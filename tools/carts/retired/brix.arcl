// BRIX : breakout with armoured bricks, speed-up and endless levels.
//   Left/Right moves the paddle, A launches the ball (and catches nothing - keep it alive!).
@name "BRIX"
@blurb "Arcade: smash the wall"
@author "Arcadia"
@version 1
@color orange
@twoplayer
@tiers "NORMAL" "EASY" "HARD" "EXTREME"
@help "Left/Right: paddle" "A: launch the ball" "3 lives. It speeds up"
@icon "########"
      "#.#.#.#."
      "########"
      "........"
      "....#..."
      "........"
      "........"
      "..####.."

const BW = 14;
const BH = 6;
const COLS = 10;
const ROWS = 6;
array bricks[60];           // 0 empty, 1 normal, 2 armoured (two hits)
array ballSp[4] = {36, 28, 44, 54};

var px, bx, by, vx, vy, lives, held, left, level, hits, flash, msgT, pw;

func newLevel() {
  left = 0;
  for (var r = 0; r < ROWS; r++) {
    for (var c = 0; c < COLS; c++) {
      var v = 1;
      if (r < level % 3 + 1) v = 2;
      if (level > 1 && (r + c + level) % 5 == 0) v = 0;
      bricks[r * COLS + c] = v;
      if (v) left++;
    }
  }
  held = 1;
  vx = 0; vy = 0;
  msgT = 50;
}

func init() {
  px = 64; pw = 32; lives = 3; level = 0;
  newLevel();
}

func launch() {
  var s = ballSp[tier()] + level * 3;
  vx = (rnd(2) ? 1 : -1) * (s / 3 + rnd(4));
  vy = -s;
  held = 0;
  sfx(1);
}

func brickCol(v, r) {
  if (v == 2) return GRAY;
  var k = r % 5;
  return k == 0 ? RED : (k == 1 ? ORANGE : (k == 2 ? YELLOW : (k == 3 ? GREEN : CYAN)));
}

func frame() {
  if (btn(LEFT))  px -= 3;
  if (btn(RIGHT)) px += 3;
  px = clamp(px, 2, 158 - pw);
  if (held) {
    bx = (px + pw / 2) * 16;
    by = 112 * 16;
    if (btnp(A)) launch();
  } else {
    // move in two half steps for accuracy
    for (var s = 0; s < 2; s++) {
      bx += vx / 2;
      by += vy / 2;
      var x = bx >> 4;
      var y = by >> 4;
      if (x < 2)   { bx = 2 * 16;   vx = abs(vx); sfx(0); }
      if (x > 156) { bx = 156 * 16; vx = -abs(vx); sfx(0); }
      if (y < 16)  { by = 16 * 16;  vy = abs(vy); sfx(0); }
      // brick collision
      var c = (x - 3) / BW;
      var r = (y - 20) / BH;
      if (x >= 3 && y >= 20 && c < COLS && r < ROWS && bricks[r * COLS + c] > 0) {
        var b = bricks[r * COLS + c];
        bricks[r * COLS + c] = b - 1;
        if (b == 1) {
          left--;
          addscore(10 + (ROWS - r) * 2);
          burst(c * BW + 10, 20 + r * BH + 3, 6, brickCol(1, r));
          sfx(4);
        } else sfx(0);
        // bounce on the nearer axis
        var cx = c * BW + 3 + BW / 2;
        var cy = 20 + r * BH + BH / 2;
        if (abs(x - cx) * BH > abs(y - cy) * BW) vx = -vx; else vy = -vy;
        by += vy / 2;
        hits++;
        if (hits % 8 == 0) { vy = vy + sign(vy); vx = vx + sign(vx); }
        if (left == 0) { level++; addscore(100); sfx(2); newLevel(); return 0; }
      }
      // paddle
      if (vy > 0 && y >= 110 && y <= 116 && x >= px - 2 && x <= px + pw + 2) {
        var off = x - (px + pw / 2);
        vx = off * 3;
        var sp = abs(vy);
        vy = -sp;
        by = 110 * 16;
        flash = 4;
        sfx(7);
      }
      if (y > 126) {
        lives--;
        sfx(3); shake(200, 2); led(255, 0, 0, 150);
        if (lives <= 0) { gameover("GAME OVER"); return 0; }
        held = 1; vx = 0; vy = 0;
      }
    }
  }
  if (flash > 0) flash--;
  if (msgT > 0) msgT--;

  cls(NAVY);
  for (var r = 0; r < ROWS; r++) {
    for (var c = 0; c < COLS; c++) {
      var v = bricks[r * COLS + c];
      if (v > 0) {
        rect(3 + c * BW, 20 + r * BH, BW - 1, BH - 1, brickCol(v, r));
        if (v == 2) rect(3 + c * BW + 1, 20 + r * BH + 1, BW - 3, 1, WHITE);
      }
    }
  }
  rect(px, 114, pw, 4, flash ? YELLOW : WHITE);
  rect(px - 2, 115, 3, 3, ORANGE);
  rect(px + pw - 1, 115, 3, 3, ORANGE);
  rect((bx >> 4) - 1, (by >> 4) - 1, 3, 3, WHITE);
  text(2, 3, WHITE, "SCORE");
  num(38, 3, YELLOW, getscore());
  text(100, 3, WHITE, "LV");
  num(116, 3, CYAN, level + 1);
  for (var i = 0; i < lives; i++) rect(136 + i * 7, 4, 5, 5, RED);
  if (held) ctext(80, YELLOW, "PRESS A");
  if (msgT > 0 && (msgT & 8)) ctext(66, WHITE, "LEVEL");
}
