  // --- Wall Pong ---
  if (gameState == ST_PONG_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterPongPlaying(); // 2P mode = simultaneous match, no hot-seat hand-off
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      s_lvlCurGame = LVLGAME_PONG;
      s_lvlMenuSel = 0;
      gameState = ST_LEVEL_MENU;
      drawLvlPickMenu();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterPongTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterPongTitle();
    }
    return;
  }
  if (gameState == ST_PONG_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterPongPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_PONG_PLAYING) {
    if (checkPauseMenu(buttons, enterPongPlaying)) return;
    unsigned long pongNow = millis();
    float pongDt = (s_lastFrameMs == 0) ? 0.016f : (pongNow - s_lastFrameMs) / 1000.0f;
    if (pongDt > 0.05f) pongDt = 0.05f;
    s_lastFrameMs = pongNow;

    if (!g_twoPlayerMode && (pressed & ARCADA_BUTTONMASK_B)) { // in 2P, B is P2's "down"
      if (s_lvlTestPlay || s_lvlPackPlay) { lvlTestPlayExit(); return; }
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if (buttons & ARCADA_BUTTONMASK_UP) pongPaddleY -= 110.0f * pongDt;
    if (buttons & ARCADA_BUTTONMASK_DOWN) pongPaddleY += 110.0f * pongDt;
    if (pongPaddleY < HUD_HEIGHT) pongPaddleY = HUD_HEIGHT;
    if (pongPaddleY > HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PONG_PADDLE_H)
      pongPaddleY = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PONG_PADDLE_H;

    if (g_twoPlayerMode) {
      if (buttons & ARCADA_BUTTONMASK_A) pongPaddle2Y -= 110.0f * pongDt;
      if (buttons & ARCADA_BUTTONMASK_B) pongPaddle2Y += 110.0f * pongDt;
      if (pongPaddle2Y < HUD_HEIGHT) pongPaddle2Y = HUD_HEIGHT;
      if (pongPaddle2Y > HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PONG_PADDLE_H)
        pongPaddle2Y = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PONG_PADDLE_H;
      pongBallX += pongBallVX * pongDt;
      pongBallY += pongBallVY * pongDt;
      if (pongBallY < HUD_HEIGHT) { pongBallY = HUD_HEIGHT; pongBallVY = fabsf(pongBallVY); }
      if (pongBallY > HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PONG_BALL_SIZE) {
        pongBallY = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PONG_BALL_SIZE;
        pongBallVY = -fabsf(pongBallVY);
      }
      pongBlockBounce();
      const int p2Left = VIEW_COLS * TILE_SIZE - 2 - PONG_PADDLE_W;
      if (pongBallVX < 0 && pongBallX <= 2 + PONG_PADDLE_W && pongBallY + PONG_BALL_SIZE >= pongPaddleY &&
          pongBallY <= pongPaddleY + PONG_PADDLE_H) {
        pongBallVX = fabsf(pongBallVX) * 1.03f;
        if (pongBallVX > 160.0f) pongBallVX = 160.0f;
        sfx(500, 30);
      } else if (pongBallVX > 0 && pongBallX + PONG_BALL_SIZE >= p2Left &&
                 pongBallY + PONG_BALL_SIZE >= pongPaddle2Y && pongBallY <= pongPaddle2Y + PONG_PADDLE_H) {
        pongBallVX = -fabsf(pongBallVX) * 1.03f;
        if (pongBallVX < -160.0f) pongBallVX = -160.0f;
        sfx(420, 30);
      } else if (pongBallX < 0 || pongBallX > VIEW_COLS * TILE_SIZE) {
        bool p2Scored = pongBallX < 0;
        if (p2Scored) pong2S2++; else pong2S1++;
        sfx(150, 80);
        if (pong2S1 >= PONG_2P_WIN || pong2S2 >= PONG_2P_WIN) {
          pong2Winner = pong2S1 >= PONG_2P_WIN ? 1 : 2;
          sfxWin();
          pixelsWinCelebration();
          gameState = ST_PONG_OVER;
          drawPongOverScreen();
          return;
        }
        pongServe();
        if (p2Scored) pongBallVX = -pongBallVX; // serve toward the player who just scored
      }
      drawPongScene();
      drawPongHud();
      blitScreen();
      return;
    }

    pongBallX += pongBallVX * pongDt;
    pongBallY += pongBallVY * pongDt;

    if (pongBallY < HUD_HEIGHT) {
      pongBallY = HUD_HEIGHT;
      pongBallVY = fabsf(pongBallVY);
    }
    if (pongBallY > HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PONG_BALL_SIZE) {
      pongBallY = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PONG_BALL_SIZE;
      pongBallVY = -fabsf(pongBallVY);
    }
    if (pongBallX > VIEW_COLS * TILE_SIZE - PONG_BALL_SIZE) {
      pongBallX = VIEW_COLS * TILE_SIZE - PONG_BALL_SIZE;
      pongBallVX = -fabsf(pongBallVX);
    }
    pongBlockBounce();

    if (pongBallVX < 0 && pongBallX <= 2 + PONG_PADDLE_W && pongBallY + PONG_BALL_SIZE >= pongPaddleY &&
        pongBallY <= pongPaddleY + PONG_PADDLE_H) {
      pongBallVX = fabsf(pongBallVX) * 1.03f;
      if (pongBallVX > 160.0f) pongBallVX = 160.0f;
      pongScore++;
      sfx(500, 30);
    } else if (pongBallX < 0) {
      pongLives--;
      sfx(150, 80);
      pixelsFlash(255, 0, 0, 60);
      if (pongLives <= 0) {
        if (s_lvlActiveSlot[LVLGAME_PONG] < 0 && pongScore > pongBestScore) pongBestScore = pongScore;
        if (s_lvlActiveSlot[LVLGAME_PONG] < 0) recordResult(18, g_variant, (long)(pongScore), true);
        else { s_lastNewBest = false; lvlRecordRun(LVLGAME_PONG, (long)pongScore, true); }
        if (g_twoPlayerMode) {
          twoPHandleGameEnd(pongScore);
        } else {
          gameState = ST_PONG_OVER;
          drawPongOverScreen();
        }
        return;
      }
      pongServe();
    }

    drawPongScene();
    drawPongHud();
    blitScreen();
    return;
  }

  // --- Gap Flyer ---
  if (gameState == ST_GAP_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterGapPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterGapPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      cycleUserSeed();
      enterGapTitle();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      lvlOpenMenu(LVLGAME_GAP);
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterGapTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterGapTitle();
    }
    return;
  }
  if (gameState == ST_GAP_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterGapPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_GAP_PLAYING) {
    if (checkPauseMenu(buttons, enterGapPlaying)) return;
    unsigned long gapNow = millis();
    float gapDt = (s_lastFrameMs == 0) ? 0.016f : (gapNow - s_lastFrameMs) / 1000.0f;
    if (gapDt > 0.05f) gapDt = 0.05f;
    s_lastFrameMs = gapNow;

    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      gapPlayerVY = -85.0f;
      sfx(500, 30);
    }
    gapPlayerVY += 220.0f * gapDt;
    gapPlayerY += gapPlayerVY * gapDt;

    bool dead = false;
    if (gapPlayerY < HUD_HEIGHT || gapPlayerY + GAP_PLAYER_SIZE > HUD_HEIGHT + GAP_PH)
      dead = true;

    if (gapNow >= gapNextSpawnMs) {
      gapSpawnWall(GAP_PW + 10);
      gapNextSpawnMs = gapNow + 1300;
    }

    for (int i = 0; i < GAP_MAX_WALLS; i++) {
      if (!gapWalls[i].active) continue;
      gapWalls[i].x -= gapSpeedCur * gapDt;
      if (gapWalls[i].x + GAP_WALL_W < 0) {
        gapWalls[i].active = false;
        continue;
      }
      bool overlapX =
          GAP_PLAYER_X + GAP_PLAYER_SIZE > gapWalls[i].x && GAP_PLAYER_X < gapWalls[i].x + GAP_WALL_W;
      if (overlapX) {
        bool inGap = gapPlayerY > gapWalls[i].gapY &&
                     gapPlayerY + GAP_PLAYER_SIZE < gapWalls[i].gapY + gapWalls[i].gapSize;
        if (!inGap) dead = true;
      }
      if (!gapWalls[i].scored && gapWalls[i].x + GAP_WALL_W < GAP_PLAYER_X) {
        gapWalls[i].scored = true;
        gapScore++;
      }
    }

    if (!dead && gapCustom && gapCustomIdx >= gapCustomLen && gapScore >= (int)gapCustomLen) {
      gapWon = true;   // every wall of the hand-made course is behind us
      sfxWin();
      pixelsWinCelebration();
      s_lastNewBest = false;
      lvlRecordRun(LVLGAME_GAP, (long)gapScore, true);
      lvlOnClear(LVLGAME_GAP);
      if (twoPOrMix()) {
        twoPHandleGameEnd(gapScore);
      } else {
        gameState = ST_GAP_OVER;
        drawGapOverScreen();
      }
      return;
    }
    if (dead) {
      if (!gapCustom && gapScore > gapBestScore) gapBestScore = gapScore;
      sfx(120, 100);
      pixelsFlash(255, 0, 0, 80);
      if (gapCustom) { s_lastNewBest = false; lvlRecordRun(LVLGAME_GAP, (long)gapScore, true); }
      else recordResult(19, g_variant, (long)(gapScore), true);
      if (twoPOrMix()) {
        twoPHandleGameEnd(gapScore);
      } else {
        gameState = ST_GAP_OVER;
        drawGapOverScreen();
      }
      return;
    }

    drawGapScene();
    drawGapHud();
    blitScreen();
    return;
  }

  // --- Platform Dash ---
  if (gameState == ST_PLAT_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterPlatPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterPlatPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterPlatTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterPlatTitle();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      s_lvlCurGame = LVLGAME_PLAT;
      s_lvlMenuSel = 0;
      gameState = ST_LEVEL_MENU;
      drawLvlPickMenu();
    }
    return;
  }
  if (gameState == ST_PLAT_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterPlatPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_PLAT_PLAYING) {
    if (checkPauseMenu(buttons, enterPlatPlaying)) return;
    unsigned long platNow = millis();
    float platDt = (s_lastFrameMs == 0) ? 0.016f : (platNow - s_lastFrameMs) / 1000.0f;
    if (platDt > 0.05f) platDt = 0.05f;
    s_lastFrameMs = platNow;

    if (pressed & ARCADA_BUTTONMASK_B) {
      if (s_lvlTestPlay || s_lvlPackPlay) { lvlTestPlayExit(); return; }
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if ((pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) && platGrounded) {
      platPlayerVY = PLAT_JUMP_VY;
      sfx(500, 30);
    }

    platPlayerVY += PLAT_GRAVITY * platDt;
    platPlayerY += platPlayerVY * platDt;

    int restrictTopY = -1;
    bool overAnyHazard = false;
    for (int i = 0; i < PLAT_MAX_HAZARDS; i++) {
      if (!platHazards[i].active) continue;
      platHazards[i].x -= platSpeedCur * platDt;
      if (platHazards[i].x + platHazards[i].w < 0) {
        platHazards[i].active = false;
        continue;
      }
      bool overlapX = PLAT_PLAYER_X + PLAT_PLAYER_SIZE > platHazards[i].x &&
                      PLAT_PLAYER_X < platHazards[i].x + platHazards[i].w;
      if (overlapX) {
        overAnyHazard = true;
        if (restrictTopY == -1 || platHazards[i].topY < restrictTopY) restrictTopY = platHazards[i].topY;
      }
      if (!platHazards[i].scored && platHazards[i].x + platHazards[i].w < PLAT_PLAYER_X) {
        platHazards[i].scored = true;
        platScore++;
      }
    }

    bool platDead = false;
    if (overAnyHazard) {
      if (platPlayerY + PLAT_PLAYER_SIZE >= restrictTopY) platDead = true;
      platGrounded = false;
    } else if (platPlayerY + PLAT_PLAYER_SIZE >= PLAT_GROUND_Y) {
      platPlayerY = PLAT_GROUND_Y - PLAT_PLAYER_SIZE;
      platPlayerVY = 0;
      platGrounded = true;
    } else {
      platGrounded = false;
    }
    if (platPlayerY < HUD_HEIGHT) {
      platPlayerY = HUD_HEIGHT;
      if (platPlayerVY < 0) platPlayerVY = 0;
    }

    if (platNow >= platNextSpawnMs) {
      bool spawned = true;
      if (s_platCustomActive) {
        if (!s_platCustomWon && s_platCustomIdx < s_platCustomLen) {
          uint8_t t = s_platCustomCells[s_platCustomIdx];
          if (t == 1 || t == 2) spawned = platSpawnHazardType(VIEW_COLS * TILE_SIZE + 10, t == 1);
          else if (t == 3) s_platCustomWon = true; // Finish beat reached, no more spawns
          if (spawned) s_platCustomIdx++;          // slots all busy: retry this beat next frame
        }
      } else {
        platSpawnHazard(VIEW_COLS * TILE_SIZE + 10);
      }
      if (spawned) platNextSpawnMs = platNow + 1100;
    }

    // Custom level: once the Finish beat has been reached and every
    // on-screen hazard has scrolled off, the run is a win rather than an
    // endless loop.
    if (s_platCustomWon) {
      bool anyActive = false;
      for (int i = 0; i < PLAT_MAX_HAZARDS; i++)
        if (platHazards[i].active) anyActive = true;
      if (!anyActive) {
        if (s_lvlActiveSlot[LVLGAME_PLAT] < 0 && platScore > platBestScore) platBestScore = platScore;
        sfxWin();
        pixelsWinCelebration();
        if (s_lvlActiveSlot[LVLGAME_PLAT] < 0) recordResult(20, g_variant, (long)(platScore), true);
        else { s_lastNewBest = false; lvlRecordRun(LVLGAME_PLAT, (long)platScore, true); lvlOnClear(LVLGAME_PLAT); }
        if (g_twoPlayerMode) {
          twoPHandleGameEnd(platScore);
        } else {
          gameState = ST_PLAT_OVER;
          drawPlatOverScreen();
        }
        return;
      }
    }

    if (platDead) {
      s_platCustomWon = false; // died, even if the Finish beat already passed
      if (s_lvlActiveSlot[LVLGAME_PLAT] < 0 && platScore > platBestScore) platBestScore = platScore;
      sfx(120, 100);
      pixelsFlash(255, 0, 0, 80);
      if (s_lvlActiveSlot[LVLGAME_PLAT] < 0) recordResult(20, g_variant, (long)(platScore), true);
      else { s_lastNewBest = false; lvlRecordRun(LVLGAME_PLAT, (long)platScore, true); }
      if (g_twoPlayerMode) {
        twoPHandleGameEnd(platScore);
      } else {
        gameState = ST_PLAT_OVER;
        drawPlatOverScreen();
      }
      return;
    }

    drawPlatScene();
    drawPlatHud();
    blitScreen();
    return;
  }

  // --- Space Invaders Mini ---
  if (gameState == ST_INV_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterInvPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterInvPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterInvTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterInvTitle();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      s_lvlCurGame = LVLGAME_INV;
      s_lvlMenuSel = 0;
      gameState = ST_LEVEL_MENU;
      drawLvlPickMenu();
    }
    return;
  }
  if (gameState == ST_INV_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterInvPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_INV_PLAYING) {
    if (checkPauseMenu(buttons, enterInvPlaying)) return;
    unsigned long invNow = millis();
    float invDt = (s_lastFrameMs == 0) ? 0.016f : (invNow - s_lastFrameMs) / 1000.0f;
    if (invDt > 0.05f) invDt = 0.05f;
    s_lastFrameMs = invNow;

    if (pressed & ARCADA_BUTTONMASK_B) {
      if (s_lvlTestPlay || s_lvlPackPlay) { lvlTestPlayExit(); return; }
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if (buttons & ARCADA_BUTTONMASK_LEFT) invShipX -= 90.0f * invDt;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) invShipX += 90.0f * invDt;
    if (invShipX < 10) invShipX = 10;
    if (invShipX > INV_PW - 10) invShipX = INV_PW - 10;

    if ((pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) && !invBulletActive) {
      invBulletActive = true;
      invBulletX = invShipX - 1;
      invBulletY = HUD_HEIGHT + INV_PH - 12;
      sfx(600, 30);
    }

    int gridWidth = INV_COLS * INV_CELL_W;
    invGridX += invGridDir * invGridSpeed * invDt;
    bool descend = false;
    if (invGridX < 4) {
      invGridX = 4;
      invGridDir = 1;
      descend = true;
    }
    if (invGridX + gridWidth > INV_PW - 4) {
      invGridX = INV_PW - 4 - gridWidth;
      invGridDir = -1;
      descend = true;
    }
    if (descend) {
      invGridY += 8.0f;
      int shipY = HUD_HEIGHT + INV_PH - 8;
      if (HUD_HEIGHT + 6 + invGridY + (INV_ROWS - 1) * INV_CELL_H >= shipY - 2) {
        if (s_lvlActiveSlot[LVLGAME_INV] < 0 && invScore > invBestScore) invBestScore = invScore;
        sfx(120, 100);
        pixelsFlash(255, 0, 0, 80);
        if (s_lvlActiveSlot[LVLGAME_INV] < 0) recordResult(21, g_variant, (long)(invScore), true);
        else { s_lastNewBest = false; lvlRecordRun(LVLGAME_INV, (long)invScore, true); }
        if (g_twoPlayerMode) {
          twoPHandleGameEnd(invScore);
        } else {
          gameState = ST_INV_OVER;
          drawInvOverScreen();
        }
        return;
      }
    }

    if (invBulletActive) {
      invBulletY -= 160.0f * invDt;
      if (invBulletY < HUD_HEIGHT) {
        invBulletActive = false;
      } else {
        int relX = (int)(invBulletX - invGridX);
        int relY = (int)(invBulletY - (HUD_HEIGHT + 6 + invGridY));
        if (relX >= 0 && relY >= 0) {
          int c = relX / INV_CELL_W;
          int r = relY / INV_CELL_H;
          if (r >= 0 && r < INV_ROWS && c >= 0 && c < INV_COLS && invAlive[r][c]) {
            invAlive[r][c] = false;
            invAliveCount--;
            invBulletActive = false;
            invScore += 10;
            sfx(500, 40);
            if (invAliveCount <= 0) {
              if (s_lvlActiveSlot[LVLGAME_INV] >= 0 && invWave == 1) {   // the custom formation was cleared
                lvlRecordRun(LVLGAME_INV, (long)invScore, true);
                lvlOnClear(LVLGAME_INV);
                sfxWin();
                if (lvlAfterClear(LVLGAME_INV)) return;
              }
              invNewWave();
              sfxWin();
            }
          }
        }
      }
    }

    drawInvScene();
    drawInvHud();
    blitScreen();
    return;
  }

  // --- Rock Paper Scissors Blitz ---
  if (gameState == ST_RPS_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "WINS", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterRpsPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterRpsPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      g_variant = (g_variant + 1) % 4;
      enterRpsTitle();
    }
    return;
  }
  if (gameState == ST_RPS_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterRpsPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_RPS_PLAYING) {
    if (checkPauseMenu(buttons, enterRpsPlaying)) return;
    unsigned long rpsNow = millis();
    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    // Reveal animation in progress: input is ignored, the round timer is parked,
    // and when it ends either the next round starts or the run is over.
    if (rpsRevealEnd != 0) {
      if (rpsNow >= rpsRevealEnd) {
        rpsRevealEnd = 0;
        if (rpsEndPending) {
          rpsEndPending = false;
          recordResult(22, g_variant, (long)(rpsWins), true);
          if (g_twoPlayerMode) {
            twoPHandleGameEnd(rpsWins);
          } else {
            gameState = ST_RPS_OVER;
            drawRpsOverScreen();
          }
          return;
        }
        rpsNewRound();
      }
      drawRpsScene();
      drawRpsHud();
      blitScreen();
      return;
    }
    bool timedOut = rpsNow >= rpsRoundEndMs;
    int playerPick = -1;
    if (pressed & ARCADA_BUTTONMASK_LEFT) playerPick = 0;
    else if (pressed & ARCADA_BUTTONMASK_UP) playerPick = 1;
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) playerPick = 2;

    if (playerPick != -1 || timedOut) {
      int result;
      if (timedOut) result = -1;
      else if (playerPick == rpsCpuPick) result = 0;
      else if ((playerPick == 0 && rpsCpuPick == 2) || (playerPick == 1 && rpsCpuPick == 0) ||
               (playerPick == 2 && rpsCpuPick == 1))
        result = 1;
      else result = -1;

      if (result == 1) {
        rpsWins++;
        sfx(700, 30);
        if (rpsRoundMs > 1400) rpsRoundMs -= 80;
      } else if (result == 0) {
        rpsDraws++;
        sfx(300, 60);
      } else {
        rpsLosses++;
        rpsLives--;
        sfx(150, 80);
        pixelsFlash(255, 0, 0, 60);
        if (rpsLives <= 0) rpsEndPending = true;
      }
      // Start the reveal (the next round / game over happens when it finishes).
      rpsNow = millis();
      rpsRevealStart = rpsNow;
      rpsRevealEnd = rpsNow + RPS_REVEAL_MS;
      rpsRevealPlayer = timedOut ? -1 : playerPick;
      rpsRevealResult = result;
    }

    drawRpsScene();
    drawRpsHud();
    blitScreen();
    return;
  }

  // --- Timing Stop ---
  if (gameState == ST_TIMING_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterTimingPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterTimingPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterTimingTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterTimingTitle();
    }
    return;
  }
  if (gameState == ST_TIMING_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterTimingPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_TIMING_PLAYING) {
    if (checkPauseMenu(buttons, enterTimingPlaying)) return;
    float timingDt = (s_lastFrameMs == 0) ? 0.016f : (millis() - s_lastFrameMs) / 1000.0f;
    if (timingDt > 0.05f) timingDt = 0.05f;
    s_lastFrameMs = millis();

    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }

    timingPos += timingDir * timingSpeed * timingDt;
    if (timingPos < 0) {
      timingPos = 0;
      timingDir = 1;
    }
    if (timingPos > TIMING_BAR_W) {
      timingPos = TIMING_BAR_W;
      timingDir = -1;
    }

    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (timingPos >= timingZoneX && timingPos <= timingZoneX + timingZoneW) {
        timingScore += 10;
        sfx(700, 30);
        timingSpeed += 4.0f;
        timingNewZone();
      } else {
        timingLives--;
        sfx(150, 80);
        pixelsFlash(255, 0, 0, 60);
        if (timingLives <= 0) {
          if (timingScore > timingBestScore) timingBestScore = timingScore;
          recordResult(23, g_variant, (long)(timingScore), true);
          if (twoPOrMix()) {
            twoPHandleGameEnd(timingScore);
          } else {
            gameState = ST_TIMING_OVER;
            drawTimingOverScreen();
          }
          return;
        }
        timingNewZone();
      }
    }

    drawTimingScene();
    drawTimingHud();
    blitScreen();
    return;
  }

  // --- Balloon Pump ---
  if (gameState == ST_BALLOON_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterBalloonPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterBalloonPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterBalloonTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterBalloonTitle();
    }
    return;
  }
  if (gameState == ST_BALLOON_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterBalloonPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_BALLOON_PLAYING) {
    if (checkPauseMenu(buttons, enterBalloonPlaying)) return;
    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if (pressed & ARCADA_BUTTONMASK_A) {
      balloonPumps++;
      if (balloonPumps >= balloonThreshold) {
        balloonLives--;
        sfx(150, 120);
        pixelsFlash(255, 0, 0, 80);
        if (balloonLives <= 0) {
          if (balloonScore > balloonBestScore) balloonBestScore = balloonScore;
          recordResult(24, g_variant, (long)(balloonScore), true);
          if (twoPOrMix()) {
            twoPHandleGameEnd(balloonScore);
          } else {
            gameState = ST_BALLOON_OVER;
            drawBalloonOverScreen();
          }
          return;
        }
        balloonNewRound();
      } else {
        balloonRoundPts += 5;
        sfx(500, 30);
      }
    } else if (pressed & ARCADA_BUTTONMASK_START) {
      balloonScore += balloonRoundPts;
      sfxWin();
      balloonNewRound();
    }

    drawBalloonScene();
    drawBalloonHud();
    blitScreen();
    return;
  }

  // --- Lights Out ---
  if (gameState == ST_LIGHTS_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterLightsPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      lvlOpenMenu(LVLGAME_LIGHTS);
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 3) % 4;
      enterLightsTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 4;
      enterLightsTitle();
    }
    return;
  }
  if (gameState == ST_LIGHTS_OVER) {   // only reached from a hand-made board
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterLightsPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_LIGHTS_PLAYING) {
    if (checkPauseMenu(buttons, enterLightsPlaying)) return;
    if (pressed & ARCADA_BUTTONMASK_B) {
      if (s_lvlTestPlay || s_lvlPackPlay) { lvlTestPlayExit(); return; }
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if (pressed & ARCADA_BUTTONMASK_LEFT) lightsCursorX = (lightsCursorX + LIGHTS_GRID - 1) % LIGHTS_GRID;
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) lightsCursorX = (lightsCursorX + 1) % LIGHTS_GRID;
    else if (pressed & ARCADA_BUTTONMASK_UP) lightsCursorY = (lightsCursorY + LIGHTS_GRID - 1) % LIGHTS_GRID;
    else if (pressed & ARCADA_BUTTONMASK_DOWN) lightsCursorY = (lightsCursorY + 1) % LIGHTS_GRID;
    else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      lightsToggle(lightsCursorX, lightsCursorY);
      lightsToggle(lightsCursorX - 1, lightsCursorY);
      lightsToggle(lightsCursorX + 1, lightsCursorY);
      lightsToggle(lightsCursorX, lightsCursorY - 1);
      lightsToggle(lightsCursorX, lightsCursorY + 1);
      lightsMoves++;
      sfx(500, 30);
      if (lightsAllOff()) {
        if (!lightsCustom && (lightsBestMoves < 0 || lightsMoves < lightsBestMoves)) lightsBestMoves = lightsMoves;
        sfxWin();
        pixelsWinCelebration();
        if (lightsCustom) {   // hand-made puzzle solved: no global records, show the result
          lvlRecordRun(LVLGAME_LIGHTS, (long)lightsMoves, false);   // fewer moves is better
          lvlOnClear(LVLGAME_LIGHTS);
          drawLightsScene();
          drawLightsHud();
          blitScreen();
          gameState = ST_LIGHTS_OVER;
          s_lastNewBest = false;
          drawLightsOverScreen();
          return;
        }
        lightsRound++;
        recordEndless(25, lightsRound);
        lightsMoves = 0;
        lightsScramble();
      }
    }

    drawLightsScene();
    drawLightsHud();
    blitScreen();
    return;
  }

  // --- Dice Duel ---
  if (gameState == ST_DICE_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterDicePlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 3) % 4;
      enterDiceTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 4;
      enterDiceTitle();
    }
    return;
  }
  if (gameState == ST_DICE_PLAYING) {
    if (checkPauseMenu(buttons, enterDicePlaying)) return;
    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if (!diceRolling && (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START))) {
      diceP1 = 1 + mazeRngRange(6);
      diceP2 = 1 + mazeRngRange(6);
      diceC1 = 1 + mazeRngRange(6);
      diceC2 = 1 + mazeRngRange(6);
      diceRolling = true;
      diceRollT = millis();
      sfx(260, 25);
    }
    if (diceRolling && millis() - diceRollT >= DICE_ROLL_MS) {
      diceRolling = false;
      diceRolled = true;
      drawDiceScene(); // show the settled faces before the result sound
      drawDiceHud();
      blitScreen();
      int p = diceP1 + diceP2 + (diceMode == 1 ? 1 : 0);
      int c = diceC1 + diceC2 + (diceMode == 2 ? 1 : 0);
      if (p > c) {
        diceWins++;
        diceStreak++;
        if (diceStreak > diceBestStreak) {
          diceBestStreak = diceStreak;
          recordEndless(26, diceBestStreak);
        }
        sfxWin();
        pixelsFlash(0, 255, 90, 60);
      } else if (p < c || (p == c && diceMode == 3)) {
        diceLosses++;
        diceStreak = 0;
        sfx(150, 80);
        pixelsFlash(255, 0, 0, 60);
      } else {
        diceDraws++;
        sfx(300, 60);
      }
    }
    drawDiceScene();
    drawDiceHud();
    blitScreen();
    return;
  }

  // --- Number Guess ---
  if (gameState == ST_GUESS_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "ROUNDS", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterGuessPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterGuessPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 3) % 4;
      enterGuessTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 4;
      enterGuessTitle();
    }
    return;
  }
  if (gameState == ST_GUESS_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterGuessPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_GUESS_PLAYING) {
    if (checkPauseMenu(buttons, enterGuessPlaying)) return;
    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN | ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT))
      guessRollStart = 0; // changing the guess cancels a roll in progress
    if (pressed & ARCADA_BUTTONMASK_UP) {
      guessCurrent++;
      if (guessCurrent > guessRangeMax) guessCurrent = guessRangeMax;
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      guessCurrent--;
      if (guessCurrent < 1) guessCurrent = 1;
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      guessCurrent += 5;
      if (guessCurrent > guessRangeMax) guessCurrent = guessRangeMax;
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      guessCurrent -= 5;
      if (guessCurrent < 1) guessCurrent = 1;
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      guessAttempts++;
      if (guessCurrent == guessSecret) {
        guessLastResult = 2;
        guessRoundsWon++;
        guessRollStart = 0;
        guessRevealBlocking(guessSecret, "CORRECT!", COL_GOAL);
        sfxWin();
        pixelsWinCelebration();
        guessNewRound();
      } else if (guessAttempts >= guessAttemptCap) {
        guessLives--;
        guessRollStart = 0;
        {
          char lost[20];
          snprintf(lost, sizeof(lost), "It was %d", guessSecret);
          guessRevealBlocking(guessSecret, lost, COL_EMITTER);
        }
        sfx(150, 80);
        pixelsFlash(255, 0, 0, 60);
        if (guessLives <= 0) {
          if (guessRoundsWon > guessBestScore) guessBestScore = guessRoundsWon;
          recordResult(27, g_variant, (long)(guessRoundsWon), true);
          if (g_twoPlayerMode) {
            twoPHandleGameEnd(guessRoundsWon);
          } else {
            gameState = ST_GUESS_OVER;
            drawGuessOverScreen();
          }
          return;
        }
        guessNewRound();
      } else {
        guessLastResult = (guessCurrent < guessSecret) ? 1 : -1;
        guessRollStart = millis();
        sfx(400, 30);
      }
    }

    drawGuessScene();
    drawGuessHud();
    blitScreen();
    return;
  }

  // --- Air Hockey ---
  if (gameState == ST_HOCKEY_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterHockeyPlaying(); // 2P mode = simultaneous match, no hot-seat hand-off
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      lvlOpenMenu(LVLGAME_HOCKEY);
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterHockeyTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterHockeyTitle();
    }
    return;
  }
  if (gameState == ST_HOCKEY_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterHockeyPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_HOCKEY_PLAYING) {
    if (checkPauseMenu(buttons, enterHockeyPlaying)) return;
    unsigned long hockeyNow = millis();
    float hockeyDt = (s_lastFrameMs == 0) ? 0.016f : (hockeyNow - s_lastFrameMs) / 1000.0f;
    if (hockeyDt > 0.05f) hockeyDt = 0.05f;
    s_lastFrameMs = hockeyNow;

    if (!g_twoPlayerMode && (pressed & ARCADA_BUTTONMASK_B)) { // in 2P, B is P2's "down"
      if (s_lvlTestPlay || s_lvlPackPlay) { lvlTestPlayExit(); return; }
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }

    if (buttons & ARCADA_BUTTONMASK_UP) hockeyPlayerY -= 100.0f * hockeyDt;
    if (buttons & ARCADA_BUTTONMASK_DOWN) hockeyPlayerY += 100.0f * hockeyDt;
    if (buttons & ARCADA_BUTTONMASK_LEFT) hockeyPlayerX -= 100.0f * hockeyDt;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) hockeyPlayerX += 100.0f * hockeyDt;
    float hockeyMidX = VIEW_COLS * TILE_SIZE / 2.0f;
    if (hockeyPlayerX < HOCKEY_PADDLE_R) hockeyPlayerX = HOCKEY_PADDLE_R;
    if (hockeyPlayerX > hockeyMidX - HOCKEY_PADDLE_R) hockeyPlayerX = hockeyMidX - HOCKEY_PADDLE_R;
    if (hockeyPlayerY < HUD_HEIGHT + HOCKEY_PADDLE_R) hockeyPlayerY = HUD_HEIGHT + HOCKEY_PADDLE_R;
    if (hockeyPlayerY > HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - HOCKEY_PADDLE_R)
      hockeyPlayerY = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - HOCKEY_PADDLE_R;

    if (g_twoPlayerMode) { // P2 (right paddle, vertical only): A = up, B = down
      if (buttons & ARCADA_BUTTONMASK_A) hockeyCpuY -= 100.0f * hockeyDt;
      if (buttons & ARCADA_BUTTONMASK_B) hockeyCpuY += 100.0f * hockeyDt;
    } else if (hockeyCpuY < hockeyPuckY) hockeyCpuY += hockeyCpuSpeedCur * hockeyDt;
    else if (hockeyCpuY > hockeyPuckY) hockeyCpuY -= hockeyCpuSpeedCur * hockeyDt;
    if (hockeyCpuY < HUD_HEIGHT + HOCKEY_PADDLE_R) hockeyCpuY = HUD_HEIGHT + HOCKEY_PADDLE_R;
    if (hockeyCpuY > HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - HOCKEY_PADDLE_R)
      hockeyCpuY = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - HOCKEY_PADDLE_R;

    hockeyPuckX += hockeyPuckVX * hockeyDt;
    hockeyPuckY += hockeyPuckVY * hockeyDt;
    if (hockeyPuckY < HUD_HEIGHT + HOCKEY_PUCK_R) {
      hockeyPuckY = HUD_HEIGHT + HOCKEY_PUCK_R;
      hockeyPuckVY = fabsf(hockeyPuckVY);
    }
    if (hockeyPuckY > HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - HOCKEY_PUCK_R) {
      hockeyPuckY = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - HOCKEY_PUCK_R;
      hockeyPuckVY = -fabsf(hockeyPuckVY);
    }
    hockeyBlockBounce();

    float hockeyDxp = hockeyPuckX - hockeyPlayerX, hockeyDyp = hockeyPuckY - hockeyPlayerY;
    if (hockeyPuckVX < 0 && hockeyDxp * hockeyDxp + hockeyDyp * hockeyDyp <
                                 (HOCKEY_PADDLE_R + HOCKEY_PUCK_R) * (HOCKEY_PADDLE_R + HOCKEY_PUCK_R)) {
      hockeyPuckVX = fabsf(hockeyPuckVX) * 1.05f;
      if (hockeyPuckVX > 130.0f) hockeyPuckVX = 130.0f;
      hockeyPuckVY += (hockeyPuckY - hockeyPlayerY) * 0.6f;
      sfx(500, 30);
    }
    float hockeyDxc = hockeyPuckX - hockeyCpuX, hockeyDyc = hockeyPuckY - hockeyCpuY;
    if (hockeyPuckVX > 0 && hockeyDxc * hockeyDxc + hockeyDyc * hockeyDyc <
                                 (HOCKEY_PADDLE_R + HOCKEY_PUCK_R) * (HOCKEY_PADDLE_R + HOCKEY_PUCK_R)) {
      hockeyPuckVX = -fabsf(hockeyPuckVX) * 1.05f;
      if (hockeyPuckVX < -130.0f) hockeyPuckVX = -130.0f;
      sfx(400, 30);
    }

    if (hockeyPuckX < 0) {
      hockeyCpuScore++;
      sfx(150, 100);
      pixelsFlash(255, 0, 0, 60);
      if (hockeyCpuScore >= 5) {
        if (g_twoPlayerMode) { sfxWin(); pixelsWinCelebration(); }
        else {
          hockeyLosses++;
          if (s_lvlActiveSlot[LVLGAME_HOCKEY] < 0) recordResult(28, g_variant, (long)((long)hockeyPlayerScore - (long)hockeyCpuScore), true);
          else { s_lastNewBest = false; lvlRecordRun(LVLGAME_HOCKEY, (long)hockeyPlayerScore - (long)hockeyCpuScore, true); }
        }
        gameState = ST_HOCKEY_OVER;
        drawHockeyOverScreen();
        return;
      }
      hockeyServe(0);
    } else if (hockeyPuckX > VIEW_COLS * TILE_SIZE) {
      hockeyPlayerScore++;
      sfxWin();
      pixelsFlash(0, 255, 90, 60);
      if (hockeyPlayerScore >= 5) {
        if (g_twoPlayerMode) { sfxWin(); pixelsWinCelebration(); }
        else {
          hockeyWins++;
          if (s_lvlActiveSlot[LVLGAME_HOCKEY] < 0) recordResult(28, g_variant, (long)((long)hockeyPlayerScore - (long)hockeyCpuScore), true);
          else {
            s_lastNewBest = false;
            lvlRecordRun(LVLGAME_HOCKEY, (long)hockeyPlayerScore - (long)hockeyCpuScore, true);
            lvlOnClear(LVLGAME_HOCKEY);
          }
        }
        gameState = ST_HOCKEY_OVER;
        drawHockeyOverScreen();
        return;
      }
      hockeyServe(1);
    }

    drawHockeyScene();
    drawHockeyHud();
    blitScreen();
    return;
  }

  // --- Connect Four ---
  if (gameState == ST_C4_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterC4Playing();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN)) {
      c4VsCpu = !c4VsCpu;
      sfxMove();
      enterC4Title();
    } else if (c4VsCpu && (pressed & ARCADA_BUTTONMASK_LEFT)) {
      g_variant = (g_variant + 3) % 4;
      enterC4Title();
    } else if (c4VsCpu && (pressed & ARCADA_BUTTONMASK_RIGHT)) {
      g_variant = (g_variant + 1) % 4;
      enterC4Title();
    }
    return;
  }
  if (gameState == ST_C4_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterC4Playing();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_C4_PLAYING) {
    if (checkPauseMenu(buttons, enterC4Playing)) return;
    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    if (c4VsCpu && c4Turn == 2) {
      // CPU's turn: human input is ignored until it has dropped (and the
      // previous disc has landed).
      if ((long)(millis() - c4CpuAt) >= 0 && !c4AnimBusy()) {
        int col = c4CpuPick();
        if (col >= 0) {
          c4Cursor = col;
          if (c4PlaceDisc(col)) return;
        }
      }
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) c4Cursor = (c4Cursor + C4_COLS - 1) % C4_COLS;
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) c4Cursor = (c4Cursor + 1) % C4_COLS;
    else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (c4Board[0][c4Cursor] == 0 && c4PlaceDisc(c4Cursor)) return;
    }

    drawC4Scene();
    drawC4Hud();
    blitScreen();
    return;
  }

  // --- Tilt Maze ---
  if (gameState == ST_TILT_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterTiltPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterTiltPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterTiltTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterTiltTitle();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      s_lvlCurGame = LVLGAME_TILT;
      s_lvlMenuSel = 0;
      gameState = ST_LEVEL_MENU;
      drawLvlPickMenu();
    }
    return;
  }
  if (gameState == ST_TILT_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterTiltPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_TILT_PLAYING) {
    if (checkPauseMenu(buttons, enterTiltPlaying)) return;
    unsigned long tiltNow = millis();
    float tiltDt = (s_lastFrameMs == 0) ? 0.016f : (tiltNow - s_lastFrameMs) / 1000.0f;
    if (tiltDt > 0.05f) tiltDt = 0.05f;
    s_lastFrameMs = tiltNow;

    if (pressed & ARCADA_BUTTONMASK_B) {
      if (s_lvlTestPlay || s_lvlPackPlay) { lvlTestPlayExit(); return; }
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }

    float ax, ay;
    tiltReadXY(ax, ay);
    // The display runs rotated relative to the accelerometer's native
    // axes, so this mapping is tuned by feel rather than derived from
    // the rotation -- flip either sign below if the ball rolls the
    // wrong way on real hardware.
    tiltVX += ax * tiltSensitivityCur * tiltDt;
    tiltVY += ay * tiltSensitivityCur * tiltDt;
    tiltVX *= 0.985f; // rolling friction
    tiltVY *= 0.985f;
    tiltBallX += tiltVX * tiltDt;
    tiltBallY += tiltVY * tiltDt;

    float playW = VIEW_COLS * TILE_SIZE, playBottom = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE;
    if (tiltBallX < TILT_BALL_R) {
      tiltBallX = TILT_BALL_R;
      tiltVX = -tiltVX * 0.4f;
    }
    if (tiltBallX > playW - TILT_BALL_R) {
      tiltBallX = playW - TILT_BALL_R;
      tiltVX = -tiltVX * 0.4f;
    }
    if (tiltBallY < HUD_HEIGHT + TILT_BALL_R) {
      tiltBallY = HUD_HEIGHT + TILT_BALL_R;
      tiltVY = -tiltVY * 0.4f;
    }
    if (tiltBallY > playBottom - TILT_BALL_R) {
      tiltBallY = playBottom - TILT_BALL_R;
      tiltVY = -tiltVY * 0.4f;
    }

    bool tiltDead = false;
    for (int i = 0; i < tiltHoleCount; i++) {
      float dx = tiltBallX - tiltHoles[i].x, dy = tiltBallY - tiltHoles[i].y;
      if (dx * dx + dy * dy < tiltHoles[i].r * tiltHoles[i].r) {
        tiltDead = true;
        break;
      }
    }
    if (tiltDead) {
      if (s_lvlActiveSlot[LVLGAME_TILT] < 0 && tiltScore > tiltBestScore) tiltBestScore = tiltScore;
      sfx(120, 100);
      pixelsFlash(255, 0, 0, 80);
      if (s_lvlActiveSlot[LVLGAME_TILT] < 0) recordResult(30, g_variant, (long)(tiltScore), true);
      else { s_lastNewBest = false; lvlRecordRun(LVLGAME_TILT, (long)tiltScore, true); }
      if (g_twoPlayerMode) {
        twoPHandleGameEnd(tiltScore);
      } else {
        gameState = ST_TILT_OVER;
        drawTiltOverScreen();
      }
      return;
    }

    float gdx = tiltBallX - tiltGoalX, gdy = tiltBallY - tiltGoalY;
    if (gdx * gdx + gdy * gdy < (TILT_GOAL_R + TILT_BALL_R) * (TILT_GOAL_R + TILT_BALL_R)) {
      tiltScore++;
      sfxWin();
      pixelsWinCelebration();
      if (s_lvlActiveSlot[LVLGAME_TILT] >= 0 && tiltScore == 1) {   // the custom layout's goal
        lvlRecordRun(LVLGAME_TILT, (long)tiltScore, true);
        lvlOnClear(LVLGAME_TILT);
        if (lvlAfterClear(LVLGAME_TILT)) return;
      }
      tiltNewLayout();
    }

    drawTiltScene();
    drawTiltHud();
    blitScreen();
    return;
  }

  // --- Block Stack ---
  if (gameState == ST_BSTK_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) twoPBegin(enterBstkPlaying, true, "LINES");
      else enterBstkPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      cycleUserSeed();
      enterBstkTitle();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      lvlOpenMenu(LVLGAME_BSTK);
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 3) % 4;
      enterBstkTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 4;
      enterBstkTitle();
    }
    return;
  }
  if (gameState == ST_BSTK_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterBstkPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_BSTK_PLAYING) {
    if (checkPauseMenu(buttons, enterBstkPlaying)) return;
    unsigned long bsNow = millis();
    bool bsLanded = false;
    if (pressed & ARCADA_BUTTONMASK_LEFT) {
      if (bsFits(bsPiece, bsRot, bsX - 1, bsY)) { bsX--; sfxMove(); }
      bsRepAtMs = bsNow + 170;
    } else if ((buttons & ARCADA_BUTTONMASK_LEFT) && bsNow >= bsRepAtMs) {
      if (bsFits(bsPiece, bsRot, bsX - 1, bsY)) { bsX--; sfxMove(); }
      bsRepAtMs = bsNow + 55;
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      if (bsFits(bsPiece, bsRot, bsX + 1, bsY)) { bsX++; sfxMove(); }
      bsRepAtMs = bsNow + 170;
    } else if ((buttons & ARCADA_BUTTONMASK_RIGHT) && bsNow >= bsRepAtMs) {
      if (bsFits(bsPiece, bsRot, bsX + 1, bsY)) { bsX++; sfxMove(); }
      bsRepAtMs = bsNow + 55;
    }
    if (pressed & (ARCADA_BUTTONMASK_SELECT | ARCADA_BUTTONMASK_A)) {
      int nr = (bsRot + 1) & 3;
      static const int8_t kicks[5] = {0, -1, 1, -2, 2};
      for (int k = 0; k < 5; k++) {
        if (bsFits(bsPiece, nr, bsX + kicks[k], bsY)) {
          bsX += kicks[k];
          bsRot = nr;
          sfx(440, 15);
          break;
        }
      }
    }
    if (pressed & ARCADA_BUTTONMASK_B) {
      while (bsFits(bsPiece, bsRot, bsX, bsY + 1)) bsY++;
      bsLanded = true;
      screenShake(120, 2);
    } else {
      if ((buttons & ARCADA_BUTTONMASK_DOWN) && bsFallAtMs > bsNow + 45) bsFallAtMs = bsNow + 45;
      if (bsNow >= bsFallAtMs) {
        if (bsFits(bsPiece, bsRot, bsX, bsY + 1)) {
          bsY++;
          bsFallAtMs = bsNow + bsInterval();
          if (buttons & ARCADA_BUTTONMASK_DOWN) bsFallAtMs = bsNow + 45;
        } else {
          bsLanded = true;
        }
      }
    }
    if (bsLanded) {
      bsPieces++;
      int cleared = bsLock();
      if (cleared > 0) {
        bsLines += cleared;
        for (int k = 0; k < bsFlashN && k < 4; k++)
          particlesBurst(BS_X0 + (BS_W * BS_CELL) / 2, BS_Y0 + bsFlashRows[k] * BS_CELL + BS_CELL / 2, 6, 0);
        sfx(500 + cleared * 120, 80);
      } else {
        sfx(200, 25);
      }
      if (bsCustom && !bsGarbageLeft()) {   // every garbage cell is gone
        bsWon = true;
        sfxWin();
        pixelsWinCelebration();
        s_lastNewBest = false;
        lvlRecordRun(LVLGAME_BSTK, (long)bsPieces, false);   // fewer pieces is better
        lvlOnClear(LVLGAME_BSTK);
        if (g_twoPlayerMode) {
          twoPHandleGameEnd(bsLines);
        } else {
          gameState = ST_BSTK_OVER;
          drawBstkOverScreen();
        }
        return;
      }
      if (!bsSpawn()) {
        sfx(120, 100);
        pixelsFlash(255, 0, 0, 80);
        if (bsCustom) { s_lastNewBest = false; lvlRecordRun(LVLGAME_BSTK, 0, false); }
        else recordResult(31, g_variant, (long)bsLines, true);
        if (g_twoPlayerMode) {
          twoPHandleGameEnd(bsLines);
        } else {
          gameState = ST_BSTK_OVER;
          drawBstkOverScreen();
        }
        return;
      }
    }
    drawBstkScene();
    blitScreen();
    return;
  }

  // --- 2048 ---
  if (gameState == ST_2048_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) twoPBegin(enter2048Playing, true, "SCORE");
      else enter2048Playing();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 3) % 4;
      enter2048Title();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 4;
      enter2048Title();
    }
    return;
  }
  if (gameState == ST_2048_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enter2048Playing();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_2048_PLAYING) {
    if (checkPauseMenu(buttons, enter2048Playing)) return;
    int g48Dir = -1;
    if (pressed & ARCADA_BUTTONMASK_LEFT) g48Dir = 0;
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) g48Dir = 1;
    else if (pressed & ARCADA_BUTTONMASK_UP) g48Dir = 2;
    else if (pressed & ARCADA_BUTTONMASK_DOWN) g48Dir = 3;
    if (g48Dir >= 0) {
      bool g48Merged = false;
      g48Anim = false;
      if (g48Slide(g48Dir, &g48Merged)) {
        g48Spawn();
        g48Anim = true;
        g48AnimStart = millis();
        if (g48Merged) sfx(600, 40);
        else sfxMove();
        if (!g48CanMove()) {
          sfx(120, 100);
          pixelsFlash(255, 0, 0, 80);
          recordResult(32, g_variant, g48Score, true);
          if (g_twoPlayerMode) {
            twoPHandleGameEnd(g48Score);
          } else {
            gameState = ST_2048_OVER;
            draw2048OverScreen();
          }
          return;
        }
      } else {
        sfxBlocked();
      }
    }
    drawG48Scene();
    blitScreen();
    return;
  }

  // --- Minesweeper ---
  if (gameState == ST_MINE_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) twoPBegin(enterMinePlaying, false, "TIME(s)");
      else enterMinePlaying();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      lvlOpenMenu(LVLGAME_MINE);
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      cycleUserSeed();
      enterMineTitle();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 3) % 4;
      enterMineTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 4;
      enterMineTitle();
    }
    return;
  }
  if (gameState == ST_MINE_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterMinePlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_MINE_PLAYING) {
    if (checkPauseMenu(buttons, enterMinePlaying)) return;
    unsigned long msNow = millis();
    // Elapsed time only counts frames actually played: s_lastFrameMs is 0
    // on the first frame and right after a pause, so those add nothing.
    if (!msFirst && s_lastFrameMs != 0) msElapsedMs += msNow - s_lastFrameMs;
    s_lastFrameMs = msNow;

    const uint32_t msDpad = ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT |
                            ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN;
    uint32_t mv = pressed & msDpad;
    if (mv) msRepAtMs = msNow + 260;
    else if ((buttons & msDpad) && msNow >= msRepAtMs) {
      mv = buttons & msDpad;
      msRepAtMs = msNow + 110;
    }
    if (mv & ARCADA_BUTTONMASK_LEFT) { if (msCx > 0) msCx--; }
    else if (mv & ARCADA_BUTTONMASK_RIGHT) { if (msCx < MS_W - 1) msCx++; }
    else if (mv & ARCADA_BUTTONMASK_UP) { if (msCy > 0) msCy--; }
    else if (mv & ARCADA_BUTTONMASK_DOWN) { if (msCy < MS_H - 1) msCy++; }

    uint8_t& cur = msGrid[msCy * MS_W + msCx];
    if (pressed & ARCADA_BUTTONMASK_B) {
      if (!(cur & MS_OPEN)) {
        if (cur & MS_FLAG) { cur &= ~MS_FLAG; msFlags--; }
        else { cur |= MS_FLAG; msFlags++; }
        sfx(350, 20);
      }
    } else if (pressed & ARCADA_BUTTONMASK_A) {
      if (msFirst && !(cur & MS_FLAG)) {
        msFirst = false;
        msPlaceMines(msCx, msCy);
      }
      if (cur & MS_OPEN) {
        // Chord: a number with enough flags around it opens the rest.
        int n = msNeighbors(msCx, msCy);
        if (n > 0 && msFlagsAround(msCx, msCy) == n) {
          for (int dy = -1; dy <= 1; dy++)
            for (int dx = -1; dx <= 1; dx++) {
              int nx = msCx + dx, ny = msCy + dy;
              if ((dx || dy) && nx >= 0 && nx < MS_W && ny >= 0 && ny < MS_H) msOpen(nx, ny);
            }
          sfx(500, 20);
        }
      } else if (!(cur & MS_FLAG)) {
        msOpen(msCx, msCy);
        sfx(500, 20);
      }
      if (msHit || msRevealed >= MS_CELLS - msMines) {
        msWon = !msHit;
        msShowAll = msHit;
        memset(msRevT, 0, sizeof(msRevT)); // show the final board at once
        if (msWon) {
          for (int i = 0; i < MS_CELLS; i++)
            if ((msGrid[i] & MS_MINE) && !(msGrid[i] & MS_FLAG)) { msGrid[i] |= MS_FLAG; msFlags++; }
        }
        drawMineScene();
        blitScreen();
        long secs = (long)(msElapsedMs / 1000);
        if (secs < 1) secs = 1;
        if (msWon) {
          sfxWin();
          pixelsWinCelebration();
          if (!msHasCustom) recordResult(33, g_variant, secs, false);   // hand-made boards don't set records
          else { s_lastNewBest = false; lvlRecordRun(LVLGAME_MINE, secs, false); lvlOnClear(LVLGAME_MINE); }
          if (g_twoPlayerMode) {
            twoPHandleGameEnd(secs);
          } else {
            gameState = ST_MINE_OVER;
            drawMineOverScreen();
          }
        } else {
          sfxDeath();
          pixelsFlash(255, 0, 0, 80);
          {
            // Explosion: white flash, then expanding fireball rings around the
            // mine you hit (same ~900 ms the old delay() took).
            unsigned long boomT0 = millis();
            int bx = MS_X0 + msCx * MS_CELL + MS_CELL / 2, by = MS_Y0 + msCy * MS_CELL + MS_CELL / 2;
            while (millis() - boomT0 < 900) {
              unsigned long el = millis() - boomT0;
              drawMineScene();
              if (el < 600) {
                float f = animEase((float)el / 600.0f);
                int r = (int)(6 + 60 * f);
                uint8_t fade = (uint8_t)(255 - 255 * el / 600);
                canvas->fillCircle(bx, by, r, animBlend(COL_BG, COL_ORANGE, fade / 2));
                canvas->drawCircle(bx, by, r, animBlend(COL_BG, COL_KEY, fade));
                canvas->drawCircle(bx, by, r > 6 ? r - 5 : 1, animBlend(COL_BG, COL_LASER, fade));
                if (el < 90) canvas->fillCircle(bx, by, 12 + (int)el / 3, 0xFFFF);
              }
              blitScreen();
            }
          }
          s_lastNewBest = false; // a loss is not a real time
          if (g_twoPlayerMode) {
            twoPHandleGameEnd(999999L); // worst possible time
          } else {
            gameState = ST_MINE_OVER;
            drawMineOverScreen();
          }
        }
        return;
      }
    }
    drawMineScene();
    blitScreen();
    return;
