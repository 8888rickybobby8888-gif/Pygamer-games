static void enterTankPlaying() {
  s_mazeRng = (millis() ^ 0xC0FFEEu) | 1u;
  tkCustom = false;
  if (s_lvlActiveSlot[LVLGAME_TANK] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_TANK, s_lvlActiveSlot[LVLGAME_TANK], &lvl)) tankLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_TANK] = -1;
  }
  tkGenTerrain();
  tkHp[0] = tkHp[1] = 100;
  tkAng[0] = tkAng[1] = 45;
  tkPow[0] = tkPow[1] = 55;
  tkDmg[0] = tkDmg[1] = 0;
  tkTurn = tkVsCpu ? 0 : (tkFirst == 1 ? 0 : 1);   // the human always opens vs the CPU
  tkWind = mazeRngRange(7) - 3;
  tkPhase = 0;
  tkPhaseT0 = 0;
  tkExR = 0;
  tkTrN = 0;
  tkRepT = 0;
  tkWinner = 0;
  if (tkVsCpu && tkTurn == 1) tkCpuPlan();
  s_lastFrameMs = 0;
  gameState = ST_TANK_PLAYING;
}

static void tkDrawTank(int who, bool active) {
  int x = tkX[who], y = tkSurf[x];
  uint16_t col = who == 0 ? COL_BLUE : COL_ORANGE;
  float a = tkAng[who] * 0.0174533f;
  int dir = who == 0 ? 1 : -1;
  int bx = x + (int)(dir * cosf(a) * 9.0f), by = y - 6 - (int)(sinf(a) * 9.0f);
  canvas->drawLine(x, y - 6, bx, by, COL_TEXT);
  canvas->fillRect(x - 5, y - 4, 11, 4, col);
  canvas->fillRect(x - 3, y - 7, 7, 3, col);
  canvas->drawFastHLine(x - 5, y - 1, 11, COL_BG);
  if (active) canvas->fillTriangle(x - 3, y - 20, x + 3, y - 20, x, y - 15, COL_KEY);
}

static void drawTankScene() {
  unsigned long now = millis();
  uint16_t sky = arcada.display->color565(10, 16, 44);
  uint16_t grass = arcada.display->color565(40, 160, 60);
  uint16_t soil = arcada.display->color565(92, 62, 34);
  canvas->fillScreen(sky);
  for (int x = 0; x < TK_W; x++) {
    int s = tkSurf[x];
    canvas->drawFastVLine(x, s, 128 - s, soil);
    canvas->drawFastVLine(x, s, 2, grass);
  }
  // trail of the last shell
  for (int i = 0; i < tkTrN; i++) canvas->drawPixel(tkTr[i][0], tkTr[i][1], COL_WALL);
  bool aiming = tkPhase == 0;
  if (tkHp[0] > 0 || tkPhase != 3) tkDrawTank(0, aiming && tkTurn == 0);
  if (tkHp[1] > 0 || tkPhase != 3) tkDrawTank(1, aiming && tkTurn == 1);
  if (tkPhase == 1) canvas->fillRect((int)tkSx - 1, (int)tkSy - 1, 3, 3, COL_TEXT);
  if ((tkPhase == 2 || tkPhase == 3) && tkExR > 0) {
    unsigned long t = now - tkPhaseT0;
    if (t < 380) {
      int r = (int)((float)tkExR * (float)t / 380.0f) + 1;
      canvas->fillCircle(tkExX, tkExY, r, COL_KEY);
      canvas->drawCircle(tkExX, tkExY, r + 2, COL_ORANGE);
    }
  }
  if (tkPhase >= 2 && now - tkPhaseT0 < 800) {
    for (int i = 0; i < 2; i++) {
      if (tkDmg[i] <= 0) continue;
      char d[16];
      snprintf(d, sizeof(d), "-%d", tkDmg[i]);
      ptc(COL_LASER, tkX[i] - 9, tkSurf[tkX[i]] - 22 - (int)((now - tkPhaseT0) / 40), d);
    }
  }
  // HUD
  canvas->setTextSize(1);
  for (int i = 0; i < 2; i++) {
    int bx = i == 0 ? 2 : 108;
    canvas->fillRect(bx, 2, 50, 5, arcada.display->color565(60, 20, 20));
    canvas->fillRect(bx, 2, tkHp[i] / 2, 5, i == 0 ? COL_BLUE : COL_ORANGE);
    canvas->drawRect(bx - 1, 1, 52, 7, COL_WALL);
  }
  char w[24];
  if (tkWind == 0) snprintf(w, sizeof(w), "W 0");
  else if (tkWind > 0) snprintf(w, sizeof(w), "W>%d", tkWind);
  else snprintf(w, sizeof(w), "<%dW", -tkWind);
  ptc(COL_ICE, 68, 2, w);
  if (tkPhase != 3) {
    char a[20];
    snprintf(a, sizeof(a), "%s A%d P%d", tkName(tkTurn), tkAng[tkTurn], tkPow[tkTurn]);
    ptc(tkTurn == 0 ? COL_BLUE : COL_ORANGE, tkTurn == 0 ? 2 : 160 - (int)strlen(a) * 6 - 2, 10, a);
  }
}

static void drawTankOverScreen() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_ORANGE);
  const char* msg;
  if (tkVsCpu) msg = tkWinner == 1 ? "YOU WIN" : tkWinner == 2 ? "CPU WINS" : "DRAW";
  else msg = tkWinner == 1 ? "PLAYER 1 WINS" : tkWinner == 2 ? "PLAYER 2 WINS" : "DRAW";
  pt((160 - (int)strlen(msg) * 6) / 2, 16, msg);
  canvas->setTextColor(COL_TEXT);
  char sb[32];
  snprintf(sb, sizeof(sb), tkVsCpu ? "HP left: You %d  CPU %d" : "HP left: P1 %d  P2 %d", tkHp[0], tkHp[1]);
  pt(4, 36, sb);
  if (tkVsCpu) snprintf(sb, sizeof(sb), "You %d  CPU %d  Draws %d", tkSb[0][0], tkSb[0][1], tkSb[0][2]);
  else snprintf(sb, sizeof(sb), "P1 %d  P2 %d  Draws %d", tkSb[1][0], tkSb[1][1], tkSb[1][2]);
  pt(4, 50, sb);
  if (tkVsCpu) {
    pt(4, 64, "Difficulty: ");
    canvas->print(kAiTierNames[g_variant & 3]);
    drawBestLineOver(40, 78);
  } else {
    pt(4, 66, tkFirst == 1 ? "P1 (left) opens next" : "P2 (right) opens next");
  }
  canvas->setCursor(4, 108);
  animPrompt("A/Start: rematch B: back");
  blitScreen();
}

static void tkFinish() {
  tkWinner = (tkHp[0] <= 0 && tkHp[1] <= 0) ? 3 : (tkHp[1] <= 0 ? 1 : 2);
  int m = tkVsCpu ? 0 : 1;
  tkSb[m][tkWinner == 1 ? 0 : (tkWinner == 2 ? 1 : 2)]++;
  s_lastNewBest = false;
  if (tkVsCpu) {
    if (tkWinner == 1 && !tkCustom) recordResult(40, g_variant, tkHp[0] * 10L + 50L * tkSb[0][0], true);
    else if (tkWinner == 1 && tkCustom) {
      lvlRecordRun(LVLGAME_TANK, tkHp[0] * 10L + 50L * tkSb[0][0], true);
      lvlOnClear(LVLGAME_TANK);
    }
  } else {
    tkFirst = (tkFirst == 1) ? 2 : 1;   // the other player opens the rematch
  }
  tkPhase = 3;
  tkPhaseT0 = millis();
  if (tkExR < 14) tkExR = 14;
  sfx(60, 260);
}

static void tkToOver() {
  if (tkWinner == 3) sfx(300, 100);
  else if (tkVsCpu && tkWinner == 2) sfxDeath();
  else { sfxWin(); pixelsWinCelebration(); }
  gameState = ST_TANK_OVER;
  drawTankOverScreen();
}

static void tkFire() {
  int t = tkTurn;
  float a = tkAng[t] * 0.0174533f;
  float v = tkPow[t] * TK_VK;
  int dir = t == 0 ? 1 : -1;
  tkSx = tkX[t] + dir * cosf(a) * 9.0f;
  tkSy = tkSurf[tkX[t]] - 6.0f - sinf(a) * 9.0f;
  tkSvx = dir * cosf(a) * v;
  tkSvy = -sinf(a) * v;
  tkPhase = 1;
  tkFlightT0 = millis();
  tkFlightAcc = 0.0f;
  tkTrN = 0;
  tkTrT = 0;
  tkDmg[0] = tkDmg[1] = 0;
  sfx(180, 70);
}

// The shell lands (or is lost off the side when hit == false).
static void tkImpact(float fx, float fy, bool hit) {
  tkPhase = 2;
  tkPhaseT0 = millis();
  if (!hit) { tkExR = 0; sfx(200, 40); return; }
  int x = (int)fx, y = (int)fy;
  tkExX = x;
  tkExY = y;
  tkExR = 11;
  int big = 0;
  for (int i = 0; i < 2; i++) {
    float dx = (float)tkX[i] - fx, dy = (float)(tkSurf[tkX[i]] - 3) - fy;
    int dm = (int)(48.0f - sqrtf(dx * dx + dy * dy) * 2.8f);
    tkDmg[i] = dm > 0 ? dm : 0;
    tkHp[i] -= tkDmg[i];
    if (tkHp[i] < 0) tkHp[i] = 0;
    if (tkDmg[i] > big) big = tkDmg[i];
  }
  const int R = tkExR;
  for (int dx = -R; dx <= R; dx++) {
    int col = x + dx;
    if (col < 0 || col >= TK_W) continue;
    int h = (int)sqrtf((float)(R * R - dx * dx));
    int top = y - h, bottom = y + h;
    if (top <= (int)tkSurf[col] && bottom > (int)tkSurf[col]) tkSurf[col] = (uint8_t)(bottom > 127 ? 127 : bottom);
  }
  sfx(70, 150);
  if (big >= 25) { sfx(420, 40); pixelsFlash(255, 120, 0, 60); }
}

static void tkNextTurn() {
  tkTurn ^= 1;
  tkWind += mazeRngRange(3) - 1;
  if (tkWind > 5) tkWind = 5;
  if (tkWind < -5) tkWind = -5;
  tkPhase = 0;
  tkRepT = 0;
  if (tkVsCpu && tkTurn == 1) tkCpuPlan();
}

// One frame of Tank Duel (called from loop() after the pause check).
static void tankFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.04f) dt = 0.04f;
  s_lastFrameMs = now;

  if (tkPhase == 0) {
    int t = tkTurn;
    if (tkVsCpu && t == 1) {
      // CPU: animate the dials to the planned values, then fire.
      if (tkAng[1] != tkCpuAng || tkPow[1] != tkCpuPow) {
        if (now - tkRepT >= 28) {
          tkRepT = now;
          if (tkAng[1] < tkCpuAng) tkAng[1] = tkAng[1] + 2 > tkCpuAng ? tkCpuAng : tkAng[1] + 2;
          else if (tkAng[1] > tkCpuAng) tkAng[1] = tkAng[1] - 2 < tkCpuAng ? tkCpuAng : tkAng[1] - 2;
          if (tkPow[1] < tkCpuPow) tkPow[1] = tkPow[1] + 2 > tkCpuPow ? tkCpuPow : tkPow[1] + 2;
          else if (tkPow[1] > tkCpuPow) tkPow[1] = tkPow[1] - 2 < tkCpuPow ? tkCpuPow : tkPow[1] - 2;
        }
      } else if (tkCpuAt == 0) {
        tkCpuAt = now + 450;
      } else if ((long)(now - tkCpuAt) >= 0) {
        tkFire();
      }
    } else {
      const uint32_t DIRS = ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN | ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT;
      uint32_t use = 0;
      if (pressed & DIRS) { use = pressed & DIRS; tkRepT = now + 260; }
      else if ((buttons & DIRS) && (long)(now - tkRepT) >= 0) { use = buttons & DIRS; tkRepT = now + 45; }
      if (use & ARCADA_BUTTONMASK_UP) { if (tkAng[t] < 85) tkAng[t]++; }
      if (use & ARCADA_BUTTONMASK_DOWN) { if (tkAng[t] > 5) tkAng[t]--; }
      if (use & ARCADA_BUTTONMASK_RIGHT) { if (tkPow[t] < 100) tkPow[t]++; }
      if (use & ARCADA_BUTTONMASK_LEFT) { if (tkPow[t] > 10) tkPow[t]--; }
      if ((pressed & DIRS) && !(buttons & ARCADA_BUTTONMASK_A)) sfx((uint16_t)(260 + tkPow[t] * 3), 6);
      if (pressed & ARCADA_BUTTONMASK_A) tkFire();
    }
  } else if (tkPhase == 1) {
    int steps = (int)(dt / 0.01f) + 1;
    float h = dt / (float)steps;
    for (int s = 0; s < steps && tkPhase == 1; s++) {
      tkSvx += tkWind * TK_WINDK * h;
      tkSvy += TK_G * h;
      tkSx += tkSvx * h;
      tkSy += tkSvy * h;
      tkFlightAcc += h;
      if (now - tkTrT >= 30 && tkTrN < TK_TRAIL) {
        tkTrT = now;
        tkTr[tkTrN][0] = (int16_t)tkSx;
        tkTr[tkTrN][1] = (int16_t)tkSy;
        tkTrN++;
      }
      if (tkSx < -40.0f || tkSx >= 200.0f || tkSy > 150.0f || tkFlightAcc > 7.0f) {
        tkImpact(tkSx, tkSy, false);
        break;
      }
      if (tkSx >= 0.0f && tkSx < (float)TK_W) {
        int ix = (int)tkSx;
        bool hit = false;
        for (int i = 0; i < 2 && !hit; i++) {
          if (i == tkTurn && tkFlightAcc < 0.25f) continue;
          int base = tkSurf[tkX[i]];
          if (abs(ix - tkX[i]) <= 5 && tkSy >= (float)(base - 7) && tkSy <= (float)(base + 1)) hit = true;
        }
        if (hit) { tkImpact(tkSx, tkSy, true); break; }
        if (tkSy >= (float)tkSurf[ix]) { tkImpact(tkSx, (float)tkSurf[ix], true); break; }
      }
    }
  } else if (tkPhase == 2) {
    if (now - tkPhaseT0 >= 750) {
      if (tkHp[0] <= 0 || tkHp[1] <= 0) tkFinish();
      else tkNextTurn();
    }
  } else {
    if (now - tkPhaseT0 >= 1300) { tkToOver(); return; }
  }
  drawTankScene();
  blitScreen();
}

// --- Space Blaster -----------------------------------------------------------
//
// Portrait (128x160) vertical shooter. Left/Right move the ship (Up/Down nudge it in the
// lower part of the screen), A fires (hold = autofire), B drops a screen-clearing bomb
// (limited). Waves of enemies in four formations sweep side to side and creep down; every
// 5th wave is a boss. Killed enemies sometimes drop power-ups: S = spread shot (12 s),
// H = shield (absorbs one hit), B = extra bomb. Reaching the bottom or being shot costs a
// life. Wave layouts and drops come from the round seed (both 2P players get the same
// waves). Tiers change enemy speed, fire rate, armor and lives.

#define SB_NE 20
#define SB_NPB 8
#define SB_NEB 10
#define SB_NPU 3
static const char* const kSbPat[4][4] = {
  {".XXXXX.", ".XXXXX.", ".XXXXX.", "......."},
  {"XX...XX", ".XX.XX.", "..XXX..", "...X..."},
  {"X.X.X.X", "X.X.X.X", "X.X.X.X", "X.X.X.X"},
  {"...X...", "..XXX..", ".XXXXX.", "..XXX.."},
};
static int16_t sbEx[SB_NE], sbEy[SB_NE];
static uint8_t sbEhp[SB_NE], sbEdrop[SB_NE];
static float sbGx, sbGy, sbBossX;
static int sbGDir, sbBossDir, sbBossHp, sbBossMax, sbTotal;
static bool sbBoss;
static float pbx[SB_NPB], pby[SB_NPB], pbvx[SB_NPB];
static uint8_t pbOn[SB_NPB];
static float ebx[SB_NEB], eby[SB_NEB], ebvx[SB_NEB], ebvy[SB_NEB];
static uint8_t ebOn[SB_NEB];
static float pux[SB_NPU], puy[SB_NPU];
static uint8_t puT[SB_NPU];
static float sbPx, sbPy, sbSpeedK;
static int sbLives, sbBombs, sbScore, sbWave, sbFireMs, sbBossShots;
static bool sbShield, sbArmor;
static uint8_t sbPhase;                 // 0 play, 1 wave banner, 2 ship exploding
static uint32_t sbSeed, sbClk, sbFireAt, sbEnFireAt, sbInvUntil, sbSpreadUntil, sbPhaseUntil, sbBombFlash, sbBossFireAt;

static uint32_t sbHash(uint32_t x) {
  x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16;
  return x;
}

static void enterBlastTitle() {
  gameState = ST_BLAST_TITLE;
  drawStdTitle("SPACE BLASTER", COL_BLUE, "Left/Right: move ship", "A: fire (hold)  B: bomb", "Turn device to play", 41);
}

static void sbSpawnWave() {
  sbWave++;
  memset(ebOn, 0, sizeof(ebOn));
  memset(sbEhp, 0, sizeof(sbEhp));
  sbBoss = (sbWave % 5 == 0);
  sbGx = 0.0f;
  sbGy = 14.0f;
  sbTotal = 0;
  if (sbBoss) {
    int base = 16 + sbWave * 2;
    int tier = g_variant & 3;
    sbBossMax = sbBossHp = tier == 3 ? base * 13 / 10 : (tier == 2 ? base * 8 / 10 : base);
    sbBossX = 50.0f;
    sbBossDir = 1;
    sbBossFireAt = sbClk + 1200;
    sbBossShots = 0;
    return;
  }
  uint32_t h = sbHash(sbSeed ^ ((uint32_t)sbWave * 2654435761U));
  int pat = sbWave == 1 ? 0 : (int)((h >> 8) & 3);
  sbGDir = (h & 1) ? 1 : -1;
  int n = 0;
  for (int r = 0; r < 4; r++) {
    for (int c = 0; c < 7; c++) {
      if (kSbPat[pat][r][c] != 'X' || n >= SB_NE) continue;
      sbEx[n] = (int16_t)(c * 15);
      sbEy[n] = (int16_t)(r * 12);
      sbEhp[n] = (uint8_t)((sbArmor && r == 0) || (sbWave >= 6 && r == 0) ? 2 : 1);
      uint32_t dh = sbHash(h ^ (uint32_t)(n * 977 + 13));
      sbEdrop[n] = (dh % 100 < 13) ? (uint8_t)(1 + ((dh >> 8) & 1)) : 0;
      n++;
    }
  }
  sbTotal = n;
}

static void enterBlastPlaying() {
  if (portraitGate(enterBlastPlaying, enterBlastTitle)) return;
  s_mazeRng = gameSeed();
  sbSeed = s_mazeRng;
  switch (g_variant & 3) {
    case 1: sbSpeedK = 1.3f; sbFireMs = 800; sbLives = 3; sbArmor = false; break;    // Speed
    case 2: sbSpeedK = 0.75f; sbFireMs = 1500; sbLives = 4; sbArmor = false; break;  // Chill
    case 3: sbSpeedK = 1.5f; sbFireMs = 600; sbLives = 2; sbArmor = true; break;     // Extreme
    default: sbSpeedK = 1.0f; sbFireMs = 1100; sbLives = 3; sbArmor = false; break;
  }
  sbWave = 0;
  sbScore = 0;
  sbBombs = 2;
  sbShield = false;
  sbBoss = false;
  sbPx = 64.0f;
  sbPy = 146.0f;
  memset(pbOn, 0, sizeof(pbOn));
  memset(ebOn, 0, sizeof(ebOn));
  memset(puT, 0, sizeof(puT));
  memset(sbEhp, 0, sizeof(sbEhp));
  sbClk = 0;
  sbFireAt = 0;
  sbEnFireAt = 1500;
  sbInvUntil = 0;
  sbSpreadUntil = 0;
  sbBombFlash = 0;
  sbPhase = 1;
  sbPhaseUntil = 1300;
  s_lastFrameMs = 0;
  gameState = ST_BLAST_PLAYING;
}

static void sbDropPU(float x, float y, uint8_t t) {
  for (int i = 0; i < SB_NPU; i++) {
    if (puT[i] == 0) { puT[i] = t; pux[i] = x; puy[i] = y; return; }
  }
}

static void sbKillEnemy(int i) {
  int row = sbEy[i] / 12;
  sbEhp[i] = 0;
  sbScore += 10 + (3 - row) * 5;
  if (sbEdrop[i]) sbDropPU(14.0f + sbEx[i] + sbGx + 4.0f, sbEy[i] + sbGy, sbEdrop[i]);
  sfx((uint16_t)(500 + row * 80), 12);
}

static void sbBossDown() {
  sbScore += 200 + 20 * sbWave;
  sbBoss = false;
  explosionBurst((int)sbBossX + 14, 24, 26, 0);
  explosionBurst((int)sbBossX + 4, 26, 12, 0);
  screenShake(420, 3);
  sbDropPU(sbBossX + 14.0f, 22.0f, 3);
  sbDropPU(sbBossX + 4.0f, 22.0f, 1);
  sbDropPU(sbBossX + 24.0f, 22.0f, 2);
  memset(ebOn, 0, sizeof(ebOn));
  sfxWin();
  pixelsFlash(255, 200, 0, 80);
}

static void sbHurt() {
  if (sbShield) { sbShield = false; sfx(300, 50); return; }
  if (sbClk < sbInvUntil) return;
  sbLives--;
  sbPhase = 2;
  sbPhaseUntil = sbClk + 900;
  sfxDeath();
  pixelsFlash(255, 0, 0, 80);
}

static void sbGameOver() {
  recordResult(41, g_variant, (long)sbScore, true);
  if (g_twoPlayerMode) {
    twoPHandleGameEnd(sbScore);
  } else {
    gameState = ST_BLAST_OVER;
    char big[12], sub[24];
    snprintf(big, sizeof(big), "%d", sbScore);
    snprintf(sub, sizeof(sub), "reached wave %d", sbWave);
    drawStdOver("SHIP LOST", COL_LASER, big, sub, 41);
  }
}

static void drawBlastScene() {
  uint16_t bg = arcada.display->color565(4, 6, 22);
  canvas->fillScreen(bg);
  for (int i = 0; i < 18; i++) {
    int sy = (i * 31 + (int)(sbClk / (uint32_t)(40 - (i % 3) * 10))) % 160;
    canvas->drawPixel((i * 53 + 11) % 128, sy, i % 3 == 0 ? COL_TEXT : COL_WALL);
  }
  uint16_t rowCol[4] = {COL_LASER, COL_ORANGE, COL_KEY, COL_GOAL};
  for (int i = 0; i < SB_NE; i++) {
    if (!sbEhp[i]) continue;
    int x = (int)(14.0f + sbEx[i] + sbGx), y = (int)(sbEy[i] + sbGy);
    uint16_t c = rowCol[(sbEy[i] / 12) & 3];
    canvas->fillRect(x, y, 9, 5, c);
    canvas->fillRect(x + 1, y + 5, 2, 2, c);
    canvas->fillRect(x + 6, y + 5, 2, 2, c);
    canvas->fillRect(x + 2, y + 1, 2, 2, bg);
    canvas->fillRect(x + 5, y + 1, 2, 2, bg);
    if (sbEhp[i] > 1) canvas->drawRect(x - 1, y - 1, 11, 7, COL_TEXT);
  }
  if (sbBoss) {
    int bx = (int)sbBossX;
    canvas->fillRect(bx, 18, 28, 10, COL_LASER);
    canvas->fillRect(bx + 4, 28, 4, 4, COL_LASER);
    canvas->fillRect(bx + 20, 28, 4, 4, COL_LASER);
    canvas->fillRect(bx + 6, 21, 4, 4, COL_KEY);
    canvas->fillRect(bx + 18, 21, 4, 4, COL_KEY);
    canvas->drawRect(14, 11, 100, 4, COL_WALL);
    canvas->fillRect(15, 12, sbBossHp * 98 / (sbBossMax > 0 ? sbBossMax : 1), 2, COL_ORANGE);
  }
  for (int i = 0; i < SB_NPB; i++) if (pbOn[i]) canvas->fillRect((int)pbx[i] - 1, (int)pby[i], 2, 5, COL_PLAYER);
  for (int i = 0; i < SB_NEB; i++) if (ebOn[i]) canvas->fillRect((int)ebx[i] - 1, (int)eby[i], 3, 4, COL_ORANGE);
  for (int i = 0; i < SB_NPU; i++) {
    if (!puT[i]) continue;
    uint16_t c = puT[i] == 1 ? COL_KEY : (puT[i] == 2 ? COL_ICE : COL_GOAL);
    int x = (int)pux[i] - 4, y = (int)puy[i] - 4;
    canvas->fillRect(x, y, 9, 9, c);
    ptc(bg, x + 2, y + 1, puT[i] == 1 ? "S" : (puT[i] == 2 ? "H" : "B"));
  }
  if (sbPhase != 2) {
    bool blink = sbClk < sbInvUntil && ((sbClk / 90) & 1);
    if (!blink) {
      int px = (int)sbPx, py = (int)sbPy;
      canvas->fillTriangle(px, py - 8, px - 6, py + 5, px + 6, py + 5, COL_PLAYER);
      canvas->fillRect(px - 1, py - 2, 3, 6, COL_BLUE);
      if (sbShield) canvas->drawCircle(px, py, 11, COL_ICE);
    }
  } else {
    int r = (int)((sbClk + 900 - sbPhaseUntil) / 25);
    if (r > 0 && r < 20) {
      canvas->fillCircle((int)sbPx, (int)sbPy, r, COL_KEY);
      canvas->drawCircle((int)sbPx, (int)sbPy, r + 2, COL_ORANGE);
    }
  }
  if (sbClk < sbBombFlash) canvas->drawRect(0, 0, 128, 160, COL_TEXT);
  // HUD
  canvas->setTextSize(1);
  char t[16];
  canvas->setTextColor(COL_TEXT);
  snprintf(t, sizeof(t), "SC %d", sbScore);
  pt(2, 2, t);
  snprintf(t, sizeof(t), "W%d", sbWave);
  pt(60, 2, t);
  canvas->setTextColor(COL_PLAYER);
  snprintf(t, sizeof(t), "L%d", sbLives);
  pt(82, 2, t);
  canvas->setTextColor(COL_GOAL);
  snprintf(t, sizeof(t), "B%d", sbBombs);
  pt(102, 2, t);
  if (sbClk < sbSpreadUntil) {
    ptc(COL_KEY, 2, 151, "S");
  }
  if (sbPhase == 1) {
    canvas->setTextSize(2);
    canvas->setTextColor(COL_ORANGE);
    int w = sbWave + 1;
    canvas->setCursor(w % 5 == 0 ? 22 : 28, 66);
    if (w % 5 == 0) canvas->print("BOSS W");
    else canvas->print("WAVE ");
    canvas->print(w);
    canvas->setTextSize(1);
  }
  particlesUpdateDraw();
}

// One frame of Space Blaster (called from loop() after the pause check; buttons are
// already in the portrait screen frame).
static void blastFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;
  sbClk += (uint32_t)(dt * 1000.0f + 0.5f);

  if (sbPhase == 2) {
    if ((long)(sbClk - sbPhaseUntil) >= 0) {
      if (sbLives <= 0) { sbGameOver(); return; }
      sbPhase = 0;
      sbPx = 64.0f;
      sbPy = 146.0f;
      sbInvUntil = sbClk + 2200;
      sbSpreadUntil = 0;
      memset(ebOn, 0, sizeof(ebOn));
    }
    drawBlastScene();
    blitScreen();
    return;
  }
  if (sbPhase == 1 && (long)(sbClk - sbPhaseUntil) >= 0) {
    sbSpawnWave();
    sbPhase = 0;
    sbEnFireAt = sbClk + 900;
  }

  // --- ship ---
  if (buttons & ARCADA_BUTTONMASK_LEFT) sbPx -= 95.0f * dt;
  if (buttons & ARCADA_BUTTONMASK_RIGHT) sbPx += 95.0f * dt;
  if (buttons & ARCADA_BUTTONMASK_UP) sbPy -= 60.0f * dt;
  if (buttons & ARCADA_BUTTONMASK_DOWN) sbPy += 60.0f * dt;
  if (sbPx < 7.0f) sbPx = 7.0f;
  if (sbPx > 121.0f) sbPx = 121.0f;
  if (sbPy < 112.0f) sbPy = 112.0f;
  if (sbPy > 148.0f) sbPy = 148.0f;
  if ((buttons & ARCADA_BUTTONMASK_A) && sbClk >= sbFireAt) {
    bool spread = sbClk < sbSpreadUntil;
    int shots = spread ? 3 : 1;
    for (int k = 0; k < shots; k++) {
      for (int i = 0; i < SB_NPB; i++) {
        if (pbOn[i]) continue;
        pbOn[i] = 1;
        pbx[i] = sbPx;
        pby[i] = sbPy - 9.0f;
        pbvx[i] = spread ? (k - 1) * 40.0f : 0.0f;
        break;
      }
    }
    sbFireAt = sbClk + (spread ? 230 : 190);
    sfx(spread ? 1250 : 1000, 6);
  }
  if ((pressed & ARCADA_BUTTONMASK_B) && sbBombs > 0 && sbPhase != 1) {
    sbBombs--;
    sbBombFlash = sbClk + 250;
    memset(ebOn, 0, sizeof(ebOn));
    for (int i = 0; i < SB_NE; i++) if (sbEhp[i]) sbKillEnemy(i);
    if (sbBoss) {
      sbBossHp -= 12;
      if (sbBossHp <= 0) sbBossDown();
    }
    sfx(120, 220);
    pixelsFlash(255, 255, 255, 90);
  } else if ((pressed & ARCADA_BUTTONMASK_B) && sbBombs <= 0) {
    sfxBlocked();
  }

  // --- player bullets ---
  for (int i = 0; i < SB_NPB; i++) {
    if (!pbOn[i]) continue;
    pby[i] -= 210.0f * dt;
    pbx[i] += pbvx[i] * dt;
    if (pby[i] < -6.0f || pbx[i] < 0.0f || pbx[i] > 128.0f) { pbOn[i] = 0; continue; }
    bool used = false;
    for (int e = 0; e < SB_NE && !used; e++) {
      if (!sbEhp[e]) continue;
      float ex = 14.0f + sbEx[e] + sbGx, ey = sbEy[e] + sbGy;
      if (pbx[i] >= ex - 1.0f && pbx[i] <= ex + 10.0f && pby[i] >= ey - 1.0f && pby[i] <= ey + 7.0f) {
        used = true;
        if (sbEhp[e] > 1) { sbEhp[e]--; sfx(300, 10); }
        else sbKillEnemy(e);
      }
    }
    if (!used && sbBoss && pbx[i] >= sbBossX && pbx[i] <= sbBossX + 28.0f && pby[i] >= 17.0f && pby[i] <= 32.0f) {
      used = true;
      sbBossHp--;
      sfx(260, 8);
      if (sbBossHp <= 0) sbBossDown();
    }
    if (used) pbOn[i] = 0;
  }

  // --- enemies ---
  int alive = 0;
  float minX = 1000.0f, maxX = -1000.0f, maxY = 0.0f;
  for (int i = 0; i < SB_NE; i++) {
    if (!sbEhp[i]) continue;
    alive++;
    float ex = 14.0f + sbEx[i] + sbGx;
    if (ex < minX) minX = ex;
    if (ex + 9.0f > maxX) maxX = ex + 9.0f;
    float ey = sbEy[i] + sbGy + 7.0f;
    if (ey > maxY) maxY = ey;
  }
  if (alive > 0) {
    float spd = 20.0f * sbSpeedK * (1.0f + 0.05f * (sbWave > 12 ? 12 : sbWave));
    spd *= 1.0f + 0.6f * (1.0f - (float)alive / (float)(sbTotal > 0 ? sbTotal : 1));
    sbGx += sbGDir * spd * dt;
    if (maxX + sbGDir * spd * dt > 126.0f && sbGDir > 0) { sbGDir = -1; sbGy += 5.0f; }
    else if (minX + sbGDir * spd * dt < 2.0f && sbGDir < 0) { sbGDir = 1; sbGy += 5.0f; }
    for (int i = 0; i < SB_NE; i++) {   // reached the bottom: costs a life
      if (!sbEhp[i]) continue;
      if (sbEy[i] + sbGy + 7.0f >= 136.0f) { sbEhp[i] = 0; sbHurt(); if (sbPhase == 2) break; }
    }
    // enemy fire
    if (sbPhase == 0 && sbClk >= sbEnFireAt) {
      float wk = 1.0f + 0.04f * (sbWave > 15 ? 15 : sbWave);
      sbEnFireAt = sbClk + (uint32_t)((float)sbFireMs / wk) + (uint32_t)mazeRngRange(sbFireMs / 3 + 1);
      int pick = mazeRngRange(alive), idx = -1;
      for (int i = 0; i < SB_NE; i++) {
        if (!sbEhp[i]) continue;
        if (pick-- == 0) { idx = i; break; }
      }
      if (idx >= 0) {
        for (int b = 0; b < SB_NEB; b++) {
          if (ebOn[b]) continue;
          ebOn[b] = 1;
          ebx[b] = 14.0f + sbEx[idx] + sbGx + 4.0f;
          eby[b] = sbEy[idx] + sbGy + 8.0f;
          ebvy[b] = 62.0f * sbSpeedK * (1.0f + 0.03f * (sbWave > 15 ? 15 : sbWave));
          ebvx[b] = mazeRngRange(4) == 0 ? (sbPx - ebx[b]) * 0.18f : 0.0f;
          break;
        }
      }
    }
  }
  if (sbBoss) {
    sbBossX += sbBossDir * 52.0f * sbSpeedK * dt;
    if (sbBossX < 4.0f) { sbBossX = 4.0f; sbBossDir = 1; }
    if (sbBossX > 96.0f) { sbBossX = 96.0f; sbBossDir = -1; }
    if (sbPhase == 0 && sbClk >= sbBossFireAt) {
      sbBossFireAt = sbClk + (uint32_t)(sbFireMs * 4 / 5);
      sbBossShots++;
      for (int k = 0; k < 3; k++) {
        for (int b = 0; b < SB_NEB; b++) {
          if (ebOn[b]) continue;
          ebOn[b] = 1;
          ebx[b] = sbBossX + 14.0f;
          eby[b] = 32.0f;
          ebvy[b] = 70.0f * sbSpeedK;
          ebvx[b] = (k - 1) * 32.0f + ((sbBossShots & 1) ? 12.0f : 0.0f);
          break;
        }
      }
      sfx(220, 20);
    }
  }
  // wave cleared?
  if (sbPhase == 0 && alive == 0 && !sbBoss) {
    sbScore += 25 + sbWave * 5;
    sbPhase = 1;
    sbPhaseUntil = sbClk + 1500;
    sfx(880, 60);
  }

  // --- enemy bullets ---
  for (int i = 0; i < SB_NEB; i++) {
    if (!ebOn[i]) continue;
    eby[i] += ebvy[i] * dt;
    ebx[i] += ebvx[i] * dt;
    if (eby[i] > 162.0f || ebx[i] < -4.0f || ebx[i] > 132.0f) { ebOn[i] = 0; continue; }
    if (sbPhase == 0 && fabsf(ebx[i] - sbPx) < 6.0f && eby[i] + 4.0f >= sbPy - 7.0f && eby[i] <= sbPy + 5.0f) {
      ebOn[i] = 0;
      sbHurt();
    }
  }
  // --- ship touching an enemy ---
  if (sbPhase == 0) {
    for (int i = 0; i < SB_NE; i++) {
      if (!sbEhp[i]) continue;
      float ex = 14.0f + sbEx[i] + sbGx, ey = sbEy[i] + sbGy;
      if (sbPx + 6.0f > ex && sbPx - 6.0f < ex + 9.0f && sbPy + 5.0f > ey && sbPy - 7.0f < ey + 7.0f) {
        sbEhp[i] = 0;
        sbHurt();
        break;
      }
    }
    if (sbBoss && sbPx + 6.0f > sbBossX && sbPx - 6.0f < sbBossX + 28.0f && sbPy - 7.0f < 32.0f) sbHurt();
  }
  // --- power-ups ---
  for (int i = 0; i < SB_NPU; i++) {
    if (!puT[i]) continue;
    puy[i] += 40.0f * dt;
    if (puy[i] > 164.0f) { puT[i] = 0; continue; }
    if (sbPhase != 2 && fabsf(pux[i] - sbPx) < 11.0f && fabsf(puy[i] - sbPy) < 11.0f) {
      if (puT[i] == 1) sbSpreadUntil = sbClk + 12000;
      else if (puT[i] == 2) sbShield = true;
      else if (sbBombs < 5) sbBombs++;
      puT[i] = 0;
      sfx(1100, 30);
    }
  }
  drawBlastScene();
  blitScreen();
}

// --- Tower Stack -------------------------------------------------------------
//
// Portrait (128x160) timing game. A block slides left/right above the tower; A (or B)
// drops it. Whatever overhangs the block below is sliced off, so the tower narrows; a
// drop within a couple of pixels is PERFECT: no slicing, a growing combo bonus, and
// after 3 in a row the block grows back a little. The camera scrolls down as the tower
// grows. Over when a drop misses the tower completely. Score = floors + combo bonuses.
// Block colors and the first slide direction come from the round seed (2P fairness).
// Tiers set the start width, tolerance and how fast the slide ramps up.

#define TS_H 8
#define TS_BASEY 100
#define TS_RING 14
static int16_t tsBx[TS_RING], tsBw[TS_RING];
static int tsN, tsFloors, tsScore, tsCombo, tsBestCombo, tsW0, tsHue, tsTol, tsFallW;
static float tsMx, tsMw, tsVx, tsV0, tsRamp, tsCap, tsScroll, tsFallX, tsFallY, tsFallVy;
static bool tsDead, tsFall;
static unsigned long tsFlashUntil, tsOverAt;

static void enterTowerTitle() {
  gameState = ST_TOWER_TITLE;
  drawStdTitle("TOWER STACK", COL_ORANGE, "A: drop the block", "Stack it straight up", "Turn device to play", 42);
}

static uint16_t tsColor(int f) {
  int h = ((tsHue + f * 9) % 360 + 360) % 360;
  int sec = h / 60, fr = (h % 60) * 255 / 60;
  const int v = 235, p = 82;
  int q = v - (v - p) * fr / 255, tt = p + (v - p) * fr / 255;
  int r, g, b;
  switch (sec) {
    case 0: r = v; g = tt; b = p; break;
    case 1: r = q; g = v; b = p; break;
    case 2: r = p; g = v; b = tt; break;
    case 3: r = p; g = q; b = v; break;
    case 4: r = tt; g = p; b = v; break;
    default: r = v; g = p; b = q; break;
  }
  return arcada.display->color565((uint8_t)r, (uint8_t)g, (uint8_t)b);
}

static void tsNewMover() {
  tsMw = (float)tsBw[0];
  float spd = tsV0 + tsRamp * tsFloors;
  if (spd > tsCap) spd = tsCap;
  bool fromLeft = (tsFloors & 1) == 0;
  tsMx = fromLeft ? 0.0f : 128.0f - tsMw;
  tsVx = fromLeft ? spd : -spd;
}

static void enterTowerPlaying() {
  if (portraitGate(enterTowerPlaying, enterTowerTitle)) return;
  s_mazeRng = gameSeed();
  tsHue = mazeRngRange(360);
  switch (g_variant & 3) {
    case 1: tsW0 = 48; tsV0 = 80.0f; tsRamp = 2.6f; tsCap = 200.0f; tsTol = 2; break;   // Speed
    case 2: tsW0 = 64; tsV0 = 45.0f; tsRamp = 1.3f; tsCap = 110.0f; tsTol = 3; break;   // Chill
    case 3: tsW0 = 40; tsV0 = 95.0f; tsRamp = 3.2f; tsCap = 240.0f; tsTol = 1; break;   // Extreme
    default: tsW0 = 56; tsV0 = 60.0f; tsRamp = 2.0f; tsCap = 150.0f; tsTol = 2; break;
  }
  tsN = 1;
  tsBx[0] = (int16_t)((128 - tsW0) / 2);
  tsBw[0] = (int16_t)tsW0;
  tsFloors = 0;
  tsScore = 0;
  tsCombo = 0;
  tsBestCombo = 0;
  tsScroll = 0.0f;
  tsDead = false;
  tsFall = false;
  tsFlashUntil = 0;
  tsNewMover();
  s_lastFrameMs = 0;
  gameState = ST_TOWER_PLAYING;
}

static void tsStartFall(int x, int w) {
  if (w <= 0) return;
  tsFall = true;
  tsFallX = (float)x;
  tsFallW = w;
  tsFallY = (float)(TS_BASEY - TS_H) + tsScroll;
  tsFallVy = 0.0f;
}

static void tsDrop() {
  int tx = tsBx[0], tw = tsBw[0];
  int mx = (int)(tsMx + 0.5f), mw = (int)(tsMw + 0.5f);
  int l = mx > tx ? mx : tx;
  int r = (mx + mw) < (tx + tw) ? (mx + mw) : (tx + tw);
  int ov = r - l;
  if (ov <= 0) {   // missed the tower completely
    tsStartFall(mx, mw);
    tsDead = true;
    tsOverAt = millis() + 900;
    sfxDeath();
    pixelsFlash(255, 0, 0, 60);
    return;
  }
  int nx, nw;
  bool perfect = abs(mx - tx) <= tsTol;
  if (perfect) {
    nx = tx;
    nw = tw;
    tsCombo++;
    if (tsCombo > tsBestCombo) tsBestCombo = tsCombo;
    tsScore += 1 + (tsCombo > 6 ? 6 : tsCombo);
    if (tsCombo >= 3 && nw < tsW0) {   // a streak grows the block back a little
      nx -= 1;
      nw += 2;
      if (nx < 0) nx = 0;
      if (nx + nw > 128) nx = 128 - nw;
    }
    tsFlashUntil = millis() + 500;
    particlesBurst(nx + nw / 2, TS_BASEY, 10 + (tsCombo > 6 ? 6 : tsCombo), 0);
    sfx((uint16_t)(520 + (tsCombo > 8 ? 8 : tsCombo) * 70), 45);
  } else {
    nx = l;
    nw = ov;
    tsCombo = 0;
    tsScore += 1;
    if (mx < tx) tsStartFall(mx, tx - mx);
    else tsStartFall(tx + tw, (mx + mw) - (tx + tw));
    sfx(240, 35);
  }
  for (int i = TS_RING - 1; i > 0; i--) { tsBx[i] = tsBx[i - 1]; tsBw[i] = tsBw[i - 1]; }
  tsBx[0] = (int16_t)nx;
  tsBw[0] = (int16_t)nw;
  if (tsN < TS_RING) tsN++;
  tsFloors++;
  tsScroll = -(float)TS_H;
  tsNewMover();
}

static void drawTowerScene() {
  uint16_t bg = arcada.display->color565(8, 10, 26);
  canvas->fillScreen(bg);
  for (int i = 0; i < 14; i++)
    canvas->drawPixel((i * 41 + 9) % 128, (i * 37 + tsFloors * 3) % 160, i % 2 ? COL_WALL : COL_TEXT);
  int sc = (int)tsScroll;
  uint16_t guide = arcada.display->color565(40, 44, 70);
  if (!tsDead) {
    canvas->drawFastVLine(tsBx[0], 0, TS_BASEY + sc, guide);
    canvas->drawFastVLine(tsBx[0] + tsBw[0] - 1, 0, TS_BASEY + sc, guide);
  }
  for (int k = 0; k < tsN; k++) {
    int y = TS_BASEY + k * TS_H + sc;
    if (y >= 160) break;
    uint16_t c = tsColor(tsFloors - k);
    canvas->fillRect(tsBx[k], y, tsBw[k], TS_H - 1, c);
    canvas->drawFastHLine(tsBx[k], y, tsBw[k], COL_TEXT);
  }
  if (!tsDead) {
    canvas->fillRect((int)(tsMx + 0.5f), TS_BASEY - TS_H + sc, (int)(tsMw + 0.5f), TS_H - 1, tsColor(tsFloors + 1));
    canvas->drawFastHLine((int)(tsMx + 0.5f), TS_BASEY - TS_H + sc, (int)(tsMw + 0.5f), COL_TEXT);
  }
  if (tsFall) canvas->fillRect((int)tsFallX, (int)tsFallY, tsFallW, TS_H - 1, tsColor(tsFloors));
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  char t[20];
  snprintf(t, sizeof(t), "SCORE %d", tsScore);
  pt(2, 2, t);
  int32_t bs = saveBest(42, saveTierOf(g_variant));
  canvas->setTextColor(COL_KEY);
  snprintf(t, sizeof(t), "BEST %d", bs == SAVE_NO_SCORE ? 0 : (int)bs);
  pt(70, 2, t);
  if (tsCombo > 1) {
    canvas->setTextColor(COL_GOAL);
    snprintf(t, sizeof(t), "COMBO x%d", tsCombo);
    pt(2, 11, t);
  }
  if (millis() < tsFlashUntil) {
    canvas->setTextSize(2);
    ptc(COL_KEY, 16, 40, "PERFECT!");
    canvas->setTextSize(1);
  }
  particlesUpdateDraw();
}

// One frame of Tower Stack (called from loop() after the pause check).
static void towerFrame(uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;

  if (tsScroll < 0.0f) {
    tsScroll += (0.0f - tsScroll) * (dt * 14.0f > 1.0f ? 1.0f : dt * 14.0f);
    if (tsScroll > -0.5f) tsScroll = 0.0f;
  }
  if (tsFall) {
    tsFallVy += 420.0f * dt;
    tsFallY += tsFallVy * dt;
    if (tsFallY > 165.0f) tsFall = false;
  }
  if (tsDead) {
    if ((long)(now - tsOverAt) >= 0) {
      recordResult(42, g_variant, (long)tsScore, true);
      if (g_twoPlayerMode) {
        twoPHandleGameEnd(tsScore);
      } else {
        gameState = ST_TOWER_OVER;
        char big[12], sub[24];
        snprintf(big, sizeof(big), "%d", tsScore);
        snprintf(sub, sizeof(sub), "%d floors  combo x%d", tsFloors, tsBestCombo);
        drawStdOver("TOWER FELL", COL_LASER, big, sub, 42);
      }
      return;
    }
  } else {
    tsMx += tsVx * dt;
    if (tsMx < 0.0f) { tsMx = 0.0f; tsVx = fabsf(tsVx); }
    if (tsMx > 128.0f - tsMw) { tsMx = 128.0f - tsMw; tsVx = -fabsf(tsVx); }
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B)) tsDrop();
  }
  drawTowerScene();
  blitScreen();
}

// --- Slide 15 ----------------------------------------------------------------
//
// The classic sliding-tile puzzle. The D-pad moves the tile NEXT to the gap toward the
// gap in the direction you press (Left slides the tile on the right of the gap to the
// left, and so on); the slide is animated (~80 ms) and one extra press is buffered.
// Scrambled by random legal moves from the solved board using the round seed, so it is
// always solvable and 2P player 2 gets the identical scramble. Score = moves (fewer is
// better). Tiers: NORMAL 4x4, SPEED 3x3, CHILL 5x5 (variant order matches the Mode
// line), EXTREME 4x4 with a long scramble and a 5 minute limit.

#define SL_ANIM_MS 80
static uint8_t slBd[25];
static uint8_t slN;
static int slEmpty, slMoves, slAnimFrom, slAnimTo, slAnimTile, slHeldDir, slQueue;
static bool slWon, slTimeUp, slEnding;
static unsigned long slTimeMs, slLimitMs, slAnimT0, slEndAt, slRepT;
static const char* const kSlModes[4] = {"4x4 CLASSIC", "3x3 EASY", "5x5 BIG", "4x4 TIMED HARD"};

static void enterSlideTitle() {
  gameState = ST_SLIDE_TITLE;
  drawStdTitleEx("SLIDE 15", COL_BLUE, "Slide tiles into order", "D-pad: tile toward gap", "Fewest moves wins", 43,
                 kSlModes[g_variant & 3]);
}

// dir: 1 = Left, 2 = Right, 3 = Up, 4 = Down (the direction the tile moves).
static bool slMove(int dir, bool animate) {
  int e = slEmpty, c = e % slN, r = e / slN, src = -1;
  if (dir == 1 && c < slN - 1) src = e + 1;
  else if (dir == 2 && c > 0) src = e - 1;
  else if (dir == 3 && r < slN - 1) src = e + slN;
  else if (dir == 4 && r > 0) src = e - slN;
  if (src < 0) return false;
  if (animate) {
    slAnimTile = slBd[src];
    slAnimFrom = src;
    slAnimTo = e;
    slAnimT0 = millis();
  }
  slBd[e] = slBd[src];
  slBd[src] = 0;
  slEmpty = src;
  return true;
}

static bool slSolved() {
  int n = slN * slN;
  for (int i = 0; i < n - 1; i++) if (slBd[i] != i + 1) return false;
  return slBd[n - 1] == 0;
}

static void enterSlidePlaying() {
  s_mazeRng = gameSeed();
  int tier = g_variant & 3, shuffles;
  switch (tier) {
    case 1: slN = 3; shuffles = 70; break;
    case 2: slN = 5; shuffles = 260; break;
    case 3: slN = 4; shuffles = 420; break;
    default: slN = 4; shuffles = 160; break;
  }
  int n = slN * slN;
  for (int i = 0; i < n - 1; i++) slBd[i] = (uint8_t)(i + 1);
  slBd[n - 1] = 0;
  slEmpty = n - 1;
  int prev = 0, rejects = 0;
  for (int k = 0; k < shuffles || slSolved(); k++) {
    int d = 1 + mazeRngRange(4);
    int opp = prev == 1 ? 2 : prev == 2 ? 1 : prev == 3 ? 4 : prev == 4 ? 3 : 0;
    if (d == opp || !slMove(d, false)) { if (++rejects > 4000) break; k--; continue; }
    prev = d;
  }
  slMoves = 0;
  slAnimFrom = slAnimTo = -1;
  slAnimTile = 0;
  slHeldDir = 0;
  slQueue = 0;
  slWon = slTimeUp = slEnding = false;
  slTimeMs = 0;
  slLimitMs = tier == 3 ? 300000UL : 0UL;
  slRepT = 0;
  s_lastFrameMs = 0;
  gameState = ST_SLIDE_PLAYING;
}

static void drawSlideScene() {
  unsigned long now = millis();
  canvas->fillScreen(COL_BG);
  const int cell = slN == 3 ? 34 : (slN == 4 ? 28 : 22);
  const int ox = 4, oy = 14;
  uint16_t gap = arcada.display->color565(24, 26, 40);
  canvas->fillRect(ox - 1, oy - 1, slN * cell + 2, slN * cell + 2, gap);
  bool animating = slAnimTo >= 0 && now - slAnimT0 < SL_ANIM_MS;
  for (int i = 0; i < slN * slN; i++) {
    int v = slBd[i];
    if (v == 0) continue;
    int x = ox + (i % slN) * cell, y = oy + (i / slN) * cell;
    if (animating && i == slAnimTo) {
      float k = (float)(now - slAnimT0) / (float)SL_ANIM_MS;   // 0 -> 1
      int fx = ox + (slAnimFrom % slN) * cell, fy = oy + (slAnimFrom / slN) * cell;
      x = fx + (int)((x - fx) * k);
      y = fy + (int)((y - fy) * k);
    }
    uint16_t c = (v == i + 1) ? COL_GOAL : COL_BLUE;
    canvas->fillRect(x + 1, y + 1, cell - 2, cell - 2, c);
    char t[4];
    snprintf(t, sizeof(t), "%d", v);
    int sz = slN == 5 ? 1 : 2;
    int tw = (int)strlen(t) * 6 * sz, th = 7 * sz;
    canvas->setTextSize(sz);
    ptc(COL_BG, x + (cell - tw) / 2, y + (cell - th) / 2, t);
  }
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 4, 3, "SLIDE 15");
  ptc(COL_TEXT, 122, 14, "MOVES");
  canvas->setTextSize(2);
  ptc(COL_KEY, 122, 24, slMoves);
  canvas->setTextSize(1);
  ptc(COL_TEXT, 122, 46, slLimitMs ? "LEFT" : "TIME");
  unsigned long sec = slLimitMs ? (slTimeMs >= slLimitMs ? 0UL : (slLimitMs - slTimeMs) / 1000UL) : slTimeMs / 1000UL;
  char tm[12];
  snprintf(tm, sizeof(tm), "%lu:%02lu", sec / 60UL, sec % 60UL);
  ptc(slLimitMs && sec < 30 ? COL_LASER : COL_ICE, 122, 56, tm);
  int32_t bs = saveBest(43, saveTierOf(g_variant));
  ptc(COL_TEXT, 122, 74, "BEST");
  pt(122, 84, bs == SAVE_NO_SCORE ? "--" : "");
  if (bs != SAVE_NO_SCORE) canvas->print((int)bs);
  ptc(COL_WALL, 122, 112, slN == 3 ? "3x3" : (slN == 4 ? "4x4" : "5x5"));
}

static void slToOver() {
  long score = slWon ? (long)slMoves : 9999L;
  if (slWon) { sfxWin(); pixelsWinCelebration(); } else sfxDeath();
  if (g_twoPlayerMode) {
    twoPHandleGameEnd(score);
    return;
  }
  gameState = ST_SLIDE_OVER;
  char big[12], sub[24];
  unsigned long sec = slTimeMs / 1000UL;
  if (slWon) {
    snprintf(big, sizeof(big), "%d", slMoves);
    snprintf(sub, sizeof(sub), "moves in %lu:%02lu", sec / 60UL, sec % 60UL);
  } else {
    snprintf(big, sizeof(big), "--");
    snprintf(sub, sizeof(sub), "ran out of time");
  }
  drawStdOver(slWon ? "SOLVED!" : "TIME UP", slWon ? COL_GOAL : COL_LASER, big, sub, 43);
}

// One frame of Slide 15 (called from loop() after the pause check).
static void slideFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  unsigned long dtms = (s_lastFrameMs == 0) ? 16UL : now - s_lastFrameMs;
  if (dtms > 100UL) dtms = 100UL;
  s_lastFrameMs = now;
  if (slEnding) {
    if ((long)(now - slEndAt) >= 0) { slToOver(); return; }
    drawSlideScene();
    blitScreen();
    return;
  }
  slTimeMs += dtms;
  if (slLimitMs && slTimeMs >= slLimitMs) {
    slTimeUp = true;
    slEnding = true;
    slEndAt = now + 700;
    sfx(150, 150);
  } else {
    bool animating = slAnimTo >= 0 && now - slAnimT0 < SL_ANIM_MS;
    if (!animating) slAnimTo = -1;
    int dir = 0;
    if (pressed & ARCADA_BUTTONMASK_LEFT) dir = 1;
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) dir = 2;
    else if (pressed & ARCADA_BUTTONMASK_UP) dir = 3;
    else if (pressed & ARCADA_BUTTONMASK_DOWN) dir = 4;
    int held = (buttons & ARCADA_BUTTONMASK_LEFT) ? 1 : (buttons & ARCADA_BUTTONMASK_RIGHT) ? 2 :
               (buttons & ARCADA_BUTTONMASK_UP) ? 3 : (buttons & ARCADA_BUTTONMASK_DOWN) ? 4 : 0;
    bool fresh = dir != 0;
    if (dir) slRepT = now + 280;
    else if (held && (long)(now - slRepT) >= 0) { dir = held; slRepT = now + 120; }
    if (dir && animating) { slQueue = dir; dir = 0; }
    if (!dir && !animating && slQueue) { dir = slQueue; slQueue = 0; fresh = true; }
    if (dir) {
      if (slMove(dir, true)) {
        slMoves++;
        sfx(520, 10);
        if (slSolved()) {
          slWon = true;
          slEnding = true;
          slEndAt = now + SL_ANIM_MS + 450;
          recordResult(43, g_variant, (long)slMoves, false);
        }
      } else if (fresh) {
        sfxBlocked();
      }
    }
  }
  drawSlideScene();
  blitScreen();
}

// --- Plinko ------------------------------------------------------------------
//
// A peg board (9 staggered rows) over 9 value pockets. Left/Right slides the drop point,
// A (or B) releases a disc. Fixed-step physics: a 5 ms-step accumulator carries the
// remainder across frames (max 12 steps per frame, excess dropped), so the step sequence
// never depends on frame timing. Gravity, elastic bounces off the pegs with a little jitter
// that is a hash of (seed, drop number, collision count) - not a shared RNG stream - so the
// same seed + same drop x gives identical bounces for the 2P replay; side walls; then the
// pocket under the disc scores. The 7 s fall safety net counts simulated steps (pause-safe).
// Tiers change the disc count, pocket values, bounciness and jitter.

#define PL_X0 8
#define PL_X1 152
#define PL_ROWS 9
#define PL_Y0 26
#define PL_DY 8
#define PL_POCKET_Y 97
static float plAim, plDx, plDy, plVx, plVy, plSx, plBounce, plJit;
static int plLeft, plN, plScore, plPocket, plLastVal, plTier;
static uint8_t plPhase;   // 0 aim, 1 falling, 2 settling into a pocket, 3 round over
static unsigned long plT0, plFallN, plSfxAt, plEndAt;
static float plAcc;
static uint32_t plSeed, plDrop, plHit;
static const int16_t kPlVals[4][9] = {
  {0, 1, 5, 10, 50, 10, 5, 1, 0},
  {0, 2, 10, 20, 90, 20, 10, 2, 0},
  {1, 2, 5, 10, 25, 10, 5, 2, 1},
  {0, 5, 25, 50, 99, 50, 25, 5, 0},
};
static const uint8_t kPlDiscs[4] = {10, 8, 12, 6};
static const float kPlBounce[4] = {0.55f, 0.60f, 0.45f, 0.70f};
static const float kPlJitter[4] = {14.0f, 20.0f, 8.0f, 28.0f};
static const char* const kPlModes[4] = {"10 DISCS CLASSIC", "8 DISCS BIG PAY", "12 DISCS EASY", "6 DISCS WILD"};

// Peg table: plPeg[row][k] = 0 none, 1 peg, 2 bumper (livelier bounce). Peg x = (row odd ? 16 : 8) + 16*k.
// The standard board fills it at round start; a level-creator layout (9x9 grid, same indexing) replaces it.
static uint8_t plPeg[PL_ROWS][9];
static bool plCustom = false;

static void plStdPegs() {
  for (int r = 0; r < PL_ROWS; r++)
    for (int k = 0; k < 9; k++) plPeg[r][k] = (uint8_t)(((r & 1) || k >= 1) ? 1 : 0);
}

static bool plinkoValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  if (lvlCountTile(lvl, 1) + lvlCountTile(lvl, 2) < 10) { snprintf(msg, msgLen, "Need at least 10 pegs"); return false; }
  return true;
}

static void plinkoLoadCustom(const LevelData *lvl) {
  memset(plPeg, 0, sizeof(plPeg));
  for (int r = 0; r < PL_ROWS && r < lvl->h; r++)
    for (int k = 0; k < 9 && k < lvl->w; k++) {
      uint8_t t = lvl->cells[r][k];
      plPeg[r][k] = t > 2 ? 0 : t;
    }
  plCustom = true;
}

static void enterPlinkoTitle() {
  gameState = ST_PLINKO_TITLE;
  drawStdTitleEx("PLINKO", COL_PLATE_ON, "Drop discs into pockets", "Left/Right aim  A: drop",
                 "Highest total wins", 44, kPlModes[g_variant & 3]);
}

static void enterPlinkoPlaying() {
  s_mazeRng = gameSeed();
  plSeed = s_mazeRng;
  plDrop = plHit = 0;
  plAcc = 0.0f;
  plTier = g_variant & 3;
  plN = kPlDiscs[plTier];
  plLeft = plN;
  plBounce = kPlBounce[plTier];
  plJit = kPlJitter[plTier];
  plScore = 0;
  plPocket = 0;
  plLastVal = 0;
  plAim = 80.0f;
  plDx = plDy = plVx = plVy = plSx = 0.0f;
  plPhase = 0;
  plT0 = plFallN = plSfxAt = plEndAt = 0;
  plStdPegs();
  plCustom = false;
  if (s_lvlActiveSlot[LVLGAME_PLINKO] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_PLINKO, s_lvlActiveSlot[LVLGAME_PLINKO], &lvl)) plinkoLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_PLINKO] = -1;
  }
  s_lastFrameMs = 0;
  gameState = ST_PLINKO_PLAYING;
}

static void plLand(unsigned long now) {
  int p = (int)((plDx - PL_X0) / 16.0f);
  if (p < 0) p = 0;
  if (p > 8) p = 8;
  plPocket = p;
  plLastVal = kPlVals[plTier][p];
  plScore += plLastVal;
  plLeft--;
  plPhase = 2;
  plT0 = now;
  plSx = plDx;
  if (plLastVal > 0) {
    int mx = kPlVals[plTier][4];
    sfx((uint16_t)(380 + (plLastVal > 99 ? 99 : plLastVal) * 8), 90);
    particlesBurst(16 + 16 * p, 104, 4 + (plLastVal >= mx ? 12 : (plLastVal >= 10 ? 5 : 0)), 0);
  } else {
    sfxBlocked();
  }
}

static uint32_t plHash(uint32_t a, uint32_t b, uint32_t c) {
  uint32_t x = (a * 0x9E3779B1u) ^ ((b + 0x7F4A7C15u) * 0x85EBCA6Bu) ^ ((c + 1u) * 0xC2B2AE35u);
  x ^= x >> 15; x *= 0x2C1B3C6Du; x ^= x >> 12; x *= 0x297A2D39u; x ^= x >> 15;
  return x;
}

static void plStep(float h, unsigned long now) {
  plVy += 300.0f * h;
  if (plVy > 240.0f) plVy = 240.0f;
  plDx += plVx * h;
  plDy += plVy * h;
  if (plDx < PL_X0 + 2.5f) { plDx = PL_X0 + 2.5f; if (plVx < 0.0f) plVx = -plVx * plBounce; }
  if (plDx > PL_X1 - 2.5f) { plDx = PL_X1 - 2.5f; if (plVx > 0.0f) plVx = -plVx * plBounce; }
  int r0 = (int)((plDy - PL_Y0) / PL_DY + 0.5f);
  for (int r = r0 - 1; r <= r0 + 1; r++) {
    if (r < 0 || r >= PL_ROWS) continue;
    int base = (r & 1) ? 16 : 8;
    int k = (int)((plDx - (float)base) / 16.0f + 0.5f);
    if (k < 0) k = 0;
    if (k > 8) k = 8;
    if (!plPeg[r][k]) continue;
    float px = (float)(base + 16 * k), py = (float)(PL_Y0 + r * PL_DY);
    float ddx = plDx - px, ddy = plDy - py;
    float d2 = ddx * ddx + ddy * ddy;
    if (d2 < 20.25f) {
      float d = sqrtf(d2), nx, ny;
      uint32_t hr = plHash(plSeed, plDrop, plHit++);
      if (d < 0.05f) { nx = ((hr >> 16) & 1u) ? 0.7f : -0.7f; ny = -0.7f; }
      else { nx = ddx / d; ny = ddy / d; }
      plDx = px + nx * 4.6f;
      plDy = py + ny * 4.6f;
      float vn = plVx * nx + plVy * ny;
      if (vn < 0.0f) {
        float e = (plPeg[r][k] == 2) ? 1.15f : plBounce;   // bumpers kick the disc
        plVx -= (1.0f + e) * vn * nx;
        plVy -= (1.0f + e) * vn * ny;
      }
      plVx += ((float)(hr % 2001u) - 1000.0f) * 0.001f * plJit;
      if (plVx > 200.0f) plVx = 200.0f;
      if (plVx < -200.0f) plVx = -200.0f;
      unsigned long t = millis();
      if (t - plSfxAt > 40) { plSfxAt = t; sfx((uint16_t)(300 + ((hr >> 20) % 5u) * 40), 6); }
    }
  }
  if (plDy >= PL_POCKET_Y) plLand(now);
}

static uint16_t plPocketCol(int v, int mx) {
  if (v >= mx) return COL_KEY;
  if (v * 4 >= mx) return COL_GOAL;
  if (v > 0) return COL_BLUE;
  return COL_WALL;
}

static void drawPlinko(unsigned long now) {
  canvas->fillScreen(COL_BG);
  uint16_t pegc = arcada.display->color565(120, 130, 190);
  canvas->drawFastVLine(PL_X0 - 1, 14, 106, COL_WALL);
  canvas->drawFastVLine(PL_X1 + 1, 14, 106, COL_WALL);
  canvas->drawFastHLine(PL_X0 - 1, 120, PL_X1 - PL_X0 + 3, COL_WALL);
  for (int r = 0; r < PL_ROWS; r++) {
    int base = (r & 1) ? 16 : 8;
    for (int k = 0; k <= 8; k++) {
      if (!plPeg[r][k]) continue;
      if (plPeg[r][k] == 2) {
        canvas->fillCircle(base + 16 * k, PL_Y0 + r * PL_DY, 3, COL_ORANGE);
        canvas->drawPixel(base + 16 * k, PL_Y0 + r * PL_DY, COL_KEY);
      } else {
        canvas->fillCircle(base + 16 * k, PL_Y0 + r * PL_DY, 2, pegc);
      }
    }
  }
  int mx = kPlVals[plTier][4];
  canvas->setTextSize(1);
  for (int i = 0; i < 9; i++) {
    int x = PL_X0 + 16 * i, v = kPlVals[plTier][i];
    uint16_t pc = plPocketCol(v, mx);
    if (plPhase >= 2 && plPocket == i && plLastVal > 0 && now - plT0 < 500)
      canvas->fillRect(x + 1, 98, 15, 22, animBlend(COL_BG, pc, 110));
    char t[12];
    snprintf(t, sizeof(t), "%d", v);
    int w = (int)strlen(t) * 6;
    ptc(pc, x + (16 - w) / 2 + 1, 106, t);
  }
  for (int i = 0; i < 10; i++) canvas->drawFastVLine(PL_X0 + 16 * i, PL_POCKET_Y, 24, COL_WALL);
  // the disc
  if (plPhase == 0) {
    canvas->fillCircle((int)plAim, 14, 2, COL_KEY);
    for (int y = 18; y < 24; y += 2) canvas->drawPixel((int)plAim, y, COL_TEXT);
  } else if (plPhase == 1) {
    canvas->fillCircle((int)plDx, (int)plDy, 2, COL_KEY);
  } else if (plPhase == 2) {
    float k = animEase((float)(now - plT0) / 250.0f);
    float cx = (float)(16 + 16 * plPocket);
    canvas->fillCircle((int)(plSx + (cx - plSx) * k), (int)(plDy + (112.0f - plDy) * k), 2, COL_KEY);
  }
  char t[24];
  canvas->setTextColor(COL_TEXT);
  canvas->setCursor(4, 2);
  snprintf(t, sizeof(t), "SCORE %d", plScore);
  canvas->print(t);
  int cur = (plPhase <= 1) ? plN - plLeft + 1 : plN - plLeft;
  if (cur > plN) cur = plN;
  canvas->setTextColor(COL_ICE);
  canvas->setCursor(94, 2);
  snprintf(t, sizeof(t), "DISC %d/%d", cur, plN);
  canvas->print(t);
  if (plPhase == 0) {
    ptc(COL_WALL, 4, 121, "Left/Right: aim  A: drop");
  }
  particlesUpdateDraw();
}

static void plToOver() {
  if (!plCustom) recordResult(44, g_variant, (long)plScore, true);   // hand-made boards don't set records
  else { s_lastNewBest = false; lvlRecordRun(LVLGAME_PLINKO, (long)plScore, true); }
  if (g_twoPlayerMode) { twoPHandleGameEnd(plScore); return; }
  gameState = ST_PLINKO_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%d", plScore);
  snprintf(sub, sizeof(sub), "%d discs dropped", plN);
  drawStdOver("ALL DROPPED", COL_PLATE_ON, big, sub, 44);
}

static void plinkoFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;
  if (plPhase == 0) {
    if (buttons & ARCADA_BUTTONMASK_LEFT) plAim -= 90.0f * dt;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) plAim += 90.0f * dt;
    if (plAim < 14.0f) plAim = 14.0f;
    if (plAim > 146.0f) plAim = 146.0f;
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B)) {
      plDx = plAim;
      plDy = 14.0f;
      plVx = ((float)(plHash(plSeed, plDrop, 0xFFFFu) % 1001u) - 500.0f) * 0.016f;
      plDrop++;
      plHit = 0;
      plAcc = 0.0f;
      plVy = 0.0f;
      plFallN = 0;
      plPhase = 1;
      sfx(700, 25);
    }
  } else if (plPhase == 1) {
    plAcc += dt;
    int steps = 0;
    while (plAcc >= 0.005f && steps < 12 && plPhase == 1) {
      plStep(0.005f, now);
      plAcc -= 0.005f;
      plFallN++;
      steps++;
    }
    if (plAcc >= 0.005f) plAcc = 0.0f;   // over the step cap: drop the excess
    if (plPhase == 1 && plFallN > 1400UL) plLand(now);   // safety net: 7 s of simulated time
  } else if (plPhase == 2) {
    if (now - plT0 >= 250UL) {
      if (plLeft <= 0) { plPhase = 3; plEndAt = now + 700UL; }
      else plPhase = 0;
    }
  } else {
    if ((long)(now - plEndAt) >= 0) { plToOver(); return; }
  }
  drawPlinko(now);
  blitScreen();
}

// --- Lucky Slots ---------------------------------------------------------------
//
// Three reels, six symbols (8x8 bitmaps in flash, drawn at 3x). Up/Down picks the bet
// (1 / 5 / 10), A spins (A again while spinning stops the reels at once), B cashes out
// while idle. Reels stop one after another with an ease-out and tick sounds. Three alike
// pay big, any two alike pay the bet back. The game ends at 0 coins, after the spin limit
// or on cash-out; score = coins left. Each spin's outcome is a hash of (round seed, spin
// number), so 2P player 2 sees the same reel results for the same spin count whatever
// they bet. Tiers change the bank, the spin limit and the payout percentage.

static const uint8_t kSmIcons[6][8] = {
  {0x06, 0x0A, 0x12, 0x22, 0x66, 0xF7, 0xF6, 0x60},  // cherry
  {0x00, 0x00, 0x7C, 0xFE, 0xFF, 0xFE, 0x7C, 0x00},  // lemon
  {0x18, 0x3C, 0x3C, 0x7E, 0x7E, 0xFF, 0xFF, 0x18},  // bell
  {0xFF, 0xFF, 0x00, 0xFF, 0xFF, 0x00, 0xFF, 0xFF},  // bar
  {0x10, 0x10, 0xFE, 0x7C, 0x38, 0x6C, 0xC6, 0x00},  // star
  {0xFE, 0xFE, 0x06, 0x0C, 0x18, 0x30, 0x30, 0x30},  // seven
};
static const uint8_t kSmWeight[6] = {8, 8, 6, 5, 3, 2};     // sums to 32
static const uint8_t kSmMult[6] = {6, 8, 12, 20, 40, 80};   // three alike, x bet
static const char* const kSmNames[6] = {"CHERRY", "LEMON", "BELL", "BAR", "STAR", "SEVEN"};
static const uint8_t kSmBets[3] = {1, 5, 10};
static const uint8_t kSmStartCoins[4] = {100, 100, 150, 50};
static const uint8_t kSmSpinMax[4] = {25, 15, 30, 20};
static const uint8_t kSmPay[4] = {100, 125, 100, 150};      // payout percentage
static const char* const kSmModes[4] = {"25 SPINS CLASSIC", "15 SPINS HOT", "30 SPINS BIG BANK", "20 SPINS ALL IN"};
static int smCoins, smBetIdx, smSpin, smSpinMax, smWin, smKind, smWinSym, smTier, smTick;
static uint8_t smPhase;   // 0 idle, 1 spinning, 2 round over (short pause)
static uint8_t smSym[3], smStopped;
static bool smCashed;
static uint32_t smSeed;
static unsigned long smT0, smStop[3], smEndAt, smWinAt;

static void enterSlotsTitle() {
  gameState = ST_SLOTS_TITLE;
  drawStdTitleEx("LUCKY SLOTS", COL_LASER, "Match the 3 reels", "Up/Down: bet  A: spin", "B: cash out early", 45,
                 kSmModes[g_variant & 3]);
}

static uint32_t smHash(uint32_t x) {
  x ^= x >> 16; x *= 0x7FEB352Du;
  x ^= x >> 15; x *= 0x846CA68Bu;
  x ^= x >> 16;
  return x;
}

static int smBetNow() {
  int i = smBetIdx;
  while (i > 0 && kSmBets[i] > smCoins) i--;
  return kSmBets[i];
}

static void enterSlotsPlaying() {
  smSeed = gameSeed();
  smTier = g_variant & 3;
  smCoins = kSmStartCoins[smTier];
  smSpinMax = kSmSpinMax[smTier];
  smBetIdx = 1;
  smSpin = 0;
  smWin = 0;
  smKind = 0;
  smWinSym = 0;
  smTick = 0;
  smPhase = 0;
  smCashed = false;
  smSym[0] = 0; smSym[1] = 2; smSym[2] = 5;
  smT0 = smEndAt = smWinAt = 0;
  smStop[0] = smStop[1] = smStop[2] = 0;
  s_lastFrameMs = 0;
  gameState = ST_SLOTS_PLAYING;
}

static uint16_t smCol(int sym) {
  switch (sym) {
    case 0: return COL_LASER;
    case 1: return COL_PLAYER;
    case 2: return COL_ORANGE;
    case 3: return COL_TEXT;
    case 4: return COL_TELE_B;
    default: return COL_BOOST;
  }
}

// 24x24 symbol (8x8 at 3x) with its top-left at (x,y), clipped to rows [clipT, clipB).
static void smDrawSym(int sym, int x, int y, int clipT, int clipB, uint16_t col) {
  for (int r = 0; r < 8; r++) {
    uint8_t bits = kSmIcons[sym][r];
    int y0 = y + r * 3, y1 = y0 + 3;
    if (y0 < clipT) y0 = clipT;
    if (y1 > clipB) y1 = clipB;
    if (!bits || y1 <= y0) continue;
    for (int c = 0; c < 8; c++)
      if (bits & (0x80 >> c)) canvas->fillRect(x + c * 3, y0, 3, y1 - y0, col);
  }
}

static void smSpinStart(unsigned long now) {
  while (smBetIdx > 0 && kSmBets[smBetIdx] > smCoins) smBetIdx--;
  int bet = kSmBets[smBetIdx];
  smStopped = 0;
  smCoins -= bet;
  smSpin++;
  smWin = 0;
  smKind = 0;
  for (int r = 0; r < 3; r++) {
    uint32_t v = smHash(smSeed + (uint32_t)smSpin * 0x9E3779B9u + (uint32_t)r * 0x85EBCA6Bu) % 32u;
    int s = 0, acc = kSmWeight[0];
    while (s < 5 && (int)v >= acc) { s++; acc += kSmWeight[s]; }
    smSym[r] = (uint8_t)s;
    smStop[r] = now + 800UL + (unsigned long)r * 450UL;
  }
  smT0 = now;
  smTick = 0;
  smPhase = 1;
  sfx(450, 30);
}

// All three reels have stopped: pay out.
static void smResolve(unsigned long now) {
  int bet = kSmBets[smBetIdx];
  int pay = kSmPay[smTier];
  int a = smSym[0], b = smSym[1], c = smSym[2];
  if (a == b && b == c) {
    smKind = 2;
    smWinSym = a;
    smWin = bet * kSmMult[a] * pay / 100;
  } else if (a == b || b == c || a == c) {
    smKind = 1;
    smWinSym = (a == b || a == c) ? a : b;
    smWin = bet * pay / 100;
    if (smWin < 1) smWin = 1;
  }
  smCoins += smWin;
  smWinAt = now;
  if (smKind == 2) {
    particlesBurst(80, 30, 20, 0);
    sfxWin();
  } else if (smKind == 1) {
    sfx(660, 70);
  } else {
    sfx(180, 60);
  }
  while (smBetIdx > 0 && kSmBets[smBetIdx] > smCoins) smBetIdx--;
  if (smCoins < 1 || smSpin >= smSpinMax) { smPhase = 2; smEndAt = now + 1000UL; }
  else smPhase = 0;
}

static void drawSlots(unsigned long now) {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  char t[32];
  canvas->setTextColor(COL_KEY);
  canvas->setCursor(4, 2);
  snprintf(t, sizeof(t), "COINS %d", smCoins);
  canvas->print(t);
  canvas->setTextColor(COL_ICE);
  canvas->setCursor(94, 2);
  snprintf(t, sizeof(t), "SPIN %d/%d", smSpin, smSpinMax);
  canvas->print(t);
  uint16_t reelBg = arcada.display->color565(12, 12, 28);
  bool glow = smWin > 0 && now - smWinAt < 1500UL && smPhase != 1;
  uint16_t frame = glow ? (smKind == 2 ? animBlend(COL_KEY, COL_TEXT, animPulse(300)) : COL_KEY) : COL_WALL;
  for (int r = 0; r < 3; r++) {
    int x0 = 24 + r * 40;
    canvas->fillRect(x0, 14, 32, 32, reelBg);
    canvas->drawRect(x0 - 1, 13, 34, 34, frame);
    bool spinning = smPhase == 1 && now < smStop[r];
    if (!spinning) {
      smDrawSym(smSym[r], x0 + 4, 18, 15, 45, smCol(smSym[r]));
    } else {
      long rem = (long)(smStop[r] - now);
      if (rem <= 130) {
        float e = animEase(1.0f - (float)rem / 130.0f);
        int oy = (int)(e * 30.0f);
        int old = (int)(((now - smT0) / 60UL + (unsigned long)r * 2UL) % 6UL);
        smDrawSym(old, x0 + 4, 18 + oy, 15, 45, smCol(old));
        smDrawSym(smSym[r], x0 + 4, 18 + oy - 30, 15, 45, smCol(smSym[r]));
      } else {
        unsigned long el = now - smT0 + (unsigned long)r * 23UL;
        int tick = (int)(el / 60UL);
        int oy = (int)((el % 60UL) * 30UL / 60UL);
        int cur = (tick + r * 2) % 6, nxt = (tick + 1 + r * 2) % 6;
        smDrawSym(cur, x0 + 4, 18 + oy, 15, 45, smCol(cur));
        smDrawSym(nxt, x0 + 4, 18 + oy - 30, 15, 45, smCol(nxt));
      }
    }
  }
  canvas->fillTriangle(16, 30, 21, 26, 21, 34, COL_LASER);
  canvas->fillTriangle(144, 30, 139, 26, 139, 34, COL_LASER);
  // bet + result
  canvas->setTextColor(COL_TEXT);
  canvas->setCursor(4, 51);
  snprintf(t, sizeof(t), "BET %d  (Up/Down)", smBetNow());
  canvas->print(t);
  if (smPhase != 1 && smSpin > 0) {
    if (smKind == 2) snprintf(t, sizeof(t), "3x %s! +%d", kSmNames[smWinSym], smWin);
    else if (smKind == 1) snprintf(t, sizeof(t), "PAIR  +%d", smWin);
    else snprintf(t, sizeof(t), "NO WIN");
    ptc(smKind ? COL_GOAL : COL_WALL, 4, 62, t);
  }
  // payout table
  int pay = kSmPay[smTier];
  for (int i = 0; i < 6; i++) {
    int x = 4 + (i % 3) * 52, y = 80 + (i / 3) * 12;
    for (int r = 0; r < 8; r++)
      for (int c = 0; c < 8; c++)
        if (kSmIcons[i][r] & (0x80 >> c)) canvas->drawPixel(x + c, y + r, smCol(i));
    canvas->setTextColor(COL_TEXT);
    canvas->setCursor(x + 11, y);
    snprintf(t, sizeof(t), "+%d", smBetNow() * kSmMult[i] * pay / 100);   // real payout at the current bet
    canvas->print(t);
  }
  canvas->setTextColor(COL_ICE);
  canvas->setCursor(4, 104);
  int pw2 = smBetNow() * pay / 100;
  if (pw2 < 1) pw2 = 1;
  snprintf(t, sizeof(t), "Any 2 alike: +%d", pw2);
  canvas->print(t);
  ptc(COL_WALL, 4, 118, "A:spin Up/Dn:bet B:cash");
  particlesUpdateDraw();
}

static void smToOver() {
  recordResult(45, g_variant, (long)smCoins, true);
  if (g_twoPlayerMode) { twoPHandleGameEnd(smCoins); return; }
  gameState = ST_SLOTS_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%d", smCoins);
  snprintf(sub, sizeof(sub), "%d of %d spins used", smSpin, smSpinMax);
  const char* head = smCashed ? "CASHED OUT" : (smCoins < 1 ? "BANKRUPT" : "ALL SPINS USED");
  drawStdOver(head, smCoins >= kSmStartCoins[smTier] ? COL_GOAL : COL_LASER, big, sub, 45);
}

static void slotsFrame(uint32_t buttons, uint32_t pressed) {
  (void)buttons;
  unsigned long now = millis();
  s_lastFrameMs = now;
  if (smPhase == 0) {
    if (pressed & ARCADA_BUTTONMASK_UP) {
      if (smBetIdx < 2 && kSmBets[smBetIdx + 1] <= smCoins) smBetIdx++;
      sfxMove();
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      if (smBetIdx > 0) smBetIdx--;
      sfxMove();
    } else if (pressed & ARCADA_BUTTONMASK_A) {
      smSpinStart(now);
    } else if ((pressed & ARCADA_BUTTONMASK_B) && smSpin > 0) {
      smCashed = true;
      smPhase = 2;
      smEndAt = now + 400UL;
      sfx(880, 60);
    }
  } else if (smPhase == 1) {
    if (pressed & ARCADA_BUTTONMASK_A) {          // quick stop
      for (int r = 0; r < 3; r++) if (smStop[r] > now + 130UL) smStop[r] = now + 130UL + (unsigned long)r * 120UL;
    }
    int tick = (int)((now - smT0) / 60UL);
    if (tick != smTick) { smTick = tick; sfx((uint16_t)(260 + (tick & 3) * 25), 5); }
    int n = 0;
    for (int r = 0; r < 3; r++) if (now >= smStop[r]) n++;
    if (n != smStopped) { if (n > smStopped) sfx((uint16_t)(500 + n * 120), 50); smStopped = (uint8_t)n; }
    if (n == 3) { smStopped = 0; smResolve(now); }
  } else {
    if ((long)(now - smEndAt) >= 0) { smToOver(); return; }
  }
  drawSlots(now);
  blitScreen();
}

// --- Cube Dash -----------------------------------------------------------------
//
// An endless auto-runner. The cube runs right at a speed that grows with distance; A or
// Up jumps (hold to keep hopping). Obstacles: single / double / triple spikes, solid blocks
// (a jump can land on top) and pits. They come from the round seed and their spacing
// depends on the speed AT THAT DISTANCE (not on time), so 2P player 2 faces the identical
// course. Fixed 1/120 s physics steps. Score = metres run; one crash ends the round.

#define CD_GROUND 100
#define CD_CUBE_X 36
#define CD_MAXOBS 9
static float cdScroll, cdCy, cdVy, cdAng, cdNextX;
static float cdOx[CD_MAXOBS];
static uint8_t cdOt[CD_MAXOBS], cdOw[CD_MAXOBS];   // type: 0 spike 1 double 2 block 3 pit 4 triple
static int cdN, cdPassed, cdTier;
static bool cdOnGround, cdDead, cdEnded;
static unsigned long cdDeadAt;
static const float kCdBase[4] = {95.0f, 120.0f, 75.0f, 140.0f};
static const float kCdRamp[4] = {0.022f, 0.030f, 0.016f, 0.034f};   // px/s gained per px run
static const uint8_t kCdGapPct[4] = {18, 18, 12, 30};

static void enterCubeTitle() {
  gameState = ST_CUBE_TITLE;
  drawStdTitle("CUBE DASH", COL_TELE_B, "Auto-run past the spikes", "A / Up: jump (hold: hop)", "Go as far as you can", 46);
}

static float cdSpeedAt(float x) {
  float v = kCdBase[cdTier] + kCdRamp[cdTier] * x;
  return v > 210.0f ? 210.0f : v;
}

// Level-creator track: a 24x4 grid read row-major = up to 96 cells of CD_TRACK_PITCH px each
// (older 10x4 saves are 40 cells and still play).
// Tiles: 0 ground, 1 spike, 2 block, 3 pit, 4 double spike. The run ends at the finish line.
#define CD_TRACK_MAX 96
#define CD_TRACK_PITCH 64
#define CD_TRACK_X0 240
static uint8_t cdTrack[CD_TRACK_MAX];
static int cdTrackLen, cdTrackIdx;
static bool cdCustom = false, cdTrackDone = false, cdWon = false;
static float cdFinishX = 0.0f;

static void cubeLoadCustom(const LevelData *lvl) {
  memset(cdTrack, 0, sizeof(cdTrack));
  int n = 0;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w && n < CD_TRACK_MAX; c++) cdTrack[n++] = lvl->cells[r][c] <= 4 ? lvl->cells[r][c] : 0;
  cdTrackLen = n;
  cdTrackIdx = 0;
  cdCustom = n > 0;
  cdTrackDone = false;
  cdFinishX = (float)(CD_TRACK_X0 + n * CD_TRACK_PITCH + 90);
}

static bool cubeValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int n = lvl->w * lvl->h - lvlCountTile(lvl, 0);
  if (n < 3) { snprintf(msg, msgLen, "Need 3+ obstacles"); return false; }
  return true;
}

static void cdAddTrackObstacle() {
  while (cdTrackIdx < cdTrackLen && cdTrack[cdTrackIdx] == 0) cdTrackIdx++;
  if (cdTrackIdx >= cdTrackLen) { cdTrackDone = true; return; }
  if (cdN >= CD_MAXOBS) return;
  uint8_t k = cdTrack[cdTrackIdx];
  uint8_t t = 0, w = 12;
  if (k == 2) { t = 2; w = 16; }
  else if (k == 3) { t = 3; w = 34; }
  else if (k == 4) { t = 1; w = 24; }
  cdOx[cdN] = (float)(CD_TRACK_X0 + cdTrackIdx * CD_TRACK_PITCH + 16);
  cdOt[cdN] = t;
  cdOw[cdN] = w;
  cdN++;
  cdTrackIdx++;
}

static void cdAddObstacle() {
  if (cdCustom) { cdAddTrackObstacle(); return; }
  float v = cdSpeedAt(cdNextX);
  float travel = v * 0.65f;
  uint8_t t, w;
  if (mazeRngRange(100) < kCdGapPct[cdTier]) {
    int mx = (int)(travel * 0.55f);
    if (mx > 44) mx = 44;
    if (mx < 24) mx = 24;
    t = 3;
    w = (uint8_t)(22 + mazeRngRange(mx - 22 + 1));
  } else {
    int r2 = mazeRngRange(100);
    if (r2 < 38) { t = 0; w = 12; }
    else if (r2 < 62) { t = 1; w = 24; }
    else if (r2 < 84) { t = 2; w = 16; }
    else if (cdTier == 2) { t = 0; w = 12; }
    else { t = 4; w = 36; }
  }
  if (cdN < CD_MAXOBS) {
    cdOx[cdN] = cdNextX;
    cdOt[cdN] = t;
    cdOw[cdN] = w;
    cdN++;
  }
  cdNextX += (float)w + 44.0f + v * 0.25f + (float)mazeRngRange((int)(v * 0.5f) + 1);
}

static void enterCubePlaying() {
  s_mazeRng = gameSeed();
  cdTier = g_variant & 3;
  cdScroll = 0.0f;
  cdCy = CD_GROUND - 12;
  cdVy = 0.0f;
  cdAng = 0.0f;
  cdN = 0;
  cdPassed = 0;
  cdNextX = 260.0f;
  cdOnGround = true;
  cdDead = cdEnded = false;
  cdDeadAt = 0;
  cdCustom = false;
  cdTrackDone = false;
  cdWon = false;
  if (s_lvlActiveSlot[LVLGAME_CUBE] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_CUBE, s_lvlActiveSlot[LVLGAME_CUBE], &lvl)) cubeLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_CUBE] = -1;
  }
  while (cdN < 7 && !cdTrackDone) cdAddObstacle();
  s_lastFrameMs = 0;
  gameState = ST_CUBE_PLAYING;
}

static void cdDie() {
  cdDead = true;
  cdDeadAt = millis();
  sfxDeath();
  particlesBurst(CD_CUBE_X + 6, (int)cdCy + 6, 20, COL_PLAYER);
}

static void cdStep(float h, bool want) {
  cdScroll += cdSpeedAt(cdScroll) * h;
  float cxw = cdScroll + CD_CUBE_X;
  float prevBottom = cdCy + 12.0f;
  if (cdOnGround && want) { cdVy = -260.0f; cdOnGround = false; sfx(620, 18); }
  cdVy += 800.0f * h;
  cdCy += cdVy * h;
  bool inPit = false;
  float cc = cxw + 6.0f;
  for (int i = 0; i < cdN; i++)
    if (cdOt[i] == 3 && cc >= cdOx[i] && cc <= cdOx[i] + cdOw[i]) inPit = true;
  float surf = inPit ? 1e9f : (float)CD_GROUND;
  for (int i = 0; i < cdN; i++) {
    if (cdOt[i] != 2) continue;
    if (cxw + 11.0f > cdOx[i] && cxw + 1.0f < cdOx[i] + 16.0f) {
      float top = (float)(CD_GROUND - 14);
      if (prevBottom <= top + 4.0f && top < surf) surf = top;
    }
  }
  if (cdVy >= 0.0f && cdCy + 12.0f >= surf) {
    cdCy = surf - 12.0f;
    cdVy = 0.0f;
    cdOnGround = true;
    cdAng = 0.0f;
  } else {
    cdOnGround = false;
    cdAng += 2.42f * h;
  }
  if (inPit && cdCy + 12.0f > CD_GROUND + 6) { cdDie(); return; }
  if (cdCy > 135.0f) { cdDie(); return; }
  float hx0 = cxw + 2.0f, hx1 = cxw + 10.0f, hy0 = cdCy + 1.0f, hy1 = cdCy + 11.0f;
  for (int i = 0; i < cdN; i++) {
    float ox0, ox1, oy0, oy1 = (float)CD_GROUND;
    uint8_t t = cdOt[i];
    if (t == 3) continue;
    if (t == 2) { ox0 = cdOx[i]; ox1 = cdOx[i] + 16.0f; oy0 = (float)(CD_GROUND - 14); }
    else { ox0 = cdOx[i] + 3.0f; ox1 = cdOx[i] + cdOw[i] - 3.0f; oy0 = (float)(CD_GROUND - 9); }
    if (hx1 > ox0 && hx0 < ox1 && hy1 > oy0 && hy0 < oy1) { cdDie(); return; }
  }
}

static void drawCube() {
  uint16_t sky = arcada.display->color565(12, 10, 40);
  canvas->fillScreen(sky);
  uint16_t l1 = arcada.display->color565(22, 18, 62), l2 = arcada.display->color565(32, 26, 90);
  int o1 = (int)(cdScroll * 0.2f) % 40;
  for (int i = 0; i < 5; i++) canvas->fillRect(i * 40 - o1, 0, 14, CD_GROUND, l1);
  int s2 = (int)(cdScroll * 0.45f);
  int j0 = s2 / 64, o2 = s2 % 64;
  for (int i = 0; i < 4; i++) {
    int hgt = 18 + ((j0 + i) * 7 % 4) * 9;
    canvas->fillRect(i * 64 - o2, CD_GROUND - hgt, 24, hgt, l2);
  }
  uint16_t gr = arcada.display->color565(40, 36, 90);
  canvas->fillRect(0, CD_GROUND, 160, 28, gr);
  canvas->drawFastHLine(0, CD_GROUND, 160, COL_TELE_B);
  for (int i = 0; i < cdN; i++) {
    int sx = (int)(cdOx[i] - cdScroll);
    int w = cdOw[i];
    if (sx > 160 || sx + w < 0) continue;
    switch (cdOt[i]) {
      case 3:
        canvas->fillRect(sx, CD_GROUND, w, 28, COL_BG);
        canvas->drawFastVLine(sx, CD_GROUND, 28, COL_TELE_B);
        canvas->drawFastVLine(sx + w, CD_GROUND, 28, COL_TELE_B);
        break;
      case 2:
        canvas->fillRect(sx, CD_GROUND - 14, 16, 14, COL_BLUE);
        canvas->drawRect(sx, CD_GROUND - 14, 16, 14, COL_TEXT);
        break;
      default:
        for (int k = 0; k < w / 12; k++)
          canvas->fillTriangle(sx + k * 12, CD_GROUND, sx + k * 12 + 12, CD_GROUND, sx + k * 12 + 6, CD_GROUND - 12, COL_LASER);
        break;
    }
  }
  if (cdCustom) {   // finish line: chequered post
    int fx = (int)(cdFinishX - cdScroll);
    if (fx > -8 && fx < 160)
      for (int k = 0; k < 10; k++) {
        canvas->fillRect(fx, CD_GROUND - 60 + k * 6, 4, 6, (k & 1) ? COL_TEXT : COL_BG);
        canvas->fillRect(fx + 4, CD_GROUND - 60 + k * 6, 4, 6, (k & 1) ? COL_BG : COL_TEXT);
      }
  }
  if (!cdDead) {
    float cx = CD_CUBE_X + 6.0f, cy = cdCy + 6.0f;
    float a = cdAng, ca = cosf(a) * 6.0f, sa = sinf(a) * 6.0f;
    int x0 = (int)(cx - ca + sa), y0 = (int)(cy - sa - ca);
    int x1 = (int)(cx + ca + sa), y1 = (int)(cy + sa - ca);
    int x2 = (int)(cx + ca - sa), y2 = (int)(cy + sa + ca);
    int x3 = (int)(cx - ca - sa), y3 = (int)(cy - sa + ca);
    canvas->fillTriangle(x0, y0, x1, y1, x2, y2, COL_PLAYER);
    canvas->fillTriangle(x0, y0, x2, y2, x3, y3, COL_PLAYER);
    canvas->drawLine(x0, y0, x1, y1, COL_ORANGE);
    canvas->drawLine(x1, y1, x2, y2, COL_ORANGE);
    canvas->drawLine(x2, y2, x3, y3, COL_ORANGE);
    canvas->drawLine(x3, y3, x0, y0, COL_ORANGE);
  }
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  char t[24];
  canvas->setCursor(4, 2);
  if (cdCustom) {
    int pc = (int)((cdScroll + CD_CUBE_X) * 100.0f / cdFinishX);
    snprintf(t, sizeof(t), "TRACK %d%%", pc < 0 ? 0 : (pc > 100 ? 100 : pc));
    canvas->print(t);
    particlesUpdateDraw();
    return;
  }
  snprintf(t, sizeof(t), "DIST %dm", (int)(cdScroll / 10.0f));
  canvas->print(t);
  int32_t bs = saveBest(46, saveTierOf(g_variant));
  canvas->setTextColor(COL_KEY);
  canvas->setCursor(96, 2);
  snprintf(t, sizeof(t), "BEST %dm", bs == SAVE_NO_SCORE ? 0 : (int)bs);
  canvas->print(t);
  particlesUpdateDraw();
}

static void cdToOver() {
  if (cdCustom) {   // hand-made track: scored by % of the track covered, never a record
    long pct = cdWon ? 100L : (long)((cdScroll + CD_CUBE_X) * 100.0f / cdFinishX);
    if (pct > 99 && !cdWon) pct = 99;
    if (pct < 0) pct = 0;
    s_lastNewBest = false;
    lvlRecordRun(LVLGAME_CUBE, pct, true);
    if (cdWon) lvlOnClear(LVLGAME_CUBE);
    if (g_twoPlayerMode) { twoPHandleGameEnd(pct); return; }
    gameState = ST_CUBE_OVER;
    char big[12];
    snprintf(big, sizeof(big), "%ld%%", pct);
    drawStdOver(cdWon ? "LEVEL CLEAR" : "CRASHED", cdWon ? COL_GOAL : COL_LASER, big, "of the track covered", 46);
    return;
  }
  long m = (long)(cdScroll / 10.0f);
  recordResult(46, g_variant, m, true);
  if (g_twoPlayerMode) { twoPHandleGameEnd(m); return; }
  gameState = ST_CUBE_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%ld", m);
  snprintf(sub, sizeof(sub), "%d obstacles passed", cdPassed);
  drawStdOver("CRASHED", COL_LASER, big, sub, 46);
}

static void cubeFrame(uint32_t buttons, uint32_t pressed) {
  (void)pressed;
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;
  if (cdDead) {
    if (!cdEnded && now - cdDeadAt > 800UL) { cdEnded = true; cdToOver(); return; }
  } else {
    bool want = (buttons & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_UP)) != 0;
    float rem = dt;
    int steps = 0;
    while (rem > 0.0001f && steps < 6 && !cdDead) {
      float h = rem > (1.0f / 120.0f) ? (1.0f / 120.0f) : rem;
      cdStep(h, want);
      rem -= h;
      steps++;
    }
    // drop obstacles that are well behind the cube, then top the course up
    while (cdN > 0 && cdOx[0] + cdOw[0] < cdScroll) {
      for (int i = 1; i < cdN; i++) { cdOx[i - 1] = cdOx[i]; cdOt[i - 1] = cdOt[i]; cdOw[i - 1] = cdOw[i]; }
      cdN--;
      cdPassed++;
    }
    while (cdN < 7 && !cdTrackDone) cdAddObstacle();
    if (cdCustom && !cdDead && cdScroll + CD_CUBE_X >= cdFinishX) {   // crossed the finish line
      cdWon = true;
      cdEnded = true;
      sfxWin();
      pixelsWinCelebration();
      cdToOver();
      return;
    }
  }
  drawCube();
  blitScreen();
}

// --- Flood Fill ----------------------------------------------------------------
//
// A coloured grid (6 colours). The flooded region starts at the top-left cell; pick a colour
// in the palette (Left/Right = previous/next, Up/Down = a row up/down) and press A: the
// whole region takes that colour and absorbs every touching cell of that colour. Flood the
// whole board within the move limit. The board comes from the round seed (2P gets the same
// board). The fill is an iterative breadth-first queue (no recursion); the recolour plays
// as a short diagonal wave (~200 ms, non-blocking). Score = (moves left + 1) x 10 on a win,
// 0 otherwise. Tiers = board size / move limit.

#define FL_MAX 14
static uint8_t flBd[FL_MAX * FL_MAX];   // bits 0-2 colour, 0x08 flooded region, 0x10 absorbed this move
static uint8_t flQ[FL_MAX * FL_MAX];
static uint16_t flCol[6];
static uint8_t flN, flCur, flOld, flTier;
static int flMoves, flLimit, flRegion;
static bool flEnding, flWon;
static unsigned long flAnimT0, flEndAt;
static const uint8_t kFlSize[4] = {10, 8, 12, 14};
static const uint8_t kFlLimit[4] = {21, 16, 25, 30};
static const uint8_t kFlCell[4] = {11, 12, 9, 8};
static const char* const kFlModes[4] = {"10x10 CLASSIC", "8x8 EASY", "12x12 BIG", "14x14 HUGE"};

static void enterFloodTitle() {
  gameState = ST_FLOOD_TITLE;
  drawStdTitleEx("FLOOD FILL", COL_BLUE, "Flood the whole board", "Left/Right: pick color", "A: absorb. Few moves!", 47,
                 kFlModes[g_variant & 3]);
}

// Recolours the flooded region to c and absorbs every touching cell of colour c.
static void flApply(uint8_t c) {
  int n = flN, total = n * n, qh = 0, qt = 0;
  flOld = flBd[0] & 7;
  for (int i = 0; i < total; i++)
    if (flBd[i] & 8) { flBd[i] = (uint8_t)(8 | c); flQ[qt++] = (uint8_t)i; }
  while (qh < qt) {
    int i = flQ[qh++], x = i % n, y = i / n;
    int nb[4], k = 0;
    if (x > 0) nb[k++] = i - 1;
    if (x < n - 1) nb[k++] = i + 1;
    if (y > 0) nb[k++] = i - n;
    if (y < n - 1) nb[k++] = i + n;
    for (int q = 0; q < k; q++) {
      int j = nb[q];
      if (!(flBd[j] & 8) && (flBd[j] & 7) == c) { flBd[j] = (uint8_t)(8 | 0x10 | c); flQ[qt++] = (uint8_t)j; }
    }
  }
  flRegion = qt;
}

// Level-creator board: tile id = colour 0-5. Board side = min(w,h); the move limit is
// derived from the colours used (colours * side / 2 + 2).
static bool flCustom = false;

static void floodLoadCustom(const LevelData *lvl) {
  int n = lvl->w < lvl->h ? lvl->w : lvl->h;
  if (n < 2) n = 2;
  if (n > FL_MAX) n = FL_MAX;
  uint8_t mask = 0;
  for (int r = 0; r < n; r++)
    for (int c = 0; c < n; c++) {
      uint8_t v = (r < lvl->h && c < lvl->w) ? (uint8_t)(lvl->cells[r][c] % 6) : 0;
      flBd[r * n + c] = v;
      mask |= (uint8_t)(1 << v);
    }
  int nc = 0;
  for (int i = 0; i < 6; i++) if (mask & (1 << i)) nc++;
  flN = (uint8_t)n;
  flTier = 0;
  flLimit = nc * n / 2 + 2;
  flCustom = true;
}

static bool floodValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  uint8_t mask = 0;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++) mask |= (uint8_t)(1 << (lvl->cells[r][c] % 6));
  int nc = 0;
  for (int i = 0; i < 6; i++) if (mask & (1 << i)) nc++;
  if (nc < 2) { snprintf(msg, msgLen, "Use at least 2 colours"); return false; }
  return true;
}

static void enterFloodPlaying() {
  s_mazeRng = gameSeed();
  flTier = (uint8_t)(g_variant & 3);
  flN = kFlSize[flTier];
  flLimit = kFlLimit[flTier];
  flCol[0] = arcada.display->color565(230, 55, 55);
  flCol[1] = arcada.display->color565(60, 200, 80);
  flCol[2] = arcada.display->color565(60, 110, 240);
  flCol[3] = arcada.display->color565(240, 220, 60);
  flCol[4] = arcada.display->color565(170, 80, 220);
  flCol[5] = arcada.display->color565(255, 140, 40);
  int total = flN * flN;
  for (int i = 0; i < total; i++) flBd[i] = (uint8_t)mazeRngRange(6);
  flCustom = false;
  if (s_lvlActiveSlot[LVLGAME_FLOOD] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_FLOOD, s_lvlActiveSlot[LVLGAME_FLOOD], &lvl)) {
      floodLoadCustom(&lvl);
      total = flN * flN;
    } else {
      s_lvlActiveSlot[LVLGAME_FLOOD] = -1;
    }
  }
  uint8_t c0 = flBd[0] & 7;
  flBd[0] = (uint8_t)(8 | c0);
  flApply(c0);
  for (int i = 0; i < total; i++) flBd[i] &= (uint8_t)~0x10;
  flCur = (uint8_t)((c0 + 1) % 6);
  flMoves = 0;
  flEnding = flWon = false;
  flAnimT0 = flEndAt = 0;
  s_lastFrameMs = 0;
  gameState = ST_FLOOD_PLAYING;
}

static void drawFlood(unsigned long now) {
  canvas->fillScreen(COL_BG);
  int n = flN, cs = kFlCell[flTier];
  const int ox = 4, oy = 14;
  unsigned long el = flAnimT0 ? now - flAnimT0 : 100000UL;
  int step = 200 / (2 * (n - 1));
  if (flAnimT0 && el >= 260UL) {
    for (int i = 0; i < n * n; i++) flBd[i] &= (uint8_t)~0x10;
    flAnimT0 = 0;
    el = 100000UL;
  }
  for (int i = 0; i < n * n; i++) {
    int x = i % n, y = i / n;
    uint8_t b = flBd[i];
    uint16_t col = flCol[(b & 7) % 6];
    if (flAnimT0 && (b & 8) && !(b & 0x10) && (unsigned long)((x + y) * step) > el) col = flCol[flOld % 6];
    canvas->fillRect(ox + x * cs, oy + y * cs, cs - 1, cs - 1, col);
    if ((b & 8) && cs >= 8) canvas->drawPixel(ox + x * cs + cs / 2 - 1, oy + y * cs + cs / 2 - 1, COL_BG);
  }
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 4, 3, "FLOOD FILL");
  ptc(COL_TEXT, 122, 14, "LEFT");
  canvas->setTextSize(2);
  int left = flLimit - flMoves;
  ptc(left <= 3 ? COL_LASER : COL_KEY, 122, 24, left);
  canvas->setTextSize(1);
  int32_t bs = saveBest(47, saveTierOf(g_variant));
  ptc(COL_TEXT, 122, 44, "BEST");
  canvas->setCursor(122, 54);
  if (bs == SAVE_NO_SCORE) canvas->print("--");
  else canvas->print((int)bs);
  for (int i = 0; i < 6; i++) {
    int x = 122 + (i % 2) * 18, y = 72 + (i / 2) * 18;
    canvas->fillRect(x, y, 16, 16, flCol[i]);
    if (i == flCur) {
      canvas->drawRect(x - 1, y - 1, 18, 18, COL_TEXT);
      canvas->drawRect(x, y, 16, 16, COL_BG);
    }
  }
  particlesUpdateDraw();
}

static void flToOver() {
  long score = flWon ? (long)(flLimit - flMoves + 1) * 10L : 0L;
  if (flWon) { sfxWin(); pixelsWinCelebration(); } else sfxDeath();
  if (!flCustom) recordResult(47, g_variant, score, true);   // custom limits aren't comparable
  else {
    s_lastNewBest = false;
    lvlRecordRun(LVLGAME_FLOOD, score, true);
    if (flWon) lvlOnClear(LVLGAME_FLOOD);
  }
  if (g_twoPlayerMode) { twoPHandleGameEnd(score); return; }
  gameState = ST_FLOOD_OVER;
  char big[12], sub[28];
  if (flWon) {
    snprintf(big, sizeof(big), "%ld", score);
    snprintf(sub, sizeof(sub), "%d moves left", flLimit - flMoves);
  } else {
    snprintf(big, sizeof(big), "--");
    snprintf(sub, sizeof(sub), "%d of %d cells flooded", flRegion, flN * flN);
  }
  drawStdOver(flWon ? "FLOODED!" : "OUT OF MOVES", flWon ? COL_GOAL : COL_LASER, big, sub, 47);
}

static void floodFrame(uint32_t buttons, uint32_t pressed) {
  (void)buttons;
  unsigned long now = millis();
  s_lastFrameMs = now;
  if (flEnding) {
    if ((long)(now - flEndAt) >= 0) { flToOver(); return; }
  } else {
    if (pressed & ARCADA_BUTTONMASK_LEFT) { flCur = (uint8_t)((flCur + 5) % 6); sfxMove(); }
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) { flCur = (uint8_t)((flCur + 1) % 6); sfxMove(); }
    else if (pressed & ARCADA_BUTTONMASK_UP) { flCur = (uint8_t)((flCur + 4) % 6); sfxMove(); }
    else if (pressed & ARCADA_BUTTONMASK_DOWN) { flCur = (uint8_t)((flCur + 2) % 6); sfxMove(); }
    else if ((pressed & ARCADA_BUTTONMASK_A) && !(flAnimT0 && now - flAnimT0 < 200UL)) {
      if (flCur == (flBd[0] & 7)) {
        sfxBlocked();
      } else {
        flMoves++;
        flApply(flCur);
        flAnimT0 = now;
        int total = flN * flN;
        sfx((uint16_t)(400 + (flRegion * 500) / total), 40);
        if (flRegion >= total) {
          flWon = true;
          flEnding = true;
          flEndAt = now + 700UL;
        } else if (flMoves >= flLimit) {
          flEnding = true;
          flEndAt = now + 700UL;
        }
      }
    }
  }
  drawFlood(now);
  blitScreen();
}

// --- Asteroids ------------------------------------------------------------------
//
// The arcade classic in vector style: the ship sits in the middle of a wrapping field.
// Left/Right rotate (0..255 = one turn, 32-entry flash sine table), A or Up thrusts
// (inertia + a little drag), Down brakes, B fires (hold = auto-fire, 6 shots at a time).
// Rocks split large -> 2 medium -> 2 small; a UFO flies through now and then and shoots
// at you (the small one is far more accurate). 3 lives by default, an extra life every
// 5000 points, waves of rocks that get faster. Fixed pools, no heap. Rock spawns/splits
// come from the round seed (2P player 2 sees the same waves). Tiers = lives / rock speed /
// UFO frequency. Score = points.

#define RK_NR 12
#define RK_NB 6
#define RK_NU 2
static const int8_t kRkSin[32] = {0, 25, 49, 71, 90, 106, 117, 125, 127, 125, 117, 106, 90, 71, 49, 25,
                                  0, -25, -49, -71, -90, -106, -117, -125, -127, -125, -117, -106, -90, -71, -49, -25};
static const int8_t kRkShape[4][8] = {{0, 2, -1, 1, 0, -2, 1, -1}, {1, -1, 2, 0, -2, 1, 0, -1},
                                      {-1, 1, 0, 2, -1, 0, -2, 1}, {0, -2, 1, -1, 2, 0, 1, -1}};
static const uint8_t kRkRad[4] = {0, 3, 6, 10};          // radius by size (1 small, 2 medium, 3 large)
static const uint8_t kRkPts[4] = {0, 100, 50, 20};
static const uint8_t kRkLives[4] = {3, 3, 5, 2};
static const uint8_t kRkSpeed[4] = {22, 32, 15, 36};     // base rock speed, px/s
static const uint8_t kRkUfoGap[4] = {24, 17, 36, 11};    // seconds between UFOs
static const uint8_t kRkRocks[4] = {3, 3, 3, 4};         // large rocks in wave 1
static const char* const kRkModes[4] = {"NORMAL 3 LIVES", "FAST ROCKS", "CHILL 5 LIVES", "EXTREME 2 LIVES"};

static float rkRx[RK_NR], rkRy[RK_NR], rkRvx[RK_NR], rkRvy[RK_NR];
static uint8_t rkRs[RK_NR], rkRsh[RK_NR];                // size (0 = free) and outline variant
static float rkBx[RK_NB], rkBy[RK_NB], rkBvx[RK_NB], rkBvy[RK_NB], rkBl[RK_NB];     // life left, s (<=0 = free)
static float rkUbx[RK_NU], rkUby[RK_NU], rkUbvx[RK_NU], rkUbvy[RK_NU], rkUbl[RK_NU];
static float rkSx, rkSy, rkSvx, rkSvy, rkAng;
static float rkUx, rkUy, rkUvx, rkUvy, rkUturn, rkUfire;
static float rkRespawn, rkInv, rkFireCd, rkUfoIn, rkWaveT, rkBanner, rkOverT;
static int rkScore, rkLives, rkWave, rkKilled, rkNextLife;
static uint8_t rkTier;
static bool rkAlive, rkUfo, rkUsmall, rkThrust, rkWaveWait, rkEnded;
// Hyperspace (A+B pressed together): cooldown s, last A/B press times, previous buttons.
static float rkHsCd;
static uint8_t rkJumps;   // hyperspace jumps survived this run ("Phase Shift" at 5)
static uint32_t rkAT, rkBT, rkPrevBtn;
static const uint8_t kRkHsOdds[4] = {8, 8, 16, 5};       // 1-in-N chance of exploding on arrival

static void enterRocksTitle() {
  gameState = ST_ROCKS_TITLE;
  drawStdTitleEx("ASTEROIDS", COL_ORANGE, "Left/Right: rotate", "A/Up: thrust  B: fire", "Down brake  A+B hyperjump", 48,
                 kRkModes[g_variant & 3]);
}

static float rkWrapD(float a, float b, float span) {
  float d = fabsf(a - b);
  return d > span * 0.5f ? span - d : d;
}
static bool rkHit(float ax, float ay, float bx, float by, float r) {
  float dx = rkWrapD(ax, bx, 160.0f), dy = rkWrapD(ay, by, 128.0f);
  return dx * dx + dy * dy < r * r;
}
static void rkWrap(float &x, float &y) {
  if (x < 0.0f) x += 160.0f;
  else if (x >= 160.0f) x -= 160.0f;
  if (y < 0.0f) y += 128.0f;
  else if (y >= 128.0f) y -= 128.0f;
}

// Random drift velocity for a rock of the given size, scaled by tier and wave.
static void rkRockVel(int sz, float &vx, float &vy) {
  float spd = (float)kRkSpeed[rkTier] * (1.0f + 0.07f * (float)(rkWave > 9 ? 8 : rkWave - 1));
  spd *= (sz == 1) ? 1.7f : (sz == 2) ? 1.25f : 1.0f;
  spd *= (float)(70 + mazeRngRange(61)) / 100.0f;
  int k = mazeRngRange(32);
  vx = (float)kRkSin[k] * spd / 127.0f;
  vy = -(float)kRkSin[(k + 8) & 31] * spd / 127.0f;
}

static bool rkSpawnRock(int sz, float x, float y) {
  for (int i = 0; i < RK_NR; i++) {
    if (rkRs[i]) continue;
    rkRs[i] = (uint8_t)sz;
    rkRsh[i] = (uint8_t)mazeRngRange(4);
    rkRx[i] = x;
    rkRy[i] = y;
    rkRockVel(sz, rkRvx[i], rkRvy[i]);
    return true;
  }
  return false;   // pool full: the extra fragment is simply dropped
}

static int rkRocksLeft() {
  int n = 0;
  for (int i = 0; i < RK_NR; i++) if (rkRs[i]) n++;
  return n;
}

static void rkNewWave() {
  rkWave++;
  int n = kRkRocks[rkTier] + (rkWave - 1) / 2;
  if (n > 5) n = 5;
  for (int k = 0; k < n; k++) {
    float x = 0.0f, y = 0.0f;
    for (int t = 0; t < 10; t++) {
      x = (float)mazeRngRange(160);
      y = (float)mazeRngRange(128);
      if (rkWrapD(x, 80.0f, 160.0f) > 36.0f || rkWrapD(y, 64.0f, 128.0f) > 36.0f) break;
    }
    rkSpawnRock(3, x, y);
  }
  rkBanner = 1.4f;
  rkUfoIn = (float)kRkUfoGap[rkTier] * 0.6f;
}

static void rkAddScore(int p) {
  rkScore += p;
  while (rkScore >= rkNextLife) {
    rkNextLife += 5000;
    if (rkLives < 6) rkLives++;
    sfx(1500, 90);
    pixelsFlash(0, 255, 90, 60);
  }
}

static void rkBreakRock(int i) {
  int sz = rkRs[i];
  float x = rkRx[i], y = rkRy[i];
  rkRs[i] = 0;
  rkKilled++;
  rkAddScore(kRkPts[sz]);
  if (sz == 3) { explosionBurst((int)x, (int)y, 12, 0); screenShake(170, 3); }   // shake grows with the rock size
  else {
    particlesBurst((int)x, (int)y, 4 + sz * 3, 0);
    if (sz == 2) screenShake(80, 1);
  }
  sfx((uint16_t)(sz == 3 ? 160 : sz == 2 ? 250 : 380), (uint16_t)(sz == 3 ? 60 : 40));
  if (sz > 1) {
    rkSpawnRock(sz - 1, x, y);
    rkSpawnRock(sz - 1, x, y);
  }
}

static void rkKillShip() {
  rkAlive = false;
  rkLives--;
  explosionBurst((int)rkSx, (int)rkSy, 18, 0);
  screenShake(300, 3);
  sfxDeath();
  pixelsFlash(255, 90, 0, 90);
  rkRespawn = 1.4f;
  rkSvx = rkSvy = 0.0f;
  if (rkLives <= 0) rkOverT = 1.6f;
}

static void rkFireUfo() {
  float dx = rkSx - rkUx, dy = rkSy - rkUy;
  if (dx > 80.0f) dx -= 160.0f;
  if (dx < -80.0f) dx += 160.0f;
  if (dy > 64.0f) dy -= 128.0f;
  if (dy < -64.0f) dy += 128.0f;
  float err = rkUsmall ? 0.22f : (rkTier == 2 ? 1.3f : 0.9f);
  if (rkTier == 3) err *= 0.7f;
  float a = atan2f(dy, dx) + err * ((float)mazeRngRange(201) - 100.0f) / 100.0f;
  for (int i = 0; i < RK_NU; i++) {
    if (rkUbl[i] > 0.0f) continue;
    rkUbx[i] = rkUx;
    rkUby[i] = rkUy;
    rkUbvx[i] = cosf(a) * 75.0f;
    rkUbvy[i] = sinf(a) * 75.0f;
    rkUbl[i] = 1.7f;
    sfx(300, 40);
    break;
  }
}

static void enterRocksPlaying() {
  s_mazeRng = gameSeed();
  rkTier = (uint8_t)(g_variant & 3);
  for (int i = 0; i < RK_NR; i++) rkRs[i] = 0;
  for (int i = 0; i < RK_NB; i++) rkBl[i] = 0.0f;
  for (int i = 0; i < RK_NU; i++) rkUbl[i] = 0.0f;
  rkScore = 0;
  rkLives = kRkLives[rkTier];
  rkWave = 0;
  rkKilled = 0;
  rkNextLife = 5000;
  rkSx = 80.0f;
  rkSy = 64.0f;
  rkSvx = rkSvy = 0.0f;
  rkAng = 0.0f;
  rkAlive = true;
  rkUfo = false;
  rkThrust = false;
  rkWaveWait = false;
  rkEnded = false;
  rkRespawn = 0.0f;
  rkInv = 1.5f;
  rkFireCd = 0.0f;
  rkOverT = 0.0f;
  rkHsCd = 0.0f;
  rkJumps = 0;
  rkAT = rkBT = 0;
  rkPrevBtn = 0;
  rkNewWave();
  s_lastFrameMs = 0;
  gameState = ST_ROCKS_PLAYING;
}

// Hyperspace jump: a random spot that is clear of rocks if one is found in 8 tries; the
// tier decides the 1-in-N chance of blowing up on arrival.
static void rkHyper() {
  float nx = rkSx, ny = rkSy;
  for (int t = 0; t < 8; t++) {
    nx = (float)mazeRngRange(160);
    ny = (float)mazeRngRange(128);
    bool ok = true;
    for (int i = 0; i < RK_NR && ok; i++)
      if (rkRs[i] && rkHit(rkRx[i], rkRy[i], nx, ny, (float)kRkRad[rkRs[i]] + 14.0f)) ok = false;
    if (ok && rkUfo && rkHit(rkUx, rkUy, nx, ny, 24.0f)) ok = false;
    if (ok) break;
  }
  particlesBurst((int)rkSx, (int)rkSy, 6, COL_KEY);
  rkSx = nx;
  rkSy = ny;
  rkSvx = rkSvy = 0.0f;
  rkHsCd = 1.5f;
  rkFireCd = 0.2f;
  particlesBurst((int)nx, (int)ny, 6, COL_KEY);
  if (mazeRngRange(kRkHsOdds[rkTier & 3]) == 0) { rkInv = 0.0f; rkKillShip(); }
  else {
    rkInv = 0.4f;
    sfx(1100, 60);
    if (rkJumps < 255) rkJumps++;
    if (rkJumps == 5 && !miscGetFlag(MF_ACH_PHASE)) { miscSetFlag(MF_ACH_PHASE, true); checkAchievements(); }   // "Phase Shift"
  }
}

static void rkToOver() {
  rkEnded = true;
  long sc = rkScore;
  recordResult(48, g_variant, sc, true);
  if (g_twoPlayerMode) { twoPHandleGameEnd(sc); return; }
  gameState = ST_ROCKS_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%ld", sc);
  snprintf(sub, sizeof(sub), "wave %d  rocks hit %d", rkWave, rkKilled);
  drawStdOver("SHIP LOST", COL_LASER, big, sub, 48);
}

// One physics step of h seconds (called 1-3 times per frame so bullets cannot tunnel).
static void rkStep(float h, uint32_t buttons) {
  // --- ship ---
  if (rkInv > 0.0f) rkInv -= h;
  if (rkAlive) {
    if (buttons & ARCADA_BUTTONMASK_LEFT) rkAng -= 150.0f * h;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) rkAng += 150.0f * h;
    if (rkAng < 0.0f) rkAng += 256.0f;
    if (rkAng >= 256.0f) rkAng -= 256.0f;
    int idx = ((int)rkAng >> 3) & 31;
    float sn = (float)kRkSin[idx] / 127.0f, cs = (float)kRkSin[(idx + 8) & 31] / 127.0f;
    bool th = (buttons & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_UP)) != 0;
    if (th) {
      rkSvx += sn * 100.0f * h;
      rkSvy -= cs * 100.0f * h;
      if (!rkThrust) sfx(150, 25);
    }
    rkThrust = th;
    float damp = 1.0f - 0.3f * h;
    if (buttons & ARCADA_BUTTONMASK_DOWN) damp -= 3.2f * h;
    if (damp < 0.0f) damp = 0.0f;
    rkSvx *= damp;
    rkSvy *= damp;
    float sp2 = rkSvx * rkSvx + rkSvy * rkSvy;
    if (sp2 > 14400.0f) {
      float k = 120.0f / sqrtf(sp2);
      rkSvx *= k;
      rkSvy *= k;
    }
    rkSx += rkSvx * h;
    rkSy += rkSvy * h;
    rkWrap(rkSx, rkSy);
    if (rkFireCd > 0.0f) rkFireCd -= h;
    if ((buttons & ARCADA_BUTTONMASK_B) && rkFireCd <= 0.0f) {
      for (int i = 0; i < RK_NB; i++) {
        if (rkBl[i] > 0.0f) continue;
        rkBx[i] = rkSx + sn * 6.0f;
        rkBy[i] = rkSy - cs * 6.0f;
        rkBvx[i] = rkSvx * 0.5f + sn * 175.0f;
        rkBvy[i] = rkSvy * 0.5f - cs * 175.0f;
        rkBl[i] = 0.85f;
        rkFireCd = 0.17f;
        sfx(880, 18);
        break;
      }
    }
  } else {
    rkThrust = false;
    if (rkLives > 0) {
      rkRespawn -= h;
      if (rkRespawn <= 0.0f) {
        bool clear = true;
        for (int i = 0; i < RK_NR; i++)
          if (rkRs[i] && rkHit(rkRx[i], rkRy[i], 80.0f, 64.0f, (float)kRkRad[rkRs[i]] + 26.0f)) clear = false;
        if (clear || rkRespawn < -2.5f) {
          rkAlive = true;
          rkSx = 80.0f;
          rkSy = 64.0f;
          rkSvx = rkSvy = 0.0f;
          rkAng = 0.0f;
          rkInv = 2.0f;
          sfx(700, 50);
        }
      }
    } else {
      rkOverT -= h;
    }
  }
  // --- rocks ---
  for (int i = 0; i < RK_NR; i++) {
    if (!rkRs[i]) continue;
    rkRx[i] += rkRvx[i] * h;
    rkRy[i] += rkRvy[i] * h;
    rkWrap(rkRx[i], rkRy[i]);
    if (rkAlive && rkInv <= 0.0f && rkHit(rkRx[i], rkRy[i], rkSx, rkSy, (float)kRkRad[rkRs[i]] + 2.5f)) rkKillShip();
  }
  // --- player bullets ---
  for (int b = 0; b < RK_NB; b++) {
    if (rkBl[b] <= 0.0f) continue;
    rkBl[b] -= h;
    rkBx[b] += rkBvx[b] * h;
    rkBy[b] += rkBvy[b] * h;
    rkWrap(rkBx[b], rkBy[b]);
    bool gone = false;
    for (int i = 0; i < RK_NR && !gone; i++) {
      if (rkRs[i] && rkHit(rkBx[b], rkBy[b], rkRx[i], rkRy[i], (float)kRkRad[rkRs[i]] + 1.5f)) {
        rkBl[b] = 0.0f;
        rkBreakRock(i);
        gone = true;
      }
    }
    if (!gone && rkUfo && rkHit(rkBx[b], rkBy[b], rkUx, rkUy, rkUsmall ? 5.0f : 7.0f)) {
      rkBl[b] = 0.0f;
      rkUfo = false;
      rkAddScore(rkUsmall ? 1000 : 200);
      particlesBurst((int)rkUx, (int)rkUy, 14, 0);
      sfx(700, 90);
      rkUfoIn = (float)kRkUfoGap[rkTier] * (float)(70 + mazeRngRange(61)) / 100.0f;
    }
  }
  // --- UFO ---
  if (rkUfo) {
    rkUx += rkUvx * h;
    rkUy += rkUvy * h;
    if (rkUy < 14.0f) { rkUy = 14.0f; rkUvy = fabsf(rkUvy); }
    if (rkUy > 122.0f) { rkUy = 122.0f; rkUvy = -fabsf(rkUvy); }
    rkUturn -= h;
    if (rkUturn <= 0.0f) {
      rkUturn = 0.9f + (float)mazeRngRange(10) / 10.0f;
      rkUvy = (float)(mazeRngRange(3) - 1) * 20.0f;
    }
    if (rkUx < -10.0f || rkUx > 170.0f) {
      rkUfo = false;
      rkUfoIn = (float)kRkUfoGap[rkTier] * (float)(70 + mazeRngRange(61)) / 100.0f;
    } else {
      rkUfire -= h;
      if (rkUfire <= 0.0f && rkAlive) {
        rkFireUfo();
        rkUfire = rkUsmall ? 0.9f : 1.5f;
      }
      float ur = rkUsmall ? 4.0f : 6.0f;
      if (rkAlive && rkInv <= 0.0f && rkHit(rkUx, rkUy, rkSx, rkSy, ur + 3.0f)) {
        rkKillShip();
        rkUfo = false;
        particlesBurst((int)rkUx, (int)rkUy, 10, 0);
      }
    }
  } else if (rkRocksLeft() > 0 && !rkWaveWait) {
    rkUfoIn -= h;
    if (rkUfoIn <= 0.0f) {
      rkUfo = true;
      rkUsmall = mazeRngRange(100) < (rkWave - 1) * 15 + (rkTier == 3 ? 25 : 0);
      bool left = (mazeRngRange(2) == 0);
      rkUx = left ? -6.0f : 166.0f;
      rkUy = 20.0f + (float)mazeRngRange(88);
      rkUvx = (left ? 1.0f : -1.0f) * (rkUsmall ? 42.0f : 30.0f);
      rkUvy = 0.0f;
      rkUturn = 1.0f;
      rkUfire = 1.2f;
      sfx(1200, 40);
    }
  }
  // --- UFO bullets ---
  for (int b = 0; b < RK_NU; b++) {
    if (rkUbl[b] <= 0.0f) continue;
    rkUbl[b] -= h;
    rkUbx[b] += rkUbvx[b] * h;
    rkUby[b] += rkUbvy[b] * h;
    rkWrap(rkUbx[b], rkUby[b]);
    if (rkAlive && rkInv <= 0.0f && rkHit(rkUbx[b], rkUby[b], rkSx, rkSy, 4.0f)) {
      rkUbl[b] = 0.0f;
      rkKillShip();
    }
  }
}

static void rkDrawShip(int x, int y, int idx, uint16_t col, bool flame) {
  int nx = x + (kRkSin[idx & 31] * 7) / 127, ny = y - (kRkSin[(idx + 8) & 31] * 7) / 127;
  int i1 = (idx + 13) & 31, i2 = (idx + 19) & 31, i3 = (idx + 16) & 31;
  int lx = x + (kRkSin[i1] * 5) / 127, ly = y - (kRkSin[(i1 + 8) & 31] * 5) / 127;
  int rx = x + (kRkSin[i2] * 5) / 127, ry = y - (kRkSin[(i2 + 8) & 31] * 5) / 127;
  int tx = x + (kRkSin[i3] * 3) / 127, ty = y - (kRkSin[(i3 + 8) & 31] * 3) / 127;
  canvas->drawLine(nx, ny, lx, ly, col);
  canvas->drawLine(lx, ly, tx, ty, col);
  canvas->drawLine(tx, ty, rx, ry, col);
  canvas->drawLine(rx, ry, nx, ny, col);
  if (flame) {
    int fx = x + (kRkSin[i3] * 8) / 127, fy = y - (kRkSin[(i3 + 8) & 31] * 8) / 127;
    canvas->drawLine(tx, ty, fx, fy, COL_ORANGE);
  }
}

static void rkDrawRock(int i) {
  int r = kRkRad[rkRs[i]], x = (int)rkRx[i], y = (int)rkRy[i];
  int px = 0, py = 0, fx = 0, fy = 0;
  for (int k = 0; k < 8; k++) {
    int rr = r + (kRkShape[rkRsh[i] & 3][k] * r) / 8;
    int vx = x + (kRkSin[k * 4] * rr) / 127, vy = y - (kRkSin[(k * 4 + 8) & 31] * rr) / 127;
    if (k == 0) { fx = vx; fy = vy; }
    else canvas->drawLine(px, py, vx, vy, COL_TEXT);
    px = vx;
    py = vy;
  }
  canvas->drawLine(px, py, fx, fy, COL_TEXT);
}

static void rkDrawUfo(int x, int y, int a) {
  int b = a / 2;
  canvas->drawFastHLine(x - a, y, 2 * a + 1, COL_LASER);
  canvas->drawLine(x - a, y, x - b, y + b, COL_LASER);
  canvas->drawLine(x + a, y, x + b, y + b, COL_LASER);
  canvas->drawFastHLine(x - b, y + b, 2 * b + 1, COL_LASER);
  canvas->drawLine(x - a, y, x - b, y - b, COL_LASER);
  canvas->drawLine(x + a, y, x + b, y - b, COL_LASER);
  canvas->drawFastHLine(x - b, y - b, 2 * b + 1, COL_LASER);
}

static void drawRocks() {
  canvas->fillScreen(COL_BG);
  for (int i = 0; i < 14; i++) canvas->drawPixel((i * 37 + 11) % 160, (i * 53 + 7) % 128, COL_WALL_NOPORTAL);
  for (int i = 0; i < RK_NR; i++) if (rkRs[i]) rkDrawRock(i);
  if (rkUfo) rkDrawUfo((int)rkUx, (int)rkUy, rkUsmall ? 4 : 6);
  for (int b = 0; b < RK_NB; b++)
    if (rkBl[b] > 0.0f) canvas->fillRect((int)rkBx[b], (int)rkBy[b], 2, 2, COL_KEY);
  for (int b = 0; b < RK_NU; b++)
    if (rkUbl[b] > 0.0f) canvas->fillRect((int)rkUbx[b], (int)rkUby[b], 2, 2, COL_LASER);
  if (rkAlive && (rkInv <= 0.0f || ((int)(rkInv * 12.0f) & 1) == 0))
    rkDrawShip((int)rkSx, (int)rkSy, ((int)rkAng >> 3) & 31, COL_PLAYER, rkThrust && ((millis() >> 6) & 1));
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  char t[20];
  snprintf(t, sizeof(t), "%d", rkScore);
  pt(2, 2, t);
  for (int i = 0; i < rkLives && i < 6; i++) {
    int cx = 154 - i * 9;
    canvas->drawLine(cx, 2, cx - 3, 9, COL_PLAYER);
    canvas->drawLine(cx, 2, cx + 3, 9, COL_PLAYER);
    canvas->drawLine(cx - 3, 9, cx + 3, 9, COL_PLAYER);
  }
  snprintf(t, sizeof(t), "W%d", rkWave);
  drawHudLine2(t, 48);
  {   // hyperspace indicator: bar fills during the 1.5 s cooldown, "HS" lights when ready
    bool rdy = rkHsCd <= 0.0f;
    int fill = rdy ? 24 : (int)((1.5f - rkHsCd) * 16.0f);
    if (fill < 0) fill = 0;
    if (fill > 24) fill = 24;
    ptc(rdy ? COL_KEY : COL_WALL, 2, 120, "HS");
    canvas->drawRect(16, 120, 26, 7, COL_WALL);
    canvas->fillRect(17, 121, fill, 5, rdy ? COL_KEY : COL_ORANGE);
  }
  if (rkBanner > 0.0f) {
    canvas->setTextSize(2);
    canvas->setTextColor(COL_ORANGE);
    snprintf(t, sizeof(t), "WAVE %d", rkWave);
    pt((160 - (int)strlen(t) * 12) / 2, 56, t);
    canvas->setTextSize(1);
  }
  particlesUpdateDraw();
}

static void rocksFrame(uint32_t buttons) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;
  if (rkEnded) return;
  // A+B pressed together (both fresh presses within 50 ms) = hyperspace; A or B alone is unchanged, and so is
  // thrust+fire while the jump is cooling down or the ship is dead (inputs are only eaten when the jump fires).
  uint32_t newly = buttons & ~rkPrevBtn;
  rkPrevBtn = buttons;
  if (newly & ARCADA_BUTTONMASK_A) rkAT = now;
  if (newly & ARCADA_BUTTONMASK_B) rkBT = now;
  if (rkHsCd > 0.0f) rkHsCd -= dt;
  if ((newly & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B)) &&
      (buttons & ARCADA_BUTTONMASK_A) && (buttons & ARCADA_BUTTONMASK_B) &&
      (uint32_t)(now - rkAT) <= 50 && (uint32_t)(now - rkBT) <= 50 && rkAlive && rkHsCd <= 0.0f) {
    buttons &= ~(uint32_t)(ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B);   // this frame: no thrust/shot
    rkHyper();
  }
  int steps = (int)(dt / 0.02f) + 1;
  if (steps > 3) steps = 3;
  float h = dt / (float)steps;
  for (int s = 0; s < steps; s++) rkStep(h, buttons);
  if (rkBanner > 0.0f) rkBanner -= dt;
  // wave bookkeeping
  if (rkRocksLeft() == 0 && !rkUfo) {
    if (!rkWaveWait) {
      rkWaveWait = true;
      rkWaveT = 1.6f;
      sfxWin();
    } else {
      rkWaveT -= dt;
      if (rkWaveT <= 0.0f) {
        rkWaveWait = false;
        rkNewWave();
      }
    }
  }
  if (rkLives <= 0 && !rkAlive && rkOverT <= 0.0f) { rkToOver(); return; }
  drawRocks();
  blitScreen();
}

// --- Gem Swap ----------------------------------------------------------------------
//
// Match-3 on an 8x8 board with 6 gem shapes/colours (5 on the Chill tier). D-pad moves the
// cursor, A picks up a gem, then a D-pad direction swaps it with that neighbour (B or A puts
// it down again). A swap that makes no run of 3+ slides back. Matches flash and vanish, the
// gems above fall with a bounce and the top refills from the round seed (so 2P player 2 gets
// exactly the same refills for the same moves); chains score x1, x2, x3 ... The start board has
// no matches and at least one legal move; if a refill leaves no move the board is reshuffled.
// Score = points before the clock runs out. Tiers = time limit (and 5 gems on Chill). A
// non-blocking phase machine drives every animation (all <= ~300 ms).

#define GM_N 8
#define GM_CS 14
#define GM_OX 4
#define GM_OY 14
#define GP_IDLE 0
#define GP_SWAP 1
#define GP_BACK 2
#define GP_CLEAR 3
#define GP_FALL 4
#define GP_SHUF 5
#define GP_END 6
static uint8_t gmBd[GM_N * GM_N];     // gem 0-5 (+0x40 while marked for clearing), 7 = empty
static uint8_t gmDrop[GM_N * GM_N];   // rows each gem still has to fall (animation only)
static uint16_t gmCol[6];
static uint8_t gmTypes, gmPhase, gmCx, gmCy, gmSel, gmSA, gmSB, gmHint;
static bool gmHintSp;   // the shown hint involves a bomb / colour gem (drawn as a glow)
static int gmScore, gmChain, gmBestChain, gmMoves, gmLongest, gmMaxDrop, gmPopV, gmPopX, gmPopY, gmLastSec;
static float gmTime;
static unsigned long gmPhT0, gmPhMs, gmLastInput, gmRepT, gmPopT0;
static const uint8_t kGmSecs[4] = {60, 40, 90, 30};
static const uint8_t kGmTypes[4] = {6, 6, 5, 6};
static const char* const kGmModes[4] = {"60 SECONDS", "40 SEC, FAST", "90 SEC, 5 GEMS", "30 SEC SPRINT"};

// Level-creator start board (tiles 0-5 = gem, 6 = random gem). A custom board is cleared by
// reaching the tier's target score before the clock runs out.
static bool gmCustom = false, gmWon = false;
static const uint16_t kGmTarget[4] = {1500, 1200, 1800, 800};

// Cell byte bits: 0-2 gem (7 = empty), 0x08 bomb gem (clears 3x3), 0x10 colour-clear gem
// (clears every gem of the swapped colour), 0x20 scratch, 0x40 marked, 0x80 special used.
#define GMF_BOMB 0x08
#define GMF_STAR 0x10
// Title option: 0 = TIMER, 1 = MOVES (25 moves, no clock, no hand-made-level target).
static uint8_t gmMode = 0;
static int gmMovesLeft = 0;
#define GM_MOVES 25
static uint8_t gmMkCell[2], gmMkKind[2], gmMkN;   // specials to create after the current match pass
static const char* const kGmModesM[4] = {"25 MOVES", "25 MOVES", "25 MOVES, 5 GEMS", "25 MOVES"};

static void enterGemTitle() {
  gameState = ST_GEM_TITLE;
  drawStdTitleEx("GEM SWAP", COL_BLUE, "D-pad move, A grab+swap", "4 = bomb  5 = colour gem",
                 gmMode ? "Mode: MOVES (Down: TIMER)" : "Mode: TIMER (Down: MOVES)", 49,
                 gmMode ? kGmModesM[g_variant & 3] : kGmModes[g_variant & 3]);
}

// True when cell (x,y) sits in a horizontal or vertical run of 3 or more equal gems.
static bool gmRunAt(int x, int y) {
  uint8_t g = gmBd[y * GM_N + x] & 7;
  if (g > 5) return false;
  int c = 1;
  for (int k = x - 1; k >= 0 && (gmBd[y * GM_N + k] & 7) == g; k--) c++;
  for (int k = x + 1; k < GM_N && (gmBd[y * GM_N + k] & 7) == g; k++) c++;
  if (c >= 3) return true;
  c = 1;
  for (int k = y - 1; k >= 0 && (gmBd[k * GM_N + x] & 7) == g; k--) c++;
  for (int k = y + 1; k < GM_N && (gmBd[k * GM_N + x] & 7) == g; k++) c++;
  return c >= 3;
}

// Flags every gem that belongs to a run of 3+ (0x40). Returns how many are flagged and sets
// gmLongest to the longest run found.
static void gmAddMake(int cell, uint8_t kind) {
  if (cell < 0 || cell >= GM_N * GM_N || (gmBd[cell] & (GMF_BOMB | GMF_STAR))) return;
  for (int j = 0; j < gmMkN; j++)
    if (gmMkCell[j] == cell) { if (kind > gmMkKind[j]) gmMkKind[j] = kind; return; }   // star (0x10) beats bomb
  if (gmMkN < 2) { gmMkCell[gmMkN] = (uint8_t)cell; gmMkKind[gmMkN] = kind; gmMkN++; }
}
// Sets up a special's effect: marks its 3x3 (bomb) or every gem of one colour (star;
// tgt = 0..5 colour, 99 = whole board, -1 = its own colour).
static void gmActivate(int c, int tgt) {
  uint8_t v = gmBd[c];
  gmBd[c] |= 0xC0;
  if (v & GMF_BOMB) {
    int x = c % GM_N, y = c / GM_N;
    for (int dy = -1; dy <= 1; dy++)
      for (int dx = -1; dx <= 1; dx++) {
        int nx = x + dx, ny = y + dy;
        if (nx < 0 || ny < 0 || nx >= GM_N || ny >= GM_N) continue;
        if ((gmBd[ny * GM_N + nx] & 7) != 7) gmBd[ny * GM_N + nx] |= 0x40;
      }
  }
  if (v & GMF_STAR) {
    int col = tgt < 0 ? (v & 7) : tgt;
    for (int i = 0; i < GM_N * GM_N; i++)
      if ((gmBd[i] & 7) != 7 && (tgt == 99 || (gmBd[i] & 7) == col)) gmBd[i] |= 0x40;
  }
}

// fromSwap: the board was just changed by the player's swap of gmSA/gmSB (specials on either
// swapped cell go off; new specials appear on a swapped cell when it is part of the run).
static int gmMark(bool fromSwap) {
  int n = 0;
  gmLongest = 0;
  gmMkN = 0;
  for (int pass = 0; pass < 2; pass++) {
    for (int a = 0; a < GM_N; a++) {
      int b = 0;
      while (b < GM_N) {
        int i = pass ? (b * GM_N + a) : (a * GM_N + b);
        uint8_t g = gmBd[i] & 7;
        if (g > 5) { b++; continue; }
        int e = b + 1;
        while (e < GM_N && (gmBd[pass ? (e * GM_N + a) : (a * GM_N + e)] & 7) == g) e++;
        if (e - b >= 3) {
          if (e - b > gmLongest) gmLongest = e - b;
          int pick = -1, bestSc = 0;
          for (int k = b; k < e; k++) {
            int ci = pass ? (k * GM_N + a) : (a * GM_N + k);
            if (pass && (gmBd[ci] & 0x20)) gmAddMake(ci, GMF_BOMB);          // L / T shape
            gmBd[ci] |= pass ? 0x40 : 0x60;
            if (gmBd[ci] & (GMF_BOMB | GMF_STAR)) continue;
            int sc = (fromSwap && (ci == (int)gmSA || ci == (int)gmSB)) ? 3 : (k == (b + e) / 2 ? 2 : 1);
            if (sc > bestSc) { bestSc = sc; pick = ci; }
          }
          if (e - b >= 4) gmAddMake(pick, e - b >= 5 ? GMF_STAR : GMF_BOMB);
        }
        b = e;
      }
    }
  }
  for (int i = 0; i < GM_N * GM_N; i++) gmBd[i] &= (uint8_t)~0x20;
  if (fromSwap) {   // a special that was swapped always goes off
    int s2[2] = {gmSA, gmSB};
    for (int j = 0; j < 2; j++) {
      int c = s2[j], o = s2[1 - j];
      if (!(gmBd[c] & (GMF_BOMB | GMF_STAR)) || (gmBd[c] & 0x80)) continue;
      gmActivate(c, (gmBd[o] & GMF_STAR) ? 99 : (gmBd[o] & 7));
    }
  }
  for (bool again = true; again;) {   // specials caught in a match / blast go off too (chains)
    again = false;
    for (int i = 0; i < GM_N * GM_N; i++)
      if ((gmBd[i] & 0x40) && (gmBd[i] & (GMF_BOMB | GMF_STAR)) && !(gmBd[i] & 0x80)) { gmActivate(i, -1); again = true; }
  }
  for (int j = 0; j < gmMkN; j++) {   // the new special stays on the board
    int c = gmMkCell[j];
    if ((gmBd[c] & 7) > 5) continue;
    gmBd[c] = (uint8_t)((gmBd[c] & 7) | gmMkKind[j]);
    if (gmMkKind[j] == GMF_BOMB) specialDelivery();
  }
  for (int i = 0; i < GM_N * GM_N; i++) if (gmBd[i] & 0x40) n++;
  return n;
}

// Looks for any legal swap. Writes the first cell and the direction (0 right, 1 down) when asked.
static bool gmHasMove(int* mx, int* my, int* md) {
  for (int y = 0; y < GM_N; y++) {
    for (int x = 0; x < GM_N; x++) {
      for (int d = 0; d < 2; d++) {
        int nx = x + (d == 0 ? 1 : 0), ny = y + (d == 1 ? 1 : 0);
        if (nx >= GM_N || ny >= GM_N) continue;
        int a = y * GM_N + x, b = ny * GM_N + nx;
        uint8_t t = gmBd[a];
        gmBd[a] = gmBd[b];
        gmBd[b] = t;
        bool ok = gmRunAt(x, y) || gmRunAt(nx, ny) || ((gmBd[a] | gmBd[b]) & (GMF_BOMB | GMF_STAR)) != 0;
        t = gmBd[a];
        gmBd[a] = gmBd[b];
        gmBd[b] = t;
        if (ok) {
          if (mx) *mx = x;
          if (my) *my = y;
          if (md) *md = d;
          return true;
        }
      }
    }
  }
  return false;
}

// First swap that involves a bomb / colour gem (always legal): preferred for the idle hint.
static bool gmFindSpecial(int* mx, int* my, int* md) {
  for (int y = 0; y < GM_N; y++) {
    for (int x = 0; x < GM_N; x++) {
      for (int d = 0; d < 2; d++) {
        int nx = x + (d == 0 ? 1 : 0), ny = y + (d == 1 ? 1 : 0);
        if (nx >= GM_N || ny >= GM_N) continue;
        int a = y * GM_N + x, b = ny * GM_N + nx;
        if ((gmBd[a] & 7) > 5 || (gmBd[b] & 7) > 5) continue;
        if (!((gmBd[a] | gmBd[b]) & (GMF_BOMB | GMF_STAR))) continue;
        *mx = x; *my = y; *md = d;
        return true;
      }
    }
  }
  return false;
}

// Fills the whole board with no ready-made runs and at least one legal move.
static void gmFill() {
  for (int attempt = 0; attempt < 40; attempt++) {
    for (int i = 0; i < GM_N * GM_N; i++) {
      int x = i % GM_N, y = i / GM_N;
      uint8_t g = (uint8_t)mazeRngRange(gmTypes);
      for (int t = 0; t < gmTypes; t++) {
        bool bad = (x >= 2 && gmBd[i - 1] == g && gmBd[i - 2] == g) ||
                   (y >= 2 && gmBd[i - GM_N] == g && gmBd[i - 2 * GM_N] == g);
        if (!bad) break;
        g = (uint8_t)((g + 1) % gmTypes);
      }
      gmBd[i] = g;
    }
    if (gmHasMove(NULL, NULL, NULL)) break;
  }
  memset(gmDrop, 0, sizeof(gmDrop));
}

// Editor start board: fixed gems must not already form a run; with no random cells a legal swap must
// exist (random cells are filled at play time, retrying until the board has a move).
static bool gemValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int nf = 0, nr = 0;
  for (int i = 0; i < GM_N * GM_N; i++) {
    uint8_t t = ((i / GM_N) < lvl->h && (i % GM_N) < lvl->w) ? lvl->cells[i / GM_N][i % GM_N] : 6;
    if (t < 6) { gmBd[i] = t; nf++; }
    else { gmBd[i] = 7; nr++; }
  }
  if (nf < 4) { snprintf(msg, msgLen, "Place some gems"); return false; }
  for (int i = 0; i < GM_N * GM_N; i++)
    if (gmRunAt(i % GM_N, i / GM_N)) { snprintf(msg, msgLen, "3 in a row at start"); return false; }
  if (nr == 0 && !gmHasMove(NULL, NULL, NULL)) { snprintf(msg, msgLen, "No legal swap"); return false; }
  return true;
}

// Builds the hand-made board in gmBd (fixed gems + seeded random fill). Leaves the random board
// from gmFill() untouched if the level is unusable.
static void gmLoadCustom(const LevelData *lvl) {
  uint8_t fx[GM_N * GM_N];
  int nf = 0;
  bool five = false;
  for (int i = 0; i < GM_N * GM_N; i++) {
    uint8_t t = ((i / GM_N) < lvl->h && (i % GM_N) < lvl->w) ? lvl->cells[i / GM_N][i % GM_N] : 6;
    fx[i] = t < 6 ? t : 7;
    if (t < 6) nf++;
    if (t == 5) five = true;
  }
  if (nf == 0) return;
  if (five && gmTypes < 6) gmTypes = 6;   // a Chill (5-gem) tier still shows a hand-placed 6th gem
  for (int attempt = 0; attempt < 40; attempt++) {
    for (int i = 0; i < GM_N * GM_N; i++) gmBd[i] = fx[i];
    for (int i = 0; i < GM_N * GM_N; i++) {
      if (fx[i] != 7) continue;
      int x = i % GM_N, y = i / GM_N;
      uint8_t g = (uint8_t)mazeRngRange(gmTypes);
      for (int t = 0; t < gmTypes; t++) {
        gmBd[i] = g;
        if (!gmRunAt(x, y)) break;
        g = (uint8_t)((g + 1) % gmTypes);
      }
      gmBd[i] = g;
    }
    bool clean = true;
    for (int i = 0; i < GM_N * GM_N && clean; i++) if (gmRunAt(i % GM_N, i / GM_N)) clean = false;
    if (clean && gmHasMove(NULL, NULL, NULL)) {
      memset(gmDrop, 0, sizeof(gmDrop));
      gmCustom = true;
      return;
    }
  }
  gmFill();   // could not make a playable board out of it: keep the normal random one
}

// After a clear: gems fall into the gaps, new ones enter from the top (seeded).
static void gmGravity() {
  memset(gmDrop, 0, sizeof(gmDrop));
  gmMaxDrop = 0;
  for (int x = 0; x < GM_N; x++) {
    int w = GM_N - 1;
    for (int y = GM_N - 1; y >= 0; y--) {
      int i = y * GM_N + x;
      if (gmBd[i] == 7) continue;
      if (w != y) {
        gmBd[w * GM_N + x] = gmBd[i];
        gmDrop[w * GM_N + x] = (uint8_t)(w - y);
        gmBd[i] = 7;
        if (w - y > gmMaxDrop) gmMaxDrop = w - y;
      }
      w--;
    }
    int k = w + 1;   // rows 0..w are now empty
    for (int y = w; y >= 0; y--) {
      gmBd[y * GM_N + x] = (uint8_t)mazeRngRange(gmTypes);
      gmDrop[y * GM_N + x] = (uint8_t)k;
    }
    if (k > gmMaxDrop) gmMaxDrop = k;
  }
}

static void enterGemPlaying() {
  s_mazeRng = gameSeed();
  int tier = g_variant & 3;
  if (s_lvlActiveSlot[LVLGAME_GEM] >= 0 || s_lvlTestPlay || s_lvlPack || g_challengeN) gmMode = 0;   // custom levels / Test Play / packs are always TIMER runs (target + record)
  gmTypes = kGmTypes[tier];
  gmTime = gmMode ? 0.0f : (float)kGmSecs[tier];
  gmLastSec = gmMode ? 0 : (int)kGmSecs[tier];
  gmMovesLeft = GM_MOVES;
  gmCol[0] = arcada.display->color565(230, 55, 55);
  gmCol[1] = arcada.display->color565(60, 200, 80);
  gmCol[2] = arcada.display->color565(60, 130, 245);
  gmCol[3] = arcada.display->color565(240, 220, 60);
  gmCol[4] = arcada.display->color565(180, 80, 230);
  gmCol[5] = arcada.display->color565(255, 140, 40);
  gmFill();
  gmCustom = false;
  gmWon = false;
  if (s_lvlActiveSlot[LVLGAME_GEM] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_GEM, s_lvlActiveSlot[LVLGAME_GEM], &lvl)) gmLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_GEM] = -1;
  }
  gmPhase = GP_IDLE;
  gmCx = 3;
  gmCy = 3;
  gmSel = 0xFF;
  gmHint = 0xFF;
  gmScore = 0;
  gmChain = 0;
  gmBestChain = 0;
  gmMoves = 0;
  gmPopV = 0;
  gmPopT0 = 0;
  gmRepT = 0;
  gmLastInput = millis();
  s_lastFrameMs = 0;
  gameState = ST_GEM_PLAYING;
}

// One gem shape of "radius" r centred on (cx,cy); col 0 = its own colour.
static void gmDrawGem(int cx, int cy, int g, int r, uint16_t col) {
  if (!col) col = gmCol[g % 6];
  switch (g) {
    case 0: canvas->fillCircle(cx, cy, r, col); break;
    case 1: canvas->fillRect(cx - r + 1, cy - r + 1, 2 * r - 1, 2 * r - 1, col); break;
    case 2:
      canvas->fillTriangle(cx, cy - r, cx - r, cy, cx + r, cy, col);
      canvas->fillTriangle(cx, cy + r, cx - r, cy, cx + r, cy, col);
      break;
    case 3: canvas->fillTriangle(cx, cy - r, cx - r, cy + r - 1, cx + r, cy + r - 1, col); break;
    case 4: canvas->fillRoundRect(cx - r, cy - r + 1, 2 * r + 1, 2 * r - 1, 3, col); break;
    default:
      canvas->fillRect(cx - 1, cy - r, 3, 2 * r + 1, col);
      canvas->fillRect(cx - r, cy - 1, 2 * r + 1, 3, col);
      canvas->fillCircle(cx, cy, r - 2, col);
      break;
  }
  if (r >= 4) canvas->drawPixel(cx - 2, cy - 2, COL_TEXT);
}

// Overlay for a special gem: bomb = ring + dark core, colour-clear = bright 8-point star.
static void gmDrawSpecial(int cx, int cy, uint8_t v) {
  uint16_t c = animBlend(COL_TEXT, COL_KEY, animPulse(500));
  if (v & GMF_BOMB) {
    canvas->drawCircle(cx, cy, 6, c);
    canvas->fillCircle(cx, cy, 2, COL_BG);
    canvas->drawPixel(cx, cy, c);
  } else if (v & GMF_STAR) {
    canvas->drawFastHLine(cx - 6, cy, 13, c);
    canvas->drawFastVLine(cx, cy - 6, 13, c);
    canvas->drawLine(cx - 4, cy - 4, cx + 4, cy + 4, c);
    canvas->drawLine(cx - 4, cy + 4, cx + 4, cy - 4, c);
  }
}

static void gmStartClear(unsigned long now) {
  gmPhase = GP_CLEAR;
  gmPhT0 = now;
  gmPhMs = 200;
  if (!gmMode && gmChain >= 2) {   // each cascade level after the first buys one second
    gmTime += 1.0f;
    float cap = (float)kGmSecs[g_variant & 3] + 20.0f;
    if (gmTime > cap) gmTime = cap;
  }
  sfx((uint16_t)(440 + (gmChain > 6 ? 6 : gmChain) * 110), 55);
}

static bool gmOutOfTime() { return gmMode ? gmMovesLeft <= 0 : gmTime <= 0.0f; }

static void gmAfterSettle(unsigned long now) {
  gmChain = 0;
  gmHint = 0xFF;
  if (gmCustom && !gmMode && gmScore >= (int)kGmTarget[g_variant & 3]) {   // target reached: the level is cleared
    gmWon = true;
    gmPhase = GP_END;
    gmPhT0 = now;
    gmPhMs = 1000;
    gmSel = 0xFF;
    sfxWin();
  } else if (gmOutOfTime()) {
    gmPhase = GP_END;
    gmPhT0 = now;
    gmPhMs = 1000;
    gmSel = 0xFF;
    sfxDeath();
  } else if (!gmHasMove(NULL, NULL, NULL)) {
    gmFill();
    gmPhase = GP_SHUF;
    gmPhT0 = now;
    gmPhMs = 900;
    sfx(330, 120);
  } else {
    gmPhase = GP_IDLE;
    gmLastInput = now;
  }
}

static void gmTrySwap(int a, int b, unsigned long now) {
  uint8_t t = gmBd[a];
  gmBd[a] = gmBd[b];
  gmBd[b] = t;
  gmSA = (uint8_t)a;
  gmSB = (uint8_t)b;
  gmSel = 0xFF;
  gmHint = 0xFF;
  gmMoves++;
  if (gmMode) gmMovesLeft--;
  gmPhase = GP_SWAP;
  gmPhT0 = now;
  gmPhMs = 130;
  sfx(520, 20);
}

static void gmFinishClear(unsigned long now) {
  int n = 0, sx = 0, sy = 0, sp = 0;
  for (int i = 0; i < GM_N * GM_N; i++) {
    if (!(gmBd[i] & 0x40)) continue;
    int x = i % GM_N, y = i / GM_N;
    if (gmBd[i] & (GMF_BOMB | GMF_STAR)) {
      sp++;
      explosionBurst(GM_OX + x * GM_CS + 7, GM_OY + y * GM_CS + 7, (gmBd[i] & GMF_STAR) ? 22 : 14, 0);
    } else {
      particlesBurst(GM_OX + x * GM_CS + 7, GM_OY + y * GM_CS + 7, 2, gmCol[(gmBd[i] & 7) % 6]);
    }
    sx += x;
    sy += y;
    n++;
    gmBd[i] = 7;
  }
  int pts = n * 10 * gmChain;
  if (gmLongest >= 4) pts += 40 * (gmLongest - 3) * gmChain;
  if (sp) { pts += 50 * sp * gmChain; screenShake(180, 2); }
  gmScore += pts;
  if (gmChain > gmBestChain) gmBestChain = gmChain;
  gmPopV = pts;
  gmPopX = GM_OX + (n ? sx / n : 3) * GM_CS;
  if (gmPopX > 88) gmPopX = 88;
  gmPopY = GM_OY + (n ? sy / n : 3) * GM_CS;
  gmPopT0 = now;
  gmGravity();
  gmPhase = GP_FALL;
  gmPhT0 = now;
  gmPhMs = 120UL + 25UL * (unsigned long)gmMaxDrop;
}

static void drawGem(unsigned long now) {
  canvas->fillScreen(COL_BG);
  uint16_t bgA = arcada.display->color565(16, 18, 38), bgB = arcada.display->color565(26, 28, 54);
  canvas->drawRect(GM_OX - 1, GM_OY - 1, GM_N * GM_CS + 2, GM_N * GM_CS + 2, COL_WALL);
  for (int i = 0; i < GM_N * GM_N; i++) {
    int x = i % GM_N, y = i / GM_N;
    canvas->fillRect(GM_OX + x * GM_CS, GM_OY + y * GM_CS, GM_CS, GM_CS, ((x + y) & 1) ? bgA : bgB);
  }
  float tp = gmPhMs ? (float)(now - gmPhT0) / (float)gmPhMs : 1.0f;
  if (tp > 1.0f) tp = 1.0f;
  for (int i = 0; i < GM_N * GM_N; i++) {
    uint8_t g = gmBd[i] & 7;
    if (g > 5) continue;
    int x = i % GM_N, y = i / GM_N;
    float px = (float)(GM_OX + x * GM_CS + 7), py = (float)(GM_OY + y * GM_CS + 7);
    if ((gmPhase == GP_SWAP || gmPhase == GP_BACK) && (i == gmSA || i == gmSB)) {
      int o = (i == gmSA) ? gmSB : gmSA;
      float k = 1.0f - animEase(tp);
      px += (float)((o % GM_N) - x) * GM_CS * k;
      py += (float)((o / GM_N) - y) * GM_CS * k;
    } else if (gmPhase == GP_FALL && gmDrop[i]) {
      py -= (float)gmDrop[i] * GM_CS * (1.0f - animBounce(tp));
    }
    int r = 5;
    uint16_t col = 0;
    if (gmBd[i] & 0x40) {
      if (((now - gmPhT0) / 45) & 1) col = COL_TEXT;
      if (tp > 0.6f) r = 5 - (int)((tp - 0.6f) * 10.0f);
      if (r < 1) r = 1;
    } else if (i == (int)gmSel) {
      r = 6;
    }
    gmDrawGem((int)(px + 0.5f), (int)(py + 0.5f), g, r, col);
    if ((gmBd[i] & (GMF_BOMB | GMF_STAR)) && !(gmBd[i] & 0x40)) gmDrawSpecial((int)(px + 0.5f), (int)(py + 0.5f), gmBd[i]);
  }
  // hint after a while without input (not on Extreme)
  if (gmPhase == GP_IDLE && (g_variant & 3) != 3 && now - gmLastInput > 7000UL) {
    if (gmHint == 0xFF) {
      int hx, hy, hd;
      if (gmFindSpecial(&hx, &hy, &hd)) { gmHint = (uint8_t)(hy * GM_N + hx + (hd ? 64 : 0)); gmHintSp = true; }
      else if (gmHasMove(&hx, &hy, &hd)) { gmHint = (uint8_t)(hy * GM_N + hx + (hd ? 64 : 0)); gmHintSp = false; }
    }
    if (gmHint != 0xFF && animPulse(700) > 120) {
      int a = gmHint & 63, x = a % GM_N, y = a / GM_N;
      int bx = x + ((gmHint & 64) ? 0 : 1), by = y + ((gmHint & 64) ? 1 : 0);
      canvas->drawRect(GM_OX + x * GM_CS, GM_OY + y * GM_CS, GM_CS, GM_CS, COL_GOAL);
      canvas->drawRect(GM_OX + bx * GM_CS, GM_OY + by * GM_CS, GM_CS, GM_CS, COL_GOAL);
      if (gmHintSp) {   // special-gem hint: a soft glow around both cells
        for (int k = 1; k <= 3; k++) {
          uint16_t gc = animBlend(COL_BG, COL_ORANGE, (uint8_t)(220 - k * 60));
          canvas->drawRect(GM_OX + x * GM_CS - k, GM_OY + y * GM_CS - k, GM_CS + 2 * k, GM_CS + 2 * k, gc);
          canvas->drawRect(GM_OX + bx * GM_CS - k, GM_OY + by * GM_CS - k, GM_CS + 2 * k, GM_CS + 2 * k, gc);
        }
      }
    }
  }
  // cursor / selection
  {
    int cx = GM_OX + gmCx * GM_CS, cy = GM_OY + gmCy * GM_CS;
    if (gmSel != 0xFF) {
      canvas->drawRect(cx, cy, GM_CS, GM_CS, COL_TEXT);
      canvas->drawRect(cx + 1, cy + 1, GM_CS - 2, GM_CS - 2, COL_TEXT);
    } else {
      canvas->drawRect(cx, cy, GM_CS, GM_CS, COL_KEY);
    }
  }
  // header (also hides gems still falling in from above the board)
  canvas->fillRect(0, 0, 160, GM_OY, COL_BG);
  canvas->drawFastHLine(GM_OX - 1, GM_OY - 1, GM_N * GM_CS + 2, COL_WALL);
  canvas->setTextSize(1);
  ptc(COL_BLUE, 4, 3, "GEM SWAP");
  char t[16];
  ptc(COL_TEXT, 122, 14, "SCORE");
  ptc(COL_KEY, 122, 24, gmScore);
  int32_t bs = saveBest(49, saveTierOf(g_variant));
  ptc(COL_TEXT, 122, 40, gmMode ? "MODE" : gmCustom ? "GOAL" : "BEST");
  canvas->setCursor(122, 50);
  if (gmMode) canvas->print("MOVES");
  else if (gmCustom) canvas->print((int)kGmTarget[g_variant & 3]);
  else if (bs == SAVE_NO_SCORE) canvas->print("--");
  else canvas->print((int)bs);
  pt(122, 66, gmMode ? "LEFT" : "TIME");
  canvas->setTextSize(2);
  int secs = gmMode ? gmMovesLeft : (int)(gmTime + 0.99f);
  canvas->setTextColor((gmMode ? secs <= 3 : secs <= 10) ? COL_LASER : COL_GOAL);
  snprintf(t, sizeof(t), "%d", secs);
  pt(122, 76, t);
  if (gmChain >= 2) {
    canvas->setTextSize(1);
    ptc(COL_TEXT, 122, 98, "COMBO");
    canvas->setTextSize(2);
    canvas->setTextColor(COL_ORANGE);
    snprintf(t, sizeof(t), "x%d", gmChain);
    pt(122, 108, t);
  }
  canvas->setTextSize(1);
  if (gmPopT0 && now - gmPopT0 < 800UL) {
    canvas->setTextColor(COL_TEXT);
    snprintf(t, sizeof(t), "+%d", gmPopV);
    pt(gmPopX, gmPopY - (int)((now - gmPopT0) / 40), t);
  }
  if (gmPhase == GP_END || gmPhase == GP_SHUF) {
    canvas->fillRect(8, 48, 104, 30, COL_BG);
    canvas->drawRect(8, 48, 104, 30, COL_ORANGE);
    canvas->setTextColor(COL_ORANGE);
    if (gmPhase == GP_END) {
      canvas->setTextSize(2);
      pt(gmWon ? 16 : 12, 56, gmWon ? "CLEARED!" : gmMode ? "NO MOVES!" : "TIME UP!");
      canvas->setTextSize(1);
    } else {
      pt(14, 52, "NO MOVES LEFT");
      pt(28, 64, "SHUFFLING");
    }
  }
  particlesUpdateDraw();
}

static void gmToOver() {
  long sc = gmScore;
  if (gmMode) {
    s_lastNewBest = false;   // MOVES mode has its own scale: no best, no level record
  } else if (gmCustom) {
    s_lastNewBest = false;
    lvlRecordRun(LVLGAME_GEM, sc, true);
    if (gmWon) lvlOnClear(LVLGAME_GEM);
  } else {
    recordResult(49, g_variant, sc, true);
  }
  if (g_twoPlayerMode) { twoPHandleGameEnd(sc); return; }
  gameState = ST_GEM_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%ld", sc);
  if (gmMode) snprintf(sub, sizeof(sub), "MOVES mode: combo x%d", gmBestChain);   // MOVES scores are not recorded
  else snprintf(sub, sizeof(sub), "best combo x%d, %d swaps", gmBestChain, gmMoves);
  drawStdOver(gmWon ? "LEVEL CLEARED" : gmMode ? "OUT OF MOVES" : "TIME UP", COL_GOAL, big, sub, 49);
}

static void gemFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;
  if (gmPhase != GP_END && !gmMode) {
    gmTime -= dt;
    if (gmTime < 0.0f) gmTime = 0.0f;
    int sec = (int)(gmTime + 0.99f);
    if (sec != gmLastSec) {
      gmLastSec = sec;
      if (sec > 0 && sec <= 5) sfx(1000, 15);
    }
  }
  if (buttons) gmLastInput = now;
  // phase machine
  unsigned long el = now - gmPhT0;
  switch (gmPhase) {
    case GP_SWAP:
      if (el >= gmPhMs) {
        if (gmMark(true) > 0) {
          gmChain = 1;
          gmStartClear(now);
        } else {
          uint8_t t = gmBd[gmSA];
          gmBd[gmSA] = gmBd[gmSB];
          gmBd[gmSB] = t;
          gmMoves--;
          if (gmMode) gmMovesLeft++;
          gmPhase = GP_BACK;
          gmPhT0 = now;
          sfxBlocked();
        }
      }
      break;
    case GP_BACK:
      if (el >= gmPhMs) gmAfterSettle(now);
      break;
    case GP_CLEAR:
      if (el >= gmPhMs) gmFinishClear(now);
      break;
    case GP_FALL:
      if (el >= gmPhMs) {
        sfx(200, 15);
        if (gmMark(false) > 0) {
          gmChain++;
          gmStartClear(now);
        } else {
          gmAfterSettle(now);
        }
      }
      break;
    case GP_SHUF:
      if (el >= gmPhMs) gmAfterSettle(now);
      break;
    case GP_END:
      if (el >= gmPhMs) { gmToOver(); return; }
      break;
    default:
      if (gmOutOfTime()) gmAfterSettle(now);
      break;
  }
  // input
  if (gmPhase != GP_END) {
    int dx = 0, dy = 0;
    bool edge = true;
    if (pressed & ARCADA_BUTTONMASK_LEFT) dx = -1;
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) dx = 1;
    else if (pressed & ARCADA_BUTTONMASK_UP) dy = -1;
    else if (pressed & ARCADA_BUTTONMASK_DOWN) dy = 1;
    else edge = false;
    if (edge) {
      gmRepT = now + 220UL;
    } else if (gmSel == 0xFF && (long)(now - gmRepT) >= 0) {   // held D-pad: cursor auto-repeat
      if (buttons & ARCADA_BUTTONMASK_LEFT) dx = -1;
      else if (buttons & ARCADA_BUTTONMASK_RIGHT) dx = 1;
      else if (buttons & ARCADA_BUTTONMASK_UP) dy = -1;
      else if (buttons & ARCADA_BUTTONMASK_DOWN) dy = 1;
      if (dx || dy) gmRepT = now + 90UL;
    }
    if (dx || dy) {
      if (gmSel != 0xFF) {
        if (edge && gmPhase == GP_IDLE) {
          int nx = (int)gmCx + dx, ny = (int)gmCy + dy;
          if (nx >= 0 && nx < GM_N && ny >= 0 && ny < GM_N) gmTrySwap(gmSel, ny * GM_N + nx, now);
          else sfxBlocked();
        }
      } else {
        int nx = (int)gmCx + dx, ny = (int)gmCy + dy;
        if (nx >= 0 && nx < GM_N && ny >= 0 && ny < GM_N) {
          gmCx = (uint8_t)nx;
          gmCy = (uint8_t)ny;
          sfxMove();
        }
      }
    }
    if (gmPhase == GP_IDLE && (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B))) {
      if (gmSel != 0xFF) {
        gmSel = 0xFF;
        sfx(300, 15);
      } else if (pressed & ARCADA_BUTTONMASK_A) {
        gmSel = (uint8_t)(gmCy * GM_N + gmCx);
        sfx(760, 25);
      }
    }
  }
  drawGem(now);
  blitScreen();
}

// --- Road Racer ------------------------------------------------------------------
//
// Portrait (128x160) endless top-down racer. Left/Right change lane (4 lanes; the car glides
// with easing), Up/A = gas, Down/B = brake, otherwise the car cruises. The traffic pace
// grows with the distance driven. Traffic rows spawn at the top at a fixed on-screen spacing
// and always leave one lane free (the free lane drifts by at most one lane per row, so a
// path exists in the layout; at the top paces it still takes quick, well-timed lane changes
// to use it); rows come from the round seed (2P player 2 drives the same road).
// A shield token now and then makes you crash-proof for 8 s (cars you hit are smashed).
// One crash = game over. Score = distance in metres. Tiers = pace ramp and traffic density.

#define RC_NC 14
#define RC_PY 128
static const uint16_t kRcV0[4] = {110, 150, 90, 170};     // starting pace, px/s
static const uint16_t kRcCap[4] = {230, 280, 175, 310};   // top pace
static const uint8_t kRcRamp[4] = {37, 45, 25, 55};       // pace gain per 100 m, x0.1
static const uint8_t kRcGap[4] = {64, 60, 78, 60};        // px between traffic rows (EXTREME shrinks to 56 at the cap, others by 14)
static const uint8_t kRcDbl[4] = {20, 28, 8, 38};         // % chance of a second car per row
static const uint16_t kRcShieldM[4] = {500, 600, 400, 750};   // metres between shield tokens
static const char* const kRcModes[4] = {"NORMAL TRAFFIC", "FAST RAMP", "CHILL LIGHT TRAFFIC", "EXTREME RUSH"};

static float rcCy[RC_NC];
static uint8_t rcCl[RC_NC], rcCt[RC_NC];     // lane (0xFF = free), body colour (+0x80 once passed)
static uint16_t rcCol[4], rcGrass, rcRoad, rcTree, rcTree2, rcWin, rcLine, rcShieldCol;
static float rcX, rcSpd, rcDist, rcScroll, rcAcc, rcShield, rcPuY;
static uint8_t rcLane, rcPuL, rcSafe, rcTier;
static int rcPassed, rcMilestone, rcNextShield;
static bool rcDead, rcEnded;
static unsigned long rcDeadAt, rcBanT;
static uint8_t rcTheme;                      // 0 day, 1 dusk, 2 night, 3 rain (changes every 1000 m)
static uint16_t rcCone, rcRain, rcPud;
// Rain extras (cosmetic + a small nudge, all derived from the round seed / row counter / distance only):
// lightning (flash, bolt, delayed thunder with a shake) and puddles that push the car sideways for 0.4 s.
#define RC_NP 4
static float rcPy[RC_NP];
static uint8_t rcPl[RC_NP];                  // puddle lane (0xFF = free slot)
static int8_t rcPd[RC_NP];                   // slip direction
static float rcSlideT;
static int8_t rcSlideDir;
static int rcLastSeg, rcRowN;
static uint32_t rcSeedH;
static unsigned long rcFlashT, rcThunderAt;
static uint8_t rcBoltX;
static uint32_t rcHash(uint32_t x) {
  x ^= x << 13;
  x ^= x >> 17;
  x ^= x << 5;
  x *= 2654435761u;
  return x ^ (x >> 15);
}
static const uint8_t kRcThF[4][3] = {{255, 255, 255}, {255, 190, 150}, {70, 90, 150}, {110, 130, 150}};  // RGB multipliers
static const char* const kRcThNames[4] = {"DAY", "DUSK", "NIGHT", "RAIN"};
// Oncoming traffic (EXTREME and SPEED tiers only): the left lane pair (0,1) is the opposite
// carriageway. Its cars (rcCt bit 0x40) come down RC_ONC_M times faster than the rest. Each
// pair keeps its own free lane in every row (right pair: one car in lanes 2/3; left pair: at most
// one car in lanes 0/1, one row spacing apart), so staying in your own pair stays possible.
#define RC_ONC_M 1.8f
static bool rcOncTier() { return rcTier == 1 || rcTier == 3; }

static void enterRacerTitle() {
  gameState = ST_RACER_TITLE;
  drawStdTitleEx("ROAD RACER", COL_BOOST, "Left/Right: change lane", "A/Up gas  B/Down brake", "Turn device to play", 50,
                 kRcModes[g_variant & 3]);
}

static float rcPace() {
  float p = (float)kRcV0[rcTier] + (float)kRcRamp[rcTier] * rcDist / 1000.0f;
  return p > (float)kRcCap[rcTier] ? (float)kRcCap[rcTier] : p;
}
static float rcLaneX(int l) { return 34.0f + 20.0f * (float)l; }

static uint16_t rcTint(int r, int g, int b, const uint8_t* f) {
  return arcada.display->color565((uint8_t)((r * f[0]) >> 8), (uint8_t)((g * f[1]) >> 8), (uint8_t)((b * f[2]) >> 8));
}
static void rcApplyTheme(uint8_t th) {
  const uint8_t* f = kRcThF[th & 3];
  rcCol[0] = rcTint(220, 50, 50, f);
  rcCol[1] = rcTint(60, 110, 230, f);
  rcCol[2] = rcTint(60, 190, 100, f);
  rcCol[3] = rcTint(180, 90, 220, f);
  rcGrass = rcTint(22, 80, 34, f);
  rcRoad = rcTint(52, 54, 62, f);
  rcTree = rcTint(14, 56, 24, f);
  rcTree2 = rcTint(30, 110, 46, f);
  rcWin = rcTint(30, 44, 80, f);
  rcLine = rcTint(210, 210, 190, f);
  rcCone = arcada.display->color565(80, 82, 66);
  rcRain = arcada.display->color565(150, 172, 205);
  rcPud = rcTint(70, 100, 150, f);
}

static void enterRacerPlaying() {
  if (portraitGate(enterRacerPlaying, enterRacerTitle)) return;
  s_mazeRng = gameSeed();
  rcSeedH = s_mazeRng;
  rcTier = (uint8_t)(g_variant & 3);
  for (int i = 0; i < RC_NP; i++) rcPl[i] = 0xFF;
  rcSlideT = 0.0f;
  rcLastSeg = -1;
  rcRowN = 0;
  rcFlashT = 0;
  rcThunderAt = 0;
  rcTheme = 0;
  rcBanT = 0;
  rcApplyTheme(0);
  rcShieldCol = arcada.display->color565(80, 220, 255);
  for (int i = 0; i < RC_NC; i++) rcCl[i] = 0xFF;
  rcPuL = 0xFF;
  rcLane = (uint8_t)(1 + mazeRngRange(2));
  rcX = rcLaneX(rcLane);
  rcSafe = rcLane;
  rcSpd = 0.85f * (float)kRcV0[rcTier];
  rcDist = 0.0f;
  rcScroll = 0.0f;
  rcAcc = 0.0f;
  rcShield = 0.0f;
  rcPassed = 0;
  rcMilestone = 0;
  rcNextShield = (int)kRcShieldM[rcTier] / 2;
  rcDead = false;
  rcEnded = false;
  s_lastFrameMs = 0;
  gameState = ST_RACER_PLAYING;
}

// One row of traffic at the top of the road; rcSafe is the lane that stays empty.
static void rcPlaceCar(int lane, uint8_t flags, float y) {
  uint8_t col = (uint8_t)mazeRngRange(4);
  for (int i = 0; i < RC_NC; i++) {
    if (rcCl[i] != 0xFF) continue;
    rcCl[i] = (uint8_t)lane;
    rcCt[i] = (uint8_t)(col | flags);
    rcCy[i] = y;
    break;
  }
}
static void rcSpawnRow() {
  if (rcOncTier()) {
    int s = 2 + mazeRngRange(2);            // free lane of the right pair; a car takes the other one
    rcSafe = (uint8_t)s;
    rcPlaceCar(s == 2 ? 3 : 2, 0, -20.0f);
    if (mazeRngRange(100) < 60) rcPlaceCar(mazeRngRange(2), 0x40, -34.0f);   // oncoming, other pair lane stays free
    if (rcPuL == 0xFF && (int)rcDist >= rcNextShield) {
      rcPuL = rcSafe;
      rcPuY = -20.0f;
      rcNextShield += (int)kRcShieldM[rcTier];
    }
    return;
  }
  int s = (int)rcSafe + mazeRngRange(3) - 1;
  if (s < 0) s = 0;
  if (s > 3) s = 3;
  rcSafe = (uint8_t)s;
  int n = 1;
  if (mazeRngRange(100) < kRcDbl[rcTier]) n++;
  if (rcTier == 3 && mazeRngRange(100) < 14) n++;
  int cand[3], nc = 0;
  for (int l = 0; l < 4; l++) if (l != s) cand[nc++] = l;
  for (int k = 0; k < n && nc > 0; k++) {
    int pick = mazeRngRange(nc);
    int lane = cand[pick];
    cand[pick] = cand[--nc];
    uint8_t col = (uint8_t)mazeRngRange(4);
    for (int i = 0; i < RC_NC; i++) {
      if (rcCl[i] != 0xFF) continue;
      rcCl[i] = (uint8_t)lane;
      rcCt[i] = col;
      rcCy[i] = -20.0f;
      break;
    }
  }
  if (rcPuL == 0xFF && (int)rcDist >= rcNextShield) {
    rcPuL = rcSafe;
    rcPuY = -20.0f;
    rcNextShield += (int)kRcShieldM[rcTier];
  }
}

static void rcDrawCar(int cx, int cy, uint16_t body, bool player, bool onc) {
  canvas->fillRect(cx - 5, cy - 8, 10, 16, body);
  if (player) canvas->fillRect(cx - 1, cy - 8, 2, 16, COL_TEXT);
  canvas->fillRect(cx - 4, cy - 5, 8, 4, rcWin);
  canvas->fillRect(cx - 4, cy + 2, 8, 3, rcWin);
  canvas->fillRect(cx - 6, cy - 7, 2, 4, COL_BG);
  canvas->fillRect(cx + 4, cy - 7, 2, 4, COL_BG);
  canvas->fillRect(cx - 6, cy + 3, 2, 4, COL_BG);
  canvas->fillRect(cx + 4, cy + 3, 2, 4, COL_BG);
  if (onc) {   // facing the player: headlights at the bottom
    canvas->fillRect(cx - 4, cy + 7, 3, 2, COL_KEY);
    canvas->fillRect(cx + 2, cy + 7, 3, 2, COL_KEY);
  } else {
    canvas->drawPixel(cx - 4, cy - 8, COL_KEY);
    canvas->drawPixel(cx + 3, cy - 8, COL_KEY);
  }
}

static void drawRacer(unsigned long now) {
  canvas->fillScreen(rcGrass);
  // roadside parallax: a slow far layer of field stripes and a fast layer of trees
  int o1 = (int)(rcScroll * 0.5f) % 48;
  for (int y = o1 - 48; y < 160; y += 48) {
    canvas->fillRect(3, y, 3, 22, rcTree);
    canvas->fillRect(121, y + 24, 3, 22, rcTree);
  }
  int o2 = (int)rcScroll % 40;
  for (int y = o2 - 40; y < 170; y += 40) {
    canvas->fillCircle(13, y, 6, rcTree);
    canvas->fillCircle(12, y - 1, 3, rcTree2);
    canvas->fillCircle(115, y + 20, 6, rcTree);
    canvas->fillCircle(114, y + 19, 3, rcTree2);
  }
  canvas->fillRect(24, 0, 80, 160, rcRoad);
  canvas->fillRect(24, 0, 2, 160, rcLine);
  canvas->fillRect(102, 0, 2, 160, rcLine);
  int o3 = (int)rcScroll % 22;
  for (int k = 1; k < 4; k++)
    for (int y = o3 - 22; y < 160; y += 22) canvas->fillRect(24 + k * 20 - 1, y, 2, 11, rcLine);
  for (int i = 0; i < RC_NP; i++) {   // rain puddles
    if (rcPl[i] == 0xFF) continue;
    int px = (int)rcLaneX(rcPl[i]), py = (int)rcPy[i];
    canvas->fillRect(px - 7, py - 2, 15, 5, rcPud);
    canvas->fillRect(px - 5, py - 4, 11, 9, rcPud);
    canvas->drawFastHLine(px - 3, py - 1, 5, rcRain);
  }
  if (rcPuL != 0xFF) {
    int px = (int)rcLaneX(rcPuL), py = (int)rcPuY;
    canvas->fillCircle(px, py, 7, rcShieldCol);
    canvas->drawCircle(px, py, 7, COL_TEXT);
    canvas->setTextSize(1);
    ptc(COL_BG, px - 2, py - 3, "S");
  }
  if (rcOncTier()) {   // double yellow centre line between the two carriageways
    canvas->fillRect(62, 0, 1, 160, COL_KEY);
    canvas->fillRect(65, 0, 1, 160, COL_KEY);
  }
  if (rcTheme == 2) {   // night: headlight cones in front of every car
    for (int i = 0; i < RC_NC; i++) {
      if (rcCl[i] == 0xFF) continue;
      int cx = (int)rcLaneX(rcCl[i]), cy = (int)rcCy[i];
      int dir = (rcCt[i] & 0x40) ? 1 : -1, y0 = cy + dir * 9, y1 = cy + dir * 46;
      canvas->fillTriangle(cx - 3, y0, cx + 3, y0, cx - 9, y1, rcCone);
      canvas->fillTriangle(cx + 3, y0, cx + 9, y1, cx - 9, y1, rcCone);
    }
    if (!rcDead) {
      int cx = (int)(rcX + 0.5f);
      canvas->fillTriangle(cx - 3, RC_PY - 9, cx + 3, RC_PY - 9, cx - 10, RC_PY - 56, rcCone);
      canvas->fillTriangle(cx + 3, RC_PY - 9, cx + 10, RC_PY - 56, cx - 10, RC_PY - 56, rcCone);
    }
  }
  for (int i = 0; i < RC_NC; i++)
    if (rcCl[i] != 0xFF) rcDrawCar((int)rcLaneX(rcCl[i]), (int)rcCy[i], rcCol[rcCt[i] & 3], false, (rcCt[i] & 0x40) != 0);
  rcDrawCar((int)(rcX + 0.5f), RC_PY, rcDead ? COL_LASER : COL_PLAYER, true, false);
  if (rcTheme == 3) {   // rain streaks
    uint32_t tk = now / 5u;
    for (int i = 0; i < 18; i++) {
      int rx = (i * 53 + (i * i) * 7) % 124 + 2;
      int ry = (int)((tk * 4u + (uint32_t)i * 37u) % 180u) - 14;
      canvas->drawLine(rx, ry, rx - 1, ry + 6, rcRain);
    }
  }
  if (rcFlashT && now - rcFlashT < 160UL) {   // lightning: a bolt and a whitened frame (every 2nd line, then every 4th)
    int bx = rcBoltX;
    canvas->drawLine(bx, 0, bx - 6, 30, COL_TEXT);
    canvas->drawLine(bx - 6, 30, bx + 4, 56, COL_TEXT);
    canvas->drawLine(bx + 4, 56, bx - 3, 84, COL_TEXT);
    int stepY = (now - rcFlashT < 70UL) ? 2 : 4;
    for (int y = 0; y < 160; y += stepY) canvas->drawFastHLine(0, y, 128, COL_TEXT);
  }
  if (rcShield > 0.0f && !rcDead && (rcShield > 2.0f || ((int)(rcShield * 8.0f) & 1))) {
    canvas->drawCircle((int)(rcX + 0.5f), RC_PY, 13, rcShieldCol);
    canvas->drawCircle((int)(rcX + 0.5f), RC_PY, 14, rcShieldCol);
  }
  // HUD
  canvas->fillRect(0, 0, 128, 19, COL_BG);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  char t[24];
  snprintf(t, sizeof(t), "%dm", (int)rcDist);
  pt(2, 2, t);
  snprintf(t, sizeof(t), "%dkm/h", (int)(rcSpd * 0.6f));
  pt(126 - (int)strlen(t) * 6, 2, t);
  int32_t bs = saveBest(50, saveTierOf(g_variant));
  canvas->setTextColor(COL_KEY);
  canvas->setCursor(2, 10);
  if (bs == SAVE_NO_SCORE) canvas->print("BEST --");
  else {
    snprintf(t, sizeof(t), "BEST %dm", (int)bs);
    canvas->print(t);
  }
  if (rcShield > 0.0f) {
    ptc(rcShieldCol, 2, 150, "SHIELD");
    canvas->fillRect(44, 151, (int)(rcShield * 10.0f), 5, rcShieldCol);
  }
  if (rcDead) {
    canvas->fillRect(18, 66, 92, 24, COL_BG);
    canvas->drawRect(18, 66, 92, 24, COL_LASER);
    canvas->setTextSize(2);
    ptc(COL_LASER, 28, 71, "CRASH!");
    canvas->setTextSize(1);
  }
  if (rcBanT && now - rcBanT < 1600UL && !rcDead) {   // theme banner
    int w = (int)strlen(kRcThNames[rcTheme]) * 6 + 12;
    canvas->fillRect((128 - w) / 2, 24, w, 13, COL_BG);
    canvas->drawRect((128 - w) / 2, 24, w, 13, COL_ORANGE);
    ptc(COL_ORANGE, (128 - w) / 2 + 6, 27, kRcThNames[rcTheme]);
  }
  particlesUpdateDraw();
}

static void rcToOver() {
  rcEnded = true;
  long m = (long)rcDist;
  recordResult(50, g_variant, m, true);
  if (g_twoPlayerMode) { twoPHandleGameEnd(m); return; }
  gameState = ST_RACER_OVER;
  char big[12], sub[24];
  snprintf(big, sizeof(big), "%ld", m);
  snprintf(sub, sizeof(sub), "%d cars passed", rcPassed);
  drawStdOver("CRASHED", COL_LASER, big, sub, 50);
}

static void racerFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;
  if (rcEnded) return;
  if (rcDead) {
    if (now - rcDeadAt >= 900UL) { rcToOver(); return; }
    drawRacer(now);
    blitScreen();
    return;
  }
  float P = rcPace();
  // steering
  if ((pressed & ARCADA_BUTTONMASK_LEFT) && rcLane > 0) { rcLane--; sfx(300, 8); }
  if ((pressed & ARCADA_BUTTONMASK_RIGHT) && rcLane < 3) { rcLane++; sfx(300, 8); }
  float k = dt * (rcTheme == 3 ? 9.0f : 13.0f);   // rain: a little less grip
  if (k > 1.0f) k = 1.0f;
  rcX += (rcLaneX(rcLane) - rcX) * k;
  if (rcSlideT > 0.0f) {   // puddle slip: at most ~8 px of drift, well inside the 20 px lane spacing
    rcX += (float)rcSlideDir * 70.0f * dt;
    rcSlideT -= dt;
  }
  // speed
  float target = 0.85f * P;
  if (buttons & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_A)) target = P;
  else if (buttons & (ARCADA_BUTTONMASK_DOWN | ARCADA_BUTTONMASK_B)) target = 0.5f * P;
  float dv = target - rcSpd, lim = (target > rcSpd ? 150.0f : 260.0f) * dt;
  if (dv > lim) dv = lim;
  if (dv < -lim) dv = -lim;
  rcSpd += dv;
  rcDist += rcSpd * dt / 6.0f;
  rcScroll += rcSpd * dt;
  {
    uint8_t th = (uint8_t)(((int)(rcDist / 1000.0f)) & 3);
    if (th != rcTheme) {
      rcTheme = th;
      rcApplyTheme(th);
      rcBanT = now;
      sfx(th == 2 ? 520 : 900, 60);
    }
    if (rcTheme == 3) {   // lightning: a seeded roll per 20 m
      int seg = (int)(rcDist / 20.0f);
      if (seg != rcLastSeg) {
        rcLastSeg = seg;
        uint32_t h = rcHash((uint32_t)seg ^ rcSeedH);
        if (h % 10u == 0u && (rcFlashT == 0 || now - rcFlashT > 2500UL)) {
          rcFlashT = now ? now : 1UL;
          rcThunderAt = now + 350UL + (h >> 8) % 500UL;
          rcBoltX = (uint8_t)(14 + (h >> 16) % 100u);
          pixelsFlashAsync(220, 230, 255, 70);
          sfx(1500, 25);
        }
      }
    }
    if (rcThunderAt && now >= rcThunderAt) {
      rcThunderAt = 0;
      sfx(90, 260);
      screenShake(260, 3);
    }
  }
  float rel = rcSpd - 0.35f * P;   // how fast the traffic comes down the screen
  if (rel < 5.0f) rel = 5.0f;
  // traffic
  rcAcc += rel * dt;
  float span = (float)kRcCap[rcTier] - (float)kRcV0[rcTier];
  float gap = (float)kRcGap[rcTier] - (rcTier == 3 ? 4.0f : 14.0f) * (P - (float)kRcV0[rcTier]) / span;   // EXTREME keeps >= 56 px so a lane change always fits
  if (rcAcc >= gap) {
    rcAcc -= gap;
    if (rcAcc > gap) rcAcc = 0.0f;
    rcSpawnRow();
    rcRowN++;
    if (rcTheme == 3) {   // a puddle between this row and the next (pool of RC_NP; 30% of rows)
      uint32_t h = rcHash((uint32_t)rcRowN * 7919u ^ rcSeedH);
      if (h % 100u < 30u) {
        for (int i = 0; i < RC_NP; i++) {
          if (rcPl[i] != 0xFF) continue;
          rcPl[i] = (uint8_t)((h >> 8) & 3u);
          rcPd[i] = (h >> 12) & 1u ? 1 : -1;
          rcPy[i] = -46.0f;
          break;
        }
      }
    }
  }
  for (int i = 0; i < RC_NP; i++) {   // puddles drift down with the traffic; driving over one starts the slip
    if (rcPl[i] == 0xFF) continue;
    rcPy[i] += rel * dt;
    if (rcPy[i] > 175.0f) { rcPl[i] = 0xFF; continue; }
    if (!rcDead && rcSlideT <= 0.0f && fabsf(rcLaneX(rcPl[i]) - rcX) < 9.0f && fabsf(rcPy[i] - (float)RC_PY) < 10.0f) {
      rcSlideT = 0.4f;
      rcSlideDir = rcPd[i];
      rcPl[i] = 0xFF;
      particlesBurst((int)rcX, RC_PY + 8, 8, rcRain);
      sfx(260, 50);
    }
  }
  for (int i = 0; i < RC_NC && !rcDead; i++) {
    if (rcCl[i] == 0xFF) continue;
    rcCy[i] += rel * dt * ((rcCt[i] & 0x40) ? RC_ONC_M : 1.0f);
    if (rcCy[i] > 175.0f) { rcCl[i] = 0xFF; continue; }
    if (!(rcCt[i] & 0x80) && rcCy[i] > (float)(RC_PY + 16)) {
      rcCt[i] |= 0x80;
      rcPassed++;
      sfx(820, 8);
    }
    if (fabsf(rcLaneX(rcCl[i]) - rcX) < 8.5f && fabsf(rcCy[i] - (float)RC_PY) < 14.0f) {
      if (rcShield > 0.0f) {   // shielded: smash through
        particlesBurst((int)rcLaneX(rcCl[i]), (int)rcCy[i], 10, 0);
        rcCl[i] = 0xFF;
        rcPassed++;
        sfx(180, 60);
      } else {
        rcDead = true;
        rcDeadAt = now;
        explosionBurst((int)rcX, RC_PY, 22, 0);
        screenShake(350, 4);
        sfxDeath();
        pixelsFlash(255, 0, 0, 80);
      }
    }
  }
  // shield token
  if (rcPuL != 0xFF) {
    rcPuY += rel * dt;
    if (rcPuY > 190.0f) {
      rcPuL = 0xFF;
    } else if (fabsf(rcLaneX(rcPuL) - rcX) < 10.0f && fabsf(rcPuY - (float)RC_PY) < 14.0f) {
      rcPuL = 0xFF;
      rcShield = 8.0f;
      particlesBurst((int)rcX, RC_PY, 12, rcShieldCol);
      sfx(1100, 60);
    }
  }
  if (rcShield > 0.0f) {
    rcShield -= dt;
    if (rcShield <= 0.0f) { rcShield = 0.0f; sfx(300, 70); }
  }
  int ms = (int)(rcDist / 500.0f);
  if (ms > rcMilestone) {
    rcMilestone = ms;
    sfx(1200, 50);
    particlesBurst(64, 100, 8, 0);
  }
  drawRacer(now);
  blitScreen();
}

// --- Bubble Shooter ----------------------------------------------------------------
//
// Landscape. A hex-packed field of coloured bubbles hangs from the ceiling (10 columns x 11 rows,
// every other row shifted half a bubble). Left/Right sweep the launcher's aim (12..168 degrees,
// faster the longer you hold), A fires the loaded bubble, B swaps it with the preview. The shot
// bounces off the side walls and sticks where it touches the field. A group of 3+ equal colours
// pops; anything no longer connected to the ceiling drops (extra points). Back-to-back pops raise a
// combo multiplier (x1..x5). Every N shots the whole field creeps one row down with a fresh top
// row; a bubble that reaches the red line ends the game. Clearing the field refills it. Colours
// come from the round seed (2P player 2 gets the same queue). Group/orphan detection is an
// iterative flood with an explicit stack (no recursion). Score = points. Tiers = colours/creep.

#define BUB_C 10
#define BUB_R 11
#define BUB_LOSE 10
#define BUB_OX 4
#define BUB_OY 6
#define BUB_W 116
#define BUB_PX 11
#define BUB_PY 10
#define BUB_LX 62
#define BUB_LY 118
#define BUB_NF 20
static uint8_t bubGrid[BUB_R * BUB_C];     // 0 empty, 1..5 colour
static uint16_t bubCol[6];
static float bubAng, bubX, bubY, bubVx, bubVy, bubHold;
static float bubFx[BUB_NF], bubFy[BUB_NF], bubFv[BUB_NF];   // falling (orphaned) bubbles
static uint8_t bubFc[BUB_NF];
static uint8_t bubPar, bubNcol, bubCur, bubNext, bubCreepN, bubLeft, bubShotsLeft;   // bubShotsLeft: custom fields only
static bool bubFlying, bubEnded;
static int bubScore, bubCombo, bubPops, bubLevel, bubPopV, bubPopX, bubPopY;
static unsigned long bubDeadAt, bubPopT0;
static const uint8_t kBubNcol[4] = {4, 5, 4, 5};
static const uint8_t kBubRows[4] = {5, 5, 4, 6};
static const uint8_t kBubCreep[4] = {6, 5, 8, 4};
static const uint8_t kBubShots[4] = {40, 30, 50, 22};   // custom fields never creep: this many shots instead
static const char* const kBubModes[4] = {"NORMAL: 4 COLORS", "SPEED: 5 COLORS", "CHILL: SLOW CREEP", "EXTREME: FAST CREEP"};
static const char* const kBubTier4[4] = {"NORM", "FAST", "CHIL", "XTRM"};
// Level-creator field (top 8 rows, tile 0 empty / 1-5 colour). Clearing it wins; the field never
// creeps down in a custom level.
static bool bubCustom = false, bubWon = false;
// Special bubbles live only in the shot queue (values 6 and 7, never in the grid): every 12th
// queued bubble is a BOMB (pops the 7-hex neighbourhood where it lands), every 17th a RAINBOW
// (takes the colour of the bubble it touches). The queue index is counted per round, so a 2P
// replay of the same seed gets the same specials at the same shots.
static uint16_t bubQN = 0;

static void enterBubTitle() {
  gameState = ST_BUBBLE_TITLE;
  drawStdTitleEx("BUBBLE SHOOTER", COL_TELE_B, "Left/Right: aim", "A: fire  B: swap next", "Bomb & rainbow bubbles", 51,
                 kBubModes[g_variant & 3]);
}

static int bubShift(int r) { return ((r + bubPar) & 1) ? BUB_PX / 2 : 0; }
static int bubCx(int r, int c) { return BUB_OX + 6 + c * BUB_PX + bubShift(r); }
static int bubCy(int r) { return BUB_OY + 6 + r * BUB_PY; }

// The (up to 6) cells touching cell (r,c): same row +-1, and two in each neighbouring row
// (the two columns that straddle it, which depend on whether the row is shifted).
static int bubNbr(int r, int c, int* out) {
  int n = 0;
  int sh = (r + bubPar) & 1;
  if (c > 0) out[n++] = r * BUB_C + c - 1;
  if (c < BUB_C - 1) out[n++] = r * BUB_C + c + 1;
  for (int k = 0; k < 2; k++) {
    int rr = r + (k ? 1 : -1);
    if (rr < 0 || rr >= BUB_R) continue;
    int c0 = sh ? c : c - 1;
    for (int j = 0; j < 2; j++) {
      int cc = c0 + j;
      if (cc >= 0 && cc < BUB_C) out[n++] = rr * BUB_C + cc;
    }
  }
  return n;
}

// Marks the same-colour group containing `start` (explicit stack; every cell is pushed at most
// once so 110 entries always suffice). Returns the group size.
static int bubGroup(int start, uint8_t* mark) {
  uint8_t stk[BUB_R * BUB_C];
  int sp = 0, n = 0;
  uint8_t col = bubGrid[start];
  if (!col) return 0;
  stk[sp++] = (uint8_t)start;
  mark[start] = 1;
  while (sp > 0) {
    int cur = stk[--sp];
    n++;
    int nb[6], k = bubNbr(cur / BUB_C, cur % BUB_C, nb);
    for (int i = 0; i < k; i++) {
      int q = nb[i];
      if (!mark[q] && bubGrid[q] == col) { mark[q] = 1; stk[sp++] = (uint8_t)q; }
    }
  }
  return n;
}

// Marks every bubble that is still connected to the ceiling through other bubbles.
static void bubAnchored(uint8_t* mark) {
  uint8_t stk[BUB_R * BUB_C];
  int sp = 0;
  memset(mark, 0, BUB_R * BUB_C);
  for (int c = 0; c < BUB_C; c++) if (bubGrid[c]) { mark[c] = 1; stk[sp++] = (uint8_t)c; }
  while (sp > 0) {
    int cur = stk[--sp];
    int nb[6], k = bubNbr(cur / BUB_C, cur % BUB_C, nb);
    for (int i = 0; i < k; i++) {
      int q = nb[i];
      if (!mark[q] && bubGrid[q]) { mark[q] = 1; stk[sp++] = (uint8_t)q; }
    }
  }
}

// Editor field: at least 10 bubbles and every one hanging from the ceiling (else it would drop at once).
static bool bubValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int n = 0;
  memset(bubGrid, 0, sizeof(bubGrid));
  for (int r = 0; r < 8 && r < lvl->h; r++)
    for (int c = 0; c < BUB_C && c < lvl->w; c++)
      if (lvl->cells[r][c] >= 1 && lvl->cells[r][c] <= 5) { bubGrid[r * BUB_C + c] = lvl->cells[r][c]; n++; }
  if (n < 10) { snprintf(msg, msgLen, "Need at least 10 bubbles"); return false; }
  bubPar = 0;
  uint8_t mark[BUB_R * BUB_C];
  bubAnchored(mark);
  for (int i = 0; i < BUB_R * BUB_C; i++)
    if (bubGrid[i] && !mark[i]) { snprintf(msg, msgLen, "Bubble not on ceiling"); return false; }
  return true;
}

// Fills the field from the level (rows 0-7). Returns false (field untouched) when it holds no bubble.
static bool bubLoadCustom(const LevelData *lvl) {
  uint8_t g[BUB_R * BUB_C];
  memset(g, 0, sizeof(g));
  int n = 0, hi = 0;
  for (int r = 0; r < 8 && r < lvl->h; r++)
    for (int c = 0; c < BUB_C && c < lvl->w; c++) {
      uint8_t t = lvl->cells[r][c];
      if (t >= 1 && t <= 5) { g[r * BUB_C + c] = t; n++; if (t > hi) hi = t; }
    }
  if (n == 0) return false;
  memcpy(bubGrid, g, sizeof(bubGrid));
  if (hi > (int)bubNcol) bubNcol = (uint8_t)hi;   // every colour on the field must be in the queue
  bubCustom = true;
  return true;
}

static uint8_t bubRaw() { return (uint8_t)(1 + mazeRngRange(bubNcol)); }

// Queue colour -> a colour that is still on the field (so the player is never stuck with a
// colour that no longer exists). The RNG consumption is independent of the field.
static uint8_t bubPickColor(uint8_t v) {
  if (v > 5) return v;   // special bubble
  uint8_t have = 0;
  for (int i = 0; i < BUB_R * BUB_C; i++) if (bubGrid[i]) have |= (uint8_t)(1u << bubGrid[i]);
  if (!have || (have & (1u << v))) return v;
  for (int k = 1; k <= (int)bubNcol; k++) {
    uint8_t w = (uint8_t)(1 + (v - 1 + k) % bubNcol);
    if (have & (1u << w)) return w;
  }
  return v;
}

// Next queue entry: always consumes one RNG value (colours stay seed-deterministic); the 12th /
// 17th entry of the round is replaced by a bomb / rainbow bubble.
static uint8_t bubMakeNext() {
  uint8_t c = bubPickColor(bubRaw());
  bubQN++;
  if (bubQN % 17 == 0) return 7;
  if (bubQN % 12 == 0) return 6;
  return c;
}

static void bubFillRows(int rows) {
  memset(bubGrid, 0, sizeof(bubGrid));
  for (int r = 0; r < rows && r < BUB_LOSE - 2; r++)
    for (int c = 0; c < BUB_C; c++) bubGrid[r * BUB_C + c] = bubRaw();
}

static void enterBubPlaying() {
  s_mazeRng = gameSeed();
  int t = g_variant & 3;
  bubNcol = kBubNcol[t];
  bubCreepN = kBubCreep[t];
  bubCol[0] = arcada.display->color565(230, 55, 55);
  bubCol[1] = arcada.display->color565(60, 200, 80);
  bubCol[2] = arcada.display->color565(60, 130, 245);
  bubCol[3] = arcada.display->color565(240, 220, 60);
  bubCol[4] = arcada.display->color565(180, 80, 230);
  bubCol[5] = arcada.display->color565(255, 255, 255);
  bubPar = 0;
  bubFillRows(kBubRows[t]);
  bubCustom = false;
  bubWon = false;
  if (s_lvlActiveSlot[LVLGAME_BUBBLE] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_BUBBLE, s_lvlActiveSlot[LVLGAME_BUBBLE], &lvl)) bubLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_BUBBLE] = -1;
  }
  bubShotsLeft = bubCustom ? kBubShots[t] : 0;
  bubQN = 0;
  bubCur = bubMakeNext();
  bubNext = bubMakeNext();
  bubAng = 90.0f;
  bubHold = 0.0f;
  bubFlying = false;
  bubEnded = false;
  bubScore = 0;
  bubCombo = 0;
  bubPops = 0;
  bubLevel = 1;
  bubLeft = bubCreepN;
  bubDeadAt = 0;
  bubPopT0 = 0;
  memset(bubFc, 0, sizeof(bubFc));
  s_lastFrameMs = 0;
  gameState = ST_BUBBLE_PLAYING;
}

static void bubDrawBubble(int x, int y, uint8_t col) {
  if (col < 1 || col > 7) return;
  if (col == 6) {   // bomb: dark ball, bright rim, lit fuse
    canvas->fillCircle(x, y, 5, arcada.display->color565(60, 60, 72));
    canvas->drawCircle(x, y, 5, COL_ORANGE);
    canvas->fillCircle(x, y + 1, 2, COL_BG);
    canvas->drawLine(x + 2, y - 4, x + 4, y - 6, COL_KEY);
    canvas->drawPixel(x + 5, y - 6, (millis() >> 7) & 1 ? COL_ORANGE : 0xFFFF);
    static const int8_t kSpX[8] = {1, 3, 2, -1, 0, 3, -2, 1};   // fuse sparks fly around the tip
    static const int8_t kSpY[8] = {-2, -1, -3, -2, -3, -3, -1, -1};
    uint32_t ph = millis() >> 6;
    for (int k = 0; k < 3; k++) {
      int j = (int)((ph + (uint32_t)k * 3u) & 7u);
      canvas->drawPixel(x + 5 + kSpX[j], y - 6 + kSpY[j], k == 0 ? 0xFFFF : (k == 1 ? COL_KEY : COL_ORANGE));
    }
    return;
  }
  if (col == 7) {   // rainbow: concentric colour rings
    for (int k = 0; k < 5; k++) canvas->fillCircle(x, y, 5 - k, bubCol[k]);
    return;
  }
  canvas->fillCircle(x, y, 5, bubCol[col - 1]);
  canvas->drawPixel(x - 2, y - 2, COL_TEXT);
}

// True when a bubble centred at (x,y) overlaps a bubble already on the field.
static bool bubHit(float x, float y) {
  for (int r = 0; r < BUB_R; r++) {
    float cy = (float)bubCy(r);
    if (fabsf(cy - y) > 11.0f) continue;
    for (int c = 0; c < BUB_C; c++) {
      if (!bubGrid[r * BUB_C + c]) continue;
      float dx = x - (float)bubCx(r, c), dy = y - cy;
      if (dx * dx + dy * dy < 100.0f) return true;
    }
  }
  return false;
}

static bool bubOverflow() {
  for (int i = BUB_LOSE * BUB_C; i < BUB_R * BUB_C; i++) if (bubGrid[i]) return true;
  return false;
}

// Removes a bubble with a burst; `fall` also launches it as a falling sprite (orphans).
static void bubPopCell(int i, bool fall) {
  uint8_t col = bubGrid[i];
  bubGrid[i] = 0;
  if (!col) return;
  int r = i / BUB_C, c = i % BUB_C;
  int x = bubCx(r, c), y = bubCy(r);
  particlesBurst(x, y, fall ? 2 : 4, bubCol[col - 1]);
  if (!fall) return;
  for (int k = 0; k < BUB_NF; k++) {
    if (bubFc[k]) continue;
    bubFc[k] = col;
    bubFx[k] = (float)x;
    bubFy[k] = (float)y;
    bubFv[k] = -60.0f;
    break;
  }
}

static void bubLose() {
  bubDeadAt = millis();
  if (bubDeadAt == 0) bubDeadAt = 1;
  sfxDeath();
  pixelsFlash(255, 0, 0, 80);
  for (int c = 0; c < BUB_C; c += 2) particlesBurst(bubCx(BUB_LOSE - 1, c), bubCy(BUB_LOSE - 1), 4, 0);
}

// Pushes the whole field one row down and deals a new top row (parity flips so the existing
// bubbles keep their x positions).
static void bubCreep() {
  memmove(bubGrid + BUB_C, bubGrid, (BUB_R - 1) * BUB_C);
  bubPar ^= 1;
  for (int c = 0; c < BUB_C; c++) bubGrid[c] = bubRaw();
  sfx(150, 80);
  for (int c = 0; c < BUB_C; c += 3) particlesBurst(bubCx(0, c), bubCy(0), 2, 0);
}

// The shot has touched the field (or the ceiling): snap it to the nearest free attachable
// cell, pop/drop what it completes, creep/level-up, then load the next bubble.
static void bubLand() {
  bubFlying = false;
  int best = -1;
  float bd2 = 1e9f;
  for (int r = 0; r < BUB_R; r++) {
    for (int c = 0; c < BUB_C; c++) {
      int i = r * BUB_C + c;
      if (bubGrid[i]) continue;
      if (r > 0) {
        int nb[6], k = bubNbr(r, c, nb);
        bool att = false;
        for (int j = 0; j < k; j++) if (bubGrid[nb[j]]) { att = true; break; }
        if (!att) continue;
      }
      float dx = bubX - (float)bubCx(r, c), dy = bubY - (float)bubCy(r);
      float d2 = dx * dx + dy * dy;
      if (d2 < bd2) { bd2 = d2; best = i; }
    }
  }
  if (best < 0) { bubLose(); return; }
  const uint8_t spc = bubCur;   // 6 bomb, 7 rainbow, else colour
  int bx = bubCx(best / BUB_C, best % BUB_C), by = bubCy(best / BUB_C);
  uint8_t mark[BUB_R * BUB_C];
  memset(mark, 0, sizeof(mark));
  int n = 0;
  if (spc == 6) {   // bomb: the landing cell is not kept; every occupied neighbour pops
    int nb[6], k = bubNbr(best / BUB_C, best % BUB_C, nb);
    for (int j = 0; j < k; j++) if (bubGrid[nb[j]]) { mark[nb[j]] = 1; n++; }
    if (n > 0) { explosionBurst(bx, by, 16, 0); screenShake(180 + 30 * n, n >= 4 ? 4 : (n >= 2 ? 3 : 2)); }   // bigger blast, bigger shake
  } else {
    uint8_t put = spc;
    if (spc == 7) {   // rainbow: colour of the touched neighbour nearest to the impact point
      put = 0;
      float bdn = 1e9f;
      int nb[6], k = bubNbr(best / BUB_C, best % BUB_C, nb);
      for (int j = 0; j < k; j++) {
        if (!bubGrid[nb[j]]) continue;
        float dx = bubX - (float)bubCx(nb[j] / BUB_C, nb[j] % BUB_C), dy = bubY - (float)bubCy(nb[j] / BUB_C);
        if (dx * dx + dy * dy < bdn) { bdn = dx * dx + dy * dy; put = bubGrid[nb[j]]; }
      }
      for (int i = 0; i < BUB_R * BUB_C && !put; i++) put = bubGrid[i];   // ceiling hit: any colour still on the field
      if (!put) put = 1;
      particlesBurst(bx, by, 6, bubCol[put - 1]);
    }
    bubGrid[best] = put;
    n = bubGroup(best, mark);
  }
  if (spc == 6 ? n >= 1 : n >= 3) {
    int popped = 0, dropped = 0;
    for (int i = 0; i < BUB_R * BUB_C; i++) if (mark[i]) { bubPopCell(i, false); popped++; }
    bubAnchored(mark);
    for (int i = 0; i < BUB_R * BUB_C; i++) if (bubGrid[i] && !mark[i]) { bubPopCell(i, true); dropped++; }
    int mult = 1 + (bubCombo < 4 ? bubCombo : 4);
    int pts = (popped * 10 + (popped > 3 ? (popped - 3) * 5 : 0) + dropped * 25) * mult;
    bubScore += pts;
    bubPops += popped + dropped;
    bubCombo++;
    bubPopV = pts;
    bubPopX = bx - 8;
    bubPopY = by;
    bubPopT0 = millis();
    if (spc == 6 && popped > 0) specialDelivery();
    if (spc != 6) {   // shake scales with the pop: small pops tremble, 8+ shake more and more
      int tot = popped + dropped;
      if (tot >= 8) { int amp = 2 + (tot - 8) / 4; explosionBurst(bx, by, 14, 0); screenShake(160 + 10 * (tot > 20 ? 20 : tot), amp > 4 ? 4 : amp); }
      else if (tot >= 5) screenShake(80, 1);
    }
    if (dropped > 0) sfx(1000, 70);
    else sfx(460 + 45 * (popped > 10 ? 10 : popped), 45);
    if (mult >= 3) pixelsFlashAsync(255, 220, 80, 60);
  } else {
    bubCombo = 0;
    sfx(260, 25);
  }
  bool empty = true;
  for (int i = 0; i < BUB_R * BUB_C; i++) if (bubGrid[i]) { empty = false; break; }
  if (empty && bubCustom) {   // the hand-made field is cleared: level done
    bubScore += 200 + 100 * bubLevel;
    bubWon = true;
    bubDeadAt = millis();
    if (bubDeadAt == 0) bubDeadAt = 1;
    sfxWin();
    particlesBurst(40, 50, 10, 0);
    particlesBurst(90, 50, 10, 0);
    return;
  }
  if (empty) {            // board cleared: bonus, a fresh (slightly taller) field
    bubScore += 200 + 100 * bubLevel;
    bubLevel++;
    int rows = kBubRows[g_variant & 3] + (bubLevel - 1) / 2;
    bubFillRows(rows > 8 ? 8 : rows);
    bubLeft = bubCreepN;
    sfxWin();
    particlesBurst(40, 50, 10, 0);
    particlesBurst(90, 50, 10, 0);
  } else {
    if (bubOverflow()) { bubLose(); return; }
    if (bubCustom) {   // no creeping rows on a hand-made field: a per-tier shot limit is its loss condition
      if (bubShotsLeft > 0) bubShotsLeft--;
      if (bubShotsLeft == 0) { bubLose(); return; }
    } else if (bubLeft > 0) bubLeft--;
    if (bubLeft == 0 && !bubCustom) {
      bubCreep();
      bubLeft = bubCreepN;
      if (bubOverflow()) { bubLose(); return; }
    }
  }
  bubCur = bubPickColor(bubNext);
  bubNext = bubMakeNext();
}

static void bubDraw(unsigned long now) {
  canvas->fillScreen(COL_BG);
  // walls, ceiling and the red line
  canvas->drawFastVLine(BUB_OX - 1, BUB_OY, 122, COL_WALL);
  canvas->drawFastVLine(BUB_OX + BUB_W, BUB_OY, 122, COL_WALL);
  canvas->drawFastHLine(BUB_OX - 1, BUB_OY - 1, BUB_W + 2, COL_WALL);
  bool warn = false;
  for (int c = 0; c < BUB_C; c++) if (bubGrid[(BUB_LOSE - 1) * BUB_C + c]) { warn = true; break; }
  uint16_t lineCol = warn ? COL_LASER : arcada.display->color565(110, 30, 30);
  int ly = BUB_OY + BUB_LOSE * BUB_PY;
  for (int x = BUB_OX; x < BUB_OX + BUB_W; x += 6) canvas->drawFastHLine(x, ly, 3, lineCol);
  // field
  for (int r = 0; r < BUB_R; r++)
    for (int c = 0; c < BUB_C; c++) {
      uint8_t v = bubGrid[r * BUB_C + c];
      if (v) bubDrawBubble(bubCx(r, c), bubCy(r), v);
    }
  for (int k = 0; k < BUB_NF; k++) if (bubFc[k]) bubDrawBubble((int)bubFx[k], (int)bubFy[k], bubFc[k]);
  // launcher + aim guide
  float rad = bubAng * 0.0174533f;
  float ca = cosf(rad), sa = sinf(rad);
  if (!bubFlying && !bubDeadAt) {
    float x = (float)BUB_LX, y = (float)BUB_LY, vx = ca, vy = -sa;
    const float lo = (float)BUB_OX + 5.5f, hi = (float)(BUB_OX + BUB_W) - 5.5f;
    for (int i = 0; i < 46; i++) {
      x += vx * 3.0f;
      y += vy * 3.0f;
      if (x < lo) { x = 2.0f * lo - x; vx = -vx; }
      else if (x > hi) { x = 2.0f * hi - x; vx = -vx; }
      if (y <= (float)bubCy(0) || (y < 112.0f && bubHit(x, y))) break;
      if (i >= 3 && (i & 1) == 0) canvas->drawPixel((int)x, (int)y, COL_TEXT);
    }
  }
  canvas->fillCircle(BUB_LX, BUB_LY + 4, 7, arcada.display->color565(70, 70, 90));
  canvas->drawLine(BUB_LX, BUB_LY, BUB_LX + (int)(ca * 15.0f), BUB_LY - (int)(sa * 15.0f), COL_WALL);
  canvas->drawLine(BUB_LX + 1, BUB_LY, BUB_LX + 1 + (int)(ca * 15.0f), BUB_LY - (int)(sa * 15.0f), COL_WALL);
  if (bubFlying) bubDrawBubble((int)(bubX + 0.5f), (int)(bubY + 0.5f), bubCur);
  else bubDrawBubble(BUB_LX, BUB_LY, bubCur);
  // side panel
  canvas->setTextSize(1);
  char t[16];
  ptc(COL_TEXT, 124, 2, "SCORE");
  ptc(COL_KEY, 124, 11, bubScore);
  int32_t bs = saveBest(51, saveTierOf(g_variant));
  ptc(COL_TEXT, 124, 24, "BEST");
  canvas->setCursor(124, 33);
  if (bs == SAVE_NO_SCORE) canvas->print("--");
  else canvas->print((int)bs);
  pt(124, 46, "NEXT");
  bubDrawBubble(142, 63, bubNext);
  pt(124, 76, "LEVEL");
  pt(124, 85, bubLevel);
  pt(124, 98, bubCustom ? "SHOTS" : "CREEP");
  canvas->setTextColor((bubCustom ? bubShotsLeft <= 5 : bubLeft <= 1) ? COL_LASER : COL_GOAL);
  if (bubCustom) snprintf(t, sizeof(t), "%d left", (int)bubShotsLeft);
  else snprintf(t, sizeof(t), "in %d", (int)bubLeft);
  pt(124, 107, t);
  ptc(COL_TEXT, 124, 119, kBubTier4[g_variant & 3]);
  if (bubCombo >= 1) {
    canvas->setTextColor(COL_ORANGE);
    snprintf(t, sizeof(t), "COMBO x%d", 1 + (bubCombo < 4 ? bubCombo : 4));
    pt(6, 119, t);
  }
  if (bubPopT0 && now - bubPopT0 < 800UL) {
    canvas->setTextColor(COL_TEXT);
    snprintf(t, sizeof(t), "+%d", bubPopV);
    pt(bubPopX, bubPopY - (int)((now - bubPopT0) / 40), t);
  }
  if (bubDeadAt) {
    canvas->fillRect(18, 48, 84, 30, COL_BG);
    canvas->drawRect(18, 48, 84, 30, bubWon ? COL_GOAL : COL_LASER);
    canvas->setTextColor(bubWon ? COL_GOAL : COL_LASER);
    bool noShots = bubCustom && !bubWon && bubShotsLeft == 0;
    pt(bubWon ? 36 : (noShots ? 33 : 30), 58, bubWon ? "CLEARED!" : (noShots ? "NO SHOTS!" : "OVERFLOW!"));
  }
  particlesUpdateDraw();
}

static void bubToOver() {
  bubEnded = true;
  long sc = bubScore;
  if (bubCustom) {
    s_lastNewBest = false;
    lvlRecordRun(LVLGAME_BUBBLE, sc, true);
    if (bubWon) lvlOnClear(LVLGAME_BUBBLE);
  } else {
    recordResult(51, g_variant, sc, true);
  }
  if (g_twoPlayerMode) { twoPHandleGameEnd(sc); return; }
  gameState = ST_BUBBLE_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%ld", sc);
  snprintf(sub, sizeof(sub), "Level %d  Pops %d", bubLevel, bubPops);
  drawStdOver(bubWon ? "FIELD CLEARED" : (bubCustom && bubShotsLeft == 0 ? "OUT OF SHOTS" : "OVERFLOW"), bubWon ? COL_GOAL : COL_LASER, big, sub, 51);
}

static void bubFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;
  if (bubEnded) return;
  for (int k = 0; k < BUB_NF; k++) {
    if (!bubFc[k]) continue;
    bubFv[k] += 520.0f * dt;
    bubFy[k] += bubFv[k] * dt;
    if (bubFy[k] > 136.0f) bubFc[k] = 0;
  }
  if (bubDeadAt) {
    if (now - bubDeadAt >= 1100UL) { bubToOver(); return; }
    bubDraw(now);
    blitScreen();
    return;
  }
  if (bubFlying) {
    const float lo = (float)BUB_OX + 5.5f, hi = (float)(BUB_OX + BUB_W) - 5.5f;
    int n = (int)(210.0f * dt / 2.5f) + 1;
    float h = dt / (float)n;
    for (int s = 0; s < n && bubFlying; s++) {
      bubX += bubVx * h;
      bubY += bubVy * h;
      if (bubX < lo) { bubX = 2.0f * lo - bubX; bubVx = -bubVx; sfx(330, 6); }
      else if (bubX > hi) { bubX = 2.0f * hi - bubX; bubVx = -bubVx; sfx(330, 6); }
      if (bubY <= (float)bubCy(0) || bubHit(bubX, bubY)) bubLand();
    }
  } else {
    bool l = (buttons & ARCADA_BUTTONMASK_LEFT) != 0, r = (buttons & ARCADA_BUTTONMASK_RIGHT) != 0;
    if (l != r) {
      bubHold += dt;
      float rate = 35.0f + 85.0f * (bubHold > 1.0f ? 1.0f : bubHold);
      bubAng += (l ? rate : -rate) * dt;
      if (bubAng < 12.0f) bubAng = 12.0f;
      if (bubAng > 168.0f) bubAng = 168.0f;
    } else {
      bubHold = 0.0f;
    }
    if (pressed & ARCADA_BUTTONMASK_B) {
      uint8_t tmp = bubCur;
      bubCur = bubNext;
      bubNext = tmp;
      sfx(700, 15);
    }
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_UP)) {
      float rad = bubAng * 0.0174533f;
      bubX = (float)BUB_LX;
      bubY = (float)BUB_LY;
      bubVx = cosf(rad) * 210.0f;
      bubVy = -sinf(rad) * 210.0f;
      bubFlying = true;
      sfx(440, 20);
    }
  }
  bubDraw(now);
  blitScreen();
}

// --- Mastermind ----------------------------------------------------------------------
//
// Code breaking. A hidden row of 4-5 coloured pegs; Left/Right pick a slot, Up/Down change its
// colour, A submits the guess, B clears the row. Each guess gets feedback pegs beside it: green =
// right colour in the right slot, yellow = right colour in the wrong slot. Two modes like the
// board games: vs CPU (the CPU deals a seeded code, you have a limited number of guesses; a solve
// scores guesses-left x 10 + a tier bonus and is the only thing recorded) or 2 PLAYERS (hot-seat:
// one player secretly sets the code behind a "pass the device" screen, the other guesses; then
// the roles swap; fewest guesses wins the match; the setter alternates match to match; nothing is
// recorded). Tiers (g_variant): 0 NORMAL 4 pegs/6 colours/10 tries, 1 EASY 4/5/12, 2 HARD 5/6/10,
// 3 EXTREME 5/8/8.

#define MM_MAXP 5
#define MM_MAXG 12
#define MP_GUESS 0
#define MP_SET 1
#define MP_PASS 2
#define MP_REVEAL 3
static const uint8_t kMmLen[4] = {4, 4, 5, 5};
static const uint8_t kMmCols[4] = {6, 5, 6, 8};
static const uint8_t kMmTries[4] = {10, 12, 10, 8};
static const uint8_t kMmBonus[4] = {30, 20, 40, 60};
static uint8_t mmCode[MM_MAXP], mmCur[MM_MAXP], mmGuess[MM_MAXG][MM_MAXP], mmFb[MM_MAXG];
static uint8_t mmLen, mmCols, mmTries, mmN, mmSlot, mmPh, mmNextPh, mmWho, mmRound, mmSetter;
static bool mmVsCpu = true, mmSolved;
static int mmSb[2][3];                  // scoreboard [0 = vs CPU: cracked/failed, 1 = 2P: P1/P2/draws]
static int mmFewest[2], mmRes[2], mmScore;
static int8_t mmFirst = 1;              // 2P: who sets the code first in the next match
static int8_t mmWinner;                 // 2P: 1 / 2 / 3 = draw
static uint16_t mmCol[9], mmHit, mmNear;
static unsigned long mmPhT0, mmBlinkT;
// Level-creator code (vs CPU only): tiles 0 empty / 1-8 colour, 5 pegs; shorter tiers use the first pegs.
static bool mmCustom = false;
// Hints (vs CPU only): Start tap reveals one secret peg, max 2 per round, each costs score points.
static uint8_t mmHintPos[2], mmHintN;
// "~N left" counter (vs CPU, NORMAL / EASY only): codes still consistent with every feedback so far.
static uint16_t mmLeft;
static bool mmAid;
static bool mmStartDown = false;
static bool mmStartArmed = false;       // Start was seen released since the round began / resumed
static unsigned long mmLastFrameMs = 0; // a frame gap (pause menu) disarms the tap
static unsigned long mmStartT0 = 0;
static const uint8_t kMmHintPen[4] = {15, 10, 20, 30};
// Black or white glyph per colour (1..8) for the colour-blind symbol overlay (letters A-H).
static const uint8_t kMmGlyphDark[9] = {0, 0, 1, 0, 1, 0, 1, 1, 1};

static bool mindValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  for (int i = 0; i < 4; i++)
    if (i >= lvl->w || lvl->cells[0][i] < 1 || lvl->cells[0][i] > 8) {
      snprintf(msg, msgLen, "Fill the first 4 pegs");
      return false;
    }
  return true;
}

static const char* mmName(int who) {
  if (mmVsCpu) return "YOU";
  return who == 1 ? "P1" : "P2";
}

