    if (lvlLoadSlot(game, (uint8_t)s_lvlActiveSlot[game], &d) && d.name[0]) snprintf(nm, sizeof(nm), "%s", d.name);
    else snprintf(nm, sizeof(nm), "Custom %d", ((int)s_lvlActiveSlot[game] & 7) + 1);
    canvas->print(nm);
    canvas->print(" (");
    canvas->print(key);
    canvas->print(": levels)");
  } else {
    canvas->print(key);
    canvas->print(": custom levels");
  }
