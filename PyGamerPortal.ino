// --- Monster Brawl ---------------------------------------------------------
//
// A turn-based auto-battler in the shape of Blooket's Monster Brawl mode,
// minus the trivia layer that normally gates it -- here, coins come from
// winning fights instead of answering questions, and go straight into an
// upgrade shop between rounds (bump the whole team's ATK or max HP, or
// heal up) rather than a one-off stat roll per battle. Your team persists
// and grows across rounds; only the enemy team is freshly generated each
// time, stronger than the last (auto-generated, not hand-authored, so
// there's no fixed level count to run out of).

struct BrawlMon {
  char name[10];
  int maxHp, hp, atk;
  uint16_t color;
};
#define BRAWL_TEAM_SIZE 3
static const char* kBrawlNames[6] = {"FLAMEPUP", "AQUABIT", "ROOTLING",
                                      "SPARKIT",  "STONEGOL", "GUSTLING"};
static BrawlMon brawlPlayer[BRAWL_TEAM_SIZE], brawlEnemy[BRAWL_TEAM_SIZE];
static int brawlPlayerIdx, brawlEnemyIdx, brawlRound;
static bool brawlWaitingForEnemy;
static unsigned long brawlEnemyMoveAtMs;
static char brawlLog[24];
static int brawlCoins, brawlShopSel;
static int brawlAtkUpgrades, brawlHpUpgrades; // purchase counts, so cost can climb each time

#define BRAWL_SHOP_ATK 0
#define BRAWL_SHOP_HP 1
#define BRAWL_SHOP_HEAL 2
#define BRAWL_SHOP_CONTINUE 3
#define BRAWL_NUM_SHOP_ITEMS 4

static int brawlAtkCost() { return 6 + brawlAtkUpgrades * 3; }
static int brawlHpCost() { return 5 + brawlHpUpgrades * 3; }
#define BRAWL_HEAL_COST 4

// Inlined into brawlNewPlayerTeam/brawlNewEnemyTeam rather than a shared
// helper -- a BrawlMon* parameter would put the struct name in the
// function's signature, and the Arduino IDE's auto-generated forward
// prototypes land above every struct definition in the file, so it'd
// fail to compile no matter where BrawlMon itself is declared (see the
// same note on galleryTargetScreenX further up).

static void brawlNewPlayerTeam() {
  static const uint16_t playerColors[BRAWL_TEAM_SIZE] = {COL_BLUE, COL_BOOST, COL_KEY};
  for (int i = 0; i < BRAWL_TEAM_SIZE; i++) {
    strncpy(brawlPlayer[i].name, kBrawlNames[mazeRngRange(6)], sizeof(brawlPlayer[i].name) - 1);
    brawlPlayer[i].name[sizeof(brawlPlayer[i].name) - 1] = 0;
    brawlPlayer[i].maxHp = brawlPlayer[i].hp = 28 + mazeRngRange(8);
    brawlPlayer[i].atk = 5 + mazeRngRange(3);
    brawlPlayer[i].color = playerColors[i];
  }
  brawlAtkUpgrades = 0;
  brawlHpUpgrades = 0;
}

static float brawlEnemyScaleMul = 1.0f;
static int brawlEnemyBaseBonus = 0; // flat offset so round 1 isn't identical across tiers
static const char* kBrawlTierNames[4] = {"NORMAL", "EASY", "HARD", "EXTREME"};

static void brawlNewEnemyTeam() {
  static const uint16_t enemyColors[BRAWL_TEAM_SIZE] = {COL_LASER, COL_TELE_A, COL_DOOR_CLOSED};
  // Stronger opponents each round -- the difficulty curve, not a level
  // list -- scaled again by the chosen difficulty tier, plus a flat
  // offset so the very first fight (round 0, before any per-round
  // scaling has kicked in) still differs between tiers.
  int enemyBonus = brawlEnemyBaseBonus + (int)(brawlRound * 3 * brawlEnemyScaleMul);
  if (enemyBonus < 0) enemyBonus = 0;
  for (int i = 0; i < BRAWL_TEAM_SIZE; i++) {
    strncpy(brawlEnemy[i].name, kBrawlNames[mazeRngRange(6)], sizeof(brawlEnemy[i].name) - 1);
    brawlEnemy[i].name[sizeof(brawlEnemy[i].name) - 1] = 0;
    brawlEnemy[i].maxHp = brawlEnemy[i].hp = 24 + mazeRngRange(8) + enemyBonus;
    brawlEnemy[i].atk = 4 + mazeRngRange(3) + enemyBonus / 4;
    brawlEnemy[i].color = enemyColors[i];
  }
  brawlPlayerIdx = 0;
  brawlEnemyIdx = 0;
  brawlWaitingForEnemy = false;
  brawlLog[0] = 0;
}

static void enterBrawlTitle() {
  gameState = ST_BRAWL_TITLE;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_EMITTER, 18, 14, "MONSTER BRAWL");
  ptc(COL_TEXT, 4, 40, "A: attack");
  pt(4, 50, "Win coins each round,");
  pt(4, 60, "spend them on upgrades");
  pt(4, 78, "Team grows, enemies");
  pt(4, 88, "get tougher each round");
  pt(4, 98, "Difficulty: ");
  canvas->print(kBrawlTierNames[g_variant]);
  pt(4, 108, "Left/Right: change");
  canvas->setCursor(4, 118);
  animPrompt("A/Start: play  B: back");
  drawBestLine(10, 26);
  blitScreen();
}

static void enterBrawlPlaying() {
  s_mazeRng = gameSeed(); // see the comment in enterMolePlaying
  brawlRound = 0;
  brawlCoins = 0;
  switch (g_variant) {
    case 1: brawlEnemyBaseBonus = -6; brawlEnemyScaleMul = 0.6f; break;  // Easy
    case 2: brawlEnemyBaseBonus = 6; brawlEnemyScaleMul = 1.5f; break;   // Hard
    case 3: brawlEnemyBaseBonus = 14; brawlEnemyScaleMul = 2.2f; break; // Extreme
    default: brawlEnemyBaseBonus = 0; brawlEnemyScaleMul = 1.0f; break;
  }
  brawlNewPlayerTeam();
  brawlNewEnemyTeam();
  gameState = ST_BRAWL_PLAYING;
}

// A single side's damage roll, +/-20% of attacker's ATK so fights aren't
// perfectly predictable turn-for-turn.
static int brawlRoll(int atk) {
  int variance = atk / 5;
  return atk - variance + (variance > 0 ? mazeRngRange(variance * 2 + 1) : 0);
}

static void drawBrawlScene() {
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  BrawlMon& p = brawlPlayer[brawlPlayerIdx];
  BrawlMon& e = brawlEnemy[brawlEnemyIdx];

  // Side by side (player left, enemy right) at the same height, rather
  // than the earlier diagonal layout -- that put the enemy's name/HP bar
  // right where the bench dots were, so the bench drew on top of (and
  // partly obscured) the enemy's name each frame. Laid out with an
  // explicit top-to-bottom budget instead: bench row, then both blobs,
  // then both name+HP bars, then the battle log and prompt -- each band
  // has clearance from the one above and below it.
  int px = 30, ex = 130;
  int blobY = HUD_HEIGHT + 46;
  canvas->fillCircle(px, blobY, 14, p.color);
  canvas->fillCircle(ex, blobY, 14, e.color);

  int nameY = blobY + 20;
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(1);
  pt(px - 24, nameY, p.name);
  pt(ex - 24, nameY, e.name);

  int barY = nameY + 12, barW = 48;
  canvas->drawRect(px - barW / 2, barY, barW, 6, COL_TEXT);
  int pFill = (int)((long)(barW - 2) * p.hp / p.maxHp);
  if (pFill > 0) canvas->fillRect(px - barW / 2 + 1, barY + 1, pFill, 4, COL_GOAL);
  canvas->drawRect(ex - barW / 2, barY, barW, 6, COL_TEXT);
  int eFill = (int)((long)(barW - 2) * e.hp / e.maxHp);
  if (eFill > 0) canvas->fillRect(ex - barW / 2 + 1, barY + 1, eFill, 4, COL_GOAL);

  // Bench: small dots for the rest of each team, dim once fainted. Sits
  // in the strip right under the HUD, well clear of the blobs below it.
  int benchY = HUD_HEIGHT + 4;
  for (int i = 0; i < BRAWL_TEAM_SIZE; i++) {
    canvas->fillCircle(10 + i * 10, benchY, 3,
                        brawlPlayer[i].hp > 0 ? brawlPlayer[i].color : COL_WALL_NOPORTAL);
    canvas->fillCircle(150 - i * 10, benchY, 3,
                        brawlEnemy[i].hp > 0 ? brawlEnemy[i].color : COL_WALL_NOPORTAL);
  }

  pt(4, barY + 14, brawlLog);
  if (!brawlWaitingForEnemy) {
    pt(4, barY + 24, "A: attack");
  }
}

static void drawBrawlHud() {
  canvas->fillRect(0, 0, VIEW_COLS * TILE_SIZE, HUD_HEIGHT, COL_BG);
  canvas->setCursor(2, 4);
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(1);
  canvas->print("ROUND ");
