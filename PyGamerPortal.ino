  canvas->setTextColor(COL_LASER);
  const char* msg;
  if (chsVsCpu) msg = chsWinner == 1 ? "YOU WIN" : chsWinner == 2 ? "CPU WINS" : "DRAW";
  else msg = chsWinner == 1 ? "PLAYER 1 WINS" : chsWinner == 2 ? "PLAYER 2 WINS" : "DRAW";
  pt((160 - (int)strlen(msg) * 6) / 2, 16, msg);
  canvas->setTextColor(COL_TEXT);
  static const char* const kWhy[7] = {"", "Checkmate", "Stalemate", "Not enough material", "50-move rule", "Threefold repetition", "Out of time"};
  pt(4, 34, kWhy[chsEndWhy < 7 ? chsEndWhy : 0]);
  char sb[32];
  if (chsVsCpu) snprintf(sb, sizeof(sb), "You %d  CPU %d  Draws %d", chsSb[0][0], chsSb[0][1], chsSb[0][2]);
  else snprintf(sb, sizeof(sb), "P1 %d  P2 %d  Draws %d", chsSb[1][0], chsSb[1][1], chsSb[1][2]);
  pt(4, 48, sb);
