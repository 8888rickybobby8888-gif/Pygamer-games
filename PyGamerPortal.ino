// Navigation with auto-repeat while held (essential with 400+ levels) --
// an initial press fires immediately, then it repeats every 80ms after an
// initial 350ms delay.
static uint32_t s_menuPrevButtons = 0;
static unsigned long s_menuRepeatAt = 0;

static uint32_t menuNavPressed(uint32_t buttons) {
  const uint32_t navMask = ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT |
                            ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN;
  uint32_t freshlyPressed = buttons & ~s_menuPrevButtons & navMask;
  uint32_t held = buttons & navMask;
  unsigned long now = millis();
  uint32_t result = freshlyPressed;

  if (freshlyPressed) {
    s_menuRepeatAt = now + 350;
  } else if (held && now >= s_menuRepeatAt) {
    result |= held;
    s_menuRepeatAt = now + 80;
  }
  if (!held) {
    s_menuRepeatAt = 0;
  }
  s_menuPrevButtons = buttons;
  return result;
}

// --- Target Rush (reflex shooting gallery) --------------------------------
//
// A separate, much simpler game mode that reuses Portal's raycaster
// (walls/floor/ceiling casting, billboard sprites) but none of its puzzle
// state -- it borrows the shared grid[]/curW/curH/playerX/Y/Angle globals
// for a plain square room instead of loading a Level. Turn to aim a fixed
// center-screen crosshair at targets popping up around the room and fire
// before they expire; hits score a point and the target respawns
// somewhere else, a miss (timeout) costs nothing but the target itself.

#define GALLERY_ROOM_SIZE 14
#define MAX_TARGETS 3
#define GALLERY_TIME_MS 45000UL
#define TARGET_MARGIN 1.5f // keep targets this far from the room walls, in tiles

struct Target {
  bool active;
  float x, y; // world pixel position, same units as playerX/Y
  unsigned long expiresAtMs;
};
static Target targets[MAX_TARGETS];
static int galleryScore = 0;
static unsigned long galleryEndAtMs = 0;
static unsigned long galleryTargetLifetimeMs = 3000UL;
static float galleryTurnSpeedCur = 1.3f;

static void spawnTarget(int i, unsigned long now) {
  float half = GALLERY_ROOM_SIZE / 2.0f - TARGET_MARGIN;
  // Targets only ever spawn in front of where the player starts facing
  // (+X, since playerAngle begins at 0 -- see setupGalleryRoom), never
  // behind: a 180 degree arc you can sweep with left/right, not a full
  // 360 you have to spin all the way around to clear.
  float tx = (GALLERY_ROOM_SIZE / 2.0f) + (mazeRngRange(1001) / 1000.0f) * half;
  float ty = (GALLERY_ROOM_SIZE / 2.0f) + (mazeRngRange(2001) / 1000.0f - 1.0f) * half;
  targets[i].x = tx * TILE_SIZE;
  targets[i].y = ty * TILE_SIZE;
  targets[i].active = true;
  targets[i].expiresAtMs = now + galleryTargetLifetimeMs;
}

static void setupGalleryRoom() {
  curW = GALLERY_ROOM_SIZE;
  curH = GALLERY_ROOM_SIZE;
  for (int r = 0; r < curH; r++)
    for (int c = 0; c < curW; c++)
      grid[r][c] = (r == 0 || c == 0 || r == curH - 1 || c == curW - 1) ? T_WALL : T_FLOOR;
  playerX = tileCenterX(curW / 2);
  playerY = tileCenterY(curH / 2);
  playerAngle = 0;
}

static void enterGalleryTitle() {
  gameState = ST_GALLERY_TITLE;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_LASER, 20, 14, "TARGET RUSH");
  ptc(COL_TEXT, 4, 38, "Left/Right: aim");
  pt(4, 47, "A or B: shoot");
  pt(4, 56, "Hit targets before");
  pt(4, 65, "they vanish!");
  pt(4, 90, "45 second rounds");
  pt(4, 98, "Mode: ");
  canvas->print(kSpeedTierNames[g_variant]);
  pt(4, 108, "Left/Right: change mode");
  canvas->setCursor(4, 118);
  animPrompt("A/Start: play  B: back");
  drawBestLine(1, 26);
