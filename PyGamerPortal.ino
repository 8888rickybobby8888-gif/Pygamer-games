// Runs its own tiny input loop (setup() has the display up but loop() has not started). Returns true
// ONLY when the user explicitly confirmed formatting; every other exit (B / Select / Start, or 30 s
// without a new button press) returns false = play without storage. Bounded: it cannot hang the boot.
static bool stoRecoveryScreen(bool blank) {
  const uint32_t kSkip = ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_SELECT | ARCADA_BUTTONMASK_START;
  uint32_t prev = arcada.readButtons();   // a button already held at boot is not a press
  unsigned long lastIn = millis(), lastDraw = 0, holdT0 = 0;
  uint8_t stage = 0;
  bool armed = false;   // stage 1: A must be released once before a hold can count
  int lastSecs = -1, lastPct = -1;
  for (;;) {
    unsigned long now = millis();
    uint32_t b = arcada.readButtons();
    uint32_t pr = b & ~prev;
    prev = b;
    if (pr) lastIn = now;
    if (now - lastIn >= STO_TIMEOUT_MS) return false;
    int pct = 0;
    if (stage == 0) {
      if (pr & kSkip) return false;
      if (pr & ARCADA_BUTTONMASK_A) {
        if (blank) return true;   // factory-fresh chip with nothing on it: one press is enough
        stage = 1;
        armed = false;
        holdT0 = 0;
        lastSecs = -1;
        sfx(600, 40);
      }
    } else if (pr & kSkip) {   // second screen: B / Select / Start = back to the first
      stage = 0;
      holdT0 = 0;
      lastSecs = -1;
    } else if (!(b & ARCADA_BUTTONMASK_A)) {
      armed = true;
      holdT0 = 0;
    } else if (armed) {
      if (!holdT0) holdT0 = now ? now : 1;
      if (now - holdT0 >= STO_HOLD_MS) return true;
      lastIn = now;   // holding A counts as activity
      pct = (int)((now - holdT0) * 100UL / STO_HOLD_MS);
    }
    int secs = (int)((STO_TIMEOUT_MS - (now - lastIn) + 999UL) / 1000UL);
    if ((secs != lastSecs || pct != lastPct) && now - lastDraw >= 50) {
      lastSecs = secs;
      lastPct = pct;
      lastDraw = now;
      stoDraw(blank ? 1 : 0, stage, secs, pct);
    }
    delay(10);
  }
}

static void lvlStorageBegin() {
  Arcada_FilesystemType t = arcada.filesysBegin(ARCADA_FILESYS_QSPI);
  if (t == ARCADA_FILESYS_NONE) {
    if (Arcada_QSPI_Flash.size() == 0) {
      // no flash chip answered: nothing to protect or format
      Serial.println("Levels: no flash chip responds -- custom levels are RAM-only this session.");
      errLog(101);
    } else {
      bool blank = stoChipBlank();
      errLog(blank ? 102 : 103);
      Serial.println(blank ? "Levels: flash chip is blank (no filesystem)." : "Levels: flash chip present but its volume can't be mounted.");
      if (stoRecoveryScreen(blank)) {
        Serial.println("Levels: format confirmed by the user, formatting...");
        stoNote("Formatting...", "Please wait", 0);
        if (lvlFormatQSPIFlash()) {
          t = arcada.filesysBegin(ARCADA_FILESYS_QSPI);
        }
        if (t == ARCADA_FILESYS_NONE) { errLog(104); stoNote("Format failed  E104", "Playing without storage", 2000); }
      } else {
        Serial.println("Levels: user chose to play without storage (flash left untouched).");
      }
    }
  }
  if (t == ARCADA_FILESYS_NONE) {
    Serial.println("Levels: no usable filesystem -- custom levels are RAM-only this session.");
    s_lvlFsReady = false;
    s_lvlFsIsRam = true;
    return;
  }
  if (!arcada.exists(LVL_DIR)) {
    arcada.mkdir(LVL_DIR);
  }
  if (arcada.exists(LVL_TMP_PATH)) arcada.remove(LVL_TMP_PATH);   // leftover from an interrupted save
  usbEnsureLayout();
  s_lvlFsReady = true;
  s_lvlFsIsRam = false;
  Serial.println("Levels: filesystem ready.");
}

// --- Optional art pack: /assets/banners.bin -----------------------------------------------------
// Header (8 B): "ARB1", version u8 (=1), count u8 (games, 56), W u8 (=64), H u8 (=32); then `count`
// banners, each W*H RGB565 little-endian, row-major (4096 B). Built on the PC by tools/make_assets.py.
// Streamed: one 128 B row per read straight into the canvas; nothing is cached. Missing / short /
// wrong magic => the built-in icon is used and nothing is shown. Never touched in USB drive mode.
#define BANNER_PATH "/assets/banners.bin"
#define BANNER_W 64
#define BANNER_H 32
#define BANNER_HDR 8
static bool s_bannerOk = false;
static uint8_t s_bannerCount = 0;
static bool bannerFsOk() { return s_lvlFsReady && !s_lvlFsIsRam && !g_usbDriveMode; }
// Called once at boot (the USB drive mode reboots, so that is enough).
static void bannerProbe() {
  s_bannerOk = false;
  s_bannerCount = 0;
  if (!bannerFsOk() || !arcada.exists(BANNER_PATH)) return;
  File f = arcada.open(BANNER_PATH, O_READ);
  if (!f) return;
  uint8_t h[BANNER_HDR];
  bool ok = f.read(h, BANNER_HDR) == BANNER_HDR && memcmp(h, "ARB1", 4) == 0 && h[4] == 1 && h[5] > 0 &&
            h[6] == BANNER_W && h[7] == BANNER_H &&
            (uint32_t)f.size() >= (uint32_t)BANNER_HDR + (uint32_t)h[5] * (BANNER_W * BANNER_H * 2);
  f.close();
  if (ok) { s_bannerOk = true; s_bannerCount = h[5]; Serial.println("Assets: banner pack found"); }
}
// ---- Portal hand-made levels on the drive: /packs/portal.lvl (built by tools/make_portal_pack.py) ----
// Header 8 B: "ARPL", u8 version=1, u16 LE count, u8 0. Record i (= level index i) at 8 + i*PORTAL_REC:
// u8 w, u8 h, name[12], u8 flags, u8 pad, then w*h tile chars (row-major, stride w), the rest unused.
// Read only at level load (never per frame); never in USB drive mode / on the RAM-only fallback.
static void portalProbe() {
  s_ptlOk = false;
  s_ptlCount = 0;
  if (!bannerFsOk() || !arcada.exists(PORTAL_PACK_PATH)) return;
  File f = arcada.open(PORTAL_PACK_PATH, O_READ);
  if (!f) return;
  uint8_t h[PORTAL_HDR];
  uint32_t sz = (uint32_t)f.size();
  uint16_t n = 0;
  bool ok = f.read(h, PORTAL_HDR) == PORTAL_HDR && memcmp(h, "ARPL", 4) == 0 && h[4] == 1;
  if (ok) {
    n = (uint16_t)(h[5] | (h[6] << 8));
    ok = n >= 1 && n <= 1000 && sz >= (uint32_t)PORTAL_HDR + (uint32_t)n * PORTAL_REC;
  }
  f.close();
  if (ok) { s_ptlOk = true; s_ptlCount = n; Serial.println("Portal: level pack found"); }
}
// Loads hand-made level idx from the pack into grid[][] through the same row parser as the flash
// table. Returns false (caller falls back to a generated level) on any problem: no/short file, bad
// size, unknown tile char, not exactly one start. Stack use: 40 B row buffer.
static int portalPackLoad(int idx) {
  if (!s_ptlOk || idx < 0 || idx >= (int)s_ptlCount || !bannerFsOk()) return 0;
  File f = arcada.open(PORTAL_PACK_PATH, O_READ);
  if (!f) return 0;
  uint8_t h[2];
  uint32_t base = (uint32_t)PORTAL_HDR + (uint32_t)idx * PORTAL_REC;
  bool ok = f.seek(base) && f.read(h, 2) == 2 && h[0] >= 1 && h[0] <= MAX_GRID_COLS && h[1] >= 1 && h[1] <= MAX_GRID_ROWS &&
            f.seek(base + PORTAL_REC_HDR);
  if (ok) {
    handLevelBegin(h[0], h[1]);
    int starts = 0;
    char row[MAX_GRID_COLS];
    for (int r = 0; ok && r < curH; r++) {
      ok = f.read((uint8_t *)row, curW) == curW;
      for (int c = 0; ok && c < curW; c++) {
        if (!strchr("#N.~ISGXPD^v<>YKudlrFMTU", row[c]) || row[c] == 0) ok = false;
        else if (row[c] == 'S') starts++;
      }
      if (ok) handLevelRow(r, row);
    }
    if (ok && starts != 1) ok = false;
  }
  f.close();
  if (!ok) { Serial.print("Portal: bad pack record "); Serial.println(idx + 1); errLog(601); return 0; }
  resetLevelRuntimeState();
  return 1;
}
// Draws banner g with its top-left at (x,y). Returns false (drawing nothing) when unavailable.
static bool bannerDraw(int g, int x, int y) {
  if (!s_bannerOk || !bannerFsOk() || g < 0 || g >= s_bannerCount) return false;
  File f = arcada.open(BANNER_PATH, O_READ);
  if (!f) { s_bannerOk = false; return false; }
  uint16_t row[BANNER_W];   // 128 B on the stack
  bool ok = f.seek((uint32_t)BANNER_HDR + (uint32_t)g * (BANNER_W * BANNER_H * 2));
  for (int r = 0; ok && r < BANNER_H; r++) {
    ok = f.read((uint8_t *)row, sizeof(row)) == (int)sizeof(row);
    if (ok) canvas->drawRGBBitmap(x, y + r, row, BANNER_W, 1);
  }
  f.close();
  if (!ok) {   // short / unreadable file: wipe the partial banner and stop trying
    s_bannerOk = false;
    canvas->fillRect(x, y, BANNER_W, BANNER_H, COL_BG);
    return false;
  }
  if (!miscGetFlag(MF_ACH_ART)) { miscSetFlag(MF_ACH_ART, true); checkAchievements(); }   // "Art Lover"
  return true;
}


// Slot files. Saves alternate between two files so the previous generation is never touched until
// the new one is written and verified (Arcada has no rename): which 0 = g<g>s<s>a.lvl, 1 = ...b.lvl,
// 2 = the legacy single file g<g>s<s>.lvl written by older builds (read-only; removed on the next save).
static void lvlSlotPath(uint8_t game, uint8_t slot, int which, char *out, size_t outLen) {
  if (which >= 2) snprintf(out, outLen, LVL_DIR "/g%ds%d.lvl", (int)game, (int)slot);
  else snprintf(out, outLen, LVL_DIR "/g%ds%d%c.lvl", (int)game, (int)slot, which ? 'b' : 'a');
}
static bool s_lvlRecovered = false;   // boot found an interrupted save and fell back to the older generation

// --- Slot file format -------------------------------------------------------
// v3 (0xA7, current): [0xA7][game | verified<<7][w][h][name x8, space padded][best int32 LE]
//   followed by w*h cell bytes (row-major, stride w). best = LVL_NO_BEST when unset.
// v4 (0xA8, flash files written by the atomic saver): the v3 layout + a 2-byte trailer [generation 1..255]
//   [checksum over everything before it]; the file with the newer generation (wrap-aware) wins.
// v2 (0xA6): [0xA6][game | verified<<7][w][h] + cells -> no name ("" shows as "Custom N"), no best.
// v1 (0xA5): exactly 94 bytes written by the earliest builds, [0xA5][game][w][h]
//   followed by cells[9][10] (stride 10); migrated transparently on load.
// Every reader masks the game byte with 0x7F (bit 7 = verified); old files read as unverified.
static char lvlNameFix(char c) {
  if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-') return c;
  if (c >= 'a' && c <= 'z') return (char)(c - 32);
  return ' ';
}
static void lvlNameTrim(char *n) {
  int l = (int)strlen(n);
  while (l > 0 && n[l - 1] == ' ') n[--l] = 0;
}

static size_t lvlSerialize(const LevelData *d, uint8_t *buf) {
  int w = d->w, h = d->h;
  buf[0] = LVL_MAGIC;
  buf[1] = (uint8_t)((d->game & 0x7F) | (d->verified ? 0x80 : 0));
  buf[2] = (uint8_t)w; buf[3] = (uint8_t)h;
  int i = 0;
  for (; i < LVL_NAME_LEN && d->name[i]; i++) buf[4 + i] = (uint8_t)lvlNameFix(d->name[i]);
  for (; i < LVL_NAME_LEN; i++) buf[4 + i] = ' ';
  uint32_t b = (uint32_t)d->best;
  buf[12] = (uint8_t)b; buf[13] = (uint8_t)(b >> 8); buf[14] = (uint8_t)(b >> 16); buf[15] = (uint8_t)(b >> 24);
  size_t k = LVL_HDR;
  for (int r = 0; r < h; r++)
    for (int c = 0; c < w; c++) buf[k++] = d->cells[r][c];
  return k;
}

static uint8_t lvlChk(const uint8_t *b, size_t n) {
  uint8_t c = 0x5A;
  for (size_t i = 0; i < n; i++) c = (uint8_t)(((c << 1) | (c >> 7)) ^ b[i]);
  return c;
}

// Structural check of a raw slot file (any version); *gen = generation (0 for pre-atomic files).
static bool lvlRawOk(const uint8_t *b, size_t n, uint8_t *gen) {
  *gen = 0;
  if (n < 4) return false;
  int w = b[2], h = b[3];
  if (w < 1 || h < 1) return false;
  switch (b[0]) {
    case LVL_MAGIC_V4:
      if (w > LVL_GRID_MAXW || h > LVL_GRID_MAXH || n != (size_t)(LVL_HDR + w * h + 2) || b[n - 1] != lvlChk(b, n - 1)) return false;
      *gen = b[n - 2];
      return *gen != 0;
    case LVL_MAGIC: return w <= LVL_GRID_MAXW && h <= LVL_GRID_MAXH && n == (size_t)(LVL_HDR + w * h);
    case LVL_MAGIC_V2: return w <= LVL_GRID_MAXW && h <= LVL_GRID_MAXH && n == (size_t)(4 + w * h);
    case LVL_MAGIC_V1: return n == LVL_V1_SIZE && w <= 10 && h <= 9;
  }
  return false;
}
static bool lvlGenNewer(uint8_t a, uint8_t b) { uint8_t d = (uint8_t)(a - b); return d != 0 && d < 128; }   // wrap-aware a > b

// Reads slot file `which` (see lvlSlotPath). 0 = absent, -1 = present but unusable, 1 = valid.
#define LVL_RAWBUF (LVL_HDR + LVL_GRID_MAXW * LVL_GRID_MAXH + 4)
static int lvlFileRead(uint8_t game, uint8_t slot, int which, uint8_t *buf, size_t *n, uint8_t *gen) {
  char path[48];
  lvlSlotPath(game, slot, which, path, sizeof(path));
  *gen = 0;
  *n = 0;
  if (g_usbDriveMode) return 0;   // the PC owns the volume
  if (!arcada.exists(path)) return 0;
  File f = arcada.open(path, O_READ);
  if (!f) return -1;
  int rn = f.read(buf, LVL_RAWBUF);
  f.close();
  if (rn < 4) return -1;
  *n = (size_t)rn;
  return lvlRawOk(buf, *n, gen) ? 1 : -1;
}

static bool lvlDeserialize(const uint8_t *buf, size_t n, LevelData *out) {
  if (n < 4) return false;
  int w = buf[2], h = buf[3];
  if (w < 1 || h < 1) return false;
  memset(out, 0, sizeof(LevelData));
  out->best = LVL_NO_BEST;
  if (buf[0] == LVL_MAGIC_V1) {            // old fixed 10x9 layout
    if (n != LVL_V1_SIZE || w > 10 || h > 9) return false;
    for (int r = 0; r < h; r++)
      for (int c = 0; c < w; c++) out->cells[r][c] = buf[4 + r * 10 + c];
  } else if (buf[0] == LVL_MAGIC_V2) {
    if (w > LVL_GRID_MAXW || h > LVL_GRID_MAXH || n != (size_t)(4 + w * h)) return false;
    for (int r = 0; r < h; r++)
      for (int c = 0; c < w; c++) out->cells[r][c] = buf[4 + r * w + c];
    out->verified = (uint8_t)(buf[1] >> 7);
  } else if (buf[0] == LVL_MAGIC || buf[0] == LVL_MAGIC_V4) {
    size_t tail = (buf[0] == LVL_MAGIC_V4) ? 2 : 0;
    if (w > LVL_GRID_MAXW || h > LVL_GRID_MAXH || n != (size_t)(LVL_HDR + w * h) + tail) return false;
    if (tail && buf[n - 1] != lvlChk(buf, n - 1)) return false;
    for (int r = 0; r < h; r++)
      for (int c = 0; c < w; c++) out->cells[r][c] = buf[LVL_HDR + r * w + c];
    out->verified = (uint8_t)(buf[1] >> 7);
    for (int i = 0; i < LVL_NAME_LEN; i++) out->name[i] = lvlNameFix((char)buf[4 + i]);
    out->name[LVL_NAME_LEN] = 0;
    lvlNameTrim(out->name);
    out->best = (int32_t)((uint32_t)buf[12] | ((uint32_t)buf[13] << 8) | ((uint32_t)buf[14] << 16) | ((uint32_t)buf[15] << 24));
  } else {
    return false;
  }
  out->magic = LVL_MAGIC;
  out->game = buf[1] & 0x7F;
  out->w = (uint8_t)w;
  out->h = (uint8_t)h;
  return lvlSanitize(out);
}

// RAM fallback pool entry: [game][slot] + serialized bytes (2 + LVL_HDR + w*h bytes total).
static uint16_t lvlRamEntrySize(int off) { return (uint16_t)(2 + LVL_HDR + s_lvlRamPool[off + 4] * s_lvlRamPool[off + 5]); }
static int lvlRamFind(uint8_t game, uint8_t slot) {
  uint16_t off = 0;
  while (off < s_lvlRamUsed) {
    if (s_lvlRamPool[off] == game && s_lvlRamPool[off + 1] == slot) return (int)off;
    off += lvlRamEntrySize(off);
  }
  return -1;
}

static void lvlRamRemove(int off) {
  uint16_t sz = lvlRamEntrySize(off);
  memmove(s_lvlRamPool + off, s_lvlRamPool + off + sz, s_lvlRamUsed - off - sz);
  s_lvlRamUsed -= sz;
}

static bool lvlSaveSlot(uint8_t game, uint8_t slot, const LevelData *data) {
  if (slot >= LVL_SLOTS || data->w < 1 || data->h < 1) return false;
  uint8_t buf[LVL_HDR + LVL_GRID_MAXW * LVL_GRID_MAXH + 2];
  size_t len = lvlSerialize(data, buf);
  buf[1] = (uint8_t)((buf[1] & 0x80) | (game & 0x7F));
  if (s_lvlFsIsRam || !s_lvlFsReady) {
    int off = lvlRamFind(game, slot);
    uint16_t freed = off >= 0 ? lvlRamEntrySize(off) : 0;
    if (s_lvlRamUsed - freed + 2 + len > LVL_RAM_POOL) return false;
    if (off >= 0) lvlRamRemove(off);
    s_lvlRamPool[s_lvlRamUsed] = game;
    s_lvlRamPool[s_lvlRamUsed + 1] = slot;
    memcpy(s_lvlRamPool + s_lvlRamUsed + 2, buf, len);
    s_lvlRamUsed += (uint16_t)(2 + len);
    return true;
  }
  if (g_usbDriveMode) return false;
  // Atomic save: write the NEW generation to the file that does not hold the current valid one,
  // verify it by re-reading, and only then delete the old generation(s). A failure at any point
  // leaves the previous generation untouched and loadable.
  if (!arcada.exists(LVL_DIR)) arcada.mkdir(LVL_DIR);
  uint8_t scratch[LVL_RAWBUF];
  size_t sn;
  uint8_t ga, gb;
  int ra = lvlFileRead(game, slot, 0, scratch, &sn, &ga);
  int rb = lvlFileRead(game, slot, 1, scratch, &sn, &gb);
  int target = 0;
  uint8_t curGen = 0;
  if (ra == 1 && rb == 1) { bool bn = lvlGenNewer(gb, ga); target = bn ? 0 : 1; curGen = bn ? gb : ga; }
  else if (ra == 1) { target = 1; curGen = ga; }
  else if (rb == 1) { target = 0; curGen = gb; }
  uint8_t newGen = (uint8_t)(curGen >= 255 ? 1 : curGen + 1);
  buf[0] = LVL_MAGIC_V4;
  buf[len] = newGen;
  buf[len + 1] = lvlChk(buf, len + 1);
  len += 2;
  char path[48];
  lvlSlotPath(game, slot, target, path, sizeof(path));
  bool ok = false;
  for (int attempt = 0; attempt < 2 && !ok; attempt++) {
    if (arcada.exists(path)) arcada.remove(path);
    File t = arcada.open(path, O_WRITE | O_CREAT | O_TRUNC);
    if (!t) continue;
    size_t tn = t.write(buf, len);
    t.close();
    if (tn != len) continue;
    File r = arcada.open(path, O_READ);
    if (!r) continue;
    bool same = true;
    uint8_t chk[32];
    size_t pos = 0;
    while (same && pos < len) {
      size_t want = len - pos < sizeof(chk) ? len - pos : sizeof(chk);
      int got = r.read(chk, want);
      if (got != (int)want || memcmp(chk, buf + pos, want) != 0) same = false;
      pos += want;
    }
    r.close();
    ok = same;
  }
  if (!ok) {   // previous generation (other file / legacy file) is still in place
    if (arcada.exists(path)) arcada.remove(path);
    return false;
  }
  for (int w = 0; w < 3; w++) {   // drop the old generation and any legacy single file
    if (w == target) continue;
    char op[48];
    lvlSlotPath(game, slot, w, op, sizeof(op));
    if (arcada.exists(op)) arcada.remove(op);
  }
  return true;
}

static bool lvlLoadSlot(uint8_t game, uint8_t slot, LevelData *out) {
  if (slot == LVL_TEMP_SLOT) {   // editor Test Play: the in-RAM work copy, never persisted
    if (s_lvlWork.magic != LVL_MAGIC || s_lvlWork.game != game) return false;
    *out = s_lvlWork;
    return true;
  }
  if (slot > LVL_TEMP_SLOT) return false;
  if (s_lvlFsIsRam || !s_lvlFsReady) {
    uint8_t buf[LVL_RAWBUF];
    int off = lvlRamFind(game, slot);
    if (off < 0) return false;
    size_t n = lvlRamEntrySize(off) - 2;
    memcpy(buf, s_lvlRamPool + off + 2, n);
    if (!lvlDeserialize(buf, n, out)) return false;
    return out->game == game;
  }
  // Flash: the valid file with the newer generation wins; an unreadable one falls back to the other,
  // then to a legacy single-file slot.
  uint8_t bufA[LVL_RAWBUF], bufB[LVL_RAWBUF];
  size_t na, nb;
  uint8_t ga, gb;
  int ra = lvlFileRead(game, slot, 0, bufA, &na, &ga);
  int rb = lvlFileRead(game, slot, 1, bufB, &nb, &gb);
  const uint8_t *c1 = NULL, *c2 = NULL;
  size_t n1 = 0, n2 = 0;
  if (ra == 1 && rb == 1) {
    if (lvlGenNewer(gb, ga)) { c1 = bufB; n1 = nb; c2 = bufA; n2 = na; }
    else { c1 = bufA; n1 = na; c2 = bufB; n2 = nb; }
  } else if (ra == 1) { c1 = bufA; n1 = na; }
  else if (rb == 1) { c1 = bufB; n1 = nb; }
  if (c1 && lvlDeserialize(c1, n1, out) && out->game == game) return true;
  if (c2 && lvlDeserialize(c2, n2, out) && out->game == game) return true;
  uint8_t gl;
  size_t nl;
  if (lvlFileRead(game, slot, 2, bufA, &nl, &gl) != 1) return false;
  if (!lvlDeserialize(bufA, nl, out)) return false;
  return out->game == game;   // a file whose game byte disagrees with its slot is rejected
}

static void lvlDeleteSlot(uint8_t game, uint8_t slot) {
  if (slot >= LVL_SLOTS) return;
  if (s_lvlFsIsRam || !s_lvlFsReady) {
    int off = lvlRamFind(game, slot);
    if (off >= 0) lvlRamRemove(off);
    return;
  }
  if (g_usbDriveMode) return;
  for (int w = 0; w < 3; w++) {   // both generations + the legacy file
    char path[48];
    lvlSlotPath(game, slot, w, path, sizeof(path));
    if (arcada.exists(path)) arcada.remove(path);
  }
}

// True when any file / RAM entry exists for the slot (valid or not).
static bool lvlSlotAny(uint8_t game, uint8_t slot) {
  if (s_lvlFsIsRam || !s_lvlFsReady) return lvlRamFind(game, slot) >= 0;
  if (g_usbDriveMode) return false;
  for (int w = 0; w < 3; w++) {
    char path[48];
    lvlSlotPath(game, slot, w, path, sizeof(path));
    if (arcada.exists(path)) return true;
  }
  return false;
}

// Number of slot files / RAM entries on the device (Settings "Delete levels").
static int lvlCountAllSaved() {
  int n = 0;
  for (int g = 0; g < LVL_NUM_GAMES; g++)
    for (int sl = 0; sl < LVL_SLOTS; sl++)
      if (lvlSlotAny((uint8_t)g, (uint8_t)sl)) n++;
  return n;
}

// Boot fix-up for saves made before the "games with saved levels" mask existed (or before it
// grew to 32 bits): rebuilds it from the slot files that are on the device.
static void lvlSavedSync() {
  // empty mask: rebuild everything (also after a Reset: level files stay on disk);
  // otherwise only the games the 32-bit widening added (24+)
  for (int g = (lvlSavedMask() != 0 ? 24 : 0); g < LVL_NUM_GAMES; g++)
    for (int sl = 0; sl < LVL_SLOTS; sl++)
      if (lvlSlotAny((uint8_t)g, (uint8_t)sl)) { lvlSavedSet(g); break; }
}

// Boot cleanup after an interrupted save: where both generation files exist, keep the newer valid
// one (or the only valid one) and delete the other. Falling back to the older generation sets
// s_lvlRecovered (toast "Level recovered" when the picker first shows). Only games in the
// saved-levels mask are scanned, so the boot stays fast.
static void lvlRecoverScan() {
  if (s_lvlFsIsRam || !s_lvlFsReady || g_usbDriveMode) return;
  uint32_t mask = lvlSavedMask();
  uint8_t sc[LVL_RAWBUF];
  for (int g = 0; g < LVL_NUM_GAMES; g++) {
    if (!((mask >> g) & 1u)) continue;
    for (int sl = 0; sl < LVL_SLOTS; sl++) {
      char pa[48], pb[48];
      lvlSlotPath((uint8_t)g, (uint8_t)sl, 0, pa, sizeof(pa));
      lvlSlotPath((uint8_t)g, (uint8_t)sl, 1, pb, sizeof(pb));
      if (!arcada.exists(pa) || !arcada.exists(pb)) continue;
      size_t n;
      uint8_t ga, gb;
      int ra = lvlFileRead((uint8_t)g, (uint8_t)sl, 0, sc, &n, &ga);
      int rb = lvlFileRead((uint8_t)g, (uint8_t)sl, 1, sc, &n, &gb);
      if (ra == 1 && rb == 1) arcada.remove(lvlGenNewer(gb, ga) ? pa : pb);   // delete of the old one was interrupted
      else if (ra == 1) { arcada.remove(pb); s_lvlRecovered = true; }         // new write never finished: older kept
      else if (rb == 1) { arcada.remove(pa); s_lvlRecovered = true; }
    }
  }
}

// --- Persistent save file (/arcadia/save.bin) ---------------------------------
#define SAVE_DIR "/arcadia"
#define SAVE_PATH "/arcadia/save.bin"

static void saveDefaults() {
  memset(&g_save, 0, sizeof(g_save));
  g_save.magic = SAVE_MAGIC;
  g_save.version = SAVE_VERSION;
  for (int g = 0; g < SAVE_MAX_GAMES; g++)
    for (int t = 0; t < SAVE_TIERS; t++) g_save.best[g][t] = SAVE_NO_SCORE;
  saveExtDefaults();
  miscDefaults();
  g_save.volume = 2;
  memset(g_save.recent, 0xFF, sizeof(g_save.recent));
}

#define SAVE_EXT_PATH "/arcadia/save_ext.bin"
// Loads the extension file (games 40+). Missing/short/invalid -> defaults (old saves have none).
static void saveExtLoad() {
  saveExtDefaults();
  if (s_lvlFsIsRam || !s_lvlFsReady) return;
  if (!arcada.exists(SAVE_EXT_PATH)) return;
  File f = arcada.open(SAVE_EXT_PATH, O_READ);
  if (!f) return;
  static SaveExt tmpExt;
  memset(&tmpExt, 0, sizeof(tmpExt));
  size_t n = f.read((uint8_t *)&tmpExt, sizeof(SaveExt));
  f.close();
  if (n == sizeof(SaveExt) && tmpExt.magic == SAVE_EXT_MAGIC && tmpExt.version == SAVE_EXT_VERSION) {
    memcpy(&g_saveExt, &tmpExt, sizeof(SaveExt));
    Serial.println("Saves: ext loaded");
  }
}

#define SAVE_MISC_PATH "/arcadia/save_misc.bin"
// Loads the third file. Missing / short (< SAVE_MISC_MIN) / bad magic -> defaults. A file shorter
// than the full struct keeps zeros for the tail; a longer one is truncated.
static void saveMiscLoad() {
  miscDefaults();
  if (s_lvlFsIsRam || !s_lvlFsReady) return;
  if (!arcada.exists(SAVE_MISC_PATH)) return;
  File f = arcada.open(SAVE_MISC_PATH, O_READ);
  if (!f) return;
  SaveMisc tmpMisc;   // on the stack (640 B) to keep static RAM down
  memset(&tmpMisc, 0, sizeof(tmpMisc));
  int n = f.read((uint8_t *)&tmpMisc, sizeof(SaveMisc));
  f.close();
  if (n >= SAVE_MISC_MIN && tmpMisc.magic == SAVE_MISC_MAGIC && tmpMisc.version == SAVE_MISC_VERSION) {
    memcpy(&g_saveMisc, &tmpMisc, sizeof(SaveMisc));
    if (g_saveMisc.mixBest > 3 * MIX_COUNT + 1) g_saveMisc.mixBest = 0;
    if (g_saveMisc.mixLast > 3 * MIX_COUNT + 1) g_saveMisc.mixLast = 0;
    if (LVL_NUM_GAMES < 32) g_saveMisc.lvlSavedMask2 &= (1UL << LVL_NUM_GAMES) - 1UL;
    if (miscGetField(MF_HUBFOCUS_SHIFT, 3) > 2) miscSetField(MF_HUBFOCUS_SHIFT, 3, 0);
    Serial.println("Saves: misc loaded");
  }
}

static bool s_miscMigrating = false;   // migration just ran this session and save_misc.bin is not yet confirmed written

static void saveLoad() {
  saveDefaults();
  if (s_lvlFsIsRam || !s_lvlFsReady || g_usbDriveMode) {
    Serial.println("Saves: RAM only");
    return;
  }
  if (!arcada.exists(SAVE_DIR)) arcada.mkdir(SAVE_DIR);
  // save.bin may be missing/unreadable: the ext and misc files are still loaded below so a
  // surviving save_misc.bin is never overwritten by defaults.
  File f;
  if (!arcada.exists(SAVE_PATH)) Serial.println("Saves: none yet");
  else f = arcada.open(SAVE_PATH, O_READ);
  if (f) {
    static SaveData tmp;
    memset(&tmp, 0, sizeof(tmp));
    size_t n = f.read((uint8_t *)&tmp, sizeof(SaveData));
    f.close();
    // Accept the old 744-byte layout too: the fields appended later keep the
    // defaults saveDefaults() already put in g_save.
    if (n >= SAVE_V1_SIZE && tmp.magic == SAVE_MAGIC && tmp.version == SAVE_VERSION) {
      memcpy(&g_save, &tmp, n);
      if (g_save.volume > 2) g_save.volume = 2;
      if (g_save.bootMode > 1) g_save.bootMode = 0;
      if (g_save.lastPlayed >= NUM_GAMES) g_save.lastPlayed = 0;
      for (int i = 0; i < 6; i++)
        if (g_save.recent[i] != 0xFF && g_save.recent[i] >= NUM_GAMES) g_save.recent[i] = 0xFF;
      g_save.miscFlags &= 31;
      if (g_save.pad[0] > 2) g_save.pad[0] = 0;
      Serial.println("Saves: loaded");
    } else {
      Serial.println("Saves: invalid file, starting fresh");
      errLog(206);
    }
  }
  saveExtLoad();
  saveMiscLoad();
  bool wasMigrated = miscGetFlag(MF_LVL_MIGRATED);
  saveMiscMigrate();
  g_mixLastTotal = (int8_t)((int)g_saveMisc.mixLast - 1);
  g_mixBestTotal = (int8_t)((int)g_saveMisc.mixBest - 1);
  trophySyncSilent();
  if (!wasMigrated) {   // persist the moved mask (misc file is written first)
    s_miscMigrating = true;
    saveWrite();
  }
}

static void saveWrite() {
  if (s_lvlFsIsRam || !s_lvlFsReady || g_usbDriveMode) return;
  if (!arcada.exists(SAVE_DIR)) arcada.mkdir(SAVE_DIR);
  {   // SaveMisc first: while migrating, the mask must be safe before the old copies are dropped
    bool miscOk = false;
    File fm = arcada.open(SAVE_MISC_PATH, O_WRITE | O_CREAT | O_TRUNC);
    if (fm) {
      size_t nm = fm.write((const uint8_t *)&g_saveMisc, sizeof(SaveMisc));
      fm.close();
      miscOk = (nm == sizeof(SaveMisc));
    }
    if (!miscOk) {
      Serial.println("Saves: misc write failed");
      errLog(202);
      // while migrating, save.bin/save_ext.bin still hold the only copy of the saved-levels bits
      if (s_miscMigrating) { Serial.println("Saves: kept old files"); return; }
    } else {
      s_miscMigrating = false;
    }
  }
  File f = arcada.open(SAVE_PATH, O_WRITE | O_CREAT | O_TRUNC);
  if (!f) {
    Serial.println("Saves: write failed (open)");
    errLog(201);
    return;
  }
  size_t n = f.write((const uint8_t *)&g_save, sizeof(SaveData));
  f.close();
  Serial.println(n == sizeof(SaveData) ? "Saves: saved" : "Saves: write failed");
  if (n != sizeof(SaveData)) errLog(201);
  File fe = arcada.open(SAVE_EXT_PATH, O_WRITE | O_CREAT | O_TRUNC);
  if (fe) {
    size_t ne = fe.write((const uint8_t *)&g_saveExt, sizeof(SaveExt));
    fe.close();
    if (ne != sizeof(SaveExt)) { Serial.println("Saves: ext write failed"); errLog(203); }
  } else {
    Serial.println("Saves: ext write failed");
    errLog(203);
  }
}

// --- Automatic backups (/arcadia/bak/) -----------------------------------------------------------
// A copy of the three save files, taken before USB drive mode and before the destructive Settings
// rows, so a bad PC edit or an accidental reset can be undone with Settings -> "Restore backup".
// Copies run in 128-byte chunks (no big buffers). Arcada has no rename, so a copy is: validate the
// source (size + magic), remove the old destination, write, then verify the length; a copy that does
// not verify is removed again and reported as failed. No RTC exists, so there is no timestamp.
#define BAK_DIR "/arcadia/bak"
static const char *bakLive(int i) { return i == 0 ? SAVE_PATH : (i == 1 ? SAVE_EXT_PATH : SAVE_MISC_PATH); }
static const char *bakCopy(int i) {
  return i == 0 ? BAK_DIR "/save.bin" : (i == 1 ? BAK_DIR "/save_ext.bin" : BAK_DIR "/save_misc.bin");
}
static uint32_t bakMagic(int i) { return i == 0 ? SAVE_MAGIC : (i == 1 ? SAVE_EXT_MAGIC : SAVE_MISC_MAGIC); }
static uint32_t bakMinSize(int i) { return i == 0 ? SAVE_V1_SIZE : (i == 1 ? sizeof(SaveExt) : SAVE_MISC_MIN); }
static uint32_t bakMaxSize(int i) { return i == 0 ? sizeof(SaveData) : (i == 1 ? sizeof(SaveExt) : sizeof(SaveMisc)); }

// Copies src -> dst (kind = which save file, for the sanity check). True only if dst verifies.
// The old dst is left alone when src is missing or fails the check. At most 7 chunks (<= 776 bytes).
static bool bakCopyFile(const char *src, const char *dst, int kind) {
  File in = arcada.open(src, O_READ);
  if (!in) return false;
  uint32_t total = (uint32_t)in.size();
  if (total < bakMinSize(kind) || total > bakMaxSize(kind)) {
    in.close();
    return false;
  }
  uint8_t buf[128];
  uint32_t done = 0;
  bool ok = false, touched = false;
  File out;
  for (int guard = 0; guard < 16; guard++) {
    uint32_t want = total - done;
    if (want > sizeof(buf)) want = sizeof(buf);
    if (want == 0) {
      ok = true;
      break;
    }
    if (in.read(buf, want) != (int)want) break;
    if (done == 0) {
      uint32_t m;
      memcpy(&m, buf, 4);
      if (m != bakMagic(kind)) break;
      if (arcada.exists(dst)) arcada.remove(dst);
      touched = true;
      out = arcada.open(dst, O_WRITE | O_CREAT | O_TRUNC);
      if (!out) break;
    }
    if (out.write(buf, want) != want) break;
    done += want;
  }
  in.close();
  if (out) out.close();
  if (ok) {
    File v = arcada.open(dst, O_READ);
    ok = v && (uint32_t)v.size() == total;
    if (v) v.close();
  }
  if (!ok && touched && arcada.exists(dst)) arcada.remove(dst);   // never leave a half file
  return ok;
}

// Backs up whatever save files exist. Returns how many were copied; silently 0 on a RAM-only volume.
static int bakAll() {
  if (s_lvlFsIsRam || !s_lvlFsReady || g_usbDriveMode) return 0;
  if (!arcada.exists(BAK_DIR)) arcada.mkdir(BAK_DIR);
  int n = 0;
  for (int i = 0; i < 3; i++)
    if (arcada.exists(bakLive(i)) && bakCopyFile(bakLive(i), bakCopy(i), i)) n++;
  Arcada_QSPI_Flash.syncBlocks();
  return n;
}

// Before "Reset saves": flush RAM to the files, then back up - unless nothing was ever played, so a
// second reset cannot replace a good backup with an empty one.
static void bakBeforeReset() {
  bool any = false;
  for (int g = 0; g < NUM_GAMES && !any; g++)
    if (savePlays(g) > 0) any = true;
  if (!any) return;
  saveWrite();
  bakAll();
}

static bool bakExists() {
  if (s_lvlFsIsRam || !s_lvlFsReady || g_usbDriveMode) return false;
  for (int i = 0; i < 3; i++)
    if (arcada.exists(bakCopy(i))) return true;
  return false;
}

// Settings -> Restore backup (second A). Copies the backups over the live files and reboots. From the
// first copy on g_usbDriveMode is set, so no code path can write the RAM state over the restored files
// (no saveWrite() before the reset). If anything fails, the flag is cleared and the intact RAM state is
// written back out so the files are consistent again; returns to the caller only in that case.
static void bakRestoreAndReboot() {
  if (s_lvlFsIsRam || !s_lvlFsReady || g_usbDriveMode) {
    errToast(105);
    sfxBlocked();
    return;
  }
  g_usbDriveMode = true;
  int n = 0, bad = 0;
  for (int i = 0; i < 3; i++) {
    if (!arcada.exists(bakCopy(i))) continue;
    if (bakCopyFile(bakCopy(i), bakLive(i), i)) n++;
    else bad++;
  }
  if (n > 0 && bad == 0) usbFinish();   // "Rebooting..." then NVIC_SystemReset(): does not return
  g_usbDriveMode = false;
  if (n > 0 || bad > 0) saveWrite();   // failure: rewrite all three live files from RAM
  errToast(bad > 0 ? 108 : 109);
  sfxBlocked();
}

// --- USB drive mode (Settings -> USB drive) -----------------------------------
// Exposes the QSPI FAT volume to a PC through Arcada's TinyUSB mass-storage callbacks. While it
// is on, g_usbDriveMode blocks every file access in the game; the only way out is a reboot, so
// the saves / levels / caches reload from whatever the PC left on the volume. RAM state is
// deliberately NOT written back on exit (that would overwrite files the user just restored).
extern Adafruit_SPIFlash Arcada_QSPI_Flash;   // owned by Adafruit_Arcada_Filesystem.cpp
#if defined(USE_TINYUSB)
#define USB_PC_MOUNTED() (USBDevice.mounted())
#else
#define USB_PC_MOUNTED() (false)
#endif
static uint8_t s_usbPage = 0;        // 0 = confirm page, 1 = drive is on
static unsigned long s_usbT0 = 0;    // when the drive was switched on

static void usbCenter(int y, const char *t, uint16_t col) {
  ptc(col, (160 - (int)strlen(t) * 6) / 2, y, t);
}

static void usbDrawScreen() {
  bool on = (s_usbPage == 1);
  bool pc = on && USB_PC_MOUNTED();
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  usbCenter(4, on ? "USB DRIVE ON" : "USB DRIVE MODE", COL_ORANGE);
  // PC monitor (left) <-- dots --> flash drive (right)
  canvas->drawRect(18, 19, 26, 18, COL_TEXT);
  canvas->fillRect(20, 21, 22, 14, animBlend(COL_BG, COL_ICE, pc ? 150 : 60));
  canvas->fillRect(28, 37, 6, 3, COL_TEXT);
  canvas->fillRect(24, 40, 14, 2, COL_TEXT);
  canvas->fillRect(112, 22, 30, 16, COL_WALL_NOPORTAL);
  canvas->drawRect(112, 22, 30, 16, COL_TEXT);
  canvas->fillRect(116, 26, 10, 8, animBlend(COL_BG, COL_TEXT, 120));
  uint16_t led = on ? (pc ? animBlend(COL_GOAL, COL_BG, (uint8_t)(animPulse(500) / 2)) : animBlend(COL_KEY, COL_BG, (uint8_t)(animPulse(900) / 2)))
                    : animBlend(COL_BG, COL_TEXT, 80);
  canvas->fillRect(134, 28, 5, 5, led);
  if (on) {
    int ph = (int)((millis() / 90UL) % 6UL);
    bool act = arcada.recentUSB(300);
    for (int k = 0; k < 6; k++) {
      int x = 52 + k * 9;
      bool hot = pc && (k == ph || (act && ((k + ph) & 1)));
      canvas->fillRect(x, 29, 4, 4, hot ? COL_GOAL : animBlend(COL_BG, COL_TEXT, pc ? 90 : 50));
    }
    usbCenter(50, pc ? "PC connected" : "Connect USB to PC", pc ? COL_GOAL : COL_KEY);
    if (act) usbCenter(62, "Disk activity", COL_ICE);
    usbCenter(78, "Eject it on the PC first,", COL_TEXT);
    usbCenter(88, "then press B.", COL_TEXT);
    usbCenter(112, "B/Select: finish & reboot", animBlend(COL_TEXT, COL_ICE, animPulse(900)));
  } else {
    usbCenter(50, "The games pause while", COL_TEXT);
    usbCenter(60, "your PC can see the files.", COL_TEXT);
    usbCenter(76, "Eject it on the PC before", COL_KEY);
    usbCenter(86, "you leave. Game reboots.", COL_KEY);
    usbCenter(112, "A: start   B: cancel", COL_TEXT);
  }
  blitScreen();
}

static void usbOpen() {
  s_usbPage = 0;
  gameState = ST_USBDRIVE;
  sfx(600, 40);
  usbDrawScreen();
}

// A on the confirm page. Persists the current RAM state, makes sure the layout exists, then
// hands the volume to the PC. On failure nothing is changed and we return to Settings.
static void usbStart() {
  if (s_lvlFsIsRam || !s_lvlFsReady) {
    errToast(105);
  } else {
    s_lvlPackPlay = false;   // (the PC is about to own the volume: no pack run may survive)
    miscSetFlag(MF_ACH_USB, true);
    checkAchievements();   // "Plugged In" (writes the save file itself when something unlocks)
    saveWrite();           // last write before the PC takes over
    usbEnsureLayout();
    if (bakAll() > 0) toastShow("Backup saved");   // safety copy of the save files in /arcadia/bak
    g_usbDriveMode = true;
    if (arcada.filesysBeginMSD(ARCADA_FILESYS_QSPI)) {
      s_usbPage = 1;
      s_usbT0 = millis();
      sfx(880, 60);
      usbDrawScreen();
      return;
    }
    g_usbDriveMode = false;
    errToast(106);
  }
  sfxBlocked();
  gameState = ST_SETTINGS;
  drawSettingsScreen();
}

static void usbFinish() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  usbCenter(60, "Rebooting...", COL_ORANGE);
  blitScreen();
  sfx(440, 60);
  Arcada_QSPI_Flash.syncBlocks();   // flush anything the host left in the flash cache
  delay(350);
#if defined(USE_TINYUSB)
  USBDevice.detach();
#endif
  delay(150);
  NVIC_SystemReset();
}

static void usbUpdate(uint32_t pressed) {
  if (s_usbPage == 0) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) usbStart();
    else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_SETTINGS;
      drawSettingsScreen();
    }
  } else if (millis() - s_usbT0 > 700 && (pressed & (ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_START))) {
    usbFinish();
  }
}

// --- Diagnostics (Settings -> Diagnostics) ------------------------------------------------------
// Two live pages for checking the hardware and the memory budget. Page 1: raw buttons, joystick,
// accelerometer. Page 2: light/backlight, battery, free RAM, uptime, storage, USB. Left/Right flips
// page; holding B or Start for 1 s leaves. Select is deliberately NOT an alias for B here (it is not
// in loop()'s Select->B list) so it can be seen lighting its box. Buttons are drawn from the raw
// device-frame mask (s_prevButtons), before any portrait remap or alias.
extern FatFileSystem Arcada_QSPI_FileSys;
static uint8_t s_diagPage = 0;
static bool s_diagArm = false;            // false until B/Start have been released once since opening
static unsigned long s_diagHoldT0 = 0;    // when the B/Start hold began (0 = not holding)
static int32_t s_diagFreeKB = -1;         // volume free / total KB, measured when the page opens (-1 = n/a)
static int32_t s_diagTotKB = 0;

static void diagOpen() {
  s_diagPage = 0;
  s_diagArm = false;
  s_diagHoldT0 = 0;
  s_diagFreeKB = -1;
  if (!s_lvlFsIsRam && s_lvlFsReady && !g_usbDriveMode) {
    int32_t fc = Arcada_QSPI_FileSys.freeClusterCount();
    uint32_t bpc = Arcada_QSPI_FileSys.bytesPerCluster();
    if (fc >= 0 && bpc > 0) {
      s_diagFreeKB = (int32_t)(((uint32_t)fc * bpc) >> 10);
      s_diagTotKB = (int32_t)(((uint32_t)Arcada_QSPI_FileSys.clusterCount() * bpc) >> 10);
    }
  }
  miscSetFlag(MF_ACH_DIAG, true);
  gameState = ST_DIAG;
  sfx(600, 40);
  checkAchievements();   // "Mechanic"
  diagDraw();
}

static void diagUpdate(uint32_t buttons, uint32_t pressed) {
  if (pressed & (ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT)) {
    s_diagPage = (uint8_t)((s_diagPage + ((pressed & ARCADA_BUTTONMASK_RIGHT) ? 1 : 2)) % 3);
    sfxMove();
  }
  if (!(buttons & (ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_START))) {
    s_diagArm = true;
    s_diagHoldT0 = 0;
  } else if (s_diagArm) {
    unsigned long now = millis();
    if (!s_diagHoldT0) s_diagHoldT0 = now ? now : 1;
    else if (now - s_diagHoldT0 >= 1000) {
      s_diagHoldT0 = 0;
      sfx(300, 30);
      gameState = ST_SETTINGS;
      drawSettingsScreen();
    }
  }
}

static void diagBox(int x, const char *t, bool on) {
  canvas->fillRect(x, 13, 18, 11, on ? COL_GOAL : COL_BG);
  if (!on) canvas->drawRect(x, 13, 18, 11, animBlend(COL_BG, COL_TEXT, 110));
  ptc(on ? COL_BG : COL_TEXT, x + (18 - (int)strlen(t) * 6) / 2, 15, t);
}

// "+0.98" style, no float printf (newlib-nano)
static void diagFmtG(char *out, size_t n, float g) {
  int v = (int)lroundf(g * 100.0f);
  char sg = v < 0 ? '-' : '+';
  if (v < 0) v = -v;
  if (v > 9999) v = 9999;
  snprintf(out, n, "%c%d.%02d", sg, v / 100, v % 100);
}

static void diagAccelRow(int y, char axis, float g, int16_t raw) {
  char gs[10], l[24];
  diagFmtG(gs, sizeof(gs), g);
  snprintf(l, sizeof(l), "%c %sg", axis, gs);
  ptc(COL_TEXT, 4, y, l);
  snprintf(l, sizeof(l), "%d", (int)raw);
  pt(54, y, l);
  canvas->drawRect(96, y - 1, 62, 9, animBlend(COL_BG, COL_TEXT, 90));
  int w = (int)(g * 15.0f);
  if (w > 29) w = 29;
  if (w < -29) w = -29;
  if (w > 0) canvas->fillRect(127, y, w, 7, COL_GOAL);
  else if (w < 0) canvas->fillRect(127 + w, y, -w, 7, COL_KEY);
  canvas->drawFastVLine(127, y - 1, 9, COL_TEXT);
}

static void diagKB(char *out, size_t n, uint32_t bytes) {   // "12.3K"
  snprintf(out, n, "%lu.%luK", (unsigned long)(bytes >> 10), (unsigned long)(((bytes & 1023UL) * 10UL) >> 10));
}

static void diagDraw() {
  char l[40], a[12], b[12];
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_ORANGE);
  canvas->setCursor(4, 2);
  snprintf(l, sizeof(l), "DIAGNOSTICS %d/3", (int)s_diagPage + 1);
  canvas->print(l);
  uint32_t m = s_prevButtons;   // raw held mask of this frame
  diagBox(1, "A", m & ARCADA_BUTTONMASK_A);
  diagBox(21, "B", m & ARCADA_BUTTONMASK_B);
  diagBox(41, "ST", m & ARCADA_BUTTONMASK_START);
  diagBox(61, "SE", m & ARCADA_BUTTONMASK_SELECT);
  diagBox(81, "<", m & ARCADA_BUTTONMASK_LEFT);
  diagBox(101, ">", m & ARCADA_BUTTONMASK_RIGHT);
  diagBox(121, "^", m & ARCADA_BUTTONMASK_UP);
  diagBox(141, "v", m & ARCADA_BUTTONMASK_DOWN);
  canvas->setTextColor(COL_TEXT);
  if (s_diagPage == 0) {
    int jx = arcada.readJoystickX(), jy = arcada.readJoystickY();
    snprintf(l, sizeof(l), "Joy X %+4d", jx);
    pt(4, 29, l);
    snprintf(l, sizeof(l), "Joy Y %+4d", jy);
    pt(4, 39, l);
    bool ctr = abs(jx) <= 60 && abs(jy) <= 60;
    ptc(ctr ? COL_GOAL : COL_KEY, 4, 49, ctr ? "Stick: centered" : "Stick: off center");
    canvas->drawRect(126, 27, 32, 32, animBlend(COL_BG, COL_TEXT, 110));   // stick position
    canvas->drawFastHLine(127, 43, 30, animBlend(COL_BG, COL_TEXT, 60));
    canvas->drawFastVLine(142, 28, 30, animBlend(COL_BG, COL_TEXT, 60));
    canvas->fillRect(142 + (jx * 13) / 512 - 1, 43 + (jy * 13) / 512 - 1, 3, 3, ctr ? COL_GOAL : COL_KEY);
    float ax, ay;
    tiltReadXY(ax, ay);   // also refreshes arcada.accel's x/y/z
    if (arcada.accel) {
      diagAccelRow(64, 'X', arcada.accel->x_g, arcada.accel->x);
      diagAccelRow(74, 'Y', arcada.accel->y_g, arcada.accel->y);
      diagAccelRow(84, 'Z', arcada.accel->z_g, arcada.accel->z);
    } else {
      ptc(COL_KEY, 4, 70, "Accelerometer: n/a");
    }
    canvas->setTextColor(COL_TEXT);
    diagFmtG(a, sizeof(a), ax);
    diagFmtG(b, sizeof(b), ay);
    snprintf(l, sizeof(l), "Maze: ax %s ay %s", a, b);
    pt(4, 94, l);
    ptc(COL_ICE, 4, 103, "Right edge down: ax +");
    pt(4, 111, "Bottom edge down: ay +");
  } else if (s_diagPage == 2) {
    diagExtPage();
  } else {
    uint16_t light = arcada.readLightSensor();
    snprintf(l, sizeof(l), "Light raw: %u", (unsigned)light);
    pt(4, 28, l);
    snprintf(l, sizeof(l), "Backlight: %d %s", (int)s_backlightLevel, s_brightnessMode == 0 ? "AUTO" : "MANUAL");
    pt(4, 38, l);
    float v = arcada.readBatterySensor();
    if (isnan(v)) snprintf(l, sizeof(l), "Battery: n/a");
    else snprintf(l, sizeof(l), "Battery: %d.%02d V", (int)v, (int)(v * 100.0f + 0.5f) % 100);
    pt(4, 48, l);
    diagKB(a, sizeof(a), freeRamNow());
    snprintf(l, sizeof(l), "RAM free: %s", a);
    pt(4, 58, l);
    diagKB(a, sizeof(a), g_minFreeRam);
    snprintf(l, sizeof(l), "RAM min:  %s", a);
    pt(4, 68, l);
    unsigned long up = millis() / 1000UL;
    snprintf(l, sizeof(l), "Up %lu:%02lu  Loop %lu.%lu ms", up / 60UL, up % 60UL, (unsigned long)(g_loopAvgUs / 1000UL),
             (unsigned long)((g_loopAvgUs % 1000UL) / 100UL));
    pt(4, 78, l);
    pt(4, 88, s_lvlFsIsRam || !s_lvlFsReady ? "Disk: RAM only (no FS)" : "Disk: mounted");
    if (s_diagFreeKB >= 0) snprintf(l, sizeof(l), "Free %ld of %ld KB", (long)s_diagFreeKB, (long)s_diagTotKB);
    else snprintf(l, sizeof(l), s_lvlFsIsRam ? "Free: n/a" : "Free: ok");
    pt(4, 98, l);
    pt(4, 108, USB_PC_MOUNTED() ? "USB PC: connected" : "USB PC: not connected");
  }
  ptc(COL_ICE, 4, 118, "L/R page  hold B/ST: exit");
  if (s_diagHoldT0) {
    unsigned long held = millis() - s_diagHoldT0;
    if (held > 1000) held = 1000;
    canvas->fillRect(0, 126, (int)(held * 160UL / 1000UL), 2, COL_KEY);
  }
  blitScreen();
}

// --- Level editor: shared engine -------------------------------------------
//
// One editor + Levels menu reused by every level game, parameterized per game
// by a row of kLevelGames[]. The grid is a generic byte buffer (up to
// LVL_GRID_MAXW x LVL_GRID_MAXH = 16x16); per-game code maps the raw tile ids
// into that game's own arrays/variables.
//
// HOW TO ADD A LEVEL GAME (the contract):
//  1. Append a LevelGameId (and bump LVL_NUM_GAMES + the s_lvlActiveSlot
//     initializer) near LevelData at the top of the file.
//  2. Add a tile-colour array (filled in lvlInitColors(): COL_* are runtime
//     values, never use them in static initializers) and a tile-name array
//     (<= 7 chars each), then one LevelGameConfig row below: title, w, h
//     (grid extents; the editor auto-scales cells to fit, cellPx is only the
//     MAX px), numTiles, tileColors, tileShortNames, defaultTile, validate fn,
//     titleFn (enter*Title), playFn (enter*Playing), flags (LVLF_1D = single
//     row layout). Tile 0 should usually be the empty/default tile.
//  3. Write `bool xValidateLevel(const LevelData*, char *msg, size_t)` (return
//     false + a <= 26 char reason to block Test Play / Save) and
//     `void xLoadCustom(const LevelData*)`; read lvl->w/h and lvl->cells[r][c]
//     (2D, no stride assumptions). Declare the validate fn with the others.
//  4. In enter*Playing(): if (s_lvlActiveSlot[game] >= 0) { LevelData lvl;
//     if (lvlLoadSlot(game, s_lvlActiveSlot[game], &lvl)) xLoadCustom(&lvl);
//     else s_lvlActiveSlot[game] = -1; }  -- the editor's Test Play uses the
//     reserved slot LVL_TEMP_SLOT (the in-RAM work copy) through this same path.
//  5. Title screen: on Up set s_lvlCurGame = <id>; s_lvlMenuSel = 0;
//     gameState = ST_LEVEL_MENU; drawLvlPickMenu();
//  6. Add the game's OVER/TITLE states to kLvlOverState/kLvlTitleState so Test
//     Play returns to the editor (pause "Back to Editor" is automatic).
//  7. Optional: tools/make_packs.py can emit /packs/g<id>.pak for the game (format: see "Level packs" below);
//     pack play reuses steps 3-6 unchanged (it goes through the same temp slot + lvlOnClear + Over/Title states).

typedef bool (*LevelValidateFn)(const LevelData *lvl, char *msg, size_t msgLen);

#define LVLF_1D 1   // single-row level (editor draws a tall strip, Up/Down unused)
#define LVLF_HBARS 2 // 1D level whose tiles are heights 0..8 (9 = pad): editor/thumbnails draw bars

typedef struct {
  const char *title;
  uint8_t w, h, cellPx;     // grid extents; cellPx = preferred (max) cell size
  uint8_t numTiles;
  const uint16_t *tileColors;
  const char *const *tileShortNames;
  uint8_t defaultTile;
  LevelValidateFn validate; // may be NULL for no validation
  EnterPlayingFn titleFn;   // this game's enter*Title()
  EnterPlayingFn playFn;    // this game's enter*Playing()
  uint8_t flags;            // LVLF_*
} LevelGameConfig;

