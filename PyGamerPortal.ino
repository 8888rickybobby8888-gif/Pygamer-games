// The game is decided (winnerColor 0/1 or -1 for a draw): scoreboard + hi-score now, the over screen follows.
static void chsFinish(int winnerColor, uint8_t why) {
  int w = 3;
  if (winnerColor >= 0) w = (winnerColor == chsP1Side()) ? 1 : 2;
  chsWinner = (int8_t)w;
  chsEndWhy = why;
  int m = chsVsCpu ? 0 : 1;
  chsSb[m][w == 1 ? 0 : (w == 2 ? 1 : 2)]++;
  bool hadSave = miscGetFlag(MF_CHESS_SAVED), wrote = false;
  if (hadSave) chsSaveClear();   // the game is over: nothing to resume
  if (chsVsCpu) {
    if (w == 1 && !chsHinted) {   // a hint cancels the result
      wrote = true;
      int margin = (chsMaterial(0) - chsMaterial(1)) / 100;
      if (margin < 0) margin = 0;
      if (margin > 40) margin = 40;
      recordResult(54, g_variant, 100L + 10L * (long)(g_variant & 3) + (long)margin, true);
    } else {
      s_lastNewBest = false;
      s_lastNewBestGame = 54;
    }
  } else {
    chsP1White = !chsP1White;   // colours swap for the rematch
    if (chsClockMode && w != 3) { miscSetFlag(MF_ACH_CLOCK, true); checkAchievements(); }   // "Clock Watcher"
  }
  if (hadSave && !wrote) saveWrite();
  chsSel = -1;
  chsDest = 0;
  chsUndoOk = false;
  chsPromoPick = false;
  chsEnding = true;
  chsEndAt = millis() + 700UL;
}

static void chsToOver() {
  if (chsWinner == 3) sfx(300, 100);
  else if (chsVsCpu && chsWinner == 2) sfxDeath();
  else { sfxWin(); pixelsWinCelebration(); }
  gameState = ST_CHESS_OVER;
  drawChsOverScreen();
}

// Plays a legal move on the real board: animation, sounds, history, then the next turn.
static void chsApply(uint16_t m, bool byCpu) {
  unsigned long now = millis();
  int from = m & 63, to = (m >> 6) & 63, fl = m >> 12;
  int mover = chsSide;
  bool isCap = (fl & 4) != 0;
  int victim = (fl == 5) ? 1 : (chsB[chsSq88(to)] & 7);
  if (chsPly < 12) chsPlyMv[chsPly] = (uint16_t)(m & 0xFFF);
  if (chsPly < 255) chsPly++;
  chsHintUntil = 0;
  chsMake(m);
  chsHistPush(chsHash(), chsHalf == 0);
  chsLastFrom = (int8_t)from;
  chsLastTo = (int8_t)to;
  chsAnimFrom = (int8_t)from;
  chsAnimTo = (int8_t)to;
  chsAnimT0 = now ? now : 1UL;
  chsBusyUntil = now + 230UL;
  chsSel = -1;
  chsDest = 0;
  int sx = chsSqX(to), sy = chsSqY(to);
  bool chk = chsAttacked(chsKing[chsSide], chsSide ^ 1);
  if (fl & 8) {
    sfx(1100, 70);
    particlesBurst(sx, sy, 12, mover ? chsPcBo : chsPcW);
  } else if (isCap) {
    sfx(220 + 40 * (victim > 4 ? 4 : victim), 45);
    particlesBurst(sx, sy, 8, mover ? chsPcW : chsPcB);
    if (victim >= 4) screenShake(120, 2);
  } else if (fl == 2 || fl == 3) {
    sfx(640, 30);
    particlesBurst(sx, sy, 6, COL_KEY);
  } else {
    sfx(byCpu ? 420 : 500, 25);
  }
  if (chk) { sfx(900, 60); pixelsFlashAsync(255, 60, 0, 60); }
  chsBeginTurn();
  if (++chsAutoCnt >= 6) chsAutoCnt = 0;
  if (!chsEnding && chsAutoCnt == 0 && !g_mixActive && !g_challengeSeed) { chsSaveStore(); saveWrite(); }   // periodic autosave
}

static void chsSnapshot() {   // 2 PLAYERS: position before the move that is about to be played
  memcpy(chsUBd, chsB, sizeof(chsB));
  chsUEp = chsEp; chsUKing[0] = chsKing[0]; chsUKing[1] = chsKing[1];
  chsUSide = chsSide; chsUCastle = chsCastle; chsUHalf = chsHalf;
  chsUHistN = chsHistN; chsUHistBase = chsHistBase;
  chsULF = chsLastFrom; chsULT = chsLastTo;
}
static void chsUndo() {
  memcpy(chsB, chsUBd, sizeof(chsB));
  chsEp = chsUEp; chsKing[0] = chsUKing[0]; chsKing[1] = chsUKing[1];
  chsSide = chsUSide; chsCastle = chsUCastle; chsHalf = chsUHalf;
  chsHistN = chsUHistN; chsHistBase = chsUHistBase;
  chsLastFrom = chsULF; chsLastTo = chsULT;
  chsUndoOk = false;
  if (chsPly) chsPly--;
  chsAutoCnt = (uint8_t)((chsAutoCnt + 5) % 6);
  chsHintUntil = 0;
  chsAnimFrom = chsAnimTo = -1;
  chsBusyUntil = millis() + 220UL;
  sfx(400, 60);
  chsBeginTurn();
}

// The human's from -> to (promoType 0 = not a promotion). False if it is not a legal move.
static bool chsTryMove(int from, int to, int promoType) {
  uint16_t lm[224];
  int n = chsLegal(lm, 224);
  for (int i = 0; i < n; i++) {
    uint16_t m = lm[i];
    if ((m & 63) != from || ((m >> 6) & 63) != to) continue;
    int fl = m >> 12;
    if ((fl & 8) && 2 + (fl & 3) != promoType) continue;
    if (!chsVsCpu) { chsSnapshot(); chsUndoOk = true; }
    chsApply(m, false);
    return true;
  }
  return false;
}

static void chsSelect(int s) {
  chsSel = (int8_t)s;
  chsDest = 0;
  uint16_t lm[224];
  int n = chsLegal(lm, 224);
  for (int i = 0; i < n; i++) if ((lm[i] & 63) == s) chsDest |= 1ULL << ((lm[i] >> 6) & 63);
  sfx(700, 15);
}

// Best move of a 3-ply search shown for 2 s. Not on EXTREME (vs CPU); using it cancels the score.
static void chsHint() {
  if (chsVsCpu && (g_variant & 3) == 3) { toastShow("No hints on EXTREME"); sfxBlocked(); return; }
  if (chsSel >= 0 || chsPromoPick) { sfxBlocked(); return; }
  uint16_t m = chsCpuPick(2);
  if (!m) { sfxBlocked(); return; }
  chsHintFrom = (int8_t)(m & 63);
  chsHintTo = (int8_t)((m >> 6) & 63);
  chsHintUntil = millis() + 2000UL;
  chsHinted = true;
  sfx(900, 30);
}
static void chsReplayLast(unsigned long now) {   // nothing selected: replay the last move's glide
  if (chsLastTo < 0) return;
  chsAnimFrom = chsLastFrom;
  chsAnimTo = chsLastTo;
  chsAnimT0 = now ? now : 1UL;
  sfx(600, 20);
}

static void chsFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  if (chsEnding) {
    if (now >= chsEndAt) { chsToOver(); return; }
    drawChsScene(now);
    blitScreen();
    return;
  }
  bool busy = now < chsBusyUntil;
  bool startTap = false;
  {   // a Start TAP (released within 500 ms) is Undo (2 PLAYERS) or Hint (vs CPU); holding it is the pause gesture
    bool sd = (buttons & ARCADA_BUTTONMASK_START) != 0;
    if (now - chsLastFrameMs > 150UL) { chsStartArmed = false; chsStartDown = false; }   // first frame / resumed from pause
    if (!sd) chsStartArmed = true;
    if ((pressed & ARCADA_BUTTONMASK_START) && chsStartArmed && !chsStartDown) { chsStartDown = true; chsStartT0 = now; }
    else if (!sd && chsStartDown) { chsStartDown = false; startTap = (now - chsStartT0 < (unsigned long)PAUSE_HOLD_MS); }   // tap window ends where the pause hold begins
    pressed &= ~(uint32_t)ARCADA_BUTTONMASK_START;
  }
  if (!chsVsCpu && chsClockMode && chsLastFrameMs && now - chsLastFrameMs <= 150UL) {   // clock of the side to move (pause / long searches are not counted)
    chsClockMs[chsSide] -= (int32_t)(now - chsLastFrameMs);
    if (chsClockMs[chsSide] <= 0) {
      chsClockMs[chsSide] = 0;
      chsLastFrameMs = now;
      chsFinish(chsSide ^ 1, 6);
      drawChsScene(now);
      blitScreen();
      return;
    }
  }
  chsLastFrameMs = now;
  if (startTap) chsTapPending = true;          // a tap released during the busy window waits for it to end
  if (chsVsCpu && chsSide == 1) {
    // CPU's turn: human input is ignored until it has played.
    chsTapPending = false;
    if (!busy && (long)(now - chsCpuAt) >= 0) {
      uint16_t m = ((g_variant & 3) >= 2) ? chsBookMove() : 0;   // HARD / EXTREME: opening book first
      if (m) chsBookUsed = true;
      else m = chsCpuPick(g_variant & 3);
      if (m == 0) chsFinish(-1, 2);            // (cannot happen: the turn start checked for moves)
      else chsApply(m, true);
    }
  } else if (!busy) {
    int dr = 0, dc = 0;
    bool edge = true;
    if (pressed & ARCADA_BUTTONMASK_LEFT) dc = -1;
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) dc = 1;
    else if (pressed & ARCADA_BUTTONMASK_UP) dr = -1;
    else if (pressed & ARCADA_BUTTONMASK_DOWN) dr = 1;
    else edge = false;
    if (edge) {
      chsRepT = now + 220UL;
    } else if ((long)(now - chsRepT) >= 0) {    // held D-pad: cursor auto-repeat
      if (buttons & ARCADA_BUTTONMASK_LEFT) dc = -1;
      else if (buttons & ARCADA_BUTTONMASK_RIGHT) dc = 1;
      else if (buttons & ARCADA_BUTTONMASK_UP) dr = -1;
      else if (buttons & ARCADA_BUTTONMASK_DOWN) dr = 1;
      if (dr || dc) chsRepT = now + 90UL;
    }
    if (chsBPend) {   // 2 PLAYERS, B with nothing selected: tap = replay the last move, hold ~0.5 s = hint
      if (!(buttons & ARCADA_BUTTONMASK_B)) { chsBPend = false; chsReplayLast(now); }
      else if (now - chsBT0 >= 500UL) { chsBPend = false; chsHint(); }
    }
    if (chsTapPending && chsVsCpu && (chsSel >= 0 || chsPromoPick)) {   // with a piece / promotion open, a Start tap still confirms like A
      chsTapPending = false;
      pressed |= ARCADA_BUTTONMASK_A;
    }
    if (chsTapPending) {
      chsTapPending = false;
      if (chsVsCpu) chsHint();
      else if (chsUndoOk && !chsPromoPick) chsUndo();
      else sfxBlocked();
    } else if (chsPromoPick) {
      if (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_LEFT)) { chsPromoIdx = (uint8_t)((chsPromoIdx + 3) % 4); sfxMove(); }
      else if (pressed & (ARCADA_BUTTONMASK_DOWN | ARCADA_BUTTONMASK_RIGHT)) { chsPromoIdx = (uint8_t)((chsPromoIdx + 1) % 4); sfxMove(); }
      else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
        chsPromoPick = false;
        if (!chsTryMove(chsPromoFrom, chsPromoTo, kChsPromoTypes[chsPromoIdx])) sfxBlocked();
      } else if (pressed & ARCADA_BUTTONMASK_B) {
        chsPromoPick = false;
        sfx(300, 15);
      }
    } else if (dr || dc) {
      int nr = (int)chsCr + dr, nc = (int)chsCc + dc;
      if (nr >= 0 && nr < 8 && nc >= 0 && nc < 8) { chsCr = (uint8_t)nr; chsCc = (uint8_t)nc; sfxMove(); }
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      int rank = chsViewFlip ? (int)chsCr : 7 - (int)chsCr;      // cursor cell -> real square
      int file = chsViewFlip ? 7 - (int)chsCc : (int)chsCc;
      int s = rank * 8 + file;
      if (chsSel >= 0 && ((chsDest >> s) & 1ULL)) {
        int pc = chsB[chsSq88(chsSel)] & 7;
        if (pc == 1 && (rank == 0 || rank == 7)) {   // a promotion: ask which piece
          chsPromoFrom = chsSel;
          chsPromoTo = (int8_t)s;
          chsPromoIdx = 0;
          chsPromoPick = true;
          sfx(800, 20);
        } else if (!chsTryMove(chsSel, s, 0)) {
          sfxBlocked();
        }
      } else if (s == chsSel) {
        chsSel = -1;
        chsDest = 0;
        sfx(300, 15);
      } else if ((chsMovable >> s) & 1ULL) {
        chsSelect(s);
      } else {
        sfxBlocked();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      if (chsSel >= 0) { chsSel = -1; chsDest = 0; sfx(300, 15); }
      else if (!chsVsCpu) { chsBPend = true; chsBT0 = now; }
      else chsReplayLast(now);
    }
  }
  if (!chsEnding) {                            // (chsApply/chsBeginTurn may have ended the game)
    drawChsScene(now);
    blitScreen();
  }
}

// --- Tilt Slalom ----------------------------------------------------------------------
//
// A skier races down a snowy course that scrolls toward the player; tilt the PyGamer left/right
// to steer (the same accelerometer axes and the same Settings "Tilt: Normal/Invert" as Tilt Maze,
// via tiltReadXY; the D-pad always works too). Pass through every gate (between its two poles) to
// build a streak; rocks, trees and (tiers 1-3) crossing skiers are in the way. Missing a gate only
// resets the streak; hitting an obstacle costs one of 3 lives (1.3 s of invincibility follows a crash). Score: 10 per gate
// + 2 per streak step (max +40) + 5 for a clean pass through the middle. Before every run the
// device is calibrated (hold still for 0.5 s: that angle becomes "straight"; A skips it). The
// course comes only from the round seed and distance travelled, so 2P player 2 faces the same one.

#define TSL_SKY 100          // skier's screen row
#define TSL_MAXG 6
#define TSL_MAXO 10
static const float kTslBase[4] = {80.0f, 105.0f, 62.0f, 120.0f};          // start speed px/s (NORMAL SPEED CHILL EXTREME)
static const float kTslRamp[4] = {0.020f, 0.026f, 0.013f, 0.032f};        // px/s gained per px travelled
static const float kTslLat[4] = {150.0f, 170.0f, 135.0f, 175.0f};         // max sideways speed px/s
static const float kTslGain[4] = {300.0f, 330.0f, 260.0f, 360.0f};        // px/s of sideways speed per g of tilt
static const uint8_t kTslGateW[4] = {30, 26, 36, 22};                     // gate half-width

static float tslS, tslX, tslVX, tslNeutral, tslNextD, tslLastD, tslLastGx, tslCalRef, tslCalSum;
static float tslGd[TSL_MAXG], tslGx[TSL_MAXG], tslOd[TSL_MAXO], tslOx[TSL_MAXO];
static uint8_t tslGw[TSL_MAXG], tslGst[TSL_MAXG], tslOt[TSL_MAXO];   // gate state: 0 ahead 1 passed 2 missed; obstacle type 0 rock 1 tree 2 crossing skier
static int8_t tslOv[TSL_MAXO];                                       // crossing skier: sideways direction (+1 / -1)
// Ghost of the best seeded run (SaveMisc.ghost): [0] tier+1 (0 = none), [1..2] seed hash, [3..4] score,
// [5] sample count (<= 180), [6..95] one 4-bit x sample (10 px steps) per 120 ms, two per byte.
#define TSL_GN 180
static uint8_t tslRec[TSL_GN / 2];
static uint8_t tslRecN;
static uint32_t tslRunMs;
static uint16_t tslSeedH, tslGhostScore;
static bool tslGhostOn, tslSeeded;
static int tslNG, tslNO, tslLives, tslScore, tslStreak, tslBest, tslGates, tslCalN, tslTier, tslPopV;
static uint8_t tslPh;                                                // 0 calibrating, 1 running, 2 crashed out
static bool tslHasAccel;
static unsigned long tslInvUntil, tslCalT0, tslCalStart, tslEndAt, tslPopT0;
static int16_t tslPopX, tslPopY;
static uint16_t tslColSnow, tslColSnow2, tslColHud, tslColInk, tslColRock, tslColTree, tslColSki;

// x of obstacle i right now. A crossing skier drifts 0.4 px per px of descent and is at tslOx[i] when it reaches the
// skier's row: a function of distance only, so it is identical in 2P replays and never blocks the whole course.
static float tslObsX(int i) {
  if (tslOt[i] != 2) return tslOx[i];
  float x = tslOx[i] + (float)tslOv[i] * 0.4f * (tslS - tslOd[i]);
  return x < 6.0f ? 6.0f : (x > 154.0f ? 154.0f : x);
}
static uint8_t tslGhostQ(int i) {
  uint8_t b = g_saveMisc.ghost[6 + (i >> 1)];
  return (i & 1) ? (uint8_t)(b >> 4) : (uint8_t)(b & 15);
}

static float tslSpeedAt(float d) {
  float v = kTslBase[tslTier] + kTslRamp[tslTier] * d;
  float cap = kTslBase[tslTier] * 2.0f;
  return v > cap ? cap : v;
}

// Appends the next gate (and up to two obstacles between the previous gate and it).
static void tslGenNext() {
  float d = tslNextD, prevD = tslLastD, prevGx = tslLastGx;
  float spacing = d - prevD;
  float v = tslSpeedAt(d);
  float ms = kTslLat[tslTier] * (spacing / v) * 0.5f;     // how far the player can reasonably get sideways in that time
  if (ms > 60.0f) ms = 60.0f;
  int w = kTslGateW[tslTier];
  float gx = prevGx + (float)(mazeRngRange(2 * (int)ms + 1) - (int)ms);
  float lo = (float)(w + 8), hi = (float)(160 - w - 8);
  if (gx < lo) gx = lo;
  if (gx > hi) gx = hi;
  if (tslNG < TSL_MAXG) {
    tslGd[tslNG] = d;
    tslGx[tslNG] = gx;
    tslGw[tslNG] = (uint8_t)w;
    tslGst[tslNG] = 0;
    tslNG++;
  }
  if (prevD > 0.0f) {   // obstacles in the gap, kept clear of the straight line between the two gates
    int chance = 45 + (int)(d / 60.0f);
    if (chance > 85) chance = 85;
    for (int k = 0; k < 2; k++) {
      if (mazeRngRange(100) >= (k == 0 ? chance : chance / 2)) continue;
      float fr = 0.3f + (float)mazeRngRange(41) / 100.0f;
      float od = prevD + spacing * fr;
      float line = prevGx + (gx - prevGx) * fr;
      for (int tries = 0; tries < 4; tries++) {
        float ox = (float)(10 + mazeRngRange(141));
        if (fabsf(ox - line) < 26.0f) continue;
        int t = mazeRngRange(2);
        int8_t dv = 0;
        if (tslTier >= 1 && mazeRngRange(100) < 35) { t = 2; dv = mazeRngRange(2) ? 1 : -1; }
        if (tslNO < TSL_MAXO) {
          tslOd[tslNO] = od;
          tslOx[tslNO] = ox;
          tslOt[tslNO] = (uint8_t)t;
          tslOv[tslNO] = dv;
          tslNO++;
        }
        break;
      }
    }
  }
  tslLastD = d;
  tslLastGx = gx;
  tslNextD = d + 64.0f + (float)mazeRngRange(24);
}

static void enterTslTitle() {
  gameState = ST_SLALOM_TITLE;
  drawStdTitle("TILT SLALOM", COL_ICE, "Tilt (or D-pad) to steer", "Pass gates, dodge rocks", "Hold still to calibrate", 55);
}

static void tslBeginRun() {
  tslPh = 1;
  s_lastFrameMs = 0;
  sfx(700, 40);
}

static void enterTslPlaying() {
  uint32_t tslSeed = gameSeed();
  s_mazeRng = tslSeed;
  tslTier = g_variant & 3;
  tslSeedH = (uint16_t)((tslSeed >> 16) ^ tslSeed);
  tslSeeded = g_twoPlayerMode || g_challengeSeed || g_userSeed;   // only repeatable courses get a ghost
  tslRunMs = 0;
  tslRecN = 0;
  tslGhostScore = 0;
  tslGhostOn = tslSeeded && g_saveMisc.ghost[0] == (uint8_t)(tslTier + 1) &&
               g_saveMisc.ghost[1] == (uint8_t)(tslSeedH & 255) && g_saveMisc.ghost[2] == (uint8_t)(tslSeedH >> 8) &&
               g_saveMisc.ghost[5] >= 2 && g_saveMisc.ghost[5] <= TSL_GN;
  if (tslGhostOn) tslGhostScore = (uint16_t)(g_saveMisc.ghost[3] | (g_saveMisc.ghost[4] << 8));
  tslColSnow = arcada.display->color565(206, 220, 238);
  tslColSnow2 = arcada.display->color565(170, 190, 220);
  tslColHud = arcada.display->color565(22, 32, 64);
  tslColInk = arcada.display->color565(20, 30, 60);
  tslColRock = arcada.display->color565(96, 100, 112);
  tslColTree = arcada.display->color565(30, 120, 64);
  tslColSki = arcada.display->color565(255, 150, 30);
  tslS = 0.0f;
  tslX = 80.0f;
  tslVX = 0.0f;
  tslNeutral = 0.0f;
  tslNG = 0;
  tslNO = 0;
  tslLastD = 0.0f;
  tslLastGx = 80.0f;
  tslNextD = 110.0f;
  tslLives = 3;
  tslScore = 0;
  tslStreak = 0;
  tslBest = 0;
  tslGates = 0;
  tslInvUntil = 0;
  tslPopT0 = 0;
  tslPopV = 0;
  tslEndAt = 0;
  while (tslNextD < 170.0f) tslGenNext();
  tslHasAccel = (arcada.accel != NULL);
  tslCalN = 0;
  tslCalSum = 0.0f;
  tslCalRef = 0.0f;
  tslCalT0 = tslCalStart = millis();
  s_lastFrameMs = 0;
  gameState = ST_SLALOM_PLAYING;
  if (tslHasAccel) tslPh = 0;
  else tslBeginRun();   // no accelerometer: D-pad only, no calibration
}

static void drawTslScene(unsigned long now) {
  canvas->fillScreen(tslColSnow);
  int sc = (int)tslS;
  for (int i = 0; i < 14; i++) {   // snow flecks scrolling past
    int x = (i * 47 + 13) % 156;
    int y = ((i * 29) % 128 + sc) % 128;
    canvas->fillRect(x, y, 3, 1, tslColSnow2);
  }
  for (int i = 0; i < tslNG; i++) {
    int sy = TSL_SKY - (int)(tslGd[i] - tslS);
    if (sy < -14 || sy > 142) continue;
    int gx = (int)tslGx[i], w = tslGw[i];
    uint16_t cl = tslGst[i] == 1 ? COL_GOAL : (tslGst[i] == 2 ? tslColInk : COL_LASER);
    uint16_t cr = tslGst[i] == 1 ? COL_GOAL : (tslGst[i] == 2 ? tslColInk : COL_BLUE);
    if (tslGst[i] == 0) for (int x = gx - w + 4; x < gx + w - 3; x += 6) canvas->drawPixel(x, sy, tslColSnow2);
    canvas->fillRect(gx - w - 1, sy - 8, 3, 16, tslColInk);
    canvas->fillRect(gx + w - 1, sy - 8, 3, 16, tslColInk);
    canvas->fillTriangle(gx - w + 2, sy - 8, gx - w + 2, sy - 1, gx - w + 9, sy - 4, cl);
    canvas->fillTriangle(gx + w - 2, sy - 8, gx + w - 2, sy - 1, gx + w - 9, sy - 4, cr);
  }
  for (int i = 0; i < tslNO; i++) {
    int sy = TSL_SKY - (int)(tslOd[i] - tslS);
    if (sy < -10 || sy > 138) continue;
    int ox = (int)tslObsX(i);
    if (tslOt[i] == 2) {   // crossing skier: leans into its direction of travel
      int ln = tslOv[i] * 3;
      canvas->drawLine(ox - 2 - ln, sy - 5, ox - 2 + ln, sy + 6, tslColInk);
      canvas->drawLine(ox + 2 - ln, sy - 5, ox + 2 + ln, sy + 6, tslColInk);
      canvas->fillCircle(ox, sy - 1, 4, COL_BLUE);
      canvas->fillCircle(ox, sy - 6, 2, tslColInk);
    } else if (tslOt[i] == 0) {
      canvas->fillCircle(ox, sy, 5, tslColRock);
      canvas->drawCircle(ox, sy, 5, tslColInk);
      canvas->drawPixel(ox - 2, sy - 2, COL_TEXT);
    } else {
      canvas->fillRect(ox - 1, sy + 3, 3, 4, tslColInk);
      canvas->fillTriangle(ox - 6, sy + 4, ox + 6, sy + 4, ox, sy - 8, tslColTree);
      canvas->fillTriangle(ox - 4, sy - 1, ox + 4, sy - 1, ox, sy - 8, lightenColor(tslColTree, 0.35f));
    }
  }
  if (tslGhostOn && tslPh == 1) {   // translucent skier replaying the stored best run
    int gi = (int)(tslRunMs / 120UL);
    int gn = g_saveMisc.ghost[5];
    if (gi + 1 < gn && gi + 1 < TSL_GN) {
      float fr = (float)(tslRunMs - (uint32_t)gi * 120UL) / 120.0f;
      float q0 = (float)tslGhostQ(gi) * 10.0f + 5.0f, q1 = (float)tslGhostQ(gi + 1) * 10.0f + 5.0f;
      int gx = (int)(q0 + (q1 - q0) * fr);
      uint16_t gc = animBlend(tslColSnow, tslColSki, 110);
      canvas->drawCircle(gx, TSL_SKY - 1, 4, gc);
      canvas->drawLine(gx - 2, TSL_SKY - 5, gx - 2, TSL_SKY + 7, gc);
      canvas->drawLine(gx + 2, TSL_SKY - 5, gx + 2, TSL_SKY + 7, gc);
    }
  }
  bool blink = (now < tslInvUntil) && (((now / 80UL) & 1UL) != 0);
  if (tslPh != 2 && !blink) {
    int x = (int)tslX;
    int lean = (int)(tslVX / 40.0f);
    if (lean > 4) lean = 4;
    if (lean < -4) lean = -4;
    canvas->drawLine(x - 2 - lean, TSL_SKY - 5, x - 2 + lean, TSL_SKY + 7, tslColInk);
    canvas->drawLine(x + 2 - lean, TSL_SKY - 5, x + 2 + lean, TSL_SKY + 7, tslColInk);
    canvas->fillCircle(x, TSL_SKY - 1, 4, tslColSki);
    canvas->fillCircle(x, TSL_SKY - 6, 2, COL_TEXT);
  }
  if (tslPopT0 && now - tslPopT0 < 600UL) {   // "+N" floating up from the gate just passed
    char pb[8];
    snprintf(pb, sizeof(pb), "+%d", tslPopV);
    canvas->setTextSize(1);
    ptc(tslColInk, tslPopX, tslPopY - (int)((now - tslPopT0) / 40UL), pb);
  }
  particlesUpdateDraw();
  // HUD
  canvas->fillRect(0, 0, 160, 12, tslColHud);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  canvas->setCursor(3, 2);
  char hb[16];
  snprintf(hb, sizeof(hb), "SCORE %d", tslScore);
  canvas->print(hb);
  if (tslStreak > 1) {
    snprintf(hb, sizeof(hb), "x%d", tslStreak);
    ptc(COL_KEY, 86, 2, hb);
  }
  for (int i = 0; i < 3; i++) {
    if (i < tslLives) canvas->fillCircle(130 + i * 11, 6, 3, COL_LASER);
    else canvas->drawCircle(130 + i * 11, 6, 3, COL_WALL);
  }
}

static void drawTslCal(unsigned long now) {
  canvas->fillScreen(tslColSnow);
  canvas->setTextSize(1);
  ptc(tslColInk, 28, 22, "CALIBRATING TILT");
  pt(4, 40, "Hold the PyGamer still,");
  pt(4, 50, "tilted how you like it.");
  int w = (int)((now - tslCalT0) * 100UL / 500UL);
  if (w > 100) w = 100;
  if (w < 0) w = 0;
  canvas->drawRect(29, 66, 102, 10, tslColInk);
  canvas->fillRect(30, 67, w, 8, COL_GOAL);
  pt(4, 90, "A: skip   Select: pause");
  pt(4, 102, "Wrong way? Settings: Tilt");
}

static void tslToOver() {
  if (tslBest >= 10) evSet2(13);   // "Steady Hands": finished a run after 10 gates in a row
  if (tslGhostOn && tslScore > (int)tslGhostScore) miscSetFlag(MF_ACH_GHOST, true);   // "Ghost Buster"
  if (tslSeeded && tslRecN >= 2 && tslScore > 0) {   // keep ONE ghost: the best run of the latest seeded course
    bool same = g_saveMisc.ghost[0] == (uint8_t)(tslTier + 1) && g_saveMisc.ghost[1] == (uint8_t)(tslSeedH & 255) &&
                g_saveMisc.ghost[2] == (uint8_t)(tslSeedH >> 8);
    bool have = g_saveMisc.ghost[0] != 0 && g_saveMisc.ghost[5] >= 2 && g_saveMisc.ghost[5] <= TSL_GN;
    uint16_t sc = (uint16_t)(tslScore > 65535 ? 65535 : tslScore);
    if (!have || !same || sc > (uint16_t)(g_saveMisc.ghost[3] | (g_saveMisc.ghost[4] << 8))) {
      memset(g_saveMisc.ghost, 0, sizeof(g_saveMisc.ghost));
      g_saveMisc.ghost[0] = (uint8_t)(tslTier + 1);
      g_saveMisc.ghost[1] = (uint8_t)(tslSeedH & 255);
      g_saveMisc.ghost[2] = (uint8_t)(tslSeedH >> 8);
      g_saveMisc.ghost[3] = (uint8_t)(sc & 255);
      g_saveMisc.ghost[4] = (uint8_t)(sc >> 8);
      g_saveMisc.ghost[5] = tslRecN;
      memcpy(&g_saveMisc.ghost[6], tslRec, sizeof(tslRec));   // saved by recordResult() just below
    }
  }
  recordResult(55, g_variant, (long)tslScore, true);
  if (g_twoPlayerMode) { twoPHandleGameEnd((long)tslScore); return; }
  gameState = ST_SLALOM_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%d", tslScore);
  if (tslGhostOn && tslScore > (int)tslGhostScore) snprintf(sub, sizeof(sub), "Ghost beaten! %d gates", tslGates);
  else snprintf(sub, sizeof(sub), "%d gates  streak %d", tslGates, tslBest);
  drawStdOver("WIPEOUT", COL_LASER, big, sub, 55);
}

// A missed gate only ends the streak (no life lost).
static void tslMiss() {
  tslStreak = 0;
  sfx(200, 90);
  particlesBurst((int)tslX, TSL_SKY, 5, COL_LASER);
}

// A crash into a rock, tree or skier: the streak ends and (unless just hit) a life is lost.
static void tslHit(unsigned long now, bool crash) {
  tslStreak = 0;
  if (now < tslInvUntil) return;
  tslLives--;
  int sx = (int)tslX;
  if (tslLives <= 0) {
    tslPh = 2;
    tslEndAt = now + 800UL;
    sfxDeath();
    explosionBurst(sx, TSL_SKY, 24, tslColSki);
    screenShake(300, 4);
  } else {
    tslInvUntil = now + 1300UL;
    sfx(crash ? 150 : 200, 110);
    particlesBurst(sx, TSL_SKY, crash ? 14 : 8, crash ? tslColSki : COL_LASER);
    screenShake(160, crash ? 3 : 2);
  }
  pixelsFlashAsync(255, 40, 0, 80);
}

static void tslFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  bool tslGap = (s_lastFrameMs == 0) || (now - s_lastFrameMs > 150UL);   // first frame / back from a pause
  s_lastFrameMs = now;
  float ax = 0.0f, ay = 0.0f;
  tiltReadXY(ax, ay);
  (void)ay;
  if (tslPh == 0) {   // calibration: still for 0.5 s (or A, or 4 s) and the current angle is "straight"
    if (tslGap) { tslCalN = 0; tslCalT0 = now; tslCalStart = now; }   // no stale samples / expired 4 s timer
    if (tslCalN == 0 || fabsf(ax - tslCalRef) > 0.10f) {
      tslCalRef = ax;
      tslCalSum = 0.0f;
      tslCalN = 0;
      tslCalT0 = now;
    }
    tslCalSum += ax;
    tslCalN++;
    if (pressed & ARCADA_BUTTONMASK_A) { tslNeutral = ax; tslBeginRun(); }
    else if (now - tslCalT0 >= 500UL) { tslNeutral = tslCalSum / (float)tslCalN; tslBeginRun(); }
    else if (now - tslCalStart >= 4000UL) { tslNeutral = ax; tslBeginRun(); }
    if (tslPh == 0) { drawTslCal(now); blitScreen(); return; }
    dt = 0.016f;
  }
  if (tslPh == 2) {
    if (now >= tslEndAt) { tslToOver(); return; }
    drawTslScene(now);
    blitScreen();
    return;
  }
  // --- running ---
  float lat = kTslLat[tslTier];
  float dev = ax - tslNeutral;
  if (fabsf(dev) < 0.04f) dev = 0.0f;
  else dev -= (dev > 0.0f ? 0.04f : -0.04f);
  float target = dev * kTslGain[tslTier];
  if (buttons & ARCADA_BUTTONMASK_LEFT) target = -lat;
  else if (buttons & ARCADA_BUTTONMASK_RIGHT) target = lat;
  if (target > lat) target = lat;
  if (target < -lat) target = -lat;
  float k = dt * 9.0f;
  if (k > 1.0f) k = 1.0f;
  tslVX += (target - tslVX) * k;
  tslX += tslVX * dt;
  if (tslX < 6.0f) { tslX = 6.0f; tslVX = 0.0f; }
  if (tslX > 154.0f) { tslX = 154.0f; tslVX = 0.0f; }
  tslRunMs += (uint32_t)(dt * 1000.0f);
  while (tslRecN <= tslRunMs / 120UL && tslRecN < TSL_GN) {   // ghost sample: x in 10 px steps, 4 bits
    int q = (int)(tslX / 10.0f);
    if (q > 15) q = 15;
    if (q < 0) q = 0;
    uint8_t &b = tslRec[tslRecN >> 1];
    if (tslRecN & 1) b = (uint8_t)((b & 0x0F) | (q << 4)); else b = (uint8_t)((b & 0xF0) | q);
    tslRecN++;
  }
  float prevS = tslS;
  tslS += tslSpeedAt(tslS) * dt;
  while (tslNextD < tslS + 170.0f) tslGenNext();
  for (int i = 0; i < tslNG; i++) {   // gates crossing the skier's line
    if (tslGst[i] != 0 || !(prevS < tslGd[i] && tslS >= tslGd[i])) continue;
    float dx = fabsf(tslX - tslGx[i]);
    if (dx <= (float)tslGw[i] - 2.0f) {
      tslGst[i] = 1;
      tslStreak++;
      tslGates++;
      if (tslStreak > tslBest) tslBest = tslStreak;
      int pts = 10 + 2 * (tslStreak - 1 > 20 ? 20 : tslStreak - 1);
      bool clean = dx < (float)tslGw[i] * 0.4f;
      if (clean) pts += 5;
      tslScore += pts;
      tslPopV = pts;
      tslPopT0 = now ? now : 1UL;
      tslPopX = (int16_t)(tslGx[i] - 8);
      tslPopY = TSL_SKY - 12;
      sfx((uint16_t)(560 + 28 * (tslStreak > 12 ? 12 : tslStreak)), 35);
      particlesBurst((int)tslGx[i], TSL_SKY, clean ? 10 : 5, clean ? COL_KEY : COL_GOAL);
      if (tslStreak == 10) { sfx(1200, 90); pixelsFlashAsync(0, 255, 120, 90); }
    } else {
      tslGst[i] = 2;
      tslMiss();
    }
  }
  if (tslPh == 1 && now >= tslInvUntil) {   // obstacles (none while invincible)
    for (int i = 0; i < tslNO; i++) {
      float dy = tslOd[i] - tslS, dx = tslX - tslObsX(i);
      float rr = (tslOt[i] == 1 ? 6.0f : 5.0f) + 3.5f;
      if (dx * dx + dy * dy < rr * rr) { tslHit(now, true); break; }
    }
  }
  // drop what has scrolled off the bottom
  for (int i = 0; i < tslNG;) {
    if (tslGd[i] < tslS - 40.0f) {
      for (int j = i; j + 1 < tslNG; j++) { tslGd[j] = tslGd[j + 1]; tslGx[j] = tslGx[j + 1]; tslGw[j] = tslGw[j + 1]; tslGst[j] = tslGst[j + 1]; }
      tslNG--;
    } else i++;
  }
  for (int i = 0; i < tslNO;) {
    if (tslOd[i] < tslS - 40.0f) {
      for (int j = i; j + 1 < tslNO; j++) { tslOd[j] = tslOd[j + 1]; tslOx[j] = tslOx[j + 1]; tslOt[j] = tslOt[j + 1]; tslOv[j] = tslOv[j + 1]; }
      tslNO--;
    } else i++;
  }
  drawTslScene(now);
  blitScreen();
}

// --- Auto-brightness (light sensor) -----------------------------------
//
// The PyGamer's phototransistor (A7) reads brighter ambient light as a
// higher analogRead() value. We use it to dim the backlight in a dark
// room and bring it back up in a lit one, rather than always running at
// full brightness. Checked a few times a second and smoothed a bit so it
// doesn't hunt/flicker on borderline readings.
//
// Not hardware-validated: the exact raw ADC range for "dark room" vs
// "bright room" is a first guess (0..800) and will likely want
// calibrating once you can see it react on a real board.
static unsigned long s_lastLightCheckMs = 0;
static float s_backlightLevel = 255;

static void updateAutoBacklight() {
  unsigned long now = millis();
  if (now - s_lastLightCheckMs < 300)
    return;
  s_lastLightCheckMs = now;

  int target;
  if (s_brightnessMode == 0) {
    uint16_t raw = arcada.readLightSensor();
    target = map((long)raw, 0, 800, 50, 255);
    target = constrain(target, 50, 255);
  } else {
    target = kManualBrightness[s_brightnessMode - 1];
  }

  // Ease toward the target instead of snapping, so it doesn't visibly
  // jump every time you wave a hand over the sensor (or flip modes).
  s_backlightLevel += (target - s_backlightLevel) * 0.3f;
  arcada.setBacklight((uint8_t)s_backlightLevel);
}

// --- Level editor: persistent storage (QSPI flash filesystem) -------------
//
// The PyGamer has an onboard QSPI NOR flash chip. Adafruit_Arcada already
// exposes it as a small FAT filesystem via filesysBegin()/open()/exists()/
// mkdir() -- the same mechanism its own config-save and file-chooser
// features use -- so custom levels are written there as small binary
// files, one per game+slot, and survive a power cycle.
//
// On a chip that's never had a FAT filesystem on it (one that never ran
// CircuitPython, which is normally what creates it on a factory PyGamer)
// filesysBegin() can come back with nothing mounted. In that case we
// format it ourselves in place, using the same FatFs formatter Adafruit
// ships as its "SdFat_format" example (see ff.c/ff.h/diskio.h/ffconf.h
// alongside this .ino -- those are vendored, not hand-written, straight
// from that example), then retry the mount. If that still fails (no flash
// chip responds at all) we fall back to keeping custom levels in RAM for
// that boot and say so on screen, rather than silently pretending saves
// are durable when they aren't.
#define LVL_DIR "/levels"
#define LVL_TMP_PATH LVL_DIR "/tmp.lvl"

static bool s_lvlFsReady = false;  // true once a real filesystem is mounted
static bool s_lvlFsIsRam = false;  // true = degraded fallback, saves don't survive reset

extern bool lvlFormatQSPIFlash(); // in LevelFlashFormat.cpp alongside this sketch

// Degraded fallback store -- only ever written to if no filesystem could be
// mounted or formatted. ~1.7KB static, trivial next to the SAMD51's 192KB.
#define LVL_RAM_POOL 640
static uint8_t s_lvlRamPool[LVL_RAM_POOL]; // compact variable-length entries
static uint16_t s_lvlRamUsed = 0;

// Folders + README that the USB drive shows on the PC. Cheap (4 exists() calls) when all are present.
static const char kUsbReadme[] =
  "ARCADIA - PyGamer drive\r\n\r\n"
  "arcadia/ saves: scores, stats, awards, settings, carts.bin.\r\n"
  "levels/  custom levels (two copies each; the newer valid one wins).\r\n"
  "assets/ banners.bin  packs/ level packs  data/ words.txt  worlds/ quest.wld\r\n"
  "carts/ expansion games *.arc   roms/ CHIP-8 programs *.ch8\r\n\r\n"
  "Copy files here only in USB drive mode. EJECT the drive on your PC first, THEN press B on the PyGamer: it reboots and reloads everything. "
  "Bad or foreign files are ignored. Back up arcadia/ and levels/ before changing anything.\r\n";
static_assert(sizeof(kUsbReadme) <= 600, "README.TXT too large");
static void usbEnsureLayout() {
  if (!arcada.exists("/arcadia")) arcada.mkdir("/arcadia");
  if (!arcada.exists("/levels")) arcada.mkdir("/levels");
  if (!arcada.exists("/assets")) arcada.mkdir("/assets");
  if (!arcada.exists("/packs")) arcada.mkdir("/packs");
  if (!arcada.exists("/data")) arcada.mkdir("/data");
  if (!arcada.exists("/carts")) arcada.mkdir("/carts");
