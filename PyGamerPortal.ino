static bool qStartAtCheckpoint() {
  s_qMsg = -1;
  if (s_qCkReg < QW_MAXREG && qExists(s_qCkReg) && qEnterRegion(s_qCkReg, s_qCkCol, s_qCkRow)) return true;
  return qEnterRegion(s_qStartReg, s_qStartCol, s_qStartRow);
}

// Pause menu "Restart": back to the last checkpoint (progress is never lost).
static void questRespawnEntry() {
  if (!qStartAtCheckpoint()) { qFatal(); return; }
  gameState = ST_QUEST_PLAYING;
  s_qMapOpen = false;
  s_lastFrameMs = 0;
  qHint("Back to checkpoint");
  qDrawPlaying();
}

static void enterQuestPlaying() {
  qInitCols();
  if (!s_qOk) { sfxBlocked(); return; }
  playerAngle = 0;
  thirdPerson = false;
  if (!qStartAtCheckpoint()) { qFatal(); return; }
  gameState = ST_QUEST_PLAYING;
  s_qMapOpen = false;
  s_qHint[0] = 0;
  s_qStartDown = false;
  s_qPlayAcc = 0;
  s_lastFrameMs = 0;
  qSaveSoon();
  qDrawPlaying();
}

static void questTitleTick(uint32_t pressed) {
  if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
    if (!s_qOk) { enterQuestTitle(); return; }   // "retry": probe the drive again
    s_qEraseArm = false;
    enterQuestPlaying();
  } else if (pressed & ARCADA_BUTTONMASK_B) {
    gameState = ST_GAME_PICKER;
    drawGamePicker();
  } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
    g_variant = (g_variant + 4) % 5;
    enterQuestTitle();
  } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
    g_variant = (g_variant + 1) % 5;
    enterQuestTitle();
  } else if ((pressed & ARCADA_BUTTONMASK_UP) && s_qOk) {
    if (s_qEraseArm && millis() - s_qEraseArmMs < 4000) {
      qEraseProgress();
      sfx(200, 150);
      s_qEraseArm = false;
      qLoadSave();
      toastShow("Progress erased");
      drawQuestTitle();
    } else {
      s_qEraseArm = true;
      s_qEraseArmMs = millis();
      drawQuestTitle();
    }
  }
}

static void questFrame(uint32_t buttons, uint32_t pressed) {
  if (checkPauseMenu(buttons, questRespawnEntry)) return;
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;

  // Start: a quick tap opens the map (a hold is the pause menu, handled above)
  bool startDown = buttons & ARCADA_BUTTONMASK_START;
  bool startTap = false;
  if (startDown && !s_qStartDown) s_qStartAt = now;
  if (!startDown && s_qStartDown && now - s_qStartAt < PAUSE_HOLD_MS) startTap = true;
  s_qStartDown = startDown;

  if (s_qSaveDue && (int32_t)(now - s_qSaveAt) >= 0) qSaveNow();

  s_qPlayAcc += dt;
  if (s_qPlayAcc >= 1.0f) { s_qPlayAcc -= 1.0f; s_qPlaySec++; }

  if (s_qMapOpen) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B) || startTap) {
      s_qMapOpen = false;
      sfx(400, 30);
      s_lastFrameMs = 0;
    } else {
      qDrawMap();
      return;
    }
  }
  if (s_qMsg >= 0) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B)) {
      s_qMsg = -1;
      sfx(400, 20);
      s_lastFrameMs = 0;
    }
    qDrawPlaying();
    return;
  }
  if ((pressed & ARCADA_BUTTONMASK_B) || startTap) {
    s_qMapOpen = true;
    sfx(500, 30);
    qDrawMap();
    return;
  }
  if (pressed & ARCADA_BUTTONMASK_A) qInteract();

  static const float kTurn[5] = {1.0f, 1.6f, 0.75f, 1.25f, 0.75f};   // NORMAL SPEED CHILL EXTREME ZEN
  float turn = TURN_SPEED * kTurn[g_variant < 5 ? g_variant : 0];
  if (buttons & ARCADA_BUTTONMASK_LEFT) playerAngle -= turn * dt;
  if (buttons & ARCADA_BUTTONMASK_RIGHT) playerAngle += turn * dt;
  if (playerAngle > 6.2831853f) playerAngle -= 6.2831853f;
  if (playerAngle < -6.2831853f) playerAngle += 6.2831853f;
  float ix = 0, iy = 0;
  if (buttons & ARCADA_BUTTONMASK_UP) { ix += cosf(playerAngle) * MOVE_SPEED; iy += sinf(playerAngle) * MOVE_SPEED; }
  if (buttons & ARCADA_BUTTONMASK_DOWN) { ix -= cosf(playerAngle) * MOVE_SPEED; iy -= sinf(playerAngle) * MOVE_SPEED; }

  hasKey = s_qKeys > 0;
  uint8_t regBefore = s_qReg;
  updatePlayer(dt, ix, iy);
  if (gameState != ST_QUEST_PLAYING) return;   // qFatal() sent us back to the title
  if (s_qReg == regBefore) {
    float wpx = curW * TILE_SIZE, hpx = curH * TILE_SIZE;
    if (playerX >= wpx - 2.5f) qCrossEdge(1, 0);
    else if (playerX < 2.5f) qCrossEdge(-1, 0);
    else if (playerY >= hpx - 2.5f) qCrossEdge(0, 1);
    else if (playerY < 2.5f) qCrossEdge(0, -1);
  }
  if (gameState != ST_QUEST_PLAYING) return;
  qAfterMove();
  if (gameState != ST_QUEST_PLAYING) return;
  qDrawPlaying();
}

// =====================================================================================
// More games (57..62): Hangman, Wordle, Sudoku mini, Nonogram, Missile Command, Pipe Link.
// Shared helpers first: the word list (drive file /data/words.txt + a small built-in
// fallback), a repeat-aware D-pad, an on-screen QWERTY letter picker and the standard
// title / over button handling.
// =====================================================================================
#define WORDS_PATH "/data/words.txt"
static const char* const kWdFallback[] = {
  "apple", "brave", "crane", "dream", "eagle", "flame", "ghost", "heart", "ivory", "jolly",
  "knife", "lemon", "mango", "night", "ocean", "piano", "queen", "river", "storm", "tiger",
  "uncle", "vivid", "water", "yacht", "zebra", "bread", "chair", "cloud", "dance", "earth",
  "field", "grape", "house", "juice", "light", "money", "north", "plant", "radio", "sheep",
  "table", "garden", "window", "planet", "rocket", "guitar", "monkey", "jungle", "castle", "bridge",
  "pencil", "elephant", "computer", "mountain", "chocolate", "adventure", "umbrella", "dolphin", "kingdom", "machine",
  "teacher", "butterfly"
};
#define WD_FB_N ((int)(sizeof(kWdFallback) / sizeof(kWdFallback[0])))
static bool s_wordsFile = false;   // the last pick came from /data/words.txt

// Streams /data/words.txt (one word per line, a-z only; other lines are skipped) and counts the
// words whose length is minLen..maxLen. When out != 0 and the target-th such word exists it is
// copied (lower case, NUL terminated) into out (>= 16 bytes) and count+1 is returned. 0 = no file.
static int wordScan(int minLen, int maxLen, int target, char* out) {
  if (!bannerFsOk() || !arcada.exists(WORDS_PATH)) return 0;
  File f = arcada.open(WORDS_PATH, O_READ);
  if (!f) return 0;
  uint8_t buf[512];
  char cur[16];
  int n = 0, count = 0;
  bool bad = false, eof = false;
  while (!eof) {
    int got = f.read(buf, sizeof(buf));
    if (got <= 0) { eof = true; got = 1; buf[0] = '\n'; }
    for (int i = 0; i < got; i++) {
      char c = (char)buf[i];
      if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
      if (c >= 'a' && c <= 'z') {
        if (n < 15) cur[n] = c; else bad = true;
        n++;
      } else if (c == '\n' || c == '\r') {
        if (!bad && n >= minLen && n <= maxLen) {
          if (out && count == target) { memcpy(out, cur, (size_t)n); out[n] = 0; f.close(); return count + 1; }
          count++;
        }
        n = 0;
        bad = false;
      } else {
        bad = true;
      }
    }
  }
  f.close();
  return count;
}

// Picks a word of minLen..maxLen letters with the round RNG (so 2P / seeds repeat it).
static void wordPick(int minLen, int maxLen, char* out) {
  out[0] = 0;
  int cnt = wordScan(minLen, maxLen, -1, 0);
  s_wordsFile = cnt >= 25;
  if (s_wordsFile) {
    wordScan(minLen, maxLen, mazeRngRange(cnt), out);
    if (out[0]) return;
    s_wordsFile = false;
  }
  int tot = 0;
  for (int i = 0; i < WD_FB_N; i++) { int l = (int)strlen(kWdFallback[i]); if (l >= minLen && l <= maxLen) tot++; }
  int k = tot ? mazeRngRange(tot) : mazeRngRange(WD_FB_N);
  for (int i = 0; i < WD_FB_N; i++) {
    int l = (int)strlen(kWdFallback[i]);
    if (tot && (l < minLen || l > maxLen)) continue;
    if (k-- == 0) { strncpy(out, kWdFallback[i], 15); out[15] = 0; return; }
  }
  strcpy(out, "planet");
}

#define NAV_MASK (ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT | ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN)
static unsigned long s_navAt = 0;
// D-pad edges plus auto-repeat (280 ms, then every 110 ms) for a held direction; one bit at a time.
static uint32_t navRepeat(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  uint32_t out = pressed & NAV_MASK;
  uint32_t h = buttons & NAV_MASK;
  if (out) s_navAt = now + 280UL;
  else if (h && (long)(now - s_navAt) >= 0) { out = h & (~h + 1u); s_navAt = now + 110UL; }
  return out;
}

// ---- on-screen QWERTY picker: kbMark[letter] 0 none, 1 absent, 2 present, 3 right, 4 wrong ----
static const char* const kKbRows[3] = {"QWERTYUIOP", "ASDFGHJKL", "ZXCVBNM<>"};
static uint8_t kbR = 1, kbC = 4;
static bool kbCtl = false;      // row 3 also holds the DEL ('<') and ENTER ('>') keys
static uint8_t kbMark[26];
static int kbLen(int r) { return (!kbCtl && r == 2) ? 7 : (int)strlen(kKbRows[r]); }
static void kbMove(uint32_t d) {
  if (d & ARCADA_BUTTONMASK_LEFT) kbC = (uint8_t)(kbC ? kbC - 1 : kbLen(kbR) - 1);
  else if (d & ARCADA_BUTTONMASK_RIGHT) kbC = (uint8_t)(kbC + 1 >= kbLen(kbR) ? 0 : kbC + 1);
  else if (d & ARCADA_BUTTONMASK_UP) kbR = (uint8_t)(kbR ? kbR - 1 : 2);
  else if (d & ARCADA_BUTTONMASK_DOWN) kbR = (uint8_t)(kbR >= 2 ? 0 : kbR + 1);
  if (kbC >= kbLen(kbR)) kbC = (uint8_t)(kbLen(kbR) - 1);
}
static char kbCur() { return kKbRows[kbR][kbC]; }
static void kbReset(bool ctl) { memset(kbMark, 0, sizeof(kbMark)); kbCtl = ctl; kbR = 1; kbC = 4; }
static void kbDraw(int y0) {
  uint16_t cDim = arcada.display->color565(58, 64, 94), cGray = arcada.display->color565(30, 32, 46);
  uint16_t tGray = arcada.display->color565(100, 100, 120);
  for (int r = 0; r < 3; r++) {
    int len = kbLen(r), x0 = (160 - len * 15) / 2, y = y0 + r * 11;
    for (int i = 0; i < len; i++) {
      char c = kKbRows[r][i];
      int x = x0 + i * 15;
      uint16_t bg = cDim, fg = COL_TEXT;
      if (c >= 'A' && c <= 'Z') {
        switch (kbMark[c - 'A']) {
          case 1: bg = cGray; fg = tGray; break;
          case 2: bg = COL_KEY; fg = COL_BG; break;
          case 3: bg = COL_GOAL; fg = COL_BG; break;
          case 4: bg = COL_LASER; fg = COL_BG; break;
        }
      }
      canvas->fillRect(x + 1, y + 1, 13, 9, bg);
      canvas->setTextColor(fg);
      if (c == '>') { canvas->setCursor(x + 2, y + 2); canvas->print("OK"); }
      else { canvas->setCursor(x + 5, y + 2); canvas->print(c); }
      if (r == kbR && i == kbC) {
        canvas->drawRect(x, y, 15, 11, COL_KEY);
        canvas->drawRect(x + 1, y + 1, 13, 9, COL_TEXT);
      }
    }
  }
}

// Shared title / over button handling for the six games below (same wiring as Tilt Slalom).
static void stdTitleTick(uint32_t pressed, EnterPlayingFn enterFn, void (*titleFn)(), bool higher, const char* label, int gidx) {
  if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
    if (g_twoPlayerMode) twoPBegin(enterFn, higher, label);
    else enterFn();
  } else if (pressed & ARCADA_BUTTONMASK_B) {
    gameState = ST_GAME_PICKER;
    drawGamePicker();
  } else if ((pressed & ARCADA_BUTTONMASK_DOWN) && gameHasSeed(gidx)) {
    cycleUserSeed();
    titleFn();
  } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
    g_variant = (g_variant + 3) % 4;
    titleFn();
  } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
    g_variant = (g_variant + 1) % 4;
    titleFn();
  }
}
static void stdOverTick(uint32_t pressed, EnterPlayingFn enterFn) {
  if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) enterFn();
  else if (pressed & ARCADA_BUTTONMASK_B) { gameState = ST_GAME_PICKER; drawGamePicker(); }
}

// --- Hangman (57) ----------------------------------------------------------------------
// Guess the hidden word letter by letter with the D-pad picker. A wrong letter adds a piece to
// the gallows; running out of misses ends the run. Each solved word scores 10 x letters + 5 per
// miss left and the next word follows at once. Tiers set the word length and the miss limit.
#define HG_MAXLEN 12
static char hgWord[16];
static uint8_t hgLen, hgMiss, hgMissMax, hgPhase;   // phase 0 guessing, 1 solved, 2 hanged
static int hgScore, hgWords, hgGain;
static unsigned long hgPhaseAt;
static const char* const kHgModes[4] = {"NORMAL 5-7 LETTERS", "EASY 4-5 LETTERS", "HARD 7-10 LETTERS", "EXTREME 5 MISSES"};

static void enterHangTitle() {
  gameState = ST_HANG_TITLE;
  drawStdTitleEx("HANGMAN", COL_ORANGE, "Guess the hidden word", "D-pad pick  A: guess", "Solve words in a row", 57,
                 kHgModes[g_variant & 3]);
}

static void hgNewWord() {
  static const uint8_t lo[4] = {5, 4, 7, 6}, hi[4] = {7, 5, 10, 10}, miss[4] = {7, 8, 7, 5};
  int t = g_variant & 3;
  wordPick(lo[t], hi[t], hgWord);
  int l = (int)strlen(hgWord);
  if (l > HG_MAXLEN) l = HG_MAXLEN;
  hgWord[l] = 0;
  for (int i = 0; i < l; i++) if (hgWord[i] >= 'a' && hgWord[i] <= 'z') hgWord[i] = (char)(hgWord[i] - 32);
  hgLen = (uint8_t)l;
  hgMissMax = miss[t];
  hgMiss = 0;
  hgPhase = 0;
  kbReset(false);
}

static void enterHangPlaying() {
  s_mazeRng = gameSeed();
  hgScore = 0;
  hgWords = 0;
  hgGain = 0;
  hgNewWord();
  s_navAt = millis() + 300UL;
  s_lastFrameMs = 0;
  gameState = ST_HANG_PLAYING;
}

static void hgDrawMan(int stage, uint16_t col) {
  canvas->drawLine(8, 80, 52, 80, COL_WALL);
  canvas->drawLine(20, 80, 20, 38, COL_WALL);
  canvas->drawLine(20, 38, 42, 38, COL_WALL);
  canvas->drawLine(20, 46, 28, 38, COL_WALL);
  if (stage >= 1) canvas->drawLine(42, 38, 42, 45, col);
  if (stage >= 1) canvas->drawCircle(42, 51, 6, col);
  if (stage >= 2) canvas->drawLine(42, 57, 42, 69, col);
  if (stage >= 3) canvas->drawLine(42, 61, 35, 66, col);
  if (stage >= 4) canvas->drawLine(42, 61, 49, 66, col);
  if (stage >= 5) canvas->drawLine(42, 69, 36, 78, col);
  if (stage >= 6) canvas->drawLine(42, 69, 48, 78, col);
}

static void hgDraw() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 3, 2, "HANGMAN");
  char b[24];
  snprintf(b, sizeof(b), "SCORE %d", hgScore);
  ptc(COL_KEY, 157 - (int)strlen(b) * 6, 2, b);
  int x0 = (160 - hgLen * 14) / 2;
  canvas->setTextSize(2);
  for (int i = 0; i < hgLen; i++) {
    int x = x0 + i * 14;
    char c = hgWord[i];
    bool got = kbMark[c - 'A'] == 3;
    canvas->drawFastHLine(x, 31, 12, hgPhase == 1 ? COL_GOAL : COL_WALL);
    if (got || hgPhase != 0) {
      ptc(hgPhase == 1 ? COL_GOAL : (got ? COL_TEXT : COL_LASER), x, 15, c);
    }
  }
  canvas->setTextSize(1);
  int stage = hgMiss ? (hgMiss * 6 + hgMissMax - 1) / hgMissMax : 0;
  hgDrawMan(stage, hgPhase == 2 ? COL_LASER : COL_TEXT);
  canvas->setTextColor(COL_TEXT);
  canvas->setCursor(66, 40);
  snprintf(b, sizeof(b), "MISSES %d/%d", hgMiss, hgMissMax);
  canvas->print(b);
  int n = 0;
  canvas->setTextColor(COL_LASER);
  canvas->setCursor(66, 52);
  for (int i = 0; i < 26; i++) if (kbMark[i] == 4) { canvas->print((char)('A' + i)); canvas->print(' '); if (++n >= 12) break; }
  canvas->setTextColor(COL_ICE);
  canvas->setCursor(66, 70);
  snprintf(b, sizeof(b), "WORDS %d", hgWords);
  canvas->print(b);
  if (hgPhase == 1) {
    canvas->setTextColor(COL_GOAL);
    canvas->setCursor(66, 61);
    snprintf(b, sizeof(b), "+%d", hgGain);
    canvas->print(b);
  }
  kbDraw(88);
  particlesUpdateDraw();
}

static void hgToOver() {
  recordResult(57, g_variant, (long)hgScore, true);
  if (g_twoPlayerMode) { twoPHandleGameEnd((long)hgScore); return; }
  gameState = ST_HANG_OVER;
  char big[12], sub[40];
  snprintf(big, sizeof(big), "%d", hgScore);
  snprintf(sub, sizeof(sub), "Solved %d. Was %.10s", hgWords, hgWord);
  drawStdOver("HANGED!", COL_LASER, big, sub, 57);
}

static void hangFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  s_lastFrameMs = now;
  if (hgPhase == 0) {
    uint32_t d = navRepeat(buttons, pressed);
    if (d) { kbMove(d); sfxMove(); }
    if (pressed & ARCADA_BUTTONMASK_A) {
      int li = kbCur() - 'A';
      if (li < 0 || li > 25 || kbMark[li]) {
        sfxBlocked();
      } else {
        bool in = false;
        for (int i = 0; i < hgLen; i++) if (hgWord[i] == kbCur()) in = true;
        if (in) {
          kbMark[li] = 3;
          sfx(660, 50);
          particlesBurst(80, 24, 6, COL_GOAL);
          bool all = true;
          for (int i = 0; i < hgLen; i++) if (kbMark[hgWord[i] - 'A'] != 3) all = false;
          if (all) {
            hgGain = hgLen * 10 + (hgMissMax - hgMiss) * 5;
            hgScore += hgGain;
            hgWords++;
            hgPhase = 1;
            hgPhaseAt = now + 1100UL;
            sfxWin();
          }
        } else {
          kbMark[li] = 4;
          hgMiss++;
          sfx(150, 100);
          screenShake(120, 2);
          if (hgMiss >= hgMissMax) {
            hgPhase = 2;
            hgPhaseAt = now + 1300UL;
            sfxDeath();
            explosionBurst(42, 55, 14, COL_LASER);
            pixelsFlashAsync(255, 30, 0, 120);
          }
        }
      }
    }
  } else if ((long)(now - hgPhaseAt) >= 0) {
    if (hgPhase == 1) hgNewWord();
    else { hgToOver(); return; }
  }
  hgDraw();
  blitScreen();
}

// --- Wordle-style (58) -------------------------------------------------------------------
// Guess the secret 5-letter word. After each guess every letter is marked green (right place),
// yellow (in the word, wrong place) or grey (not in it); the picker's keys remember the best
// mark. Solve words back to back: 20 + 10 per spare guess each; a word you fail ends the run.
// Tiers: NORMAL 6 guesses, EASY 7 guesses + first letter shown, HARD 5 guesses, EXTREME 5
// guesses and "hard mode" (revealed clues must be reused). Any 5 letters count as a guess.
#define WD_COLS 5
#define WD_MAXROWS 7
static char wdTarget[8];
static char wdGuess[WD_MAXROWS][WD_COLS];
static uint8_t wdRes[WD_MAXROWS][WD_COLS];
static uint8_t wdRow, wdCol, wdMaxRows, wdPhase, wdRevN;   // phase 0 typing, 1 revealing, 2 solved, 3 failed
static int wdScore, wdWords, wdGain;
static unsigned long wdPhaseAt;
static const char* const kWdModes[4] = {"NORMAL 6 GUESSES", "EASY 7 + 1ST LETTER", "HARD 5 GUESSES", "EXTREME HARD MODE"};

static void enterWordleTitle() {
  gameState = ST_WORDLE_TITLE;
  drawStdTitleEx("WORDLE", COL_GOAL, "Find the 5-letter word", "Green = right spot", "Yellow = wrong spot", 58,
                 kWdModes[g_variant & 3]);
}

static void wdNewWord() {
  static const uint8_t rows[4] = {6, 7, 5, 5};
  wordPick(5, 5, wdTarget);
  wdTarget[5] = 0;
  for (int i = 0; i < 5; i++) if (wdTarget[i] >= 'a' && wdTarget[i] <= 'z') wdTarget[i] = (char)(wdTarget[i] - 32);
  wdMaxRows = rows[g_variant & 3];
  wdRow = 0;
  wdCol = 0;
  wdPhase = 0;
  memset(wdGuess, ' ', sizeof(wdGuess));
  memset(wdRes, 0, sizeof(wdRes));
  kbReset(true);
  if ((g_variant & 3) == 1) kbMark[wdTarget[0] - 'A'] = 3;
}

static void enterWordlePlaying() {
  s_mazeRng = gameSeed();
  wdScore = 0;
  wdWords = 0;
  wdGain = 0;
  wdNewWord();
  s_navAt = millis() + 300UL;
  s_lastFrameMs = 0;
  gameState = ST_WORDLE_PLAYING;
}

static void wdDraw(unsigned long now) {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_GOAL, 3, 2, "WORDLE");
  char b[24];
  snprintf(b, sizeof(b), "SCORE %d", wdScore);
  ptc(COL_KEY, 157 - (int)strlen(b) * 6, 2, b);
  uint16_t cGray = arcada.display->color565(46, 48, 66);
  for (int r = 0; r < wdMaxRows; r++) {
    for (int c = 0; c < WD_COLS; c++) {
      int x = 5 + c * 22, y = 11 + r * 12;
      bool shown = r < wdRow || (r == wdRow && wdPhase != 0 && (c < wdRevN || wdPhase >= 2));
      uint8_t rs = shown ? wdRes[r][c] : 0;
      if (rs) {
        canvas->fillRect(x, y, 20, 11, rs == 3 ? COL_GOAL : (rs == 2 ? COL_KEY : cGray));
      } else {
        canvas->drawRect(x, y, 20, 11, (r == wdRow && wdPhase == 0) ? (c == wdCol ? COL_KEY : COL_WALL) : COL_WALL);
      }
      char ch = wdGuess[r][c];
      if (ch != ' ') {
        ptc(rs == 3 || rs == 2 ? COL_BG : COL_TEXT, x + 7, y + 2, ch);
      }
    }
  }
  canvas->setTextColor(COL_ICE);
  canvas->setCursor(120, 14);
  snprintf(b, sizeof(b), "WORDS");
  canvas->print(b);
  pt(120, 24, wdWords);
  ptc(COL_TEXT, 120, 40, "TRY");
  canvas->setCursor(120, 50);
  snprintf(b, sizeof(b), "%d/%d", wdRow + (wdPhase == 0 ? 1 : 0) > wdMaxRows ? wdMaxRows : wdRow + (wdPhase == 0 ? 1 : 0), wdMaxRows);
  canvas->print(b);
  if (wdPhase == 2) {
    canvas->setTextColor(COL_GOAL);
    canvas->setCursor(120, 68);
    snprintf(b, sizeof(b), "+%d", wdGain);
    canvas->print(b);
  } else if (wdPhase == 3) {
    ptc(COL_LASER, 120, 68, "WORD:");
    pt(120, 78, wdTarget);
  }
  kbDraw(95);
  particlesUpdateDraw();
  (void)now;
}

static void wdToOver() {
  recordResult(58, g_variant, (long)wdScore, true);
  if (g_twoPlayerMode) { twoPHandleGameEnd((long)wdScore); return; }
  gameState = ST_WORDLE_OVER;
  char big[12], sub[40];
  snprintf(big, sizeof(big), "%d", wdScore);
  snprintf(sub, sizeof(sub), "Solved %d. Was %.7s", wdWords, wdTarget);
  drawStdOver("OUT OF GUESSES", COL_LASER, big, sub, 58);
}

// Hard mode: a guess must keep every green letter in place and contain every yellow/green letter found so far.
static bool wdHardOk() {
  for (int r = 0; r < wdRow; r++) {
    for (int c = 0; c < WD_COLS; c++) {
      if (wdRes[r][c] == 3 && wdGuess[wdRow][c] != wdGuess[r][c]) return false;
      if (wdRes[r][c] >= 2) {
        bool has = false;
        for (int k = 0; k < WD_COLS; k++) if (wdGuess[wdRow][k] == wdGuess[r][c]) has = true;
        if (!has) return false;
      }
    }
  }
  return true;
}

static void wdSubmit(unsigned long now) {
  if (wdCol < WD_COLS) { toastShow("Need 5 letters"); sfxBlocked(); return; }
  if ((g_variant & 3) == 3 && !wdHardOk()) { toastShow("Reuse the clues"); sfxBlocked(); return; }
  bool used[WD_COLS] = {false, false, false, false, false};
  for (int c = 0; c < WD_COLS; c++) {
    if (wdGuess[wdRow][c] == wdTarget[c]) { wdRes[wdRow][c] = 3; used[c] = true; }
    else wdRes[wdRow][c] = 1;
  }
  for (int c = 0; c < WD_COLS; c++) {
    if (wdRes[wdRow][c] == 3) continue;
    for (int k = 0; k < WD_COLS; k++) {
      if (!used[k] && wdTarget[k] == wdGuess[wdRow][c]) { used[k] = true; wdRes[wdRow][c] = 2; break; }
    }
  }
  wdPhase = 1;
  wdRevN = 0;
  wdPhaseAt = now;
}

static void wordleFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  s_lastFrameMs = now;
  if (wdPhase == 0) {
    uint32_t d = navRepeat(buttons, pressed);
    if (d) { kbMove(d); sfxMove(); }
    if (pressed & ARCADA_BUTTONMASK_B) {
      if (wdCol > 0) { wdCol--; wdGuess[wdRow][wdCol] = ' '; sfx(300, 15); }
    } else if (pressed & ARCADA_BUTTONMASK_A) {
      char k = kbCur();
      if (k == '>') {
        wdSubmit(now);
      } else if (k == '<') {
        if (wdCol > 0) { wdCol--; wdGuess[wdRow][wdCol] = ' '; sfx(300, 15); }
      } else if (wdCol < WD_COLS) {
        wdGuess[wdRow][wdCol++] = k;
        sfx(520, 20);
      } else {
        sfxBlocked();
      }
    }
  } else if (wdPhase == 1) {
    int want = (int)((now - wdPhaseAt) / 230UL) + 1;
    if (want > WD_COLS) want = WD_COLS;
    while (wdRevN < want) {
      uint8_t rs = wdRes[wdRow][wdRevN];
      sfx(rs == 3 ? 880 : (rs == 2 ? 660 : 330), 40);
      char ch = wdGuess[wdRow][wdRevN];
      if (rs > kbMark[ch - 'A'] || kbMark[ch - 'A'] == 4) kbMark[ch - 'A'] = rs;
      if (rs == 3) particlesBurst(5 + wdRevN * 22 + 10, 11 + wdRow * 12 + 5, 3, COL_GOAL);
      wdRevN++;
    }
    if (wdRevN >= WD_COLS && now - wdPhaseAt > 230UL * WD_COLS + 250UL) {
      bool win = true;
      for (int c = 0; c < WD_COLS; c++) if (wdRes[wdRow][c] != 3) win = false;
      if (win) {
        int left = wdMaxRows - (wdRow + 1);
        wdGain = 20 + 10 * left + ((g_variant & 3) == 3 ? 10 : 0);
        wdScore += wdGain;
        wdWords++;
        wdPhase = 2;
        wdPhaseAt = now + 1300UL;
        sfxWin();
      } else if (wdRow + 1 >= wdMaxRows) {
        wdPhase = 3;
        wdPhaseAt = now + 1700UL;
        sfxDeath();
        screenShake(200, 3);
      } else {
        wdRow++;
        wdCol = 0;
        wdPhase = 0;
      }
    }
  } else if ((long)(now - wdPhaseAt) >= 0) {
    if (wdPhase == 2) wdNewWord();
    else { wdToOver(); return; }
  }
  wdDraw(now);
  blitScreen();
}

// --- Sudoku mini (59) ----------------------------------------------------------------------
// 6x6 Sudoku (digits 1-6, 2x3 boxes). A fresh puzzle with exactly one solution is generated from
// the round seed (random full grid, then clues are removed while the solution stays unique), so
// 2P player 2 gets the identical puzzle. D-pad moves, A raises / B lowers the digit in a cell.
// A digit is checked when you leave the cell (or pause 0.8 s): a wrong one costs +15 s.
// Score = seconds + penalties (lower is better). Tiers set the number of clues.
#define SD_N 36
static uint8_t sdSol[SD_N], sdBd[SD_N];
static uint8_t sdGiven[SD_N], sdWrong[SD_N];
static int sdCur, sdMiss, sdPend;      // sdPend: cell edited but not yet checked (-1 = none)
static unsigned long sdTimeMs, sdPendAt, sdEndAt;
static bool sdWon;
static const char* const kSdModes[4] = {"NORMAL 16 CLUES", "EASY 22 CLUES", "HARD 13 CLUES", "EXTREME 11 CLUES"};

static void enterSudokuTitle() {
  gameState = ST_SUDOKU_TITLE;
  drawStdTitleEx("SUDOKU MINI", COL_ICE, "Fill the 6x6 grid", "Rows, columns, boxes", "Each digit 1-6 once", 59,
                 kSdModes[g_variant & 3]);
}

static bool sdOk(const uint8_t* b, int i, int v) {
  int r = i / 6, c = i % 6;
  for (int k = 0; k < 6; k++) if (b[r * 6 + k] == v || b[k * 6 + c] == v) return false;
  int br = (r / 2) * 2, bc = (c / 3) * 3;
  for (int rr = 0; rr < 2; rr++) for (int cc = 0; cc < 3; cc++) if (b[(br + rr) * 6 + bc + cc] == v) return false;
  return true;
}

static bool sdFill(uint8_t* b, int i) {
  if (i == SD_N) return true;
  uint8_t ord[6] = {1, 2, 3, 4, 5, 6};
  for (int k = 5; k > 0; k--) { int j = mazeRngRange(k + 1); uint8_t t = ord[k]; ord[k] = ord[j]; ord[j] = t; }
  for (int k = 0; k < 6; k++) {
    if (!sdOk(b, i, ord[k])) continue;
    b[i] = ord[k];
    if (sdFill(b, i + 1)) return true;
    b[i] = 0;
  }
  return false;
}

// Number of solutions (stops counting at `limit`); leaves b unchanged.
static int sdCount(uint8_t* b, int i, int limit) {
  while (i < SD_N && b[i]) i++;
  if (i == SD_N) return 1;
  int n = 0;
  for (int v = 1; v <= 6 && n < limit; v++) {
    if (!sdOk(b, i, v)) continue;
    b[i] = (uint8_t)v;
    n += sdCount(b, i + 1, limit - n);
    b[i] = 0;
  }
  return n;
}

static void enterSudokuPlaying() {
  s_mazeRng = gameSeed();
  static const uint8_t clues[4] = {16, 22, 13, 11};
  memset(sdSol, 0, sizeof(sdSol));
  sdFill(sdSol, 0);
  memcpy(sdBd, sdSol, sizeof(sdBd));
  uint8_t ord[SD_N];
  for (int i = 0; i < SD_N; i++) ord[i] = (uint8_t)i;
  for (int k = SD_N - 1; k > 0; k--) { int j = mazeRngRange(k + 1); uint8_t t = ord[k]; ord[k] = ord[j]; ord[j] = t; }
  int left = SD_N, want = clues[g_variant & 3];
  for (int k = 0; k < SD_N && left > want; k++) {
    uint8_t v = sdBd[ord[k]];
    sdBd[ord[k]] = 0;
    if (sdCount(sdBd, 0, 2) == 1) left--;
    else sdBd[ord[k]] = v;
  }
  for (int i = 0; i < SD_N; i++) { sdGiven[i] = sdBd[i] ? 1 : 0; sdWrong[i] = 0; }
  sdCur = 0;
  while (sdCur < SD_N - 1 && sdGiven[sdCur]) sdCur++;
  sdMiss = 0;
  sdPend = -1;
  sdTimeMs = 0;
  sdWon = false;
  sdEndAt = 0;
  s_navAt = millis() + 300UL;
  s_lastFrameMs = 0;
  gameState = ST_SUDOKU_PLAYING;
}

static void sdDraw() {
  canvas->fillScreen(COL_BG);
  uint16_t cGiv = arcada.display->color565(38, 42, 68), cWrong = arcada.display->color565(90, 24, 24);
  uint16_t cSame = arcada.display->color565(30, 70, 60);
  int curV = sdBd[sdCur];
  for (int i = 0; i < SD_N; i++) {
    int x = 4 + (i % 6) * 18, y = 14 + (i / 6) * 18;
    uint16_t bg = sdWrong[i] ? cWrong : (sdGiven[i] ? cGiv : COL_BG);
    if (!sdWrong[i] && curV && sdBd[i] == curV && i != sdCur) bg = cSame;
    canvas->fillRect(x, y, 18, 18, bg);
    if (sdBd[i]) {
      canvas->setTextSize(2);
      ptc(sdWrong[i] ? COL_LASER : (sdGiven[i] ? COL_TEXT : COL_ICE), x + 3, y + 2, (int)sdBd[i]);
    }
    canvas->drawRect(x, y, 19, 19, COL_WALL);
  }
  for (int k = 0; k <= 2; k++) canvas->drawFastHLine(4, 14 + k * 36, 109, COL_TEXT);
  for (int k = 0; k <= 1; k++) canvas->drawFastVLine(4 + k * 54, 14, 109, COL_TEXT);
  canvas->drawFastVLine(4 + 108, 14, 109, COL_TEXT);
  canvas->drawRect(4 + (sdCur % 6) * 18, 14 + (sdCur / 6) * 18, 19, 19, COL_KEY);
  canvas->drawRect(5 + (sdCur % 6) * 18, 15 + (sdCur / 6) * 18, 17, 17, COL_KEY);
  canvas->setTextSize(1);
  ptc(COL_ICE, 4, 3, "SUDOKU MINI");
  unsigned long sec = sdTimeMs / 1000UL + (unsigned long)sdMiss * 15UL;
  char b[16];
  ptc(COL_TEXT, 122, 14, "TIME");
  snprintf(b, sizeof(b), "%lu:%02lu", sec / 60UL, sec % 60UL);
  ptc(COL_KEY, 122, 24, b);
  ptc(COL_TEXT, 122, 40, "MISS");
  ptc(sdMiss ? COL_LASER : COL_TEXT, 122, 50, sdMiss);
  int32_t bs = saveBest(59, saveTierOf(g_variant));
  ptc(COL_TEXT, 122, 68, "BEST");
  canvas->setCursor(122, 78);
  if (bs == SAVE_NO_SCORE) canvas->print("--");
  else { snprintf(b, sizeof(b), "%ld:%02ld", (long)(bs / 60), (long)(bs % 60)); canvas->print(b); }
  particlesUpdateDraw();
}

static bool sdSolved() {
  for (int i = 0; i < SD_N; i++) if (sdBd[i] != sdSol[i]) return false;
  return true;
}

static void sdToOver() {
  long score = (long)(sdTimeMs / 1000UL) + (long)sdMiss * 15L;
  if (score < 1) score = 1;
  recordResult(59, g_variant, score, false);
  if (g_twoPlayerMode) { twoPHandleGameEnd(score); return; }
  gameState = ST_SUDOKU_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%ld", score);
  snprintf(sub, sizeof(sub), "seconds, %d slips", sdMiss);
  drawStdOver("SOLVED!", COL_GOAL, big, sub, 59);
}

// Checks the pending cell (called when the cursor leaves it or after a short idle).
static void sdCommit() {
  if (sdPend < 0) return;
  int i = sdPend;
  sdPend = -1;
  if (sdBd[i] && sdBd[i] != sdSol[i]) {
    sdWrong[i] = 1;
    sdMiss++;
    sfx(140, 120);
    screenShake(120, 2);
    particlesBurst(4 + (i % 6) * 18 + 9, 14 + (i / 6) * 18 + 9, 5, COL_LASER);
  } else {
    sdWrong[i] = 0;
    if (sdBd[i]) { sfx(740, 40); particlesBurst(4 + (i % 6) * 18 + 9, 14 + (i / 6) * 18 + 9, 4, COL_GOAL); }
  }
}

static void sudokuFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  unsigned long dtms = (s_lastFrameMs == 0) ? 16UL : now - s_lastFrameMs;
  if (dtms > 100UL) dtms = 100UL;
  s_lastFrameMs = now;
  if (sdWon) {
    if ((long)(now - sdEndAt) >= 0) { sdToOver(); return; }
  } else {
    sdTimeMs += dtms;
    uint32_t d = navRepeat(buttons, pressed);
    if (d) {
      int r = sdCur / 6, c = sdCur % 6;
      if (d & ARCADA_BUTTONMASK_LEFT) c = (c + 5) % 6;
      else if (d & ARCADA_BUTTONMASK_RIGHT) c = (c + 1) % 6;
      else if (d & ARCADA_BUTTONMASK_UP) r = (r + 5) % 6;
      else if (d & ARCADA_BUTTONMASK_DOWN) r = (r + 1) % 6;
      sdCommit();
      sdCur = r * 6 + c;
      sfxMove();
    }
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B)) {
      if (sdGiven[sdCur]) {
        sfxBlocked();
      } else {
        int v = sdBd[sdCur];
        v = (pressed & ARCADA_BUTTONMASK_A) ? (v + 1) % 7 : (v + 6) % 7;
        sdBd[sdCur] = (uint8_t)v;
        sdWrong[sdCur] = 0;
        sdPend = sdCur;
        sdPendAt = now;
        sfx(400 + v * 40, 15);
        if (sdSolved()) {
          sdPend = -1;
          sdWon = true;
          sdEndAt = now + 1000UL;
          sfxWin();
          particlesBurst(60, 70, 24, COL_GOAL);
        }
      }
    }
    if (sdPend >= 0 && now - sdPendAt > 800UL) sdCommit();
  }
  sdDraw();
  blitScreen();
}

// --- Nonogram (60) -------------------------------------------------------------------------
// Paint by numbers: the clues beside each row / above each column give the lengths of the runs of
// filled cells in that line. A fills a cell (hold A and move to paint a run), B marks an X. Fill a
// cell that is really empty and it becomes an X and costs +10 s (EASY: free). A line's clues grey
// out when it is complete. Score = seconds + penalties (lower is better). Tiers pick the size.
#define NN_MAX 8
static uint8_t nnN, nnCell, nnGx, nnGy;
static uint8_t nnSol[NN_MAX * NN_MAX], nnBd[NN_MAX * NN_MAX];   // board: 0 empty, 1 filled, 2 X
static uint8_t nnRC[NN_MAX][4], nnCC[NN_MAX][4], nnRL[NN_MAX], nnCL[NN_MAX];
static uint8_t nnCurX, nnCurY, nnPaint, nnMaxR, nnMaxC;
static int nnMiss, nnLeft;
static unsigned long nnTimeMs, nnEndAt;
static bool nnWon;
static const char* const kNnModes[4] = {"NORMAL 6x6", "EASY 5x5 NO PENALTY", "HARD 7x7", "EXTREME 8x8"};

static void enterNonoTitle() {
  gameState = ST_NONO_TITLE;
  drawStdTitleEx("NONOGRAM", COL_PLATE_ON, "Paint by the numbers", "A: fill  B: mark X", "Hold A and move to paint", 60,
                 kNnModes[g_variant & 3]);
}

static void nnMakeClues(const uint8_t* line, int stride, uint8_t* out, uint8_t* cnt) {
  int n = 0, run = 0;
  for (int i = 0; i < nnN; i++) {
    if (line[i * stride]) run++;
    else if (run) { out[n++] = (uint8_t)run; run = 0; }
  }
  if (run) out[n++] = (uint8_t)run;
  *cnt = (uint8_t)n;
}

static void enterNonoPlaying() {
  s_mazeRng = gameSeed();
  static const uint8_t sizes[4] = {6, 5, 7, 8};
  nnN = sizes[g_variant & 3];
  nnCell = (uint8_t)(nnN == 5 ? 16 : (nnN == 6 ? 14 : (nnN == 7 ? 12 : 11)));
  memset(nnSol, 0, sizeof(nnSol));
  memset(nnBd, 0, sizeof(nnBd));
  int dens = 56 + mazeRngRange(10);
  for (int i = 0; i < nnN * nnN; i++) nnSol[i] = (uint8_t)(mazeRngRange(100) < dens ? 1 : 0);
  for (int r = 0; r < nnN; r++) {   // no empty line
    bool any = false;
    for (int c = 0; c < nnN; c++) if (nnSol[r * nnN + c]) any = true;
    if (!any) nnSol[r * nnN + mazeRngRange(nnN)] = 1;
  }
  for (int c = 0; c < nnN; c++) {
    bool any = false;
    for (int r = 0; r < nnN; r++) if (nnSol[r * nnN + c]) any = true;
    if (!any) nnSol[mazeRngRange(nnN) * nnN + c] = 1;
  }
  nnMaxR = nnMaxC = 1;
  nnLeft = 0;
  for (int i = 0; i < nnN; i++) {
    nnMakeClues(nnSol + i * nnN, 1, nnRC[i], &nnRL[i]);
    nnMakeClues(nnSol + i, nnN, nnCC[i], &nnCL[i]);
    if (nnRL[i] > nnMaxR) nnMaxR = nnRL[i];
    if (nnCL[i] > nnMaxC) nnMaxC = nnCL[i];
  }
  for (int i = 0; i < nnN * nnN; i++) nnLeft += nnSol[i];
  nnGx = (uint8_t)(5 + nnMaxR * 7);
  nnGy = (uint8_t)(4 + nnMaxC * 8);
  nnCurX = nnCurY = 0;
  nnPaint = 0;
  nnMiss = 0;
  nnTimeMs = 0;
  nnWon = false;
  nnEndAt = 0;
  s_navAt = millis() + 300UL;
  s_lastFrameMs = 0;
  gameState = ST_NONO_PLAYING;
}

static bool nnRowDone(int r) {
  for (int c = 0; c < nnN; c++) if (nnSol[r * nnN + c] && nnBd[r * nnN + c] != 1) return false;
  return true;
}
static bool nnColDone(int c) {
  for (int r = 0; r < nnN; r++) if (nnSol[r * nnN + c] && nnBd[r * nnN + c] != 1) return false;
  return true;
}

static void nnDraw() {
  canvas->fillScreen(COL_BG);
  uint16_t cEmpty = arcada.display->color565(28, 30, 50), cDim = arcada.display->color565(70, 74, 100);
  canvas->setTextSize(1);
  for (int r = 0; r < nnN; r++) {   // row clues, right aligned against the grid
    uint16_t col = nnRowDone(r) ? cDim : (r == nnCurY ? COL_KEY : COL_TEXT);
    canvas->setTextColor(col);
    for (int k = 0; k < nnRL[r]; k++) {
      pt(nnGx - 3 - (nnRL[r] - k) * 7 + 1, nnGy + r * nnCell + (nnCell - 7) / 2, (int)nnRC[r][k]);
    }
  }
  for (int c = 0; c < nnN; c++) {
    canvas->setTextColor(nnColDone(c) ? cDim : (c == nnCurX ? COL_KEY : COL_TEXT));
    for (int k = 0; k < nnCL[c]; k++) {
      pt(nnGx + c * nnCell + (nnCell - 5) / 2, nnGy - 2 - (nnCL[c] - k) * 8, (int)nnCC[c][k]);
    }
  }
  for (int r = 0; r < nnN; r++) {
    for (int c = 0; c < nnN; c++) {
      int x = nnGx + c * nnCell, y = nnGy + r * nnCell, v = nnBd[r * nnN + c];
      canvas->fillRect(x + 1, y + 1, nnCell - 1, nnCell - 1, v == 1 ? COL_ICE : cEmpty);
      if (v == 2) {
        canvas->drawLine(x + 3, y + 3, x + nnCell - 3, y + nnCell - 3, cDim);
        canvas->drawLine(x + nnCell - 3, y + 3, x + 3, y + nnCell - 3, cDim);
      }
    }
  }
  for (int k = 0; k <= nnN; k += 5) {   // guide lines every 5 cells
    canvas->drawFastHLine(nnGx, nnGy + k * nnCell, nnN * nnCell + 1, COL_WALL);
    canvas->drawFastVLine(nnGx + k * nnCell, nnGy, nnN * nnCell + 1, COL_WALL);
  }
  canvas->drawRect(nnGx + nnCurX * nnCell, nnGy + nnCurY * nnCell, nnCell + 1, nnCell + 1, COL_KEY);
  int px = nnGx + nnN * nnCell + 6;
  unsigned long sec = nnTimeMs / 1000UL + (unsigned long)nnMiss * 10UL;
  char b[16];
  ptc(COL_PLATE_ON, px, 3, "NONO");
  ptc(COL_TEXT, px, 18, "TIME");
  snprintf(b, sizeof(b), "%lu:%02lu", sec / 60UL, sec % 60UL);
  ptc(COL_KEY, px, 28, b);
  ptc(COL_TEXT, px, 44, "LEFT");
  pt(px, 54, nnLeft);
  pt(px, 70, "MISS");
  ptc(nnMiss ? COL_LASER : COL_TEXT, px, 80, nnMiss);
  particlesUpdateDraw();
}

static void nnToOver() {
  long score = (long)(nnTimeMs / 1000UL) + (long)nnMiss * 10L;
  if (score < 1) score = 1;
  recordResult(60, g_variant, score, false);
  if (g_twoPlayerMode) { twoPHandleGameEnd(score); return; }
  gameState = ST_NONO_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%ld", score);
  snprintf(sub, sizeof(sub), "seconds, %d slips", nnMiss);
  drawStdOver("PICTURE DONE!", COL_GOAL, big, sub, 60);
}

// mode: 1 fill, 2 clear a fill, 3 mark X, 4 clear an X.
static void nnApply(int mode) {
  int i = nnCurY * nnN + nnCurX;
  int cx = nnGx + nnCurX * nnCell + nnCell / 2, cy = nnGy + nnCurY * nnCell + nnCell / 2;
  if (mode == 1) {
    if (nnBd[i] == 1) return;
    if (nnSol[i]) {
      nnBd[i] = 1;
      nnLeft--;
      sfx(600 + (nnN * nnN - nnLeft) % 8 * 30, 25);
      particlesBurst(cx, cy, 3, COL_ICE);
      if (nnLeft <= 0) {
        nnWon = true;
        nnEndAt = millis() + 1000UL;
        sfxWin();
        particlesBurst(60, 60, 24, COL_GOAL);
      }
    } else {
      nnBd[i] = 2;
      if ((g_variant & 3) != 1) nnMiss++;
      sfx(140, 110);
      screenShake(100, 2);
      particlesBurst(cx, cy, 5, COL_LASER);
    }
  } else if (mode == 2) {
    return;   // a correct fill is permanent
  } else if (mode == 3) {
    if (nnBd[i] == 0) { nnBd[i] = 2; sfx(300, 15); }
  } else if (mode == 4) {
    if (nnBd[i] == 2) { nnBd[i] = 0; sfx(260, 15); }
  }
}

static void nonoFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  unsigned long dtms = (s_lastFrameMs == 0) ? 16UL : now - s_lastFrameMs;
  if (dtms > 100UL) dtms = 100UL;
  s_lastFrameMs = now;
  if (nnWon) {
    if ((long)(now - nnEndAt) >= 0) { nnToOver(); return; }
  } else {
    nnTimeMs += dtms;
    int i = nnCurY * nnN + nnCurX;
    if (pressed & ARCADA_BUTTONMASK_A) { nnPaint = 1; nnApply(1); }
    else if (pressed & ARCADA_BUTTONMASK_B) { nnPaint = nnBd[i] == 2 ? 4 : 3; nnApply(nnPaint); }
    if (!(buttons & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B))) nnPaint = 0;
    uint32_t d = navRepeat(buttons, pressed);
    if (d) {
      if (d & ARCADA_BUTTONMASK_LEFT) nnCurX = (uint8_t)((nnCurX + nnN - 1) % nnN);
      else if (d & ARCADA_BUTTONMASK_RIGHT) nnCurX = (uint8_t)((nnCurX + 1) % nnN);
      else if (d & ARCADA_BUTTONMASK_UP) nnCurY = (uint8_t)((nnCurY + nnN - 1) % nnN);
      else if (d & ARCADA_BUTTONMASK_DOWN) nnCurY = (uint8_t)((nnCurY + 1) % nnN);
      sfxMove();
      if (nnPaint && !nnWon) nnApply(nnPaint);
    }
  }
  nnDraw();
  blitScreen();
}

// --- Missile Command (61) --------------------------------------------------------------------
// Six cities sit on the ground while enemy missiles streak down at them. Move the crosshair with
// the D-pad (it speeds up the longer you hold) and press A: an interceptor flies from the bunker to
// the crosshair and bursts into a fireball that destroys any enemy missile it touches (chain
// reactions count). Each wave brings more and faster missiles (some split in two) and gives a fresh
// ammo load; survivors score a bonus and every 3rd wave one lost city is rebuilt. Tiers set the
// speed, ammo and splitting. Score = kills (25 each) + wave bonuses.
#define MC_E 16
#define MC_P 4
#define MC_X 10
#define MC_GROUND 118
static float mcEx[MC_E], mcEy[MC_E], mcSx[MC_E], mcSy[MC_E], mcTx[MC_E], mcEd[MC_E], mcEp[MC_E];
static uint8_t mcEAlive[MC_E], mcETgt[MC_E], mcESplit[MC_E];
static float mcPx[MC_P], mcPy[MC_P], mcPtx[MC_P], mcPty[MC_P];
static uint8_t mcPAlive[MC_P];
static float mcXx[MC_X], mcXy[MC_X], mcXr[MC_X];
static unsigned long mcXt0[MC_X];
static uint8_t mcXAct[MC_X];
static uint8_t mcCity[6];            // 1 = standing
static float mcCx, mcCy, mcHold;     // crosshair, hold time of the current direction
static int mcScore, mcWave, mcAmmo, mcToSpawn, mcBonus, mcKillsWave;
static uint8_t mcPhase;              // 0 wave banner, 1 playing, 2 wave cleared, 3 all cities lost
static unsigned long mcPhaseAt, mcNextSpawn;
static const char* const kMcModes[4] = {"NORMAL", "EASY SLOW, 20 AMMO", "HARD FAST, 14 AMMO", "EXTREME SPLITTERS"};

static void enterMissileTitle() {
  gameState = ST_MISSILE_TITLE;
  drawStdTitleEx("MISSILE CMD", COL_LASER, "Defend the six cities", "D-pad aim  A: fire", "Intercept the missiles", 61,
                 kMcModes[g_variant & 3]);
}

static int mcCityX(int i) { return 14 + i * 26; }
static int mcAliveCities() { int n = 0; for (int i = 0; i < 6; i++) n += mcCity[i]; return n; }

static void mcWaveStart() {
  static const uint8_t ammo[4] = {16, 20, 14, 12};
  mcWave++;
  mcToSpawn = 6 + 2 * mcWave;
  if (mcToSpawn > 24) mcToSpawn = 24;
  mcAmmo = ammo[g_variant & 3] + (mcWave > 4 ? 2 : 0);
  mcKillsWave = 0;
  mcPhase = 0;
  mcPhaseAt = millis() + 1300UL;
  mcNextSpawn = 0;
  memset(mcEAlive, 0, sizeof(mcEAlive));
  memset(mcPAlive, 0, sizeof(mcPAlive));
  memset(mcXAct, 0, sizeof(mcXAct));
  if (mcWave % 3 == 1 && mcWave > 1) {   // rebuild one lost city
    for (int i = 0; i < 6; i++) if (!mcCity[i]) { mcCity[i] = 1; break; }
  }
  sfx(500, 60);
}

static void enterMissilePlaying() {
  s_mazeRng = gameSeed();
  for (int i = 0; i < 6; i++) mcCity[i] = 1;
  mcScore = 0;
  mcWave = 0;
  mcCx = 80;
  mcCy = 60;
  mcHold = 0;
  mcBonus = 0;
  mcWaveStart();
  s_lastFrameMs = 0;
  gameState = ST_MISSILE_PLAYING;
}

static void mcExplode(float x, float y, float r) {
  for (int i = 0; i < MC_X; i++) {
    if (mcXAct[i]) continue;
    mcXAct[i] = 1;
    mcXx[i] = x;
    mcXy[i] = y;
    mcXr[i] = r;
    mcXt0[i] = millis();
    return;
  }
}

// Spawns an enemy at (sx,sy) heading for a random standing city (not `avoid` if another exists).
static bool mcSpawnEnemy(float sx, float sy, int avoid, bool allowSplit) {
  int alive = mcAliveCities();
  if (!alive) return false;
  int slot = -1;
  for (int i = 0; i < MC_E; i++) if (!mcEAlive[i]) { slot = i; break; }
  if (slot < 0) return false;
  int pick = mazeRngRange(alive), ci = 0;
  for (int i = 0; i < 6; i++) {
    if (!mcCity[i]) continue;
    if (pick-- == 0) { ci = i; break; }
  }
  if (ci == avoid && alive > 1) { for (int k = 1; k < 6; k++) if (mcCity[(ci + k) % 6]) { ci = (ci + k) % 6; break; } }
  mcSx[slot] = mcEx[slot] = sx;
  mcSy[slot] = mcEy[slot] = sy;
  mcTx[slot] = (float)mcCityX(ci) + (float)(mazeRngRange(7) - 3);
  float dx = mcTx[slot] - sx, dy = (float)MC_GROUND - sy;
  mcEd[slot] = sqrtf(dx * dx + dy * dy);
  mcEp[slot] = 0;
  mcETgt[slot] = (uint8_t)ci;
  int t = g_variant & 3;
  mcESplit[slot] = (allowSplit && (mcWave >= (t == 3 ? 2 : 4)) && mazeRngRange(100) < 30) ? 1 : 0;
  mcEAlive[slot] = 1;
  return true;
}

static void mcDraw(unsigned long now) {
  canvas->fillScreen(COL_BG);
  uint16_t cTrail = arcada.display->color565(150, 40, 40), cGround = arcada.display->color565(40, 90, 50);
  uint16_t cCity = arcada.display->color565(120, 170, 230), cRuin = arcada.display->color565(70, 60, 60);
  for (int i = 0; i < MC_E; i++) {
    if (!mcEAlive[i]) continue;
    canvas->drawLine((int)mcSx[i], (int)mcSy[i], (int)mcEx[i], (int)mcEy[i], cTrail);
    canvas->fillRect((int)mcEx[i] - 1, (int)mcEy[i] - 1, 3, 3, COL_TEXT);
  }
  for (int i = 0; i < MC_P; i++) {
    if (!mcPAlive[i]) continue;
    canvas->drawLine(80, 114, (int)mcPx[i], (int)mcPy[i], COL_ICE);
    canvas->drawRect((int)mcPtx[i] - 2, (int)mcPty[i] - 2, 5, 5, COL_ICE);
  }
  canvas->fillRect(0, MC_GROUND, 160, 10, cGround);
  for (int i = 0; i < 6; i++) {
    int x = mcCityX(i);
    if (mcCity[i]) {
      canvas->fillRect(x - 6, MC_GROUND - 5, 4, 5, cCity);
      canvas->fillRect(x - 2, MC_GROUND - 9, 4, 9, cCity);
      canvas->fillRect(x + 2, MC_GROUND - 6, 4, 6, cCity);
      canvas->drawPixel(x, MC_GROUND - 7, COL_KEY);
    } else {
      canvas->fillRect(x - 5, MC_GROUND - 2, 10, 2, cRuin);
    }
  }
  canvas->fillTriangle(72, MC_GROUND, 88, MC_GROUND, 80, MC_GROUND - 8, COL_BLUE);
  for (int i = 0; i < MC_X; i++) {
    if (!mcXAct[i]) continue;
    unsigned long age = now - mcXt0[i];
    float r = mcXr[i];
    if (age < 350UL) r = mcXr[i] * (float)age / 350.0f;
    else if (age >= 500UL) r = mcXr[i] * (850.0f - (float)age) / 350.0f;
    if (r < 1.0f) continue;
    uint16_t c = ((now / 60UL) & 1UL) ? COL_KEY : COL_ORANGE;
    canvas->fillCircle((int)mcXx[i], (int)mcXy[i], (int)r, c);
    canvas->drawCircle((int)mcXx[i], (int)mcXy[i], (int)r + 1, COL_TEXT);
  }
  int cx = (int)mcCx, cy = (int)mcCy;
  canvas->drawFastHLine(cx - 6, cy, 5, COL_GOAL);
  canvas->drawFastHLine(cx + 2, cy, 5, COL_GOAL);
  canvas->drawFastVLine(cx, cy - 6, 5, COL_GOAL);
  canvas->drawFastVLine(cx, cy + 2, 5, COL_GOAL);
  particlesUpdateDraw();
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  char b[20];
  snprintf(b, sizeof(b), "%d", mcScore);
  pt(3, 2, b);
  snprintf(b, sizeof(b), "WAVE %d", mcWave);
  ptc(COL_ICE, 62, 2, b);
  snprintf(b, sizeof(b), "AMMO %d", mcAmmo);
  ptc(mcAmmo <= 3 ? COL_LASER : COL_KEY, 157 - (int)strlen(b) * 6, 2, b);
  if (mcPhase == 0) {
    canvas->setTextSize(2);
    canvas->setTextColor(COL_KEY);
    snprintf(b, sizeof(b), "WAVE %d", mcWave);
    pt(80 - (int)strlen(b) * 6, 46, b);
    canvas->setTextSize(1);
  } else if (mcPhase == 2) {
    ptc(COL_GOAL, 34, 40, "WAVE CLEARED");
    snprintf(b, sizeof(b), "BONUS +%d", mcBonus);
    pt(80 - (int)strlen(b) * 3, 54, b);
  }
}

static void mcToOver() {
  recordResult(61, g_variant, (long)mcScore, true);
  if (g_twoPlayerMode) { twoPHandleGameEnd((long)mcScore); return; }
  gameState = ST_MISSILE_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%d", mcScore);
  snprintf(sub, sizeof(sub), "Reached wave %d", mcWave);
  drawStdOver("CITIES LOST", COL_LASER, big, sub, 61);
}

static void missileFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;
  static const float spd[4] = {1.0f, 0.8f, 1.25f, 1.5f};
  float sm = spd[g_variant & 3];
  // crosshair
  float dx = 0, dy = 0;
  if (buttons & ARCADA_BUTTONMASK_LEFT) dx -= 1;
  if (buttons & ARCADA_BUTTONMASK_RIGHT) dx += 1;
  if (buttons & ARCADA_BUTTONMASK_UP) dy -= 1;
  if (buttons & ARCADA_BUTTONMASK_DOWN) dy += 1;
  if (dx != 0 || dy != 0) { mcHold += dt; if (mcHold > 0.6f) mcHold = 0.6f; } else mcHold = 0;
  float cs = 70.0f + mcHold * 150.0f;
  mcCx += dx * cs * dt;
  mcCy += dy * cs * dt;
  if (mcCx < 3) mcCx = 3;
  if (mcCx > 156) mcCx = 156;
  if (mcCy < 14) mcCy = 14;
  if (mcCy > 108) mcCy = 108;
  if (mcPhase == 0) {
    if ((long)(now - mcPhaseAt) >= 0) { mcPhase = 1; mcNextSpawn = now + 400UL; }
  } else if (mcPhase == 1) {
    if ((pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B)) && mcAmmo > 0) {
      for (int i = 0; i < MC_P; i++) {
        if (mcPAlive[i]) continue;
        mcPAlive[i] = 1;
        mcPx[i] = 80;
        mcPy[i] = 114;
        mcPtx[i] = mcCx;
        mcPty[i] = mcCy;
        mcAmmo--;
        sfx(900, 25);
        break;
      }
    } else if ((pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B)) && mcAmmo <= 0) {
      sfxBlocked();
    }
    // spawns
    if (mcToSpawn > 0 && (long)(now - mcNextSpawn) >= 0) {
      if (mcSpawnEnemy((float)(4 + mazeRngRange(152)), 12.0f, -1, true)) mcToSpawn--;
      int base = 1100 - mcWave * 70;
      if (base < 380) base = 380;
      mcNextSpawn = now + (unsigned long)((float)(base / 2 + mazeRngRange(base)) / sm);
    }
    // interceptors
    for (int i = 0; i < MC_P; i++) {
      if (!mcPAlive[i]) continue;
      float ax = mcPtx[i] - mcPx[i], ay = mcPty[i] - mcPy[i];
      float d = sqrtf(ax * ax + ay * ay), step = 210.0f * dt;
      if (d <= step) {
        mcPAlive[i] = 0;
        mcExplode(mcPtx[i], mcPty[i], (g_variant & 3) == 3 ? 14.0f : ((g_variant & 3) == 1 ? 20.0f : 17.0f));
        sfx(240, 90);
      } else {
        mcPx[i] += ax / d * step;
        mcPy[i] += ay / d * step;
      }
    }
    // enemies
    for (int i = 0; i < MC_E; i++) {
      if (!mcEAlive[i]) continue;
      mcEp[i] += (24.0f + (float)mcWave * 3.5f) * sm * dt;
      float f = mcEp[i] / mcEd[i];
      if (f >= 1.0f) {
        mcEAlive[i] = 0;
        int ci = mcETgt[i];
        if (mcCity[ci]) {
          mcCity[ci] = 0;
          explosionBurst(mcCityX(ci), MC_GROUND - 3, 18, COL_ORANGE);
          screenShake(250, 3);
          sfxDeath();
          pixelsFlashAsync(255, 60, 0, 120);
        }
        mcExplode((float)mcCityX(ci), (float)MC_GROUND - 2.0f, 12.0f);
        continue;
      }
      mcEx[i] = mcSx[i] + (mcTx[i] - mcSx[i]) * f;
      mcEy[i] = mcSy[i] + ((float)MC_GROUND - mcSy[i]) * f;
      if (mcESplit[i] && f > 0.3f && f < 0.6f && mcEy[i] < 80.0f) {
        mcESplit[i] = 0;
        mcSpawnEnemy(mcEx[i], mcEy[i], mcETgt[i], false);
      }
    }
    // fireballs vs enemies
    for (int x = 0; x < MC_X; x++) {
      if (!mcXAct[x]) continue;
      unsigned long age = now - mcXt0[x];
      if (age >= 850UL) { mcXAct[x] = 0; continue; }
      float r = mcXr[x];
      if (age < 350UL) r = mcXr[x] * (float)age / 350.0f;
      else if (age >= 500UL) r = mcXr[x] * (850.0f - (float)age) / 350.0f;
      for (int i = 0; i < MC_E; i++) {
        if (!mcEAlive[i]) continue;
        float ex = mcEx[i] - mcXx[x], ey = mcEy[i] - mcXy[x];
        if (ex * ex + ey * ey <= (r + 1.0f) * (r + 1.0f)) {
          mcEAlive[i] = 0;
          mcScore += 25;
          mcKillsWave++;
          sfx(500 + (mcKillsWave % 6) * 90, 30);
          particlesBurst((int)mcEx[i], (int)mcEy[i], 4, COL_KEY);
          mcExplode(mcEx[i], mcEy[i], 11.0f);
        }
      }
    }
    if (mcAliveCities() == 0) {
      mcPhase = 3;
      mcPhaseAt = now + 1500UL;
      memset(mcEAlive, 0, sizeof(mcEAlive));
    } else if (mcToSpawn == 0) {
      bool busy = false;
      for (int i = 0; i < MC_E; i++) if (mcEAlive[i]) busy = true;
      for (int i = 0; i < MC_P; i++) if (mcPAlive[i]) busy = true;
      for (int i = 0; i < MC_X; i++) if (mcXAct[i]) busy = true;
      if (!busy) {
        mcBonus = mcAliveCities() * 100 + mcAmmo * 5;
        mcScore += mcBonus;
        mcPhase = 2;
        mcPhaseAt = now + 1800UL;
        sfxWin();
      }
    }
  } else if (mcPhase == 2) {
    if ((long)(now - mcPhaseAt) >= 0) mcWaveStart();
  } else {   // 3: let the last fireballs burn out, then game over
    for (int x = 0; x < MC_X; x++) if (mcXAct[x] && now - mcXt0[x] >= 850UL) mcXAct[x] = 0;
    if ((long)(now - mcPhaseAt) >= 0) { mcToOver(); return; }
  }
  mcDraw(now);
  blitScreen();
}

// --- Pipe Link (62) --------------------------------------------------------------------------
// Connect every pair of same-coloured dots with a pipe. Move the cursor onto a dot (or onto part of
// a pipe), press A to pick it up, steer with the D-pad to lay pipe (step back to undo, cross your
// own pipe to cut it back, cross another colour to cut that one), B lets go. The puzzle comes from
// a random Hamiltonian path cut into pieces, so it is always solvable (same seed = same puzzle in
// 2P). Score = seconds (lower is better). Tiers: 6x6, 5x5, 7x7, and 8x8 where every cell must be
// covered too.
#define PP_MAXN 8
#define PP_MAXC 7
static uint8_t ppN, ppK, ppCell, ppX0, ppY0;
static uint8_t ppEp[PP_MAXN * PP_MAXN], ppOwn[PP_MAXN * PP_MAXN];
static uint8_t ppPath[PP_MAXC + 1][PP_MAXN * PP_MAXN], ppLen[PP_MAXC + 1], ppDone[PP_MAXC + 1];
static uint8_t ppCur, ppAct;
static unsigned long ppTimeMs, ppEndAt;
static bool ppWon;
static const char* const kPpModes[4] = {"NORMAL 6x6", "EASY 5x5", "HARD 7x7", "EXTREME 8x8 FULL"};

static void enterPipeTitle() {
  gameState = ST_PIPE_TITLE;
  drawStdTitleEx("PIPE LINK", COL_TELE_A, "Join the matching dots", "A: grab  D-pad: draw", "B: let go. Cross = cut", 62,
                 kPpModes[g_variant & 3]);
}

static void ppGen() {
  int n = ppN, N = n * n;
  uint8_t path[PP_MAXN * PP_MAXN];
  for (int r = 0; r < n; r++) for (int c = 0; c < n; c++) path[r * n + c] = (uint8_t)(r * n + ((r & 1) ? n - 1 - c : c));
  for (int it = 0; it < N * 40; it++) {   // "backbite" moves keep it a Hamiltonian path
    bool tail = mazeRngRange(2) != 0;
    int e = tail ? path[N - 1] : path[0], er = e / n, ec = e % n;
    int d = mazeRngRange(4);
    int nr = er + (d == 0 ? -1 : (d == 1 ? 1 : 0)), nc = ec + (d == 2 ? -1 : (d == 3 ? 1 : 0));
    if (nr < 0 || nr >= n || nc < 0 || nc >= n) continue;
    int nb = nr * n + nc, j = 0;
    while (path[j] != nb) j++;
    int lo, hi;
    if (tail) { if (j >= N - 2) continue; lo = j + 1; hi = N - 1; }
    else { if (j <= 1) continue; lo = 0; hi = j - 1; }
    while (lo < hi) { uint8_t t = path[lo]; path[lo] = path[hi]; path[hi] = t; lo++; hi--; }
  }
  memset(ppEp, 0, sizeof(ppEp));
  int base = N / ppK, jit = base / 4;
  int b[PP_MAXC + 1];
  b[0] = 0;
  for (int s = 1; s < ppK; s++) b[s] = s * base + (jit ? mazeRngRange(2 * jit + 1) - jit : 0);
  b[ppK] = N;
  for (int s = 0; s < ppK; s++) {
    ppEp[path[b[s]]] = (uint8_t)(s + 1);
    ppEp[path[b[s + 1] - 1]] = (uint8_t)(s + 1);
  }
}

static void enterPipePlaying() {
  s_mazeRng = gameSeed();
  static const uint8_t sizes[4] = {6, 5, 7, 8}, pairs[4] = {5, 4, 6, 7};
  ppN = sizes[g_variant & 3];
  ppK = pairs[g_variant & 3];
  ppCell = (uint8_t)(ppN == 5 ? 21 : (ppN == 6 ? 18 : (ppN == 7 ? 15 : 13)));
  ppX0 = 4;
  ppY0 = 16;
  ppGen();
  memset(ppOwn, 0, sizeof(ppOwn));
  memset(ppLen, 0, sizeof(ppLen));
  memset(ppDone, 0, sizeof(ppDone));
  for (int i = 0; i < ppN * ppN; i++) if (ppEp[i]) ppOwn[i] = ppEp[i];
  ppCur = 0;
  ppAct = 0;
  ppTimeMs = 0;
  ppWon = false;
  ppEndAt = 0;
  s_navAt = millis() + 300UL;
  s_lastFrameMs = 0;
  gameState = ST_PIPE_PLAYING;
}

static void ppCols(uint16_t* pc) {
  pc[1] = COL_LASER;
  pc[2] = COL_KEY;
  pc[3] = COL_GOAL;
  pc[4] = arcada.display->color565(70, 150, 255);
  pc[5] = COL_ORANGE;
  pc[6] = arcada.display->color565(200, 90, 240);
  pc[7] = arcada.display->color565(60, 230, 230);
}

static int ppFilled() {
  int n = 0;
  for (int i = 0; i < ppN * ppN; i++) if (ppOwn[i]) n++;
  return n;
}

// Removes every non-endpoint cell of colour c's pipe.
static void ppClear(int c) {
  for (int k = 0; k < ppLen[c]; k++) {
    int cell = ppPath[c][k];
    if (!ppEp[cell]) ppOwn[cell] = 0;
  }
  ppLen[c] = 0;
  ppDone[c] = 0;
}

// Pops cells from c's pipe until `cell` is its head.
static void ppTruncate(int c, int cell) {
  while (ppLen[c] > 0 && ppPath[c][ppLen[c] - 1] != cell) {
    int x = ppPath[c][--ppLen[c]];
    if (!ppEp[x]) ppOwn[x] = 0;
  }
  ppDone[c] = 0;
}

static void ppDraw() {
  canvas->fillScreen(COL_BG);
  uint16_t pc[PP_MAXC + 1];
  ppCols(pc);
  uint16_t cCell = arcada.display->color565(24, 26, 42);
  int cs = ppCell, w = cs / 6 + 1;
  for (int i = 0; i < ppN * ppN; i++) {
    int x = ppX0 + (i % ppN) * cs, y = ppY0 + (i / ppN) * cs;
    uint16_t bg = cCell;
    if (ppOwn[i] && ppDone[ppOwn[i]]) bg = animBlend(cCell, pc[ppOwn[i]], 60);
    canvas->fillRect(x + 1, y + 1, cs - 1, cs - 1, bg);
  }
  for (int c = 1; c <= ppK; c++) {
    for (int k = 0; k < ppLen[c]; k++) {
      int a = ppPath[c][k];
      int ax = ppX0 + (a % ppN) * cs + cs / 2, ay = ppY0 + (a / ppN) * cs + cs / 2;
      canvas->fillRect(ax - w, ay - w, 2 * w + 1, 2 * w + 1, pc[c]);
      if (k + 1 < ppLen[c]) {
        int b = ppPath[c][k + 1];
        int bx = ppX0 + (b % ppN) * cs + cs / 2, by = ppY0 + (b / ppN) * cs + cs / 2;
        int x0 = ax < bx ? ax : bx, y0 = ay < by ? ay : by;
        canvas->fillRect(x0 - w, y0 - w, (ax > bx ? ax - bx : bx - ax) + 2 * w + 1, (ay > by ? ay - by : by - ay) + 2 * w + 1, pc[c]);
      }
    }
  }
  for (int i = 0; i < ppN * ppN; i++) {
    if (!ppEp[i]) continue;
    int x = ppX0 + (i % ppN) * cs + cs / 2, y = ppY0 + (i / ppN) * cs + cs / 2;
    canvas->fillCircle(x, y, cs / 3, pc[ppEp[i]]);
    if (ppAct == ppEp[i]) canvas->drawCircle(x, y, cs / 3 + 2, COL_TEXT);
  }
  int cx = ppX0 + (ppCur % ppN) * cs, cy = ppY0 + (ppCur / ppN) * cs;
  uint16_t cc = ppAct ? pc[ppAct] : COL_TEXT;
  canvas->drawRect(cx, cy, cs + 1, cs + 1, cc);
  canvas->drawRect(cx + 1, cy + 1, cs - 1, cs - 1, cc);
  canvas->setTextSize(1);
  ptc(COL_TELE_A, 4, 3, "PIPE LINK");
  int px = ppX0 + ppN * cs + 6;
  char b[16];
  unsigned long sec = ppTimeMs / 1000UL;
  ptc(COL_TEXT, px, 16, "TIME");
  snprintf(b, sizeof(b), "%lu:%02lu", sec / 60UL, sec % 60UL);
  ptc(COL_KEY, px, 26, b);
  int done = 0;
  for (int c = 1; c <= ppK; c++) done += ppDone[c];
  ptc(COL_TEXT, px, 42, "LINKS");
  canvas->setTextColor(done == ppK ? COL_GOAL : COL_ICE);
  canvas->setCursor(px, 52);
  snprintf(b, sizeof(b), "%d/%d", done, ppK);
  canvas->print(b);
  ptc(COL_TEXT, px, 68, "FILL");
  canvas->setCursor(px, 78);
  snprintf(b, sizeof(b), "%d%%", ppFilled() * 100 / (ppN * ppN));
  canvas->print(b);
  particlesUpdateDraw();
}

static void ppToOver() {
  long score = (long)(ppTimeMs / 1000UL);
  if (score < 1) score = 1;
  recordResult(62, g_variant, score, false);
  if (g_twoPlayerMode) { twoPHandleGameEnd(score); return; }
  gameState = ST_PIPE_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%ld", score);
  snprintf(sub, sizeof(sub), "seconds, %d pipes", ppK);
  drawStdOver("ALL LINKED!", COL_GOAL, big, sub, 62);
}

static void ppCheckWin() {
  for (int c = 1; c <= ppK; c++) if (!ppDone[c]) return;
  if ((g_variant & 3) == 3 && ppFilled() < ppN * ppN) return;
  ppWon = true;
  ppEndAt = millis() + 1000UL;
  ppAct = 0;
  sfxWin();
  particlesBurst(60, 70, 24, COL_GOAL);
}

// Cursor step toward cell t. While a pipe is held it lays / undoes / cuts; returns false if blocked.
static bool ppStep(int t) {
  if (!ppAct) { ppCur = (uint8_t)t; return true; }
  int c = ppAct, len = ppLen[c], head = ppPath[c][len - 1];
  if (len >= 2 && t == ppPath[c][len - 2]) {   // step back = undo
    if (!ppEp[head]) ppOwn[head] = 0;
    ppLen[c]--;
    ppCur = (uint8_t)t;
    sfx(300, 12);
    return true;
  }
  if (ppEp[t] && ppEp[t] != c) return false;   // other colour's dot
  if (ppEp[t] == c) {
    if (t == ppPath[c][0]) return false;
    ppPath[c][ppLen[c]++] = (uint8_t)t;         // reached the partner dot
    ppDone[c] = 1;
    ppAct = 0;
    ppCur = (uint8_t)t;
    sfx(880, 70);
    particlesBurst(ppX0 + (t % ppN) * ppCell + ppCell / 2, ppY0 + (t / ppN) * ppCell + ppCell / 2, 8, COL_TEXT);
    ppCheckWin();
    return true;
  }
  if (ppOwn[t] == c) {                          // crossed itself: cut back to there
    ppTruncate(c, t);
    ppCur = (uint8_t)t;
    sfx(300, 12);
    return true;
  }
  if (ppOwn[t]) ppClear(ppOwn[t]);              // cut another colour's pipe
  ppOwn[t] = (uint8_t)c;
  ppPath[c][ppLen[c]++] = (uint8_t)t;
  ppCur = (uint8_t)t;
  sfx(520 + ppLen[c] * 12, 12);
  return true;
}

static void pipeFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  unsigned long dtms = (s_lastFrameMs == 0) ? 16UL : now - s_lastFrameMs;
  if (dtms > 100UL) dtms = 100UL;
  s_lastFrameMs = now;
  if (ppWon) {
    if ((long)(now - ppEndAt) >= 0) { ppToOver(); return; }
  } else {
    ppTimeMs += dtms;
    uint32_t d = navRepeat(buttons, pressed);
    if (d) {
      int r = ppCur / ppN, c = ppCur % ppN;
      if ((d & ARCADA_BUTTONMASK_LEFT) && c > 0) c--;
      else if ((d & ARCADA_BUTTONMASK_RIGHT) && c < ppN - 1) c++;
      else if ((d & ARCADA_BUTTONMASK_UP) && r > 0) r--;
      else if ((d & ARCADA_BUTTONMASK_DOWN) && r < ppN - 1) r++;
      else d = 0;
      if (d) {
        if (!ppStep(r * ppN + c)) sfxBlocked();
        else if (!ppAct) sfxMove();
      }
    }
    if (pressed & ARCADA_BUTTONMASK_A) {
      int t = ppCur;
      if (ppEp[t]) {
        int col = ppEp[t];
        ppClear(col);
        ppPath[col][0] = (uint8_t)t;
        ppLen[col] = 1;
        ppAct = (uint8_t)col;
        sfx(700, 25);
      } else if (ppOwn[t]) {
        ppAct = ppOwn[t];
        ppTruncate(ppAct, t);
        sfx(700, 25);
      } else {
        sfxBlocked();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      if (ppAct) { ppAct = 0; sfx(400, 20); }
    }
  }
  ppDraw();
  blitScreen();
}

// =====================================================================================
// Expansion cartridges: /carts/<name>.arc, a tiny bytecode VM ("ARC1"), see tools/README_CARTS.txt.
// The executable spec is tools/arcvm_ref.py (same opcodes, same int16 maths); tools/make_carts.py
// compiles the cart language to this format.  Nothing is compiled into the sketch except the VM:
// every cartridge is data on the drive, listed by cartScan() at boot and shown by the picker as
// a game of its own (ids CART_BASE + index, "EXPANSIONS" filter).
//   File : header 208 B + payload.  Header: "ARC1", u8 fmt=1, u8 flags (1 = 2P, 2 = lower score wins),
//          u8 cartVer, u8 nSprites, u16 codeLen, u16 strLen, u16 memWords, u16 memInit, u16 initAddr,
//          u16 frameAddr, u32 FNV-1a(payload), u8 nGlobals, u8 colour, name[16]@32, blurb[24]@48,
//          author[16]@72, 4 tier names[8]@88, icon[8]@120, 3 help lines[24]@128.
//          Payload: code, string pool, sprites (8 B each), memInit int16 LE words.
// Safety: every memory / array / stack / call / string / sprite access is bounds-checked, each frame
// may run at most CART_BUDGET opcodes, a fault shows a message and returns to the picker, the cart
// only ever sees its own heap block (plus 16 save bytes persisted in /arcadia/carts.bin).
// =====================================================================================
#define CART_DIR "/carts"
#define CART_BIN_PATH "/arcadia/carts.bin"
#define CART_TMP_PATH "/arcadia/carts.tmp"
#define CART_HDR 208
#define CART_FILE_MAX 14000
#define CART_BUDGET 30000UL
#define CART_RAM_MARGIN 4096UL


static int s_cartCur = -1;            // index into s_carts[] of the cart being shown / played
static unsigned long s_cartNextMs = 0;
static char s_cartHead[24];           // game-over headline chosen by the cart
static char s_cartErrMsg[28];
static uint16_t s_cartLastErr = 0;     // last cart error code (0 = none)
static uint32_t s_cartLastRam = 0;    // bytes the last loaded cart needed

static uint32_t cartFnv(const uint8_t* b, size_t n, uint32_t h) {
  for (size_t i = 0; i < n; i++) h = (h ^ b[i]) * 16777619UL;
  return h;
}
static uint16_t cvLe16(const uint8_t* p) { return (uint16_t)(p[0] | (p[1] << 8)); }
static uint32_t cvLe32(const uint8_t* p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }

// Validates a header read from a file of fileSize bytes; fills the numbers the loader needs.
static bool cartParseHdr(const uint8_t* h, uint32_t fileSize, CartInfo* ci) {
  if (memcmp(h, "ARC1", 4) != 0 || h[4] != 1) return false;
  ci->flags = h[5];
  ci->nspr = h[7];
  ci->codeLen = cvLe16(h + 8);
  ci->strLen = cvLe16(h + 10);
  ci->memWords = cvLe16(h + 12);
  ci->memInit = cvLe16(h + 14);
  ci->initAddr = cvLe16(h + 16);
  ci->frameAddr = cvLe16(h + 18);
  ci->sum = cvLe32(h + 20);
  ci->col = (uint8_t)(h[25] & 15);
  if (h[24] > CV_GLOBALS || ci->nspr > 64 || ci->codeLen == 0 || ci->codeLen > 8192 || ci->strLen > 2048 ||
      ci->memWords > 1024 || ci->memInit > ci->memWords || ci->initAddr >= ci->codeLen || ci->frameAddr >= ci->codeLen)
    return false;
  uint32_t pay = (uint32_t)ci->codeLen + ci->strLen + (uint32_t)ci->nspr * 8 + (uint32_t)ci->memInit * 2;
  if (fileSize != CART_HDR + pay) return false;
  if (h[32] < 32 || h[32] > 126) return false;     // name must start with a printable character
  if (h[47] != 0 || h[71] != 0) return false;      // name / blurb must be NUL terminated
  return true;
}

// ---- carts.bin: [ "ACB1", u16 count, u16 0, count x 40 B records, u32 FNV-1a of all before ] ----
#define CB_REC_SIZE 40
#define CB_FILE_MAX (8 + CART_MAX * CB_REC_SIZE + 4)
static void cartRecEncode(const CartRec* r, uint8_t* o) {
  memcpy(o, &r->key, 4);
  memcpy(o + 4, &r->plays, 2);
  o[6] = 0; o[7] = 0;
  memcpy(o + 8, r->best, 16);
  memcpy(o + 24, r->save, 16);
}
static void cartRecDecode(const uint8_t* i, CartRec* r) {
  memcpy(&r->key, i, 4);
  memcpy(&r->plays, i + 4, 2);
  r->pad = 0;
  memcpy(r->best, i + 8, 16);
  memcpy(r->save, i + 24, 16);
}
// Reads one candidate file; true when magic, size and checksum are all right.
static bool cartBinRead(const char* path) {
  if (!arcada.exists(path)) return false;
  File f = arcada.open(path, O_READ);
  if (!f) return false;
  uint8_t buf[CB_FILE_MAX];
  uint32_t sz = (uint32_t)f.size();
  bool ok = sz >= 12 && sz <= CB_FILE_MAX && f.read(buf, sz) == (int)sz;
  f.close();
  if (!ok || memcmp(buf, "ACB1", 4) != 0) return false;
  uint16_t n = cvLe16(buf + 4);
  if (n > CART_MAX || sz != (uint32_t)(8 + n * CB_REC_SIZE + 4)) return false;
  if (cartFnv(buf, sz - 4, 2166136261UL) != cvLe32(buf + sz - 4)) return false;
  s_cbN = (uint8_t)n;
  for (int i = 0; i < n; i++) cartRecDecode(buf + 8 + i * CB_REC_SIZE, &s_cbRec[i]);
  return true;
}
static void cartBinLoad() {
  s_cbN = 0;
  memset(s_cbRec, 0, sizeof(s_cbRec));
  if (!bannerFsOk()) return;
  if (!cartBinRead(CART_BIN_PATH) && !cartBinRead(CART_TMP_PATH)) { s_cbN = 0; memset(s_cbRec, 0, sizeof(s_cbRec)); }
}
static bool cartWriteVerified(const char* path, const uint8_t* b, size_t n) {
  if (arcada.exists(path)) arcada.remove(path);
  File f = arcada.open(path, O_WRITE | O_CREAT | O_TRUNC);
  if (!f) return false;
  size_t w = f.write(b, n);
  f.close();
  if (w != n) return false;
  File r = arcada.open(path, O_READ);
  if (!r) return false;
  uint8_t chk[32];
  size_t pos = 0;
  bool same = true;
  while (same && pos < n) {
    size_t want = n - pos < sizeof(chk) ? n - pos : sizeof(chk);
    if (r.read(chk, want) != (int)want || memcmp(chk, b + pos, want) != 0) same = false;
    pos += want;
  }
  r.close();
  return same;
}
// Atomic: carts.tmp is written and verified first, then carts.bin is replaced, then the tmp goes.
// A power cut leaves at least one complete copy (loading prefers carts.bin, falls back to carts.tmp).
static void cartBinSave() {
  if (!bannerFsOk()) return;
  uint8_t buf[CB_FILE_MAX];
  memcpy(buf, "ACB1", 4);
  buf[4] = s_cbN; buf[5] = 0; buf[6] = 0; buf[7] = 0;
  for (int i = 0; i < s_cbN; i++) cartRecEncode(&s_cbRec[i], buf + 8 + i * CB_REC_SIZE);
  size_t n = 8 + (size_t)s_cbN * CB_REC_SIZE;
  uint32_t h = cartFnv(buf, n, 2166136261UL);
  memcpy(buf + n, &h, 4);
  n += 4;
  if (!arcada.exists("/arcadia")) arcada.mkdir("/arcadia");
  if (!cartWriteVerified(CART_TMP_PATH, buf, n)) { Serial.println("Carts: save failed"); errLog(306); return; }
  if (cartWriteVerified(CART_BIN_PATH, buf, n)) arcada.remove(CART_TMP_PATH);
  Arcada_QSPI_Flash.syncBlocks();
}
// --- Factory reset (Settings -> Factory reset) -----------------------------------------------------
// Warning screen, hold A/Start ~2 s (B/Select cancels), automatic backup into /arcadia/bak, then every
// user file is removed (saves, levels, quest, carts.bin/tmp) and the console reboots. Installed content
// (assets, packs, worlds, data, carts, roms, README) is never touched. g_usbDriveMode is raised before the
// first deletion so no pending/debounced save can write RAM state back; the reboot rebuilds all defaults.
static void frMsg(const char *t1, const char *t2, const char *t3) {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  usbCenter(4, "FACTORY RESET", COL_ORANGE);
  usbCenter(40, t1, COL_TEXT);
  usbCenter(54, t2, COL_TEXT);
  usbCenter(68, t3, COL_KEY);
  blitScreen();
}
static void frWaitPress() {
  for (int i = 0; i < 100 && arcada.readButtons(); i++) delay(20);
  delay(300);
  while (!arcada.readButtons()) delay(20);
}
static int frRm(const char *p) {   // 1 = the file is still there afterwards
  if (!arcada.exists(p)) return 0;
  arcada.remove(p);
  return arcada.exists(p) ? 1 : 0;
}
static void frProgress(int pct) {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  usbCenter(50, "Resetting...", COL_ORANGE);
  canvas->drawRect(20, 66, 120, 10, COL_TEXT);
  canvas->fillRect(22, 68, 116 * pct / 100, 6, COL_GOAL);
  blitScreen();
}
static void factoryReset() {
  if (g_usbDriveMode) { toastShow("Not in USB drive mode"); sfxBlocked(); return; }
  if (s_lvlFsIsRam || !s_lvlFsReady) { errToast(105); sfxBlocked(); return; }
  bool armed = false, holding = false;
  unsigned long t0 = 0;
  for (;;) {
    uint32_t b = arcada.readButtons();
    if (b & (ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_SELECT)) { sfx(300, 40); return; }
    if (!(b & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START))) { armed = true; holding = false; }
    else if (armed) {
      if (!holding) { holding = true; t0 = millis(); }
      if (millis() - t0 >= 2000UL) break;
    }
    int pct = holding ? (int)((millis() - t0) / 20UL) : 0;
    if (pct > 100) pct = 100;
    canvas->fillScreen(COL_BG);
    canvas->setTextSize(1);
    usbCenter(3, "FACTORY RESET", COL_ORANGE);
    usbCenter(16, "Erases all scores, stats,", COL_TEXT);
    usbCenter(26, "settings, levels, progress.", COL_TEXT);
    usbCenter(36, "Installed games/files kept.", COL_KEY);
    usbCenter(50, "A backup is saved first.", COL_TEXT);
    usbCenter(60, "Undo: Settings >", COL_TEXT);
    usbCenter(70, "Restore backup", COL_TEXT);
    canvas->drawRect(20, 86, 120, 10, COL_TEXT);
    canvas->fillRect(22, 88, 116 * pct / 100, 6, COL_ORANGE);
    usbCenter(104, "Hold A/Start 2s = erase", COL_TEXT);
    usbCenter(116, "B = cancel", COL_ICE);
    blitScreen();
    delay(20);
  }
  frMsg("Saving a backup...", "", "");
  saveWrite();
  int want = 0;
  for (int i = 0; i < 3; i++) if (arcada.exists(bakLive(i))) want++;
  if (bakAll() < want) {
    errLog(107);
    frMsg("Backup failed. (E107)", "Nothing was erased.", "Press any button");
    sfxBlocked();
    frWaitPress();
    return;
  }
  g_usbDriveMode = true;   // from here on nothing may write RAM state back to the volume
  int bad = 0;
  char path[48];
  for (int g = 0; g < LVL_NUM_GAMES; g++) {
    frProgress(g * 80 / LVL_NUM_GAMES);
    for (int sl = 0; sl < LVL_SLOTS; sl++)
      for (int w = 0; w < 3; w++) {
        lvlSlotPath((uint8_t)g, (uint8_t)sl, w, path, sizeof(path));
        bad += frRm(path);
      }
  }
  frProgress(85);
  bad += frRm(LVL_TMP_PATH);
  bad += frRm(QS_PATH0);
  bad += frRm(QS_PATH1);
  bad += frRm(CART_BIN_PATH);
  bad += frRm(CART_TMP_PATH);
  bad += frRm(SAVE_EXT_PATH);   // save files last: an interrupted wipe keeps one consistent set
  bad += frRm(SAVE_MISC_PATH);
  bad += frRm(SAVE_PATH);
  Arcada_QSPI_Flash.syncBlocks();
  frProgress(100);
  sfxDeath();
  delay(400);
  if (bad > 0) {
    char m[28];
    snprintf(m, sizeof(m), "%d files could not be", bad);
    frMsg(m, "removed. Backup saved.", "A: reboot");
  } else {
    frMsg("Done. Backup saved.", "Undo: Settings >", "Restore backup");
  }
  frWaitPress();
  usbFinish();   // "Rebooting..." then NVIC_SystemReset(): does not return
}
// The record of cart k, created on first use (when full, the least-played record is recycled).
static CartRec* cartRecMake(int k) {
  CartRec* r = cartRecOf(k);
  if (r) return r;
  if (k < 0 || k >= (int)s_cartN) return NULL;
  int slot;
  if (s_cbN < CART_MAX) slot = s_cbN++;
  else {
    slot = 0;
    for (int i = 1; i < CART_MAX; i++) if (s_cbRec[i].plays < s_cbRec[slot].plays) slot = i;
  }
  memset(&s_cbRec[slot], 0, sizeof(CartRec));
  s_cbRec[slot].key = s_carts[k].key;
  for (int t = 0; t < 4; t++) s_cbRec[slot].best[t] = SAVE_NO_SCORE;
  return &s_cbRec[slot];
}

// ---- scan /carts ----
static bool cartNameIsArc(const char* n) {
  size_t l = strlen(n);
  return l >= 5 && l < 20 && n[0] != '.' && strcasecmp(n + l - 4, ".arc") == 0;
}
static void cartScan() {
  s_cartN = 0;
  s_cartBad = 0;
  s_cartDirOk = false;
  if (!bannerFsOk() || !arcada.exists(CART_DIR)) return;
  File dir = arcada.open(CART_DIR);
  if (!dir) return;
  s_cartDirOk = true;
  for (int guard = 0; guard < 96; guard++) {
    File e = dir.openNextFile();
    if (!e) break;
    char nm[32];
    nm[0] = 0;
    e.getName(nm, sizeof(nm));
    bool skip = e.isDirectory();
    uint32_t sz = (uint32_t)e.size();
    uint8_t h[CART_HDR];
    CartInfo ci;
    bool ok = false;
    if (!skip && nm[0] && cartNameIsArc(nm)) {
      ok = sz >= CART_HDR && sz <= CART_FILE_MAX && e.read(h, CART_HDR) == CART_HDR && cartParseHdr(h, sz, &ci);
      if (!ok) s_cartBad++;
    } else if (!skip && nm[0] && nm[0] != '.' && strlen(nm) > 4 && strcasecmp(nm + strlen(nm) - 4, ".arc") == 0) {
      s_cartBad++;   // a .arc whose name is too long
    }
    e.close();
    if (!ok) continue;
    if (s_cartN >= CART_MAX) { s_cartBad++; continue; }
    CartEntry& c = s_carts[s_cartN];
    memset(&c, 0, sizeof(c));
    strncpy(c.file, nm, sizeof(c.file) - 1);
    memcpy(c.name, h + 32, 15);
    memcpy(c.blurb, h + 48, 23);
    memcpy(c.icon, h + 120, 8);
    c.col = ci.col;
    c.flags = (uint8_t)(ci.flags & 3);
    uint32_t key = 2166136261UL;
    for (const char* q = nm; *q; q++) key = (key ^ (uint8_t)tolower((unsigned char)*q)) * 16777619UL;
    c.key = key;
    s_cartN++;
  }
  dir.close();
  for (int i = 1; i < (int)s_cartN; i++) {   // insertion sort by display name
    CartEntry t = s_carts[i];
    int j = i - 1;
    while (j >= 0 && strcasecmp(s_carts[j].name, t.name) > 0) { s_carts[j + 1] = s_carts[j]; j--; }
    s_carts[j + 1] = t;
  }
  Serial.print("Carts: found ");
  Serial.println((int)s_cartN);
}

// ---- load / release ----
static void cartRelease() {
  if (!s_cv) return;
  if (s_cv->saveDirty && s_cartCur >= 0) {
    CartRec* r = cartRecMake(s_cartCur);
    if (r) { memcpy(r->save, s_cv->save, 16); cartBinSave(); }
  }
  extMemPut(s_cv);
  s_cv = NULL;
}
static void cartError(uint16_t code, const char* detail) {
  snprintf(s_cartErrMsg, sizeof(s_cartErrMsg), "%s", detail ? detail : "");
  s_cartLastErr = code;
  errLog(code);
  cartRelease();
  gameState = ST_CART_ERR;
  errDraw(code, s_cartErrMsg);
  ptc(COL_TEXT, 4, 92, s_cartCur >= 0 && s_cartCur < (int)s_cartN ? s_carts[s_cartCur].name : "?");
  pt(4, 108, "A/B: back to games");
  sfxDeath();
  blitScreen();
}

static void cartStartEntry(CartVm& v, uint16_t addr) {
  v.pc = addr;
  v.sp = 0;
  v.cd = 0;
  v.fp = 0;
  v.lsp = 0;
}

// Loads /carts/<file> into one heap block; returns 0 on success or an error code (E3xx).
static uint16_t cartLoad(const char* file) {
  if (!bannerFsOk()) return 301;
  char path[40];
  snprintf(path, sizeof(path), CART_DIR "/%s", file);
  File f = arcada.open(path, O_READ);
  if (!f) return 302;
  uint32_t sz = (uint32_t)f.size();
  uint8_t h[CART_HDR];
  CartInfo ci;
  if (sz < CART_HDR || sz > CART_FILE_MAX || f.read(h, CART_HDR) != CART_HDR || !cartParseHdr(h, sz, &ci)) {
    f.close();
    return 303;
  }
  uint32_t pay = sz - CART_HDR;
  uint32_t off0 = (sizeof(CartVm) + 3U) & ~3U;
  uint32_t offMem = (off0 + pay + 3U) & ~3U;
  uint32_t need = offMem + (uint32_t)ci.memWords * 2U + 4U;
  s_cartLastRam = need;
  if (!extMemFits(need, CART_RAM_MARGIN)) { f.close(); return 305; }
  uint8_t* blk = extMemGet(need);
  if (!blk) { f.close(); return 305; }
  uint8_t* pp = blk + off0;
  bool ok = true;
  uint32_t got = 0;
  while (ok && got < pay) {
    uint32_t want = pay - got > 256 ? 256 : pay - got;
    int r = f.read(pp + got, want);
    if (r <= 0) ok = false; else got += (uint32_t)r;
  }
  f.close();
  if (!ok || cartFnv(pp, pay, 2166136261UL) != ci.sum) { extMemPut(blk); return 304; }
  memset(blk, 0, sizeof(CartVm));
  CartVm& v = *(CartVm*)blk;
  v.code = pp;
  v.strs = pp + ci.codeLen;
  v.spr = v.strs + ci.strLen;
  v.mem = (int16_t*)(blk + offMem);
  v.codeLen = ci.codeLen;
  v.strLen = ci.strLen;
  v.memWords = ci.memWords;
  v.frameAddr = ci.frameAddr;
  v.nspr = ci.nspr;
  memset(v.mem, 0, (size_t)ci.memWords * 2U);
  memcpy(v.mem, v.spr + (uint32_t)ci.nspr * 8U, (size_t)ci.memInit * 2U);
  for (int i = 0; i < 8; i++) v.pal[i] = 0xFFFF;
  v.tsz = 1;
  cartStartEntry(v, ci.initAddr);
  s_cv = &v;
  return 0;
}

// ---- the interpreter ----
static const uint16_t kCartSfx[8][2] = {{500, 20}, {700, 40}, {1047, 90}, {110, 260}, {880, 70}, {1500, 30}, {300, 30}, {600, 45}};
static const int8_t kCartSinQ[65] = {
  0, 3, 6, 9, 12, 16, 19, 22, 25, 28, 31, 34, 37,
  40, 43, 46, 49, 51, 54, 57, 60, 63, 65, 68, 71, 73,
  76, 78, 81, 83, 85, 88, 90, 92, 94, 96, 98, 100, 102,
  104, 106, 107, 109, 111, 112, 113, 115, 116, 117, 118, 120, 121,
  122, 122, 123, 124, 125, 125, 126, 126, 126, 127, 127, 127, 127};
static int cartSin(int a) {
  a &= 255;
  if (a <= 64) return kCartSinQ[a];
  if (a <= 128) return kCartSinQ[128 - a];
  if (a <= 192) return -kCartSinQ[a - 128];
  return -kCartSinQ[256 - a];
}
static inline int16_t cvPop(CartVm& v) {
  if (v.sp == 0) { v.err = "Stack underflow"; return 0; }
  return v.st[--v.sp];
}
static inline void cvPush(CartVm& v, int32_t x) {
  if (v.sp >= CV_STACK) { v.err = "Stack overflow"; return; }
  v.st[v.sp++] = (int16_t)x;
}
static inline uint16_t cvCol(int16_t c) { uint16_t u = (uint16_t)c; return u < 16 ? kCartPal[u] : u; }
// String pool access: returns a pointer to a NUL-terminated string inside the pool (or "" + error).
static const char* cvStr(CartVm& v, int16_t off) {
  if (off < 0 || off >= (int)v.strLen || memchr(v.strs + off, 0, v.strLen - (size_t)off) == NULL) { v.err = "Bad string"; return ""; }
  return (const char*)(v.strs + off);
}
static void cvRect(int x, int y, int w, int h, uint16_t c) {
  if (w <= 0 || h <= 0) return;
  if (x < 0) { w += x; x = 0; }
  if (y < 0) { h += y; y = 0; }
  if (x + w > 160) w = 160 - x;
  if (y + h > 128) h = 128 - y;
  if (w > 0 && h > 0) canvas->fillRect(x, y, w, h, c);
}
static void cvText(CartVm& v, int x, int y, uint16_t c, const char* s) {
  int sz = v.tsz;
  for (int i = 0; s[i] && i < 80; i++) {
    int cx = x + i * 6 * sz;
    if (cx >= 160) break;
    if (cx + 6 * sz <= 0 || s[i] < 32 || s[i] > 126) continue;
    canvas->drawChar(cx, y, (unsigned char)s[i], c, c, (uint8_t)sz);
  }
}
static void cvSprite(CartVm& v, int x, int y, int idx, uint16_t c, int flags) {
  if (idx < 0 || idx >= v.nspr) { v.err = "Bad sprite"; return; }
  const uint8_t* sp = v.spr + idx * 8;
  int sc = (flags & 4) ? 2 : 1;
  if (x > 160 || y > 128 || x + 8 * sc < 0 || y + 8 * sc < 0) return;
  for (int r = 0; r < 8; r++) {
    uint8_t row = sp[(flags & 2) ? 7 - r : r];
    if (!row) continue;
    for (int cc = 0; cc < 8; cc++) {
      uint8_t bit = (flags & 1) ? (uint8_t)(1u << cc) : (uint8_t)(0x80u >> cc);
      if (!(row & bit)) continue;
      if (sc == 1) canvas->drawPixel(x + cc, y + r, c);
      else canvas->fillRect(x + cc * 2, y + r * 2, 2, 2, c);
    }
  }
}
static bool cvMapOk(CartVm& v, int base, int w, int h) {
  if (w < 0 || h < 0 || base < 0 || base + w * h > (int)v.memWords) { v.err = "Map out of range"; return false; }
  return true;
}

// Runs until the frame ends (RET of the entry stub), wait(), gameover() or a fault (v.err).
static void cartRun() {
  CartVm& v = *s_cv;
  const uint8_t* code = v.code;
  const uint16_t n = v.codeLen;
  uint32_t ops = 0;
  v.err = NULL;
  while (!v.err && !v.over) {
    if (++ops > CART_BUDGET) { v.err = "Cart too slow"; break; }
    if (v.pc >= n) { v.err = "Ran off the code"; break; }
    uint8_t op = code[v.pc++];
    int32_t a, b;
    switch (op) {
      case 1:
        if (v.pc + 1 > n) { v.err = "Truncated code"; break; }
        cvPush(v, (int8_t)code[v.pc++]);
        break;
      case 2:
        if (v.pc + 2 > n) { v.err = "Truncated code"; break; }
        cvPush(v, (int16_t)(code[v.pc] | (code[v.pc + 1] << 8)));
        v.pc += 2;
        break;
      case 3: a = cvPop(v); cvPush(v, a); cvPush(v, a); break;
      case 4: cvPop(v); break;
      case 5: b = cvPop(v); a = cvPop(v); cvPush(v, b); cvPush(v, a); break;
      case 6: b = cvPop(v); a = cvPop(v); cvPush(v, a); cvPush(v, b); cvPush(v, a); break;
      case 10: b = cvPop(v); a = cvPop(v); cvPush(v, a + b); break;
      case 11: b = cvPop(v); a = cvPop(v); cvPush(v, a - b); break;
      case 12: b = cvPop(v); a = cvPop(v); cvPush(v, a * b); break;
      case 13: b = cvPop(v); a = cvPop(v); cvPush(v, b == 0 ? 0 : a / b); break;
      case 14: b = cvPop(v); a = cvPop(v); cvPush(v, b == 0 ? 0 : a % b); break;
      case 15: a = cvPop(v); cvPush(v, -a); break;
      case 16: b = cvPop(v); a = cvPop(v); cvPush(v, a & b); break;
      case 17: b = cvPop(v); a = cvPop(v); cvPush(v, a | b); break;
      case 18: b = cvPop(v); a = cvPop(v); cvPush(v, a ^ b); break;
      case 19: a = cvPop(v); cvPush(v, ~a); break;
      case 20: b = cvPop(v); a = cvPop(v); cvPush(v, (int32_t)((uint32_t)a << (b & 15))); break;
      case 21: b = cvPop(v); a = cvPop(v); cvPush(v, a >> (b & 15)); break;
      case 22: a = cvPop(v); cvPush(v, a == 0); break;
      case 23: b = cvPop(v); a = cvPop(v); cvPush(v, a == b); break;
      case 24: b = cvPop(v); a = cvPop(v); cvPush(v, a != b); break;
      case 25: b = cvPop(v); a = cvPop(v); cvPush(v, a < b); break;
      case 26: b = cvPop(v); a = cvPop(v); cvPush(v, a <= b); break;
      case 27: b = cvPop(v); a = cvPop(v); cvPush(v, a > b); break;
      case 28: b = cvPop(v); a = cvPop(v); cvPush(v, a >= b); break;
      case 29: b = cvPop(v); a = cvPop(v); cvPush(v, a < b ? a : b); break;
      case 30: b = cvPop(v); a = cvPop(v); cvPush(v, a > b ? a : b); break;
      case 31: a = cvPop(v); cvPush(v, a < 0 ? -a : a); break;
      case 32: b = cvPop(v); a = cvPop(v); cvPush(v, (a * b) >> 8); break;
      case 33: { int32_t hi = cvPop(v), lo = cvPop(v), x = cvPop(v); cvPush(v, x < lo ? lo : (x > hi ? hi : x)); break; }
      case 34: a = cvPop(v); cvPush(v, a > 0 ? 1 : (a < 0 ? -1 : 0)); break;
      case 40:
        if (v.pc + 1 > n) { v.err = "Truncated code"; break; }
        a = code[v.pc++];
        if (a >= CV_GLOBALS) { v.err = "Global out of range"; break; }
        cvPush(v, v.g[a]);
        break;
      case 41:
        if (v.pc + 1 > n) { v.err = "Truncated code"; break; }
        a = code[v.pc++];
        if (a >= CV_GLOBALS) { v.err = "Global out of range"; break; }
        v.g[a] = cvPop(v);
        break;
      case 42:
        if (v.pc + 1 > n) { v.err = "Truncated code"; break; }
        a = v.fp + code[v.pc++];
        if (a >= CV_LOCALS) { v.err = "Local out of range"; break; }
        cvPush(v, v.ls[a]);
        break;
      case 43:
        if (v.pc + 1 > n) { v.err = "Truncated code"; break; }
        a = v.fp + code[v.pc++];
        if (a >= CV_LOCALS) { v.err = "Local out of range"; break; }
        v.ls[a] = cvPop(v);
        break;
      case 44:
        a = cvPop(v);
        if (a < 0 || a >= v.memWords) { v.err = "Memory out of range"; break; }
        cvPush(v, v.mem[a]);
        break;
      case 45:
        b = cvPop(v); a = cvPop(v);
        if (a < 0 || a >= v.memWords) { v.err = "Memory out of range"; break; }
        v.mem[a] = (int16_t)b;
        break;
      case 50:
        if (v.pc + 2 > n) { v.err = "Truncated code"; break; }
        v.pc = cvLe16(code + v.pc);
        break;
      case 51: case 52: {
        if (v.pc + 2 > n) { v.err = "Truncated code"; break; }
        uint16_t t = cvLe16(code + v.pc);
        v.pc += 2;
        a = cvPop(v);
        if ((a == 0) == (op == 51)) v.pc = t;
        break;
      }
      case 53: {
        if (v.pc + 4 > n) { v.err = "Truncated code"; break; }
        uint16_t t = cvLe16(code + v.pc);
        int na = code[v.pc + 2], nl = code[v.pc + 3];
        v.pc += 4;
        if (v.cd >= CV_CALLS) { v.err = "Calls nested too deep"; break; }
        if (v.lsp + nl > CV_LOCALS || nl < na) { v.err = "Out of locals"; break; }
        if (v.sp < na) { v.err = "Stack underflow"; break; }
        for (int k = 0; k < nl; k++) v.ls[v.lsp + k] = 0;
        for (int k = na - 1; k >= 0; k--) v.ls[v.lsp + k] = v.st[--v.sp];
        v.cPc[v.cd] = v.pc; v.cFp[v.cd] = v.fp; v.cLsp[v.cd] = v.lsp;
        v.cd++;
        v.fp = v.lsp;
        v.lsp = (uint16_t)(v.lsp + nl);
        v.pc = t;
        break;
      }
      case 54: {
        int16_t rv = cvPop(v);
        if (v.cd == 0) {
          if (v.phase == 0) {   // init finished: run the first frame in the same tick
            v.phase = 1;
            cartStartEntry(v, v.frameAddr);
            break;
          }
          return;
        }
        v.cd--;
        v.pc = v.cPc[v.cd]; v.fp = v.cFp[v.cd]; v.lsp = v.cLsp[v.cd];
        cvPush(v, rv);
        break;
      }
      case 55: v.susp = 1; return;
      // ---- drawing ----
      case 60: { uint16_t c = cvCol(cvPop(v)); canvas->fillScreen(c); break; }
      case 61: { uint16_t c = cvCol(cvPop(v)); int y = cvPop(v), x = cvPop(v); if (x >= 0 && x < 160 && y >= 0 && y < 128) canvas->drawPixel(x, y, c); break; }
      case 62: { uint16_t c = cvCol(cvPop(v)); int h = cvPop(v), w = cvPop(v), y = cvPop(v), x = cvPop(v); cvRect(x, y, w, h, c); break; }
      case 63: {
        uint16_t c = cvCol(cvPop(v));
        int h = cvPop(v), w = cvPop(v), y = cvPop(v), x = cvPop(v);
        if (w > 0 && h > 0) { cvRect(x, y, w, 1, c); cvRect(x, y + h - 1, w, 1, c); cvRect(x, y, 1, h, c); cvRect(x + w - 1, y, 1, h, c); }
        break;
      }
      case 64: {
        uint16_t c = cvCol(cvPop(v));
        int y1 = cvPop(v), x1 = cvPop(v), y0 = cvPop(v), x0 = cvPop(v);
        if (abs(x0) <= 512 && abs(y0) <= 512 && abs(x1) <= 512 && abs(y1) <= 512) canvas->drawLine(x0, y0, x1, y1, c);
        break;
      }
      case 65: case 66: {
        uint16_t c = cvCol(cvPop(v));
        int r = cvPop(v), y = cvPop(v), x = cvPop(v);
        if (r >= 0 && r <= 127) { if (op == 66) canvas->fillCircle(x, y, r, c); else canvas->drawCircle(x, y, r, c); }
        break;
      }
      case 67: { const char* s = cvStr(v, cvPop(v)); uint16_t c = cvCol(cvPop(v)); int y = cvPop(v), x = cvPop(v); cvText(v, x, y, c, s); break; }
      case 68: {
        int16_t nv = cvPop(v); uint16_t c = cvCol(cvPop(v)); int y = cvPop(v), x = cvPop(v);
        char t[8]; snprintf(t, sizeof(t), "%d", (int)nv); cvText(v, x, y, c, t);
        break;
      }
      case 69: {
        const char* s = cvStr(v, cvPop(v)); uint16_t c = cvCol(cvPop(v)); int y = cvPop(v);
        cvText(v, (160 - (int)strlen(s) * 6 * v.tsz) / 2, y, c, s);
        break;
      }
      case 70: a = cvPop(v); v.tsz = a >= 2 ? 2 : 1; break;
      case 71: { uint16_t c = cvCol(cvPop(v)); int i = cvPop(v), y = cvPop(v), x = cvPop(v); cvSprite(v, x, y, i, c, 0); break; }
      case 72: { int f = cvPop(v); uint16_t c = cvCol(cvPop(v)); int i = cvPop(v), y = cvPop(v), x = cvPop(v); cvSprite(v, x, y, i, c, f); break; }
      case 73: {
        int oy = cvPop(v), ox = cvPop(v), h = cvPop(v), w = cvPop(v), base = cvPop(v);
        if (!cvMapOk(v, base, w, h)) break;
        for (int yy = 0; yy < h && !v.err; yy++)
          for (int xx = 0; xx < w && !v.err; xx++) {
            int16_t m = v.mem[base + yy * w + xx];
            if (m & 63) cvSprite(v, ox + xx * 8, oy + yy * 8, (m & 63) - 1, v.pal[(m >> 6) & 7], 0);
          }
        break;
      }
      case 74: { uint16_t c = cvCol(cvPop(v)); int i = cvPop(v); if (i >= 0 && i < 8) v.pal[i] = c; break; }
      case 75: {
        int y = cvPop(v), x = cvPop(v);
        cvPush(v, (x >= 0 && x < 160 && y >= 0 && y < 128) ? (int16_t)canvas->getBuffer()[y * canvas->width() + x] : -1);
        break;
      }
      case 76: { int bl = cvPop(v) & 255, gr = cvPop(v) & 255, rd = cvPop(v) & 255; cvPush(v, (int16_t)CRGB(rd, gr, bl)); break; }
      case 77: {
        int h2 = cvPop(v), w2 = cvPop(v), y2 = cvPop(v), x2 = cvPop(v), h1 = cvPop(v), w1 = cvPop(v), y1 = cvPop(v), x1 = cvPop(v);
        cvPush(v, x1 < x2 + w2 && x2 < x1 + w1 && y1 < y2 + h2 && y2 < y1 + h1);
        break;
      }
      case 78: {
        int w = cvPop(v), nv = cvPop(v); uint16_t c = cvCol(cvPop(v)); int y = cvPop(v), x = cvPop(v);
        if (w < 0) w = 0;
        if (w > 8) w = 8;
        char t[16]; snprintf(t, sizeof(t), "%0*d", w, nv); cvText(v, x, y, c, t);
        break;
      }
      // ---- input / numbers ----
      case 85: a = cvPop(v); cvPush(v, a >= 0 && a < 6 && ((v.held >> a) & 1)); break;
      case 86: a = cvPop(v); cvPush(v, a >= 0 && a < 6 && ((v.pressed >> a) & 1)); break;
      case 90:
        a = cvPop(v);
        v.rng = v.rng * 1664525UL + 1013904223UL;
        cvPush(v, a <= 0 ? 0 : (int32_t)(((v.rng >> 16) & 0x7FFF) % (uint32_t)a));
        break;
      case 91: cvPush(v, v.frameNo & 0x7FFF); break;
      case 92: a = cvPop(v); cvPush(v, cartSin((int)a)); break;
      case 93: a = cvPop(v); cvPush(v, cartSin((int)a + 64)); break;
      case 94: {
        a = cvPop(v);
        int32_t r = 0;
        if (a > 0) { r = (int32_t)sqrtf((float)a); while (r * r > a) r--; while ((r + 1) * (r + 1) <= a) r++; }
        cvPush(v, r);
        break;
      }
      case 95: a = cvPop(v); v.rng = (uint32_t)(a & 0xFFFF) * 40503UL + 1UL; break;
      // ---- sound / effects ----
      case 100: { int ms = cvPop(v), f = cvPop(v); if (f >= 20 && f <= 8000 && ms > 0) sfx((uint16_t)f, (uint16_t)(ms > 1000 ? 1000 : ms)); break; }
      case 101: a = cvPop(v); if (a >= 0 && a < 8) sfx(kCartSfx[a][0], kCartSfx[a][1]); break;
      case 102: {
        uint16_t c = cvCol(cvPop(v)); int cnt = cvPop(v), y = cvPop(v), x = cvPop(v);
        if (cnt > 0 && x >= 0 && x < 160 && y >= 0 && y < 128) particlesBurst(x, y, cnt > 24 ? 24 : cnt, c);
        break;
      }
      case 103: { int amp = cvPop(v), ms = cvPop(v); if (amp > 0 && ms > 0) screenShake((uint16_t)(ms > 600 ? 600 : ms), (uint8_t)(amp > 4 ? 4 : amp)); break; }
      case 104: {
        int ms = cvPop(v), bl = cvPop(v) & 255, gr = cvPop(v) & 255, rd = cvPop(v) & 255;
        if (ms > 0) pixelsFlashAsync((uint8_t)rd, (uint8_t)gr, (uint8_t)bl, (uint16_t)(ms > 1000 ? 1000 : ms));
        break;
      }
      // ---- game flow ----
      case 110: v.score = cvPop(v); break;
      case 111: cvPush(v, v.score > 32767 ? 32767 : (v.score < -32768 ? -32768 : v.score)); break;
      case 112: {
        const char* s = cvStr(v, cvPop(v));
        if (!v.err) { snprintf(s_cartHead, sizeof(s_cartHead), "%.20s", s); v.over = 1; }
        break;
      }
      case 113: {
        int32_t bst = s_cartCur >= 0 ? cartBestOf(s_cartCur, g_variant & 3) : SAVE_NO_SCORE;
        cvPush(v, bst == SAVE_NO_SCORE ? -1 : (bst > 32767 ? 32767 : (bst < -32768 ? -32768 : bst)));
        break;
      }
      case 114: cvPush(v, g_variant & 3); break;
      case 115: cvPush(v, (g_twoPlayerMode && s_cartCur >= 0 && (s_carts[s_cartCur].flags & 1)) ? g_twoPPlayerNum : 1); break;
      case 116: a = cvPop(v); cvPush(v, v.save[a & 15]); break;
      case 117: b = cvPop(v); a = cvPop(v); v.save[a & 15] = (uint8_t)b; v.saveDirty = 1; break;
      case 118: {
        int val = cvPop(v), cnt = cvPop(v), base = cvPop(v);
        if (cnt < 0 || base < 0 || base + cnt > (int)v.memWords) { v.err = "Memory out of range"; break; }
        for (int k = 0; k < cnt; k++) v.mem[base + k] = (int16_t)val;
        break;
      }
      case 119: {
        int y = cvPop(v), x = cvPop(v), h = cvPop(v), w = cvPop(v), base = cvPop(v);
        if (!cvMapOk(v, base, w, h)) break;
        cvPush(v, (x >= 0 && x < w && y >= 0 && y < h) ? v.mem[base + y * w + x] : -1);
        break;
      }
      case 120: {
        int val = cvPop(v), y = cvPop(v), x = cvPop(v), h = cvPop(v), w = cvPop(v), base = cvPop(v);
        if (!cvMapOk(v, base, w, h)) break;
        if (x >= 0 && x < w && y >= 0 && y < h) v.mem[base + y * w + x] = (int16_t)val;
        break;
      }
      case 121: v.score += cvPop(v); break;
      case 122: cvPush(v, g_twoPlayerMode && s_cartCur >= 0 && (s_carts[s_cartCur].flags & 1)); break;
      default: v.err = "Bad opcode"; break;
    }
  }
}

// ---- cart flow: launch -> title -> playing -> over ----
static void cartEnterTitle() {
  if (s_cartCur < 0 || s_cartCur >= (int)s_cartN) return;
  const CartEntry& c = s_carts[s_cartCur];
  char t[3][24] = {{0}, {0}, {0}};
  char tn[9] = {0};
  bool have = false;
  if (bannerFsOk()) {   // title text lives in the file header: help lines @128, tier names @88
    char path[40];
    snprintf(path, sizeof(path), CART_DIR "/%s", c.file);
    File f = arcada.open(path, O_READ);
    if (f) {
      uint8_t h[CART_HDR];
      if (f.read(h, CART_HDR) == CART_HDR && memcmp(h, "ARC1", 4) == 0) {
        for (int i = 0; i < 3; i++) { memcpy(t[i], h + 128 + i * 24, 23); for (int k = 0; k < 23; k++) if ((uint8_t)t[i][k] < 32 || (uint8_t)t[i][k] > 126) t[i][k] = 0; }
        memcpy(tn, h + 88 + (g_variant & 3) * 8, 7);
        for (int k = 0; k < 8; k++) if ((uint8_t)tn[k] < 32 || (uint8_t)tn[k] > 126) tn[k] = 0;
        have = true;
      }
      f.close();
    }
  }
  if (!have) { strcpy(t[0], "Expansion cartridge"); strcpy(tn, kAiTierNames[g_variant & 3]); }
  if (!tn[0]) strcpy(tn, kAiTierNames[g_variant & 3]);
  gameState = ST_CART_TITLE;
  drawStdTitleEx(c.name, kCartPal[c.col & 15], t[0], t[1], t[2], CART_BASE + s_cartCur, tn);
}
static void cartLaunch(int k) {
  if (k < 0 || k >= (int)s_cartN) return;
  g_userSeed = 0;
  clearLevelSlots();
  g_variant = 0;
  s_cartCur = k;
  cartEnterTitle();
}
static void cartTitleTick(uint32_t pressed) {
  if (s_cartCur < 0 || s_cartCur >= (int)s_cartN) { gameState = ST_GAME_PICKER; drawGamePicker(); return; }
  bool tp = g_twoPlayerMode;
  bool can2P = (s_carts[s_cartCur].flags & 1) != 0;
  if (!can2P) g_twoPlayerMode = false;   // a cart that does not declare 2P always starts solo
  stdTitleTick(pressed, cartEnterPlaying, cartEnterTitle, !(s_carts[s_cartCur].flags & 2), "SCORE", CART_BASE + s_cartCur);
  g_twoPlayerMode = tp;
}
static void cartEnterPlaying() {
  if (s_cartCur < 0 || s_cartCur >= (int)s_cartN) { gameState = ST_GAME_PICKER; drawGamePicker(); return; }
  cartRelease();
  uint16_t e = cartLoad(s_carts[s_cartCur].file);
  if (e) { cartError(e, NULL); return; }
  CartVm& v = *s_cv;
  CartRec* r = cartRecMake(s_cartCur);
  if (r) {
    memcpy(v.save, r->save, 16);
    if (!(g_twoPlayerMode && (s_carts[s_cartCur].flags & 1) && g_twoPPlayerNum == 2) && r->plays < 65535) r->plays++;
  }
  v.rng = gameSeed() | 1UL;
  canvas->fillScreen(0);
  canvas->setTextSize(1);
  s_lastFrameMs = 0;
  s_cartNextMs = millis();
  gameState = ST_CART_PLAYING;
}
static void cartToOver() {
  CartVm& v = *s_cv;
  int32_t sc = v.score;
  const CartEntry& c = s_carts[s_cartCur];
  bool lower = (c.flags & 2) != 0;
  int t = g_variant & 3;
  CartRec* r = cartRecMake(s_cartCur);
  bool better = false;
  if (r && sc > 0) {
    int32_t cur = r->best[t];
    better = (cur == SAVE_NO_SCORE) || (lower ? sc < cur : sc > cur);
    if (better) { r->best[t] = sc; bump8(g_save.cntBests); }
  }
  s_lastNewBest = better;
  s_lastNewBestGame = CART_BASE + s_cartCur;
  if (r) memcpy(r->save, v.save, 16);
  v.saveDirty = 0;
  cartBinSave();
  cartRelease();
  int distinct = 0;
  for (int i = 0; i < (int)s_cbN; i++) if (s_cbRec[i].plays > 0) distinct++;
  miscSetFlag(MF_ACH_CART, true);
  if (distinct >= 4) miscSetFlag(MF_ACH_CART4, true);
  checkAchievements();
  saveWrite();
  if (g_twoPlayerMode && (c.flags & 1)) { twoPHandleGameEnd((long)sc); return; }
  gameState = ST_CART_OVER;
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%ld", (long)sc);
  snprintf(sub, sizeof(sub), "%.15s", c.name);
  drawStdOver(s_cartHead[0] ? s_cartHead : "GAME OVER", COL_LASER, big, sub, CART_BASE + s_cartCur);
}
static void cartFrame(uint32_t buttons) {
  CartVm* vp = s_cv;
  if (!vp) { cartError(311, NULL); return; }
  unsigned long now = millis();
  if ((long)(now - s_cartNextMs) < 0) return;   // 30 frames per second
  s_cartNextMs += 33;
  if ((long)(now - s_cartNextMs) > 100) s_cartNextMs = now + 33;
  s_lastFrameMs = now;
  CartVm& v = *vp;
  uint16_t m = 0;
  if (buttons & ARCADA_BUTTONMASK_LEFT) m |= 1;
  if (buttons & ARCADA_BUTTONMASK_RIGHT) m |= 2;
  if (buttons & ARCADA_BUTTONMASK_UP) m |= 4;
  if (buttons & ARCADA_BUTTONMASK_DOWN) m |= 8;
  if (buttons & ARCADA_BUTTONMASK_A) m |= 16;
  if (buttons & ARCADA_BUTTONMASK_B) m |= 32;
  v.pressed = (uint16_t)(m & ~v.held);
  v.held = m;
  v.frameNo++;
  if (!v.susp && v.phase == 1) cartStartEntry(v, v.frameAddr);
  v.susp = 0;
  cartRun();
  if (v.err) { cartError(310, v.err); return; }
  if (v.over) { cartToOver(); return; }
  particlesUpdateDraw();
  blitScreen();
}

