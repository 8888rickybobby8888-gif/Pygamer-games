static void launchGame(int idx) { launchGameV(idx, 0); }

// Custom-level slots must not leak into seeded rounds (Challenge / Mix): force the
// built-in content for every level-creator game.
static void clearLevelSlots() {
  for (int i = 0; i < LVL_NUM_GAMES; i++) s_lvlActiveSlot[i] = -1;
  s_lvlTestPlay = false;
  s_lvlPack = false;
  s_lvlPackPlay = false;
  s_pkBrowse = false;
  s_lvlRunGame = 0xFF;   // no stale "Level best" from an earlier custom run
  s_lvlRunNew = false;
}

// --- Mix mode launch ---------------------------------------------------------
// Verified quick score-attack games where higher is better and which end through a
// single twoPHandleGameEnd() site (see twoPOrMix()).
typedef struct { uint8_t idx; EnterPlayingFn fn; } MixDef;
#define NUM_MIX_GAMES 12
static const MixDef kMixGames[NUM_MIX_GAMES] = {
  {1, enterGalleryPlaying}, {4, enterMolePlaying},   {8, enterMashPlaying},
  {16, enterColorPlaying},  {17, enterMathPlaying},  {23, enterTimingPlaying},
  {15, enterCatchPlaying},  {11, enterSnakePlaying}, {19, enterGapPlaying},
  {24, enterBalloonPlaying},{7, enterDodgePlaying},  {9, enterAsteroidPlaying},
};

static void mixAbort() { g_mixActive = false; }

// Input/exit handling for ST_TURN_PROMPT (the animation itself is drawTurnPrompt()).
// Portrait detected -> chime and start; A/Start -> start now in the current direction
// (Flip A unless the accelerometer already chose); B -> back to the game's title (or
// the picker for a Mix run).
static void turnPromptUpdate(uint32_t pressed) {
  EnterPlayingFn fn = s_turnFn;
  EnterPlayingFn tf = s_turnTitleFn;
  if (pressed & ARCADA_BUTTONMASK_B) {
    s_turnFn = NULL;
    s_turnTitleFn = NULL;
    sfx(300, 30);
    if (g_mixActive || !tf) {
      mixAbort();
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else {
      tf();
    }
    return;
  }
  bool skip = (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) != 0;
  if (!skip && !s_orientPort) return;
  s_turnFn = NULL;
  s_turnTitleFn = NULL;
  if (skip) {
    sfx(600, 40);
  } else {
    sfx(660, 50);
    delay(60);
    sfx(990, 90);
  }
  if (fn) {
    s_turnBypass = true;
    fn();
    s_turnBypass = false;
  } else {
    gameState = ST_GAME_PICKER;
    drawGamePicker();
  }
}

// Starts the game g_mixList[g_mixK] straight into PLAYING on Normal.
static void mixLaunchCurrent() {
  int g = g_mixList[g_mixK];
  g_variant = 0;
  g_userSeed = 0;
  g_mixPrevBest = saveBest(g, 0);
  noteGamePlayed(g);
  for (int i = 0; i < NUM_MIX_GAMES; i++) {
    if (kMixGames[i].idx == g) {
      kMixGames[i].fn();
      return;
    }
  }
  mixAbort(); // not in the table: cannot happen, but never get stuck
  gameState = ST_GAME_PICKER;
  drawGamePicker();
}

static void mixStart() {
  if (g_twoPlayerMode) {
    toastShow("Turn off 2 Player");
    sfxBlocked();
    return;
  }
  uint8_t pool[NUM_MIX_GAMES];
  for (int i = 0; i < NUM_MIX_GAMES; i++) pool[i] = kMixGames[i].idx;
  uint32_t r = micros() ^ (millis() * 2654435761u) ^ 0xA5F00Du;
  if (r == 0) r = 1;
  for (int i = 0; i < MIX_COUNT; i++) { // partial Fisher-Yates: 5 distinct games
    r ^= r << 13; r ^= r >> 17; r ^= r << 5;
    int j = i + (int)(r % (uint32_t)(NUM_MIX_GAMES - i));
    uint8_t t = pool[i]; pool[i] = pool[j]; pool[j] = t;
    g_mixList[i] = pool[i];
    g_mixStars[i] = 0;
    g_mixScore[i] = 0;
  }
  clearLevelSlots();
  g_userSeed = 0;
  g_challengeN = 0;
  g_challengeSeed = 0;
  g_variant = 0;
  g_mixK = 0;
  g_mixActive = true;
  sfx(600, 40);
  mixShowIntro();
}

// --- Challenge mode ----------------------------------------------------------
// Challenge #N always maps to the same {game, difficulty tier, round seed}, so two
// people entering the same number play the identical round. Only score-attack games
// whose enter*Playing() seeds the RNG from gameSeed() are used.
static const uint8_t kChalGames[] = {1, 4, 11, 13, 15, 19, 31, 44, 46, 47, 48, 49};   // first 7 = the original pool (CLASSIC); the full 12 = EXTENDED
#define CHAL_GAMES ((uint32_t)(sizeof(kChalGames) / sizeof(kChalGames[0])))
static_assert(sizeof(kChalGames) >= 7, "CLASSIC pool needs the first 7 games");

static void challengeParams(uint16_t n, uint8_t& game, uint8_t& tier, uint32_t& seed) {
  uint32_t h = (uint32_t)n * 2654435761u + 0x9E3779B9u;
  h ^= h >> 15; h *= 2246822519u; h ^= h >> 13; h *= 3266489917u; h ^= h >> 16;
  game = kChalGames[(h >> 3) % (miscGetFlag(MF_CHAL_CLASSIC) ? 7u : CHAL_GAMES)];   // CLASSIC = the original first 7 entries
  tier = (uint8_t)((h >> 11) % 4);
  seed = (h * 2654435761u) | 1u;
}

static void challengeStart() {
  if (g_twoPlayerMode) {
    toastShow("Turn off 2 Player");
    sfxBlocked();
    return;
  }
  uint8_t game, tier;
  uint32_t seed;
  challengeParams(s_chalSel, game, tier, seed);
  g_save.chalN[0] = (uint8_t)(s_chalSel & 0xFF);
  g_save.chalN[1] = (uint8_t)(s_chalSel >> 8);
  g_save.evFlags |= 32; // counts as using a seed
  mixAbort();
  clearLevelSlots();
  g_challengeN = s_chalSel;   // set before the title draws so it shows the banner
  g_challengeSeed = seed;
  sfx(600, 40);
  launchGameV(game, tier);    // also saves via noteGamePlayed()
}

// --- Challenges & Awards hub: open / input ---------------------------------------
// Remembers the focused panel in SaveMisc.flags (written only when it changed).
static void hubRememberFocus() {
  uint8_t g = hubGroup();
  if (miscGetField(MF_HUBFOCUS_SHIFT, 3) != g) {
    miscSetField(MF_HUBFOCUS_SHIFT, 3, g);
    saveWrite();
  }
}
static void hubOpen(uint8_t from) {
  s_hubFrom = from;
  uint8_t fg = miscGetField(MF_HUBFOCUS_SHIFT, 3);   // remembered focus panel
  s_hubSel = fg == 1 ? HUB_CHAL : (fg == 2 ? HUB_LIST0 : HUB_MIX);
  s_hubListSel = 0;
  s_hubDesc = false;
  s_hubTop = 0;
  s_hubHi = s_hubScr = 0;
  s_hubFoc = (fg <= 2) ? (float)fg : 0.0f;
  s_hubT0 = s_hubDescT0 = millis();
  evSet2(1);   // "Self-Aware"
  checkAchievements();
  gameState = ST_HUB;
  sfx(600, 40);
  drawHubScreen();
}

static void hubUpdate(uint32_t buttons, uint32_t pressed) {
  static unsigned long holdSince = 0, lastStep = 0;
  const uint32_t kLR = ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT;
  if (s_hubDesc) {   // the full description is up: any press just closes it
    if (pressed) {
      s_hubDesc = false;
      sfx(300, 20);
      drawHubScreen();
    }
    return;
  }
  if (pressed & ARCADA_BUTTONMASK_SELECT) {   // Select jumps MIX -> CHALLENGE -> AWARDS (B is back)
    uint8_t g = hubGroup();
    if (g == 2) s_hubListSel = (uint8_t)(s_hubSel - HUB_LIST0);
    g = (uint8_t)((g + 1) % 3);
    s_hubSel = g == 0 ? HUB_MIX : (g == 1 ? HUB_CHAL : (uint8_t)(HUB_LIST0 + s_hubListSel));
    s_hubDescT0 = millis();
    hubSyncFocus();
    sfxMove();
    drawHubScreen();
    holdSince = 0;
    return;
  }
  // Challenge # auto-repeat: hold Left/Right (+5 per step after 0.45 s, +25 after 1.8 s).
  if (!(buttons & kLR)) {
    holdSince = 0;
  } else if (s_hubSel == HUB_CHAL && holdSince != 0 &&
             !(pressed & (kLR | ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN))) {
    unsigned long nowC = millis();
    if (nowC - holdSince >= 450 && nowC - lastStep >= 100) {
      int step = (nowC - holdSince >= 1800) ? 25 : 5;
      int n = (int)s_chalSel + ((buttons & ARCADA_BUTTONMASK_RIGHT) ? step : -step);
      s_chalSel = (uint16_t)(((n - 1) % CHAL_MAX + CHAL_MAX) % CHAL_MAX + 1);
      lastStep = nowC;
      sfx(300, 5);
      drawHubScreen();
    }
  }
  if (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN)) {
    holdSince = 0;   // a fresh Left/Right press is needed to start repeating again
    if (pressed & ARCADA_BUTTONMASK_UP) s_hubSel = (uint8_t)((s_hubSel + HUB_N - 1) % HUB_N);
    else s_hubSel = (uint8_t)((s_hubSel + 1) % HUB_N);   // wraps Mix <-> last award
    s_hubDescT0 = millis();
    hubSyncFocus();
    sfxMove();
    drawHubScreen();
  } else if (pressed & kLR) {
    int d = (pressed & ARCADA_BUTTONMASK_RIGHT) ? 1 : -1;
    if (s_hubSel == HUB_CHAL) {
      s_chalSel = (uint16_t)(((int)s_chalSel - 1 + d + CHAL_MAX) % CHAL_MAX + 1);
      holdSince = lastStep = millis();
      sfxMove();
    } else if (s_hubSel >= HUB_LIST0) {   // page the award list by 4 rows (clamped, no wrap)
      int li = (int)s_hubSel - HUB_LIST0;
      int nl = li + d * HUB_VIS;
      if (nl < 0) nl = 0;
      if (nl > HUB_LROWS - 1) nl = HUB_LROWS - 1;
      if (nl == li) {
        sfxBlocked();
      } else {
        s_hubSel = (uint8_t)(HUB_LIST0 + nl);
        s_hubDescT0 = millis();
        hubSyncFocus();
        sfxMove();
      }
    }
    drawHubScreen();
  } else if (pressed & ARCADA_BUTTONMASK_B) {   // Select is NOT aliased to B on the hub (see above)
    sfx(300, 30);
    hubRememberFocus();
    if (s_hubFrom) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else {
      gameState = ST_SETTINGS;
      drawSettingsScreen();
    }
  } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
    if (s_hubSel == HUB_MIX) {
      hubRememberFocus();
      mixStart();   // refuses with a toast in 2P
    } else if (s_hubSel == HUB_CHAL) {
      if (pressed & ARCADA_BUTTONMASK_START) {   // Start flips the number pool: CLASSIC 7 <-> EXTENDED 12
        miscSetFlag(MF_CHAL_CLASSIC, !miscGetFlag(MF_CHAL_CLASSIC));
        saveWrite();
        toastShow(miscGetFlag(MF_CHAL_CLASSIC) ? "Pool: CLASSIC 7" : "Pool: EXTENDED 12");
        sfx(500, 30);
        drawHubScreen();
      } else {
        hubRememberFocus();
        challengeStart();
      }
    } else if (s_hubSel == HUB_LIST0) {
      hubRememberFocus();
      s_trophySel = 0;
      gameState = ST_TROPHIES;
      sfx(600, 40);
      drawTrophyScreen();
    } else {   // an award row: full-width description (any press closes), twinkle replays
      s_hubT0 = millis();
      s_hubDesc = true;
      sfx(700, 20);
      drawHubScreen();
    }
  }
}

// Leaves the How to Play screen: back to the pause menu, or on into the game that was
// being launched from the picker (its title screen).
static void helpClose() {
  sfx(300, 30);
  if (s_helpFrom == 0) {
    gameState = ST_PAUSE;
    s_pauseOpenMs = millis();
    s_pauseBarY = (float)(PAUSE_Y0 + s_pauseSel * PAUSE_DY);
    drawPauseMenu();
  } else {
    jingleStart(JG_START);
    launchGame(s_helpLaunch);
  }
}

// Timed redraw (~30 fps) for the otherwise event-driven menu / static screens.
// Called once per loop() before input handling; input code is untouched.
static unsigned long s_menuAnimLast = 0;
static void menuAnimTick() {
  unsigned long now = millis();
  if (now - s_menuAnimLast < 33) return;
  switch (gameState) {
    case ST_SPLASH:        splashSound(); break;
    case ST_GAME_PICKER:   pickerAnimTick(); menuMusicTick(); break;
    case ST_MIX_INTRO:     drawMixIntro(); break;
    case ST_MIX_RESULTS:   drawMixResults(); break;
    case ST_CREDITS:       drawCreditsScreen(); break;
    case ST_ATTRACT:       drawAttract(); break;
    case ST_SETTINGS:      settingsAnimTick(); break;
    case ST_HUB:           hubAnimTick(); break;
    case ST_TROPHIES:      trophyAnimTick(); break;
    case ST_HISCORES:      hiScoresAnimTick(); break;
    case ST_USBDRIVE:      usbDrawScreen(); break;
    case ST_DIAG:          diagDraw(); break;
    case ST_ERRLOG:        errLogDraw(); break;
    case ST_PAUSE:         pauseAnimTick(); break;
    case ST_LEVEL_SAVE_MENU: drawLevelSaveMenu(); break;
    case ST_LEVEL_MENU:    drawLvlPickMenu(); break;
    case ST_HELP:          drawHelpScreen(); break;
    case ST_TURN_PROMPT:   drawTurnPrompt(); break;
    default:               animScreenTick(); break;
  }
  if (toastMenuState()) g_menuRedrawn = true;
  if (gameState == ST_SPLASH) drawSplashFrame();
  // Fixed cadence: advance by exactly one period so frame spacing doesn't
  // wobble with loop() jitter (resync if we fell far behind).
  s_menuAnimLast += 33;
  if (now - s_menuAnimLast > 66) s_menuAnimLast = now;
}

// --- Arduino entry points --------------------------------------------------

void setup() {
  Serial.begin(115200);

  if (!arcada.arcadaBegin()) {
    pinMode(LED_BUILTIN, OUTPUT);
    while (1) {
      digitalWrite(LED_BUILTIN, HIGH);
      delay(100);
      digitalWrite(LED_BUILTIN, LOW);
      delay(100);
    }
  }

  arcada.displayBegin();
  arcada.display->setRotation(1); // landscape, 160x128
  arcada.setBacklight(255);
  arcada.enableSpeaker(true);
  arcada.pixels.begin();
  arcada.pixels.setBrightness(60);

  // Off-screen framebuffer: every frame is drawn here, then pushed to the
  // real screen in one burst (see blitFrameBuffer calls) instead of many
  // small fillRect/fillCircle calls hitting the display directly, which is
  // what was causing the visible flicker/tearing.
  arcada.createFrameBuffer(VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE + HUD_HEIGHT);
  s_landCanvas = arcada.getCanvas();
  // Second framebuffer for the portrait games (128x160, rotated into the first
  // one by blitScreen). If the allocation fails, portrait mode just stays off.
  {
    GFXcanvas16* pc = new GFXcanvas16(128, 160);
    if (pc && pc->getBuffer()) s_portCanvas = pc;
    else { s_portCanvas = NULL; errLog(703); }
  }

  initColors();
  initPickerColors();
  initSimonColors();

  for (int i = 0; i < LVL_NUM_GAMES; i++) s_lvlActiveSlot[i] = -1;
  lvlStorageBegin();
  errBoot();
  saveLoad();
  lvlSavedSync();
  lvlRecoverScan();
  bannerProbe();
  portalProbe();
  extBootInit();
  ckFlipOpt = !miscGetFlag(MF_CKFLIP_OFF);
  {
    int cn = (int)g_save.chalN[0] | ((int)g_save.chalN[1] << 8);
    s_chalSel = (uint16_t)((cn >= 1 && cn <= CHAL_MAX) ? cn : 1);
  }
  s_lastInputMs = millis();

  if (g_save.bootMode == 1 && g_save.lastPlayed < NUM_GAMES &&
      savePlays(g_save.lastPlayed) > 0) {
    pickerSelection = g_save.lastPlayed;
    launchGame(pickerSelection);
  } else {
    gameState = ST_SPLASH;
    drawSplashScreen();
  }
}

static void enterPlaying(int level) {
  currentLevel = level;
  loadLevel(currentLevel);
  gameState = ST_PLAYING;
  s_lastFrameMs = 0; // avoid a huge dt on the first frame after a menu
  drawAll();
}

void loop() {
  {   // loop period (rolling average) + free-RAM high-water mark, for Diagnostics
    static uint32_t lastUs = 0;
    uint32_t nowUs = micros();
    uint32_t dtUs = nowUs - lastUs;
    lastUs = nowUs;
    if (dtUs < 1000000UL) g_loopAvgUs = (uint32_t)((int32_t)g_loopAvgUs + ((int32_t)dtUs - (int32_t)g_loopAvgUs) / 8);
    ramSample();
  }
  uint32_t buttons = arcada.readButtons();
  uint32_t pressed = buttons & ~s_prevButtons;
  s_prevButtons = buttons;   // raw (device-frame) mask, so edge detection stays consistent
  s_rawPressed = pressed;
  if (s_cv && gameState != ST_CART_PLAYING && gameState != ST_PAUSE && gameState != ST_HELP) cartRelease();   // free the cart's RAM as soon as it is left
  if (s_c8 && gameState != ST_CH8_PLAYING && gameState != ST_CH8_MENU) ch8Release();
  orientTick();
  jingleTick();
  pixelsTick();
  if (isPortraitState((uint8_t)gameState)) {   // portrait screens read screen-frame directions
    buttons = portRemap(buttons);
    pressed = portRemap(pressed);
  }

  // Hold the backlight steady on the splash: the light sensor sees the
  // animated screen itself and the easing made brightness visibly shimmer.
  // (Also held steady during the attract animation, for the same reason as the splash.)
  if (gameState != ST_SPLASH && gameState != ST_ATTRACT) updateAutoBacklight();

  if (s_favDirty && (long)(millis() - s_favSaveAt) >= 0) {
    s_favDirty = false;
    saveWrite();
  }
  menuAnimTick();
  toastService();
  {   // a Start hold must not carry over across a state change or a release
    static GameState s_pauseHeldState = ST_SPLASH;
    if (!(buttons & ARCADA_BUTTONMASK_START) || gameState != s_pauseHeldState) s_pauseHeld = false;
    s_pauseHeldState = gameState;
  }

  // Picker bookkeeping: Mix / Challenge are over whenever the picker is showing (that is
  // every exit path: B, pause "Back to Games", results screens). Idle for ~30 s -> attract.
  {
    static bool wasPicker = false;
    static uint8_t prevSt = ST_SPLASH;
    if (buttons) s_lastInputMs = millis();
    if (gameState == ST_GAME_PICKER) {
      if (!wasPicker) { s_lastInputMs = millis(); shelfArrived(prevSt); }
      if (g_mixActive) mixAbort();
      if (g_challengeN || g_challengeSeed) { g_challengeN = 0; g_challengeSeed = 0; }
      if (s_lvlRecovered) { s_lvlRecovered = false; toastShow("Level recovered"); }
      if (millis() - s_lastInputMs >= ATTRACT_IDLE_MS && !buttons) attractStart();
    }
    wasPicker = (gameState == ST_GAME_PICKER);
    prevSt = (uint8_t)gameState;
  }
  if (gameState == ST_ATTRACT) {
    if (buttons) { // any button wakes it; that press does nothing else
      s_lastInputMs = millis();
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  // Challenge rounds have a fixed tier/seed: no mode, seed or level-menu changes on their title.
  if (g_challengeN && (gameState == ST_GALLERY_TITLE || gameState == ST_MOLE_TITLE ||
                       gameState == ST_SNAKE_TITLE || gameState == ST_BRK_TITLE ||
                       gameState == ST_CATCH_TITLE || gameState == ST_GAP_TITLE ||
                       gameState == ST_BSTK_TITLE || gameState == ST_PLINKO_TITLE ||
                       gameState == ST_CUBE_TITLE || gameState == ST_FLOOD_TITLE ||
                       gameState == ST_ROCKS_TITLE || gameState == ST_GEM_TITLE)) {
    pressed &= ~(uint32_t)(ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT |
                           ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN);
  }

  // Select is the quick "menu / back" key: on these screens it acts exactly like B.
  // (Playing states are handled in checkPauseMenu; the picker, Portal and the level
  // editor handle Select themselves.)
  if (pressed & ARCADA_BUTTONMASK_SELECT) {
    switch (gameState) {
      case ST_SETTINGS: case ST_TROPHIES: case ST_CREDITS: case ST_HISCORES: case ST_USBDRIVE: case ST_ERRLOG:
      case ST_PAUSE: case ST_LEVEL_MENU: case ST_LEVEL_SAVE_MENU: case ST_MIX_RESULTS:
      case ST_TWOP_RESULTS: case ST_TURN_PROMPT: case ST_HELP:
      case ST_GALLERY_TITLE: case ST_MAZE_TITLE: case ST_REACT_TITLE: case ST_MOLE_TITLE:
      case ST_SIMON_TITLE: case ST_SOKOBAN_TITLE: case ST_DODGE_TITLE: case ST_MASH_TITLE:
      case ST_ASTEROID_TITLE: case ST_BRAWL_TITLE: case ST_SNAKE_TITLE: case ST_MEM_TITLE:
      case ST_BRK_TITLE: case ST_TTT_TITLE: case ST_CATCH_TITLE: case ST_COLOR_TITLE:
      case ST_MATH_TITLE: case ST_PONG_TITLE: case ST_GAP_TITLE: case ST_PLAT_TITLE:
      case ST_INV_TITLE: case ST_RPS_TITLE: case ST_TIMING_TITLE: case ST_BALLOON_TITLE:
      case ST_LIGHTS_TITLE: case ST_DICE_TITLE: case ST_GUESS_TITLE: case ST_HOCKEY_TITLE:
      case ST_C4_TITLE: case ST_TILT_TITLE: case ST_BSTK_TITLE: case ST_2048_TITLE:
      case ST_MINE_TITLE: case ST_ROAD_TITLE: case ST_PAC_TITLE:
      case ST_LAND_TITLE: case ST_SKY_TITLE: case ST_BEAT_TITLE: case ST_REV_TITLE:
      case ST_TANK_TITLE: case ST_BLAST_TITLE: case ST_TOWER_TITLE: case ST_SLIDE_TITLE:
      case ST_PLINKO_TITLE: case ST_SLOTS_TITLE: case ST_CUBE_TITLE: case ST_FLOOD_TITLE:
      case ST_ROCKS_TITLE: case ST_GEM_TITLE: case ST_RACER_TITLE:
      case ST_BUBBLE_TITLE: case ST_MIND_TITLE: case ST_CK_TITLE:
      case ST_CHESS_TITLE: case ST_SLALOM_TITLE: case ST_QUEST_TITLE:
      case ST_HANG_TITLE:
      case ST_WORDLE_TITLE:
      case ST_SUDOKU_TITLE:
      case ST_NONO_TITLE:
      case ST_MISSILE_TITLE:
      case ST_PIPE_TITLE:
      case ST_CART_TITLE: case ST_CART_ERR: case ST_CH8_LIST: case ST_CH8_ERR:
      // @@SELB
        pressed |= ARCADA_BUTTONMASK_B;
        break;
      default: break;
    }
  }

  if (s_lvlTestPlay && lvlTestPlayTick(pressed)) return;   // editor Test Play return paths
  if (s_lvlPackPlay && pkPlayTick(pressed)) return;        // level-pack play: back to the pack list / next level
  if (s_lvlPack && lvlPackTick(pressed)) return;           // "Play All Custom" hand-off
  if (gameState == ST_TURN_PROMPT) {
    turnPromptUpdate(pressed);
    return;
  }
  if (gameState == ST_MIX_INTRO) {
    if (pressed & ARCADA_BUTTONMASK_B) {
      mixAbort();
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    unsigned long nowMx = millis();
    if (nowMx >= g_mixIntroEnd ||
        ((pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) && nowMx - g_mixAnimT0 > 400)) {
      mixLaunchCurrent();
    }
    return;
  }
  if (gameState == ST_MIX_RESULTS) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_START)) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_CREDITS) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_START)) {
      gameState = ST_SETTINGS;
      drawSettingsScreen();
    }
    return;
  }

  if (gameState == ST_USBDRIVE) {
    usbUpdate(pressed);
    return;
  }
  if (gameState == ST_ERRLOG) { errLogUpdate(pressed); return; }
  if (gameState == ST_DIAG) {   // raw buttons: Select is NOT an alias for B on this page
    diagUpdate(buttons, pressed);
    return;
  }

  if (gameState == ST_SPLASH) {
    if (pressed) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }

  if (gameState == ST_LEVEL_MENU) {
    updateLevelMenu(pressed);
    return;
  }
  if (gameState == ST_LEVEL_EDITOR) {
    updateLevelEditor(buttons, pressed);
    return;
  }
  if (gameState == ST_LEVEL_SAVE_MENU) {
    updateLevelSaveMenu(pressed);
    return;
  }

  if (gameState == ST_HELP) {
    if (pressed & (ARCADA_BUTTONMASK_RIGHT | ARCADA_BUTTONMASK_DOWN)) {
      helpPage(1);
    } else if (pressed & (ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_UP)) {
      helpPage(-1);
    } else if (pressed & (ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      helpClose();
    }
    return;
  }

  if (gameState == ST_PAUSE) {
    if (pressed & ARCADA_BUTTONMASK_UP) {
      s_pauseSel = (s_pauseSel + PAUSE_N - 1) % PAUSE_N;
      sfxMove();
      drawPauseMenu();
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      s_pauseSel = (s_pauseSel + 1) % PAUSE_N;
      sfxMove();
      drawPauseMenu();
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      sfx(600, 40);
      if (s_pauseSel == 0) { // Resume
        gameState = s_pauseResumeState;
        s_fadeSkipOnce = true;
        s_lastFrameMs = 0; // don't let a huge paused dt hit physics on the next frame
      } else if (s_pauseSel == 1) { // Restart
        if (s_pauseRestartFn) s_pauseRestartFn();
      } else if (s_pauseSel == 2) { // How to Play (B returns here)
        if (s_cv) cartHelpOpen(); else helpOpen(g_save.lastPlayed < NUM_GAMES ? g_save.lastPlayed : 0, 0);
      } else { // Back to Games (also abandons a Mix run / Challenge round)
        if (s_pauseResumeState == ST_CHESS_PLAYING) chsSaveOnLeave();
        mixAbort();
        if (s_lvlTestPlay || s_lvlPackPlay) {   // editor Test Play: back to the editor, work intact (pack play: back to the pack list)
          lvlTestPlayExit();
        } else {
          gameState = ST_GAME_PICKER;
          drawGamePicker();
        }
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = s_pauseResumeState;
      s_fadeSkipOnce = true;
      s_lastFrameMs = 0;
    }
    return;
  }

  if (gameState == ST_HISCORES) {
    int hsList[NUM_GAMES];
    int hsN = hsScoredList(hsList);
    if (pressed & ARCADA_BUTTONMASK_DOWN) {
      if (s_hsTop < hsN - HS_ROWS) s_hsTop++;
      sfxMove();
      drawHiScoresScreen();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      if (s_hsTop > 0) s_hsTop--;
      sfxMove();
      drawHiScoresScreen();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      s_hsTier = (s_hsTier + 1) % SAVE_TIERS;
      sfxMove();
      drawHiScoresScreen();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      s_hsTier = (s_hsTier + SAVE_TIERS - 1) % SAVE_TIERS;
      sfxMove();
      drawHiScoresScreen();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }

  if (gameState == ST_GAME_PICKER) {
    // B: tap (released before the hold threshold) opens Settings, holding B
    // opens High Scores (mirrors checkPauseMenu's hold gesture). Select is an
    // immediate alias for Settings.
    static bool pickBHeld = false, pickBConsumed = false;
    static unsigned long pickBSince = 0;
    if (pressed & ARCADA_BUTTONMASK_SELECT) { // immediate Settings (B tap does it on release)
      pickBHeld = false;
      s_settingsSel = 0; s_setHi = 1; s_setScr = 0; s_settingsTop = 0;
      gameState = ST_SETTINGS;
      drawSettingsScreen();
      return;
    }
    if (pressed & ARCADA_BUTTONMASK_B) {
      pickBHeld = true;
      pickBConsumed = false;
      pickBSince = millis();
    }
    if (pickBHeld) {
      if (buttons & ARCADA_BUTTONMASK_B) {
        if (!pickBConsumed && millis() - pickBSince >= PAUSE_HOLD_MS) {
          pickBConsumed = true;
          s_hsTop = 0;
          s_hsTier = saveTierOf(g_variant);
          evSet2(0);
          gameState = ST_HISCORES;
          sfx(600, 40);
          drawHiScoresScreen();
        }
      } else {
        pickBHeld = false;
        if (!pickBConsumed) {
          s_settingsSel = 0; s_setHi = 1; s_setScr = 0; s_settingsTop = 0;
          gameState = ST_SETTINGS;
          drawSettingsScreen();
        }
      }
      return;
    }
    // Up: tap toggles the favorite star on release; hold (~0.7 s) = "Surprise me", a quick
    // slot-machine run that stops on a random game of the list.
    {
      static bool pickUpHeld = false, pickUpDone = false;
      static unsigned long pickUpSince = 0;
      if (pressed & ARCADA_BUTTONMASK_UP) { pickUpHeld = true; pickUpDone = false; pickUpSince = millis(); }
      if (pickUpHeld) {
        if (!(buttons & ARCADA_BUTTONMASK_UP)) {
          pickUpHeld = false;
          if (!pickUpDone) {
            pickerToggleFavorite();
            sfx(700, 30);
            drawGamePicker();
            return;
          }
        } else if (!pickUpDone && millis() - pickUpSince >= 700) {
          pickUpDone = true;
          pickerSurprise();
          return;
        }
      }
    }
    // Down: tap cycles the category filter on release; hold (~0.7 s) = Challenges & Awards.
    {
      static bool pickDnHeld = false, pickDnDone = false;
      static unsigned long pickDnSince = 0;
      if (pressed & ARCADA_BUTTONMASK_DOWN) { pickDnHeld = true; pickDnDone = false; pickDnSince = millis(); }
      if (pickDnHeld) {
        if (!(buttons & ARCADA_BUTTONMASK_DOWN)) {
          pickDnHeld = false;
          if (!pickDnDone) {
            pickerCycleFilter();
            sfxMove();
            drawGamePicker();
            return;
          }
        } else if (!pickDnDone && millis() - pickDnSince >= 700) {
          pickDnDone = true;
          hubOpen(1);
          return;
        }
      }
    }
    // Right/Left move through the games.
    if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      pickerMove(1);
      sfxMove();
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      pickerMove(-1);
      sfxMove();
      drawGamePicker();
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      pickerRebuild();
      if (s_pickN == 0 || pickerPos() < 0) {
        sfxBlocked();
        return;
      }
      sfx(600, 40);
      shelfInsert(pickerSelection);
      if (cartIsId(pickerSelection)) { cartLaunch(pickerSelection - CART_BASE); return; }
      // First launch of this game from the picker: show its How to Play screen first
      // (not in 2P; Mix / Challenge / boot-to-last / Restart never come through here).
      if (!(g_save.miscFlags & 4) && !g_twoPlayerMode && !helpSeen(pickerSelection)) {
        helpOpen(pickerSelection, 1);
        return;
      }
      launchGame(pickerSelection);
    }
    return;
  }

  if (gameState == ST_SETTINGS) {
    bool wasArmed = s_resetArmed;
    const uint32_t kAorStart = ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START;
    const uint32_t kLR = ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT;
    if (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN)) {
      s_resetArmed = false;
      if (pressed & ARCADA_BUTTONMASK_UP) s_settingsSel = (s_settingsSel + SET_ROWS - 1) % SET_ROWS;
      else s_settingsSel = (s_settingsSel + 1) % SET_ROWS;
      sfxMove();
      drawSettingsScreen();
    } else if (pressed & kLR) {
      int d = (pressed & ARCADA_BUTTONMASK_RIGHT) ? 1 : -1;
      s_resetArmed = false;
      bool valueRow = true;
      switch (s_settingsSel) {
        case SR_BRIGHT: s_brightnessMode = (s_brightnessMode + 6 + d) % 6; break;
        case SR_SOUND: s_soundOn = !s_soundOn; break;
        case SR_VOLUME:
          g_save.volume = (uint8_t)((g_save.volume + 3 + d) % 3);
          saveWrite();
          break;
        case SR_2P: g_twoPlayerMode = !g_twoPlayerMode; break;
        case SR_BOOT:
          g_save.bootMode = g_save.bootMode ? 0 : 1;
          saveWrite();
          break;
        case SR_BOOTSND:
          g_save.miscFlags ^= 1;
          saveWrite();
          break;
        case SR_MUSIC:
          g_save.miscFlags ^= 2;
          saveWrite();
          break;
        case SR_AUTOHELP:
          g_save.miscFlags ^= 4;
          saveWrite();
          break;
        case SR_MENU:
          miscSetFlag(MF_SHELF_LIST, !miscGetFlag(MF_SHELF_LIST));
          saveWrite();
          break;
        case SR_CARTANIM: {   // Full -> Quick -> Off
          int ca = (int)miscGetField(MF_CARTANIM_SHIFT, 2);
          if (ca > 2) ca = 0;
          miscSetField(MF_CARTANIM_SHIFT, 2, (uint8_t)((ca + 3 + d) % 3));
          saveWrite();
          break;
        }
        case SR_PORT:
          g_save.pad[0] = (uint8_t)((portSetting() + 3 + d) % 3);
          saveWrite();
          break;
        case SR_TILT:
          g_save.miscFlags ^= 16;
          saveWrite();
          break;
        case SR_TILTGAIN: {   // Low / Med / High  <->  field 1 / 0 / 2
          uint8_t tg = miscGetField(MF_TILT_SHIFT, 2);
          int idx = tg == 1 ? 0 : (tg == 2 ? 2 : 1);
          idx = (idx + 3 + d) % 3;
          miscSetField(MF_TILT_SHIFT, 2, (uint8_t)(idx == 0 ? 1 : (idx == 2 ? 2 : 0)));
          saveWrite();
          break;
        }
        default: valueRow = false; break;
      }
      if (valueRow) {
        g_save.evFlags |= 8;
        if (s_settingsSel == SR_BRIGHT) evSet2(3);
        if (s_settingsSel == SR_VOLUME && g_save.volume == 0) evSet2(4);
        if (s_settingsSel == SR_2P && g_twoPlayerMode) evSet2(7);
        if (s_settingsSel == SR_BOOT && g_save.bootMode) evSet2(5);
        if (s_settingsSel == SR_SOUND && !s_soundOn) g_save.evFlags |= 16;
        checkAchievements();
      }
      if (s_settingsSel == SR_VOLUME) sfx(660, 50); else sfxMove();
      drawSettingsScreen();
    } else if (pressed & (ARCADA_BUTTONMASK_B | kAorStart)) {
      s_resetArmed = false;
      bool a = (pressed & kAorStart) != 0;
      if (a && s_settingsSel == SR_HUB) {
        hubOpen(0);
      } else if (a && s_settingsSel == SR_CREDITS) {
        s_creditsT0 = millis();
        gameState = ST_CREDITS;
        sfx(600, 40);
        drawCreditsScreen();
      } else if (a && s_settingsSel == SR_USB) {
        usbOpen();
      } else if (a && s_settingsSel == SR_DIAG) {
        diagOpen();
      } else if (a && s_settingsSel == SR_ERRLOG) {
        errLogOpen();
      } else if (a && s_settingsSel == SR_RESTORE) {
        if (!wasArmed) {
          if (!bakExists()) {
            toastShow("No backup");
            sfxBlocked();
          } else {
            s_resetArmed = true;
            sfx(300, 60);
          }
          drawSettingsScreen();
        } else {
          bakRestoreAndReboot();   // reboots on success; returns only on failure
          drawSettingsScreen();
        }
      } else if (a && s_settingsSel == SR_SNDTEST) {
        static const uint16_t kTestNotes[8] = {523, 659, 784, 1047, 784, 659, 523, 392};
        for (int i = 0; i < 8; i++) {
          sfx(kTestNotes[i], 70);
          delay(75);
        }
        s_prevButtons = arcada.readButtons(); // don't let a press made during the arpeggio count twice
      } else if (a && s_settingsSel == SR_RESET_ACH) {
        if (!wasArmed) {
          s_resetArmed = true;
          sfx(300, 60);
          drawSettingsScreen();
        } else {
          achClearAll();
          lvlSavedSync();   // level files stay on disk: rebuild the saved-levels mask
          evSet2(6);
          trophySyncSilent();
          checkAchievements();
          saveWrite();
          toastShow("Achievements reset");
          sfxDeath();
          drawSettingsScreen();
        }
      } else if (a && s_settingsSel == SR_DELLVLS) {
        if (!wasArmed) {
          s_delLvlN = lvlCountAllSaved();
          if (s_delLvlN == 0) {
            toastShow("No custom levels");
            sfxBlocked();
          } else {
            s_resetArmed = true;
            sfx(300, 60);
          }
          drawSettingsScreen();
        } else {
          bakAll();   // safety copy of the three save files before anything is deleted
          for (int g = 0; g < LVL_NUM_GAMES; g++)
            for (int sl = 0; sl < LVL_SLOTS; sl++) lvlDeleteSlot((uint8_t)g, (uint8_t)sl);
          s_lvlRamUsed = 0;
          for (int i = 0; i < LVL_NUM_GAMES; i++) s_lvlActiveSlot[i] = -1;
          s_lvlCacheGame = 0xFF;
          s_lvlPack = false;
          toastShow("Levels deleted");
          sfxDeath();
          drawSettingsScreen();
        }
      } else if (a && s_settingsSel == SR_RESET_SAVES) {
        if (!wasArmed) {
          s_resetArmed = true;
          sfx(300, 60);
          drawSettingsScreen();
        } else {
          // Clear scores, stats, favorites and achievements; keep the
          // settings (volume/boot/chime/music/challenge #). Level-creator files are untouched.
          bakBeforeReset();   // safety copy first (skipped when there is nothing worth keeping)
          uint8_t keepVol = g_save.volume, keepBoot = g_save.bootMode, keepMisc = g_save.miscFlags;
          uint8_t keepC0 = g_save.chalN[0], keepC1 = g_save.chalN[1], keepPort = g_save.pad[0];
          // SaveMisc settings kept: Checkers flip, tilt sens, challenge pool, hub focus, migrated bit, menu layout, cartridge anim
          uint32_t keepMF = g_saveMisc.flags & ((1UL << MF_CKFLIP_OFF) | (3UL << MF_TILT_SHIFT) | (1UL << MF_CHAL_CLASSIC) |
                                                (7UL << MF_HUBFOCUS_SHIFT) | (1UL << MF_LVL_MIGRATED) | (1UL << MF_SHELF_LIST) | (3UL << MF_CARTANIM_SHIFT));
          saveDefaults();
          g_saveMisc.flags = keepMF;
          g_mixLastTotal = -1;
          g_mixBestTotal = -1;
          g_save.volume = keepVol;
          g_save.bootMode = keepBoot;
          g_save.miscFlags = keepMisc;
          g_save.chalN[0] = keepC0;
          g_save.chalN[1] = keepC1;
          g_save.pad[0] = keepPort;
          s_pickFilter = 0;
          s_favDirty = false;
          lvlSavedSync();   // level files stay on disk: rebuild the saved-levels mask
          saveWrite();
          toastShow("Saves reset");
          sfxDeath();
          drawSettingsScreen();
        }
      } else if (a && s_settingsSel == SR_FACTORY) {
        factoryReset();   // reboots on success; returns on cancel / abort
        s_prevButtons = arcada.readButtons();
        drawSettingsScreen();
      } else if (!a || setIsValueRow(s_settingsSel)) {
        gameState = ST_GAME_PICKER;
        drawGamePicker();
      }
    }
    return;
  }

  if (gameState == ST_HUB) {
    hubUpdate(buttons, pressed);
    return;
  }

  if (gameState == ST_TROPHIES) {
    if (pressed & ARCADA_BUTTONMASK_DOWN) {
      s_trophySel = (s_trophySel + 1) % NUM_TROPHIES;
      sfxMove();
      drawTrophyScreen();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      s_trophySel = (s_trophySel + NUM_TROPHIES - 1) % NUM_TROPHIES;
      sfxMove();
      drawTrophyScreen();
    } else if (pressed & (ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      gameState = ST_HUB;   // Trophies is only opened from the hub
      drawHubScreen();
    }
    return;
  }

  if (gameState == ST_TWOP_INTRO) {
    if ((pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) && g_twoPEnterFn) {
      s_mazeRng = g_twoPSeed;
      g_twoPEnterFn();
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START |
                          ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_SELECT)) {
      g_twoPPlayerNum = 1;          // no game to start (or cancelled): back to the picker
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }

  if (gameState == ST_TWOP_RESULTS) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_START)) {
      g_twoPPlayerNum = 1;
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }

  if (gameState == ST_TITLE) {
    // Start or Select opens the level menu here instead of also playing (unlike
    // every other title screen's A/Start) -- this screen is the only one that
    // needs a fourth action beyond play/back.
    if (pressed & ARCADA_BUTTONMASK_A) {
      enterPlaying(0);
    } else if (pressed & (ARCADA_BUTTONMASK_START | ARCADA_BUTTONMASK_SELECT)) {
      menuSelection = 0;
      gameState = ST_MENU;
      drawLevelMenu();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }

  if (gameState == ST_GALLERY_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterGalleryPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterGalleryPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      cycleUserSeed();
      enterGalleryTitle();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterGalleryTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterGalleryTitle();
    }
    return;
  }

  if (gameState == ST_GALLERY_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterGalleryTitle();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }

  if (gameState == ST_GALLERY_PLAYING) {
    if (checkPauseMenu(buttons, enterGalleryPlaying)) return;
    unsigned long galNow = millis();
    float galDt = (s_lastFrameMs == 0) ? 0.016f : (galNow - s_lastFrameMs) / 1000.0f;
    if (galDt > 0.05f) galDt = 0.05f;
    s_lastFrameMs = galNow;

    // Slower than Portal's TURN_SPEED -- aiming at a small crosshair
    // target needs finer control than just walking around a level does.
    if (buttons & ARCADA_BUTTONMASK_LEFT) playerAngle -= galleryTurnSpeedCur * galDt;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) playerAngle += galleryTurnSpeedCur * galDt;
    if (playerAngle > 6.2831853f) playerAngle -= 6.2831853f;
    if (playerAngle < -6.2831853f) playerAngle += 6.2831853f;

    float gdirX = cosf(playerAngle), gdirY = sinf(playerAngle);
    float gplaneLen = tanf(FOV_RADIANS * 0.5f);
    float gplaneX = -gdirY * gplaneLen, gplaneY = gdirX * gplaneLen;

    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B)) {
      galleryTryShoot(playerX / TILE_SIZE, playerY / TILE_SIZE, gdirX, gdirY,
                       gplaneX, gplaneY);
    }

    for (int i = 0; i < MAX_TARGETS; i++) {
      if (targets[i].active && galNow >= targets[i].expiresAtMs)
        spawnTarget(i, galNow); // missed -- just relocate it, no penalty
    }

    if (galNow >= galleryEndAtMs) {
      recordResult(1, g_variant, (long)(galleryScore), true);
      if (twoPOrMix()) {
        twoPHandleGameEnd(galleryScore);
      } else {
        gameState = ST_GALLERY_OVER;
        drawGalleryOverScreen();
      }
      return;
    }

    drawGalleryScene();
    drawGalleryHud(galNow);
    blitScreen();
    return;
  }

  if (gameState == ST_MAZE_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = false;
        strncpy(g_twoPScoreLabel, "TIME(ms)", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterMazePlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterMazePlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterMazeTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterMazeTitle();
    } else if (pressed & ARCADA_BUTTONMASK_UP) {
      s_lvlCurGame = LVLGAME_MAZE;
      s_lvlMenuSel = 0;
      gameState = ST_LEVEL_MENU;
      drawLvlPickMenu();
    }
    return;
  }

  if (gameState == ST_MAZE_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterMazePlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }

  if (gameState == ST_MAZE_PLAYING) {
    if (checkPauseMenu(buttons, enterMazePlaying)) return;
    unsigned long mazeNow = millis();
    float mazeDt = (s_lastFrameMs == 0) ? 0.016f : (mazeNow - s_lastFrameMs) / 1000.0f;
    if (mazeDt > 0.05f) mazeDt = 0.05f;
    s_lastFrameMs = mazeNow;

    // Faster than Portal's TURN_SPEED -- this is a speedrun, quick
    // corner-snapping turns matter more here than the precise aim Target
    // Rush wants or the deliberate pace Portal's puzzles want.
    if (buttons & ARCADA_BUTTONMASK_LEFT) playerAngle -= mazeTurnSpeedCur * mazeDt;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) playerAngle += mazeTurnSpeedCur * mazeDt;
    if (playerAngle > 6.2831853f) playerAngle -= 6.2831853f;
    if (playerAngle < -6.2831853f) playerAngle += 6.2831853f;

    float mix = 0, miy = 0;
    if (buttons & ARCADA_BUTTONMASK_UP) {
      mix += cosf(playerAngle) * MOVE_SPEED;
      miy += sinf(playerAngle) * MOVE_SPEED;
    }
    if (buttons & ARCADA_BUTTONMASK_DOWN) {
      mix -= cosf(playerAngle) * MOVE_SPEED;
      miy -= sinf(playerAngle) * MOVE_SPEED;
    }
    updatePlayer(mazeDt, mix, miy);

    if (levelWon) {
      mazeFinalElapsedMs = mazeNow - mazeStartMs;
      pixelsSet(0, 0, 0); // pixelsWinCelebration (from applyPlayerTileEffects) already ran; clear after
      if (s_lvlActiveSlot[LVLGAME_MAZE] < 0) recordResult(2, g_variant, (long)((long)mazeFinalElapsedMs), false);
      else {   // custom mazes keep their own per-slot record (lower time is better)
        s_lastNewBest = false;
        lvlRecordRun(LVLGAME_MAZE, (long)mazeFinalElapsedMs, false);
        lvlOnClear(LVLGAME_MAZE);
      }
      if (g_twoPlayerMode) {
        twoPHandleGameEnd((long)mazeFinalElapsedMs);
      } else {
        gameState = ST_MAZE_OVER;
        drawMazeOverScreen();
      }
      return;
    }

    updateMazeCompass();
    drawMazeScene();
    drawMazeHud(mazeNow - mazeStartMs);
    blitScreen();
    return;
  }

  // --- Reaction Test ---
  if (gameState == ST_REACT_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = false;
        strncpy(g_twoPScoreLabel, "TIME(ms)", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterReactPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterReactPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterReactTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterReactTitle();
    }
    return;
  }
  if (gameState == ST_REACT_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterReactPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_REACT_PLAYING) {
    unsigned long reactNow = millis();
    if (reactWaiting) {
      if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
        reactTooSoon = true;
        reactWaiting = false;
        sfxDeath();
        pixelsFlash(255, 0, 0, 80);
        s_lastNewBest = false; // false start: not a real time
        if (g_twoPlayerMode) {
          twoPHandleGameEnd(999999L); // jumped the gun -- worst possible time
        } else {
          gameState = ST_REACT_OVER;
          drawReactOverScreen();
        }
        return;
      }
      if (reactHasDecoy && !reactDecoyShown && reactNow >= reactDecoyAtMs) {
        reactDecoyShown = true;
        canvas->fillScreen(COL_ORANGE);
        canvas->setTextSize(2);
        ptc(COL_BG, 56, 50, "...");
        blitScreen();
      } else if (reactNow >= reactGoAtMs) {
        reactWaiting = false;
        reactArmed = true;
        sfx(1100, 50); // the "GO" cue itself
        canvas->fillScreen(COL_BOOST);
        canvas->setTextSize(2);
        ptc(COL_BG, 50, 50, "GO!");
        blitScreen();
      }
      return;
    }
    if (reactArmed && (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START))) {
      reactResultMs = reactNow - reactGoAtMs;
      if (reactResultMs < reactBestMs) {
        reactBestMs = reactResultMs;
        sfxWin(); // new best time
      } else {
        sfx(700, 60);
      }
      reactArmed = false;
      recordResult(3, g_variant, (long)((long)reactResultMs), false);
      if (g_twoPlayerMode) {
        twoPHandleGameEnd((long)reactResultMs);
      } else {
        gameState = ST_REACT_OVER;
        drawReactOverScreen();
      }
    }
    return;
  }

  // --- Whack-a-Mole ---
  if (gameState == ST_MOLE_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterMolePlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterMolePlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      cycleUserSeed();
      enterMoleTitle();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterMoleTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterMoleTitle();
    }
    return;
  }
