}

static void enterGalleryPlaying() {
  setupGalleryRoom();
  s_mazeRng = gameSeed(); // fresh spread each round unless a seed/2P/challenge fixes it
  galleryScore = 0;
  switch (g_variant) {
    case 1: galleryTargetLifetimeMs = 2000UL; galleryTurnSpeedCur = 1.6f; break; // Speed
    case 2: galleryTargetLifetimeMs = 4200UL; galleryTurnSpeedCur = 1.0f; break; // Chill
    case 3: galleryTargetLifetimeMs = 1400UL; galleryTurnSpeedCur = 1.9f; break; // Extreme
    case 4: galleryTargetLifetimeMs = 5500UL; galleryTurnSpeedCur = 0.8f; break; // Zen
    default: galleryTargetLifetimeMs = 3000UL; galleryTurnSpeedCur = 1.3f; break;
  }
  unsigned long now = millis();
  galleryEndAtMs = now + GALLERY_TIME_MS;
  for (int i = 0; i < MAX_TARGETS; i++) spawnTarget(i, now);
  gameState = ST_GALLERY_PLAYING;
  s_lastFrameMs = 0;
}

// Same billboard-transform math as drawBillboard3D, but we only need the
// screen X position and depth here to test against the fixed center
// crosshair -- not a full pixel render. Takes plain floats rather than a
// Target -- the Arduino IDE's auto-generated forward prototypes land
// above every struct definition in the translation unit, so a custom
// struct type in a function signature fails to compile no matter where
// in the .ino the struct itself is declared.
static bool galleryTargetScreenX(float targetX, float targetY, float posX,
                                  float posY, float dirX, float dirY,
                                  float planeX, float planeY, int* outScreenX,
                                  float* outTransformY) {
  float spriteX = (targetX / TILE_SIZE) - posX;
  float spriteY = (targetY / TILE_SIZE) - posY;
  float invDet = 1.0f / (planeX * dirY - dirX * planeY);
  float transformX = invDet * (dirY * spriteX - dirX * spriteY);
  float transformY = invDet * (-planeY * spriteX + planeX * spriteY);
  if (transformY <= 0.1f) return false;
  *outScreenX = (int)((VIEW3D_W / 2) * (1.0f + transformX / transformY));
  *outTransformY = transformY;
  return true;
}

#define GALLERY_HIT_TOLERANCE_PX 22 // widened to match the bigger target sprite (sizeScale 2.2f)

static void galleryTryShoot(float posX, float posY, float dirX, float dirY,
                             float planeX, float planeY) {
  int centerX = VIEW3D_W / 2;
  int bestIdx = -1;
  float bestDist = 1e9f;
  for (int i = 0; i < MAX_TARGETS; i++) {
    if (!targets[i].active) continue;
    int screenX;
    float transformY;
    if (!galleryTargetScreenX(targets[i].x, targets[i].y, posX, posY, dirX,
                               dirY, planeX, planeY, &screenX, &transformY))
      continue;
    if (abs(screenX - centerX) > GALLERY_HIT_TOLERANCE_PX) continue;
    int zx = (screenX < 0) ? 0 : (screenX >= VIEW3D_W ? VIEW3D_W - 1 : screenX);
    if (transformY >= s_zbuffer[zx]) continue; // blocked by a wall
    if (transformY < bestDist) {
      bestDist = transformY;
      bestIdx = i;
    }
  }
  if (bestIdx >= 0) {
    galleryScore++;
    sfx(1200, 40);
    pixelsFlash(60, 255, 90, 30);
    spawnTarget(bestIdx, millis());
  } else {
    sfx(150, 30);
  }
}

