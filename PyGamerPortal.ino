  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TELE_B);
  const int sw = canvas->width(), yo = (canvas->height() - 128) / 2;
  if (gapWon) {
    ptc(COL_GOAL, (sw - 66) / 2, 20 + yo, "LEVEL CLEAR");
