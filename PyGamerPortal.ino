#define TTT_CELL 36
#define TTT_BOARD_X 26
#define TTT_BOARD_Y (HUD_HEIGHT + 4)

// X strokes / O ring draw in over TTT_MARK_MS (t = 0..1).
static void tttDrawMark(int x, int y, int v, float t) {
  int cx = x + TTT_CELL / 2, cy = y + TTT_CELL / 2;
  if (v == 1) {
    uint16_t col = COL_GOAL;
    float a = t * 2.0f; // first stroke 0..0.5, second 0.5..1
    float b = t * 2.0f - 1.0f;
    if (a > 1.0f) a = 1.0f;
    if (b < 0.0f) b = 0.0f;
    for (int o = -1; o <= 0; o++) {
      canvas->drawLine(cx - 10 + o, cy - 10, cx - 10 + o + (int)(20.0f * a), cy - 10 + (int)(20.0f * a), col);
      if (b > 0.0f)
        canvas->drawLine(cx + 10 + o, cy - 10, cx + 10 + o - (int)(20.0f * b), cy - 10 + (int)(20.0f * b), col);
    }
  } else {
    int r = (int)(11.0f * animEase(t) + 0.5f);
    if (r < 1) return;
    canvas->drawCircle(cx, cy, r, COL_LASER);
    if (r > 1) canvas->drawCircle(cx, cy, r - 1, COL_LASER);
  }
}

static void drawTttScene() {
  unsigned long now = millis();
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  for (int i = 0; i < 9; i++) {
    int cx = i % 3, cy = i / 3;
    int x = TTT_BOARD_X + cx * TTT_CELL, y = TTT_BOARD_Y + cy * TTT_CELL;
    canvas->drawRect(x, y, TTT_CELL, TTT_CELL, COL_WALL);
    if (i == tttCursor) canvas->drawRect(x + 1, y + 1, TTT_CELL - 2, TTT_CELL - 2,
                                         animBlend(COL_PLATE_ON, 0xFFFF, animPulse(600) / 2));
    if (tttBoard[i] == 0) continue;
    float t = 1.0f;
    if (tttMarkT[i] != 0) {
      if ((long)(now - tttMarkT[i]) < 0) continue; // CPU mark not started yet
      t = (float)(now - tttMarkT[i]) / (float)TTT_MARK_MS;
      if (t > 1.0f) t = 1.0f;
    }
    tttDrawMark(x, y, tttBoard[i], t);
  }
  canvas->setTextSize(1);
}

// Index of the winning row/column/diagonal, or -1.
static int tttWinLineIdx() {
  static const int8_t ln[8][3] = {{0, 1, 2}, {3, 4, 5}, {6, 7, 8}, {0, 3, 6},
                                   {1, 4, 7}, {2, 5, 8}, {0, 4, 8}, {2, 4, 6}};
  for (int i = 0; i < 8; i++) {
    int8_t a = tttBoard[ln[i][0]];
    if (a != 0 && a == tttBoard[ln[i][1]] && a == tttBoard[ln[i][2]]) return i;
  }
  return -1;
}

static void drawTttHud();

// Short blocking finish (the round is over anyway): lets the last marks draw
// in, then a line sweeps through the winning three cells.
static void tttEndTween() {
  static const int8_t ln[8][3] = {{0, 1, 2}, {3, 4, 5}, {6, 7, 8}, {0, 3, 6},
                                   {1, 4, 7}, {2, 5, 8}, {0, 4, 8}, {2, 4, 6}};
  int li = tttWinLineIdx();
  unsigned long t0 = millis();
  unsigned long markEnd = 0;
  for (int i = 0; i < 9; i++)
    if (tttMarkT[i] != 0 && tttMarkT[i] + TTT_MARK_MS > markEnd) markEnd = tttMarkT[i] + TTT_MARK_MS;
  unsigned long sweepStart = (markEnd > t0 ? markEnd : t0);
  unsigned long endAt = sweepStart + (li >= 0 ? 220 : 0);
  while ((long)(endAt - millis()) > 0 && millis() - t0 < 600) {
    drawTttScene();
    unsigned long now = millis();
    if (li >= 0 && now > sweepStart) {
      float f = animEase((float)(now - sweepStart) / 220.0f);
      int a = ln[li][0], c = ln[li][2];
      int ax = TTT_BOARD_X + (a % 3) * TTT_CELL + TTT_CELL / 2, ay = TTT_BOARD_Y + (a / 3) * TTT_CELL + TTT_CELL / 2;
      int bx = TTT_BOARD_X + (c % 3) * TTT_CELL + TTT_CELL / 2, by = TTT_BOARD_Y + (c / 3) * TTT_CELL + TTT_CELL / 2;
      int ex = ax + (int)((bx - ax) * f), ey = ay + (int)((by - ay) * f);
      for (int o = -1; o <= 1; o++) canvas->drawLine(ax + o, ay, ex + o, ey, COL_KEY);
      canvas->drawLine(ax, ay + 1, ex, ey + 1, COL_KEY);
    }
    drawTttHud();
    blitScreen();
  }
}

static void drawTttHud() {
  canvas->fillRect(0, 0, VIEW_COLS * TILE_SIZE, HUD_HEIGHT, COL_BG);
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(1);
  canvas->setCursor(2, 4);
