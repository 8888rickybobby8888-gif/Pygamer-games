  {0x18, 0x18, 0x18, 0x7E, 0x3C, 0x18, 0x00, 0xFF},   // restore
  {0x81, 0x42, 0x24, 0x18, 0x18, 0x24, 0x42, 0x81},   // X
  {0x3C, 0xFF, 0x42, 0x5A, 0x5A, 0x5A, 0x42, 0x7E},   // trash
  {0x7E, 0x5A, 0x5A, 0x7E, 0x7E, 0x66, 0x66, 0x7E},   // floppy
  {0x18, 0x3C, 0x3C, 0x7E, 0x7E, 0xFF, 0xFF, 0x00}};  // warning

static bool setIsValueRow(int sr) { return sr <= SR_MUSIC || (sr >= SR_2P && sr <= SR_TILTGAIN); }
static bool setIsArmRow(int sr) { return sr == SR_RESTORE || sr == SR_RESET_ACH || sr == SR_DELLVLS || sr == SR_RESET_SAVES; }
static int setLineOf(int sr) {
  int n = 0;
  for (int g = 0; g < SET_GROUPS; g++) if (kSetGrp[g] <= sr) n++;
  return sr + n;
}
static int setRowY(float line) { return SET_Y0 + (int)floorf((line - s_setScr) * SET_PITCH + 0.5f); }
// Keeps the selected row (and its group header when it is the first of a group) in the window.
static void setFixTop() {
  int ln = setLineOf(s_settingsSel);
  int need = ln;
  for (int g = 0; g < SET_GROUPS; g++) if (kSetGrp[g] == s_settingsSel) need = ln - 1;
  if (need < s_settingsTop) s_settingsTop = need;
  if (ln >= s_settingsTop + SET_VISIBLE) s_settingsTop = ln - SET_VISIBLE + 1;
  if (s_settingsTop > SET_LINES - SET_VISIBLE) s_settingsTop = SET_LINES - SET_VISIBLE;
  if (s_settingsTop < 0) s_settingsTop = 0;
}

static void setArrows(int ry, int xl, int xr, bool sel) {
  uint16_t c = sel ? COL_KEY : animBlend(COL_BG, COL_WALL, 150);
  int nd = (sel && s_setPl >= 2) ? 1 : 0;
  ptc(c, xl + nd, ry + 2, "<");
  ptc(c, xr - nd, ry + 2, ">");
}
// Segmented bar (on < 0 = AUTO pill), 44 px wide at x 95..139.
static void setSegs(int ry, int on, int n, int w, uint16_t c, bool sel) {
  setArrows(ry, 88, 141, sel);
  if (on < 0) {
    canvas->fillRoundRect(103, ry + 1, 36, 10, 4, COL_ICE);
    ptc(COL_BG, 109, ry + 2, "AUTO");
    return;
  }
  for (int k = 0; k < n; k++)
    canvas->fillRect(95 + k * (w + 1), ry + 3, w, 6, k < on ? c : animBlend(COL_BG, COL_WALL, 90));
}
static void setChoice(int ry, const char* v, bool sel) {
  int w = (int)strlen(v) * 6;
  int xl = 147 - w - 18;
  setArrows(ry, xl, 141, sel);
  canvas->fillRoundRect(xl + 7, ry + 1, w + 4, 10, 3, animBlend(COL_BG, sel ? COL_ICE : COL_WALL, 70));
  ptc(sel ? COL_TEXT : animBlend(COL_BG, COL_TEXT, 190), xl + 9, ry + 2, v);
}
static void setSwitch(int ry, bool on, bool sel) {
  canvas->fillRoundRect(126, ry + 1, 20, 10, 5, on ? COL_GOAL : animBlend(COL_BG, COL_WALL, 110));
  canvas->fillCircle(on ? 140 : 132, ry + 6, 3, animBlend(COL_BG, COL_TEXT, sel ? 255 : 190));
  ptc(on ? COL_GOAL : animBlend(COL_BG, COL_WALL, 170), on ? 108 : 102, ry + 2, on ? "ON" : "OFF");
}

// Foreground of one row (icon, label, value widget) at top y = ry.
static void setDrawRow(int sr, int ry) {
  bool sel = sr == s_settingsSel;
  bool dg = sr >= SR_RESET_ACH;
  if (sel && s_resetArmed && setIsArmRow(sr)) {   // armed: the prompt replaces icon, label and widget
    char b[26];
    if (sr == SR_RESTORE) snprintf(b, sizeof(b), "Restore? A=yes");
    else if (sr == SR_DELLVLS) snprintf(b, sizeof(b), "Delete %d lvls? A=yes", s_delLvlN);
    else snprintf(b, sizeof(b), "SURE? A=yes, other=no");
    ptc(COL_TEXT, 8, ry + 2, b);
    return;
  }
  uint16_t acc = dg ? 0xFACB : COL_ICE;
  canvas->drawBitmap(7, ry + 2, kSetIcon[sr], 8, 8, sel ? COL_KEY : animBlend(COL_BG, acc, 190));
  ptc(sel ? COL_TEXT : animBlend(COL_BG, dg ? 0xFACB : COL_TEXT, 200), 18, ry + 2, kSetLbl[sr]);
  switch (sr) {
    case SR_BRIGHT: setSegs(ry, s_brightnessMode == 0 ? -1 : (int)s_brightnessMode, 5, 8, COL_KEY, sel); break;
    case SR_MENU: setChoice(ry, miscGetFlag(MF_SHELF_LIST) ? "List" : "Shelf", sel); break;
    case SR_CARTANIM: { uint8_t ca = miscGetField(MF_CARTANIM_SHIFT, 2); setChoice(ry, ca == 1 ? "Quick" : (ca >= 2 ? "Off" : "Full"), sel); break; }
    case SR_PORT: setChoice(ry, portSetting() == 0 ? "Auto" : portSetting() == 1 ? "Flip A" : "Flip B", sel); break;
    case SR_SOUND: setSwitch(ry, s_soundOn, sel); break;
    case SR_VOLUME: setSegs(ry, (int)(g_save.volume % 3) + 1, 3, 14, COL_GOAL, sel); break;
    case SR_BOOTSND: setSwitch(ry, !(g_save.miscFlags & 1), sel); break;
    case SR_MUSIC: setSwitch(ry, (g_save.miscFlags & 2) != 0, sel); break;
    case SR_2P: setSwitch(ry, g_twoPlayerMode, sel); break;
    case SR_BOOT: setChoice(ry, g_save.bootMode ? "Last game" : "Picker", sel); break;
    case SR_AUTOHELP: setSwitch(ry, !(g_save.miscFlags & 4), sel); break;
    case SR_TILT: setChoice(ry, (g_save.miscFlags & 16) ? "Invert" : "Normal", sel); break;
    case SR_TILTGAIN: { uint8_t tg = miscGetField(MF_TILT_SHIFT, 2); setChoice(ry, tg == 1 ? "Low" : (tg == 2 ? "High" : "Med"), sel); break; }
    default: ptc(sel ? COL_KEY : animBlend(COL_BG, COL_WALL, 150), 141 + ((sel && s_setPl >= 2) ? 1 : 0), ry + 2, ">"); break;
  }
}

static void drawSettingsScreen() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  setFixTop();
  s_setPl = animPulse(1000) >> 6;
  const int sel = s_settingsSel;
  const bool armed = s_resetArmed && setIsArmRow(sel);
  for (int pass = 0; pass < 2; pass++) {
    if (pass == 1) {   // sliding rounded highlight, pulsing; red for the danger zone / armed prompts
      int hy = setRowY(s_setHi);
      uint16_t base = armed ? animBlend(COL_BG, 0xF800, 110 + s_setPl * 30)
                    : sel >= SR_RESET_ACH ? animBlend(COL_BG, 0xF800, 70 + s_setPl * 14)
                    : animBlend(animBlend(COL_BG, COL_WALL_NOPORTAL, 210), COL_ICE, 16 + s_setPl * 12);
      canvas->fillRoundRect(3, hy, 146, 12, 3, base);
      canvas->drawRoundRect(3, hy, 146, 12, 3, animBlend(base, 0xFFFF, 110 + s_setPl * 30));
    }
    int line = 0, g = 0;
    for (int sr = 0; sr < SR_COUNT; sr++, line++) {
      if (g < SET_GROUPS && kSetGrp[g] == sr) {
        int hy = setRowY((float)line);
        if (pass == 0 && hy >= 2 && hy <= 109) {   // group header bar
          bool red = g == SET_GROUPS - 1;
          canvas->fillRoundRect(3, hy + 1, 146, 10, 2, animBlend(COL_BG, red ? 0xF800 : COL_ICE, red ? 60 : 45));
          ptc(red ? 0xFACB : COL_ICE, 8, hy + 2, kSetGrpName[g]);
        }
        line++;
        g++;
      }
      int ry = setRowY((float)line);
      if (ry < 2 || ry > 109) continue;
      if (pass == 0) {
        if (sr >= SR_RESET_ACH) canvas->fillRoundRect(3, ry, 146, 12, 3, animBlend(COL_BG, 0xF800, 26));
      } else {
        setDrawRow(sr, ry);
      }
    }
  }
  // Title bar
  canvas->fillRect(0, 0, 160, 13, animBlend(COL_BG, COL_ORANGE, 45));
  ptc(COL_ORANGE, 4, 3, "SETTINGS");
  char cb[8];
  snprintf(cb, sizeof(cb), "%d/%d", sel + 1, SR_COUNT);
  ptc(animBlend(COL_BG, COL_TEXT, 170), 152 - (int)strlen(cb) * 6, 3, cb);
  // Scrollbar
  canvas->fillRect(155, SET_Y0, 3, 96, animBlend(COL_BG, COL_WALL, 60));
  int th = 96 * SET_VISIBLE / SET_LINES;
  int ty = SET_Y0 + (int)((96 - th) * s_setScr / (float)(SET_LINES - SET_VISIBLE) + 0.5f);
  canvas->fillRect(155, ty, 3, th, animBlend(COL_WALL, COL_ICE, 150));
  // Footer: hint follows the selected row
  canvas->fillRect(0, 110, 160, 18, COL_BG);
  canvas->drawFastHLine(0, 110, 160, animBlend(COL_BG, COL_WALL, 90));
  const char* hint;
  if (armed) hint = "A: confirm  other: cancel";
  else if (setIsValueRow(sel)) hint = "L/R change   A: done";
  else if (sel == SR_SNDTEST) hint = "A: play";
  else if (sel == SR_FACTORY) hint = "A, then hold to confirm";
  else if (sel == SR_RESTORE) hint = "A twice: restore backup";
  else if (setIsArmRow(sel)) hint = "A twice: erase (danger)";
  else hint = "A: open";
  ptc(sel >= SR_RESET_ACH ? 0xFACB : COL_ICE, 4, 113, hint);
  ptc(animBlend(COL_BG, COL_TEXT, 140), 4, 120, "U/D move  B: back");
  blitScreen();
}

static void settingsAnimTick() {
  setFixTop();
  float th = (float)setLineOf(s_settingsSel), ts = (float)s_settingsTop;
  bool mv = s_setHi != th || s_setScr != ts;
  animChase(s_setHi, th, 0.42f);
  animChase(s_setScr, ts, 0.42f);
  // Redraw only while sliding, when the pulse level steps, or while a toast banner needs repainting under it.
  if (mv || (uint8_t)(animPulse(1000) >> 6) != s_setPl || s_toastPhase != 0 || s_toastQN != 0) drawSettingsScreen();
}

// --- Challenges & Awards hub (Settings -> Challenges & Awards, or hold Down in the picker) ---
// One page, three stacked panels: MIX MODE, CHALLENGE #N and AWARDS. Focus order is flat:
// 0 = Mix, 1 = Challenge, then the award list (list row 0 = "Trophies >", rows 1.. = the
// achievements in index order). B / Select returns to where the hub was opened from.
static void challengeParams(uint16_t n, uint8_t& game, uint8_t& tier, uint32_t& seed);   // defined with Challenge mode
#define HUB_MIX 0
#define HUB_CHAL 1
#define HUB_LIST0 2
#define HUB_LROWS (1 + NUM_ACH)
#define HUB_N (HUB_LIST0 + HUB_LROWS)
#define HUB_VIS 4
#define HUB_RY 88          // y of the first visible list row (pitch 8)
static uint8_t s_hubSel = 0;     // focus, 0..HUB_N-1
static uint8_t s_hubFrom = 0;    // 0 = opened from Settings, 1 = from the picker
static int s_hubTop = 0;         // first visible list row
static float s_hubHi = 0, s_hubScr = 0, s_hubFoc = 0;   // eased list bar / scroll / focused panel
static unsigned long s_hubT0 = 0, s_hubDescT0 = 0;       // open time (twinkle), selection time (marquee)
static bool s_hubDesc = false;   // full-width award description is showing (A on an award row)
static uint8_t s_hubListSel = 0; // last focused award-list row (Select jumps back to it)
static uint8_t hubGroup() { return s_hubSel < HUB_LIST0 ? s_hubSel : 2; }   // 0 Mix, 1 Challenge, 2 Awards

static void hubTitle(int x, int y, const char* t, uint16_t acc, bool foc) {
  canvas->setCursor(x, y);
  canvas->setTextColor(foc ? animBlend(acc, 0xFFFF, (uint8_t)(animPulse(900) / 2)) : animBlend(COL_BG, acc, 190));
  canvas->print(t);
}

static uint16_t hubBorder(int p, uint16_t acc) {
  float d = s_hubFoc - (float)p;
  if (d < 0) d = -d;
  float k = 1.0f - d;
  if (k < 0) k = 0;
  return animBlend(animBlend(COL_BG, COL_TEXT, 70), acc, (uint8_t)(k * 255.0f));
}

static void drawHubScreen() {
  char buf[48];
  unsigned long now = millis();
  int sel = s_hubSel;
  uint16_t dimTx = animBlend(COL_BG, COL_TEXT, 130);
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(animBlend(COL_ORANGE, COL_ICE, animPulse(2400)), 50, 1, "CHALLENGES");

  // --- MIX panel (y 9..36)
  hubTitle(4, 12, "MIX MODE", COL_ORANGE, sel == HUB_MIX);
  if (sel == HUB_MIX) {
    drawPulsingText(114, 12, "A: Play", COL_ORANGE, 700);
  } else {
    canvas->setCursor(114, 12);
    canvas->setTextColor(dimTx);
    canvas->print("A: Play");
  }
  canvas->setTextColor(COL_TEXT);
  canvas->setCursor(4, 20);
  snprintf(buf, sizeof(buf), "%d random games, stars/%d", MIX_COUNT, 3 * MIX_COUNT);
  canvas->print(buf);
  canvas->setCursor(4, 28);
  canvas->setTextColor(dimTx);
  if (g_mixBestTotal < 0) snprintf(buf, sizeof(buf), "No Mix run yet");
  else snprintf(buf, sizeof(buf), "Last %d/%d  Best %d/%d", (int)g_mixLastTotal, 3 * MIX_COUNT, (int)g_mixBestTotal, 3 * MIX_COUNT);
  canvas->print(buf);

  // --- CHALLENGE panel (y 37..66)
  uint8_t cg, ct;
  uint32_t cseed;
  challengeParams(s_chalSel, cg, ct, cseed);
  snprintf(buf, sizeof(buf), "CHALLENGE #%03d", (int)s_chalSel);
  hubTitle(4, 40, buf, COL_ICE, sel == HUB_CHAL);
  if (sel == HUB_CHAL) {
    int nud = animPulse(500) > 127 ? 1 : 0;
    ptc(COL_ICE, 110 - nud, 40, "<");
    pt(120, 40, "pick");
    pt(146 + nud, 40, ">");
  }
  drawGameIcon(4, 48, cg, 2, s_pickerColors[cg]);
  ptc(s_pickerColors[cg], 26, 49, kGameNames[cg]);
  ptc(COL_TEXT, 26, 58, kSpeedTierNames[ct & 3]);
  {   // personal best for this challenge number (between the tier name and "A: go")
    int32_t cb;
    if (miscChalGet(s_chalSel, miscGetFlag(MF_CHAL_CLASSIC), &cb)) {
      char val[16];
      fmtBestValue(cg, cb, val, sizeof(val));
      int bx = 26 + (int)strlen(kSpeedTierNames[ct & 3]) * 6 + 6;
      snprintf(buf, sizeof(buf), "Best %s", val);
      if (bx + (int)strlen(buf) * 6 > 122) snprintf(buf, sizeof(buf), "%s", val);
      if (bx + (int)strlen(buf) * 6 <= 124) {
        ptc(COL_KEY, bx, 58, buf);
      }
    }
  }
  if (miscGetFlag(MF_CHAL_CLASSIC) && sel != HUB_CHAL) {   // pool tag (the focused panel's footer says it too)
    ptc(dimTx, 96, 40, "CLASSIC");
  }
  if (sel == HUB_CHAL) drawPulsingText(126, 58, "A: go", COL_ICE, 700);
  else {
    canvas->setCursor(126, 58);
    canvas->setTextColor(dimTx);
    canvas->print("A: go");
  }

  // --- AWARDS panel (y 68..127): scrolling list first, then the masks and header over it
  const int LN = HUB_LROWS;
  int first = (int)floorf(s_hubScr) - 1;
  if (first < 0) first = 0;
  if (sel >= HUB_LIST0) {   // focus bar glides to the selected row
    int by = HUB_RY + (int)floorf((s_hubHi - s_hubScr) * 8.0f + 0.5f);
    canvas->fillRect(2, by - 1, 148, 9, COL_WALL_NOPORTAL);
  }
  for (int i = first; i < LN && i <= first + HUB_VIS + 1; i++) {
    int y = HUB_RY + (int)floorf(((float)i - s_hubScr) * 8.0f + 0.5f);
    if (y < 79 || y > 118) continue;
    bool on = (sel - HUB_LIST0 == i);
    uint16_t nc = on ? animBlend(COL_TEXT, 0xFFFF, animPulse(700)) : COL_TEXT;
    if (i == 0) {   // Trophies >
      uint16_t gold = on ? animBlend(COL_KEY, 0xFFFF, animPulse(700)) : COL_KEY;
      canvas->fillRect(6, y, 5, 3, gold);
      canvas->fillRect(8, y + 3, 1, 2, gold);
      canvas->fillRect(6, y + 5, 5, 1, gold);
      ptc(gold, 16, y, "Trophies");
      pt(66 + (on && animPulse(600) > 127 ? 2 : 0), y, ">");
      continue;
    }
    int a = i - 1;
    bool got = achGet(a);
    if (got) {
      uint16_t tc = COL_KEY;
      long tw = (long)(now - s_hubT0) - 120 - (long)(i - (int)floorf(s_hubScr)) * 70;
      if (tw >= 0 && tw < 280) {   // one-shot twinkle when the page opens
        uint8_t lv = (uint8_t)(255 - (int)(tw * 255 / 280));
        tc = animBlend(COL_KEY, 0xFFFF, lv);
        int r = (int)(tw / 70) + 1;
        canvas->drawPixel(8 - r, y + 4, tc);
        canvas->drawPixel(8 + r, y + 4, tc);
        canvas->drawPixel(8, y + 4 - r, tc);
        canvas->drawPixel(8, y + 4 + r, tc);
      }
      canvas->drawLine(5, y + 4, 7, y + 6, tc);
      canvas->drawLine(7, y + 6, 11, y + 1, tc);
    } else {   // lock
      uint16_t lc = animBlend(COL_BG, COL_TEXT, 110);
      canvas->drawRect(7, y, 3, 3, lc);
      canvas->fillRect(6, y + 3, 5, 4, lc);
    }
    ptc(got ? nc : animBlend(COL_BG, COL_TEXT, 120), 16, y, achName(a));
  }
  canvas->fillRect(1, 70, 158, 17, COL_BG);   // header mask (rows scroll underneath)
  uint16_t hc = (sel >= HUB_LIST0) ? animBlend(COL_KEY, 0xFFFF, (uint8_t)(animPulse(900) / 2)) : animBlend(COL_BG, COL_KEY, 190);
  canvas->setTextColor(hc);
  canvas->setCursor(3, 71);
  snprintf(buf, sizeof(buf), "AWARDS %d/%d %s %d/%d", achCount(), NUM_ACH,
           trophyCount() < 10 ? "TROPHIES" : "TROPHY", trophyCount(), NUM_TROPHIES);   // <= 26 chars
  canvas->print(buf);
  {
    int pl = statTotalPlays();
    char ps[16];
    if (pl < 1000) snprintf(ps, sizeof(ps), "%d", pl);
    else if (pl < 10000) snprintf(ps, sizeof(ps), "%d.%dk", pl / 1000, (pl % 1000) / 100);
    else snprintf(ps, sizeof(ps), "%dk", pl / 1000);
    snprintf(buf, sizeof(buf), "Play %s Games %d Best %d", ps, statDistinctPlayed(), statScoredGames());
    ptc(dimTx, 3, 79, buf);
  }
  if (LN > HUB_VIS) {   // scroll hints
    uint16_t ac = animBlend(COL_WALL, COL_ICE, animPulse(800));
    if (s_hubScr > 0.05f) canvas->fillTriangle(153, 88, 150, 92, 156, 92, ac);
    if (s_hubScr < (float)(LN - HUB_VIS) - 0.05f) canvas->fillTriangle(153, 118, 150, 114, 156, 114, ac);
  }
  if (s_hubDesc && sel > HUB_LIST0) {   // full-width wrapped description replaces the list for a moment
    int a = sel - HUB_LIST0 - 1;
    bool got = achGet(a);
    canvas->fillRect(1, 70, 158, 57, COL_BG);
    ptc(got ? COL_KEY : dimTx, 4, 73, achName(a));
    const char* p = achDesc(a);
    int y = 85;
    for (int row = 0; row < 3 && *p; row++) {
      int len = (int)strlen(p), cut = len;
      if (len > 25) { cut = 25; while (cut > 0 && p[cut] != ' ') cut--; if (cut == 0) cut = 25; }
      char ln[28];
      memcpy(ln, p, (size_t)cut);
      ln[cut] = 0;
      ptc(COL_TEXT, 4, y, ln);
      p += cut;
      while (*p == ' ') p++;
      y += 10;
    }
    ptc(got ? COL_GOAL : dimTx, 4, 111, got ? "Unlocked" : "Locked");
  }
  // Bottom line: description of the selected award (scrolls sideways when long) or a hint.
  canvas->fillRect(1, 120, 158, 7, COL_BG);
  const char* d = "Sel: next panel  B: back";
  uint16_t dc = dimTx;
  if (s_hubDesc) d = "Any button: close";
  else if (sel >= HUB_LIST0 + 1) { d = achDesc(sel - HUB_LIST0 - 1); dc = COL_TEXT; }
  else if (sel == HUB_LIST0) d = "A: open the trophy room";
  else if (sel == HUB_CHAL) d = miscGetFlag(MF_CHAL_CLASSIC) ? "Start: pool CLASSIC 7" : "Start: pool EXTENDED 12";
  int tw = (int)strlen(d) * 6, off = 0;
  if (tw > 152) {
    int over = tw - 152;
    unsigned long m = (now - s_hubDescT0) % (1200UL + (unsigned long)over * 30UL);
    if (m >= 600) off = (int)((m - 600) / 30);
    if (off > over) off = over;
  }
  ptc(dc, 4 - off, 120, d);
  canvas->fillRect(0, 120, 3, 7, COL_BG);     // clip the marquee to the panel
  canvas->fillRect(157, 120, 3, 7, COL_BG);

  canvas->drawRoundRect(0, 9, 160, 28, 3, hubBorder(0, COL_ORANGE));
  canvas->drawRoundRect(0, 37, 160, 30, 3, hubBorder(1, COL_ICE));
  canvas->drawRoundRect(0, 68, 160, 60, 3, hubBorder(2, COL_KEY));
  blitScreen();
}

// Keeps the selected list row inside the 4-row window.
static void hubSyncFocus() {
  if (s_hubSel < HUB_LIST0) return;
  int li = s_hubSel - HUB_LIST0;
  s_hubListSel = (uint8_t)li;   // remembered for Select to jump back to
  if (li < s_hubTop) s_hubTop = li;
