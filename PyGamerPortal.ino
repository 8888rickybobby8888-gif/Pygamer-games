static bool spritePixelLit(uint8_t kind, int tx, int ty) {
  switch (kind) {
    case SPR_CRATE: return bitmapLit(TEX_SPR_CRATE, tx, ty);
    case SPR_RING: return bitmapLit(TEX_SPR_RING, tx, ty);
    case SPR_DIAMOND: return bitmapLit(TEX_SPR_DIAMOND, tx, ty);
    case SPR_KEY: return bitmapLit(TEX_SPR_KEY, tx, ty);
    case SPR_BOLT: return bitmapLit(TEX_SPR_BOLT, tx, ty);
    case SPR_PLATE: return bitmapLit(TEX_SPR_PLATE, tx, ty);
    default: return bitmapLit(TEX_SPR_CHECK, tx, ty); // SPR_CHECK
  }
}

// A camera-facing colored square, depth-tested per column against the
// wall zbuffer so it's hidden behind nearer walls.
// floorFlush=false centers the sprite on the horizon (for upright objects
// like boxes/portals/goal/key -- the usual raycaster billboard). true
// pins its top edge AT the horizon so it extends downward into the floor
// instead, for flat ground-level markers (pits/ice/mud/boost/plates) --
// otherwise they'd render as a square floating at eye level instead of
// lying flat on the ground.

// icon=true: unlit texels are skipped (sprite floats transparently over
// whatever's behind it) -- used for portals/goal/key/lasers. icon=false:
// unlit texels draw a darker shade of the same color instead (a fully
// solid object) -- used for boxes and the floor-level hazard markers.
static void drawBillboard3D(float tileRow, float tileCol, uint16_t color,
                             uint8_t kind, float posX, float posY, float dirX,
                             float dirY, float planeX, float planeY,
                             float sizeScale, bool floorFlush, bool icon) {
  float spriteX = (tileCol + 0.5f) - posX;
  float spriteY = (tileRow + 0.5f) - posY;

  float invDet = 1.0f / (planeX * dirY - dirX * planeY);
  float transformX = invDet * (dirY * spriteX - dirX * spriteY);
  float transformY = invDet * (-planeY * spriteX + planeX * spriteY);
  if (transformY <= 0.1f) return; // behind the camera

  int spriteScreenX = (int)((VIEW3D_W / 2) * (1.0f + transformX / transformY));
  int size = (int)(fabsf(VIEW3D_H / transformY) * sizeScale);
  if (size < 1) return;

  int drawStartY = floorFlush ? (int)s_horizon : ((int)s_horizon - size / 2);
  int drawEndY = drawStartY + size;
  int drawStartX = spriteScreenX - size / 2;
  int drawEndX = spriteScreenX + size / 2;

  int clipTop = (drawStartY < 0) ? 0 : drawStartY;
  int clipBottom = (drawEndY > VIEW3D_H) ? VIEW3D_H : drawEndY;
  if (clipBottom <= clipTop) return;

  uint16_t darkColor = shadeColor(color, 0.55f);

  canvas->startWrite();
  for (int sx = drawStartX; sx < drawEndX; sx++) {
    if (sx < 0 || sx >= VIEW3D_W) continue;
    if (transformY >= s_zbuffer[sx]) continue; // hidden behind a wall
    int texX = (int)((sx - drawStartX) * TEX_SIZE / (float)size);
    if (texX < 0) texX = 0;
    if (texX >= TEX_SIZE) texX = TEX_SIZE - 1;
    for (int sy = clipTop; sy < clipBottom; sy++) {
      int texY = (int)((sy - drawStartY) * TEX_SIZE / (float)size);
      if (texY < 0) texY = 0;
      if (texY >= TEX_SIZE) texY = TEX_SIZE - 1;
      bool lit = spritePixelLit(kind, texX, texY);
      if (!lit && icon) continue;
      canvas->writePixel(sx, HUD_HEIGHT + sy, lit ? color : darkColor);
    }
  }
  canvas->endWrite();
}

// Crates are real axis-aligned boxes, not camera-facing billboards: each
// screen column ray-casts against the box's 2D bounding square (a slab
// test, same idea as castColumn's DDA but against one dynamic square
// instead of the tile grid) so whichever side actually faces the camera
// is what gets drawn, and it changes correctly as you walk around it.
// That also fixes the old billboard's occasional "missing corner" look
// near walls -- every column now gets its own real hit distance instead
// of the whole sprite sharing one center-point distance.
//
// EYE_HEIGHT is where this raycaster's camera sits, in the same
// wall-height-is-1-unit scale used everywhere else here (lineHeight =
// VIEW3D_H / perpDist assumes a full wall spans 0..1 and the horizon row
// is exactly the midpoint, i.e. eye height 0.5). BOX_HEIGHT_FRAC has to
// stay below that: a box taller than eye height has its top edge behind
// (above) the camera's sightline, so it can never show a top surface no
// matter the angle -- straight down a 1-wide corridor it then reads as
// nothing but a flat front rectangle, indistinguishable from the old
// billboard even though the underlying geometry changed. Below eye
// height, the top is genuinely visible and gets ray-cast as a real
// surface below, which is what actually reads as "a block" even head-on.
#define EYE_HEIGHT 0.5f
#define BOX_HEIGHT_FRAC 0.3f

// Shared by crates and laser barriers: ray-casts a screen column against
// an arbitrary axis-aligned box footprint (a slab test, same idea as
// castColumn's DDA but against one dynamic box instead of the tile grid)
// so whichever side actually faces the camera is what gets drawn, and it
// changes correctly as you walk around it -- unlike a billboard, which
// always presents the same flat face regardless of viewing angle.
//
// EYE_HEIGHT is where this raycaster's camera sits, in the same
// wall-height-is-1-unit scale used everywhere else here (lineHeight =
// VIEW3D_H / perpDist assumes a full wall spans 0..1 and the horizon row
// is exactly the midpoint, i.e. eye height 0.5). heightFrac has to stay
// below that: a box taller than eye height has its top edge behind
// (above) the camera's sightline, so it can never show a top surface no
// matter the angle -- straight down a 1-wide corridor it then reads as
// nothing but a flat front rectangle, indistinguishable from a billboard
// even though the underlying geometry changed. Below eye height, the top
// is genuinely visible and gets ray-cast as a real surface, which is
// what actually reads as "a block" even head-on.
static void drawSolidBox3D(float minX, float maxX, float minY, float maxY,
                            float heightFrac, uint16_t baseColor,
                            uint8_t frontFaceKind, uint8_t sideFaceKind,
                            bool outline, float posX, float posY, float dirX,
                            float dirY, float planeX, float planeY) {
  const float planeGap = EYE_HEIGHT - heightFrac; // > 0: top is below eye level

  // Tracks the leftmost/rightmost columns actually drawn, so a dark
  // vertical edge line can be added down each side afterward -- a
  // sprite has no edges to speak of, so a crisp silhouette outline is
  // another cheap, unmissable "this is a solid object" cue on top of the
  // real per-column geometry below.
  int edgeX[2] = {-1, -1};
  int edgeTop[2] = {0, 0}, edgeBottom[2] = {0, 0};

  // The player's collision half-width and the box's aren't quite the same
  // (PLAYER_HALF vs BOX_HALF), so a push or a mid-teleport overlap can
  // leave the camera a hair inside a box's footprint. tNear/tFar's usual
  // meaning (both positive, tNear < tFar) assumes the ray starts outside
  // the box; from inside, tNear goes negative (the "entry" plane is
  // actually behind the camera) while tFar still correctly gives the
  // exit point. Using tNear unmodified there would aim the hit point
  // backwards and, since perpDist gets clamped positive anyway, draw
  // whatever the wrong face/texture math happens to produce -- which is
  // how the box was going invisible rather than just looking odd.
  bool insideBox = (posX > minX && posX < maxX && posY > minY && posY < maxY);

  canvas->startWrite();
  for (int x = 0; x < VIEW3D_W; x++) {
    float cameraX = 2.0f * x / (float)VIEW3D_W - 1.0f;
    float rayDirX = dirX + planeX * cameraX;
    float rayDirY = dirY + planeY * cameraX;

    float invDirX = (fabsf(rayDirX) > 1e-6f) ? (1.0f / rayDirX) : 1e30f;
    float invDirY = (fabsf(rayDirY) > 1e-6f) ? (1.0f / rayDirY) : 1e30f;
    float tx1 = (minX - posX) * invDirX, tx2 = (maxX - posX) * invDirX;
    float ty1 = (minY - posY) * invDirY, ty2 = (maxY - posY) * invDirY;
    float tMinX = fminf(tx1, tx2), tMaxX = fmaxf(tx1, tx2);
    float tMinY = fminf(ty1, ty2), tMaxY = fmaxf(ty1, ty2);
    float tNear = fmaxf(tMinX, tMinY);
    float tFar = fminf(tMaxX, tMaxY);
    if (!insideBox && (tNear > tFar || tFar < 0.05f)) continue; // ray misses the box
    if (insideBox && tFar < 0.05f) continue; // degenerate: right on an edge

    bool hitXFace;
    float hitT;
    if (insideBox) {
      // Looking at the inside surface from within: use the exit plane
      // (whichever bound is reached first leaving the box) instead of an
      // entry plane that's actually behind the camera.
      hitXFace = tMaxX < tMaxY;
      hitT = tFar;
    } else {
      hitXFace = tMinX > tMinY; // which slab produced tNear
      hitT = tNear;
    }
    float perpDist = (hitT > 0.05f) ? hitT : 0.05f;
    if (perpDist >= s_zbuffer[x]) continue; // a wall is nearer

    float hitX = posX + hitT * rayDirX, hitY = posY + hitT * rayDirY;
    float u = hitXFace ? (hitY - minY) / (maxY - minY)
                        : (hitX - minX) / (maxX - minX);
    if (u < 0) u = 0;
    if (u > 0.999f) u = 0.999f;

    float lineHeightFull = VIEW3D_H / perpDist;
    float bottomYf = s_horizon + lineHeightFull / 2.0f;
    float topYf = bottomYf - lineHeightFull * heightFrac;
    int clipTop = (topYf < 0) ? 0 : (int)topYf;
    int clipBottom = (bottomYf > VIEW3D_H) ? VIEW3D_H : (int)bottomYf;
    if (clipBottom <= clipTop) continue;

    float distShade = 1.0f - fminf(perpDist / 9.0f, 0.65f);
    float shade = distShade * (hitXFace ? 0.75f : 1.0f);
    uint16_t litColor = shadeColor(baseColor, shade);
    uint16_t darkColor = shadeColor(baseColor, shade * 0.55f);
    uint8_t faceKind = hitXFace ? sideFaceKind : frontFaceKind;

    int texX = (int)(u * TEX_SIZE);
    if (texX >= TEX_SIZE) texX = TEX_SIZE - 1;
    float texSpan = bottomYf - topYf;
    for (int y = clipTop; y < clipBottom; y++) {
      int texY = (int)((y - topYf) * TEX_SIZE / texSpan);
      if (texY < 0) texY = 0;
      if (texY >= TEX_SIZE) texY = TEX_SIZE - 1;
      bool lit = spritePixelLit(faceKind, texX, texY);
      canvas->writePixel(x, HUD_HEIGHT + y, lit ? litColor : darkColor);
    }

    // Top cap: ray-cast the box's flat top plane for the screen rows
    // between the horizon and the front/side face's top edge -- the same
    // floor-casting math as drawFloorCeiling, just for a plane below eye
    // height instead of the ground. Walking the ray outward from the
    // face's top edge toward the horizon, it naturally leaves the box's
    // footprint once it clears the far edge, which is what ends the loop.
    // Lightened (not just distance-shaded) so it reads as a bright top
    // surface catching light, not just a slightly different gray.
    uint16_t topColor = shadeColor(lightenColor(baseColor, 0.5f), distShade);
    int topmostY = clipTop;
    for (int y = clipTop - 1; y > (int)s_horizon; y--) {
      float p = (float)y - s_horizon;
      float rowDistance = planeGap * VIEW3D_H / p; // VIEW3D_H/2 is the fixed screen scale, see drawFloorCeiling
      if (rowDistance >= s_zbuffer[x]) break; // behind a wall
      float wx = posX + rowDistance * rayDirX;
      float wy = posY + rowDistance * rayDirY;
      if (wx < minX || wx > maxX || wy < minY || wy > maxY) break; // past the far edge
      canvas->writePixel(x, HUD_HEIGHT + y, topColor);
      topmostY = y;
    }

    if (edgeX[0] < 0) {
      edgeX[0] = edgeX[1] = x;
      edgeTop[0] = edgeTop[1] = topmostY;
      edgeBottom[0] = edgeBottom[1] = clipBottom;
    } else {
      edgeX[1] = x;
      edgeTop[1] = topmostY;
      edgeBottom[1] = clipBottom;
    }
  }

  // Silhouette outline down the two outermost visible columns -- see the
  // comment above edgeX's declaration.
  if (outline) {
    uint16_t outlineColor = shadeColor(baseColor, 0.3f);
    for (int i = 0; i < 2; i++) {
      if (edgeX[i] < 0) continue;
      for (int y = edgeTop[i]; y < edgeBottom[i]; y++)
        canvas->writePixel(edgeX[i], HUD_HEIGHT + y, outlineColor);
    }
  }

  canvas->endWrite();
}

static void drawBoxCube3D(float bx, float by, float posX, float posY,
                           float dirX, float dirY, float planeX,
                           float planeY) {
  float half = (BOX_HALF / TILE_SIZE);
  drawSolidBox3D(bx - half, bx + half, by - half, by + half, BOX_HEIGHT_FRAC,
                 COL_BOX, SPR_CRATE, SPR_CHECK, true, posX, posY, dirX, dirY,
                 planeX, planeY);
}

// A thin vertical light column marking a pressure plate from a distance
// down a corridor -- unlike a full box, it has no top cap (it just
// shoots straight up past the visible ceiling), so it's ray-cast
// directly rather than through drawSolidBox3D: same per-column AABB slab
// test as everything else here, but the drawn span always runs from the
// screen top down to wherever the beam meets the floor at that column's
// distance. The s_zbuffer depth test is what keeps it from showing
// through walls -- a column whose wall is nearer than the beam's own hit
// distance just never gets touched.
static void drawBeacon3D(float col, float row, uint16_t color, float posX,
                          float posY, float dirX, float dirY, float planeX,
                          float planeY) {
  float cx = col + 0.5f, cy = row + 0.5f;
  const float half = 0.07f;
  float minX = cx - half, maxX = cx + half;
  float minY = cy - half, maxY = cy + half;
  uint16_t beamColor = lightenColor(color, 0.25f);

  canvas->startWrite();
  for (int x = 0; x < VIEW3D_W; x++) {
    float cameraX = 2.0f * x / (float)VIEW3D_W - 1.0f;
    float rayDirX = dirX + planeX * cameraX;
    float rayDirY = dirY + planeY * cameraX;

    float invDirX = (fabsf(rayDirX) > 1e-6f) ? (1.0f / rayDirX) : 1e30f;
    float invDirY = (fabsf(rayDirY) > 1e-6f) ? (1.0f / rayDirY) : 1e30f;
    float tx1 = (minX - posX) * invDirX, tx2 = (maxX - posX) * invDirX;
    float ty1 = (minY - posY) * invDirY, ty2 = (maxY - posY) * invDirY;
    float tMinX = fminf(tx1, tx2), tMaxX = fmaxf(tx1, tx2);
    float tMinY = fminf(ty1, ty2), tMaxY = fmaxf(ty1, ty2);
    float tNear = fmaxf(tMinX, tMinY);
    float tFar = fminf(tMaxX, tMaxY);
    if (tNear > tFar || tFar < 0.05f) continue; // ray misses the beam
    float perpDist = (tNear > 0.05f) ? tNear : 0.05f;
    if (perpDist >= s_zbuffer[x]) continue; // a wall is nearer -- hidden

    float lineHeightFull = VIEW3D_H / perpDist;
    float bottomYf = s_horizon + lineHeightFull / 2.0f; // meets the floor like a wall's base
    int clipBottom = (bottomYf > VIEW3D_H) ? VIEW3D_H : (int)bottomYf;
    if (clipBottom <= 0) continue;

    float distShade = 1.0f - fminf(perpDist / 9.0f, 0.6f);
    uint16_t lit = shadeColor(beamColor, fminf(distShade * 1.3f, 1.0f));
    for (int y = 0; y < clipBottom; y++)
      canvas->writePixel(x, HUD_HEIGHT + y, lit);
  }
  canvas->endWrite();
}

// Laser beams block movement (walking into one kills you) but the
// portal-aiming ray passes straight through them -- see isBeamBlocker --
// so they read as "can't walk through, can still shoot a portal past
// it," a real barrier rather than a decorative floating icon. Rendered
// as a thin, floor-touching rail spanning the full width of whichever
// cells the beam actually crosses (retraced here the same way
// computeLitCells does it, since that only keeps a flat cell list and
// not each beam's direction) rather than a small centered sprite per
// cell, so it reads as one continuous barrier instead of a string of
// separate floating dots.
#define LASER_HEIGHT_FRAC 0.16f
#define LASER_HALF_WIDTH 0.1f

static void drawLaserBeams3D(float posX, float posY, float dirX, float dirY,
                              float planeX, float planeY) {
  for (int e = 0; e < numEmitters; e++) {
    int r = emitters[e].row, c = emitters[e].col;
    int dx = emitters[e].dx, dy = emitters[e].dy;
    for (;;) {
      r += dy;
      c += dx;
      if (r < 0 || r >= curH || c < 0 || c >= curW) break;
      uint8_t t = grid[r][c];
      if (isBeamBlocker(t) || boxAt(r, c) >= 0) break;

      float minX, maxX, minY, maxY;
      if (dx != 0) { // horizontal beam: full cell along X, thin band in Y
        minX = c;
        maxX = c + 1;
        minY = r + 0.5f - LASER_HALF_WIDTH;
        maxY = r + 0.5f + LASER_HALF_WIDTH;
      } else { // vertical beam: full cell along Y, thin band in X
        minY = r;
        maxY = r + 1;
        minX = c + 0.5f - LASER_HALF_WIDTH;
        maxX = c + 0.5f + LASER_HALF_WIDTH;
      }
      drawSolidBox3D(minX, maxX, minY, maxY, LASER_HEIGHT_FRAC, COL_LASER,
                     SPR_BOLT, SPR_BOLT, false, posX, posY, dirX, dirY,
                     planeX, planeY);
    }
  }
}

// Third-person marker: this raycaster only ever has one eye point per
// frame, so "3rd person" is really the camera pulled back a bit behind
// the player along their facing direction (see draw3DScene) with a small
// sprite drawn where the player now visibly is in front of it. Projected
// with the same billboard transform as everything else so it sits at the
// correct screen position/size for wherever the camera actually ended up
// (it gets pulled in closer than usual when backed into a tight corner).
static void drawPlayerMarker3D(float playerPosX, float playerPosY,
                                float camPosX, float camPosY, float dirX,
                                float dirY, float planeX, float planeY) {
  float spriteX = playerPosX - camPosX;
  float spriteY = playerPosY - camPosY;
  float invDet = 1.0f / (planeX * dirY - dirX * planeY);
  float transformX = invDet * (dirY * spriteX - dirX * spriteY);
  float transformY = invDet * (-planeY * spriteX + planeX * spriteY);
  if (transformY <= 0.05f) return; // camera didn't actually pull back this frame

  int screenX = (int)((VIEW3D_W / 2) * (1.0f + transformX / transformY));
  int zx = (screenX < 0) ? 0 : (screenX >= VIEW3D_W ? VIEW3D_W - 1 : screenX);
  if (transformY >= s_zbuffer[zx]) return; // a wall is between camera and player

  int size = (int)(fabsf(VIEW3D_H / transformY) * 0.34f);
  if (size < 5) size = 5;
  if (size > 40) size = 40;
  int footY = (int)(s_horizon + (VIEW3D_H / transformY) / 2.0f);
  if (footY > VIEW3D_H) footY = VIEW3D_H;

  uint16_t body = COL_PLAYER;
  uint16_t cloak = shadeColor(body, 0.7f);
  canvas->fillTriangle(screenX - size / 2, HUD_HEIGHT + footY, screenX + size / 2,
                        HUD_HEIGHT + footY, screenX, HUD_HEIGHT + footY - size, cloak);
  canvas->fillCircle(screenX, HUD_HEIGHT + footY - size, size / 3, body);
}

// Floor/ceiling casting: for each row below (and mirrored, above) the
// horizon, walks the world-space line that row corresponds to and samples
// a checkerboard so the ground actually looks like a floor receding into
// the distance rather than a flat color. Must run BEFORE the wall pass --
// castColumn() overwrites its column's portion of these pixels for
// whatever height the nearest wall actually occupies, which is what
// keeps the floor from painting over/through walls without needing a
// separate depth check here.
static void drawFloorCeiling(float posX, float posY, float dirX, float dirY,
                              float planeX, float planeY) {
  float rayDirX0 = dirX - planeX, rayDirY0 = dirY - planeY;
  float rayDirX1 = dirX + planeX, rayDirY1 = dirY + planeY;
  // screenDist is the fixed projection-plane distance (always half the
  // view height, same as everything else here); horizon is just which
  // pixel row currently stands for "straight ahead" -- keeping those two
  // separate is what makes s_horizon a pure pitch shift instead of also
  // warping the floor's perspective scale.
  const float screenDist = VIEW3D_H / 2.0f;
  int horizon = (int)s_horizon;
  int maxP = (horizon > VIEW3D_H - horizon) ? horizon : (VIEW3D_H - horizon);

  // Pits are sampled directly off the real tile grid at each pixel's
  // actual world position, rather than as a separate billboard object --
  // that's what keeps their silhouette correctly perspective-matched to
  // the floor at any viewing angle instead of a flat sprite that just
  // faces the camera. prevPit tracks, per column, whether the previous
  // (farther) row landed in a pit tile so a dark rim line can be drawn
  // right at the edge -- a cheap but real depth cue for the drop-off,
  // without needing true stepped 3D wall geometry for it.
  static bool prevPit[VIEW3D_W];
  for (int x = 0; x < VIEW3D_W; x++) prevPit[x] = false;
  uint16_t pitRim = shadeColor(COL_PIT, 0.2f);
  const uint8_t thm = qCurTheme();
  const uint16_t cFloor = themeTint(COL_FLOOR, thm), cCeil = themeTint(COL_CEILING, thm);

  canvas->startWrite();
  for (int p = 1; p <= maxP; p++) {
    float rowDistance = screenDist / (float)p;

    float stepX = rowDistance * (rayDirX1 - rayDirX0) / VIEW3D_W;
    float stepY = rowDistance * (rayDirY1 - rayDirY0) / VIEW3D_W;
    float worldX = posX + rowDistance * rayDirX0;
    float worldY = posY + rowDistance * rayDirY0;

    float shade = 1.0f - fminf(rowDistance / 9.0f, 0.65f);
    uint16_t floorLit = shadeColor(cFloor, shade);
    uint16_t floorDark = shadeColor(cFloor, shade * 0.6f);
    uint16_t ceilLit = shadeColor(cCeil, shade);
    uint16_t ceilDark = shadeColor(cCeil, shade * 0.6f);
    uint16_t pitLit = shadeColor(COL_PIT, shade);
    uint16_t pitDark = shadeColor(COL_PIT, shade * 0.45f);
    uint16_t iceLit = shadeColor(COL_ICE, shade);
    uint16_t iceDark = shadeColor(COL_ICE, shade * 0.75f);

    int floorY = horizon + p, ceilY = horizon - p;

    for (int x = 0; x < VIEW3D_W; x++) {
      float cellXf = floorf(worldX), cellYf = floorf(worldY);
      int cellX = (int)cellXf, cellY = (int)cellYf;
      int texX = (int)((worldX - cellXf) * TEX_SIZE) & (TEX_SIZE - 1);
      int texY = (int)((worldY - cellYf) * TEX_SIZE) & (TEX_SIZE - 1);
      worldX += stepX;
      worldY += stepY;

      bool checker = ((cellX & 1) ^ (cellY & 1)) == 0;
      bool panelLit = bitmapLit(TEX_CEIL_PANEL, texX, texY);
      uint8_t floorTile = (cellY >= 0 && cellY < curH && cellX >= 0 && cellX < curW)
                              ? grid[cellY][cellX]
                              : (uint8_t)T_WALL;
      bool isPit = floorTile == T_PIT;
      bool isIce = floorTile == T_ICE;

      if (floorY < VIEW3D_H && rowDistance < s_zbuffer[x]) {
        if (isPit != prevPit[x]) {
          canvas->writePixel(x, HUD_HEIGHT + floorY, pitRim);
        } else if (isPit) {
          canvas->writePixel(x, HUD_HEIGHT + floorY, checker ? pitDark : pitLit);
        } else if (isIce) {
          // Diagonal frost-crack lines (reusing the hazard-wall pattern)
          // instead of a plain checker, so it still reads as "ice" and
          // not just a re-tinted floor tile.
          bool crack = bitmapLit(TEX_WALL_HAZARD, texX, texY);
          canvas->writePixel(x, HUD_HEIGHT + floorY, crack ? iceDark : iceLit);
        } else {
          canvas->writePixel(x, HUD_HEIGHT + floorY, checker ? floorLit : floorDark);
        }
        prevPit[x] = isPit;
      }
      if (ceilY >= 0 && rowDistance < s_zbuffer[x])
        canvas->writePixel(x, HUD_HEIGHT + ceilY, panelLit ? ceilDark : ceilLit);
    }
  }
  canvas->endWrite();
}

static void draw3DScene() {
  float playerPosX = playerX / TILE_SIZE, playerPosY = playerY / TILE_SIZE;
  float dirX = cosf(playerAngle), dirY = sinf(playerAngle);
  float planeLen = tanf(FOV_RADIANS * 0.5f);
  float planeX = -dirY * planeLen, planeY = dirX * planeLen;

  // Third person: pull the camera back behind the player along their
  // facing direction. Walked in from the largest pullback so it never
  // ends up inside a wall or a box (or outside the level) -- it just
  // settles for whatever room it actually has when backed into a corner.
  // A camera that ends up INSIDE a box's small AABB breaks
  // drawSolidBox3D's slab test (the ray origin is then between a face's
  // near and far planes instead of outside both, so the "which face did
  // we hit" math picks the wrong one) -- avoiding the overlap here is
  // simpler and cheaper than making that renderer handle being inside
  // its own box.
  float posX = playerPosX, posY = playerPosY;
  if (thirdPerson) {
    static const float kPullbacks[] = {0.9f, 0.6f, 0.35f, 0.0f};
    for (int i = 0; i < 4; i++) {
      float cx = playerPosX - dirX * kPullbacks[i];
      float cy = playerPosY - dirY * kPullbacks[i];
      int tr = (int)cy, tc = (int)cx;
      bool blocked = (tr < 0 || tr >= curH || tc < 0 || tc >= curW)
                         ? true
                         : isWallForRender(grid[tr][tc]);
      if (!blocked)
        blocked = boxOverlapping(cx * TILE_SIZE, cy * TILE_SIZE, 2.0f) >= 0;
      if (!blocked) {
        posX = cx;
        posY = cy;
        break;
      }
    }
  }

  // 3rd person also tilts the view down a bit (in addition to pulling the
  // camera back above) so it actually looks down at the player from
  // slightly above/behind, rather than from exactly their own eye line.
  s_horizon = thirdPerson ? (VIEW3D_H / 2.0f - THIRD_PERSON_RAISE_PX)
                          : (VIEW3D_H / 2.0f);

  // Wall pass first so its per-column zbuffer distances exist for the
  // floor/ceiling and sprite passes to depth-test against.
  for (int x = 0; x < VIEW3D_W; x++)
    castColumn(x, posX, posY, dirX, dirY, planeX, planeY);

  drawFloorCeiling(posX, posY, dirX, dirY, planeX, planeY);

  // Laser beams are real geometry now -- see drawLaserBeams3D.
  drawLaserBeams3D(posX, posY, dirX, dirY, planeX, planeY);

  for (int i = 0; i < MAX_BOXES; i++) {
    if (boxes[i].active)
      drawBoxCube3D(boxes[i].x / TILE_SIZE, boxes[i].y / TILE_SIZE, posX, posY,
                    dirX, dirY, planeX, planeY);
  }

  // Floor-level tiles a raycaster can't show as walls, but which really
  // need to be visible. Pits and ice are handled inside drawFloorCeiling
  // itself now (sampled straight off the real grid) instead of as a
  // billboard here -- that's what makes them actually follow the floor's
  // real perspective instead of being a flat sprite that always faces
  // the camera.
  for (int r = 0; r < curH; r++) {
    for (int c = 0; c < curW; c++) {
      uint8_t t = grid[r][c];
      if (t == T_MUD) {
        drawBillboard3D(r, c, COL_MUD, SPR_CHECK, posX, posY, dirX, dirY,
                         planeX, planeY, 1.0f, true, false);
      } else if (t == T_BOOST) {
        drawBillboard3D(r, c, COL_BOOST, SPR_CHECK, posX, posY, dirX, dirY,
                         planeX, planeY, 1.0f, true, false);
      } else if (t == T_PLATE) {
        uint16_t plateColor = doorsOpen ? COL_PLATE_ON : COL_PLATE;
        drawBillboard3D(r, c, plateColor, SPR_PLATE, posX, posY, dirX, dirY,
                         planeX, planeY, 0.6f, true, false);
        drawBeacon3D(c, r, plateColor, posX, posY, dirX, dirY, planeX, planeY);
      } else if (isConveyor(t)) {
        drawBillboard3D(r, c, COL_CONVEYOR, SPR_CHECK, posX, posY, dirX, dirY,
                         planeX, planeY, 1.0f, true, false);
      }
    }
  }

  // Portals are flush-mounted on the wall they were fired at rather than
  // floating over the floor tile in front of it: nudged from the tile
  // center towards that wall by just under half a tile (PORTAL_WALL_NUDGE
  // stops just short of the wall's actual surface so the billboard's
  // distance reliably beats the wall's own z-buffer entry instead of
  // tying with it, which -- since drawBillboard3D hides on ">="  not
  // ">" -- would otherwise make it flicker in and out behind its own
  // wall depending on floating-point rounding).
  #define PORTAL_WALL_NUDGE 0.47f
  if (portalBlueRow >= 0)
    drawBillboard3D(portalBlueRow + portalBlueFaceDY * PORTAL_WALL_NUDGE,
                     portalBlueCol + portalBlueFaceDX * PORTAL_WALL_NUDGE,
                     COL_BLUE, SPR_RING, posX, posY, dirX, dirY, planeX,
                     planeY, 0.85f, false, true);
  if (portalOrangeRow >= 0)
    drawBillboard3D(portalOrangeRow + portalOrangeFaceDY * PORTAL_WALL_NUDGE,
                     portalOrangeCol + portalOrangeFaceDX * PORTAL_WALL_NUDGE,
                     COL_ORANGE, SPR_RING, posX, posY, dirX, dirY, planeX,
                     planeY, 0.85f, false, true);
  if (teleportARow >= 0)
    drawBillboard3D(teleportARow, teleportACol, COL_TELE_A, SPR_RING, posX,
                     posY, dirX, dirY, planeX, planeY, 0.85f, false, true);
  if (teleportBRow >= 0)
    drawBillboard3D(teleportBRow, teleportBCol, COL_TELE_B, SPR_RING, posX,
                     posY, dirX, dirY, planeX, planeY, 0.85f, false, true);
  if (keyRow >= 0 && grid[keyRow][keyCol] == T_KEY)
    drawBillboard3D(keyRow, keyCol, COL_KEY, SPR_KEY, posX, posY, dirX, dirY,
                     planeX, planeY, 0.5f, false, true);
  if (goalRow >= 0)
    drawBillboard3D(goalRow, goalCol, COL_GOAL, SPR_DIAMOND, posX, posY, dirX,
                     dirY, planeX, planeY, 0.95f, false, true);

  if (thirdPerson)
    drawPlayerMarker3D(playerPosX, playerPosY, posX, posY, dirX, dirY, planeX,
                        planeY);
}

static void drawHud() {
  canvas->fillRect(0, 0, VIEW_COLS * TILE_SIZE, HUD_HEIGHT, COL_BG);
  canvas->setCursor(2, 4);
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(1);
  canvas->print("LVL ");
  canvas->print(currentLevel + 1);
  int tier = levelTier(currentLevel);
  if (tier < 0) {
    canvas->print("/");
    canvas->print(NUM_HAND_LEVELS);
  } else {
    canvas->print(" T");
    canvas->print(tier);
  }
  canvas->print("  MOVES ");
  canvas->print(moveCount);

  pt(138, 4, (int)(smoothedFps + 0.5f));
}

static void drawWinOverlay() {
  int w = 130, h = lastLevelWasGenerated ? 52 : 40;
  int x = (VIEW_COLS * TILE_SIZE - w) / 2;
  int y = HUD_HEIGHT + (VIEW_ROWS * TILE_SIZE - h) / 2;

  canvas->fillRect(x, y, w, h, COL_GOAL);
  canvas->drawRect(x, y, w, h, COL_TEXT);
  canvas->setCursor(x + 6, y + 8);
  canvas->setTextColor(COL_BG);
  canvas->print("LEVEL DONE!");

  if (lastLevelWasGenerated) {
    pt(x + 6, y + 20, "Built in ");
    canvas->print(lastGenMicros / 1000.0f, 1);
    canvas->print("ms");
    canvas->setCursor(x + 6, y + 34);
  } else {
    canvas->setCursor(x + 6, y + 22);
  }
  canvas->print("Press any key");
}

static unsigned long s_lastFpsLogMs = 0;

static void drawAll() {
  updateDoorsState();

  unsigned long t0 = micros();
  draw3DScene();
  lastRenderUs = micros() - t0;

  // The HUD's fps readout is necessarily one frame behind (this frame's
  // timing isn't known until after it's drawn) -- harmless, it's just a
  // rolling indicator.
  drawHud();

  if (levelWon)
    drawWinOverlay();

  // Draw everything off-screen above, then push the whole frame to the
  // physical display in one burst -- this is what actually kills the
  // flicker, since the screen never shows a partially-redrawn frame.
  unsigned long t1 = micros();
  blitScreen();
  lastBlitUs = micros() - t1;

  unsigned long totalUs = lastRenderUs + lastBlitUs;
  float fps = (totalUs > 0) ? 1000000.0f / (float)totalUs : 0;
  smoothedFps += (fps - smoothedFps) * 0.15f;

  unsigned long now = millis();
  if (now - s_lastFpsLogMs > 1000) {
    s_lastFpsLogMs = now;
    Serial.print("Frame: render=");
    Serial.print(lastRenderUs);
    Serial.print("us blit=");
    Serial.print(lastBlitUs);
    Serial.print("us (~");
    Serial.print(smoothedFps, 1);
    Serial.println(" fps)");
  }
}

// --- Splash screen ---------------------------------------------------------

// Animated intro: drifting stars, letters bouncing in with a rising chime,
// a sweeping scanline and a glow that pulses under the title. Any button
// skips to the picker (see loop()); otherwise it parks on the last frame.
static unsigned long s_splashStart = 0;
static int s_splashNote = 0;
static bool s_splashShim = false;
static const uint16_t kSplashNotes[8] = {392, 440, 494, 523, 587, 659, 784, 1047};

static void drawSplashFrame() {
  uint32_t t = millis() - s_splashStart;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);

  // Drifting stars (position derived from index + time: no state).
  uint32_t ts = t % 200000u;
  for (int i = 0; i < 16; i++) {
    int speed = 6 + (i % 4) * 5;
    int x = ((i * 53) % 160 + 160 - (int)(((ts * speed) / 100) % 160)) % 160;
    int y = (i * 29 + 7) % 126;
    uint8_t tw = (uint8_t)(70 + (i % 4) * 36); // steady per-star depth, no twinkle
    canvas->drawPixel(x, y, animBlend(COL_BG, COL_TEXT, tw));
    if (i % 5 == 0) canvas->drawPixel(x + 1, y, animBlend(COL_BG, COL_ICE, tw / 2));
  }
  // Scanline sweeping down.
  int sy = (int)((ts / 14) % 150) - 10;
  if (sy >= 0 && sy < 128) {
    canvas->drawFastHLine(0, sy, 160, animBlend(COL_BG, COL_ICE, 36));
    if (sy + 1 < 128) canvas->drawFastHLine(0, sy + 1, 160, animBlend(COL_BG, COL_ICE, 22));
  }

  if (t > 100) {
    uint32_t a = (t - 100) * 255u / 400u;
    if (a > 255) a = 255;
    ptc(animBlend(COL_BG, COL_TEXT, (uint8_t)a), 50, 38, "WELCOME TO");
  }

  // Glow under the title once the letters have landed.
  if (t > 1300) {
    uint8_t g = animPulse(900);
    uint32_t gk = (t - 1300) / 1200u;
    uint16_t gcol = animBlend(s_catCols[gk % 6], s_catCols[(gk + 1) % 6], (uint8_t)(((t - 1300) % 1200u) * 255u / 1200u));
    uint16_t gc = animBlend(COL_BG, gcol, (uint8_t)(60 + (g * 150u) / 255u));
    canvas->fillRect(34, 74, 92, 2, gc);
    canvas->fillRect(46, 77, 68, 1, animBlend(COL_BG, gcol, (uint8_t)(g / 3)));
    if (!s_splashShim) {   // one-off shimmer as the title lands
      s_splashShim = true;
      particlesBurst(56, 76, 8, 0);
      particlesBurst(80, 76, 8, 0);
      particlesBurst(104, 76, 8, 0);
    }
  }

  canvas->setTextSize(2);
  for (int i = 0; i < 7; i++) {
    int32_t ti = 250 + i * 110;
    if ((int32_t)t < ti) continue;
    float f = (float)((int32_t)t - ti) / 500.0f;
    int y = -18 + (int)(72.0f * animBounce(f));
    uint16_t col = s_catCols[i % 6];   // category accent colours
    if (t > 1300) {
      int hi = (int)(((t - 1300) / 70) % 14); // highlight sweeps across, then rests
      if (hi == i) col = 0xFFFF;
      else if (hi == i + 1 || hi == i - 1) col = animBlend(col, 0xFFFF, 110);
    }
    ptc(col, 38 + i * 12, y, "ARCADIA"[i]);
  }
  canvas->setTextSize(1);

  if (t > 1700) drawPulsingText(40, 100, "press any button", COL_TEXT, 1000);
  particlesUpdateDraw();
  blitScreen();
}

// Fires the chime notes in sync with the letters landing.
static void splashSound() {
  uint32_t t = millis() - s_splashStart;
  while (s_splashNote < 8) {
    uint32_t due = (s_splashNote < 7) ? (uint32_t)(250 + s_splashNote * 110 + 230) : 1450u;
    if (t < due) break;
    if (!(g_save.miscFlags & 1)) sfx(kSplashNotes[s_splashNote], s_splashNote < 7 ? 70 : 220); // Settings -> Boot sound
    s_splashNote++;
  }
}

static void drawSplashScreen() {
  s_splashStart = millis();
  s_splashNote = 0;
  s_splashShim = false;
  drawSplashFrame();
}

// --- Game picker (boot screen) -------------------------------------------

static int pickerSelection = 0;
// Selects a difficulty/mode tier for whichever of the 19 arcade/puzzle
// games (Snake through Connect Four) is entered next -- 0 is each game's
// normal tuning. Set by the picker just before the matching enter*Title()
// call, then read once by that game's enter*Playing() to scale its speed/
// size/lives constants. Shared across games since only one is ever active
// at a time.
static int g_variant = 0;

// --- Two-player hot-seat mode globals -------------------------------
// The PyGamer has only one set of controls, so "2 player" means
// hot-seat: player 1 plays a full round, then player 2 plays an
// identical round (same RNG seed), then a results screen compares
// scores. Independent of g_variant (per-game difficulty).
static bool g_twoPlayerMode = false;
// Player-chosen round seed for single-player score-attack games (0 = random). Cycled with Down
// on a handful of title screens; reset to 0 whenever a game is launched from the picker.
static uint8_t g_userSeed = 0;
// Challenge mode (Challenges & Awards hub): N != 0 while a challenge round is the
