  if (gameState == ST_CH8_MENU) { ch8MenuTick(pressed); return; }
  if (gameState == ST_CH8_PLAYING) { ch8Frame(buttons); return; }
  // @@DISPATCH
  // --- Portal Quest ---
  if (gameState == ST_QUEST_TITLE) { questTitleTick(pressed); return; }
  if (gameState == ST_QUEST_OVER) { questOverTick(pressed); return; }
  if (gameState == ST_QUEST_PLAYING) { questFrame(buttons, pressed); return; }

  if (gameState == ST_MENU) {
    uint32_t navPressed = menuNavPressed(buttons);
    bool dirty = false;

    if (navPressed & ARCADA_BUTTONMASK_LEFT) { menuSelection -= 1; dirty = true; }
    if (navPressed & ARCADA_BUTTONMASK_RIGHT) { menuSelection += 1; dirty = true; }
    if (navPressed & ARCADA_BUTTONMASK_UP) { menuSelection -= 10; dirty = true; }
    if (navPressed & ARCADA_BUTTONMASK_DOWN) { menuSelection += 10; dirty = true; }
    if (menuSelection < 0) menuSelection = 0;
    if (menuSelection >= NUM_LEVELS) menuSelection = NUM_LEVELS - 1;

    if (pressed & ARCADA_BUTTONMASK_A) {
      enterPlaying(menuSelection);
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_TITLE;
      drawTitleScreen();
    } else if (pressed & (ARCADA_BUTTONMASK_START | ARCADA_BUTTONMASK_SELECT)) {
      menuSelection = rerollWithinTier(menuSelection);
      drawLevelMenu();
    } else if (dirty) {
      drawLevelMenu();
    }
    return;
  }

  // --- ST_PLAYING --------------------------------------------------------

  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f)
    dt = 0.05f; // clamp huge gaps (first frame, a slow draw, etc)
  s_lastFrameMs = now;

  if (pressed & ARCADA_BUTTONMASK_SELECT) { // Select: straight to the level menu
    s_startWasDown = false;
    menuSelection = currentLevel;
    gameState = ST_MENU;
    drawLevelMenu();
    return;
  }

  if (levelWon) {
    if (pressed & ARCADA_BUTTONMASK_START) {
      menuSelection = currentLevel;
      gameState = ST_MENU;
      drawLevelMenu();
      return;
    }
    if (pressed) {
      currentLevel = (currentLevel + 1) % NUM_LEVELS;
      loadLevel(currentLevel);
    }
  } else {
    // First-person controls: left/right turn the view, up/down walk
    // forward/backward along it.
    if (buttons & ARCADA_BUTTONMASK_LEFT) playerAngle -= TURN_SPEED * dt;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) playerAngle += TURN_SPEED * dt;
    if (playerAngle > 6.2831853f) playerAngle -= 6.2831853f;
    if (playerAngle < -6.2831853f) playerAngle += 6.2831853f;

    float ix = 0, iy = 0;
    if (buttons & ARCADA_BUTTONMASK_UP) {
      ix += cosf(playerAngle) * MOVE_SPEED;
      iy += sinf(playerAngle) * MOVE_SPEED;
    }
    if (buttons & ARCADA_BUTTONMASK_DOWN) {
      ix -= cosf(playerAngle) * MOVE_SPEED;
      iy -= sinf(playerAngle) * MOVE_SPEED;
    }

    updatePlayer(dt, ix, iy);

    // Aim/shoot direction always matches where you're actually looking,
    // even if you're not currently walking -- snapped to the nearest
    // cardinal direction since the world (and the portal-placement ray)
    // is tile-aligned.
    float c = cosf(playerAngle), s = sinf(playerAngle);
    if (fabsf(c) > fabsf(s)) {
      facingDX = (c > 0) ? 1 : -1;
      facingDY = 0;
    } else {
      facingDX = 0;
      facingDY = (s > 0) ? 1 : -1;
    }

    // Portal firing stays edge-triggered -- one shot per press, not a
    // continuous stream while held.
    if (pressed & ARCADA_BUTTONMASK_A)
      shootPortal(true);
    if (pressed & ARCADA_BUTTONMASK_B)
      shootPortal(false);
  }

  // START now carries three tiers instead of two, since the physical
  // Select button isn't usable and its "back to level menu" action
  // needed a new home: a quick tap resets the level (unchanged), a
  // medium hold toggles 3rd person (unchanged), and a long hold jumps
  // back to the level menu. Decided on release so a tap doesn't also
  // trigger a longer tier before the hold threshold is known.
  bool startDown = buttons & ARCADA_BUTTONMASK_START;
  if (startDown && !s_startWasDown) s_startHeldSinceMs = now;
  if (!startDown && s_startWasDown) {
    unsigned long heldFor = now - s_startHeldSinceMs;
    if (heldFor < 450) {
      loadLevel(currentLevel); // quick "reset this level"
    } else if (heldFor < 1500) {
      thirdPerson = !thirdPerson;
    } else {
      s_startWasDown = false;
      menuSelection = currentLevel;
      gameState = ST_MENU;
      drawLevelMenu();
      return;
    }
  }
  s_startWasDown = startDown;

  drawAll();
}
