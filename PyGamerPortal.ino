static void diceDrawFace(int x, int y, int face, uint16_t col) {
  static const uint16_t pat[7] = {0, 0x010, 0x101, 0x111, 0x145, 0x155, 0x1C7};
  canvas->fillRect(x, y, 22, 22, COL_TEXT);
  canvas->drawRect(x, y, 22, 22, col);
  uint16_t m = pat[face < 1 ? 1 : (face > 6 ? 6 : face)];
  for (int i = 0; i < 9; i++)
    if (m & (1 << i)) canvas->fillCircle(x + 5 + (i % 3) * 6, y + 5 + (i / 3) * 6, 2, COL_BG);
}

static void drawDiceScene() {
  unsigned long now = millis();
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  canvas->setTextSize(1);
  int f[4] = {diceP1, diceP2, diceC1, diceC2};
  int bob[4] = {0, 0, 0, 0};
  if (diceRolling) {
    // tumbling faces (changes ~14x/s) and a small bounce
    for (int k = 0; k < 4; k++) {
      uint32_t h = ((now / 70) * 2654435761u) ^ ((uint32_t)(k + 1) * 40503u);
      f[k] = 1 + (int)((h >> 13) % 6);
      bob[k] = (int)((now / 45 + k * 2) % 4) - 1;
    }
  }
  diceDrawFace(100, HUD_HEIGHT + 8 + bob[0], f[0], COL_GOAL);
  diceDrawFace(128, HUD_HEIGHT + 8 + bob[1], f[1], COL_GOAL);
  diceDrawFace(100, HUD_HEIGHT + 36 + bob[2], f[2], COL_LASER);
  diceDrawFace(128, HUD_HEIGHT + 36 + bob[3], f[3], COL_LASER);
  ptc(COL_GOAL, 4, HUD_HEIGHT + 16, "YOU");
  canvas->setCursor(4, HUD_HEIGHT + 26);
  if (diceRolling) canvas->print("= ?");
  else { canvas->print("= "); canvas->print(diceP1 + diceP2); }
  ptc(COL_LASER, 4, HUD_HEIGHT + 44, "CPU");
  canvas->setCursor(4, HUD_HEIGHT + 54);
  if (diceRolling) canvas->print("= ?");
  else { canvas->print("= "); canvas->print(diceC1 + diceC2); }
  ptc(COL_TEXT, 4, HUD_HEIGHT + 78, diceRolling ? "Rolling..." : (diceRolled ? "A: roll again" : "A: roll the dice"));
}

