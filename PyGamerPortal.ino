  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_ORANGE);
  if (s_platCustomWon) {
    pt(22, 20, "LEVEL CLEAR!");
  } else {
    pt(30, 20, "GAME OVER");
  }
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(2);
  char buf[12];
  snprintf(buf, sizeof(buf), "%d", platScore);
  int textW = strlen(buf) * 12;
  pt((VIEW_COLS * TILE_SIZE - textW) / 2, 50, buf);
  canvas->setTextSize(1);
  pt(4, 78, "score -- best: ");
  canvas->print(platBestScore);
  canvas->setCursor(4, 108);
  animPrompt("A/Start: retry  B: back");
  drawBestLineOver(20, 92);
  blitScreen();
}

// --- Space Invaders Mini ------------------------------------------------
//
// A small alien grid marches side to side and creeps down; blast them
// before they reach you. Clearing a wave spawns a faster one -- endless.

#define INV_COLS 5
#define INV_ROWS 3
// Portrait (128x160): 5 columns of 18px, rows of 12px, 128x144 field under the HUD.
#define INV_CELL_W 18
#define INV_CELL_H 12
#define INV_PW 128
#define INV_PH 144
static bool invAlive[INV_ROWS][INV_COLS];
static float invGridX, invGridY, invGridSpeed;
static int invGridDir;
static float invBulletX, invBulletY;
static bool invBulletActive;
static float invShipX;
static int invScore, invBestScore, invWave, invAliveCount;

static void invNewWave() {
  invAliveCount = 0;
  for (int r = 0; r < INV_ROWS; r++) {
    for (int c = 0; c < INV_COLS; c++) {
      invAlive[r][c] = true;
      invAliveCount++;
    }
  }
  invGridX = 10;
  invGridY = 0;
  invGridDir = 1;
  invGridSpeed += 6.0f;
  invBulletActive = false;
  invWave++;
}

// Level editor hook: tile ids are 0=Empty, 1=Enemy, grid is INV_COLS x
// INV_ROWS -- exactly invAlive[][]'s own dimensions. A custom level
// replaces the first wave's formation only; clearing it falls through to
// invNewWave()'s normal (faster, fully-populated) endless progression.
static void invLoadCustom(const LevelData *lvl) {
  invAliveCount = 0;
  for (int r = 0; r < INV_ROWS; r++) {
    for (int c = 0; c < INV_COLS; c++) {
      bool alive = (r < lvl->h && c < lvl->w) ? (lvl->cells[r][c] == 1) : false;
      invAlive[r][c] = alive;
      if (alive) invAliveCount++;
    }
  }
  if (invAliveCount == 0) { // validate() should prevent this, stay safe anyway
    invAlive[0][0] = true;
    invAliveCount = 1;
  }
  invGridX = 10;
  invGridY = 0;
  invGridDir = 1;
  invBulletActive = false;
  invWave = 1;
}

static bool invValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int n = 0;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++)
      if (lvl->cells[r][c] == 1) n++;
  if (n < 1) { snprintf(msg, msgLen, "Need at least 1 enemy"); return false; }
  return true;
}

static void enterInvTitle() {
  gameState = ST_INV_TITLE;
