// Per-cell crossfade when a light flips (detected while drawing).
static bool lightsPrevOn[LIGHTS_GRID][LIGHTS_GRID];
static unsigned long lightsFlipT[LIGHTS_GRID][LIGHTS_GRID];
static bool lightsPrevInit = false;
#define LIGHTS_FLIP_MS 150

static void enterLightsPlaying() {
  s_mazeRng = gameSeed();
  lightsCursorX = LIGHTS_GRID / 2;
  lightsCursorY = LIGHTS_GRID / 2;
  lightsMoves = 0;
  lightsRound = 0;
  lightsPrevInit = false;
  memset(lightsFlipT, 0, sizeof(lightsFlipT));
  switch (g_variant) {
    case 1: lightsStartToggles = 4; break;  // Easy
    case 2: lightsStartToggles = 10; break; // Hard
    case 3: lightsStartToggles = 16; break; // Extreme
    default: lightsStartToggles = 6; break;
  }
  lightsScramble();
  lightsCustom = false;
  if (s_lvlActiveSlot[LVLGAME_LIGHTS] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_LIGHTS, s_lvlActiveSlot[LVLGAME_LIGHTS], &lvl)) lightsLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_LIGHTS] = -1;
  }
  gameState = ST_LIGHTS_PLAYING;
}

static void drawLightsScene() {
  unsigned long now = millis();
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  int gridPx = LIGHTS_CELL * LIGHTS_GRID;
  int x0 = (VIEW_COLS * TILE_SIZE - gridPx) / 2;
  for (int y = 0; y < LIGHTS_GRID; y++) {
    for (int x = 0; x < LIGHTS_GRID; x++) {
      int px = x0 + x * LIGHTS_CELL, py = HUD_HEIGHT + y * LIGHTS_CELL;
      if (!lightsPrevInit) lightsPrevOn[y][x] = lightsOn[y][x];
      if (lightsPrevOn[y][x] != lightsOn[y][x]) {
        lightsPrevOn[y][x] = lightsOn[y][x];
        lightsFlipT[y][x] = now;
      }
      uint16_t col = lightsOn[y][x] ? COL_PLATE_ON : COL_WALL_NOPORTAL;
      int inset = 1;
      if (lightsFlipT[y][x] != 0 && now - lightsFlipT[y][x] < LIGHTS_FLIP_MS) {
        float f = (float)(now - lightsFlipT[y][x]) / (float)LIGHTS_FLIP_MS;
        uint16_t from = lightsOn[y][x] ? COL_WALL_NOPORTAL : COL_PLATE_ON;
        col = animBlend(from, col, (uint8_t)(255.0f * f));
        // pop: the tile shrinks a touch mid-flip
        float tri = (f < 0.5f) ? f * 2.0f : (2.0f - f * 2.0f);
        inset = 1 + (int)(tri * 3.0f);
      }
      canvas->fillRect(px + inset, py + inset, LIGHTS_CELL - 2 * inset, LIGHTS_CELL - 2 * inset, col);
      if (x == lightsCursorX && y == lightsCursorY)
        canvas->drawRect(px, py, LIGHTS_CELL, LIGHTS_CELL, COL_TEXT);
    }
  }
  lightsPrevInit = true;
}

static void drawLightsHud() {
  canvas->fillRect(0, 0, VIEW_COLS * TILE_SIZE, HUD_HEIGHT, COL_BG);
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(1);
  pt(2, 1, "MOVES ");
  canvas->print(lightsMoves);
  pt(94, 1, "FEWEST ");
