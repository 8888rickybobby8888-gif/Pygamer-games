// --- Shared level validation helpers (used by the per-game validate fns) -----
static int lvlCountTile(const LevelData *lvl, uint8_t tile) {
  int n = 0;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++)
      if (lvl->cells[r][c] == tile) n++;
  return n;
}
// First cell (row-major) holding `tile`; returns false if none.
static bool lvlFindTile(const LevelData *lvl, uint8_t tile, int *outX, int *outY) {
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++)
      if (lvl->cells[r][c] == tile) { *outX = c; *outY = r; return true; }
  return false;
}
// BFS (4-neighbour) from (sx,sy) over tiles whose bit is set in passMask
// (bit t = tile id t, ids < 32). Returns the number of cells reached, start
// included; 0 if the start itself is blocked. Optional `seen` (LVL_GRID_MAXW *
// LVL_GRID_MAXH bytes, stride LVL_GRID_MAXW) receives 1 for every reached cell.
static int lvlReachable(const LevelData *lvl, int sx, int sy, uint32_t passMask, uint8_t *seen) {
  uint8_t vis[LVL_GRID_MAXH * LVL_GRID_MAXW];
  uint16_t q[LVL_GRID_MAXH * LVL_GRID_MAXW];
  memset(vis, 0, sizeof(vis));
  if (sx < 0 || sy < 0 || sx >= lvl->w || sy >= lvl->h) return 0;
  uint8_t t0 = lvl->cells[sy][sx];
  if (t0 >= 32 || !(passMask & (1UL << t0))) return 0;
  int qh = 0, qt = 0, n = 0;
  q[qt++] = (uint16_t)(sy * LVL_GRID_MAXW + sx);
  vis[sy * LVL_GRID_MAXW + sx] = 1;
  while (qh < qt) {
    int v = q[qh++];
    int cx = v % LVL_GRID_MAXW, cy = v / LVL_GRID_MAXW;
    n++;
    static const int8_t ddx[4] = {1, -1, 0, 0};
    static const int8_t ddy[4] = {0, 0, 1, -1};
    for (int k = 0; k < 4; k++) {
      int nx = cx + ddx[k], ny = cy + ddy[k];
      if (nx < 0 || ny < 0 || nx >= lvl->w || ny >= lvl->h) continue;
      if (vis[ny * LVL_GRID_MAXW + nx]) continue;
      uint8_t t = lvl->cells[ny][nx];
      if (t >= 32 || !(passMask & (1UL << t))) continue;
      vis[ny * LVL_GRID_MAXW + nx] = 1;
      q[qt++] = (uint16_t)(ny * LVL_GRID_MAXW + nx);
    }
  }
  if (seen) memcpy(seen, vis, sizeof(vis));
  return n;
}
// SaveMisc accessors (kept below the LevelData typedef: the IDE hoists prototypes above the first function)
static bool miscGetFlag(int bit) { return (g_saveMisc.flags >> bit) & 1u; }
static void miscSetFlag(int bit, bool on) {
  if (on) g_saveMisc.flags |= (1UL << bit); else g_saveMisc.flags &= ~(1UL << bit);
}
static uint8_t miscGetField(int shift, int bits) { return (uint8_t)((g_saveMisc.flags >> shift) & ((1UL << bits) - 1UL)); }
static void miscSetField(int shift, int bits, uint8_t v) {
  uint32_t m = ((1UL << bits) - 1UL) << shift;
  g_saveMisc.flags = (g_saveMisc.flags & ~m) | (((uint32_t)v << shift) & m);
}
// Level-pack completion bits live in SaveMisc.reserved (188 B = 1504 bits): bit g*60+idx for pack level idx (< 60)
// of level-game g (< 25 games * 60 = 1500 bits). "Reset saves" wipes them (miscDefaults); "Reset achievements" keeps them.
#define PK_MAX_LEVELS 60
static_assert(LVL_NUM_GAMES * PK_MAX_LEVELS <= (int)sizeof(((SaveMisc *)0)->reserved) * 8, "pack completion bits do not fit SaveMisc.reserved");
static bool pkDone(int g, int idx) {
  if (g < 0 || g >= LVL_NUM_GAMES || idx < 0 || idx >= PK_MAX_LEVELS) return false;
  int b = g * PK_MAX_LEVELS + idx;
  return (g_saveMisc.reserved[b >> 3] >> (b & 7)) & 1u;
}
static void pkSetDone(int g, int idx) {
  if (g < 0 || g >= LVL_NUM_GAMES || idx < 0 || idx >= PK_MAX_LEVELS) return;
  int b = g * PK_MAX_LEVELS + idx;
  g_saveMisc.reserved[b >> 3] |= (uint8_t)(1u << (b & 7));
}
static int pkDoneTotal() {   // pack levels cleared over every game (popcount of the bitmask)
  int n = 0;
  for (unsigned i = 0; i < sizeof(g_saveMisc.reserved); i++) n += __builtin_popcount(g_saveMisc.reserved[i]);
  return n;
}
static void miscDefaults() { memset(&g_saveMisc, 0, sizeof(g_saveMisc)); g_saveMisc.magic = SAVE_MISC_MAGIC; g_saveMisc.version = SAVE_MISC_VERSION; }
// Challenge personal bests: newest result first, the 32 most recent challenges are kept.
static int miscChalFind(uint16_t key) {
  for (int i = 0; i < MISC_CHAL_N; i++) if (g_saveMisc.chalBest[i].key == key && key != 0) return i;
  return -1;
}
static bool miscChalGet(uint16_t num, bool classic, int32_t *out) {
  int i = miscChalFind((uint16_t)(num | (classic ? 0x8000u : 0u)));
  if (i < 0) return false;
  *out = g_saveMisc.chalBest[i].best;
  return true;
}
// Stores `v` if it beats the current best for that challenge. Returns true when written.
static bool miscChalSet(uint16_t num, bool classic, int32_t v, bool higherIsBetter) {
  uint16_t key = (uint16_t)(num | (classic ? 0x8000u : 0u));
  if (num == 0) return false;
  int i = miscChalFind(key);
  if (i >= 0) {
    int32_t cur = g_saveMisc.chalBest[i].best;
    if (higherIsBetter ? v <= cur : v >= cur) return false;
    g_saveMisc.chalBest[i].best = v;
    return true;
  }
  memmove(&g_saveMisc.chalBest[1], &g_saveMisc.chalBest[0], sizeof(ChalBest) * (MISC_CHAL_N - 1));   // evicts the oldest
  g_saveMisc.chalBest[0].key = key;
  g_saveMisc.chalBest[0].pad = 0;
  g_saveMisc.chalBest[0].best = v;
  return true;
}
static void saveExtDefaults() {
