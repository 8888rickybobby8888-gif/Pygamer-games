// =====================================================================================
// Retro (CHIP-8, game 63): runs /roms/*.ch8 with a CHIP-8 interpreter. 64x32 display drawn 2x,
// 16-key pad on D-pad/A/B/Start (per-ROM /roms/<name>.key or 4 presets), ~700 instr/s adjustable,
// 60 Hz timers, buzzer via tone, quirk toggles in the Select menu. The 4 KB machine is a heap
// block that only exists while a ROM runs (nothing static beyond the small ROM name list).
// Docs: tools/README_CHIP8.txt.  Retro has no high score.
// =====================================================================================
#define ROM_DIR "/roms"
#define ROM_MAX 16
#define ROM_NAME 20
static char s_romNames[ROM_MAX][ROM_NAME];
static int s_romSel = 0;
static uint16_t s_c8Ips = 700;        // instructions per second (kept for the session)
static uint8_t s_c8Flags = 0x0B;      // bit0 shift uses VY, bit1 load/store bump I, bit2 jump uses VX, bit3 AND/OR/XOR clear VF
static uint8_t s_c8Preset = 0;
static int s_c8Menu = 0;
static const uint8_t kC8Font[80] = {
  0xF0, 0x90, 0x90, 0x90, 0xF0, 0x20, 0x60, 0x20, 0x20, 0x70, 0xF0, 0x10, 0xF0, 0x80, 0xF0, 0xF0, 0x10, 0xF0, 0x10, 0xF0,
  0x90, 0x90, 0xF0, 0x10, 0x10, 0xF0, 0x80, 0xF0, 0x10, 0xF0, 0xF0, 0x80, 0xF0, 0x90, 0xF0, 0xF0, 0x10, 0x20, 0x40, 0x40,
  0xF0, 0x90, 0xF0, 0x90, 0xF0, 0xF0, 0x90, 0xF0, 0x10, 0xF0, 0xF0, 0x90, 0xF0, 0x90, 0x90, 0xE0, 0x90, 0xE0, 0x90, 0xE0,
  0xF0, 0x80, 0x80, 0x80, 0xF0, 0xE0, 0x90, 0x90, 0x90, 0xE0, 0xF0, 0x80, 0xF0, 0x80, 0xF0, 0xF0, 0x80, 0xF0, 0x80, 0x80};
// key map presets: Left, Right, Up, Down, A, B, Start -> CHIP-8 key 0..F
static const uint8_t kC8Keys[4][7] = {
  {4, 6, 2, 8, 5, 0, 0xA}, {0xC, 0xD, 1, 4, 5, 0, 0xA}, {4, 6, 2, 8, 5, 5, 0}, {5, 6, 4, 7, 4, 7, 0}};
static const char* const kC8PresetNames[5] = {"STD 4/6/2/8", "PONG 1/4 C/D", "SHOOT 4/6/5", "BLOCK 5/6/4", "FILE .key"};

struct Ch8 {
  uint8_t mem[4096];
  uint8_t disp[256];     // 64x32 bits, row-major, MSB first
  uint16_t stk[16];
  uint8_t v[16], km[7];
  uint16_t i, pc, keys, prevKeys;
  uint8_t sp, dt, st, dirty, waitReg, flags;
  uint32_t lastUs, tAcc, iAcc;
  uint32_t rng;
  char name[ROM_NAME];
};
static Ch8* s_c8 = NULL;

static void ch8DrawMenu();
static void ch8Release() {
  if (s_c8) { extMemPut(s_c8); s_c8 = NULL; }
}
static void ch8Scan() {
  s_romN = 0;
  s_romDirOk = false;
  if (!bannerFsOk() || !arcada.exists(ROM_DIR)) return;
  File dir = arcada.open(ROM_DIR);
  if (!dir) return;
  s_romDirOk = true;
  for (int guard = 0; guard < 96 && s_romN < ROM_MAX; guard++) {
    File e = dir.openNextFile();
    if (!e) break;
    char nm[32];
    nm[0] = 0;
    e.getName(nm, sizeof(nm));
    size_t l = strlen(nm);
    bool ok = !e.isDirectory() && nm[0] && nm[0] != '.' && l >= 5 && l < ROM_NAME && strcasecmp(nm + l - 4, ".ch8") == 0 &&
              e.size() > 0 && e.size() <= 3584;
    e.close();
    if (!ok) continue;
    int j = s_romN++;
    while (j > 0 && strcasecmp(s_romNames[j - 1], nm) > 0) { memcpy(s_romNames[j], s_romNames[j - 1], ROM_NAME); j--; }
    memcpy(s_romNames[j], nm, ROM_NAME);
  }
  dir.close();
}
static void ch8DrawList() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_TELE_B, 4, 4, "RETRO CHIP-8");
  canvas->setTextColor(COL_TEXT);
  if (s_romN == 0) {
    pt(4, 24, s_romDirOk ? "No .ch8 ROMs in /roms" : "No /roms folder yet");
    pt(4, 40, "Settings > USB drive,");
    pt(4, 50, "copy *.ch8 into /roms");
    pt(4, 60, "(install_assets -Roms)");
    pt(4, 76, "tools/README_CHIP8.txt");
  } else {
    int top = s_romSel - 3;
    if (top > s_romN - 7) top = s_romN - 7;
    if (top < 0) top = 0;
    for (int r = 0; r < 7 && top + r < s_romN; r++) {
      int i = top + r;
      char nm[ROM_NAME];
      snprintf(nm, sizeof(nm), "%s", s_romNames[i]);
      nm[strlen(nm) - 4] = 0;
      if (i == s_romSel) { canvas->fillRect(2, 16 + r * 12 - 1, 156, 11, COL_WALL_NOPORTAL); canvas->setTextColor(COL_KEY); }
      else canvas->setTextColor(COL_TEXT);
      pt(6, 16 + r * 12, nm);
    }
  }
  ptc(COL_TEXT, 4, 108, s_romN ? "A: run  U/D: pick" : "");
  pt(4, 118, "B: back");
  blitScreen();
}
static void ch8EnterList() {
  ch8Release();
  ch8Scan();
  if (s_romSel >= s_romN) s_romSel = 0;
  gameState = ST_CH8_LIST;
  ch8DrawList();
}
static void ch8Fail(uint16_t code) {
  ch8Release();
  gameState = ST_CH8_ERR;
  errLog(code);
  errDraw(code, NULL);
  pt(4, 108, "A/B: back");
  sfxDeath();
  blitScreen();
}
static void ch8LoadKeys() {   // preset 4 = the ROM's .key file: up to 7 hex digits (L R U D A B Start)
  Ch8& c = *s_c8;
  if (s_c8Preset < 4) { memcpy(c.km, kC8Keys[s_c8Preset], 7); return; }
  memcpy(c.km, kC8Keys[0], 7);
  char path[48];
  snprintf(path, sizeof(path), ROM_DIR "/%s", c.name);
  size_t l = strlen(path);
  memcpy(path + l - 3, "key", 4);
  if (!arcada.exists(path)) return;
  File f = arcada.open(path, O_READ);
  if (!f) return;
  char b[40];
  int n = f.read((uint8_t*)b, sizeof(b));
  f.close();
  int k = 0;
  for (int i = 0; i < n && k < 7; i++) {
    int d = isdigit((unsigned char)b[i]) ? b[i] - '0' : (b[i] >= 'a' && b[i] <= 'f') ? b[i] - 'a' + 10 : (b[i] >= 'A' && b[i] <= 'F') ? b[i] - 'A' + 10 : -1;
    if (d >= 0) c.km[k++] = (uint8_t)d;
  }
}
static void ch8Reset() {
  Ch8& c = *s_c8;
  char path[48];
  snprintf(path, sizeof(path), ROM_DIR "/%s", c.name);
  File f = arcada.open(path, O_READ);
  if (!f) { ch8Fail(401); return; }
  uint32_t sz = (uint32_t)f.size();
  memset(c.mem, 0, sizeof(c.mem));
  memcpy(c.mem + 0x50, kC8Font, 80);
  bool ok = sz > 0 && sz <= 3584 && f.read(c.mem + 0x200, sz) == (int)sz;
  f.close();
  if (!ok) { ch8Fail(402); return; }
  memset(c.disp, 0, sizeof(c.disp));
  memset(c.v, 0, sizeof(c.v));
  c.i = 0; c.pc = 0x200; c.sp = 0; c.dt = 0; c.st = 0; c.keys = 0; c.prevKeys = 0; c.waitReg = 0xFF;
  c.dirty = 1; c.lastUs = micros(); c.tAcc = 0; c.iAcc = 0; c.rng = micros() | 1UL;
}
static void ch8Start() {
  ch8Release();
  if (s_romSel < 0 || s_romSel >= s_romN) { gameState = ST_GAME_PICKER; drawGamePicker(); return; }
  if (!extMemFits(sizeof(Ch8), 4096UL)) { ch8Fail(403); return; }
  s_c8 = (Ch8*)extMemGet(sizeof(Ch8));
  if (!s_c8) { ch8Fail(403); return; }
  memset(s_c8, 0, sizeof(Ch8));
  snprintf(s_c8->name, sizeof(s_c8->name), "%s", s_romNames[s_romSel]);
  ch8LoadKeys();
  ch8Reset();
  if (!s_c8) return;
  canvas->fillScreen(COL_BG);
  miscSetFlag(MF_ACH_CH8, true);
  checkAchievements();
  gameState = ST_CH8_PLAYING;
}
static void ch8Exec() {
  Ch8& c = *s_c8;
  uint16_t pc = c.pc & 0xFFF;
  uint16_t op = (uint16_t)((c.mem[pc] << 8) | c.mem[(pc + 1) & 0xFFF]);
  c.pc = (uint16_t)((pc + 2) & 0xFFF);
  uint8_t x = (op >> 8) & 15, y = (op >> 4) & 15, n = op & 15, nn = op & 255;
  uint16_t nnn = op & 0xFFF;
  uint8_t* v = c.v;
  switch (op >> 12) {
    case 0:
      if (op == 0x00E0) { memset(c.disp, 0, sizeof(c.disp)); c.dirty = 1; }
      else if (op == 0x00EE) { if (c.sp) c.pc = c.stk[--c.sp] & 0xFFF; }
      break;
    case 1: c.pc = nnn; break;
    case 2: if (c.sp < 16) { c.stk[c.sp++] = c.pc; c.pc = nnn; } break;
    case 3: if (v[x] == nn) c.pc = (c.pc + 2) & 0xFFF; break;
    case 4: if (v[x] != nn) c.pc = (c.pc + 2) & 0xFFF; break;
    case 5: if (n == 0 && v[x] == v[y]) c.pc = (c.pc + 2) & 0xFFF; break;
    case 6: v[x] = nn; break;
    case 7: v[x] = (uint8_t)(v[x] + nn); break;
    case 8: {
      uint8_t a = v[x], b = v[y], f = v[15], r = 0;
      bool setf = true;
      switch (n) {
        case 0: r = b; setf = false; break;
        case 1: r = a | b; if (c.flags & 8) f = 0; else setf = false; break;
        case 2: r = a & b; if (c.flags & 8) f = 0; else setf = false; break;
        case 3: r = a ^ b; if (c.flags & 8) f = 0; else setf = false; break;
        case 4: { uint16_t s = (uint16_t)(a + b); r = (uint8_t)s; f = s > 255; break; }
        case 5: r = (uint8_t)(a - b); f = a >= b; break;
        case 6: { uint8_t s = (c.flags & 1) ? b : a; r = s >> 1; f = s & 1; break; }
        case 7: r = (uint8_t)(b - a); f = b >= a; break;
        case 14: { uint8_t s = (c.flags & 1) ? b : a; r = (uint8_t)(s << 1); f = s >> 7; break; }
        default: return;
      }
      v[x] = r;
      if (setf) v[15] = f;
      break;
    }
    case 9: if (n == 0 && v[x] != v[y]) c.pc = (c.pc + 2) & 0xFFF; break;
    case 0xA: c.i = nnn; break;
    case 0xB: c.pc = (uint16_t)((nnn + v[(c.flags & 4) ? x : 0]) & 0xFFF); break;
    case 0xC: c.rng = c.rng * 1664525UL + 1013904223UL; v[x] = (uint8_t)((c.rng >> 16) & nn); break;
    case 0xD: {
      uint8_t px0 = v[x] & 63, py0 = v[y] & 31, hit = 0;
      for (int r = 0; r < n && py0 + r < 32; r++) {
        uint8_t bits = c.mem[(c.i + r) & 0xFFF];
        for (int b = 0; b < 8 && px0 + b < 64; b++) {
          if (!(bits & (0x80 >> b))) continue;
          uint8_t& d = c.disp[(py0 + r) * 8 + ((px0 + b) >> 3)];
          uint8_t m = (uint8_t)(0x80 >> ((px0 + b) & 7));
          if (d & m) hit = 1;
          d ^= m;
        }
      }
      v[15] = hit;
      c.dirty = 1;
      break;
    }
    case 0xE:
      if (nn == 0x9E) { if ((c.keys >> (v[x] & 15)) & 1) c.pc = (c.pc + 2) & 0xFFF; }
      else if (nn == 0xA1) { if (!((c.keys >> (v[x] & 15)) & 1)) c.pc = (c.pc + 2) & 0xFFF; }
      break;
    case 0xF:
      switch (nn) {
        case 0x07: v[x] = c.dt; break;
        case 0x0A: {
          uint16_t nw = c.keys & ~c.prevKeys;
          if (!nw) { c.pc = pc; break; }   // keep waiting
          for (int k = 0; k < 16; k++) if ((nw >> k) & 1) { v[x] = (uint8_t)k; break; }
          c.prevKeys = c.keys;   // consume the press: a second FX0A in the same frame must wait for a new one
          break;
        }
        case 0x15: c.dt = v[x]; break;
        case 0x18: c.st = v[x]; break;
        case 0x1E: c.i = (uint16_t)(c.i + v[x]); break;
        case 0x29: c.i = (uint16_t)(0x50 + (v[x] & 15) * 5); break;
        case 0x33: c.mem[c.i & 0xFFF] = v[x] / 100; c.mem[(c.i + 1) & 0xFFF] = (v[x] / 10) % 10; c.mem[(c.i + 2) & 0xFFF] = v[x] % 10; break;
        case 0x55: for (int k = 0; k <= x; k++) c.mem[(c.i + k) & 0xFFF] = v[k]; if (c.flags & 2) c.i = (uint16_t)(c.i + x + 1); break;
        case 0x65: for (int k = 0; k <= x; k++) v[k] = c.mem[(c.i + k) & 0xFFF]; if (c.flags & 2) c.i = (uint16_t)(c.i + x + 1); break;
        default: break;
      }
      break;
  }
}
static void ch8Draw() {
  Ch8& c = *s_c8;
  canvas->fillRect(15, 31, 130, 66, COL_WALL);
  canvas->fillRect(16, 32, 128, 64, COL_BG);
  for (int y = 0; y < 32; y++)
    for (int b = 0; b < 8; b++) {
      uint8_t d = c.disp[y * 8 + b];
      if (!d) continue;
      for (int k = 0; k < 8; k++)
        if (d & (0x80 >> k)) canvas->fillRect(16 + (b * 8 + k) * 2, 32 + y * 2, 2, 2, COL_GOAL);
    }
  c.dirty = 0;
}
static void ch8Frame(uint32_t buttons) {
  Ch8* cp = s_c8;
  if (!cp) { ch8Fail(404); return; }
  Ch8& c = *cp;
  if (s_rawPressed & ARCADA_BUTTONMASK_SELECT) {
    s_c8Menu = 0;
    gameState = ST_CH8_MENU;
    ch8DrawMenu();
    return;
  }
  c.prevKeys = c.keys;
  uint16_t k = 0;
  if (buttons & ARCADA_BUTTONMASK_LEFT) k |= 1u << c.km[0];
  if (buttons & ARCADA_BUTTONMASK_RIGHT) k |= 1u << c.km[1];
  if (buttons & ARCADA_BUTTONMASK_UP) k |= 1u << c.km[2];
  if (buttons & ARCADA_BUTTONMASK_DOWN) k |= 1u << c.km[3];
  if (buttons & ARCADA_BUTTONMASK_A) k |= 1u << c.km[4];
  if (buttons & ARCADA_BUTTONMASK_B) k |= 1u << c.km[5];
  if (buttons & ARCADA_BUTTONMASK_START) k |= 1u << c.km[6];
  c.keys = k;
  uint32_t nowUs = micros();
  uint32_t dtUs = nowUs - c.lastUs;
  c.lastUs = nowUs;
  if (dtUs > 100000UL) dtUs = 100000UL;
  c.tAcc += dtUs;
  bool tick = false;
  while (c.tAcc >= 16667UL) {
    tick = true;
    c.tAcc -= 16667UL;
    if (c.dt) c.dt--;
    if (c.st) c.st--;
  }
  c.iAcc += dtUs * (uint32_t)s_c8Ips;
  uint32_t n = c.iAcc / 1000000UL;
  c.iAcc -= n * 1000000UL;
  if (n > 400) n = 400;
  c.flags = s_c8Flags;
  for (uint32_t i = 0; i < n; i++) ch8Exec();
  if (c.st) sfx(440, 40);
  if (tick && c.dirty) { ch8Draw(); blitScreen(); }
}
static void ch8DrawMenu() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_TELE_B, 4, 3, "CHIP-8 MENU");
  char l[28];
  for (int i = 0; i < 9; i++) {
    switch (i) {
      case 0: snprintf(l, sizeof(l), "Resume"); break;
      case 1: snprintf(l, sizeof(l), "Speed: %d/s", (int)s_c8Ips); break;
      case 2: snprintf(l, sizeof(l), "Keys: %s", kC8PresetNames[s_c8Preset]); break;
      case 3: snprintf(l, sizeof(l), "Shift: %s", (s_c8Flags & 1) ? "VY (orig)" : "VX"); break;
      case 4: snprintf(l, sizeof(l), "Load/store: %s", (s_c8Flags & 2) ? "I+=X+1" : "I fixed"); break;
      case 5: snprintf(l, sizeof(l), "Jump B: %s", (s_c8Flags & 4) ? "VX" : "V0"); break;
      case 6: snprintf(l, sizeof(l), "AND/OR/XOR VF: %s", (s_c8Flags & 8) ? "reset" : "keep"); break;
      case 7: snprintf(l, sizeof(l), "Reset ROM"); break;
      default: snprintf(l, sizeof(l), "Exit to list"); break;
    }
    if (i == s_c8Menu) { canvas->fillRect(2, 13 + i * 11, 156, 10, COL_WALL_NOPORTAL); canvas->setTextColor(COL_KEY); }
    else canvas->setTextColor(COL_TEXT);
    pt(6, 14 + i * 11, l);
  }
  ptc(COL_TEXT, 4, 116, "L/R: change  A: ok  B: back");
  blitScreen();
}
static void ch8MenuTick(uint32_t pressed) {
  if (!s_c8) { ch8EnterList(); return; }
  bool redraw = false;
  int d = (pressed & ARCADA_BUTTONMASK_RIGHT) ? 1 : (pressed & ARCADA_BUTTONMASK_LEFT) ? -1 : 0;
  if (pressed & ARCADA_BUTTONMASK_UP) { s_c8Menu = (s_c8Menu + 8) % 9; redraw = true; sfxMove(); }
  else if (pressed & ARCADA_BUTTONMASK_DOWN) { s_c8Menu = (s_c8Menu + 1) % 9; redraw = true; sfxMove(); }
  if (d) {
    redraw = true;
    sfxMove();
    switch (s_c8Menu) {
      case 1: { int v = (int)s_c8Ips + d * 100; s_c8Ips = (uint16_t)(v < 100 ? 100 : (v > 2000 ? 2000 : v)); break; }
      case 2: s_c8Preset = (uint8_t)((s_c8Preset + 5 + d) % 5); ch8LoadKeys(); break;
      case 3: s_c8Flags ^= 1; break;
      case 4: s_c8Flags ^= 2; break;
      case 5: s_c8Flags ^= 4; break;
      case 6: s_c8Flags ^= 8; break;
      default: break;
    }
  }
  bool ok = pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START);
  if ((pressed & ARCADA_BUTTONMASK_B) || (ok && s_c8Menu == 0)) {
    s_c8->lastUs = micros();
    canvas->fillScreen(COL_BG);
    s_c8->dirty = 1;
    gameState = ST_CH8_PLAYING;
    return;
  }
  if (ok && s_c8Menu == 7) { ch8Reset(); if (s_c8) { canvas->fillScreen(COL_BG); gameState = ST_CH8_PLAYING; } return; }
  if (ok && s_c8Menu == 8) { ch8EnterList(); return; }
  if (redraw) ch8DrawMenu();
}
static void ch8ListTick(uint32_t pressed) {
  if (pressed & ARCADA_BUTTONMASK_B) { gameState = ST_GAME_PICKER; drawGamePicker(); return; }
  if (s_romN == 0) return;
  if (pressed & ARCADA_BUTTONMASK_DOWN) { s_romSel = (s_romSel + 1) % s_romN; sfxMove(); ch8DrawList(); }
  else if (pressed & ARCADA_BUTTONMASK_UP) { s_romSel = (s_romSel + s_romN - 1) % s_romN; sfxMove(); ch8DrawList(); }
  else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) { sfx(600, 40); ch8Start(); }
}

