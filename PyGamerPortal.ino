static const uint16_t TEX_SPR_PLATE[TEX_SIZE] = {0xffff, 0xffff, 0xf1c7, 0xce3b, 0xce3b, 0xce3b, 0xf1c7, 0xf1c7, 0xf1c7, 0xce3b, 0xce3b, 0xce3b, 0xf1c7, 0xf1c7, 0xffff, 0xffff};
