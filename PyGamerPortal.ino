  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  for (int i = 0; i < tiltHoleCount; i++) {
    canvas->fillCircle((int)tiltHoles[i].x, (int)tiltHoles[i].y, (int)tiltHoles[i].r, COL_PIT);
