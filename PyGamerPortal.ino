// Game-over screens drop in from the top and bounce to rest.
static float slideBounce(float t) {
  if (t <= 0.0f) return 0.0f;
  if (t >= 1.0f) return 1.0f;
  if (t < 0.36364f) return 7.5625f * t * t;
  if (t < 0.72727f) { t -= 0.54545f; return 7.5625f * t * t + 0.75f; }
  if (t < 0.90909f) { t -= 0.81818f; return 7.5625f * t * t + 0.9375f; }
  t -= 0.95455f;
  return 7.5625f * t * t + 0.984375f;
}

static void blitScreenCore() {
  GameState st = gameState;
  bool change = (st != s_lastBlitState);
  s_lastBlitState = st;
  if (!change || !s_fadeEnabled || st == ST_PAUSE || st == ST_SPLASH || st == ST_REACT_OVER) {
    s_fadeSkipOnce = false;
    presentFrame();
    return;
  }
  if (isOverState(st)) {
    uint16_t* spx = canvas->getBuffer();
    const int W = canvas->width(), H = canvas->height();
    if ((uint32_t)W * (uint32_t)H <= sizeof(s_fadeBuf) / sizeof(s_fadeBuf[0])) {
      memcpy(s_fadeBuf, spx, (size_t)W * H * sizeof(uint16_t));
      uint32_t t0 = millis();
      const uint32_t dur = 450;
      for (;;) {
        uint32_t el = millis() - t0;
        if (el >= dur) break;
        int off = (int)(H * slideBounce((float)el / (float)dur));
        for (int y = 0; y < H; y++) {
          int sy = y - off;
          if (sy < 0) memset(spx + (size_t)y * W, 0, (size_t)W * sizeof(uint16_t));
          else memcpy(spx + (size_t)y * W, s_fadeBuf + (size_t)sy * W, (size_t)W * sizeof(uint16_t));
        }
        presentFrame();
        if (arcada.readButtons() & ~s_prevButtons) break;
      }
      memcpy(spx, s_fadeBuf, (size_t)W * H * sizeof(uint16_t));
    }
    presentFrame();
    s_lastFadeEndMs = millis();
    if (s_lastFadeEndMs == 0) s_lastFadeEndMs = 1;
    if (st != ST_TWOP_RESULTS && st != ST_MIX_RESULTS && !s_jgOn &&
        (uint32_t)(millis() - s_sfxLastMs) > 900) jingleStart(JG_OVER);
    return;
  }
  if (s_fadeSkipOnce || (s_lastFadeEndMs != 0 && millis() - s_lastFadeEndMs < 300)) {
    s_fadeSkipOnce = false;
    presentFrame();
    return;
  }
  uint16_t* px = canvas->getBuffer();
  uint32_t n = (uint32_t)canvas->width() * (uint32_t)canvas->height();
  if (n > sizeof(s_fadeBuf) / sizeof(s_fadeBuf[0])) {
    presentFrame();
    return;
  }
  memcpy(s_fadeBuf, px, n * sizeof(uint16_t));
  for (int step = 1; step < FADE_STEPS; step++) {
    uint32_t a = (uint32_t)step * 32u / FADE_STEPS; // 0..31 of 32
    for (uint32_t i = 0; i < n; i++) {
      uint32_t p = s_fadeBuf[i];
      uint32_t x = (p | (p << 16)) & 0x07E0F81Fu;
      x = ((x * a) >> 5) & 0x07E0F81Fu;
      px[i] = (uint16_t)(x | (x >> 16));
    }
    presentFrame();
    // A fresh button press skips the rest of the fade (the press itself is
    // not consumed: loop() sees it as usual via s_prevButtons).
    if (arcada.readButtons() & ~s_prevButtons) break;
  }
  memcpy(px, s_fadeBuf, n * sizeof(uint16_t));
  presentFrame();
  s_lastFadeEndMs = millis();
  if (s_lastFadeEndMs == 0) s_lastFadeEndMs = 1;
}

// --- Horizontal slide between menu screens ------------------------------------
// Navigation picker <-> Settings <-> Challenges hub/Credits/High Scores (-> Trophies) slides instead of
// fading: forward (deeper) = old frame leaves to the left, back = it leaves to the right.
// Every blit of one of these (landscape) screens mirrors the finished frame into s_fadeBuf
// (s_slideHold remembers which screen it belongs to). On a screen change the live canvas
// (holding the NEW frame) is swapped with that copy, then the canvas is shifted in place
// and refilled from s_fadeBuf column by column, so only two 40 KB buffers are involved.
// s_fadeBuf is shared with the fade and the pause backdrop; every blit of any other screen
// invalidates the copy (s_slideHold = 0xFF), and the pause menu cannot be reached from here.
static uint8_t s_slideHold = 0xFF;

static int slideDepth(uint8_t st) {
  switch (st) {
    case ST_GAME_PICKER: return 0;
    case ST_SETTINGS: return 1;
    case ST_HUB: case ST_CREDITS: case ST_HISCORES: case ST_USBDRIVE: case ST_DIAG: case ST_ERRLOG: return 2;
    case ST_TROPHIES: return 3;   // opened from the hub
    default: return -1;
  }
}

static void blitSlide(int dir) {
  uint16_t* spx = canvas->getBuffer();
  const int W = canvas->width(), H = canvas->height();
  uint16_t tmp[160];
  for (int y = 0; y < H; y++) {   // canvas <- old frame, s_fadeBuf <- new frame
    uint16_t* a = spx + (size_t)y * W;
    uint16_t* b = s_fadeBuf + (size_t)y * W;
    memcpy(tmp, a, (size_t)W * sizeof(uint16_t));
    memcpy(a, b, (size_t)W * sizeof(uint16_t));
    memcpy(b, tmp, (size_t)W * sizeof(uint16_t));
  }
  const uint32_t dur = 180;
  uint32_t t0 = millis();
  int done = 0;
  for (;;) {
    uint32_t el = millis() - t0;
    if (el >= dur) break;
    int off = (int)((float)W * animEase((float)el / (float)dur) + 0.5f);
    if (off > W) off = W;
    int delta = off - done;
    if (delta > 0) {
      for (int y = 0; y < H; y++) {
        uint16_t* row = spx + (size_t)y * W;
        const uint16_t* nw = s_fadeBuf + (size_t)y * W;
        if (dir > 0) {
          memmove(row, row + delta, (size_t)(W - delta) * sizeof(uint16_t));
          memcpy(row + (W - delta), nw + done, (size_t)delta * sizeof(uint16_t));
        } else {
          memmove(row + delta, row, (size_t)(W - delta) * sizeof(uint16_t));
          memcpy(row, nw + (W - off), (size_t)delta * sizeof(uint16_t));
        }
      }
      done = off;
    }
    presentFrame();
    if (arcada.readButtons() & ~s_prevButtons) break;   // a fresh press skips the rest
  }
  memcpy(spx, s_fadeBuf, (size_t)W * H * sizeof(uint16_t));
  presentFrame();
  s_lastFadeEndMs = millis();
  if (s_lastFadeEndMs == 0) s_lastFadeEndMs = 1;
}

// --- Screen shake (shared) ----------------------------------------------------
// screenShake(ms, amp) jolts the canvas for `ms` (amp <= 4 px, decays linearly). The jolt is
// applied only while presenting (a shifted copy is shown, then the clean frame is put
// back), works for the portrait canvas too (the shift happens before the rotate) and is
// skipped while a fade/slide/state change is running.
static uint32_t s_shakeEnd = 0, s_shakeStart = 0;
static uint8_t s_shakeAmp = 0;
static void screenShake(uint16_t ms, uint8_t amp) {
  if (amp > 4) amp = 4;
  if (amp == 0 || ms == 0) return;
  if (ms > 600) ms = 600;
  uint32_t now = millis();
  if (s_shakeAmp && (int32_t)(s_shakeEnd - now) > 0 && amp < s_shakeAmp) return;  // keep the stronger one
  s_shakeAmp = amp;
  s_shakeStart = now;
  s_shakeEnd = now + ms;
}
// Current offset in pixels (|dx|,|dy| <= 4); false when no shake is running.
static bool shakeOffset(int& dx, int& dy) {
  dx = dy = 0;
  if (!s_shakeAmp) return false;
  uint32_t now = millis();
  if ((int32_t)(s_shakeEnd - now) <= 0) { s_shakeAmp = 0; return false; }
  uint32_t total = s_shakeEnd - s_shakeStart;
  if (total == 0) total = 1;
  int a = (int)(((uint32_t)s_shakeAmp * (s_shakeEnd - now) + total - 1) / total);
  if (a < 1) a = 1;
  if (a > 4) a = 4;
  uint32_t h = (now / 16u) * 2654435761u;
  dx = (int)((h >> 8) % (uint32_t)(2 * a + 1)) - a;
  dy = (int)((h >> 20) % (uint32_t)(2 * a + 1)) - a;
  return true;
}
// Presents the frame shifted by the shake offset; the canvas itself is left untouched.
// Returns false (nothing presented) when no shake applies.
static bool shakeApply() {
  int dx, dy;
  if (!shakeOffset(dx, dy)) return false;
  uint16_t* px = canvas->getBuffer();
  const int W = canvas->width(), H = canvas->height();
  uint32_t n = (uint32_t)W * (uint32_t)H;
  if (n > sizeof(s_fadeBuf) / sizeof(s_fadeBuf[0]) || W <= 8 || H <= 8) return false;
  memcpy(s_fadeBuf, px, n * sizeof(uint16_t));
  for (int y = 0; y < H; y++) {
    int sy = y - dy;
    uint16_t* d = px + (size_t)y * W;
    if (sy < 0 || sy >= H) { memset(d, 0, (size_t)W * sizeof(uint16_t)); continue; }
    const uint16_t* sr = s_fadeBuf + (size_t)sy * W;
    if (dx > 0) { memset(d, 0, (size_t)dx * sizeof(uint16_t)); memcpy(d + dx, sr, (size_t)(W - dx) * sizeof(uint16_t)); }
    else if (dx < 0) { memcpy(d, sr - dx, (size_t)(W + dx) * sizeof(uint16_t)); memset(d + (W + dx), 0, (size_t)(-dx) * sizeof(uint16_t)); }
    else memcpy(d, sr, (size_t)W * sizeof(uint16_t));
  }
  presentFrame();
  memcpy(px, s_fadeBuf, n * sizeof(uint16_t));
  return true;
}

// --- Free-RAM tracking (Settings -> Diagnostics) ---------------------------------------------------
// Free RAM = gap between the end of the heap (sbrk(0)) and the current stack pointer. The minimum
// ever seen is refreshed from blitScreen() (every game draws through it, usually from deep inside
// its own call chain) and from loop(), so it catches heap growth and most stack peaks.
static uint32_t g_minFreeRam = 0xFFFFFFFFUL;
static uint32_t g_loopAvgUs = 0;   // rolling average loop() period in microseconds (Diagnostics)
static uint32_t freeRamNow() {
  char marker;
  return (uint32_t)(&marker - (char *)sbrk(0));
}
static inline void ramSample() {
  uint32_t f = freeRamNow();
  if (f < g_minFreeRam) g_minFreeRam = f;
}

// Cartridge / CHIP-8 memory: landscape games never touch the portrait canvas, so its 40 KB buffer is
// lent out while one of them runs; the heap is only the fallback when the canvas is missing or too small.
static uint8_t* extMemGet(uint32_t need) {
  if (s_portCanvas && need <= 128UL * 160UL * 2UL) return (uint8_t*)s_portCanvas->getBuffer();
  return (uint8_t*)malloc(need);
}
static void extMemPut(void* p) {
  if (!p) return;
  if (s_portCanvas && p == (void*)s_portCanvas->getBuffer()) return;
  free(p);
}
static bool extMemFits(uint32_t need, uint32_t margin) {
  if (s_portCanvas && need <= 128UL * 160UL * 2UL) return true;
  return freeRamNow() >= need + margin;
}

static void blitScreen() {
  ramSample();
  GameState st = gameState;
  GameState prev = s_lastBlitState;
  if (st != prev) s_shakeAmp = 0;                       // no jolt across a screen change
  else if (s_shakeAmp && st != ST_PAUSE && slideDepth((uint8_t)st) < 0 && shakeApply()) {
    s_slideHold = 0xFF;
    return;
  }
  int dn = slideDepth((uint8_t)st);
  const int W = canvas->width(), H = canvas->height();
  bool eligible = dn >= 0 && W <= 160 && (uint32_t)W * (uint32_t)H <= sizeof(s_fadeBuf) / sizeof(s_fadeBuf[0]);
  if (eligible && st != prev && s_fadeEnabled && s_slideHold == (uint8_t)prev &&
      slideDepth((uint8_t)prev) >= 0 && !s_fadeSkipOnce &&
      !(s_lastFadeEndMs != 0 && millis() - s_lastFadeEndMs < 300)) {
    s_lastBlitState = st;
    blitSlide(dn > slideDepth((uint8_t)prev) ? 1 : -1);
  } else {
    blitScreenCore();
  }
  if (eligible) {
    memcpy(s_fadeBuf, canvas->getBuffer(), (size_t)W * H * sizeof(uint16_t));
    s_slideHold = (uint8_t)st;
  } else {
    s_slideHold = 0xFF;
  }
}

