#define C4_YELLOW 0xFEE0 // RGB565 yellow (constant, safe in any initializer)
static uint16_t c4FillFor(int8_t v) {
  // P1 red, P2 yellow
  return v == 1 ? COL_LASER : v == 2 ? C4_YELLOW : COL_WALL_NOPORTAL;
}

static void drawC4Scene() {
  unsigned long now = millis();
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  int bob = (animPulse(500) > 127) ? 1 : 0; // cursor arrow bobs
  canvas->fillTriangle(C4_BOARD_X + c4Cursor * C4_CELL + 2, C4_BOARD_Y - 6 - bob,
                        C4_BOARD_X + c4Cursor * C4_CELL + C4_CELL - 2, C4_BOARD_Y - 6 - bob,
                        C4_BOARD_X + c4Cursor * C4_CELL + C4_CELL / 2, C4_BOARD_Y - 1 - bob, COL_PLATE_ON);
  for (int r = 0; r < C4_ROWS; r++) {
    for (int c = 0; c < C4_COLS; c++) {
      int x = C4_BOARD_X + c * C4_CELL, y = C4_BOARD_Y + r * C4_CELL;
      uint16_t fill = (c4AnimFind(c, r, now) >= 0) ? COL_WALL_NOPORTAL : c4FillFor(c4Board[r][c]);
      canvas->fillCircle(x + C4_CELL / 2, y + C4_CELL / 2, C4_CELL / 2 - 2, fill);
    }
  }
  // Falling discs (bounce when they land).
  for (int k = 0; k < C4_ANIMS; k++) {
    if (now < c4AnT[k] || now >= c4AnT[k] + c4AnD[k]) continue;
    int c = c4AnC[k], r = c4AnR[k];
    float f = animBounce((float)(now - c4AnT[k]) / (float)c4AnD[k]);
    int yTop = C4_BOARD_Y - C4_CELL / 2;
    int yEnd = C4_BOARD_Y + r * C4_CELL + C4_CELL / 2;
    int cy = yTop + (int)((float)(yEnd - yTop) * f);
    canvas->fillCircle(C4_BOARD_X + c * C4_CELL + C4_CELL / 2, cy, C4_CELL / 2 - 2, c4FillFor(c4Board[r][c]));
  }
}

