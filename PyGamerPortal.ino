  canvas->setTextSize(1);
  ptc(COL_GOAL, 14, 14, "SPACE INVADERS");
  ptc(COL_TEXT, 4, 40, "Left/Right: move ship");
  pt(4, 50, "A: fire  Clear every");
  pt(4, 60, "wave before they land!");
  pt(4, 88, "Mode: ");
  canvas->print(kSpeedTierNames[g_variant]);
  pt(4, 98, "Left/Right: change mode");
  canvas->setCursor(4, 108);
  animPrompt("A/Start: play  B: back");
  canvas->setCursor(4, 118);
  lvlTitleHint(LVLGAME_INV);
  drawBestLine(21, 26);
  blitScreen();
}
static void enterInvPlaying() {
  if (portraitGate(enterInvPlaying, enterInvTitle)) return;
  s_mazeRng = gameSeed();
  invShipX = INV_PW / 2.0f;
  invScore = 0;
  invWave = 0;
  float invStartSpeed;
  switch (g_variant) {
    case 1: invStartSpeed = 22.0f; break; // Speed
    case 2: invStartSpeed = 9.0f; break;  // Chill
    case 3: invStartSpeed = 30.0f; break; // Extreme
    case 4: invStartSpeed = 6.0f; break;  // Zen
    default: invStartSpeed = 14.0f; break;
  }
  if (s_lvlActiveSlot[LVLGAME_INV] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_INV, s_lvlActiveSlot[LVLGAME_INV], &lvl)) {
      invGridSpeed = invStartSpeed; // invLoadCustom() doesn't go through invNewWave()'s +6.0f
      invLoadCustom(&lvl);
    } else {
      s_lvlActiveSlot[LVLGAME_INV] = -1;
      invGridSpeed = invStartSpeed - 6.0f; // invNewWave() adds 6.0f back below
      invNewWave();
    }
  } else {
    invGridSpeed = invStartSpeed - 6.0f; // invNewWave() adds 6.0f back below
    invNewWave();
  }
  gameState = ST_INV_PLAYING;
  s_lastFrameMs = 0;
}

