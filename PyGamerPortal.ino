static void fmtBestValue(int g, int32_t v, char* out, size_t n) {
  if (v == SAVE_NO_SCORE) { snprintf(out, n, "--"); return; }
  if (g == 3) snprintf(out, n, "%ldms", (long)v);
  else if (g == 33 || g == 59 || g == 60 || g == 62) snprintf(out, n, "%lds", (long)v); // Minesweeper / Sudoku / Nonogram / Pipe Link: whole seconds
  else if (g == 46 || g == 50) snprintf(out, n, "%ldm", (long)v);   // Cube Dash / Road Racer: metres
  else if (g == 52 || g == 53 || g == 54) snprintf(out, n, "%ld pts", (long)v);   // Mastermind / Checkers / Chess
  else if (g == 43) {   // Slide 15: fewer is better
    char tmp[24];
    snprintf(tmp, sizeof(tmp), "%d moves", (int)(v > 99999 ? 99999 : v));
    size_t i = 0;
    while (tmp[i] && i + 1 < n) { out[i] = tmp[i]; i++; }
    out[i] = 0;
  }
  else if (bestIsMs(g)) snprintf(out, n, "%ld.%lds", (long)(v / 1000), (long)((v / 100) % 10));
  else snprintf(out, n, "%ld", (long)v);
}

// Second HUD line (y=9) for the endless games: "<left>  Best <persisted best>".
static void drawHudLine2(const char* left, int gameIdx) {
  char val[16], line[40];
  fmtBestValue(gameIdx, saveBest(gameIdx, saveTierOf(g_variant)), val, sizeof(val));
  snprintf(line, sizeof(line), "%s  Best %s", left, val);
  canvas->setTextSize(1);
  ptc(COL_KEY, 2, 9, line);
}


// --- Toast banner + achievements ----------------------------------------------
// A toast is a 12px banner drawn over the top of whatever is on the canvas for
// 2 seconds. The strip underneath is saved first and put back afterwards, but
// only if the screen was not redrawn in the meantime (checked by checksum).
#define TOAST_H 12
#define TOAST_MS 2000
#define TOAST_Q 4
static char s_toastQ[TOAST_Q][28];
static int s_toastQN = 0;
static uint32_t s_toastSum = 0;
static uint16_t s_toastSaved[160 * TOAST_H];

static void toastShow(const char* text) {
  if (s_toastQN >= TOAST_Q) return;
  snprintf(s_toastQ[s_toastQN], sizeof(s_toastQ[0]), "%.26s", text);
  s_toastQN++;
}

static uint32_t toastStripSum() {
  const uint16_t* b = canvas->getBuffer();
  uint32_t h = 2166136261u;
  for (int i = 0; i < 160 * TOAST_H; i++) h = (h ^ b[i]) * 16777619u;
  return h;
}

// Called at the top of loop(). The banner slides down from the top edge,
// holds, then slides back up; each frame checks that the strip is still what
// we drew last (otherwise the screen was redrawn and the toast just ends).
#define TOAST_SLIDE_MS 140
static uint8_t s_toastPhase = 0; // 0 idle, 1 slide in, 2 hold, 3 slide out
static unsigned long s_toastT0 = 0, s_toastLast = 0;
static char s_toastCur[28];

// vis = visible banner height in px (0..TOAST_H), drawn over the saved strip.
static void toastDrawAt(int vis) {
  memcpy(canvas->getBuffer(), s_toastSaved, sizeof(s_toastSaved));
  if (vis > 0) {
    canvas->fillRect(0, vis - TOAST_H, 160, TOAST_H, COL_ORANGE);
    canvas->setTextSize(1);
    canvas->setTextColor(COL_BG);
    canvas->setCursor(4, vis - TOAST_H + 2);
    {
      char tb[28];   // portrait is only 128px wide: clip the text to fit
      snprintf(tb, sizeof(tb), "%.*s", (canvas->width() - 8) / 6, s_toastCur);
      canvas->print(tb);
    }
    // Sparkles: a few white glints (one of them a little cross) twinkling along the banner.
    {
      uint32_t ph = millis() / 90u;
      int cw = canvas->width();
      for (int k = 0; k < 4; k++) {
        uint32_t h = (ph + (uint32_t)k * 7u) * 2654435761u;
        int gx = (int)((h >> 8) % (uint32_t)cw);
        int gy = vis - TOAST_H + 1 + (int)((h >> 20) % (TOAST_H - 2));   // stays inside the banner
        canvas->drawPixel(gx, gy, 0xFFFF);
        if (k == 0) {
          canvas->drawPixel(gx - 1, gy, 0xFFFF);
          canvas->drawPixel(gx + 1, gy, 0xFFFF);
          canvas->drawPixel(gx, gy - 1, 0xFFFF);
          canvas->drawPixel(gx, gy + 1, 0xFFFF);
        }
      }
    }
  }
  s_toastSum = toastStripSum();
  blitScreen();
}

// Set by menuAnimTick() whenever it repainted a whole menu screen (which also
// wiped the banner), so the toast is re-applied on top of the fresh frame.
static bool g_menuRedrawn = false;
static bool toastMenuState() {
  return gameState == ST_GAME_PICKER || gameState == ST_SETTINGS || gameState == ST_HUB ||
         gameState == ST_TROPHIES || gameState == ST_HISCORES || gameState == ST_MIX_INTRO ||
         gameState == ST_MIX_RESULTS || gameState == ST_CREDITS || gameState == ST_HELP || gameState == ST_USBDRIVE ||
         gameState == ST_DIAG || gameState == ST_ERRLOG;
}

static void toastService() {
  if (s_toastPhase == 0 && s_toastQN == 0) return;
  unsigned long now = millis();
  if (s_toastPhase == 0) {
    memcpy(s_toastSaved, canvas->getBuffer(), sizeof(s_toastSaved));
    memcpy(s_toastCur, s_toastQ[0], sizeof(s_toastCur));
    for (int i = 1; i < s_toastQN; i++) memcpy(s_toastQ[i - 1], s_toastQ[i], sizeof(s_toastQ[0]));
    s_toastQN--;
    s_toastSum = toastStripSum();
    s_toastPhase = 1;
    s_toastT0 = now;
    s_toastLast = now;
    g_menuRedrawn = false;
    if (strstr(s_toastCur, "nlocked") || !strncmp(s_toastCur, "Trophy", 6)) jingleStart(JG_ACH);
    else sfx(880, 60);
    return;
  }
  bool menuMode = toastMenuState();
  if (menuMode) {
    if (!g_menuRedrawn) return; // banner from the last frame is still on screen
    g_menuRedrawn = false;
    memcpy(s_toastSaved, canvas->getBuffer(), sizeof(s_toastSaved));
    s_toastSum = toastStripSum();
  } else if (toastStripSum() != s_toastSum) {
    s_toastPhase = 0; // screen was redrawn by the game: just stop
    return;
  }
  if (s_toastPhase == 2) {
    if ((long)(now - s_toastT0) >= TOAST_MS) { s_toastPhase = 3; s_toastT0 = now; s_toastLast = 0; }
    else if (menuMode) toastDrawAt(TOAST_H);
    return;
  }
  if (!menuMode && now - s_toastLast < 25) return;
  s_toastLast = now;
  float t = (float)(now - s_toastT0) / (float)TOAST_SLIDE_MS;
  if (s_toastPhase == 1) {
    if (t >= 1.0f) { toastDrawAt(TOAST_H); s_toastPhase = 2; s_toastT0 = now; }
    else toastDrawAt((int)(TOAST_H * animEase(t) + 0.5f));
  } else {
    if (t >= 1.0f) { toastDrawAt(0); s_toastPhase = 0; }
    else toastDrawAt(TOAST_H - (int)(TOAST_H * animEase(t) + 0.5f));
  }
}

