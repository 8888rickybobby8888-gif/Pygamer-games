  }
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(2);
  char buf[12];
  snprintf(buf, sizeof(buf), "%d", gapScore);
  int textW = strlen(buf) * 12;
  pt((sw - textW) / 2, 50 + yo, buf);
  canvas->setTextSize(1);
  canvas->setCursor(4, 78 + yo);
  if (gapCustom) {
    canvas->print("walls passed");
  } else {
    canvas->print("score -- best: ");
    canvas->print(gapBestScore);
  }
  canvas->setCursor(4, 108 + yo);
  animPrompt(sw >= 160 ? "A/Start: retry  B: back" : "A: retry  B: back");
  drawBestLineOver(19, 92 + yo);
  blitScreen();
}

// --- Platform Dash -----------------------------------------------------
//
// Auto-running platformer: gravity, jump arcs, and a ground that scrolls
// past with real pits (jump over or fall) and blocks (jump over or hit).
// Both hazard kinds share one collision rule -- clear a "must be above
// this Y while overlapping this X range" line -- so pits and blocks use
// the same check with different thresholds.

#define PLAT_GROUND_H 10
#define PLAT_GROUND_Y (HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - PLAT_GROUND_H)
#define PLAT_PLAYER_SIZE 8
#define PLAT_PLAYER_X 24
#define PLAT_MAX_HAZARDS 3
#define PLAT_GRAVITY 300.0f
#define PLAT_JUMP_VY -140.0f
struct PlatHazard { bool active; float x; int w; int topY; bool scored; };
static PlatHazard platHazards[PLAT_MAX_HAZARDS];
static float platPlayerY, platPlayerVY;
static bool platGrounded;
static unsigned long platNextSpawnMs;
static int platScore, platBestScore;
static float platSpeedCur = 65.0f;

static void platSpawnHazard(float x) {
  for (int i = 0; i < PLAT_MAX_HAZARDS; i++) {
    if (platHazards[i].active) continue;
    platHazards[i].active = true;
    platHazards[i].x = x;
    bool pit = mazeRngRange(100) < 55;
    if (pit) {
      platHazards[i].w = 14 + mazeRngRange(10);
      platHazards[i].topY = PLAT_GROUND_Y;
    } else {
      platHazards[i].w = 10;
      platHazards[i].topY = PLAT_GROUND_Y - 14;
    }
    platHazards[i].scored = false;
    return;
  }
}

// Level editor hook: tile ids are 0=Safe, 1=Pit, 2=Block, 3=Finish.
// Platform Dash is an endless auto-runner, not a fixed grid level -- there's
// nothing resembling a 2D layout to reuse. A custom level is instead
// authored as a 1D timeline (row 0 of the editor grid, one cell per
// hazard-spawn "beat") that replaces the random pit/block RNG for exactly
// one run and ends in a win once the Finish beat is reached, rather than
// looping forever.
static bool s_platCustomActive = false;
static uint8_t s_platCustomCells[LVL_GRID_MAXW];
static uint8_t s_platCustomLen = 0;
static uint8_t s_platCustomIdx = 0;
static bool s_platCustomWon = false;

static bool platSpawnHazardType(float x, bool pit) {
  for (int i = 0; i < PLAT_MAX_HAZARDS; i++) {
    if (platHazards[i].active) continue;
    platHazards[i].active = true;
    platHazards[i].x = x;
    if (pit) {
      platHazards[i].w = 20;
      platHazards[i].topY = PLAT_GROUND_Y;
    } else {
      platHazards[i].w = 10;
      platHazards[i].topY = PLAT_GROUND_Y - 14;
    }
    platHazards[i].scored = false;
    return true;
  }
  return false;   // every slot busy
}

static void platLoadCustom(const LevelData *lvl) {
  s_platCustomLen = lvl->w;
  for (int c = 0; c < lvl->w; c++) s_platCustomCells[c] = lvl->cells[0][c];
  s_platCustomIdx = 0;
  s_platCustomActive = true;
  s_platCustomWon = false;
}

static bool platValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int finishes = 0;
  for (int c = 0; c < lvl->w; c++)
    if (lvl->cells[0][c] == 3) finishes++;
  if (finishes != 1) { snprintf(msg, msgLen, "Need exactly 1 Finish"); return false; }
  if (lvl->cells[0][0] != 0) { snprintf(msg, msgLen, "First cell must be Safe"); return false; }
  return true;
}

static void enterPlatTitle() {
  gameState = ST_PLAT_TITLE;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 18, 14, "PLATFORM DASH");
  ptc(COL_TEXT, 4, 40, "A: jump");
  pt(4, 50, "Clear the pits and");
  pt(4, 60, "blocks -- don't fall!");
  pt(4, 88, "Mode: ");
  canvas->print(kSpeedTierNames[g_variant]);
  pt(4, 98, "Left/Right: change mode");
  canvas->setCursor(4, 108);
  animPrompt("A/Start: play  B: back");
  canvas->setCursor(4, 118);
  lvlTitleHint(LVLGAME_PLAT);
  drawBestLine(20, 26);
  blitScreen();
}

static void enterPlatPlaying() {
  s_mazeRng = gameSeed();
  for (int i = 0; i < PLAT_MAX_HAZARDS; i++) platHazards[i].active = false;
  platPlayerY = PLAT_GROUND_Y - PLAT_PLAYER_SIZE;
  platPlayerVY = 0;
  platGrounded = true;
  platScore = 0;
  switch (g_variant) {
    case 1: platSpeedCur = 85.0f; break;  // Speed
    case 2: platSpeedCur = 48.0f; break;  // Chill
    case 3: platSpeedCur = 105.0f; break; // Extreme
    case 4: platSpeedCur = 38.0f; break;  // Zen
    default: platSpeedCur = 65.0f; break;
  }
  s_platCustomActive = false;
  if (s_lvlActiveSlot[LVLGAME_PLAT] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_PLAT, s_lvlActiveSlot[LVLGAME_PLAT], &lvl)) {
      platLoadCustom(&lvl);
    } else {
      s_lvlActiveSlot[LVLGAME_PLAT] = -1;
    }
  }
  if (!s_platCustomActive) {
    platSpawnHazard(VIEW_COLS * TILE_SIZE + 30);
  }
  platNextSpawnMs = millis() + 1100;
  gameState = ST_PLAT_PLAYING;
  s_lastFrameMs = 0;
}

static void drawPlatScene() {
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  canvas->fillRect(0, PLAT_GROUND_Y, VIEW_COLS * TILE_SIZE, PLAT_GROUND_H, COL_WALL_NOPORTAL);
  for (int i = 0; i < PLAT_MAX_HAZARDS; i++) {
    if (!platHazards[i].active) continue;
    if (platHazards[i].topY == PLAT_GROUND_Y) {
      canvas->fillRect((int)platHazards[i].x, PLAT_GROUND_Y, platHazards[i].w, PLAT_GROUND_H, COL_BG);
    } else {
      canvas->fillRect((int)platHazards[i].x, platHazards[i].topY, platHazards[i].w,
                        PLAT_GROUND_Y - platHazards[i].topY, COL_LASER);
    }
  }
  canvas->fillRect(PLAT_PLAYER_X, (int)platPlayerY, PLAT_PLAYER_SIZE, PLAT_PLAYER_SIZE, COL_PLAYER);
}

static void drawPlatHud() {
  canvas->fillRect(0, 0, VIEW_COLS * TILE_SIZE, HUD_HEIGHT, COL_BG);
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(1);
  pt(2, 4, "SCORE ");
  canvas->print(platScore);
}

