// --- Block Stack (Tetris-style) -------------------------------------------
//
// 10x14 well, 7 tetrominoes dealt from a shuffled 7-bag. Score = lines
// cleared. Tiers change the fall speed; EXTREME also starts with 4 rows of
// garbage. Piece shapes are 4x4 bitmasks (bit 15 = top-left cell).

#define BS_W 10
#define BS_H 14
// Portrait (128x160): 10px cells -> 100x140 well, centred, with a 16px HUD strip above it.
#define BS_CELL 10
#define BS_X0 14
#define BS_Y0 17
static const uint16_t kBsShapes[7][4] = {
    {0x0F00, 0x2222, 0x00F0, 0x4444},  // I
    {0x6600, 0x6600, 0x6600, 0x6600},  // O
    {0x0E40, 0x4C40, 0x4E00, 0x4640},  // T
    {0x06C0, 0x8C40, 0x6C00, 0x4620},  // S
    {0x0C60, 0x4C80, 0xC600, 0x2640},  // Z
    {0x8E00, 0x6440, 0x0E20, 0x44C0},  // J
    {0x2E00, 0x4460, 0x0E80, 0xC440},  // L
};
static uint8_t bsWell[BS_H][BS_W]; // 0 empty, 1-7 piece colour, 8 garbage, 9-12 coloured garbage (custom start)
static uint16_t bsColors[13];      // runtime-filled (color565 is not constant)
// Level-creator start: garbage in the bottom 8 rows (tile 1 = grey, 2-5 = colours). Clearing every
// garbage cell wins; the run's result is the number of pieces used (fewer is better).
static bool bsCustom = false, bsWon = false;
static int bsPieces = 0;
static int8_t bsBag[7];
static int8_t bsBagPos, bsPiece, bsRot, bsNext;
static int bsX, bsY, bsLines;
static unsigned long bsBaseMs, bsFallAtMs, bsRepAtMs;
// Cosmetic state: cleared-row sweep, lock flash, eased falling-piece row.
static int bsFlashRows[4], bsFlashN = 0;
static unsigned long bsFlashAt = 0;
static int bsLkCells[4][2], bsLkN = 0;
static unsigned long bsLkAt = 0, bsVisAt = 0;
static float bsVisY = 0;

static void bsInitColors() {
  bsColors[0] = COL_BG;
  bsColors[1] = arcada.display->color565(0, 220, 230);
  bsColors[2] = arcada.display->color565(240, 220, 0);
  bsColors[3] = arcada.display->color565(170, 0, 220);
  bsColors[4] = arcada.display->color565(0, 210, 60);
  bsColors[5] = arcada.display->color565(230, 30, 30);
  bsColors[6] = arcada.display->color565(40, 80, 255);
  bsColors[7] = arcada.display->color565(255, 140, 0);
  bsColors[8] = arcada.display->color565(110, 110, 120);
  bsColors[9] = arcada.display->color565(230, 30, 30);
  bsColors[10] = arcada.display->color565(40, 80, 255);
  bsColors[11] = arcada.display->color565(0, 210, 60);
  bsColors[12] = arcada.display->color565(240, 220, 0);
}

static bool bstkValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int filled = 0;
  for (int r = 0; r < lvl->h; r++) {
    int f = 0;
    for (int c = 0; c < lvl->w; c++) if (lvl->cells[r][c] != 0) f++;
    if (f >= lvl->w) { snprintf(msg, msgLen, "Row %d is full", r + 1); return false; }
    filled += f;
  }
  if (filled < 4) { snprintf(msg, msgLen, "Add some garbage"); return false; }
  if (filled * 10 > lvl->w * lvl->h * 7) { snprintf(msg, msgLen, "Over 70%% filled"); return false; }
  return true;
}

// Copies the editor grid into the bottom of the well (grid row 0 = well row BS_H - 8).
static void bsLoadCustom(const LevelData *lvl) {
  int n = 0;
  for (int r = 0; r < 8; r++)
    for (int c = 0; c < BS_W; c++) {
      uint8_t t = (r < lvl->h && c < lvl->w) ? lvl->cells[r][c] : 0;
      if (t > 5) t = 0;
      bsWell[BS_H - 8 + r][c] = t ? (uint8_t)(7 + t) : 0;
      if (t) n++;
    }
  bsCustom = n > 0;
}

static bool bsGarbageLeft() {
  for (int r = 0; r < BS_H; r++)
    for (int c = 0; c < BS_W; c++) if (bsWell[r][c] >= 8) return true;
  return false;
}

static bool bsFits(int p, int r, int x, int y) {
  uint16_t m = kBsShapes[p][r];
  for (int i = 0; i < 16; i++) {
    if (!(m & (0x8000 >> i))) continue;
    int cx = x + (i & 3), cy = y + (i >> 2);
    if (cx < 0 || cx >= BS_W || cy >= BS_H) return false;
    if (cy >= 0 && bsWell[cy][cx]) return false;
  }
  return true;
}

static int bsDrawFromBag() {
  if (bsBagPos >= 7) {
    for (int i = 0; i < 7; i++) bsBag[i] = i;
    for (int i = 6; i > 0; i--) {
      int j = mazeRngRange(i + 1);
      int8_t t = bsBag[i];
      bsBag[i] = bsBag[j];
      bsBag[j] = t;
    }
    bsBagPos = 0;
  }
  return bsBag[bsBagPos++];
}

static unsigned long bsInterval() {
  long iv = (long)bsBaseMs - (long)bsLines * 12;
  long floorMs = (g_variant == 3) ? 60 : 80;
  if (iv < floorMs) iv = floorMs;
  return (unsigned long)iv;
}

// Brings in the next piece. Returns false if it has no room (game over).
static bool bsSpawn() {
  bsPiece = bsNext;
  bsNext = bsDrawFromBag();
  bsRot = 0;
  bsX = 3;
  bsY = 0;
  bsFallAtMs = millis() + bsInterval();
  bsVisY = (float)bsY;
  bsVisAt = millis();
  return bsFits(bsPiece, bsRot, bsX, bsY);
}

// Writes the falling piece into the well and clears full rows; returns how
// many rows were cleared.
static int bsLock() {
  uint16_t m = kBsShapes[bsPiece][bsRot];
  bsLkN = 0;
  for (int i = 0; i < 16; i++) {
    if (!(m & (0x8000 >> i))) continue;
    int cx = bsX + (i & 3), cy = bsY + (i >> 2);
    if (cx >= 0 && cx < BS_W && cy >= 0 && cy < BS_H) {
      bsWell[cy][cx] = bsPiece + 1;
      if (bsLkN < 4) { bsLkCells[bsLkN][0] = cx; bsLkCells[bsLkN][1] = cy; bsLkN++; }
    }
  }
  bsLkAt = millis();
  int cleared = 0;
  bsFlashN = 0;
  for (int r = BS_H - 1; r >= 0;) {
    bool full = true;
    for (int c = 0; c < BS_W; c++) if (!bsWell[r][c]) { full = false; break; }
    if (!full) { r--; continue; }
    if (bsFlashN < 4) bsFlashRows[bsFlashN++] = r - cleared; // row position before collapsing
    for (int rr = r; rr > 0; rr--) memcpy(bsWell[rr], bsWell[rr - 1], BS_W);
    memset(bsWell[0], 0, BS_W);
    cleared++;
  }
  if (cleared > 0) { bsFlashAt = millis(); bsLkN = 0; }
  return cleared;
}

static void enterBstkTitle() {
  gameState = ST_BSTK_TITLE;
  drawStdTitle("BLOCK STACK", COL_TELE_B, "L/R move  Down: drop", "Select/A: rotate B:slam",
               "Clear lines to score", 31);
}

static void enterBstkPlaying() {
  if (portraitGate(enterBstkPlaying, enterBstkTitle)) return;
  bsInitColors();
  s_mazeRng = gameSeed();
  memset(bsWell, 0, sizeof(bsWell));
  bsLines = 0;
  bsBagPos = 7;
  switch (g_variant & 3) {
    case 1: bsBaseMs = 450; break;  // Speed
    case 2: bsBaseMs = 1000; break; // Chill
    case 3: bsBaseMs = 300; break;  // Extreme (plus garbage below)
    default: bsBaseMs = 700; break;
  }
  if ((g_variant & 3) == 3) {
    for (int r = BS_H - 4; r < BS_H; r++) {
      int hole = mazeRngRange(BS_W);
      for (int c = 0; c < BS_W; c++) bsWell[r][c] = (c == hole) ? 0 : 8;
    }
  }
  bsCustom = false;
  bsWon = false;
  bsPieces = 0;
  if (s_lvlActiveSlot[LVLGAME_BSTK] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_BSTK, s_lvlActiveSlot[LVLGAME_BSTK], &lvl)) {
      memset(bsWell, 0, sizeof(bsWell));   // the hand-made garbage replaces the Extreme rows
      bsLoadCustom(&lvl);
    } else {
      s_lvlActiveSlot[LVLGAME_BSTK] = -1;
    }
  }
  bsFlashN = 0;
  bsLkN = 0;
  bsNext = bsDrawFromBag();
  bsSpawn();
  bsRepAtMs = 0;
  gameState = ST_BSTK_PLAYING;
}

static void drawBstkCell(int cx, int cy, uint16_t col) {
  canvas->fillRect(BS_X0 + cx * BS_CELL, BS_Y0 + cy * BS_CELL, BS_CELL - 1, BS_CELL - 1, col);
}

static void drawBstkScene() {
  canvas->fillScreen(COL_BG);
  canvas->drawRect(BS_X0 - 1, BS_Y0 - 1, BS_W * BS_CELL + 2, BS_H * BS_CELL + 2, COL_WALL);
  for (int r = 0; r < BS_H; r++)
    for (int c = 0; c < BS_W; c++)
      if (bsWell[r][c]) drawBstkCell(c, r, bsColors[bsWell[r][c]]);
  unsigned long bsDrawNow = millis();
  // Lock flash: the cells of the piece that just landed glow white briefly.
  if (bsLkN > 0 && bsDrawNow - bsLkAt < 120) {
    uint8_t a = (uint8_t)(255 - (bsDrawNow - bsLkAt) * 255 / 120);
    for (int k = 0; k < bsLkN; k++) {
      int fx = bsLkCells[k][0], fy = bsLkCells[k][1];
      if (bsWell[fy][fx]) drawBstkCell(fx, fy, animBlend(bsColors[bsWell[fy][fx]], 0xFFFF, a));
    }
  }
  // Line clear: white bar sweeps across each cleared row, then fades out.
  if (bsFlashN > 0 && bsDrawNow - bsFlashAt < 220) {
    uint32_t el = bsDrawNow - bsFlashAt;
    for (int k = 0; k < bsFlashN; k++) {
      int fy = BS_Y0 + bsFlashRows[k] * BS_CELL;
      if (el < 90) {
        int w = (int)(BS_W * BS_CELL * animEase((float)el / 90.0f));
        canvas->fillRect(BS_X0, fy, w, BS_CELL - 1, 0xFFFF);
      } else {
        canvas->fillRect(BS_X0, fy, BS_W * BS_CELL - 1,
                         BS_CELL - 1, animBlend(0xFFFF, COL_BG, (uint8_t)((el - 90) * 255 / 130)));
      }
    }
  }
  // Eased vertical position of the falling piece (glides into each new row).
  bsVisY += ((float)bsY - bsVisY) * (1.0f - expf(-(float)(bsDrawNow - bsVisAt) / 45.0f));
  bsVisAt = bsDrawNow;
  if (bsVisY > (float)bsY) bsVisY = (float)bsY; // never draws below its real cell
  if ((float)bsY - bsVisY < 0.04f) bsVisY = (float)bsY;
  int bsOffY = (int)((bsVisY - (float)bsY) * BS_CELL - 0.5f);
  if (bsVisY == (float)bsY) bsOffY = 0;
  // Landing ghost (outline), then the falling piece itself.
  int gy = bsY;
  while (bsFits(bsPiece, bsRot, bsX, gy + 1)) gy++;
  uint16_t m = kBsShapes[bsPiece][bsRot];
  for (int i = 0; i < 16; i++) {
    if (!(m & (0x8000 >> i))) continue;
    int cx = bsX + (i & 3), cy = (i >> 2);
    if (gy + cy >= 0 && gy != bsY)
      canvas->drawRect(BS_X0 + cx * BS_CELL, BS_Y0 + (gy + cy) * BS_CELL, BS_CELL - 1,
                       BS_CELL - 1, COL_WALL);
  }
  for (int i = 0; i < 16; i++) {
    if (!(m & (0x8000 >> i))) continue;
    int cx = bsX + (i & 3), cy = bsY + (i >> 2);
    if (cy >= 0)
      canvas->fillRect(BS_X0 + cx * BS_CELL, BS_Y0 + cy * BS_CELL + bsOffY, BS_CELL - 1,
                       BS_CELL - 1, bsColors[bsPiece + 1]);
  }
  // HUD strip above the well: lines (left) and the next piece (right).
  canvas->setTextSize(1);
  ptc(COL_TEXT, 3, 5, "LINES");
  canvas->setTextSize(2);
  pt(36, 1, bsLines);
  canvas->setTextSize(1);
  pt(82, 5, "NEXT");
  uint16_t nm = kBsShapes[bsNext][0];
  for (int i = 0; i < 16; i++) {
    if (!(nm & (0x8000 >> i))) continue;
    canvas->fillRect(108 + (i & 3) * 4, 2 + (i >> 2) * 4, 3, 3, bsColors[bsNext + 1]);
  }
  particlesUpdateDraw();
}

static void drawBstkOverScreen() {
  char big[12];
  if (bsWon) {
    snprintf(big, sizeof(big), "%d", bsPieces);
    drawStdOver("GARBAGE CLEARED", COL_GOAL, big, "pieces used", 31);
    return;
  }
  snprintf(big, sizeof(big), "%d", bsLines);
  drawStdOver("STACKED OUT", COL_LASER, big, "lines cleared", 31);
}

// --- 2048 ------------------------------------------------------------------
//
// Slide with the D-pad; equal tiles merge and the merged value is added to
// the score. Tiles are stored as exponents (1 = 2, 2 = 4, ...). Tiers:
// NORMAL 4x4, SPEED 4x4 with lots of 4s, CHILL 5x5, EXTREME 3x3.

#define G48_MAX 5
static uint8_t g48[G48_MAX][G48_MAX];
static uint16_t g48Col[16]; // runtime-filled tile colours
static int g48N, g48CellSz, g48FourPct;
static long g48Score;
static bool g48ColReady = false;
// Slide animation bookkeeping (logic is applied instantly; these only drive
// the drawing): per tile {fromR, fromC, toR, toC, exponent}, merge-pop flags,
// and the freshly spawned cell.
#define G48_SLIDE_MS 110
#define G48_POP_MS 110
static uint8_t g48Mv[G48_MAX * G48_MAX][5];
static int g48MvN = 0;
static bool g48Pop[G48_MAX][G48_MAX];
static int g48SpR = -1, g48SpC = -1;
static bool g48Anim = false;
static unsigned long g48AnimStart = 0;

static void g48InitColors() {
  if (g48ColReady) return;
  g48ColReady = true;
  g48Col[0] = arcada.display->color565(30, 30, 40);
  g48Col[1] = arcada.display->color565(238, 228, 218);
  g48Col[2] = arcada.display->color565(237, 224, 200);
  g48Col[3] = arcada.display->color565(242, 177, 121);
  g48Col[4] = arcada.display->color565(245, 149, 99);
  g48Col[5] = arcada.display->color565(246, 124, 95);
  g48Col[6] = arcada.display->color565(246, 94, 59);
  g48Col[7] = arcada.display->color565(237, 207, 114);
  g48Col[8] = arcada.display->color565(237, 204, 97);
  g48Col[9] = arcada.display->color565(237, 200, 80);
  g48Col[10] = arcada.display->color565(237, 197, 63);
  g48Col[11] = arcada.display->color565(237, 194, 46);
  for (int i = 12; i < 16; i++) g48Col[i] = arcada.display->color565(60, 60, 220);
}

static void g48Pos(int dir, int i, int j, int& r, int& c) {
  switch (dir) {
    case 0: r = i; c = j; break;                 // left
    case 1: r = i; c = g48N - 1 - j; break;      // right
    case 2: r = j; c = i; break;                 // up
    default: r = g48N - 1 - j; c = i; break;     // down
  }
}

// Slides + merges every line toward `dir`. Returns true if anything moved.
// Sets *merged when at least one pair merged (for the sound).
static bool g48Slide(int dir, bool* merged) {
  bool moved = false;
  g48MvN = 0;
  memset(g48Pop, 0, sizeof(g48Pop));
  g48SpR = g48SpC = -1;
  for (int i = 0; i < g48N; i++) {
    uint8_t out[G48_MAX] = {0};
    bool done[G48_MAX] = {false};
    int o = 0;
    for (int j = 0; j < g48N; j++) {
      int r, c;
      g48Pos(dir, i, j, r, c);
      uint8_t v = g48[r][c];
      if (!v) continue;
      int destIdx;
      if (o > 0 && out[o - 1] == v && !done[o - 1]) {
        out[o - 1]++;
        done[o - 1] = true;
        g48Score += 1L << out[o - 1];
        *merged = true;
        destIdx = o - 1;
      } else {
        destIdx = o;
        out[o++] = v;
      }
      int dr, dc;
      g48Pos(dir, i, destIdx, dr, dc);
      if (g48MvN < G48_MAX * G48_MAX) {
        g48Mv[g48MvN][0] = (uint8_t)r;
        g48Mv[g48MvN][1] = (uint8_t)c;
        g48Mv[g48MvN][2] = (uint8_t)dr;
        g48Mv[g48MvN][3] = (uint8_t)dc;
        g48Mv[g48MvN][4] = v;
        g48MvN++;
      }
      if (out[destIdx] != v) g48Pop[dr][dc] = true;
    }
    for (int j = 0; j < g48N; j++) {
      int r, c;
      g48Pos(dir, i, j, r, c);
      if (g48[r][c] != out[j]) moved = true;
      g48[r][c] = out[j];
    }
  }
  return moved;
}

static void g48Spawn() {
  int empties = 0;
  for (int r = 0; r < g48N; r++)
    for (int c = 0; c < g48N; c++) if (!g48[r][c]) empties++;
  if (!empties) return;
  int pick = mazeRngRange(empties);
  for (int r = 0; r < g48N; r++)
    for (int c = 0; c < g48N; c++) {
      if (g48[r][c]) continue;
      if (pick-- == 0) {
        g48[r][c] = (mazeRngRange(100) < g48FourPct) ? 2 : 1;
        g48SpR = r;
        g48SpC = c;
        return;
      }
    }
}

static bool g48CanMove() {
  for (int r = 0; r < g48N; r++)
    for (int c = 0; c < g48N; c++) {
      if (!g48[r][c]) return true;
      if (c + 1 < g48N && g48[r][c] == g48[r][c + 1]) return true;
      if (r + 1 < g48N && g48[r][c] == g48[r + 1][c]) return true;
    }
  return false;
}

static void enter2048Title() {
  gameState = ST_2048_TITLE;
  drawStdTitle("2048", COL_KEY, "D-pad: slide tiles", "Equal tiles merge", "Score = merged value", 32);
}

static void enter2048Playing() {
  g48InitColors();
  s_mazeRng = gameSeed();
  memset(g48, 0, sizeof(g48));
  g48Score = 0;
  switch (g_variant & 3) {
    case 1: g48N = 4; g48FourPct = 40; break;  // Speed: lots of 4s
    case 2: g48N = 5; g48FourPct = 10; break;  // Chill: roomy 5x5
    case 3: g48N = 3; g48FourPct = 10; break;  // Extreme: tiny 3x3
    default: g48N = 4; g48FourPct = 10; break;
  }
  g48CellSz = 110 / g48N;   // landscape: board <=110px square, stats on the right
  g48Anim = false;
  g48Spawn();
  g48Spawn();
  g48SpR = g48SpC = -1;
  gameState = ST_2048_PLAYING;
}

// Draws one tile in the cell whose top-left pixel is (x, y); a larger inset
// makes it smaller (spawn pop-in), a negative one makes it bigger (merge pop).
static void g48DrawTile(int x, int y, int inset, uint8_t e) {
  int sz = g48CellSz - 2 * inset;
  if (sz < 2) return;
  canvas->fillRect(x + inset, y + inset, sz, sz, g48Col[e > 15 ? 15 : e]);
  if (!e) return;
  char buf[16];
  long v = 1L << e;
  if (v >= 1000) snprintf(buf, sizeof(buf), "%ldk", v / 1000);
  else snprintf(buf, sizeof(buf), "%ld", v);
  int tw = (int)strlen(buf) * 6;
  if (sz < tw + 2) return;
  ptc(e <= 2 ? COL_BG : COL_TEXT, x + (g48CellSz - tw) / 2, y + (g48CellSz - 8) / 2, buf);
}

static void drawG48Scene() {
  canvas->fillScreen(COL_BG);
  const int x0 = 4, y0 = (128 - g48N * g48CellSz) / 2;
  canvas->fillRect(x0 - 2, y0 - 2, g48N * g48CellSz + 4, g48N * g48CellSz + 4, COL_WALL_NOPORTAL);
  canvas->setTextSize(1);
  uint32_t el = 0;
  if (g48Anim) {
    el = millis() - g48AnimStart;
    if (el >= G48_SLIDE_MS + G48_POP_MS) g48Anim = false;
  }
  for (int r = 0; r < g48N; r++)
    for (int c = 0; c < g48N; c++)
      canvas->fillRect(x0 + c * g48CellSz + 1, y0 + r * g48CellSz + 1, g48CellSz - 2, g48CellSz - 2, g48Col[0]);
  if (g48Anim && el < G48_SLIDE_MS) {
    float f = animEase((float)el / (float)G48_SLIDE_MS);
    for (int i = 0; i < g48MvN; i++) {
      float fx = g48Mv[i][1] + ((float)g48Mv[i][3] - (float)g48Mv[i][1]) * f;
      float fy = g48Mv[i][0] + ((float)g48Mv[i][2] - (float)g48Mv[i][0]) * f;
      g48DrawTile(x0 + (int)(fx * g48CellSz + 0.5f), y0 + (int)(fy * g48CellSz + 0.5f), 1, g48Mv[i][4]);
    }
  } else {
    float k = g48Anim ? (float)(el - G48_SLIDE_MS) / (float)G48_POP_MS : 1.0f;
    for (int r = 0; r < g48N; r++) {
      for (int c = 0; c < g48N; c++) {
        uint8_t e = g48[r][c];
        if (!e) continue;
        int inset = 1;
        if (g48Anim && r == g48SpR && c == g48SpC) {
          inset = 1 + (int)((1.0f - animEase(k)) * (float)(g48CellSz / 2 - 2));
        } else if (g48Anim && g48Pop[r][c]) {
          float tri = (k < 0.5f) ? k * 2.0f : (1.0f - k) * 2.0f;
          inset = 1 - (int)(tri * 2.0f + 0.5f);
        }
        g48DrawTile(x0 + c * g48CellSz, y0 + r * g48CellSz, inset, e);
      }
    }
  }
  ptc(COL_TEXT, 118, 8, "SCORE");
  pt(118, 18, g48Score);
  pt(118, 40, "BEST");
  char val[16];
  fmtBestValue(32, saveBest(32, saveTierOf(g_variant)), val, sizeof(val));
  pt(118, 50, val);
  ptc(COL_ICE, 118, 72, kSpeedTierNames[g_variant & 3]);
}

static void draw2048OverScreen() {
  char big[12];
  snprintf(big, sizeof(big), "%ld", g48Score);
  drawStdOver("NO MOVES LEFT", COL_LASER, big, "points", 32);
}

// --- Minesweeper -----------------------------------------------------------
//
// 10x8 board. A reveals (zeros flood open), B flags, A on a satisfied number
// opens its neighbours. The first reveal is always safe (mines are laid
// after it, away from that cell). Score = seconds taken on a win (lower is
// better); a loss is worst-case and records nothing. Tiers change the mine
// count: NORMAL 10, SPEED 16, CHILL 6, EXTREME 22.

#define MS_W 10
#define MS_H 8
#define MS_CELLS (MS_W * MS_H)
// Landscape (160x128): 13px cells -> 130x104 board centred, one-line HUD strip above.
#define MS_CELL 13
#define MS_X0 15
#define MS_Y0 20
#define MS_MINE 1
#define MS_OPEN 2
#define MS_FLAG 4
static uint8_t msGrid[MS_CELLS];
static int msMines, msCx, msCy, msRevealed, msFlags;
static bool msFirst, msHit, msWon, msShowAll;
static unsigned long msElapsedMs, msRepAtMs;
static unsigned long msRevT[MS_CELLS]; // when each cell becomes visible (ripple reveal)
static unsigned long msRevBase = 0;

static int msNeighbors(int x, int y) {
  int n = 0;
  for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++) {
      int nx = x + dx, ny = y + dy;
      if ((dx || dy) && nx >= 0 && nx < MS_W && ny >= 0 && ny < MS_H &&
          (msGrid[ny * MS_W + nx] & MS_MINE))
        n++;
    }
  return n;
}

static int msFlagsAround(int x, int y) {
  int n = 0;
  for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++) {
      int nx = x + dx, ny = y + dy;
      if ((dx || dy) && nx >= 0 && nx < MS_W && ny >= 0 && ny < MS_H &&
          (msGrid[ny * MS_W + nx] & MS_FLAG))
        n++;
    }
  return n;
}

// Opens one cell (and floods outward from zeros). Sets msHit on a mine.
static void msOpen(int sx, int sy) {
  uint8_t stack[MS_CELLS];
  int sp = 0;
  uint8_t& s0 = msGrid[sy * MS_W + sx];
  if (s0 & (MS_OPEN | MS_FLAG)) return;
  s0 |= MS_OPEN;
  msRevBase = millis();
  msRevT[sy * MS_W + sx] = msRevBase;
  if (s0 & MS_MINE) { msHit = true; return; }
  msRevealed++;
  if (msNeighbors(sx, sy) == 0) stack[sp++] = (uint8_t)(sy * MS_W + sx);
  while (sp > 0) {
    int idx = stack[--sp];
    int x = idx % MS_W, y = idx / MS_W;
    for (int dy = -1; dy <= 1; dy++)
      for (int dx = -1; dx <= 1; dx++) {
        int nx = x + dx, ny = y + dy;
        if (nx < 0 || nx >= MS_W || ny < 0 || ny >= MS_H) continue;
        uint8_t& c = msGrid[ny * MS_W + nx];
        if (c & (MS_OPEN | MS_FLAG | MS_MINE)) continue;
        c |= MS_OPEN;
        msRevealed++;
        msRevT[ny * MS_W + nx] = msRevBase + 40UL * (unsigned long)(max(abs(nx - sx), abs(ny - sy)));
        if (msNeighbors(nx, ny) == 0) stack[sp++] = (uint8_t)(ny * MS_W + nx);
      }
  }
}

// Seeded cell order (built in enterMinePlaying): mines are the first msMines cells of
// it outside the first click's 3x3 zone, so a seed + first click always gives one board.
static uint8_t msOrder[MS_CELLS];
// Level-creator board: 1 = mine. msHasCustom replaces the seeded placement.
static uint8_t msCustom[MS_CELLS];
static bool msHasCustom = false;

static void mineLoadCustom(const LevelData *lvl) {
  memset(msCustom, 0, sizeof(msCustom));
  int n = 0;
  for (int r = 0; r < lvl->h && r < MS_H; r++)
    for (int c = 0; c < lvl->w && c < MS_W; c++)
      if (lvl->cells[r][c] == 1) { msCustom[r * MS_W + c] = 1; n++; }
  msHasCustom = n > 0;
  if (n > 0) msMines = n;
}

static bool mineValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int n = lvlCountTile(lvl, 1);
  if (n < 1) { snprintf(msg, msgLen, "Need at least 1 mine"); return false; }
  if (n > lvl->w * lvl->h - 9) { snprintf(msg, msgLen, "Too many mines"); return false; }
  return true;
}

static void msPlaceMines(int safeX, int safeY) {
  if (msHasCustom) {
    for (int i = 0; i < MS_CELLS; i++) if (msCustom[i]) msGrid[i] |= MS_MINE;
    int fi = safeY * MS_W + safeX;
    if (msGrid[fi] & MS_MINE) {   // first click is always safe: move that one mine to the first free cell
      for (int i = 0; i < MS_CELLS; i++)
        if (!(msGrid[i] & MS_MINE)) { msGrid[i] |= MS_MINE; break; }
      msGrid[fi] &= (uint8_t)~MS_MINE;
    }
    return;
  }
  int placed = 0;
  for (int k = 0; k < MS_CELLS && placed < msMines; k++) {
    int idx = msOrder[k];
    int x = idx % MS_W, y = idx / MS_W;
    if (abs(x - safeX) <= 1 && abs(y - safeY) <= 1) continue;
    msGrid[idx] |= MS_MINE;
    placed++;
  }
}

static void enterMineTitle() {
  gameState = ST_MINE_TITLE;
  drawStdTitle("MINESWEEPER", COL_LASER, "D-pad: move  A: open", "B: flag a mine",
               "Score: fastest time", 33);
}

static void enterMinePlaying() {
  s_mazeRng = gameSeed();
  for (int i = 0; i < MS_CELLS; i++) msOrder[i] = (uint8_t)i;
  for (int i = MS_CELLS - 1; i > 0; i--) {   // Fisher-Yates with the seeded RNG
    int j = mazeRngRange(i + 1);
    uint8_t t = msOrder[i]; msOrder[i] = msOrder[j]; msOrder[j] = t;
  }
  memset(msGrid, 0, sizeof(msGrid));
  memset(msRevT, 0, sizeof(msRevT));
  switch (g_variant & 3) {
    case 1: msMines = 16; break;  // Speed
    case 2: msMines = 6; break;   // Chill
    case 3: msMines = 22; break;  // Extreme
    default: msMines = 10; break;
  }
  msHasCustom = false;
  if (s_lvlActiveSlot[LVLGAME_MINE] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_MINE, s_lvlActiveSlot[LVLGAME_MINE], &lvl)) mineLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_MINE] = -1;
  }
  msCx = MS_W / 2;
  msCy = MS_H / 2;
  msRevealed = 0;
  msFlags = 0;
  msFirst = true;
  msHit = false;
  msWon = false;
  msShowAll = false;
  msElapsedMs = 0;
  msRepAtMs = 0;
  s_lastFrameMs = 0;
  gameState = ST_MINE_PLAYING;
}

static void drawMineScene() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_TEXT, 4, 6, "MINES ");
  canvas->print(msMines - msFlags);
  pt(112, 6, "TIME ");
  canvas->print((int)(msElapsedMs / 1000));
  ptc(COL_ICE, 62, 6, kSpeedTierNames[g_variant & 3]);
  canvas->setTextColor(COL_TEXT);
  uint16_t numCol[9] = {COL_FLOOR, COL_BLUE, COL_BOOST, COL_LASER, COL_TELE_A,
                        COL_ORANGE, COL_TELE_B, COL_KEY, COL_TEXT};
  unsigned long msDrawNow = millis();
  for (int y = 0; y < MS_H; y++) {
    for (int x = 0; x < MS_W; x++) {
      uint8_t f = msGrid[y * MS_W + x];
      int px = MS_X0 + x * MS_CELL, py = MS_Y0 + y * MS_CELL;
      bool open = (f & MS_OPEN) || (msShowAll && (f & MS_MINE));
      unsigned long msRt = msRevT[y * MS_W + x];
      long msAge = (msRt != 0 && (f & MS_OPEN)) ? (long)(msDrawNow - msRt) : 1000;
      if (msAge < 0) open = false; // ripple hasn't reached this cell yet
      if (!open) {
        canvas->fillRect(px, py, MS_CELL - 1, MS_CELL - 1, COL_WALL);
        if (f & MS_FLAG) {
          canvas->fillRect(px + 3, py + 3, 6, 4, COL_LASER);
          canvas->fillRect(px + 5, py + 7, 2, 4, COL_TEXT);
        }
        continue;
      }
      canvas->fillRect(px, py, MS_CELL - 1, MS_CELL - 1,
                       msAge < 130 ? animBlend(COL_FLOOR, 0xFFFF, (uint8_t)(200 - msAge * 200 / 130)) : COL_FLOOR);
      if (f & MS_MINE) {
        canvas->fillCircle(px + 6, py + 6, 3, COL_LASER);
      } else {
        int n = msNeighbors(x, y);
        if (n > 0) {
          ptc(numCol[n], px + 4, py + 3, n);
        }
      }
    }
  }
  canvas->drawRect(MS_X0 + msCx * MS_CELL - 1, MS_Y0 + msCy * MS_CELL - 1, MS_CELL + 1,
                   MS_CELL + 1, COL_PLAYER);
  canvas->drawRect(MS_X0 + msCx * MS_CELL, MS_Y0 + msCy * MS_CELL, MS_CELL - 1, MS_CELL - 1,
                   COL_PLAYER);
}

static void drawMineOverScreen() {
  if (msWon) {
    char big[12];
    snprintf(big, sizeof(big), "%lds", (long)(msElapsedMs / 1000 > 0 ? msElapsedMs / 1000 : 1));
    drawStdOver("FIELD CLEARED", COL_GOAL, big, "lower time is better", 33);
  } else {
    drawStdOver("BOOM!", COL_LASER, "LOST", "stepped on a mine", 33);
  }
}

// --- Road Cross (Frogger-style) --------------------------------------------
//
// 13x9 grid of 12px cells. Bottom row is the start, rows 5-7 are roads
// (cars; touching one costs a life), row 4 is a safe median, rows 1-3 are a
// river (you must ride the logs or you drown) and row 0 is the goal. Score =
// successful crossings; each crossing nudges traffic faster. 3 lives.
// Tiers scale traffic speed (EXTREME also has shorter logs, denser cars).

// Portrait (128x160): 10 columns of 12px across, 9 lanes of 16px down (the lanes
// are just taller; the lane logic is unchanged).
#define RC_COLS 10
#define RC_ROWS 9
#define RC_CELL 12
#define RC_CELLH 16
#define RC_X0 4
#define RC_Y0 16
#define RC_PX_W (RC_COLS * RC_CELL)
static int rcSpace[RC_ROWS], rcW[RC_ROWS], rcN[RC_ROWS];
static float rcSpeed[RC_ROWS], rcBase[RC_ROWS];
static float rcMul, rcFx;
static int rcRow, rcLives, rcScore;
static long rcTenths;   // course time in tenths of a second, rounded once when the course is cleared
static float rcTime;   // seconds of actual play this run (pauses and death freezes excluded)
static unsigned long rcFreezeUntilMs;
static bool rcNeedReset;
// Lane kinds (row 0 = goal ... row 8 = start): 0 safe, 1 road (cars), 2 river (logs).
static uint8_t rcKind[RC_ROWS] = {0, 2, 2, 2, 0, 1, 1, 1, 0};
// Level-creator course: per-lane tile (0 safe, 1/2 road, 3/4 fast road, 5/6 river; odd = drifts left).
static bool rcCustom = false, rcCrossed = false;
static uint8_t rcCustTile[RC_ROWS];

static bool roadValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  if (lvl->w < RC_ROWS) { snprintf(msg, msgLen, "Need all 9 lanes"); return false; }
  if (lvl->cells[0][0] != 0 || lvl->cells[0][RC_ROWS - 1] != 0) {
    snprintf(msg, msgLen, "Start and goal: Safe");
    return false;
  }
  int haz = 0;
  for (int c = 0; c < RC_ROWS; c++)
    if (lvl->cells[0][c] != 0) haz++;
  if (haz < 2) { snprintf(msg, msgLen, "Need 2+ hazard lanes"); return false; }
  return true;
}

static void roadLoadCustom(const LevelData *lvl) {
  for (int c = 0; c < RC_ROWS; c++) {   // editor column 0 = start = bottom row 8
    uint8_t t = (c < lvl->w) ? lvl->cells[0][c] : 0;
    rcCustTile[RC_ROWS - 1 - c] = t > 6 ? 0 : t;
  }
  rcCustTile[0] = 0;
  rcCustTile[RC_ROWS - 1] = 0;
  rcCustom = true;
  rcCrossed = false;
}

static float rcObjX(int row, int i) {
  float ring = (float)(rcN[row] * rcSpace[row]);
  float p = rcBase[row] + (float)(i * rcSpace[row]);
  if (p >= ring) p -= ring;
  return p - (float)rcW[row];
}

static void rcSetLane(int row, int w, int space, float speed) {
  rcW[row] = w;
  rcSpace[row] = space;
  rcSpeed[row] = speed;
  rcN[row] = (RC_PX_W + w + space - 1) / space;
  rcBase[row] = (float)mazeRngRange(rcN[row] * space);
}

static void rcResetFrog() {
  rcRow = RC_ROWS - 1;
  rcFx = (float)(RC_COLS / 2 * RC_CELL);
}

// Index of the log under the frog's centre on a river row, or -1.
static int rcLogUnder(float cx) {
  for (int i = 0; i < rcN[rcRow]; i++) {
    float x = rcObjX(rcRow, i);
    if (cx >= x && cx < x + rcW[rcRow]) return i;
  }
  return -1;
}

static bool rcFrogDead() {
  if (rcKind[rcRow] == 1) {
    for (int i = 0; i < rcN[rcRow]; i++) {
      float x = rcObjX(rcRow, i);
      if (rcFx + 2 < x + rcW[rcRow] - 1 && rcFx + 10 > x + 1) return true;
    }
  } else if (rcKind[rcRow] == 2) {
    float cx = rcFx + 6;
    if (cx < 0 || cx >= RC_PX_W) return true;
    if (rcLogUnder(cx) < 0) return true;
  }
  return false;
}

static void enterRoadTitle() {
  gameState = ST_ROAD_TITLE;
  drawStdTitle("ROAD CROSS", COL_BOOST, "D-pad: hop", "Dodge cars, ride logs", "3 lives, cross often",
               34);
}

static void enterRoadPlaying() {
  if (portraitGate(enterRoadPlaying, enterRoadTitle)) return;
  s_mazeRng = gameSeed();
  int logW = 36, carGap = 0;
  switch (g_variant & 3) {
    case 1: rcMul = 1.35f; break;                           // Speed
    case 2: rcMul = 0.7f; break;                            // Chill
    case 3: rcMul = 1.7f; logW = 24; carGap = 12; break;    // Extreme
    default: rcMul = 1.0f; break;
  }
  memset(rcSpace, 0, sizeof(rcSpace));
  memset(rcW, 0, sizeof(rcW));
  memset(rcN, 0, sizeof(rcN));
  memset(rcSpeed, 0, sizeof(rcSpeed));
  memset(rcBase, 0, sizeof(rcBase));
  rcSetLane(1, logW, 84, -20.0f);
  rcSetLane(2, logW, 72, 28.0f);
  rcSetLane(3, logW, 90, -18.0f);
  rcSetLane(5, 12, 70 - carGap, 34.0f);
  rcSetLane(6, 24, 96 - carGap, -26.0f);
  rcSetLane(7, 12, 58 - carGap, 46.0f);
  static const uint8_t kRcDefKind[RC_ROWS] = {0, 2, 2, 2, 0, 1, 1, 1, 0};
  memcpy(rcKind, kRcDefKind, sizeof(rcKind));
  rcCustom = false;
  rcCrossed = false;
  if (s_lvlActiveSlot[LVLGAME_ROAD] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_ROAD, s_lvlActiveSlot[LVLGAME_ROAD], &lvl)) roadLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_ROAD] = -1;
  }
  if (rcCustom) {   // rebuild every lane from the hand-made course
    memset(rcSpace, 0, sizeof(rcSpace));
    memset(rcW, 0, sizeof(rcW));
    memset(rcN, 0, sizeof(rcN));
    memset(rcSpeed, 0, sizeof(rcSpeed));
    memset(rcBase, 0, sizeof(rcBase));
    for (int r = 0; r < RC_ROWS; r++) {
      uint8_t t = rcCustTile[r];
      int j = r % 3;
      rcKind[r] = (t == 0) ? 0 : (t <= 4) ? 1 : 2;
      float dir = (t & 1) ? -1.0f : 1.0f;     // odd tiles drift left
      if (t >= 1 && t <= 4) {
        bool fast = t >= 3;
        rcSetLane(r, (r & 1) ? 24 : 12, (fast ? 58 : 72) + j * 12 - carGap, dir * ((fast ? 46.0f : 28.0f) + j * 4.0f));
      } else if (t >= 5) {
        rcSetLane(r, logW, 72 + j * 9, dir * (18.0f + j * 5.0f));
      }
    }
  }
  rcLives = 3;
  rcScore = 0;
  rcTime = 0;
  rcTenths = 0;
  rcResetFrog();
  rcFreezeUntilMs = 0;
  rcNeedReset = false;
  s_lastFrameMs = 0;
  gameState = ST_ROAD_PLAYING;
}

static void rcFillClipped(float x, int w, int row, int inset, uint16_t col) {
  int x1 = (int)x, x2 = (int)x + w;
  if (x1 < 0) x1 = 0;
  if (x2 > RC_PX_W) x2 = RC_PX_W;
  if (x2 > x1)
    canvas->fillRect(RC_X0 + x1, RC_Y0 + row * RC_CELLH + inset, x2 - x1, RC_CELLH - 2 * inset, col);
}

static void drawRoadScene(bool dead) {
  canvas->fillScreen(COL_BG);
  uint16_t grass = arcada.display->color565(20, 90, 30);
  uint16_t water = arcada.display->color565(10, 40, 120);
  uint16_t road = arcada.display->color565(45, 45, 50);
  for (int r = 0; r < RC_ROWS; r++) {
    uint16_t c = (rcKind[r] == 2) ? water : (rcKind[r] == 1) ? road : grass;
    canvas->fillRect(RC_X0, RC_Y0 + r * RC_CELLH, RC_PX_W, RC_CELLH, c);
  }
  for (int r = 0; r < RC_ROWS; r++) {
    if (rcKind[r] == 0 || !rcN[r]) continue;
    uint16_t c = (rcKind[r] == 2) ? COL_BOX : (r % 3 == 2) ? COL_LASER : (r % 3 == 0) ? COL_KEY : COL_TELE_B;
    for (int i = 0; i < rcN[r]; i++) rcFillClipped(rcObjX(r, i), rcW[r], r, 2, c);
  }
  int fx = RC_X0 + (int)rcFx + 2, fy = RC_Y0 + rcRow * RC_CELLH + 4;
  canvas->fillRect(fx, fy, 8, 8, dead ? COL_LASER : COL_BOOST);
  if (!dead) {
    canvas->fillRect(fx + 1, fy + 1, 2, 2, COL_TEXT);
    canvas->fillRect(fx + 5, fy + 1, 2, 2, COL_TEXT);
  }
  canvas->setTextSize(1);
  ptc(COL_TEXT, 4, 4, "SCORE ");
  canvas->print(rcScore);
  pt(76, 4, "LIVES ");
  canvas->print(rcLives);
}

static void drawRoadOverScreen() {
  char big[20];
  snprintf(big, sizeof(big), "%d", rcScore);
  if (rcCrossed) {   // custom course: the big number is the time
    snprintf(big, sizeof(big), "%d.%ds", (int)(rcTenths / 10), (int)(rcTenths % 10));
    drawStdOver("CROSSED!", COL_GOAL, big, canvas->width() < 160 ? "lower = better" : "time (lower is better)", 34);
  }
  else drawStdOver("SPLAT!", COL_LASER, big, rcCustom ? "no crossing" : "successful crossings", 34);
}

// --- Maze Chase (Pac-style) ------------------------------------------------
//
// A fixed 20x14 maze (left half stored, mirrored at load). Eat every dot;
// two ghosts alternate scatter (head for their corners, shown blue) and chase
// (red hunts you directly, purple aims two tiles ahead of you). Touching a
// ghost costs a life (3 lives). Clearing the maze refills the dots and speeds
// the ghosts up. Score = dots eaten. Tiers set pac/ghost speed and how long
// the chase phases last.

#define PAC_W 20
#define PAC_H 14
#define PAC_CELL 8
#define PAC_Y0 16
static const char* const kPacRows[PAC_H] = {
    "##########", "#.........", "#.##.####.", "#.##......", "#....##.#.",
    "####.#....", "#....#.##.", "#.##...#..", "#.##.#.#.#", "#....#....",
    "#.####.##.", "#.........", "#.###.###.", "##########",
};
static uint8_t pacGrid[PAC_H][PAC_W]; // 0 empty, 1 wall, 2 dot
static int pacX, pacY, pacDX, pacDY, pacWantDX, pacWantDY;
static int pacGX[2], pacGY[2], pacGDX[2], pacGDY[2];
static int pacDots, pacLives, pacDotsLeft;
static bool pacChase;
static unsigned long pacStepMs, pacGhostMs, pacMoveAt, pacGhostAt, pacModeUntil, pacReadyUntil;
static unsigned long pacScatterMs, pacChaseMs;
static const int8_t kPacDx[4] = {0, -1, 0, 1};
static const int8_t kPacDy[4] = {-1, 0, 1, 0};

static bool pacOpen(int x, int y) {
  return x >= 0 && x < PAC_W && y >= 0 && y < PAC_H && pacGrid[y][x] != 1;
}

// Level-creator maze: the LEFT 10x14 half (mirrored at build time). Tiles: 0 wall, 1 dot,
// 2 empty, 3 player start, 4 ghost start (the second ghost starts at the mirrored cell).
static uint8_t pacCust[PAC_H][PAC_W / 2];   // 1 wall, 2 dot, 0 open
static bool pacCustom = false;
static int pacStartX = 9, pacStartY = 11, pacGhostX = 9, pacGhostY = 5;

static bool pacValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int px = 0, py = 0, gx = 0, gy = 0;
  if (lvlCountTile(lvl, 3) != 1) { snprintf(msg, msgLen, "Need 1 player start"); return false; }
  if (lvlCountTile(lvl, 4) != 1) { snprintf(msg, msgLen, "Need 1 ghost start"); return false; }
  int dots = lvlCountTile(lvl, 1);
  if (dots < 10) { snprintf(msg, msgLen, "Need at least 10 dots"); return false; }
  lvlFindTile(lvl, 3, &px, &py);
  lvlFindTile(lvl, 4, &gx, &gy);
  if (abs(gx - px) + abs(gy - py) <= 3 || abs((PAC_W - 1 - gx) - px) + abs(gy - py) <= 3) {
    snprintf(msg, msgLen, "Ghost too near start");
    return false;
  }
  uint8_t seen[LVL_GRID_MAXW * LVL_GRID_MAXH];
  lvlReachable(lvl, px, py, (1u << 1) | (1u << 2) | (1u << 3) | (1u << 4), seen);
  int got = 0;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++)
      if (lvl->cells[r][c] == 1 && seen[r * LVL_GRID_MAXW + c]) got++;
  if (got < dots) { snprintf(msg, msgLen, "Some dots unreachable"); return false; }
  return true;
}

static void pacLoadCustom(const LevelData *lvl) {
  if (lvlCountTile(lvl, 1) < 1) return;   // a dot-less maze would "clear" every frame: keep the built-in
  int px = 9, py = 11, gx = 9, gy = 5;
  for (int y = 0; y < PAC_H; y++)
    for (int x = 0; x < PAC_W / 2; x++) {
      uint8_t t = (y < lvl->h && x < lvl->w) ? lvl->cells[y][x] : 0;
      uint8_t v = 0;
      if (t == 0) v = 1;
      else if (t == 1) v = 2;
      else if (t == 3) { px = x; py = y; }
      else if (t == 4) { gx = x; gy = y; }
      pacCust[y][x] = v;
    }
  pacStartX = px; pacStartY = py; pacGhostX = gx; pacGhostY = gy;
  pacCustom = true;
}

static void pacBuildMaze() {
  pacDotsLeft = 0;
  for (int y = 0; y < PAC_H; y++)
    for (int x = 0; x < PAC_W / 2; x++) {
      uint8_t v = pacCustom ? pacCust[y][x] : ((kPacRows[y][x] == '#') ? 1 : 2);
      pacGrid[y][x] = v;
      pacGrid[y][PAC_W - 1 - x] = v;
    }
  if (!pacCustom) pacGrid[11][9] = 0; // pac start has no dot
  for (int y = 0; y < PAC_H; y++)
    for (int x = 0; x < PAC_W; x++) if (pacGrid[y][x] == 2) pacDotsLeft++;
}

static void pacResetActors(unsigned long now) {
  pacX = pacStartX; pacY = pacStartY;
  pacDX = pacDY = 0;
  pacWantDX = pacWantDY = 0;
  pacGX[0] = pacGhostX;  pacGY[0] = pacGhostY;
  pacGX[1] = PAC_W - 1 - pacGhostX; pacGY[1] = pacGhostY;
  for (int i = 0; i < 2; i++) pacGDX[i] = pacGDY[i] = 0;
  pacChase = false;
  pacModeUntil = now + 1200 + pacScatterMs;
  pacReadyUntil = now + 1200;
  pacMoveAt = pacGhostAt = now + 1200;
}

static void pacGhostStep(int i) {
  int tx, ty;
  if (pacChase) {
    if (i == 0) { tx = pacX; ty = pacY; }
    else { tx = pacX + 2 * pacDX; ty = pacY + 2 * pacDY; }
  } else {
    tx = (i == 0) ? PAC_W - 2 : 1;
    ty = 1;
  }
  int best = -1;
  long bestD = 0x7FFFFFFF;
  for (int d = 0; d < 4; d++) {
    int dx = kPacDx[d], dy = kPacDy[d];
    if (dx == -pacGDX[i] && dy == -pacGDY[i] && (dx || dy)) continue; // no U-turns
    int nx = pacGX[i] + dx, ny = pacGY[i] + dy;
    if (!pacOpen(nx, ny)) continue;
    long dist = (long)(nx - tx) * (nx - tx) + (long)(ny - ty) * (ny - ty);
    if (dist < bestD) { bestD = dist; best = d; }
  }
  if (best < 0) { // dead end: turn around
    pacGDX[i] = -pacGDX[i];
    pacGDY[i] = -pacGDY[i];
  } else {
    pacGDX[i] = kPacDx[best];
    pacGDY[i] = kPacDy[best];
  }
  if (pacOpen(pacGX[i] + pacGDX[i], pacGY[i] + pacGDY[i])) {
    pacGX[i] += pacGDX[i];
    pacGY[i] += pacGDY[i];
  }
}

static bool pacCaught() {
  for (int i = 0; i < 2; i++) if (pacGX[i] == pacX && pacGY[i] == pacY) return true;
  return false;
}

static void enterPacTitle() {
  gameState = ST_PAC_TITLE;
  drawStdTitle("MAZE CHASE", COL_PLAYER, "D-pad: steer", "Eat every dot", "Avoid the 2 ghosts", 35);
}

static void enterPacPlaying() {
  s_mazeRng = gameSeed(); // the maze is fixed; kept for consistency
  switch (g_variant & 3) {
    case 1: pacStepMs = 130; pacGhostMs = 130; pacScatterMs = 5000; pacChaseMs = 18000; break;
    case 2: pacStepMs = 150; pacGhostMs = 230; pacScatterMs = 7000; pacChaseMs = 10000; break;
    case 3: pacStepMs = 125; pacGhostMs = 105; pacScatterMs = 3000; pacChaseMs = 25000; break;
    default: pacStepMs = 140; pacGhostMs = 175; pacScatterMs = 5000; pacChaseMs = 15000; break;
  }
  pacDots = 0;
  pacLives = 3;
  pacCustom = false;
  pacStartX = 9; pacStartY = 11; pacGhostX = 9; pacGhostY = 5;
  if (s_lvlActiveSlot[LVLGAME_PAC] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_PAC, s_lvlActiveSlot[LVLGAME_PAC], &lvl)) pacLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_PAC] = -1;
  }
  pacBuildMaze();
  pacResetActors(millis());
  gameState = ST_PAC_PLAYING;
}

