        if (pacCaught()) pacDied = true;
      }
      if (!pacDied && pacNow >= pacGhostAt) {
        pacGhostAt = pacNow + pacGhostMs;
        for (int i = 0; i < 2; i++) pacGhostStep(i);
        if (pacCaught()) pacDied = true;
      }
    }

