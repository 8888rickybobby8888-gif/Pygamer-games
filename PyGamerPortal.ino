// Drops the current player's disc in `col` (human or CPU; column not full).
// Returns true if the round ended (game-over screen shown).
static bool c4PlaceDisc(int col) {
  int8_t who = c4Turn;
  int r = c4DropPiece(col, who);
  c4AnimAdd(col, r, millis());
  sfx(who == 2 ? 420 : 500, 40);
  int8_t result = 0;
  if (c4CheckWinAt(r, col, who)) result = who;
  else if (c4BoardFull()) result = 3;
  else {
    c4Turn = (who == 1) ? 2 : 1;
    if (c4VsCpu && c4Turn == 2) c4CpuAt = millis() + 350 + (unsigned long)mazeRngRange(350);
  }
  if (result == 0) return false;
  // let the last disc land before the result screen (short, ends the round)
  unsigned long c4Guard = millis() + 600;
  while (c4AnimBusy() && (long)(c4Guard - millis()) > 0) {
    drawC4Scene();
    drawC4Hud();
    blitScreen();
  }
  c4Winner = result;
  int m = c4VsCpu ? 0 : 1;
  if (result == 3) { c4Sb[m][2]++; sfx(300, 100); }
  else {
    if (result == 1) c4Sb[m][0]++; else c4Sb[m][1]++;
    if (c4VsCpu && result == 2) sfxDeath();
    else { sfxWin(); pixelsWinCelebration(); }
  }
  if (c4VsCpu) {
    long sc = 0;   // hi-score = human wins at this tier this session
    if (result == 1) sc = ++c4TierWins[g_variant & 3];
    recordResult(29, g_variant, sc, true);
  } else {
    c4First = (c4First == 1) ? 2 : 1;   // the other player opens the rematch
  }
  gameState = ST_C4_OVER;
  drawC4OverScreen();
  return true;
}

// --- Tilt Maze -----------------------------------------------------------
//
// Physically tilt the PyGamer to roll a marble across the play field --
// touch a hole and it's game over; reach the goal to score and get a
// fresh, slightly harder layout. Uses the onboard accelerometer (already
// begun by arcadaBegin() in setup()) instead of any button for movement.

// Shared tilt input (Tilt Maze + Tilt Slalom): the LIS3DH's x_g / y_g with Settings "Tilt: Invert" applied.
// Positive ax = roll toward the screen's right edge, positive ay = toward the bottom (as Tilt Maze always did).
static void tiltReadXY(float &ax, float &ay) {
  ax = 0.0f;
  ay = 0.0f;
  if (!arcada.accel) return;
  arcada.accel->read();
  ax = arcada.accel->x_g;
  ay = arcada.accel->y_g;
  if (g_save.miscFlags & 16) { ax = -ax; ay = -ay; }
  uint8_t tg = miscGetField(MF_TILT_SHIFT, 2);   // 0 = Med (default), 1 = Low, 2 = High
  float gm = tg == 1 ? 0.7f : (tg == 2 ? 1.4f : 1.0f);
  ax *= gm;
  ay *= gm;
}

#define TILT_BALL_R 4
#define TILT_GOAL_R 6
#define TILT_MAX_HOLES 6
struct TiltHole { float x, y, r; };
static TiltHole tiltHoles[TILT_MAX_HOLES];
static int tiltHoleCount;
static float tiltBallX, tiltBallY, tiltVX, tiltVY;
static float tiltGoalX, tiltGoalY;
static int tiltScore, tiltBestScore;
static int tiltHoleBase = 3;
static float tiltSensitivityCur = 220.0f;

static void tiltNewLayout() {
  tiltHoleCount = tiltHoleBase + tiltScore / 2;
  if (tiltHoleCount > TILT_MAX_HOLES) tiltHoleCount = TILT_MAX_HOLES;
  float playW = VIEW_COLS * TILE_SIZE, playH = VIEW_ROWS * TILE_SIZE;
  for (int i = 0; i < tiltHoleCount; i++) {
    float hx, hy;
    for (;;) {
      hx = 12 + mazeRngRange((int)playW - 24);
      hy = HUD_HEIGHT + 12 + mazeRngRange((int)playH - 24);
      float dx = hx - tiltBallX, dy = hy - tiltBallY;
      if (dx * dx + dy * dy > 30 * 30) break; // keep clear of the ball's current spot
    }
    tiltHoles[i].x = hx;
    tiltHoles[i].y = hy;
    tiltHoles[i].r = 6;
  }
  for (;;) {
    tiltGoalX = 12 + mazeRngRange((int)playW - 24);
    tiltGoalY = HUD_HEIGHT + 12 + mazeRngRange((int)playH - 24);
    float dx = tiltGoalX - tiltBallX, dy = tiltGoalY - tiltBallY;
    if (dx * dx + dy * dy < 25 * 25) continue;
    bool clearOfHoles = true;
    for (int i = 0; i < tiltHoleCount; i++) {
      float hdx = tiltGoalX - tiltHoles[i].x, hdy = tiltGoalY - tiltHoles[i].y;
      if (hdx * hdx + hdy * hdy < 16 * 16) {
        clearOfHoles = false;
        break;
      }
    }
    if (clearOfHoles) break;
  }
}

// Level editor hook: tile ids are 0=Floor, 1=Hole, 2=Goal, 3=Start. The
// editor grid is VIEW_COLS x VIEW_ROWS cells of TILE_SIZE (16px) each --
// Tilt Maze has no walls (its physics only knows the ball, holes and the
// goal, all free-floating circles) so a custom level places hole/goal/
// start positions on that coarse grid instead of inventing wall collision
// this game doesn't have.
static void tiltLoadCustom(const LevelData *lvl) {
  tiltHoleCount = 0;
  tiltBallX = TILE_SIZE / 2.0f;
  tiltBallY = HUD_HEIGHT + TILE_SIZE / 2.0f;
  tiltGoalX = tiltBallX;
  tiltGoalY = tiltBallY;
  for (int r = 0; r < lvl->h; r++) {
    for (int c = 0; c < lvl->w; c++) {
      uint8_t t = lvl->cells[r][c];
      if (t == 0) continue;
      float cx = c * TILE_SIZE + TILE_SIZE / 2.0f;
      float cy = HUD_HEIGHT + r * TILE_SIZE + TILE_SIZE / 2.0f;
      if (t == 1 && tiltHoleCount < TILT_MAX_HOLES) {
        tiltHoles[tiltHoleCount].x = cx;
        tiltHoles[tiltHoleCount].y = cy;
        tiltHoles[tiltHoleCount].r = 6;
        tiltHoleCount++;
      } else if (t == 2) {
        tiltGoalX = cx;
        tiltGoalY = cy;
      } else if (t == 3) {
        tiltBallX = cx;
        tiltBallY = cy;
      }
    }
  }
  tiltVX = tiltVY = 0;
}

static bool tiltValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int starts = 0, goals = 0, holes = 0;
  for (int r = 0; r < lvl->h; r++) {
    for (int c = 0; c < lvl->w; c++) {
      uint8_t t = lvl->cells[r][c];
      if (t == 3) starts++;
      else if (t == 2) goals++;
      else if (t == 1) holes++;
    }
  }
  if (starts != 1) { snprintf(msg, msgLen, "Need exactly 1 Start"); return false; }
  if (goals != 1) { snprintf(msg, msgLen, "Need exactly 1 Goal"); return false; }
  if (holes > TILT_MAX_HOLES) { snprintf(msg, msgLen, "Max %d holes", TILT_MAX_HOLES); return false; }
  return true;
}

