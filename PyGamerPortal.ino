// Eased on-screen positions (in cells): the player and boxes glide to their
// logical cell instead of jumping. Far-off values (new level) just snap.
static float sokoVisPX = -10, sokoVisPY = -10;
static float sokoVisBX[SOKO_MAX_BOXES], sokoVisBY[SOKO_MAX_BOXES];
static unsigned long sokoVisAt = 0;
static bool sokoVisInit = false;

static void sokoEase(float& v, int target, float k) {
  float d = (float)target - v;
  if (d > 2.2f || d < -2.2f) { v = (float)target; return; }
  if (d < 0.03f && d > -0.03f) { v = (float)target; return; }
  v += d * k;
}

static void drawSokoScene() {
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  int cell = 14;
  int gx = (VIEW_COLS * TILE_SIZE - sokoW * cell) / 2;
  int gy = HUD_HEIGHT + (VIEW_ROWS * TILE_SIZE - sokoH * cell) / 2;
  for (int r = 0; r < sokoH; r++) {
    for (int c = 0; c < sokoW; c++) {
      int x = gx + c * cell, y = gy + r * cell;
      if (sokoWall[r][c])
        canvas->fillRect(x, y, cell, cell, COL_WALL);
      else
        canvas->fillRect(x, y, cell, cell, sokoTarget[r][c] ? shadeColor(COL_GOAL, 0.35f) : COL_FLOOR);
    }
  }
  unsigned long sokoNow = millis();
  float sokoK = 1.0f - expf(-(float)(sokoNow - sokoVisAt) / 40.0f);
  if (!sokoVisInit || sokoNow - sokoVisAt > 400) sokoK = 1.0f; // first frame / after a pause: snap
  sokoVisAt = sokoNow;
  sokoVisInit = true;
  sokoEase(sokoVisPX, sokoPX, sokoK);
  sokoEase(sokoVisPY, sokoPY, sokoK);
  for (int i = 0; i < sokoBoxCount; i++) {
    sokoEase(sokoVisBX[i], sokoBoxX[i], sokoK);
    sokoEase(sokoVisBY[i], sokoBoxY[i], sokoK);
    int x = gx + (int)(sokoVisBX[i] * cell + 0.5f), y = gy + (int)(sokoVisBY[i] * cell + 0.5f);
    bool onTarget = sokoTarget[sokoBoxY[i]][sokoBoxX[i]];
    canvas->fillRect(x + 1, y + 1, cell - 2, cell - 2, onTarget ? COL_GOAL : COL_BOX);
  }
  canvas->fillCircle(gx + (int)(sokoVisPX * cell + 0.5f) + cell / 2,
                     gy + (int)(sokoVisPY * cell + 0.5f) + cell / 2, cell / 2 - 1, COL_PLAYER);
}

