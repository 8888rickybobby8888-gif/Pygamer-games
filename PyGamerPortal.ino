    if (rcDt > 0.05f) rcDt = 0.05f;
    s_lastFrameMs = rcNow;

    if (rcNow < rcFreezeUntilMs) { // brief "squashed" pause after a death
      drawRoadScene(true);
      blitScreen();
      return;
    }
    if (rcNeedReset) {
      rcNeedReset = false;
      rcResetFrog();
    }

    if (pressed & ARCADA_BUTTONMASK_UP) {
      if (rcRow > 0) { rcRow--; sfx(500, 15); }
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      if (rcRow < RC_ROWS - 1) { rcRow++; sfx(400, 15); }
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      rcFx -= RC_CELL;
      if (rcFx < 0) rcFx = 0;
      sfx(450, 15);
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      rcFx += RC_CELL;
      if (rcFx > RC_PX_W - RC_CELL) rcFx = RC_PX_W - RC_CELL;
      sfx(450, 15);
    }

    rcTime += rcDt;
    if (rcRow == 0 && rcCustom) { // hand-made course: the first crossing clears it (2P score = lives left; the slot record = time)
      rcScore = rcLives;
      rcCrossed = true;
      rcTenths = (long)(rcTime * 10.0f + 0.5f);
      if (rcTenths < 4) rcTenths = 4;
      sfxWin();
      pixelsWinCelebration();
      s_lastNewBest = false;
      lvlRecordRun(LVLGAME_ROAD, rcTenths, false);   // fewer seconds is better
      lvlOnClear(LVLGAME_ROAD);
      if (g_twoPlayerMode) {
        twoPHandleGameEnd(rcScore);
      } else {
        gameState = ST_ROAD_OVER;
        drawRoadOverScreen();
      }
      return;
    }
    if (rcRow == 0) { // made it across
      rcScore++;
      if (rcMul < 3.0f) rcMul += 0.06f;
      sfx(800, 60);
      rcResetFrog();
    }

    // Ride the log under us (found against the pre-move positions), then
    // advance every lane.
    bool carried = false;
    float carryDx = 0;
    if (rcKind[rcRow] == 2 && rcLogUnder(rcFx + 6) >= 0) {
      carried = true;
      carryDx = rcSpeed[rcRow] * rcMul * rcDt;
    }
    for (int r = 0; r < RC_ROWS; r++) {
      if (!rcN[r]) continue;
      float ring = (float)(rcN[r] * rcSpace[r]);
      rcBase[r] += rcSpeed[r] * rcMul * rcDt;
      if (rcBase[r] < 0) rcBase[r] += ring;
      if (rcBase[r] >= ring) rcBase[r] -= ring;
    }
    if (carried) rcFx += carryDx;

    if (rcFrogDead()) {
      rcLives--;
      sfx(120, 150);
      pixelsFlash(255, 0, 0, 80);
      if (rcLives <= 0) {
        drawRoadScene(true);
        blitScreen();
        if (rcCustom) { s_lastNewBest = false; lvlRecordRun(LVLGAME_ROAD, 0, false); }
        else recordResult(34, g_variant, (long)rcScore, true);
        if (g_twoPlayerMode) {
          twoPHandleGameEnd(rcScore);
        } else {
          gameState = ST_ROAD_OVER;
          drawRoadOverScreen();
        }
        return;
      }
      rcFreezeUntilMs = rcNow + 600;
      rcNeedReset = true; // frog respawns once the freeze ends
      drawRoadScene(true);
      blitScreen();
      return;
    }

    drawRoadScene(false);
    blitScreen();
    return;
  }

