// Reads the whole pack once: names / par / offsets, and runs every record through the structural checks and the
// game's own validate function (the preview buffer is the scratch LevelData). Returns false when nothing is usable.
static bool pkTabLoad(uint8_t g) {
  s_pkTabOk = false;
  s_pkCount = 0;
  s_pkLoaded = 0xFF;
  if (!pkProbeFile(g)) return false;
  char path[24];
  pkPath(g, path, sizeof(path));
  File f = arcada.open(path, O_READ);
  if (!f) return false;
  uint8_t h[PK_HDR];
  uint32_t sz = (uint32_t)f.size();
  if (f.read(h, PK_HDR) != PK_HDR) { f.close(); return false; }
  PkTab *t = PKT;
  LevelData *lv = lvlPrevBuf();
  memset(t, 0, sizeof(PkTab));
  for (int i = 0; i < 12; i++) t->title[i] = (h[8 + i] >= 32 && h[8 + i] < 127) ? (char)h[8 + i] : ' ';
  const LevelGameConfig *cfg = &kLevelGames[g];
  uint8_t cnt = h[6];
  uint32_t pos = PK_HDR;
  int n = 0;
  for (; n < cnt; n++) {
    uint8_t rh[PK_REC_HDR];
    if (pos + PK_REC_HDR > sz || !f.seek(pos) || f.read(rh, PK_REC_HDR) != PK_REC_HDR) break;
    int w = rh[0], hh = rh[1];
    if (w < 1 || hh < 1 || w > cfg->w || hh > cfg->h) break;         // unknown record size: later offsets can't be trusted
    uint32_t cells = (uint32_t)w * (uint32_t)hh;
    if (pos + PK_REC_HDR + cells > sz) break;                          // truncated file
    t->off[n] = (uint16_t)pos;
    for (int i = 0; i < 8; i++) t->name[n][i] = lvlNameFix((char)rh[2 + i]);
    t->par[n] = rh[10] > 9 ? 9 : rh[10];
    memset(lv, 0, sizeof(LevelData));
    lv->magic = LVL_MAGIC;
    lv->game = g;
    lv->w = (uint8_t)w;
    lv->h = (uint8_t)hh;
    bool ok = true;
    for (int r = 0; ok && r < hh; r++) {
      if (f.read(lv->cells[r], w) != w) ok = false;
      else for (int c = 0; c < w; c++) if (lv->cells[r][c] >= cfg->numTiles) ok = false;
    }
    if (ok && cfg->validate) {
      char msg[28];
      ok = cfg->validate(lv, msg, sizeof(msg));
    }
    if (ok) t->okMask[n >> 3] |= (uint8_t)(1 << (n & 7));
    pos += PK_REC_HDR + cells;
  }
  f.close();
  s_pkCount = (uint8_t)n;
  s_pkTabOk = n > 0;
  return n > 0;
}

static bool pkOk(int i) { return s_pkTabOk && i >= 0 && i < s_pkCount && ((PKT->okMask[i >> 3] >> (i & 7)) & 1u); }

// Loads record idx of game g into *dst (a full, sanitised LevelData). Structural checks only; callers that
// start play also run the game's validate function.
static bool pkReadRecord(uint8_t g, int idx, LevelData *dst) {
  if (!s_pkTabOk || g >= LVL_NUM_GAMES || idx < 0 || idx >= s_pkCount) return false;
  const LevelGameConfig *cfg = &kLevelGames[g];
  char path[24];
  pkPath(g, path, sizeof(path));
  File f = arcada.open(path, O_READ);
  if (!f) return false;
  uint8_t rh[PK_REC_HDR];
  bool ok = f.seek(PKT->off[idx]) && f.read(rh, PK_REC_HDR) == PK_REC_HDR;
  int w = rh[0], hh = rh[1];
  ok = ok && w >= 1 && hh >= 1 && w <= cfg->w && hh <= cfg->h;
  if (ok) {
    memset(dst, 0, sizeof(LevelData));
    dst->magic = LVL_MAGIC;
    dst->game = g;
    dst->w = (uint8_t)w;
    dst->h = (uint8_t)hh;
    dst->best = LVL_NO_BEST;
    memcpy(dst->name, PKT->name[idx], 8);
    dst->name[8] = 0;
    lvlNameTrim(dst->name);
    for (int r = 0; ok && r < hh; r++) {
      if (f.read(dst->cells[r], w) != w) ok = false;
      else for (int c = 0; c < w; c++) if (dst->cells[r][c] >= cfg->numTiles) ok = false;
    }
  }
  f.close();
  return ok;
}

static void pkSelect(int i) {
  s_pkSel = (uint8_t)i;
  s_pkLoaded = (pkOk(i) && pkReadRecord(s_lvlCurGame, i, lvlPrevBuf())) ? (uint8_t)i : 0xFF;
}

// Loads record idx into the Test-Play work slot and starts the game exactly like Test Play does.
static bool pkLaunch(int idx) {
  uint8_t g = s_lvlCurGame;
  if (g >= LVL_NUM_GAMES) return false;
  const LevelGameConfig *cfg = &kLevelGames[g];
  char msg[28];
  if (!pkOk(idx) || !pkReadRecord(g, idx, &s_lvlWork) || (cfg->validate && !cfg->validate(&s_lvlWork, msg, sizeof(msg)))) {
    s_lvlWork.magic = 0;
    toastShow("Level is invalid");
    sfxBlocked();
    return false;
  }
  s_pkPlayIdx = (uint8_t)idx;
  s_pkSel = (uint8_t)idx;
  s_pkBrowse = false;
  s_lvlTestPlay = false;
  s_lvlPackPlay = true;
  s_lvlClearedNow = false;
  s_pkHint = false;
  s_lvlActiveSlot[g] = LVL_TEMP_SLOT;
  sfx(600, 40);
  cfg->playFn();
  return true;
}

// Back from a played pack level (OVER with B/Select, pause "Back to Packs", title, picker): reopen the list.
static void pkReturn() {
  uint8_t g = s_lvlCurGame;
  s_lvlPackPlay = false;
  if (g < LVL_NUM_GAMES) s_lvlActiveSlot[g] = -1;
  s_lvlClearedNow = false;
  s_fadeSkipOnce = true;
  pkEnter(s_pkPlayIdx, !s_pkTabOk);
}

// Next playable level after the one just played, or back to the list when it was the last.
static bool pkNext(uint8_t g) {
  (void)g;
  for (int k = s_pkPlayIdx + 1; k < s_pkCount; k++)
    if (pkOk(k)) {
      sfx(700, 40);
      if (!pkLaunch(k)) pkReturn();
      return true;
    }
  toastShow("Pack finished");
  sfx(900, 80);
  pkReturn();
  return true;
}

// Every record cleared at least once -> the "Completionist" flag (also re-checked when the list opens).
static void pkCheckFull(uint8_t g) {
  if (!lvlGameHasClear(g) || s_pkCount < 5 || miscGetFlag(MF_ACH_PACK)) return;
  for (int i = 0; i < s_pkCount; i++) if (!pkDone(g, i)) return;
  miscSetFlag(MF_ACH_PACK, true);
  checkAchievements();
}

// The game's clear event during pack play (called from lvlOnClear): remember it and count it.
static void pkOnClear(uint8_t g) {
  if (g != s_lvlCurGame || s_lvlActiveSlot[g] != LVL_TEMP_SLOT || s_lvlClearedNow) return;
  s_lvlClearedNow = true;
  if (!lvlGameHasClear(g)) return;
  bool first = !pkDone(g, s_pkPlayIdx);
  if (first) pkSetDone(g, s_pkPlayIdx);
  jingleStart(JG_WIN);
  toastShow(first ? "Pack level cleared!" : "Cleared again");
  if (first) {
    pkCheckFull(g);
    checkAchievements();
    saveWrite();
  }
}

// Called once per loop() while s_lvlPackPlay: return paths + "next level" after a clear.
static bool pkPlayTick(uint32_t pressed) {
  uint8_t g = s_lvlCurGame;
  uint8_t st = (uint8_t)gameState;
  if (g >= LVL_NUM_GAMES || st == ST_TWOP_RESULTS || st == ST_MIX_INTRO || st == ST_MIX_RESULTS) {   // abandoned some other way
    s_lvlPackPlay = false;
    if (g < LVL_NUM_GAMES) s_lvlActiveSlot[g] = -1;
    return false;
  }
  if (st == ST_GAME_PICKER || st == kLvlTitleState[g]) { pkReturn(); return true; }
  if (st != kLvlOverState[g]) return false;
  if (pressed & (ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_SELECT)) {
    sfx(300, 30);
    pkReturn();
    return true;
  }
  if (s_lvlClearedNow) {
    if (!s_pkHint) { s_pkHint = true; toastShow("A: next level"); }
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) return pkNext(g);
  }
  return false;
}

#define PK_ROW_Y0 24
#define PK_ROW_PITCH 10
#define PK_ROWS 8

static void pkDraw() {
  lvlInitColors();
  uint8_t g = s_lvlCurGame;
  const LevelGameConfig *cfg = &kLevelGames[g];
  const PkTab *t = PKT;
  bool clr = lvlGameHasClear(g);
  uint16_t grey = arcada.display->color565(105, 105, 120);
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_ICE, 4, 2, t->title);
  int done = 0;
  for (int i = 0; i < s_pkCount; i++) if (pkDone(g, i)) done++;
  char cnt[16];
  if (clr) snprintf(cnt, sizeof(cnt), "%d/%d", done, (int)s_pkCount);
  else snprintf(cnt, sizeof(cnt), "%d lvls", (int)s_pkCount);
  ptc(clr && done >= s_pkCount ? COL_GOAL : COL_TEXT, 156 - (int)strlen(cnt) * 6, 2, cnt);
  ptc(COL_TEXT, 4, 12, cfg->title);
  animChase(s_lvlBarY, (float)(PK_ROW_Y0 + (s_pkSel - s_pkTop) * PK_ROW_PITCH), 0.4f);
  canvas->fillRect(6, (int)s_lvlBarY - 1, 104, 10, COL_WALL_NOPORTAL);
  for (int i = 0; i < PK_ROWS; i++) {
    int idx = s_pkTop + i;
    if (idx >= s_pkCount) break;
    int y = PK_ROW_Y0 + i * PK_ROW_PITCH;
    bool ok = pkOk(idx);
    bool sel = idx == s_pkSel;
    if (sel) {
      ptc(COL_ORANGE, 8 + (animPulse(520) * 3) / 255, y, ">");
    }
    canvas->setTextColor(ok ? COL_TEXT : grey);
    char nm[9];
    memcpy(nm, t->name[idx], 8);
    nm[8] = 0;
    lvlNameTrim(nm);
    if (!nm[0]) { nm[0] = '#'; nm[1] = (char)('0' + (idx + 1) / 10 % 10); nm[2] = (char)('0' + (idx + 1) % 10); nm[3] = 0; }
    pt(18, y, nm);
    if (ok) {
      char pb[4] = {'D', (char)('0' + (t->par[idx] % 10)), 0, 0};
      ptc(COL_ICE, 72, y, pb);
      if (clr && pkDone(g, idx)) lvlDrawTick(94, y + 2, COL_GOAL);
    } else {
      pt(72, y, "bad");
    }
  }
  const LevelData *tp = (s_pkLoaded == s_pkSel) ? lvlPrevBuf() : NULL;
  lvlDrawThumb(tp, g, 114, 24, 42, 36);
  char buf[16];
  canvas->setTextColor(COL_TEXT);
  snprintf(buf, sizeof(buf), "%dx%d", tp ? tp->w : cfg->w, tp ? tp->h : cfg->h);
  pt(114, 64, buf);
  if (pkOk(s_pkSel)) {
    snprintf(buf, sizeof(buf), "Diff %d", (int)t->par[s_pkSel]);
    ptc(COL_ICE, 114, 74, buf);
    if (clr && pkDone(g, s_pkSel)) lvlDrawTick(114, 86, COL_GOAL);
  } else {
    ptc(COL_LASER, 114, 74, "Broken");
  }
  ptc(COL_TEXT, 2, 108, "L/R: page   D = difficulty");
  pt(2, 118, "A:play Start:copy B:back");
  blitScreen();
}

// Opens the browser for s_lvlCurGame at record `sel`. reload = read + validate the file again (otherwise the list
// kept in the undo ring is reused, e.g. after playing a level). Falls back to the plain Levels menu on any problem.
static void pkEnter(int sel, bool reload) {
  uint8_t g = s_lvlCurGame;
  lvlMenuRefresh();                 // slot cache (free slots for "copy"); never touches the list buffer
  if (g >= LVL_NUM_GAMES || (reload && !pkTabLoad(g)) || !s_pkTabOk) {
    s_pkAvail = false;
    toastShow("Pack unreadable");
    lvlLeaveToMenu();
    return;
  }
  if (sel < 0 || sel >= s_pkCount) sel = 0;
  s_pkTop = (uint8_t)(sel >= PK_ROWS ? sel - PK_ROWS + 1 : 0);
  s_lvlBarY = (float)(PK_ROW_Y0 + (sel - s_pkTop) * PK_ROW_PITCH);
  s_pkBrowse = true;
  s_lvlPackPlay = false;
  s_lvlShowSummary = false;
  s_lvlSub = -1;
  s_lvlPrevSlot = -1;
  s_lvlPrevFail = -1;
  pkSelect(sel);
  pkCheckFull(g);
  gameState = ST_LEVEL_MENU;
  pkDraw();
}

// Start: copy the highlighted record into the first free custom slot (the same atomic save the editor uses).
static void pkCopySel() {
  uint8_t g = s_lvlCurGame;
  if (s_pkLoaded != s_pkSel) { toastShow("Level is invalid"); sfxBlocked(); return; }
  int dst = -1;
  for (int s = 0; s < LVL_SLOTS && dst < 0; s++) if (!(s_lvlUsedMask & (1 << s))) dst = s;
  if (dst < 0) { toastShow("No free slot"); sfxBlocked(); return; }
  LevelData *lv = lvlPrevBuf();
  lv->verified = 0;
  lv->best = LVL_NO_BEST;
  if (!lvlSaveSlot(g, (uint8_t)dst, lv)) { errToast(204); sfx(150, 150); return; }
  s_lvlUsedMask |= (uint8_t)(1 << dst);          // keep the Levels-menu slot cache in step
  s_lvlVerMask &= (uint8_t)~(1 << dst);
  memcpy(s_lvlSlotName[dst], lv->name, LVL_NAME_LEN + 1);
  s_lvlSlotBest[dst] = LVL_NO_BEST;
  char sm[28];
  snprintf(sm, sizeof(sm), "Saved to slot %d", dst + 1);
  toastShow(sm);
  sfx(800, 60);
}

static void pkUpdate(uint32_t pressed) {
  int n = s_pkCount;
  int sel = s_pkSel;
  if (n < 1) { s_pkBrowse = false; lvlLeaveToMenu(); return; }
  if (pressed & ARCADA_BUTTONMASK_UP) sel = (sel + n - 1) % n;
  else if (pressed & ARCADA_BUTTONMASK_DOWN) sel = (sel + 1) % n;
  else if (pressed & ARCADA_BUTTONMASK_LEFT) sel = sel - 5 < 0 ? 0 : sel - 5;
  else if (pressed & ARCADA_BUTTONMASK_RIGHT) sel = sel + 5 > n - 1 ? n - 1 : sel + 5;
  else if (pressed & ARCADA_BUTTONMASK_B) {            // Select arrives here as B
    s_pkBrowse = false;
    s_pkTabOk = false;
    s_lvlPrevSlot = -1;                                // the preview buffer was borrowed by the pack list
    s_lvlPrevFail = -1;
    s_lvlMenuSel = 2;
    s_lvlBarY = LVL_ROW_Y0 + 2 * LVL_ROW_PITCH;
    sfx(300, 30);
    drawLvlPickMenu();
    return;
  } else if (pressed & ARCADA_BUTTONMASK_A) {
    pkLaunch(s_pkSel);
    return;
  } else if (pressed & ARCADA_BUTTONMASK_START) {
    pkCopySel();
  }
  if (sel != s_pkSel) {
    if (sel < s_pkTop) s_pkTop = (uint8_t)sel;
    if (sel >= s_pkTop + PK_ROWS) s_pkTop = (uint8_t)(sel - PK_ROWS + 1);
    pkSelect(sel);
    sfxMove();
    s_lvlAnimLast = 0;
  }
  unsigned long now = millis();
  if (now - s_lvlAnimLast >= 33) {                     // ~30 fps repaint from cached data only (no file I/O)
    s_lvlAnimLast = now;
    pkDraw();
  }
}

static void drawLvlPickMenu() {
  if (s_pkBrowse) { pkDraw(); return; }
  lvlInitColors();
  lvlMenuRefresh();
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  int slots[LVL_SLOTS];
  int ns = lvlOccupied(slots);
  bool hasPack = lvlGameHasClear(s_lvlCurGame) && ns >= 2 && !g_twoPlayerMode;
  bool hasPk = s_pkAvail && !g_twoPlayerMode;            // "Browse Packs" (row 2) when /packs/g<game>.pak is valid
  int packRow = hasPack ? (hasPk ? 3 : 2) : -1;          // "Play All Custom"
  int off = 2 + (hasPk ? 1 : 0) + (hasPack ? 1 : 0);
  int n = off + ns;
  if (s_lvlMenuSel >= n) s_lvlMenuSel = n - 1;
  if (s_lvlMenuSel < 0) s_lvlMenuSel = 0;
  if (s_lvlSub >= 0 && !(s_lvlUsedMask & (1 << s_lvlSub))) s_lvlSub = -1;

  if (s_lvlShowSummary) {
    canvas->fillScreen(COL_BG);
    canvas->setTextSize(1);
    ptc(COL_ICE, 4, 2, cfg->title);
    bool all = s_lvlPackCleared >= s_lvlPackTotal && s_lvlPackTotal > 0;
    ptc(all ? COL_GOAL : COL_ORANGE, all ? 30 : 36, 26, all ? "PACK COMPLETE!" : "PACK FINISHED");
    char big[16];
    snprintf(big, sizeof(big), "%d / %d", (int)s_lvlPackCleared, (int)s_lvlPackTotal);
    canvas->setTextSize(3);
    ptc(COL_TEXT, (160 - (int)strlen(big) * 18) / 2, 50, big);
    canvas->setTextSize(1);
    pt(46, 82, "levels cleared");
    for (int k = 0; k < s_lvlPackTotal && k < 8; k++) {
      int x = 80 - s_lvlPackTotal * 7 + k * 14;
      canvas->drawRect(x, 96, 10, 10, COL_ICE);
      if (k < s_lvlPackCleared) lvlDrawTick(x + 2, 99, COL_GOAL);
    }
    canvas->setTextColor(COL_TEXT);
    canvas->setCursor(30, 118);
    animPrompt("A/B: back to levels");
    blitScreen();
    return;
  }

  int previewSlot = -1;
  if (s_lvlSub >= 0) previewSlot = s_lvlSub;
  else if (s_lvlMenuSel >= off) previewSlot = slots[s_lvlMenuSel - off];
  if (previewSlot >= 0 && s_lvlPrevSlot != previewSlot && s_lvlPrevFail != previewSlot) {
    if (lvlLoadSlot(s_lvlCurGame, previewSlot, lvlPrevBuf())) s_lvlPrevSlot = (int8_t)previewSlot;
    else { s_lvlPrevSlot = -1; s_lvlPrevFail = (int8_t)previewSlot; }
  }

  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_ICE, 4, 2, cfg->title);
  canvas->setCursor(4, 12);
  if (s_lvlSub >= 0) {
    char nm[12];
    lvlSlotLabel(s_lvlSub, nm, sizeof(nm));
    canvas->print("SLOT ");
    canvas->print(s_lvlSub + 1);
    canvas->print(": ");
    canvas->print(nm);
  } else {
    canvas->print("LEVELS");
    if (ns >= 2) {
      canvas->setTextColor(COL_TEXT);
      canvas->print("  Sort:");
      canvas->print(kLvlSortNames[s_lvlSort & 3]);
    }
  }
  char cnt[16];
  snprintf(cnt, sizeof(cnt), "%d/%d slots", ns, LVL_SLOTS);
  ptc(ns >= LVL_SLOTS ? COL_ORANGE : COL_TEXT, 156 - (int)strlen(cnt) * 6, 2, cnt);

  // Rows (labels <= 16 chars so they clear the thumbnail column at x=114).
  char labels[9][18];
  int rows;
  int sel;
  if (s_lvlSub >= 0) {
    snprintf(labels[0], 18, "Play");
    snprintf(labels[1], 18, "Edit");
    snprintf(labels[2], 18, ns >= LVL_SLOTS ? "Copy (no space)" : "Copy to free slot");
    snprintf(labels[3], 18, s_lvlDelArm ? "Delete? press A" : "Delete");
    rows = 4;
    sel = s_lvlSubSel;
  } else {
    snprintf(labels[0], 18, "Play Built-in");
    snprintf(labels[1], 18, "Create New");
    if (hasPk) snprintf(labels[2], 18, "Browse Packs");
    if (hasPack) snprintf(labels[packRow], 18, "Play All Custom");
    for (int i = 0; i < ns && i < 5; i++) lvlSlotLabel(slots[i], labels[off + i], 18);
    rows = n;
    sel = s_lvlMenuSel;
  }
  int pitch = rows > 8 ? LVL_ROW_PITCH - 1 : LVL_ROW_PITCH;   // 9 rows (all extras + 5 slots) squeeze in above the footer
  animChase(s_lvlBarY, (float)(LVL_ROW_Y0 + sel * pitch), 0.4f);
  canvas->fillRect(6, (int)s_lvlBarY - 2, 104, pitch, COL_WALL_NOPORTAL);
  for (int i = 0; i < rows; i++) {
    int y = LVL_ROW_Y0 + i * pitch;
    if (i == sel) {
      ptc(COL_ORANGE, 8 + (animPulse(520) * 3) / 255, y, ">");
      canvas->setTextColor(s_lvlSub >= 0 && i == 3 && s_lvlDelArm ? COL_ORANGE : COL_TEXT);
    } else {
      canvas->setTextColor(COL_TEXT);
    }
    pt(18, y, labels[i]);
    if (s_lvlSub < 0 && i >= off) {          // slot row: best + verified tick
      int sl = slots[i - off];
      if (s_lvlSlotBest[sl] != LVL_NO_BEST) {
        char bv[12];
        lvlFmtBest(s_lvlCurGame, s_lvlSlotBest[sl], bv, sizeof(bv));
        bv[5] = 0;
        ptc(COL_ICE, 68, y, bv);
      }
      if (s_lvlVerMask & (1 << sl)) lvlDrawTick(100, y + 2, COL_GOAL);
    }
  }

  // Thumbnail column.
  const LevelData *tp = (previewSlot >= 0 && s_lvlPrevSlot == previewSlot) ? lvlPrevBuf() : NULL;
  lvlDrawThumb(tp, s_lvlCurGame, 114, 28, 42, 36);
  canvas->setTextColor(COL_TEXT);
  char dims[12];
  if (tp) snprintf(dims, sizeof(dims), "%dx%d", tp->w, tp->h);
  else snprintf(dims, sizeof(dims), "%dx%d", cfg->w, cfg->h);
  pt(114, 68, dims);
  if (previewSlot >= 0) {
    char bv[12];
    lvlFmtBest(s_lvlCurGame, s_lvlSlotBest[previewSlot], bv, sizeof(bv));
    ptc(COL_ICE, 114, 78, "Best");
    ptc(COL_TEXT, 114, 87, bv);
    if (s_lvlVerMask & (1 << previewSlot)) lvlDrawTick(114, 98, COL_GOAL);
  }
  ptc(COL_TEXT, 2, 118, s_lvlSub >= 0 ? "Up/Down A:go B:back" : (s_lvlMenuSel >= off && ns >= 2 ? "U/D A:ok B:back L/R:sort" : "Up/Down A:select B:back"));
  blitScreen();
}

static void lvlLeaveToMenu() {
  s_lvlTestPlay = false;
  s_lvlPack = false;
  s_lvlPackPlay = false;
  s_pkBrowse = false;
  s_pkTabOk = false;
  s_lvlCacheGame = 0xFF;
  s_lvlSub = -1;
  s_lvlDelArm = false;
  s_lvlShowSummary = false;
  s_lvlMenuSel = 0;
  s_lvlBarY = LVL_ROW_Y0;
  gameState = ST_LEVEL_MENU;
  drawLvlPickMenu();
}

// Title screens: "Up" (or the game's free button) opens that game's Levels menu.
static void lvlOpenMenu(uint8_t game) {
  s_lvlCurGame = game;
  s_lvlMenuSel = 0;
  s_lvlSub = -1;
  s_lvlDelArm = false;
  s_lvlShowSummary = false;
  s_lvlPack = false;
  s_lvlPackPlay = false;
  s_pkBrowse = false;
  s_pkTabOk = false;
  s_pkProbeGame = 0xFF;             // probe /packs again for this visit
  s_lvlBarY = LVL_ROW_Y0;
  gameState = ST_LEVEL_MENU;
  drawLvlPickMenu();
}

static void lvlEnterEditor(bool fresh) {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  s_lvlCacheGame = 0xFF;            // the undo ring doubles as thumbnail scratch
  s_pkTabOk = false;                // ... and as the pack list
  s_lvlSub = -1;
  lvlLayout(s_lvlCurGame);
  if (fresh) {
    s_lvlUndoN = 0;
    s_lvlRedoOk = false;
    s_lvlDirty = false;
    s_lvlBestStale = false;
    s_lvlCopyMode = false;
    s_lvlCurX = s_lvlCurY = 0;
    s_lvlTool = 0;
    s_lvlBrush = cfg->numTiles > 1 ? 1 : 0;
    if (s_lvlBrush == cfg->defaultTile && cfg->numTiles > 1) s_lvlBrush = (uint8_t)((cfg->defaultTile + 1) % cfg->numTiles);
  }
  if (s_lvlCurX >= cfg->w) s_lvlCurX = cfg->w - 1;
  if (s_lvlCurY >= cfg->h) s_lvlCurY = cfg->h - 1;
  s_lvlStroke = false;
  s_lvlPicked = false;
  s_lvlHeld = false;
  s_lvlSelDown = false;
  s_lvlRepMask = 0;
  s_lvlAnchor = false;
  s_lvlPrevA = false;
  s_lvlBSwallow = false;
  s_lvlNeedRelease = true;          // ignore buttons still held from the previous screen
  if (!s_lvlHintShown) { s_lvlHintShown = true; s_lvlHintUntilMs = millis() + 2000; }
  gameState = ST_LEVEL_EDITOR;
}

// ---- editor drawing ----
static int lvlBarPx(int t) { return 3 + t * 80 / lvlBarMax(kLevelGames[s_lvlCurGame].numTiles); }   // height-bar view: pixel height of height t

// On-screen rectangle of grid cell (x,y) in the editor view (the whole column for height bars).
static void lvlCellRect(int x, int y, int *rx, int *ry, int *rw, int *rh) {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  *rx = s_lvlGx + x * s_lvlCw;
  *rw = s_lvlCw;
  if (cfg->flags & LVLF_HBARS) { *ry = 14; *rh = LVL_BAR_BASE + 2 - 14; }
  else { *ry = s_lvlGy + y * s_lvlCh; *rh = s_lvlCh; }
}

// Preview of a tool cell: the brush colour (or just an outline for the copy region).
static void lvlOverlayCell(int x, int y, bool outlineOnly) {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  int rx, ry, rw, rh;
  lvlCellRect(x, y, &rx, &ry, &rw, &rh);
  int gap = (s_lvlCw >= 6 && s_lvlCh >= 6) ? 1 : 0;
  if (cfg->flags & LVLF_HBARS) {
    int bt = s_lvlBrush <= 8 ? s_lvlBrush : 0;
    int hp = lvlBarPx(bt);
    if (outlineOnly) canvas->drawRect(rx, ry, rw - gap, rh, COL_ICE);
    else {
      canvas->fillRect(rx, LVL_BAR_BASE + 1 - hp, rw - gap, hp, cfg->tileColors[s_lvlBrush]);
      canvas->drawRect(rx, LVL_BAR_BASE + 1 - hp, rw - gap, hp, COL_TEXT);
    }
    return;
  }
  if (outlineOnly) {
    canvas->drawRect(rx, ry, rw - gap, rh - gap, COL_ICE);
  } else {
    canvas->fillRect(rx, ry, rw - gap, rh - gap, cfg->tileColors[s_lvlBrush]);
    if (rw >= 5 && rh >= 5) canvas->drawRect(rx, ry, rw - gap, rh - gap, COL_TEXT);
  }
}

// mode 0 = draw preview, 1 = write the brush into the work grid, 2 = outline preview (copy region)
static void lvlShapeCell(int x, int y, uint8_t mode) {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  if (x < 0 || y < 0 || x >= cfg->w || y >= cfg->h) return;
  if (mode == 1) s_lvlWork.cells[y][x] = s_lvlBrush;
  else lvlOverlayCell(x, y, mode == 2);
}

// kind: 1 line, 2 rectangle outline, 3 filled rectangle.
static void lvlShape(int kind, int ax, int ay, int bx, int by, uint8_t mode) {
  if (kind == 1) {   // Bresenham
    int dx = bx > ax ? bx - ax : ax - bx;
    int dy = -(by > ay ? by - ay : ay - by);
    int sx = ax < bx ? 1 : -1, sy = ay < by ? 1 : -1;
    int err = dx + dy;
    for (int guard = 0; guard < 64; guard++) {
      lvlShapeCell(ax, ay, mode);
      if (ax == bx && ay == by) break;
      int e2 = 2 * err;
      if (e2 >= dy) { err += dy; ax += sx; }
      if (e2 <= dx) { err += dx; ay += sy; }
    }
    return;
  }
  int x0 = ax < bx ? ax : bx, x1 = ax < bx ? bx : ax;
  int y0 = ay < by ? ay : by, y1 = ay < by ? by : ay;
  for (int y = y0; y <= y1; y++)
    for (int x = x0; x <= x1; x++)
      if (kind == 3 || x == x0 || x == x1 || y == y0 || y == y1) lvlShapeCell(x, y, mode);
}

static void drawLevelEditor() {
  lvlInitColors();
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  unsigned long now = millis();
  bool bars = (cfg->flags & LVLF_HBARS) != 0;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_ICE, 2, 1, cfg->title);
  if (s_lvlDirty) {                 // unsaved-changes marker
    ptc(((now / 400) & 1) ? COL_ORANGE : COL_TEXT, 90, 1, "*");
  }
  if (s_lvlWork.verified) {
    ptc(COL_GOAL, 100, 1, "VERIFIED");
    lvlDrawTick(150, 2, COL_GOAL);
  } else {
    ptc(COL_TEXT, 130, 1, "EDIT");
  }

  int gx = s_lvlGx, gy = s_lvlGy, cw = s_lvlCw, ch = s_lvlCh;
  int gap = (cw >= 6 && ch >= 6) ? 1 : 0;
  if (bars) {
    for (int c = 0; c < cfg->w; c++) {
      uint8_t t = s_lvlWork.cells[0][c];
      if (t >= cfg->numTiles) t = cfg->defaultTile;
      int hp = lvlBarPx(lvlBarT(&s_lvlWork, c));
      canvas->fillRect(gx + c * cw, LVL_BAR_BASE + 1 - hp, cw - gap, hp, cfg->tileColors[t]);
    }
    canvas->drawFastHLine(gx, LVL_BAR_BASE + 1, cfg->w * cw, COL_WALL_NOPORTAL);
  } else {
    for (int r = 0; r < cfg->h; r++) {
      for (int c = 0; c < cfg->w; c++) {
        uint8_t t = s_lvlWork.cells[r][c];
        if (t >= cfg->numTiles) t = cfg->defaultTile;
        canvas->fillRect(gx + c * cw, gy + r * ch, cw - gap, ch - gap, cfg->tileColors[t]);
      }
    }
    // Grid frame so empty (dark) cells still read as a board.
    canvas->drawRect(gx - 1, gy - 1, cfg->w * cw + 1 + (gap ? 0 : 1), cfg->h * ch + 1 + (gap ? 0 : 1), COL_WALL_NOPORTAL);
  }

  // Live tool preview from the anchor to the cursor.
  bool toolMode = (s_lvlTool != 0 || s_lvlCopyMode);
  if (toolMode && s_lvlAnchor) {
    if (s_lvlCopyMode) lvlShape(2, s_lvlAncX, s_lvlAncY, s_lvlCurX, s_lvlCurY, 2);
    else lvlShape(s_lvlTool, s_lvlAncX, s_lvlAncY, s_lvlCurX, s_lvlCurY, 0);
    int rx, ry, rw, rh;
    lvlCellRect(s_lvlAncX, s_lvlAncY, &rx, &ry, &rw, &rh);
    canvas->drawRect(rx - 1, ry - 1, rw + 1, rh + 1, COL_ORANGE);
  }
  // Blinking cursor outline plus a brush-coloured dot inside it.
  {
    int rx, ry, rw, rh;
    lvlCellRect(s_lvlCurX, s_lvlCurY, &rx, &ry, &rw, &rh);
    uint16_t cc = ((now / 250) & 1) ? COL_TEXT : COL_ORANGE;
    canvas->drawRect(rx - 1, ry - 1, rw + 1, rh + 1, cc);
    if (s_lvlBigCursor) {   // 2 px outline + corner ticks, readable on the small 24x16 cells
      uint16_t tc = ((now / 250) & 1) ? COL_ORANGE : COL_TEXT;
      canvas->drawRect(rx - 2, ry - 2, rw + 3, rh + 3, cc);
      int x1 = rx + rw, y1 = ry + rh;
      canvas->drawFastHLine(rx - 5, ry - 2, 3, tc); canvas->drawFastVLine(rx - 2, ry - 5, 3, tc);
      canvas->drawFastHLine(x1 + 1, ry - 2, 3, tc); canvas->drawFastVLine(x1, ry - 5, 3, tc);
      canvas->drawFastHLine(rx - 5, y1, 3, tc); canvas->drawFastVLine(rx - 2, y1 + 1, 3, tc);
      canvas->drawFastHLine(x1 + 1, y1, 3, tc); canvas->drawFastVLine(x1, y1 + 1, 3, tc);
    }
    if (bars) {
      int bt = s_lvlBrush <= 8 ? s_lvlBrush : 0;
      canvas->fillRect(rx, LVL_BAR_BASE + 1 - lvlBarPx(bt) - 1, rw - gap, 2, cfg->tileColors[s_lvlBrush]);
    } else if (rw >= 8 && rh >= 8) {
      canvas->fillRect(rx + rw / 2 - 2, ry + rh / 2 - 2, 3, 3, cfg->tileColors[s_lvlBrush]);
    }
  }

  // Palette strip: every tile as a chip, active one outlined; scrolls when there are too many.
  {
    int nt = cfg->numTiles;
    int chipW = 14;
    int vis = nt > LVL_PAL_VIS ? LVL_PAL_VIS - 1 : nt;
    if (nt > vis) {
      if (s_lvlPalTop > s_lvlBrush) s_lvlPalTop = s_lvlBrush;
      if (s_lvlBrush >= s_lvlPalTop + vis) s_lvlPalTop = (uint8_t)(s_lvlBrush - vis + 1);
      if (s_lvlPalTop + vis > nt) s_lvlPalTop = (uint8_t)(nt - vis);
    } else {
      s_lvlPalTop = 0;
    }
    int px0 = (160 - vis * chipW) / 2;
    for (int k = 0; k < vis; k++) {
      int i = s_lvlPalTop + k;
      int x = px0 + k * chipW;
      canvas->fillRect(x + 1, 107, chipW - 2, 7, cfg->tileColors[i]);
      if (i == s_lvlBrush) canvas->drawRect(x, 106, chipW, 9, COL_TEXT);
    }
    if (nt > vis) {
      int ex = px0 + vis * chipW + 3;
      canvas->fillTriangle(px0 - 3, 107, px0 - 3, 113, px0 - 8, 110, s_lvlPalTop > 0 ? COL_TEXT : COL_WALL_NOPORTAL);
      canvas->fillTriangle(ex, 107, ex, 113, ex + 5, 110, s_lvlPalTop + vis < nt ? COL_TEXT : COL_WALL_NOPORTAL);
    }
  }

  // Footer: brush swatch + name + tool + cursor coords, or a message.
  canvas->setCursor(2, 118);
  if (now < s_lvlWarnUntilMs) {
    canvas->setTextColor(COL_ORANGE);
    canvas->print(s_lvlWarnMsg);
  } else if (now < s_lvlHintUntilMs) {
    canvas->setTextColor(COL_ICE);
    canvas->print("A paint B erase A+B pick");
  } else {
    canvas->fillRect(2, 118, 7, 7, cfg->tileColors[s_lvlBrush]);
    canvas->drawRect(1, 117, 9, 9, COL_TEXT);
    ptc(COL_TEXT, 14, 118, cfg->tileShortNames[s_lvlBrush]);
    if (toolMode) {
      canvas->setTextColor(COL_ORANGE);
      canvas->setCursor(62, 118);
      if (s_lvlCopyMode) canvas->print(s_lvlAnchor ? "COPY 2" : "COPY 1");
      else canvas->print(kLvlToolNames[s_lvlTool]);
    }
    canvas->setTextColor(COL_TEXT);
    char pos[16];
    snprintf(pos, sizeof(pos), "%d,%d", (s_lvlCurX & 31) + 1, (s_lvlCurY & 31) + 1);
    pt(156 - (int)strlen(pos) * 6, 118, pos);
  }
  blitScreen();
}

// ---- editor operations ----
static void lvlUndoPush() {
  if (s_lvlUndoN >= LVL_UNDO_DEPTH) {
    memmove(s_lvlUndo[0], s_lvlUndo[1], (LVL_UNDO_DEPTH - 1) * LVL_CELLS);
    memmove(s_lvlUndoVer, s_lvlUndoVer + 1, LVL_UNDO_DEPTH - 1);
    memmove(s_lvlUndoDirty, s_lvlUndoDirty + 1, LVL_UNDO_DEPTH - 1);
    s_lvlUndoN = LVL_UNDO_DEPTH - 1;
  }
  s_lvlUndoVer[s_lvlUndoN] = s_lvlWork.verified;
  s_lvlUndoDirty[s_lvlUndoN] = s_lvlDirty;
  s_lvlDirty = true;
  s_lvlBestStale = true;
  s_lvlRedoOk = false;              // any new edit voids Redo
  memcpy(s_lvlUndo[s_lvlUndoN++], s_lvlWork.cells, LVL_CELLS);
  s_lvlWork.verified = 0;           // any grid edit voids the Test Play clear
}

// Drops the newest snapshot if the operation turned out to change nothing.
static void lvlUndoCommit() {
  if (s_lvlUndoN && !memcmp(s_lvlUndo[s_lvlUndoN - 1], s_lvlWork.cells, LVL_CELLS)) {
    s_lvlUndoN--;
    s_lvlWork.verified = s_lvlUndoVer[s_lvlUndoN];
    s_lvlDirty = s_lvlUndoDirty[s_lvlUndoN];   // no-op edit: not unsaved
  }
}

static bool lvlUndoPop(bool restoreDirty = false) {
  if (!s_lvlUndoN) return false;
  s_lvlUndoN--;
  s_lvlDirty = restoreDirty ? s_lvlUndoDirty[s_lvlUndoN] : true;
  memcpy(s_lvlWork.cells, s_lvlUndo[s_lvlUndoN], LVL_CELLS);
  s_lvlWork.verified = s_lvlUndoVer[s_lvlUndoN];
  return true;
}

static void lvlApplyBrush(bool paint) {
  uint8_t t = paint ? s_lvlBrush : kLevelGames[s_lvlCurGame].defaultTile;
  s_lvlWork.cells[s_lvlCurY][s_lvlCurX] = t;
}

static void lvlFillRegion(uint8_t nt) {
  int w = s_lvlWork.w, h = s_lvlWork.h;
  uint8_t old = s_lvlWork.cells[s_lvlCurY][s_lvlCurX];
  if (old == nt) return;
  uint16_t stk[LVL_CELLS];
  int sp = 0;
  s_lvlWork.cells[s_lvlCurY][s_lvlCurX] = nt;
  stk[sp++] = (uint16_t)(s_lvlCurY * LVL_GRID_MAXW + s_lvlCurX);
  static const int8_t dx[4] = {1, -1, 0, 0};
  static const int8_t dy[4] = {0, 0, 1, -1};
  while (sp) {
    int v = stk[--sp];
    int cx = v % LVL_GRID_MAXW, cy = v / LVL_GRID_MAXW;
    for (int k = 0; k < 4; k++) {
      int nx = cx + dx[k], ny = cy + dy[k];
      if (nx < 0 || ny < 0 || nx >= w || ny >= h) continue;
      if (s_lvlWork.cells[ny][nx] != old) continue;
      s_lvlWork.cells[ny][nx] = nt;
      stk[sp++] = (uint16_t)(ny * LVL_GRID_MAXW + nx);
    }
  }
}

static void lvlClearAll() {
  uint8_t def = kLevelGames[s_lvlCurGame].defaultTile;
  for (int r = 0; r < s_lvlWork.h; r++)
    for (int c = 0; c < s_lvlWork.w; c++) s_lvlWork.cells[r][c] = def;
}

static void lvlMirror(bool horizontal) {
  int w = s_lvlWork.w, h = s_lvlWork.h;
  if (horizontal) {
    for (int r = 0; r < h; r++)
      for (int c = 0; c < w / 2; c++) s_lvlWork.cells[r][w - 1 - c] = s_lvlWork.cells[r][c];
  } else {
    for (int r = 0; r < h / 2; r++)
      for (int c = 0; c < w; c++) s_lvlWork.cells[h - 1 - r][c] = s_lvlWork.cells[r][c];
  }
}

// Flip = reverse the whole level (unlike Mirror, which copies one half onto the other).
static void lvlFlip(bool horizontal) {
  int w = s_lvlWork.w, h = s_lvlWork.h;
  if (horizontal) {
    for (int r = 0; r < h; r++)
      for (int c = 0; c < w / 2; c++) {
        uint8_t t = s_lvlWork.cells[r][c];
        s_lvlWork.cells[r][c] = s_lvlWork.cells[r][w - 1 - c];
        s_lvlWork.cells[r][w - 1 - c] = t;
      }
  } else {
    for (int r = 0; r < h / 2; r++)
      for (int c = 0; c < w; c++) {
        uint8_t t = s_lvlWork.cells[r][c];
        s_lvlWork.cells[r][c] = s_lvlWork.cells[h - 1 - r][c];
        s_lvlWork.cells[h - 1 - r][c] = t;
      }
  }
}

// Rotate 90 degrees clockwise (square levels only); reads the undo snapshot taken just before.
static void lvlRotate() {
  int n = s_lvlWork.w;
  if (n != s_lvlWork.h || !s_lvlUndoN) return;
  const uint8_t *src = s_lvlUndo[s_lvlUndoN - 1];
  for (int r = 0; r < n; r++)
    for (int c = 0; c < n; c++)
      s_lvlWork.cells[r][c] = src[(n - 1 - c) * LVL_GRID_MAXW + r];
}

// Copy the rectangle between the anchor and the cursor into the clipboard.
static bool lvlCopyCommit() {
  int x0 = s_lvlAncX < s_lvlCurX ? s_lvlAncX : s_lvlCurX, x1 = s_lvlAncX < s_lvlCurX ? s_lvlCurX : s_lvlAncX;
  int y0 = s_lvlAncY < s_lvlCurY ? s_lvlAncY : s_lvlCurY, y1 = s_lvlAncY < s_lvlCurY ? s_lvlCurY : s_lvlAncY;
  int w = x1 - x0 + 1, h = y1 - y0 + 1;
  if (w * h > LVL_CLIP_MAX) return false;
  for (int r = 0; r < h; r++)
    for (int c = 0; c < w; c++) s_lvlClip[r * w + c] = s_lvlWork.cells[y0 + r][x0 + c];
  s_lvlClipW = (uint8_t)w;
  s_lvlClipH = (uint8_t)h;
  s_lvlClipGame = s_lvlCurGame;
  return true;
}

// Stamp the clipboard with its top-left at the cursor, clipped to the grid.
static void lvlPasteHere() {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  for (int r = 0; r < s_lvlClipH; r++)
    for (int c = 0; c < s_lvlClipW; c++) {
      int x = s_lvlCurX + c, y = s_lvlCurY + r;
      if (x >= cfg->w || y >= cfg->h) continue;
      uint8_t t = s_lvlClip[r * s_lvlClipW + c];
      s_lvlWork.cells[y][x] = t < cfg->numTiles ? t : cfg->defaultTile;
    }
}

static void lvlWarn(const char *msg) {
  strncpy(s_lvlWarnMsg, msg, sizeof(s_lvlWarnMsg) - 1);
  s_lvlWarnMsg[sizeof(s_lvlWarnMsg) - 1] = 0;
  s_lvlWarnUntilMs = millis() + 2200;
}

static void lvlOpenEditorMenu();

static void updateLevelEditor(uint32_t buttons, uint32_t pressed) {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  unsigned long now = millis();
  uint8_t ph = (uint8_t)((now / 250) & 1);
  bool changed = false;

  // Buttons carried in from the previous screen (the A that picked "Edit",
  // a Select hold, ...) must be released before they can paint / open menus.
  if (s_lvlNeedRelease) {
    if (buttons & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_SELECT | ARCADA_BUTTONMASK_START)) {
      if (ph != s_lvlBlinkPh) { s_lvlBlinkPh = ph; drawLevelEditor(); }
      return;
    }
    s_lvlNeedRelease = false;
    s_lvlPrevA = false;
    changed = true;
  }

  // Editor menu: hold Start (same timing as the pause hold) or hold Select.
  bool startDown = (buttons & ARCADA_BUTTONMASK_START) != 0;
  if (startDown && !s_lvlHeld) {
    s_lvlHeld = true;
    s_lvlHeldSinceMs = now;
  } else if (!startDown) {
    s_lvlHeld = false;
  }
  bool selDown = (buttons & ARCADA_BUTTONMASK_SELECT) != 0;
  bool openMenu = (startDown && s_lvlHeld && now - s_lvlHeldSinceMs >= PAUSE_HOLD_MS);
  if (selDown && !s_lvlSelDown) {
    s_lvlSelDown = true;
    s_lvlSelMs = now;
  } else if (selDown && s_lvlSelDown && now - s_lvlSelMs >= LVL_SEL_HOLD_MS) {
    openMenu = true;
  } else if (!selDown && s_lvlSelDown) {   // released before the hold time: a tap
    s_lvlSelDown = false;
    s_lvlBrush = (uint8_t)((s_lvlBrush + 1) % cfg->numTiles);
    sfx(700, 15);
    changed = true;
  }
  if (openMenu) {
    if (s_lvlStroke) { s_lvlStroke = false; lvlUndoCommit(); }
    s_lvlAnchor = false;               // a half-drawn shape / copy never survives the menu
    s_lvlCopyMode = false;
    s_lvlHeld = false;
    s_lvlSelDown = false;
    lvlOpenEditorMenu();
    return;
  }

  // Paint (A) / erase (B) strokes; moving while held drags the brush. With a shape tool (or
  // copy mode) A instead acts on release: first A = anchor, second A = commit; B cancels.
  bool aDown = (buttons & ARCADA_BUTTONMASK_A) != 0;
  bool bDown = (buttons & ARCADA_BUTTONMASK_B) != 0;
  bool toolMode = (s_lvlTool != 0 || s_lvlCopyMode);
  bool aRelease = s_lvlPrevA && !aDown;
  s_lvlPrevA = aDown;
  // A+B together = eyedropper: copy the tile under the cursor into the brush (and undo
  // whatever the first of the two presses just painted); no painting until both are released.
  if (aDown && bDown && !s_lvlPicked) {
    s_lvlPicked = true;
    if (s_lvlStroke) {            // undo the whole stroke (snapshot taken when it started)
      s_lvlStroke = false;
      lvlUndoPop(true);
    }
    uint8_t t = s_lvlWork.cells[s_lvlCurY][s_lvlCurX];
    s_lvlBrush = t < cfg->numTiles ? t : cfg->defaultTile;
    sfx(900, 25);
    changed = true;
  }
  bool wasPicked = s_lvlPicked;
  if (!aDown && !bDown) s_lvlPicked = false;
  if (!bDown) s_lvlBSwallow = false;

  if (toolMode && (pressed & ARCADA_BUTTONMASK_B) && !aDown && (s_lvlAnchor || s_lvlCopyMode)) {
    s_lvlAnchor = false;          // B cancels a pending shape / copy
    s_lvlCopyMode = false;
    s_lvlBSwallow = true;
    sfx(300, 30);
    changed = true;
  }
  if (toolMode && aRelease && !wasPicked) {
    if (!s_lvlAnchor) {
      s_lvlAnchor = true;
      s_lvlAncX = (uint8_t)s_lvlCurX;
      s_lvlAncY = (uint8_t)s_lvlCurY;
      sfx(550, 20);
    } else if (s_lvlCopyMode) {
      s_lvlAnchor = false;
      if (lvlCopyCommit()) {
        s_lvlCopyMode = false;
        char cm[28];
        snprintf(cm, sizeof(cm), "Copied %dx%d", (int)s_lvlClipW, (int)s_lvlClipH);
        lvlWarn(cm);
        sfx(800, 40);
      } else {
        lvlWarn("Region too big (256)");
        sfxBlocked();
      }
    } else {
      s_lvlAnchor = false;
      lvlUndoPush();
      lvlShape(s_lvlTool, s_lvlAncX, s_lvlAncY, s_lvlCurX, s_lvlCurY, 1);
      lvlUndoCommit();
      sfx(650, 30);
    }
    changed = true;
  }

  bool strokeA = aDown && !toolMode;
  bool strokeB = bDown && !s_lvlBSwallow;
  if ((strokeA || strokeB) && !s_lvlStroke && !s_lvlPicked) {
    s_lvlStroke = true;
    s_lvlStrokeA = strokeA;
    lvlUndoPush();
    lvlApplyBrush(strokeA);
    sfx(strokeA ? 500 : 250, 15);
    changed = true;
  } else if (s_lvlStroke && !(s_lvlStrokeA ? aDown : bDown)) {
    s_lvlStroke = false;
    lvlUndoCommit();
  }

  // Cursor movement with hold-to-repeat (250 ms, then every 60 ms).
  const uint32_t dirs = ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN |
                        ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT;
  uint32_t use = 0;
  bool fresh = false;
  uint32_t pd = pressed & dirs;
  if (pd) {
    if (pd & ARCADA_BUTTONMASK_UP) use = ARCADA_BUTTONMASK_UP;
    else if (pd & ARCADA_BUTTONMASK_DOWN) use = ARCADA_BUTTONMASK_DOWN;
    else if (pd & ARCADA_BUTTONMASK_LEFT) use = ARCADA_BUTTONMASK_LEFT;
    else use = ARCADA_BUTTONMASK_RIGHT;
    s_lvlRepMask = use;
    s_lvlRepAt = now + 250;
    fresh = true;
  } else if (s_lvlRepMask) {
    if (!(buttons & s_lvlRepMask)) s_lvlRepMask = 0;
    else if ((long)(now - s_lvlRepAt) >= 0) { use = s_lvlRepMask; s_lvlRepAt = now + 60; }
  }
  if (use) {
    int dx = 0, dy = 0;
    if (use == ARCADA_BUTTONMASK_UP) dy = -1;
    else if (use == ARCADA_BUTTONMASK_DOWN) dy = 1;
    else if (use == ARCADA_BUTTONMASK_LEFT) dx = -1;
    else dx = 1;
    int nx = s_lvlCurX + dx, ny = s_lvlCurY + dy;
    int w = cfg->w, h = cfg->h;
    if (fresh) {          // wraps at the edges on a fresh press, clamps while repeating
      nx = (nx + w) % w;
      ny = (ny + h) % h;
    } else {
      if (nx < 0) nx = 0;
      if (nx >= w) nx = w - 1;
      if (ny < 0) ny = 0;
      if (ny >= h) ny = h - 1;
    }
    if (nx != s_lvlCurX || ny != s_lvlCurY) {
      s_lvlCurX = nx;
      s_lvlCurY = ny;
      if (s_lvlStroke && !s_lvlPicked) lvlApplyBrush(s_lvlStrokeA);
      changed = true;
    }
  }

  if (ph != s_lvlBlinkPh) { s_lvlBlinkPh = ph; changed = true; }
  if (changed) drawLevelEditor();
}

// ---- editor menu (ST_LEVEL_SAVE_MENU) ----
// The menu is a list of ids built when it opens (Rotate only exists for square levels).
enum {
  LEM_RESUME = 0, LEM_TEST, LEM_RENAME, LEM_TOOL, LEM_BRUSH, LEM_COPY, LEM_PASTE, LEM_FILL,
  LEM_CLEAR, LEM_MIRH, LEM_MIRV, LEM_FLIPH, LEM_FLIPV, LEM_ROT, LEM_UNDO, LEM_REDO, LEM_RAND, LEM_CURSOR, LEM_EXIT,
  LEM_SAVE0 = 32
};
#define LVL_EM_ROWS 7

static void lvlEmBuild() {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  int n = 0;
  s_lvlEmIds[n++] = LEM_RESUME;
  s_lvlEmIds[n++] = LEM_TEST;
  for (int s = 0; s < LVL_SLOTS; s++) s_lvlEmIds[n++] = (uint8_t)(LEM_SAVE0 + s);
  s_lvlEmIds[n++] = LEM_RENAME;
  s_lvlEmIds[n++] = LEM_TOOL;
  s_lvlEmIds[n++] = LEM_BRUSH;
  s_lvlEmIds[n++] = LEM_COPY;
  s_lvlEmIds[n++] = LEM_PASTE;
  s_lvlEmIds[n++] = LEM_FILL;
  s_lvlEmIds[n++] = LEM_CLEAR;
  s_lvlEmIds[n++] = LEM_MIRH;
  s_lvlEmIds[n++] = LEM_MIRV;
  s_lvlEmIds[n++] = LEM_FLIPH;
  s_lvlEmIds[n++] = LEM_FLIPV;
  if (cfg->w == cfg->h && cfg->h > 1) s_lvlEmIds[n++] = LEM_ROT;
  s_lvlEmIds[n++] = LEM_UNDO;
  s_lvlEmIds[n++] = LEM_REDO;
  if (s_lvlCurGame == LVLGAME_GEM || s_lvlCurGame == LVLGAME_GAP) s_lvlEmIds[n++] = LEM_RAND;
  s_lvlEmIds[n++] = LEM_CURSOR;
  s_lvlEmIds[n++] = LEM_EXIT;
  s_lvlEmN = (uint8_t)n;
}

static uint32_t s_lvlRng = 1;
static uint32_t lvlRand() { s_lvlRng ^= s_lvlRng << 13; s_lvlRng ^= s_lvlRng >> 17; s_lvlRng ^= s_lvlRng << 5; return s_lvlRng; }

// Gem Swap: random gems with no three-in-a-row to start with. Gap Flyer: random heights, each
// wall within 2 steps of the previous one so the course stays flyable.
static void lvlRandomize() {
  s_lvlRng = (micros() ^ (millis() * 2654435761u)) | 1u;
  int w = s_lvlWork.w, h = s_lvlWork.h;
  if (s_lvlCurGame == LVLGAME_GEM) {
    for (int r = 0; r < h; r++)
      for (int c = 0; c < w; c++) {
        int off = (int)(lvlRand() % 6u);
        uint8_t pick = (uint8_t)off;
        for (int t = 0; t < 6; t++) {
          uint8_t cand = (uint8_t)((off + t) % 6);
          bool bad = (c >= 2 && s_lvlWork.cells[r][c - 1] == cand && s_lvlWork.cells[r][c - 2] == cand) ||
                     (r >= 2 && s_lvlWork.cells[r - 1][c] == cand && s_lvlWork.cells[r - 2][c] == cand);
          if (!bad) { pick = cand; break; }
        }
        s_lvlWork.cells[r][c] = pick;
      }
  } else if (s_lvlCurGame == LVLGAME_GAP) {
    int cur = 3;
    for (int c = 0; c < w; c++) {
      cur += (int)(lvlRand() % 5u) - 2;
      if (cur < 0) cur = 0;
      if (cur > 6) cur = 6;
      s_lvlWork.cells[0][c] = (uint8_t)cur;
    }
  }
}

static bool lvlClipUsable() { return s_lvlClipW > 0 && s_lvlClipGame == s_lvlCurGame; }

static void lvlEmLabel(int idx, char *out, size_t n) {
  int id = s_lvlEmIds[idx];
  if (idx == s_lvlEmArm) snprintf(out, n, id == LEM_EXIT ? "Discard? press A" : "Overwrite? press A");
  else if (id == LEM_RESUME) snprintf(out, n, "Resume");
  else if (id == LEM_TEST) snprintf(out, n, "Test Play");
  else if (id >= LEM_SAVE0) {
    int sl = id - LEM_SAVE0;
    if (s_lvlUsedMask & (1 << sl)) {
      char nm[12];
      lvlSlotLabel(sl, nm, sizeof(nm));
      snprintf(out, n, "Save %d: %s *", sl + 1, nm);
    } else {
      snprintf(out, n, "Save %d: (empty)", sl + 1);
    }
  }
  else if (id == LEM_RENAME) snprintf(out, n, "Rename: %s", s_lvlWork.name[0] ? s_lvlWork.name : "(unnamed)");
  else if (id == LEM_TOOL) snprintf(out, n, "Tool: %s", kLvlToolNames[s_lvlTool & 3]);
  else if (id == LEM_BRUSH) snprintf(out, n, "Brush... %s", kLevelGames[s_lvlCurGame].tileShortNames[s_lvlBrush]);
  else if (id == LEM_COPY) snprintf(out, n, "Copy region");
  else if (id == LEM_PASTE) { if (lvlClipUsable()) snprintf(out, n, "Paste here (%dx%d)", (int)s_lvlClipW, (int)s_lvlClipH); else snprintf(out, n, "Paste here (empty)"); }
  else if (id == LEM_FILL) snprintf(out, n, "Fill region");
  else if (id == LEM_CLEAR) snprintf(out, n, "Clear all");
  else if (id == LEM_MIRH) snprintf(out, n, "Mirror Horizontal");
  else if (id == LEM_MIRV) snprintf(out, n, "Mirror Vertical");
  else if (id == LEM_FLIPH) snprintf(out, n, "Flip Horizontal");
  else if (id == LEM_FLIPV) snprintf(out, n, "Flip Vertical");
  else if (id == LEM_ROT) snprintf(out, n, "Rotate 90");
  else if (id == LEM_UNDO) snprintf(out, n, "Undo (%d)", (int)s_lvlUndoN);
  else if (id == LEM_REDO) snprintf(out, n, "Redo (%d)", s_lvlRedoOk ? 1 : 0);
  else if (id == LEM_RAND) snprintf(out, n, "Randomize");
  else if (id == LEM_CURSOR) snprintf(out, n, "Cursor: %s", s_lvlBigCursor ? "Big" : "Normal");
  else snprintf(out, n, "Discard & Exit");
}

static void drawLevelSaveMenu() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  if (s_lvlEmMode == 2) {            // name picker
    ptc(COL_ORANGE, 38, 4, "RENAME LEVEL");
    bool blink = ((millis() / 350) & 1) != 0;
    for (int i = 0; i < LVL_NAME_LEN; i++) {
      int x = 22 + i * 15;
      bool cur = (i == s_lvlNameCur);
      canvas->drawRect(x, 30, 13, 20, cur ? COL_ORANGE : COL_ICE);
      canvas->setTextSize(2);
      ptc(cur ? COL_TEXT : COL_ICE, x + 1, 33, s_lvlNameBuf[i]);
      canvas->setTextSize(1);
      if (cur && blink) canvas->fillRect(x, 52, 13, 2, COL_ORANGE);
    }
    ptc(COL_TEXT, 4, 70, "Up/Down: change letter");
    pt(4, 80, "Left/Right: move cursor");
    pt(4, 90, "A ok   B cancel");
    canvas->setCursor(4, 104);
    canvas->setTextColor(COL_ICE);
    canvas->print("A-Z 0-9 space and -");
    blitScreen();
    return;
  }
  if (s_lvlEmMode == 1) {            // brush picker
    const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
    ptc(COL_ORANGE, 44, 3, "PICK BRUSH");
    int nt = cfg->numTiles;
    if (s_lvlBrushPick < s_lvlBrushTop) s_lvlBrushTop = s_lvlBrushPick;
    if (s_lvlBrushPick >= s_lvlBrushTop + LVL_EM_ROWS) s_lvlBrushTop = (uint8_t)(s_lvlBrushPick - LVL_EM_ROWS + 1);
    for (int r = 0; r < LVL_EM_ROWS; r++) {
      int i = s_lvlBrushTop + r;
      if (i >= nt) break;
      int y = 16 + r * 13;
      if (i == s_lvlBrushPick) {
        canvas->fillRect(8, y - 2, 138, 12, COL_WALL_NOPORTAL);
        ptc(COL_ORANGE, 12, y, ">");
      }
      canvas->fillRect(26, y, 10, 8, cfg->tileColors[i]);
      canvas->drawRect(25, y - 1, 12, 10, COL_TEXT);
      ptc(COL_TEXT, 42, y, cfg->tileShortNames[i]);
      if (i == s_lvlBrush) { canvas->setCursor(110, y); canvas->setTextColor(COL_ICE); canvas->print("(now)"); }
    }
    canvas->fillTriangle(152, 14, 156, 14, 154, 11, s_lvlBrushTop > 0 ? COL_TEXT : COL_BG);
    canvas->fillTriangle(152, 108, 156, 108, 154, 111, (s_lvlBrushTop + LVL_EM_ROWS < nt) ? COL_TEXT : COL_BG);
    ptc(COL_TEXT, 2, 118, "Up/Down A:pick B:back");
    blitScreen();
    return;
  }
  ptc(COL_ORANGE, 50, 3, "LEVEL MENU");
  if (s_lvlDirty) { canvas->setCursor(112, 3); canvas->print("*"); }
  if (s_lvlWork.verified) lvlDrawTick(122, 3, COL_GOAL);
  uint8_t emOldTop = s_lvlEmTop;
  if (s_lvlMenuSel < (int)s_lvlEmTop) s_lvlEmTop = (uint8_t)s_lvlMenuSel;
  if (s_lvlMenuSel >= (int)s_lvlEmTop + LVL_EM_ROWS) s_lvlEmTop = (uint8_t)(s_lvlMenuSel - LVL_EM_ROWS + 1);
  float emBarTgt = (float)(16 + (s_lvlMenuSel - s_lvlEmTop) * 13);
  if (s_lvlEmTop != emOldTop) s_lvlBarY = emBarTgt;   // list scrolled a page: the bar snaps with it
  animChase(s_lvlBarY, emBarTgt, 0.4f);
  if (fabsf(s_lvlBarY - emBarTgt) < 0.6f) s_lvlBarY = emBarTgt;
  canvas->fillRect(8, (int)s_lvlBarY - 2, 138, 12, COL_WALL_NOPORTAL);
  char lb[28];
  for (int r = 0; r < LVL_EM_ROWS; r++) {
    int i = s_lvlEmTop + r;
    if (i >= s_lvlEmN) break;
    int y = 16 + r * 13;
    lvlEmLabel(i, lb, sizeof(lb));
    if (i == s_lvlMenuSel) {
      ptc(COL_ORANGE, 12 + (animPulse(520) * 3) / 255, y, ">");
    }
    ptc(COL_TEXT, 26, y, lb);
  }
  canvas->fillTriangle(152, 14, 156, 14, 154, 11, s_lvlEmTop > 0 ? COL_TEXT : COL_BG);
  canvas->fillTriangle(152, 108, 156, 108, 154, 111, (s_lvlEmTop + LVL_EM_ROWS < s_lvlEmN) ? COL_TEXT : COL_BG);
  canvas->setCursor(2, 118);
  int selId = s_lvlEmIds[s_lvlMenuSel];
  if (millis() < s_lvlWarnUntilMs) {
    canvas->setTextColor(COL_ORANGE);
    canvas->print(s_lvlWarnMsg);
  } else if (s_lvlFsIsRam && selId >= LEM_SAVE0) {
    canvas->setTextColor(COL_ORANGE);
    canvas->print("No flash found: RAM only!");
  } else {
    canvas->setTextColor(COL_TEXT);
    canvas->print(selId == LEM_TOOL ? "Left/Right/A: next tool" : "Up/Down A:select B:back");
  }
  blitScreen();
}

static void lvlOpenEditorMenu() {
  s_lvlMenuSel = 0;
  s_lvlEmArm = -1;
  s_lvlEmTop = 0;
  s_lvlEmMode = 0;
  s_lvlBarY = 16;
  s_lvlCacheGame = 0xFF;            // reload the slot cache (names / used) for the Save rows
  lvlMenuRefresh();
  lvlEmBuild();
  gameState = ST_LEVEL_SAVE_MENU;
  drawLevelSaveMenu();
}

// Back into the editor from its menu; work and undo stay intact.
static void lvlResumeEditor() {
  lvlEnterEditor(false);
  drawLevelEditor();
}

static bool lvlValidateWork(char *msg, size_t n) {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  return cfg->validate ? cfg->validate(&s_lvlWork, msg, n) : true;
}

static void updateLevelSaveMenu(uint32_t pressed) {
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];

  if (s_lvlEmMode == 2) {            // name picker: Up/Down letter, Left/Right cursor, A ok, B cancel
    if (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN)) {
      const int nc = (int)strlen(kLvlNameChars);
      const char *p = strchr(kLvlNameChars, s_lvlNameBuf[s_lvlNameCur]);
      int k = p ? (int)(p - kLvlNameChars) : 0;
      k = (k + nc + ((pressed & ARCADA_BUTTONMASK_UP) ? -1 : 1)) % nc;
      s_lvlNameBuf[s_lvlNameCur] = kLvlNameChars[k];
      sfx(500 + k * 8, 10);
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      s_lvlNameCur = (uint8_t)((s_lvlNameCur + LVL_NAME_LEN - 1) % LVL_NAME_LEN);
      sfxMove();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      s_lvlNameCur = (uint8_t)((s_lvlNameCur + 1) % LVL_NAME_LEN);
      sfxMove();
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      memcpy(s_lvlWork.name, s_lvlNameBuf, LVL_NAME_LEN);
      s_lvlWork.name[LVL_NAME_LEN] = 0;
      lvlNameTrim(s_lvlWork.name);
      s_lvlDirty = true;
      s_lvlEmMode = 0;
      sfx(800, 40);
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      s_lvlEmMode = 0;
      sfx(300, 30);
    } else {
      static uint8_t lastBlink = 0;           // keep the caret blinking
      uint8_t b = (uint8_t)((millis() / 350) & 1);
      if (b == lastBlink) return;
      lastBlink = b;
    }
    drawLevelSaveMenu();
    return;
  }
  if (s_lvlEmMode == 1) {            // brush picker
    if (pressed & ARCADA_BUTTONMASK_UP) {
      s_lvlBrushPick = (uint8_t)((s_lvlBrushPick + cfg->numTiles - 1) % cfg->numTiles);
      sfxMove();
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      s_lvlBrushPick = (uint8_t)((s_lvlBrushPick + 1) % cfg->numTiles);
      sfxMove();
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      s_lvlBrush = s_lvlBrushPick;
      s_lvlEmMode = 0;
      sfx(700, 30);
      lvlResumeEditor();
      return;
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      s_lvlEmMode = 0;
      sfx(300, 30);
    } else {
      return;
    }
    drawLevelSaveMenu();
    return;
  }

  if (pressed & ARCADA_BUTTONMASK_UP) {
    s_lvlEmArm = -1;
    s_lvlMenuSel = (s_lvlMenuSel + s_lvlEmN - 1) % s_lvlEmN;
    sfxMove();
    drawLevelSaveMenu();
  } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
    s_lvlEmArm = -1;
    s_lvlMenuSel = (s_lvlMenuSel + 1) % s_lvlEmN;
    sfxMove();
    drawLevelSaveMenu();
  } else if ((pressed & (ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT)) && s_lvlEmIds[s_lvlMenuSel] == LEM_TOOL) {
    int d = (pressed & ARCADA_BUTTONMASK_RIGHT) ? 1 : 3;
    s_lvlTool = (uint8_t)((s_lvlTool + d) & 3);
    sfxMove();
    drawLevelSaveMenu();
  } else if ((pressed & (ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT)) && s_lvlEmIds[s_lvlMenuSel] == LEM_CURSOR) {
    s_lvlBigCursor = !s_lvlBigCursor;
    sfxMove();
    drawLevelSaveMenu();
  } else if (pressed & ARCADA_BUTTONMASK_B) {
    s_lvlEmArm = -1;
    lvlResumeEditor();
  } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
    int sel = s_lvlMenuSel;
    int id = s_lvlEmIds[sel];
    char msg[28];
    bool armed = (s_lvlEmArm == sel);
    s_lvlEmArm = -1;
    if (!armed && ((id == LEM_EXIT && s_lvlDirty) ||
                   (id >= LEM_SAVE0 &&
                    (s_lvlUsedMask & (1 << (id - LEM_SAVE0))) &&
                    id - LEM_SAVE0 != s_lvlCurSlot))) {
      s_lvlEmArm = (int8_t)sel;       // first press only arms the confirm
      sfx(300, 60);
      drawLevelSaveMenu();
      return;
    }
    s_lvlWork.magic = LVL_MAGIC;
    s_lvlWork.game = s_lvlCurGame;
    if (id == LEM_RESUME) {
      sfx(600, 30);
      lvlResumeEditor();
    } else if (id == LEM_TEST) {
      if (g_twoPlayerMode) {
        toastShow("Turn off 2 Player");
        sfxBlocked();
        return;
      }
      if (!lvlValidateWork(msg, sizeof(msg))) {
        lvlWarn(msg);
        sfx(150, 150);
        lvlResumeEditor();
        return;
      }
      sfx(600, 40);
      s_lvlTestPlay = true;
      s_lvlClearedNow = false;
      s_lvlActiveSlot[s_lvlCurGame] = LVL_TEMP_SLOT;
      cfg->playFn();
    } else if (id >= LEM_SAVE0) {
      int slot = id - LEM_SAVE0;
      if (!lvlValidateWork(msg, sizeof(msg))) {
        lvlWarn(msg);
        sfx(150, 150);
        lvlResumeEditor();
        return;
      }
      bool wasEmpty = !(s_lvlUsedMask & (1 << slot));
      if (!s_lvlWork.name[0]) snprintf(s_lvlWork.name, sizeof(s_lvlWork.name), "LEVEL %d", (slot & 7) + 1);
      if (s_lvlBestStale || slot != s_lvlCurSlot) s_lvlWork.best = LVL_NO_BEST;   // new content / new slot: new record book
      bool saved = lvlSaveSlot(s_lvlCurGame, slot, &s_lvlWork);
      if (saved) {
        g_save.evFlags |= 2;
        if (wasEmpty) bump8(g_save.cntLevels);   // only new levels count toward Architect
        lvlSavedSet(s_lvlCurGame);
        checkAchievements();
        saveWrite();
        s_lvlCurSlot = (int8_t)slot;
        s_lvlDirty = false;
        s_lvlBestStale = false;
      }
      sfx(saved ? 800 : 150, 100);
      if (!saved) { errLog(204); lvlWarn("E204 Save failed (full?)"); lvlResumeEditor(); return; }
      {
        char sm[28];   // stay in the editor; the Levels menu thumbnails refresh on the next visit
        snprintf(sm, sizeof(sm), "Saved to slot %d", slot + 1);
        s_lvlUsedMask |= (uint8_t)(1 << slot);
        lvlResumeEditor();            // also invalidates the thumbnail cache (lvlEnterEditor)
        lvlWarn(sm);
        drawLevelEditor();
      }
    } else if (id == LEM_EXIT) {
      sfx(300, 30);
      lvlLeaveToMenu();
    } else if (id == LEM_RENAME) {
      for (int i = 0; i < LVL_NAME_LEN; i++) s_lvlNameBuf[i] = s_lvlWork.name[i] ? s_lvlWork.name[i] : ' ';
      s_lvlNameBuf[LVL_NAME_LEN] = 0;
      s_lvlNameCur = 0;
      s_lvlEmMode = 2;
      sfx(600, 30);
      drawLevelSaveMenu();
    } else if (id == LEM_TOOL) {
      s_lvlTool = (uint8_t)((s_lvlTool + 1) & 3);
      sfxMove();
      drawLevelSaveMenu();
    } else if (id == LEM_BRUSH) {
      s_lvlBrushPick = s_lvlBrush;
      s_lvlBrushTop = 0;
      s_lvlEmMode = 1;
      sfx(600, 30);
      drawLevelSaveMenu();
    } else if (id == LEM_COPY) {
      sfx(600, 30);
      lvlResumeEditor();
      s_lvlCopyMode = true;
      s_lvlAnchor = false;
      lvlWarn("A: corner 1  B: cancel");
      drawLevelEditor();
    } else if (id == LEM_PASTE) {
      if (!lvlClipUsable()) { lvlWarn("Clipboard empty"); sfxBlocked(); drawLevelSaveMenu(); return; }
      lvlUndoPush();
      lvlPasteHere();
      lvlUndoCommit();
      sfx(650, 40);
      lvlResumeEditor();
    } else {
      // In-place edit operations, each undoable.
      if (id == LEM_UNDO) {
        if (!s_lvlUndoN) { lvlWarn("Nothing to undo"); sfxBlocked(); drawLevelSaveMenu(); return; }
        memcpy(s_lvlRedo, s_lvlWork.cells, LVL_CELLS);   // stash the current state for one Redo
        s_lvlRedoVer = s_lvlWork.verified;
        s_lvlRedoDirty = s_lvlDirty;
        lvlUndoPop();
        s_lvlRedoOk = true;
      } else if (id == LEM_REDO) {
        if (!s_lvlRedoOk) { lvlWarn("Nothing to redo"); sfxBlocked(); drawLevelSaveMenu(); return; }
        lvlUndoPush();                                   // current state back onto the undo ring (voids redo flag)
        memcpy(s_lvlWork.cells, s_lvlRedo, LVL_CELLS);
        s_lvlWork.verified = s_lvlRedoVer;
        s_lvlDirty = true;
        s_lvlRedoOk = false;
      } else if (id == LEM_CURSOR) {
        s_lvlBigCursor = !s_lvlBigCursor;
        sfxMove();
        drawLevelSaveMenu();
        return;
      } else {
        lvlUndoPush();
        if (id == LEM_RAND) lvlRandomize();
        else if (id == LEM_FILL) lvlFillRegion(s_lvlBrush);
        else if (id == LEM_CLEAR) lvlClearAll();
        else if (id == LEM_MIRH) lvlMirror(true);
        else if (id == LEM_MIRV) lvlMirror(false);
        else if (id == LEM_FLIPH) lvlFlip(true);
        else if (id == LEM_FLIPV) lvlFlip(false);
        else if (id == LEM_ROT) lvlRotate();
        lvlUndoCommit();
      }
      sfx(650, 40);
      lvlResumeEditor();
    }
  }
}

// ---- Levels menu input ----
static int lvlFirstFreeSlot() {
  for (int s = 0; s < LVL_SLOTS; s++)
    if (!(s_lvlUsedMask & (1 << s))) return s;
  return -1;
}

static void updateLevelMenu(uint32_t pressed) {
  s_lvlTestPlay = false;
  lvlMenuRefresh();
  if (s_pkBrowse) { pkUpdate(pressed); return; }
  if (s_lvlShowSummary) {             // finished pack: any of A / B / Start returns to the list
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_START)) {
      s_lvlShowSummary = false;
      s_lvlMenuSel = 0;
      sfx(600, 30);
      drawLvlPickMenu();
    } else if (millis() - s_lvlAnimLast >= 33) {
      s_lvlAnimLast = millis();
      drawLvlPickMenu();
    }
    return;
  }
  int slots[LVL_SLOTS];
  int ns = lvlOccupied(slots);
  bool hasPack = lvlGameHasClear(s_lvlCurGame) && ns >= 2 && !g_twoPlayerMode;
  bool hasPk = s_pkAvail && !g_twoPlayerMode;
  int packRow = hasPack ? (hasPk ? 3 : 2) : -1;
  int off = 2 + (hasPk ? 1 : 0) + (hasPack ? 1 : 0);
  int n = off + ns;
  if (s_lvlMenuSel >= n) s_lvlMenuSel = n - 1;
  const LevelGameConfig *cfg = &kLevelGames[s_lvlCurGame];
  bool redraw = false;

  if (s_lvlSub >= 0) {
    if (pressed & ARCADA_BUTTONMASK_UP) {
      s_lvlSubSel = (uint8_t)((s_lvlSubSel + 3) % 4); s_lvlDelArm = false; sfxMove(); redraw = true;
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      s_lvlSubSel = (uint8_t)((s_lvlSubSel + 1) % 4); s_lvlDelArm = false; sfxMove(); redraw = true;
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      s_lvlSub = -1; s_lvlDelArm = false; sfx(300, 30); redraw = true;
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      int slot = s_lvlSub;
      if (s_lvlSubSel == 0) {                       // Play
        s_lvlSub = -1;
        s_lvlActiveSlot[s_lvlCurGame] = (int8_t)slot;
        s_lvlClearedNow = false;
        if (g_twoPlayerMode) {                      // 2P must start from the title (twoPBegin)
          s_lvlCacheGame = 0xFF;
          cfg->titleFn();
          toastShow("Title: A starts 2P");
          return;
        }
        cfg->playFn();
        return;
      } else if (s_lvlSubSel == 1) {                // Edit
        if (lvlLoadSlot(s_lvlCurGame, slot, &s_lvlWork)) {
          lvlPadToCfg(&s_lvlWork);
          s_lvlSub = -1;
          s_lvlCurSlot = (int8_t)slot;
          lvlEnterEditor(true);
          drawLevelEditor();
          return;
        }
      } else if (s_lvlSubSel == 2) {                // Copy to next free slot
        int dst = lvlFirstFreeSlot();
        LevelData *tmp = lvlPrevBuf();
        s_lvlPrevSlot = -1; s_lvlPrevFail = -1;   // the scratch buffer is about to be overwritten
        if (dst < 0 || !lvlLoadSlot(s_lvlCurGame, slot, tmp)) {
          sfxBlocked();
        } else {
          tmp->best = LVL_NO_BEST;                 // a copy starts with a clean record
          if (!lvlSaveSlot(s_lvlCurGame, dst, tmp)) {
            sfxBlocked();
          } else {
            sfx(800, 60);
            s_lvlCacheGame = 0xFF;
            lvlMenuRefresh();
            toastShow("Level copied");
          }
        }
        s_lvlPrevSlot = -1; s_lvlPrevFail = -1;
        redraw = true;
      } else {                                      // Delete (A twice)
        if (!s_lvlDelArm) {
          s_lvlDelArm = true; sfx(300, 60);
        } else {
          lvlDeleteSlot(s_lvlCurGame, slot);
          if (s_lvlActiveSlot[s_lvlCurGame] == slot) s_lvlActiveSlot[s_lvlCurGame] = -1;
          s_lvlUsedMask &= (uint8_t)~(1 << slot);
          s_lvlPrevSlot = -1; s_lvlPrevFail = -1;
          s_lvlDelArm = false;
          s_lvlSub = -1;
          s_lvlCacheGame = 0xFF;
          sfx(180, 120);
        }
        redraw = true;
      }
    }
  } else {
    if (pressed & ARCADA_BUTTONMASK_UP) {
      s_lvlMenuSel = (s_lvlMenuSel + n - 1) % n; sfxMove(); redraw = true;
    } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
      s_lvlMenuSel = (s_lvlMenuSel + 1) % n; sfxMove(); redraw = true;
    } else if ((pressed & (ARCADA_BUTTONMASK_LEFT | ARCADA_BUTTONMASK_RIGHT)) && s_lvlMenuSel >= off && ns >= 2) {
      int cur = slots[s_lvlMenuSel - off];      // the cursor follows the same slot through the re-sort
      s_lvlSort = (uint8_t)((s_lvlSort + ((pressed & ARCADA_BUTTONMASK_RIGHT) ? 1 : 3)) & 3);
      int again[LVL_SLOTS];
      lvlOccupied(again);
      for (int i = 0; i < ns; i++) if (again[i] == cur) { s_lvlMenuSel = off + i; break; }
      sfxMove(); redraw = true;
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      s_lvlCacheGame = 0xFF;
      cfg->titleFn();
      return;
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (s_lvlMenuSel == 0) {
        s_lvlActiveSlot[s_lvlCurGame] = -1;
        if (g_twoPlayerMode) {
          s_lvlCacheGame = 0xFF;
          cfg->titleFn();
          toastShow("Title: A starts 2P");
          return;
        }
        cfg->playFn();
        return;
      } else if (s_lvlMenuSel == 1) {
        lvlBlankLevel(&s_lvlWork, s_lvlCurGame);
        s_lvlCurSlot = -1;
        lvlEnterEditor(true);
        drawLevelEditor();
        return;
      } else if (hasPk && s_lvlMenuSel == 2) {        // Browse Packs: /packs/g<game>.pak
        sfx(600, 30);
        pkEnter(0, true);
        return;
      } else if (hasPack && s_lvlMenuSel == packRow) {      // Play All Custom: occupied slots in order
        s_lvlPack = true;
        s_lvlPackMask = s_lvlUsedMask;
        s_lvlPackTotal = (uint8_t)ns;
        s_lvlPackCleared = 0;
        s_lvlPackSlot = (int8_t)slots[0];
        for (int i = 1; i < ns; i++) if (slots[i] < s_lvlPackSlot) s_lvlPackSlot = (int8_t)slots[i];   // packs run in slot order
        s_lvlClearedNow = false;
        s_lvlPackHint = false;
        s_lvlActiveSlot[s_lvlCurGame] = s_lvlPackSlot;
        sfx(700, 40);
        cfg->playFn();
        return;
      } else {
        s_lvlSub = (int8_t)slots[s_lvlMenuSel - off];
        s_lvlSubSel = 0;
        s_lvlDelArm = false;
        sfx(600, 30);
        redraw = true;
      }
    }
  }
  // ~30 fps repaint keeps the highlight bar / selector animated (cached data only).
  unsigned long now = millis();
  if (redraw || now - s_lvlAnimLast >= 33) {
    s_lvlAnimLast = now;
    drawLvlPickMenu();
  }
}

// ---- Success / result hooks called by the games ----
// A level was cleared (the game's natural win event). In an editor Test Play this verifies the
// work copy; in a "Play All Custom" run it counts toward the pack.
static void lvlOnClear(uint8_t game) {
  if (game >= LVL_NUM_GAMES) return;
  if (s_lvlPackPlay) { pkOnClear(game); return; }   // a /packs level: completion bit + "next level" (never verifies / saves a best)
  if (s_lvlTestPlay && game == s_lvlCurGame && s_lvlActiveSlot[game] == LVL_TEMP_SLOT) {
    if (!s_lvlWork.verified) {
      s_lvlWork.verified = 1;
      s_lvlDirty = true;                 // the flag is saved with the slot
      evSet2(11);
      jingleStart(JG_WIN);
      toastShow("Level verified!");
      checkAchievements();
    }
  } else if (!s_lvlTestPlay && s_lvlActiveSlot[game] >= 0 && s_lvlActiveSlot[game] < LVL_SLOTS) {
    // a saved custom level cleared in normal play (also inside a pack) counts as verified
    if (s_lvlPack && s_lvlActiveSlot[game] == s_lvlPackSlot && !s_lvlClearedNow) {
      s_lvlClearedNow = true;
      if (s_lvlPackCleared < 255) s_lvlPackCleared++;
    }
    LevelData d;
    if (lvlLoadSlot(game, (uint8_t)s_lvlActiveSlot[game], &d) && !d.verified) {
      d.verified = 1;
      if (lvlSaveSlot(game, (uint8_t)s_lvlActiveSlot[game], &d)) {
        s_lvlCacheGame = 0xFF;
        toastShow("Level verified!");
      } else {
        toastShow("Verify not saved");
      }
    }
  }
}

// Records a finished custom run in the slot file's own "best" field (global bests are never
// touched). Lower-is-better games (times) pass higherIsBetter = false. Test Play (temp slot)
// and built-in runs are ignored.
static void lvlRecordRun(uint8_t game, long score, bool higherIsBetter) {
  s_lvlRunGame = game;
  s_lvlRunNew = false;
  s_lvlRunBest = LVL_NO_BEST;
  s_lastNewBest = false;
  if (game >= LVL_NUM_GAMES) return;
  int8_t sl = s_lvlActiveSlot[game];
  if (sl < 0 || sl >= LVL_SLOTS) return;
  LevelData d;
  if (!lvlLoadSlot(game, (uint8_t)sl, &d)) return;
  d.best = lvlBestFix(game, d.best);
  s_lvlRunBest = d.best;
  if (score <= 0) return;                // like the global bests, non-positive results never count
  bool better = (d.best == LVL_NO_BEST) || (higherIsBetter ? score > d.best : score < d.best);
  if (!better) return;
  d.best = (int32_t)score;
  if (lvlSaveSlot(game, (uint8_t)sl, &d)) {
    s_lvlRunNew = true;
    s_lvlRunBest = d.best;
    s_lvlCacheGame = 0xFF;
  }
}

// ---- Test Play / pack return paths ----
// Leaves a test play and returns to the editor with the work intact.
static void lvlTestPlayExit() {
  if (s_lvlPackPlay) { pkReturn(); return; }   // pack play shares the Test Play return hooks but returns to the pack list
  s_lvlTestPlay = false;
  s_lvlPack = false;
  if (s_lvlCurGame < LVL_NUM_GAMES) s_lvlActiveSlot[s_lvlCurGame] = -1;
  s_fadeSkipOnce = true;
  lvlEnterEditor(false);
  drawLevelEditor();
}

// Called once per loop() before state dispatch. Returns true if it consumed the frame.
static bool lvlTestPlayTick(uint32_t pressed) {
  if (!s_lvlTestPlay) return false;
  uint8_t g = s_lvlCurGame;
  uint8_t st = (uint8_t)gameState;
  if (g < LVL_NUM_GAMES && st == ST_GAME_PICKER) {    // a game's B handler bailed to the picker:
    lvlTestPlayExit();                                // reopen the editor, work intact
    return true;
  }
  if (g >= LVL_NUM_GAMES || st == ST_TWOP_RESULTS ||
      st == ST_MIX_INTRO || st == ST_MIX_RESULTS) {   // abandoned some other way
    s_lvlTestPlay = false;
    if (g < LVL_NUM_GAMES) s_lvlActiveSlot[g] = -1;
    return false;
  }
  if (st == kLvlTitleState[g]) { lvlTestPlayExit(); return true; }
  if (st == kLvlOverState[g] && (pressed & (ARCADA_BUTTONMASK_B | ARCADA_BUTTONMASK_SELECT))) {
    sfx(300, 30);
    lvlTestPlayExit();
    return true;
  }
  return false;
}

// Moves a pack on to its next level, or to the summary after the last one. Always returns true.
static bool lvlPackNext(uint8_t g) {
  int nx = -1;
  for (int k = s_lvlPackSlot + 1; k < LVL_SLOTS; k++)
    if (s_lvlPackMask & (1 << k)) { nx = k; break; }
  if (nx >= 0) {
    s_lvlPackSlot = (int8_t)nx;
    s_lvlActiveSlot[g] = (int8_t)nx;
    s_lvlClearedNow = false;
    s_lvlPackHint = false;
    sfx(700, 40);
    kLevelGames[g].playFn();
    return true;
  }
  uint8_t keepC = s_lvlPackCleared, keepT = s_lvlPackTotal;
  if (keepT >= 2 && keepC >= keepT && !miscGetFlag(MF_PACK_DONE)) {   // "Pack Master" trophy
    miscSetFlag(MF_PACK_DONE, true);
    saveWrite();
    checkAchievements();
  }
  s_lvlActiveSlot[g] = -1;
  lvlLeaveToMenu();                                   // clears the pack flags and redraws
  s_lvlPackCleared = keepC;
  s_lvlPackTotal = keepT;
  s_lvlShowSummary = true;
  sfx(900, 80);
  drawLvlPickMenu();
  return true;
}

// For games that keep playing after a clear (no over screen): hands a Test Play back to the
// editor or a pack on to its next level. Returns true when the game must stop for this frame.
static bool lvlAfterClear(uint8_t g) {
  if (g >= LVL_NUM_GAMES) return false;
  if (s_lvlTestPlay && s_lvlActiveSlot[g] == LVL_TEMP_SLOT) { lvlTestPlayExit(); return true; }
  if (s_lvlPackPlay && s_lvlActiveSlot[g] == LVL_TEMP_SLOT) return s_lvlClearedNow ? pkNext(g) : false;   // /packs level: straight on to the next one
  if (s_lvlPack && s_lvlClearedNow) return lvlPackNext(g);
  return false;
}

// "Play All Custom": at a game's over screen, A/Start after a CLEAR starts the next occupied slot
// (Select skips a failed level); after the last one the pack summary shows in the Levels menu.
static bool lvlPackTick(uint32_t pressed) {
  if (!s_lvlPack) return false;
  uint8_t g = s_lvlCurGame;
  uint8_t st = (uint8_t)gameState;
  if (g >= LVL_NUM_GAMES || st == ST_GAME_PICKER || st == ST_TWOP_RESULTS ||
      st == ST_MIX_INTRO || st == ST_MIX_RESULTS || st == kLvlTitleState[g]) {
    s_lvlPack = false;                                // left the pack (B to the title / picker)
    return false;
  }
  if (st != kLvlOverState[g]) return false;
  if (!s_lvlClearedNow && !s_lvlPackHint) { s_lvlPackHint = true; toastShow("Select: skip level"); }
  bool adv = s_lvlClearedNow && (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START));
  bool skip = !s_lvlClearedNow && (pressed & ARCADA_BUTTONMASK_SELECT);
  if (!adv && !skip) return false;
  return lvlPackNext(g);
}

// Records the launch in the save data (play counts, MRU list, last played).
static void noteGamePlayed(int idx) {
  if (idx < 0 || idx >= NUM_GAMES) return;
  if (savePlays(idx) < 65535) saveSetPlays(idx, (uint16_t)(savePlays(idx) + 1));
  g_save.lastPlayed = (uint8_t)idx;
  uint8_t r[6];
  int n = 0;
  r[n++] = (uint8_t)idx;
  for (int i = 0; i < 6 && n < 6; i++)
    if (g_save.recent[i] != 0xFF && g_save.recent[i] != idx) r[n++] = g_save.recent[i];
  while (n < 6) r[n++] = 0xFF;
  memcpy(g_save.recent, r, 6);
  s_favDirty = false;
  checkAchievements();
  saveWrite();
}

// =====================================================================================
// Portal Quest (game 56): ONE big connected world streamed from /worlds/quest.wld on the drive.
// The world is a grid of regions (up to 8x8, each up to 40x40 tiles of the normal Portal tile set).
// Only the current region lives in RAM (the shared grid[][] + the small object/string tables below);
// walking through a doorway in a region edge loads the neighbour with a seek + a few small reads.
// Format and tooling: tools/README_QUEST.txt, tools/make_quest_world.py.
//   File : header 32 B  "ARQW", u8 ver=1, u8 W, u8 H, u8 nRegions, u32 worldId, u16 crystalTotal, u16 crystalNeed,
//                       u8 startRegion, u8 startCol, u8 startRow, u8 0, char name[12]
//          index W*H x 8 B: u32 offset, u16 length (0 = no region), u8 theme, u8 0
//          region (length bytes): u8 w, u8 h, u8 nObj, u8 nStr, u16 strBytes, u16 0,
//                       nObj x 8 B objects {type,col,row,flag,a,b,c,d}, strBytes of (u8 len + chars), w*h tile chars
// Progress (collected items, opened doors, explored regions, checkpoint, keys) lives in two alternating
// generation files /arcadia/quest0.bin + quest1.bin (68 B each, seq + checksum): a power cut during a
// save always leaves the other generation intact.
// =====================================================================================
#define QUEST_GAME 56
static void enterQuestTitle();
static void drawQuestOver();
#define QW_PATH "/worlds/quest.wld"
#define QW_HDR 32
#define QW_IDX 8
#define QW_MAXREG 64
#define QW_MAXOBJ 28
#define QW_MAXSTR 12
#define QW_STRBUF 360
#define QS_PATH0 "/arcadia/quest0.bin"
#define QS_PATH1 "/arcadia/quest1.bin"
#define QS_MAGIC 0x31535141UL   // "AQS1"

enum { QO_NONE = 0, QO_CRYSTAL, QO_KEY, QO_LOCK, QO_SIGN, QO_CHECK, QO_TELE, QO_SECRET, QO_GATE, QO_WIN, QO_NPC, QO_MAXTYPE = QO_NPC };

struct QObj { uint8_t type, col, row, flag, a, b, c, d; };
struct QuestSave {
  uint32_t magic;
  uint32_t worldId;
  uint32_t playSec;
  uint16_t seq;
  uint16_t crystals;     // informational (title screen without loading the world)
  uint8_t flags[32];     // 256 progress flags: crystals first (0..crystalTotal-1), then keys / locks / secrets
  uint8_t explored[8];   // bit per region
  uint8_t ckReg, ckCol, ckRow, keys;
  uint8_t done, pad[3];
  uint32_t crc;          // FNV-1a over everything above
};
static_assert(sizeof(QObj) == 8, "QObj layout");
static_assert(sizeof(QuestSave) == 68, "QuestSave layout");

// ---- world (header + index) ----
static bool s_qOk = false;            // the world file looked valid at the last probe
static uint8_t s_qErr = 0;            // 1 no drive access, 2 file missing, 3 corrupt
static uint8_t s_qW = 0, s_qH = 0, s_qNReg = 0;
static uint8_t s_qStartReg = 0, s_qStartCol = 0, s_qStartRow = 0;
static uint32_t s_qWorldId = 0;
static uint16_t s_qCrysTotal = 0, s_qCrysNeed = 0;
static uint8_t s_qExist[8];           // bit per region id (id = row*W + col)
static uint8_t s_qTheme[QW_MAXREG];
static uint16_t s_qThemeCol[8];       // filled with color565 at run time (never in a static initializer)
static const char* const kQThemeNames[8] = {"Town", "Ice", "Factory", "Temple", "Maze", "Swamp", "Vault", "Caves"};

// ---- progress ----
static uint8_t s_qFlags[32];
static uint8_t s_qExplored[8];
static uint8_t s_qCkReg = 0, s_qCkCol = 0, s_qCkRow = 0, s_qKeys = 0;
static bool s_qDone = false;
static uint32_t s_qPlaySec = 0;
static uint16_t s_qSeq = 0;
static float s_qPlayAcc = 0;

// ---- current region ----
static uint8_t s_qReg = 0;
static uint8_t qCurTheme() { return gameState == ST_QUEST_PLAYING ? (uint8_t)(s_qTheme[s_qReg] & 7) : 0; }
static QObj s_qObj[QW_MAXOBJ];
static uint8_t s_qNObj = 0;
static char s_qStr[QW_STRBUF];
static uint8_t s_qNStr = 0;
static uint16_t s_qStrOff[QW_MAXSTR];
static char s_qLines[6][25];
static int8_t s_qMsg = -1;            // string index being shown, -1 = none
static bool s_qMapOpen = false;
static char s_qHint[28];
static uint32_t s_qHintUntil = 0;
static uint32_t s_qTeleCool = 0;
static uint32_t s_qSaveAt = 0;
static bool s_qSaveDue = false;
static bool s_qEraseArm = false;
static uint32_t s_qEraseArmMs = 0;
static bool s_qStartDown = false;
static uint32_t s_qStartAt = 0;

static uint32_t qHash(const uint8_t* p, size_t n) {
  uint32_t h = 2166136261u;
  while (n--) h = (h ^ *p++) * 16777619u;
  return h;
}
static bool qFlag(uint8_t f) { return f != 255 && ((s_qFlags[f >> 3] >> (f & 7)) & 1u); }
static void qSetFlag(uint8_t f) { if (f != 255) s_qFlags[f >> 3] |= (uint8_t)(1u << (f & 7)); }
static bool qExists(int id) { return id >= 0 && id < QW_MAXREG && ((s_qExist[id >> 3] >> (id & 7)) & 1u); }
static bool qIsExplored(int id) { return id >= 0 && id < QW_MAXREG && ((s_qExplored[id >> 3] >> (id & 7)) & 1u); }
static int qCrystals() {
  int n = 0;
  for (int i = 0; i < s_qCrysTotal && i < 255; i++) if ((s_qFlags[i >> 3] >> (i & 7)) & 1u) n++;
  return n;
}
static int qExploredCount() {
  int n = 0;
  for (int i = 0; i < QW_MAXREG; i++) if (qExists(i) && qIsExplored(i)) n++;
  return n;
}
static void qHint(const char* t) {
  snprintf(s_qHint, sizeof(s_qHint), "%.26s", t);
  s_qHintUntil = millis() + 2200;
}
static void qInitCols() {
  s_qThemeCol[0] = COL_KEY;
  s_qThemeCol[1] = COL_ICE;
  s_qThemeCol[2] = COL_CONVEYOR;
  s_qThemeCol[3] = COL_LASER;
  s_qThemeCol[4] = COL_TELE_A;
  s_qThemeCol[5] = COL_MUD;
  s_qThemeCol[6] = COL_GOAL;
  s_qThemeCol[7] = COL_BLUE;
}

// ---- save / load of progress ----
static void qDefaults() {
  memset(s_qFlags, 0, sizeof(s_qFlags));
  memset(s_qExplored, 0, sizeof(s_qExplored));
  s_qCkReg = s_qStartReg; s_qCkCol = s_qStartCol; s_qCkRow = s_qStartRow;
  s_qKeys = 0;
  s_qDone = false;
  s_qPlaySec = 0;
  s_qSeq = 0;
}
static bool qReadSaveFile(const char* path, uint8_t* buf) {
  if (!arcada.exists(path)) return false;
  File f = arcada.open(path, O_READ);
  if (!f) return false;
  int n = f.read(buf, sizeof(QuestSave));
  f.close();
  const QuestSave* q = (const QuestSave*)buf;
  return n == (int)sizeof(QuestSave) && q->magic == QS_MAGIC &&
         q->crc == qHash(buf, sizeof(QuestSave) - 4);
}
static void qLoadSave() {
  qDefaults();
  if (!bannerFsOk()) return;
  QuestSave a, b;
  bool va = qReadSaveFile(QS_PATH0, (uint8_t*)&a);
  bool vb = qReadSaveFile(QS_PATH1, (uint8_t*)&b);
  if (va && a.worldId != s_qWorldId) va = false;   // progress of a different (regenerated) world is ignored
  if (vb && b.worldId != s_qWorldId) vb = false;
  const QuestSave* q = NULL;
  if (va && vb) q = ((int16_t)(a.seq - b.seq) >= 0) ? &a : &b;
  else if (va) q = &a;
  else if (vb) q = &b;
  if (!q) return;
  bool ok = q->ckReg < QW_MAXREG && qExists(q->ckReg) && q->ckCol < MAX_GRID_COLS && q->ckRow < MAX_GRID_ROWS && q->keys <= 99;
  if (!ok) return;
  memcpy(s_qFlags, q->flags, sizeof(s_qFlags));
  memcpy(s_qExplored, q->explored, sizeof(s_qExplored));
  s_qCkReg = q->ckReg; s_qCkCol = q->ckCol; s_qCkRow = q->ckRow;
  s_qKeys = q->keys;
  s_qDone = q->done != 0;
  s_qPlaySec = q->playSec;
  s_qSeq = q->seq;
}
static void qSaveNow() {
  s_qSaveDue = false;
  if (!s_qOk || !bannerFsOk()) return;
  if (!arcada.exists("/arcadia")) arcada.mkdir("/arcadia");
  QuestSave sv;
  memset(&sv, 0, sizeof(sv));
  sv.magic = QS_MAGIC;
  sv.worldId = s_qWorldId;
  sv.playSec = s_qPlaySec;
  sv.seq = (uint16_t)(s_qSeq + 1);
  sv.crystals = (uint16_t)qCrystals();
  memcpy(sv.flags, s_qFlags, sizeof(sv.flags));
  memcpy(sv.explored, s_qExplored, sizeof(sv.explored));
  sv.ckReg = s_qCkReg; sv.ckCol = s_qCkCol; sv.ckRow = s_qCkRow; sv.keys = s_qKeys;
  sv.done = s_qDone ? 1 : 0;
  sv.crc = qHash((const uint8_t*)&sv, sizeof(sv) - 4);
  const char* path = (sv.seq & 1) ? QS_PATH1 : QS_PATH0;   // always the OLDER generation
  bool ok = false;
  File f = arcada.open(path, O_WRITE | O_CREAT | O_TRUNC);
  if (f) {
    ok = f.write((const uint8_t*)&sv, sizeof(sv)) == sizeof(sv);
    f.close();
  }
  if (ok) { s_qSeq = sv.seq; Arcada_QSPI_Flash.syncBlocks(); }
  else { Serial.println("Quest: save failed"); errLog(205); }
  int c = qCrystals();
  if (c > 0) recordEndless(QUEST_GAME, c);   // best = most crystals (only rewrites save.bin when it improved)
}
static void qSaveSoon() { s_qSaveDue = true; s_qSaveAt = millis() + 300; }
static void qEraseProgress() {
  if (bannerFsOk()) {
    if (arcada.exists(QS_PATH0)) arcada.remove(QS_PATH0);
    if (arcada.exists(QS_PATH1)) arcada.remove(QS_PATH1);
  }
  qDefaults();
}

// ---- world probe (header + index) ----
static void qProbe() {
  s_qOk = false;
  s_qErr = 1;
  memset(s_qExist, 0, sizeof(s_qExist));
  memset(s_qTheme, 0, sizeof(s_qTheme));
  s_qNReg = 0;
  if (!bannerFsOk()) return;
  s_qErr = 2;
  if (!arcada.exists(QW_PATH)) return;
  s_qErr = 3;
  File f = arcada.open(QW_PATH, O_READ);
  if (!f) return;
  uint32_t sz = (uint32_t)f.size();
  uint8_t h[QW_HDR];
  bool ok = f.read(h, QW_HDR) == QW_HDR && memcmp(h, "ARQW", 4) == 0 && h[4] == 1 &&
            h[5] >= 1 && h[5] <= 8 && h[6] >= 1 && h[6] <= 8;
  int n = ok ? h[5] * h[6] : 0;
  uint32_t idxEnd = QW_HDR + (uint32_t)n * QW_IDX;
  if (ok && sz < idxEnd) ok = false;
  int found = 0;
  for (int i = 0; ok && i < n; i++) {
    uint8_t e[QW_IDX];
    if (f.read(e, QW_IDX) != QW_IDX) { ok = false; break; }
    uint32_t off = e[0] | ((uint32_t)e[1] << 8) | ((uint32_t)e[2] << 16) | ((uint32_t)e[3] << 24);
    uint32_t len = e[4] | ((uint32_t)e[5] << 8);
    if (len == 0) continue;
    if (len < 9 || off < idxEnd || off + len > sz) { ok = false; break; }
    s_qExist[i >> 3] |= (uint8_t)(1u << (i & 7));
    s_qTheme[i] = e[6] & 7;
    found++;
  }
  f.close();
  if (!ok || found < 1) { errLog(503); return; }
  s_qW = h[5]; s_qH = h[6];
  s_qNReg = (uint8_t)found;
  s_qWorldId = h[8] | ((uint32_t)h[9] << 8) | ((uint32_t)h[10] << 16) | ((uint32_t)h[11] << 24);
  s_qCrysTotal = (uint16_t)(h[12] | (h[13] << 8));
  s_qCrysNeed = (uint16_t)(h[14] | (h[15] << 8));
  s_qStartReg = h[16]; s_qStartCol = h[17]; s_qStartRow = h[18];
  if (s_qCrysTotal > 250 || s_qStartReg >= n || !qExists(s_qStartReg) || s_qStartCol >= MAX_GRID_COLS || s_qStartRow >= MAX_GRID_ROWS) return;
  s_qErr = 0;
  s_qOk = true;
}

// ---- region streaming ----
static void qApplyGates() {
  int cr = qCrystals();
  for (int i = 0; i < s_qNObj; i++) {
    const QObj& o = s_qObj[i];
    if (o.col >= curW || o.row >= curH) continue;
    if (o.type == QO_GATE) grid[o.row][o.col] = (cr >= o.a) ? T_FLOOR : T_WALL_NOPORTAL;
    else if (o.type == QO_SECRET) grid[o.row][o.col] = qFlag(o.flag) ? T_FLOOR : T_WALL;
    else if (o.type == QO_LOCK) grid[o.row][o.col] = qFlag(o.flag) ? T_FLOOR : T_DOOR_LOCKED;
  }
}

// Reads region `reg` into grid[][] + the object/string tables. false = any problem (state is then
// undefined; callers fall back to reloading a known-good region).
static bool qLoadRegion(uint8_t reg) {
  if (!s_qOk || reg >= s_qW * s_qH || !qExists(reg) || !bannerFsOk()) return false;
  File f = arcada.open(QW_PATH, O_READ);
  if (!f) return false;
  uint8_t e[QW_IDX], h[8];
  bool ok = f.seek(QW_HDR + (uint32_t)reg * QW_IDX) && f.read(e, QW_IDX) == QW_IDX;
  uint32_t off = 0, len = 0;
  if (ok) {
    off = e[0] | ((uint32_t)e[1] << 8) | ((uint32_t)e[2] << 16) | ((uint32_t)e[3] << 24);
    len = e[4] | ((uint32_t)e[5] << 8);
    ok = len >= 9 && f.seek(off) && f.read(h, 8) == 8;
  }
  int w = 0, hh = 0, nObj = 0, nStr = 0, strB = 0;
  if (ok) {
    w = h[0]; hh = h[1]; nObj = h[2]; nStr = h[3]; strB = h[4] | (h[5] << 8);
    ok = w >= 1 && w <= MAX_GRID_COLS && hh >= 1 && hh <= MAX_GRID_ROWS && nObj <= QW_MAXOBJ &&
         nStr <= QW_MAXSTR && strB <= QW_STRBUF && len == (uint32_t)(8 + nObj * 8 + strB + w * hh);
  }
  if (ok && nObj > 0) ok = f.read((uint8_t*)s_qObj, nObj * 8) == nObj * 8;
  if (ok && strB > 0) ok = f.read((uint8_t*)s_qStr, strB) == strB;
  if (ok) {
    int p = 0;
    for (int i = 0; ok && i < nStr; i++) {
      if (p >= strB) { ok = false; break; }
      s_qStrOff[i] = (uint16_t)p;
      p += 1 + (uint8_t)s_qStr[p];
      if (p > strB) ok = false;
    }
    if (ok && nStr == 0 && strB != 0) ok = false;
  }
  if (ok) {
    for (int i = 0; i < nObj; i++) {
      QObj& o = s_qObj[i];
      if (o.type == QO_NONE || o.type > QO_MAXTYPE || o.col >= w || o.row >= hh) o.type = QO_NONE;
      if ((o.type == QO_SIGN || o.type == QO_NPC) && o.a >= nStr) o.type = QO_NONE;
    }
    s_qNObj = (uint8_t)nObj;
    s_qNStr = (uint8_t)nStr;
    handLevelBegin(w, hh);
    char row[MAX_GRID_COLS];
    for (int r = 0; ok && r < hh; r++) {
      ok = f.read((uint8_t*)row, w) == w;
      for (int c = 0; ok && c < w; c++)
        if (row[c] == 0 || !strchr("#N.~IPD^v<>KudlrFMTUX", row[c])) ok = false;
      if (ok) handLevelRow(r, row);
    }
  }
  f.close();
  if (!ok) { Serial.print("Quest: bad region "); Serial.println(reg); errLog(504); return false; }
  resetLevelRuntimeState();
  qApplyGates();
  if (g_variant == 4) numEmitters = 0;   // ZEN: lasers are off
  return true;
}

// Nudges the player to the nearest walkable tile if a landing spot turned out to be blocked.
static void qUnstick() {
  if (!staticBlockedAt(playerX, playerY, PLAYER_HALF, false)) return;
  float best = 1e9f, bx = playerX, by = playerY;
  for (int r = 0; r < curH; r++)
    for (int c = 0; c < curW; c++) {
      if (tileBlocksMover(grid[r][c], false) || grid[r][c] == T_PIT) continue;
      float dx = tileCenterX(c) - playerX, dy = tileCenterY(r) - playerY;
      float d = dx * dx + dy * dy;
      if (d < best) { best = d; bx = tileCenterX(c); by = tileCenterY(r); }
    }
  playerX = bx; playerY = by;
}

static void qMarkExplored(uint8_t reg) {
  if (qIsExplored(reg)) return;
  s_qExplored[reg >> 3] |= (uint8_t)(1u << (reg & 7));
  qSaveSoon();
}

static void qFatal() {
  errLog(505);
  s_qOk = false;
  s_qErr = 3;
  s_qMsg = -1;
  enterQuestTitle();
}

// Loads `reg` and puts the player on tile (col,row).
static bool qEnterRegion(uint8_t reg, int col, int row) {
  if (!qLoadRegion(reg)) return false;
  s_qReg = reg;
  if (col >= curW) col = curW - 1;
  if (row >= curH) row = curH - 1;
  playerX = tileCenterX(col);
  playerY = tileCenterY(row);
  qUnstick();
  qMarkExplored(reg);
  s_qMsg = -1;
  s_qTeleCool = millis() + 800;
  return true;
}

// Walked off an edge: dx/dy = direction of travel. Loads the neighbour or pushes the player back.
static void qCrossEdge(int dx, int dy) {
  int rx = s_qReg % s_qW, ry = s_qReg / s_qW;
  int nx = rx + dx, ny = ry + dy;
  uint8_t prev = s_qReg;
  float px = playerX, py = playerY;
  int pw = curW, ph = curH;
  if (nx >= 0 && nx < s_qW && ny >= 0 && ny < s_qH && qExists(ny * s_qW + nx)) {
    uint8_t nid = (uint8_t)(ny * s_qW + nx);
    if (qLoadRegion(nid)) {
      s_qReg = nid;
      float maxX = curW * TILE_SIZE - 6.0f, maxY = curH * TILE_SIZE - 6.0f;
      if (dx > 0) { playerX = 6.0f; playerY = py; }
      else if (dx < 0) { playerX = maxX; playerY = py; }
      else if (dy > 0) { playerY = 6.0f; playerX = px; }
      else { playerY = maxY; playerX = px; }
      if (playerX > maxX) playerX = maxX;
      if (playerY > maxY) playerY = maxY;
      if (playerX < 6.0f) playerX = 6.0f;
      if (playerY < 6.0f) playerY = 6.0f;
      qUnstick();
      qMarkExplored(nid);
      s_qTeleCool = millis() + 400;
      { char rb[20]; snprintf(rb, sizeof(rb), "%s %d", kQThemeNames[s_qTheme[nid] & 7], (int)nid); qHint(rb); }
      playerVX = playerVY = 0;
      s_qMsg = -1;
      return;
    }
    // neighbour unreadable: put the old region back and keep the player inside it
    if (!qLoadRegion(prev)) { qFatal(); return; }
    qHint("Read error (E504)");
  }
  float maxX = pw * TILE_SIZE - 3.0f, maxY = ph * TILE_SIZE - 3.0f;
  if (playerX > maxX) playerX = maxX;
  if (playerY > maxY) playerY = maxY;
  if (playerX < 3.0f) playerX = 3.0f;
  if (playerY < 3.0f) playerY = 3.0f;
  playerVX = playerVY = 0;
}

static void questOnDeath() {
  uint8_t r = s_qCkReg, c = s_qCkCol, w = s_qCkRow;
  if (g_variant == 3) { r = s_qStartReg; c = s_qStartCol; w = s_qStartRow; }   // EXTREME: back to the start
  if (!qEnterRegion(r, c, w)) {
    if (!qEnterRegion(s_qStartReg, s_qStartCol, s_qStartRow)) { qFatal(); return; }
  }
  qHint(g_variant == 3 ? "Back to the start!" : "Back to checkpoint");
}

// ---- objects: touch + interact ----
static bool qNearObj(int oi, float maxTiles, bool needFacing) {
  const QObj& o = s_qObj[oi];
  float dx = tileCenterX(o.col) - playerX, dy = tileCenterY(o.row) - playerY;
  float d2 = dx * dx + dy * dy, m = maxTiles * TILE_SIZE;
  if (d2 > m * m) return false;
  if (!needFacing || d2 < 16.0f) return true;
  float d = sqrtf(d2);
  return (dx * cosf(playerAngle) + dy * sinf(playerAngle)) / d > 0.35f;
}

static void qWin() {
  s_qDone = true;
  s_qSaveDue = false;
  qSaveNow();
  miscSetFlag(MF_ACH_QUEST, true);
  recordResult(QUEST_GAME, g_variant, (long)qCrystals(), true);
  sfxWin();
  pixelsWinCelebration();
  gameState = ST_QUEST_OVER;
  drawQuestOver();
}

static void qAfterMove() {
  // a locked door that turned into floor this frame was opened with a key
  for (int i = 0; i < s_qNObj; i++) {
    QObj& o = s_qObj[i];
    if (o.type == QO_LOCK && !qFlag(o.flag) && grid[o.row][o.col] != T_DOOR_LOCKED) {
      qSetFlag(o.flag);
      if (s_qKeys > 0) s_qKeys--;
      qApplyGates();   // opens the other tiles of the same door
      sfx(500, 60);
      qHint("Door unlocked");
      qSaveNow();
    }
  }
  for (int i = 0; i < s_qNObj; i++) {
    QObj& o = s_qObj[i];
    if (o.type == QO_NONE) continue;
    float dx = playerX - tileCenterX(o.col), dy = playerY - tileCenterY(o.row);
    bool touch = dx * dx + dy * dy < 100.0f;
    if (!touch) continue;
    switch (o.type) {
      case QO_CRYSTAL:
        if (!qFlag(o.flag)) {
          qSetFlag(o.flag);
          int before = qCrystals() - 1;
          sfx(1175, 40);
          pixelsFlash(60, 220, 255, 30);
          char b[28];
          snprintf(b, sizeof(b), "Crystal %d/%u", before + 1, (unsigned)s_qCrysTotal);
          qHint(b);
          bool opened = false;
          for (int g = 0; g < s_qNObj; g++)
            if (s_qObj[g].type == QO_GATE && before < s_qObj[g].a && before + 1 >= s_qObj[g].a) opened = true;
          qApplyGates();
          if (opened) { qHint("A gate rumbles open!"); sfxWin(); }
          qSaveSoon();
        }
        break;
      case QO_KEY:
        if (!qFlag(o.flag)) {
          qSetFlag(o.flag);
          if (s_qKeys < 99) s_qKeys++;
          sfx(700, 60);
          qHint("Got a key!");
          qSaveNow();
        }
        break;
      case QO_CHECK:
        if (s_qCkReg != s_qReg || s_qCkCol != o.col || s_qCkRow != o.row) {
          s_qCkReg = s_qReg; s_qCkCol = o.col; s_qCkRow = o.row;
          sfx(880, 50);
          pixelsFlash(60, 255, 120, 40);
          qHint("Checkpoint saved");
          qSaveNow();
        }
        break;
      case QO_TELE:
        if ((int32_t)(millis() - s_qTeleCool) >= 0) {
          sfx(600, 50);
          pixelsFlash(180, 0, 255, 40);
          s_qTeleCool = millis() + 1200;
          if (o.a == s_qReg) {
            playerX = tileCenterX(o.b < curW ? o.b : curW - 1);
            playerY = tileCenterY(o.c < curH ? o.c : curH - 1);
            qUnstick();
          } else {
            uint8_t prev = s_qReg;
            float ox = playerX, oy = playerY;
            if (!qEnterRegion(o.a, o.b, o.c)) {
              if (qLoadRegion(prev)) { s_qReg = prev; playerX = ox; playerY = oy; qHint("Read error (E504)"); }
              else qFatal();
            }
            s_qTeleCool = millis() + 1200;
          }
          return;   // objects may have been replaced
        }
        break;
      case QO_WIN:
        qWin();
        return;
      default: break;
    }
  }
}

// A button: read a sign / talk to an NPC / press on a cracked wall.
static void qInteract() {
  int best = -1;
  float bestD = 1e9f;
  for (int i = 0; i < s_qNObj; i++) {
    const QObj& o = s_qObj[i];
    bool ok = false;
    if (o.type == QO_SIGN) ok = qNearObj(i, 1.6f, true);
    else if (o.type == QO_NPC) ok = qNearObj(i, 2.0f, false);
    else if (o.type == QO_SECRET && !qFlag(o.flag)) ok = qNearObj(i, 1.7f, true);
    if (!ok) continue;
    float dx = tileCenterX(o.col) - playerX, dy = tileCenterY(o.row) - playerY;
    float d = dx * dx + dy * dy;
    if (d < bestD) { bestD = d; best = i; }
  }
  if (best < 0) return;
  QObj& o = s_qObj[best];
  if (o.type == QO_SECRET) {
    qSetFlag(o.flag);
    qApplyGates();
    sfx(300, 120);
    pixelsFlash(255, 200, 60, 60);
    qHint("A hidden door opens!");
    qSaveNow();
  } else {
    s_qMsg = (int8_t)o.a;
    sfx(660, 25);
  }
}

// ---- drawing ----
static void qDrawObjects(float posX, float posY, float dirX, float dirY, float planeX, float planeY) {
  for (int i = 0; i < s_qNObj; i++) {
    const QObj& o = s_qObj[i];
    switch (o.type) {
      case QO_CRYSTAL:
        if (!qFlag(o.flag))
          drawBillboard3D(o.row, o.col, COL_ICE, SPR_DIAMOND, posX, posY, dirX, dirY, planeX, planeY, 0.55f, false, true);
        break;
      case QO_KEY:
        if (!qFlag(o.flag))
          drawBillboard3D(o.row, o.col, COL_KEY, SPR_KEY, posX, posY, dirX, dirY, planeX, planeY, 0.5f, false, true);
        break;
      case QO_CHECK: {
        bool cur = (s_qCkReg == s_qReg && s_qCkCol == o.col && s_qCkRow == o.row);
        uint16_t c = cur ? COL_BOOST : COL_PLATE;
        drawBillboard3D(o.row, o.col, c, SPR_PLATE, posX, posY, dirX, dirY, planeX, planeY, 0.6f, true, false);
        drawBeacon3D(o.col, o.row, c, posX, posY, dirX, dirY, planeX, planeY);
        break;
      }
      case QO_SIGN:
        drawBillboard3D(o.row, o.col, COL_TEXT, SPR_CRATE, posX, posY, dirX, dirY, planeX, planeY, 0.4f, false, false);
        break;
      case QO_NPC:
        drawBillboard3D(o.row, o.col, COL_ORANGE, SPR_RING, posX, posY, dirX, dirY, planeX, planeY, 0.6f, false, true);
        break;
      case QO_TELE:
        drawBillboard3D(o.row, o.col, COL_TELE_A, SPR_RING, posX, posY, dirX, dirY, planeX, planeY, 0.85f, false, true);
        break;
      case QO_WIN:
        drawBillboard3D(o.row, o.col, COL_GOAL, SPR_DIAMOND, posX, posY, dirX, dirY, planeX, planeY, 0.95f, false, true);
        break;
      default: break;
    }
  }
  // region exits: a blue ring on every open tile of the outer edge (only doorways are open there)
  for (int c = 0; c < curW; c++) {
    if (!tileBlocksMover(grid[0][c], false) && grid[0][c] != T_PIT)
      drawBillboard3D(0, c, COL_BLUE, SPR_RING, posX, posY, dirX, dirY, planeX, planeY, 0.7f, false, true);
    if (curH > 1 && !tileBlocksMover(grid[curH - 1][c], false) && grid[curH - 1][c] != T_PIT)
      drawBillboard3D(curH - 1, c, COL_BLUE, SPR_RING, posX, posY, dirX, dirY, planeX, planeY, 0.7f, false, true);
  }
  for (int r = 1; r < curH - 1; r++) {
    if (!tileBlocksMover(grid[r][0], false) && grid[r][0] != T_PIT)
      drawBillboard3D(r, 0, COL_BLUE, SPR_RING, posX, posY, dirX, dirY, planeX, planeY, 0.7f, false, true);
    if (curW > 1 && !tileBlocksMover(grid[r][curW - 1], false) && grid[r][curW - 1] != T_PIT)
      drawBillboard3D(r, curW - 1, COL_BLUE, SPR_RING, posX, posY, dirX, dirY, planeX, planeY, 0.7f, false, true);
  }
}

static void qDrawHud() {
  canvas->fillRect(0, 0, VIEW_COLS * TILE_SIZE, HUD_HEIGHT, COL_BG);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_ICE);
  canvas->setCursor(2, 4);
  char b[28];
  snprintf(b, sizeof(b), "%d/%u", qCrystals(), (unsigned)s_qCrysTotal);
  canvas->print(b);
  canvas->setTextColor(COL_KEY);
  snprintf(b, sizeof(b), " K%u", (unsigned)s_qKeys);
  canvas->print(b);
  const char* tn = kQThemeNames[s_qTheme[s_qReg] & 7];
  ptc(COL_TEXT, 158 - (int)strlen(tn) * 6, 4, tn);
}

static void qDrawHintLine() {
  if ((int32_t)(millis() - s_qHintUntil) >= 0 || !s_qHint[0]) return;
  int w = (int)strlen(s_qHint) * 6 + 6;
  canvas->fillRect(0, 116, w, 12, COL_BG);
  canvas->setTextSize(1);
  ptc(COL_TEXT, 3, 119, s_qHint);
}

static int qWrapText(const char* s, int len) {
  int n = 0, pos = 0;
  while (pos < len && n < 6) {
    while (pos < len && s[pos] == ' ') pos++;
    if (pos >= len) break;
    int take = len - pos;
    if (take > 24) {
      take = 24;
      if (s[pos + 24] != ' ') {
        int k = 23;
        while (k > 0 && s[pos + k] != ' ') k--;
        if (k > 0) take = k;
      }
    }
    memcpy(s_qLines[n], s + pos, take);
    s_qLines[n][take] = 0;
    n++;
    pos += take;
  }
  return n;
}

static void qDrawMessage() {
  if (s_qMsg < 0 || s_qMsg >= s_qNStr) return;
  const char* s = s_qStr + s_qStrOff[s_qMsg];
  int len = (uint8_t)s[0];
  int n = qWrapText(s + 1, len);
  if (n == 0) return;
  int h = 10 + n * 10 + 10;
  int y = 118 - h;
  canvas->fillRect(4, y, 152, h, COL_BG);
  canvas->drawRect(4, y, 152, h, COL_KEY);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  for (int i = 0; i < n; i++) {
    pt(9, y + 6 + i * 10, s_qLines[i]);
  }
  ptc(COL_KEY, 112, y + h - 10, "A: ok");
}

static void qDrawMap() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_KEY, 4, 3, "WORLD MAP");
  int cell = 150 / s_qW;
  int cellV = 92 / s_qH;
  if (cellV < cell) cell = cellV;
  if (cell > 18) cell = 18;
  if (cell < 5) cell = 5;
  int ox = (160 - cell * s_qW) / 2, oy = 14;
  for (int ry = 0; ry < s_qH; ry++)
    for (int rx = 0; rx < s_qW; rx++) {
      int id = ry * s_qW + rx;
      if (!qExists(id)) continue;
      int x = ox + rx * cell, y = oy + ry * cell;
      if (qIsExplored(id)) canvas->fillRect(x, y, cell - 1, cell - 1, s_qThemeCol[s_qTheme[id] & 7]);
      else canvas->drawRect(x, y, cell - 1, cell - 1, COL_WALL_NOPORTAL);
      if (s_qCkReg == id && cell >= 7) canvas->fillRect(x + 1, y + 1, 2, 2, COL_BOOST);
    }
  {   // you are here: blinks, positioned inside the cell
    int rx = s_qReg % s_qW, ry = s_qReg / s_qW;
    int x = ox + rx * cell, y = oy + ry * cell;
    int px = x + (int)(playerX * (cell - 2) / (curW * TILE_SIZE)) + 1;
    int py = y + (int)(playerY * (cell - 2) / (curH * TILE_SIZE)) + 1;
    if ((millis() / 300u) & 1u) canvas->fillRect(px - 1, py - 1, 3, 3, COL_TEXT);
    else canvas->drawRect(x - 1, y - 1, cell + 1, cell + 1, COL_TEXT);
  }
  char b[40];
  canvas->setTextColor(COL_TEXT);
  snprintf(b, sizeof(b), "Crystals %d/%u  Keys %u", qCrystals(), (unsigned)s_qCrysTotal, (unsigned)s_qKeys);
  pt(4, 108, b);
  snprintf(b, sizeof(b), "Regions %d/%u  %s", qExploredCount(), (unsigned)s_qNReg, kQThemeNames[s_qTheme[s_qReg] & 7]);
  pt(4, 118, b);
  blitScreen();
}

static void qDrawPlaying() {
  float posX = playerX / TILE_SIZE, posY = playerY / TILE_SIZE;
  float dirX = cosf(playerAngle), dirY = sinf(playerAngle);
  float planeLen = tanf(FOV_RADIANS * 0.5f);
  float planeX = -dirY * planeLen, planeY = dirX * planeLen;
  thirdPerson = false;
  draw3DScene();
  qDrawObjects(posX, posY, dirX, dirY, planeX, planeY);
  qDrawHud();
  qDrawHintLine();
  qDrawMessage();
  blitScreen();
}

