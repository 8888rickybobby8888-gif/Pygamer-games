    unsigned long dodgeNow = millis();
    float dodgeDt = (s_lastFrameMs == 0) ? 0.016f : (dodgeNow - s_lastFrameMs) / 1000.0f;
    if (dodgeDt > 0.05f) dodgeDt = 0.05f;
    s_lastFrameMs = dodgeNow;

    if (buttons & ARCADA_BUTTONMASK_LEFT) dodgePX -= DODGE_PLAYER_SPEED * dodgeDt;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) dodgePX += DODGE_PLAYER_SPEED * dodgeDt;
    if (buttons & ARCADA_BUTTONMASK_UP) dodgePY -= DODGE_PLAYER_SPEED * dodgeDt;
    if (buttons & ARCADA_BUTTONMASK_DOWN) dodgePY += DODGE_PLAYER_SPEED * dodgeDt;
    if (dodgePX < DODGE_PLAYER_R) dodgePX = DODGE_PLAYER_R;
    if (dodgePX > DODGE_PLAY_W - DODGE_PLAYER_R) dodgePX = DODGE_PLAY_W - DODGE_PLAYER_R;
    if (dodgePY < DODGE_PLAYER_R) dodgePY = DODGE_PLAYER_R;
    if (dodgePY > DODGE_PLAY_H - DODGE_PLAYER_R) dodgePY = DODGE_PLAY_H - DODGE_PLAYER_R;

    bool hitThisFrame = false;
    for (int i = 0; i < MAX_BEAMS; i++) {
      if (!beams[i].active) {
        if (dodgeNow >= dodgeBeamActivateAt[i]) dodgeSpawnBeam(i);
        continue;
      }
      beams[i].pos += beams[i].speed * dodgeDt;
      float dim = beams[i].vertical ? DODGE_PLAY_W : DODGE_PLAY_H;
      if (beams[i].pos > dim) {
        dodgeSpawnBeam(i); // resets pos back off-screen with a fresh speed/thickness
        continue;
      }
      float sweepCoord = beams[i].vertical ? dodgePX : dodgePY;
      float perpCoord = beams[i].vertical ? dodgePY : dodgePX;
      bool inBar = sweepCoord >= beams[i].pos && sweepCoord <= beams[i].pos + beams[i].thickness;
      bool inGap = perpCoord >= beams[i].gapStart && perpCoord <= beams[i].gapStart + beams[i].gapSize;
      if (inBar && !inGap) hitThisFrame = true;
    }
    if (hitThisFrame && dodgeNow >= dodgeHitUntilMs) {
      dodgeLives--;
      dodgeHitUntilMs = dodgeNow + DODGE_HIT_COOLDOWN_MS;
      sfx(120, 80);
      pixelsFlash(255, 0, 0, 60);
