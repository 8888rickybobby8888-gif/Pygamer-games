static_assert(sizeof(kAchTbl) / sizeof(kAchTbl[0]) == NUM_ACH - NUM_ACH_OLD, "kAchTbl length must match NUM_ACH");
static const char *achName(int i) { return i < NUM_ACH_OLD ? kAchNames[i] : kAchTbl[i - NUM_ACH_OLD].name; }
static const char *achDesc(int i) { return i < NUM_ACH_OLD ? kAchDescs[i] : kAchTbl[i - NUM_ACH_OLD].desc; }

static int popcount64(uint64_t v) {
  int c = 0;
  while (v) { c += (int)(v & 1); v >>= 1; }
  return c;
}
static int statTotalPlays() {
  long t = 0;
  for (int g = 0; g < NUM_GAMES; g++) t += savePlays(g);
  return t > 99999 ? 99999 : (int)t;
}
static int statDistinctPlayed() {
  int c = 0;
  for (int g = 0; g < NUM_GAMES; g++) if (savePlays(g) > 0) c++;
  return c;
}
static bool statHasBest(int g) {
  if (!gameHasScore(g)) return false;
  for (int t = 0; t < SAVE_TIERS; t++) if (saveBest(g, t) != SAVE_NO_SCORE) return true;
  return false;
}
static int statScoredGames() {
  int c = 0;
  for (int g = 0; g < NUM_GAMES; g++) if (statHasBest(g)) c++;
  return c;
}
static int achCount() {
  int c = 0;
  for (int i = 0; i < NUM_ACH; i++) if (achGet(i)) c++;
  return c;
}

// Category of a game, from its blurb prefix: 0 Arcade, 1 Reflex, 2 Puzzle,
// 3 Strategy, 4 Battle, -1 other (Race/Memory/Luck/Tilt/Risk it).
#define NUM_CATS 5
static const char* kCatNames[NUM_CATS] = {"Arcade", "Reflex", "Puzzle", "Strategy", "Battle"};
static int gameCategory(int g) {
  if (!cartIsId(g) && (g < 0 || g >= NUM_GAMES)) return -1;
  const char* bl = pkBlurb(g);
  for (int c = 0; c < NUM_CATS; c++) {
    size_t l = strlen(kCatNames[c]);
    if (strncmp(bl, kCatNames[c], l) == 0 && bl[l] == ':') return c;
  }
  return -1;
}
static uint16_t gameCatColor(int g) {
  int c = gameCategory(g);
  return s_catCols[(c < 0 || c > 4) ? 5 : c];
}

static int catBestCount(int cat) {
  int c = 0;
  for (int g = 0; g < NUM_GAMES; g++) if (gameCategory(g) == cat && statHasBest(g)) c++;
  return c;
}

static int tierBestCount(int t) {
  int c = 0;
  for (int g = 0; g < NUM_GAMES; g++) if (gameHasScore(g) && saveBest(g, t) != SAVE_NO_SCORE) c++;
  return c;
}
static bool condMet(uint8_t type, uint16_t p) {
  switch (type) {
    case C_PLAYS: return statTotalPlays() >= p;
    case C_DIST: return statDistinctPlayed() >= p;
    case C_SCORED: return statScoredGames() >= p;
    case C_FAVS: return popcount64(g_save.favorites) >= p;
    case C_GAMEPLAYS:
      for (int g = 0; g < NUM_GAMES; g++) if (savePlays(g) >= p) return true;
      return false;
    case C_TIER: return tierBestCount((p / 100) % SAVE_TIERS) >= (p % 100);
    case C_CAT: return catBestCount((p / 100) % NUM_CATS) >= (p % 100);
    case C_PLAYED: return p < NUM_GAMES && savePlays(p) > 0;
    case C_EV2: return (g_save.evFlags2[p >> 3] >> (p & 7)) & 1u;
    case C_C2P: return g_save.cnt2P >= p;
    case C_CPAUSE: return g_save.cntPause >= p;
    case C_CLVL: return g_save.cntLevels >= p;
    case C_LVLGAMES: return popcount64(lvlSavedMask()) >= (int)p;
    case C_MISCF: return miscGetFlag((int)p);
    case C_BESTAT: return saveBest((int)(p / 10), (int)(p % 10)) != SAVE_NO_SCORE;   // p = game * 10 + tier
    case C_CBEST: return g_save.cntBests >= p;
    case C_PACKN: return pkDoneTotal() >= (int)p;   // pack levels cleared in total (popcount of SaveMisc.reserved)
    case C_ACH: return achCount() >= (p ? (int)p : NUM_ACH);
    case C_PLAYEDALL: {   // p = first of 4 consecutive games that must all have been played (p >= 100: first = p - 100, only 3 games)
      int first = (int)p, cnt = 4;
      if (first >= 100) { first -= 100; cnt = 3; }
      for (int g = first; g < first + cnt; g++)
        if (g >= NUM_GAMES || savePlays(g) == 0) return false;
      return true;
    }
    case C_BESTGE:      // p = game * 1000 + threshold: a best of at least that on any tier
      for (int t = 0; t < SAVE_TIERS; t++) {
        int32_t b = saveBest((int)(p / 1000), t);
        if (b != SAVE_NO_SCORE && b >= (int32_t)(p % 1000)) return true;
      }
      return false;
  }
  return false;
}

static bool achEarned(int i) {
  if (i >= NUM_ACH_OLD) return condMet(kAchTbl[i - NUM_ACH_OLD].type, kAchTbl[i - NUM_ACH_OLD].p);
  switch (i) {
    case 0: return statTotalPlays() >= 1;
    case 1: return statDistinctPlayed() >= 10;
    case 2: return statDistinctPlayed() >= 25;
    case 3: return statTotalPlays() >= 100;
    case 4: {
      for (int g = 31; g < 36; g++) if (g >= NUM_GAMES || savePlays(g) == 0) return false;
      return true;
    }
    case 5: {
      for (int g = 0; g < NUM_GAMES; g++)
        if (gameHasScore(g) && saveBest(g, SAVE_TIERS - 1) != SAVE_NO_SCORE) return true;
      return false;
    }
    case 6: return popcount64(g_save.favorites) >= 5;
    case 7: return (g_save.evFlags & 1) != 0;
    case 8: return (g_save.evFlags & 2) != 0;
    case 9: {
      bool have[NUM_CATS] = {false, false, false, false, false};
      for (int g = 0; g < NUM_GAMES; g++) {
        int c = gameCategory(g);
        if (c >= 0 && statHasBest(g)) have[c] = true;
      }
      for (int c = 0; c < NUM_CATS; c++) if (!have[c]) return false;
      return true;
    }
    case 10: return statScoredGames() >= 20;
    case 11: return statTotalPlays() >= 500;
    case 12: return statDistinctPlayed() >= NUM_GAMES;
    case 13: {
      for (int g = 0; g < NUM_GAMES; g++) {
        if (!gameHasScore(g)) continue;
        bool all = true;
        for (int t = 0; t < SAVE_TIERS; t++) if (saveBest(g, t) == SAVE_NO_SCORE) all = false;
        if (all) return true;
      }
      return false;
    }
    case 14: return statScoredGames() >= 10;
    case 15: {
      for (int g = 0; g < NUM_GAMES; g++) if (savePlays(g) >= 25) return true;
      return false;
    }
    case 16: return catBestCount(0) >= 5;
    case 17: return catBestCount(1) >= 4;
    case 18: return catBestCount(2) >= 3;
    case 19: return catBestCount(3) >= 2;
    case 20: return popcount64(g_save.favorites) >= 10;
    case 21: return (g_save.evFlags & 4) != 0;
    case 22: return (g_save.evFlags & 8) != 0;
    case 23: return (g_save.evFlags & 16) != 0;
  }
  return false;
}

// Trophies (shown on the Trophies screen). Defined here, ahead of checkAchievements(),
// so a newly earned trophy can be announced with a toast.
typedef struct { const char *name; const char *desc; uint8_t tier; uint8_t type; uint16_t p; } TrophyDef;
#define NUM_TROPHIES 13
static_assert(NUM_TROPHIES <= 16, "trophyMask has 16 bits");
static const TrophyDef kTrophies[NUM_TROPHIES] = {
  {"Bronze Cup", "Earn 10 achievements", 0, C_ACH, 10},
  {"Silver Cup", "Earn 25 achievements", 1, C_ACH, 25},
  {"Gold Cup", "Earn 50 achievements", 2, C_ACH, 50},
  {"Platinum Cup", "Earn every achievement", 3, C_ACH, 0},
  {"Arcade Champion", "Bests in 8 arcade games", 2, C_CAT, 8},
  {"Reflex Champion", "Bests in 6 reflex games", 2, C_CAT, 106},
  {"Puzzle Champion", "Bests in 4 puzzle games", 2, C_CAT, 204},
  {"Extreme Elite", "Extreme bests: 10 games", 4, C_TIER, 310},
  {"Grand Master", "Best score in 30 games", 4, C_SCORED, 30},
  {"Century Club", "Reach 1000 total plays", 1, C_PLAYS, 1000},
  {"Collector Shelf", "Favorite 10 games", 0, C_FAVS, 10},
  {"Pack Master", "Clear a whole custom pack", 2, C_MISCF, MF_PACK_DONE},
  {"Grand Architect", "Save levels for 5 games", 1, C_LVLGAMES, 5},
};
static bool trophyEarned(int i) { return condMet(kTrophies[i].type, kTrophies[i].p); }
static bool trophyAnnounced(int i) { return (g_save.trophyMask[i >> 3] >> (i & 7)) & 1u; }
static void trophyMarkAnnounced(int i) { g_save.trophyMask[i >> 3] |= (uint8_t)(1u << (i & 7)); }
// After loading a save: trophies already earned are marked announced without a toast,
// so only trophies that flip to earned from now on show a banner.
static void trophySyncSilent() {
  for (int i = 0; i < NUM_TROPHIES; i++) if (trophyEarned(i)) trophyMarkAnnounced(i);
}

// Unlocks any newly-earned achievements (toast + save). Returns true if any.
static bool checkAchievements() {
  bool any = false;
  int nNew = 0;
  for (int i = 0; i < NUM_ACH; i++) if (!achGet(i) && achEarned(i)) nNew++;
  if (nNew >= 3) {            // batch: one toast instead of a pile of them
    for (int i = 0; i < NUM_ACH; i++) if (!achGet(i) && achEarned(i)) achSet(i);
    char buf[40];
    snprintf(buf, sizeof(buf), "%d achievements unlocked", nNew);
    toastShow(buf);
    any = true;
  } else for (int i = 0; i < NUM_ACH; i++) {
    if (achGet(i) || !achEarned(i)) continue;
    achSet(i);
    char buf[28];
    snprintf(buf, sizeof(buf), "Unlocked: %.15s", achName(i));
    toastShow(buf);
    any = true;
  }
  for (int i = 0; i < NUM_TROPHIES; i++) {
    if (trophyAnnounced(i) || !trophyEarned(i)) continue;
    trophyMarkAnnounced(i);
    char buf[28];
    snprintf(buf, sizeof(buf), "Trophy: %.17s", kTrophies[i].name);
    toastShow(buf);
    any = true;
  }
  if (any) saveWrite();
  return any;
}

// "Special Delivery": a bomb gem was made (Gem Swap) or a bomb bubble popped (Bubble Shooter).
static void specialDelivery() {
  if (g_save.evFlags2[1] & 0x10) return;
  evSet2(12);
  checkAchievements();
}

// Records a finished round. Returns true if it is a new best for this
// game + difficulty tier. Non-positive scores never count as a best.
static bool s_noBestCount = false; // set by recordEndless(): don't count each step as a "new best" for the cntBests achievements
static bool recordResult(int gameIdx, int variant, long score, bool higherIsBetter) {
  s_lastNewBest = false;
  s_lastNewBestGame = gameIdx;
  if (gameIdx < 0 || gameIdx >= SAVE_TOTAL_GAMES) return false;
  int t = saveTierOf(variant);
  int32_t cur = saveBest(gameIdx, t);
  bool better = false;
  if (score > 0) {
    better = (cur == SAVE_NO_SCORE) || (higherIsBetter ? score > cur : score < cur);
  }
  if (better) { saveSetBest(gameIdx, t, (int32_t)score); if (!s_noBestCount) bump8(g_save.cntBests); }
  s_lastNewBest = better;
  bool chalNew = false;   // personal best for this Challenge number (only Challenge runs count)
  if (g_challengeN && score > 0)
    chalNew = miscChalSet(g_challengeN, miscGetFlag(MF_CHAL_CLASSIC), (int32_t)score, higherIsBetter);
  // Endless games only rewrite the file when something actually improved.
  if (better || chalNew || !s_noBestCount) saveWrite();
  checkAchievements();
  return better;
}

// For games with no game-over (Sokoban, Lights Out, Dice Duel): called at each
// scoring event with the running session score (higher is better).
static void recordEndless(int gameIdx, long score) {
  s_noBestCount = true;
  recordResult(gameIdx, g_variant, score, true);
  s_noBestCount = false;
}

static void drawBestLineCore(int gameIdx, int y, bool over) {
  char val[16], line[32];
  if (over) {   // a custom-slot run shows the slot's own record instead of the global best
    int lg = lvlGameFromPicker(gameIdx);
    if (lg >= 0 && s_lvlActiveSlot[lg] >= 0 && s_lvlActiveSlot[lg] < LVL_SLOTS && ((s_lvlRecMask >> lg) & 1u)) {
      bool mine = (s_lvlRunGame == lg);
      bool isNewL = mine && s_lvlRunNew;
      lvlFmtBest((uint8_t)lg, mine ? s_lvlRunBest : LVL_NO_BEST, val, sizeof(val));
      if (isNewL) snprintf(line, sizeof(line), canvas->width() < 160 ? "NEW BEST! %s" : "NEW LEVEL BEST! %s", val);
      else snprintf(line, sizeof(line), "Level best: %s", val);
      canvas->setTextSize(1);
      ptc(isNewL ? COL_KEY : COL_TEXT, 4, y, line);
      if (isNewL) animBestFlash(4, y, line);
      return;
    }
  }
  int32_t v = cartIsId(gameIdx) ? cartBestOf(gameIdx - CART_BASE, saveTierOf(g_variant)) : saveBest(gameIdx, saveTierOf(g_variant));
  fmtBestValue(gameIdx, v, val, sizeof(val));
  bool isNew = over && s_lastNewBest && s_lastNewBestGame == gameIdx;
  if (isNew) snprintf(line, sizeof(line), "NEW BEST! %s", val);
  else if (!over && pkPlays(gameIdx) > 0 && strlen(val) <= 8)   // title: add "Plays: N" (<= 26 chars)
    snprintf(line, sizeof(line), "Best: %.8s  Plays: %u", val, (unsigned)pkPlays(gameIdx));
  else snprintf(line, sizeof(line), "Best: %s", val);
  canvas->setTextSize(1);
  ptc(isNew ? COL_KEY : COL_TEXT, 4, y, line);
  if (isNew) animBestFlash(4, y, line);
}
// Games whose title screen offers the "Seed" line (Down cycles it).
static bool gameHasSeed(int g) {
  return g == 1 || g == 4 || g == 11 || g == 13 || g == 15 || g == 19 || g == 31 || g == 33 || g == 57 || g == 58;
}
static void cycleUserSeed() {
  if (g_challengeN) return; // a challenge round has a fixed seed
  g_userSeed = (g_userSeed >= 99) ? 0 : (uint8_t)(g_userSeed + 1);
  g_save.evFlags |= 32;
}
// Title screens: always "Best: N" for the currently selected tier. Seed-enabled games also get
// their "Seed:" line here, since every title calls this last, just before blitting.
static void drawBestLine(int gameIdx, int y) {
  drawBestLineCore(gameIdx, y, false);
  if (gameHasSeed(gameIdx) && !g_twoPlayerMode) {
    char line[32];
    if (g_challengeN) snprintf(line, sizeof(line), "CHALLENGE #%d", (int)g_challengeN);
    else if (g_userSeed) snprintf(line, sizeof(line), "Seed: #%d (Down: next)", g_userSeed);
    else snprintf(line, sizeof(line), "Seed: RANDOM (Down)");
    canvas->setTextSize(1);
    ptc(g_challengeN ? COL_ORANGE : COL_KEY, 4, 77, line);
  }
}
// Over screens: "NEW BEST! N" if the round that just ended set a record.
static void drawBestLineOver(int gameIdx, int y) { drawBestLineCore(gameIdx, y, true); }

