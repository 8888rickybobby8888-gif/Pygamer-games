// --- Gap Flyer ---------------------------------------------------------
//
// Flappy-style auto-scroller: press A to thrust up against gravity, fly
// through the gaps in walls scrolling in from the right. Distance is the
// score; gaps are randomly placed (auto-generated, endless).

#define GAP_MAX_WALLS 3
struct GapWall { bool active; float x; int gapY, gapSize; bool scored; };
static GapWall gapWalls[GAP_MAX_WALLS];
static float gapPlayerY, gapPlayerVY;
static unsigned long gapNextSpawnMs;
static int gapScore, gapBestScore;
static float gapSpeedCur = 55.0f;
#define GAP_PLAYER_X 24
#define GAP_PLAYER_SIZE 6
#define GAP_WALL_W 10
#define GAP_PW 160   // landscape: 160x112 field under the 16px HUD
#define GAP_PH 112

// Level-creator course: a fixed sequence of wall gaps (tile 0..6 = gap height, 0 = lowest). The run
// ends with LEVEL CLEAR once every wall has been passed.
static bool gapCustom = false, gapWon = false;
static uint8_t gapCustomCells[LVL_GRID_MAXW];
static uint8_t gapCustomLen = 0, gapCustomIdx = 0;

static bool gapValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  if (lvl->w < 5) { snprintf(msg, msgLen, "Need at least 5 walls"); return false; }
  for (int c = 0; c < lvl->w; c++)
    if (lvl->cells[0][c] > 6) { snprintf(msg, msgLen, "Bad gap height"); return false; }
  return true;
}

static void gapLoadCustom(const LevelData *lvl) {
  int n = lvl->w < LVL_GRID_MAXW ? lvl->w : LVL_GRID_MAXW;
  if (n < 1) return;
  for (int c = 0; c < n; c++) gapCustomCells[c] = lvl->cells[0][c] > 6 ? 3 : lvl->cells[0][c];
  gapCustomLen = (uint8_t)n;
  gapCustomIdx = 0;
  gapCustom = true;
  gapWon = false;
}

static void gapSpawnWall(float x) {
  if (gapCustom && gapCustomIdx >= gapCustomLen) return;   // the course has no more walls
  for (int i = 0; i < GAP_MAX_WALLS; i++) {
    if (gapWalls[i].active) continue;
    gapWalls[i].active = true;
    gapWalls[i].x = x;
    gapWalls[i].gapSize = 34;
    if (gapCustom) {   // tile 6 = highest gap; the usable range is the same 0..57 px as the random walls
      gapWalls[i].gapY = HUD_HEIGHT + 10 + (6 - (int)gapCustomCells[gapCustomIdx]) * 57 / 6;
      gapCustomIdx++;
    } else {
      gapWalls[i].gapY = HUD_HEIGHT + 10 + (GAP_PH - 112) / 2 + mazeRngRange(112 - 20 - gapWalls[i].gapSize);
    }
    gapWalls[i].scored = false;
    return;
  }
}

static void enterGapTitle() {
  gameState = ST_GAP_TITLE;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_TELE_B, 30, 14, "GAP FLYER");
  ptc(COL_TEXT, 4, 40, "A: flap upward");
  pt(4, 50, "Fly through the gaps,");
  pt(4, 60, "don't hit a wall!");
  pt(4, 88, "Mode: ");
  canvas->print(kSpeedTierNames[g_variant]);
  pt(4, 98, "Left/Right: change mode");
  canvas->setCursor(4, 108);
  animPrompt("A/Start: play  B: back");
  canvas->setCursor(4, 118);
  lvlTitleHint(LVLGAME_GAP);
  drawBestLine(19, 26);
  blitScreen();
}

static void enterGapPlaying() {
  s_mazeRng = gameSeed();
  for (int i = 0; i < GAP_MAX_WALLS; i++) gapWalls[i].active = false;
  gapCustom = false;
  gapWon = false;
  if (s_lvlActiveSlot[LVLGAME_GAP] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_GAP, s_lvlActiveSlot[LVLGAME_GAP], &lvl)) gapLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_GAP] = -1;
  }
  gapPlayerY = HUD_HEIGHT + GAP_PH / 2.0f;
  gapPlayerVY = 0;
  gapScore = 0;
  switch (g_variant) {
    case 1: gapSpeedCur = 75.0f; break;  // Speed
    case 2: gapSpeedCur = 40.0f; break;  // Chill
    case 3: gapSpeedCur = 95.0f; break;  // Extreme
    case 4: gapSpeedCur = 30.0f; break;  // Zen
    default: gapSpeedCur = 55.0f; break;
  }
  gapSpawnWall(GAP_PW + 20);
  gapNextSpawnMs = millis() + 1300;
  gameState = ST_GAP_PLAYING;
  s_lastFrameMs = 0;
}

static void drawGapScene() {
  canvas->fillRect(0, HUD_HEIGHT, GAP_PW, GAP_PH, COL_BG);
  for (int i = 0; i < GAP_MAX_WALLS; i++) {
    if (!gapWalls[i].active) continue;
    int wx = (int)gapWalls[i].x;
    canvas->fillRect(wx, HUD_HEIGHT, GAP_WALL_W, gapWalls[i].gapY - HUD_HEIGHT, COL_WALL);
    int belowY = gapWalls[i].gapY + gapWalls[i].gapSize;
    canvas->fillRect(wx, belowY, GAP_WALL_W, HUD_HEIGHT + GAP_PH - belowY, COL_WALL);
  }
  canvas->fillRect(GAP_PLAYER_X, (int)gapPlayerY, GAP_PLAYER_SIZE, GAP_PLAYER_SIZE, COL_PLAYER);
}

