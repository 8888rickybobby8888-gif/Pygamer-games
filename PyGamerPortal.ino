static float mazeStartDist = 1.0f; // straight-line start-to-goal distance, for the compass color scale

static void enterMazePlaying() {
  if (s_lvlActiveSlot[LVLGAME_MAZE] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_MAZE, s_lvlActiveSlot[LVLGAME_MAZE], &lvl)) {
      mazeLoadCustom(&lvl);
    } else {
      s_lvlActiveSlot[LVLGAME_MAZE] = -1;
      generateSpeedMaze(millis() ^ 0x2545f491UL);
    }
  } else {
    generateSpeedMaze(millis() ^ 0x2545f491UL);
  }
  switch (g_variant) {
    case 1: mazeTurnSpeedCur = 5.2f; break; // Speed
    case 2: mazeTurnSpeedCur = 3.2f; break; // Chill
    case 3: mazeTurnSpeedCur = 6.4f; break; // Extreme
    case 4: mazeTurnSpeedCur = 2.4f; break; // Zen
    default: mazeTurnSpeedCur = 4.2f; break;
  }
  gameState = ST_MAZE_PLAYING;
  mazeStartMs = millis();
  s_lastFrameMs = 0;

  float sx = playerX / TILE_SIZE, sy = playerY / TILE_SIZE;
  float gx = goalCol + 0.5f, gy = goalRow + 0.5f;
  mazeStartDist = sqrtf((gx - sx) * (gx - sx) + (gy - sy) * (gy - sy));
  if (mazeStartDist < 1.0f) mazeStartDist = 1.0f; // guard against div-by-~0
}

// A "compass": the PyGamer's NeoPixels are a straight line, not a ring,
// so this doesn't point in a full 360 -- instead it maps the goal's
// CURRENT bearing relative to wherever you're facing this exact frame
// onto the strip's left-to-right position (center pixel = straight
// ahead, one end = hard left, the other = hard right), the same way a
// simple left/right nudge indicator would; it's recomputed every frame,
// so it tracks live as you turn and move, never a stale snapshot.
// Distance is color, not brightness: red far away, shifting through
// orange/yellow and into green as you close in -- a full-brightness
// color gradient reads faster at a glance than a dim/bright difference
// does.
static void updateMazeCompass() {
  float px = playerX / TILE_SIZE, py = playerY / TILE_SIZE;
  float gx = goalCol + 0.5f, gy = goalRow + 0.5f;
  float toGoal = atan2f(gy - py, gx - px);
  float rel = toGoal - playerAngle;
  while (rel > PI) rel -= 2.0f * PI;
  while (rel < -PI) rel += 2.0f * PI;
  float norm = rel / PI; // -1 (hard left/behind) .. 0 (ahead) .. 1 (hard right/behind)

  int idx = (int)roundf((norm + 1.0f) * 0.5f * (ARCADA_NEOPIXEL_NUM - 1));
  if (idx < 0) idx = 0;
  if (idx >= ARCADA_NEOPIXEL_NUM) idx = ARCADA_NEOPIXEL_NUM - 1;

  // Scaled against the actual start-to-goal distance (not the grid's
  // generic diagonal) so the very first frame of a run reads as pure red
  // no matter how the maze happened to lay out, then scales smoothly to
  // green as you close the gap -- a straight-line distance can briefly
  // exceed the starting one (you're not walking straight at it through
  // walls), so this still clamps to the 0..1 range.
  float dist = sqrtf((gx - px) * (gx - px) + (gy - py) * (gy - py));
  float closeness = 1.0f - dist / mazeStartDist;
  if (closeness < 0.0f) closeness = 0.0f;
  if (closeness > 1.0f) closeness = 1.0f;

  // Red -> yellow -> green: ramp green up over the first half of the
  // range, then ramp red down over the second half, so the midpoint
  // reads as a clear yellow rather than a muddy blend.
  uint8_t r = (closeness < 0.5f) ? 255 : (uint8_t)(255 * (1.0f - (closeness - 0.5f) * 2.0f));
  uint8_t g = (closeness < 0.5f) ? (uint8_t)(255 * closeness * 2.0f) : 255;

  for (int i = 0; i < ARCADA_NEOPIXEL_NUM; i++) {
    if (i == idx)
      arcada.pixels.setPixelColor(i, r, g, 0);
    else
      arcada.pixels.setPixelColor(i, 0, 0, 0);
  }
  arcada.pixels.show();
}

