// --- Whack-a-Mole ------------------------------------------------------
//
// A 3x3 grid drawn flat (no raycasting) -- one mole lights up at a time,
// move the cursor onto it and press A/B before it vanishes.

static int moleCursorX = 1, moleCursorY = 1;
static int moleActiveX = -1, moleActiveY = -1;
static unsigned long moleExpiresAtMs = 0, moleEndAtMs = 0;
static int moleScore = 0;
#define MOLE_TIME_MS 30000UL
#define MOLE_CELL 34
static const int MOLE_GX = (VIEW_COLS * TILE_SIZE - 3 * MOLE_CELL) / 2;
static const int MOLE_GY = HUD_HEIGHT + (VIEW_ROWS * TILE_SIZE - 3 * MOLE_CELL) / 2;
static unsigned long moleLifetimeMs = 1200UL;

static void moleSpawn(unsigned long now) {
  int newX, newY;
  do {
    newX = mazeRngRange(3);
    newY = mazeRngRange(3);
  } while (newX == moleActiveX && newY == moleActiveY);
  moleActiveX = newX;
  moleActiveY = newY;
  moleExpiresAtMs = now + moleLifetimeMs;
}

static void enterMoleTitle() {
  gameState = ST_MOLE_TITLE;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_BOOST, 16, 14, "WHACK-A-MOLE");
  ptc(COL_TEXT, 4, 40, "D-pad: move cursor");
  pt(4, 50, "A or B: whack");
  pt(4, 68, "30 second rounds");
  pt(4, 88, "Mode: ");
  canvas->print(kSpeedTierNames[g_variant]);
  pt(4, 98, "Left/Right: change mode");
  canvas->setCursor(4, 108);
  animPrompt("A/Start: play  B: back");
  drawBestLine(4, 26);
  blitScreen();
}

static void enterMolePlaying() {
  // mazeRngRange() draws from the shared s_mazeRng, which starts at 0 and
  // stays 0 forever (xorshift is a fixed point at zero) until something
  // seeds it -- Portal and Speed Maze both do that themselves before
  // they need randomness, but coming here straight from the picker
  // without ever playing either of those left it unseeded, so the mole
  // always "spawned" in the same cell instead of moving around.
  s_mazeRng = gameSeed();
  moleScore = 0;
  moleCursorX = moleCursorY = 1;
  switch (g_variant) {
    case 1: moleLifetimeMs = 850UL; break;  // Speed
    case 2: moleLifetimeMs = 1700UL; break; // Chill
    case 3: moleLifetimeMs = 550UL; break;  // Extreme
    case 4: moleLifetimeMs = 2300UL; break; // Zen
    default: moleLifetimeMs = 1200UL; break;
  }
  unsigned long now = millis();
  moleEndAtMs = now + MOLE_TIME_MS;
  moleSpawn(now);
  gameState = ST_MOLE_PLAYING;
  s_lastFrameMs = 0;
}

static void drawMoleScene() {
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  for (int r = 0; r < 3; r++) {
    for (int c = 0; c < 3; c++) {
      bool lit = (c == moleActiveX && r == moleActiveY);
      uint16_t col = lit ? COL_BOOST : COL_WALL_NOPORTAL;
      canvas->fillRect(MOLE_GX + c * MOLE_CELL + 2, MOLE_GY + r * MOLE_CELL + 2,
                        MOLE_CELL - 4, MOLE_CELL - 4, col);
    }
  }
  canvas->drawRect(MOLE_GX + moleCursorX * MOLE_CELL, MOLE_GY + moleCursorY * MOLE_CELL,
                    MOLE_CELL, MOLE_CELL, COL_TEXT);
}

