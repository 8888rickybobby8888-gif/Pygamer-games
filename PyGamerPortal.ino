// Starts a side's turn: legal moves, movable-piece mask, CPU timer, or the game-over test.
static void ckFinish(int w);
static void ckBeginTurn() {
  ckNMv = (uint8_t)ckGen(ckBd, ckTurn, ckMv, CK_MAXM);
  if (ckNMv == 0) { ckFinish(3 - ckTurn); return; }
  ckMovable = 0;
  for (int i = 0; i < ckNMv; i++) ckMovable |= (1UL << ckMv[i * CK_MP + 1]);
  ckMust = (ckMv[0] & 0x80) != 0;
  ckSel = -1;
  ckDest = 0;
  ckK = 0;
  ckNCand = 0;
  ckCpuPlanned = false;
  unsigned long now = millis();
  {   // 2 PLAYERS: P2 sees the board rotated (animated when it changes)
    bool want = (!ckVsCpu && ckFlipOpt && ckTurn == 2);
    if (want != ckViewFlip) {
      ckViewOld = ckViewFlip;
      ckViewFlip = want;
      ckFlipT0 = now ? now : 1UL;
      if (ckBusyUntil < now + 340UL) ckBusyUntil = now + 340UL;
    }
  }
  if (ckVsCpu && ckTurn == 2) {
    ckCpuAt = now + 450UL + (unsigned long)mazeRngRange(300);
  } else {                     // park the cursor on a piece that can move
    int s = ckMv[1];
    int r = s >> 2, c = 2 * (s & 3) + ((r & 1) ? 0 : 1);
    ckCr = (uint8_t)(ckViewFlip ? 7 - r : r);     // the cursor is kept in screen cells
    ckCc = (uint8_t)(ckViewFlip ? 7 - c : c);
  }
}

static void enterCkPlaying() {
  for (int s = 0; s < 32; s++) ckBd[s] = (int8_t)(s < 12 ? 3 : (s >= 20 ? 1 : 0));
  ckColL = arcada.display->color565(176, 146, 104);
  ckColD = arcada.display->color565(86, 56, 36);
  ckPc1 = arcada.display->color565(242, 236, 214);
  ckPc2 = arcada.display->color565(205, 45, 45);
  ckGold = arcada.display->color565(255, 205, 40);
  ckTurn = (uint8_t)(ckVsCpu ? 1 : ckFirst);   // the human always opens vs the CPU
  ckLastFrom = -1;
  ckLastTo = -1;
  ckPromoSq = -1;
  ckWinner = 0;
  ckQuiet = 0;
  ckCapThis = false;
  ckEnding = false;
  ckRepT = 0;
  ckBusyUntil = 0;
  ckViewFlip = (!ckVsCpu && ckFlipOpt && ckTurn == 2);
  ckViewOld = ckViewFlip;
  ckDrawFlip = ckViewFlip;
  ckFlipT0 = 0;
  ckRepStart = 0;
  ckUndoOk = false;
  ckStartDown = false;
  ckStartArmed = false;
  ckTapPending = false;
  memset(ckLastMv, 0, sizeof(ckLastMv));
  s_mazeRng = (millis() ^ 0xC0FFEEu) | 1u;
  ckBeginTurn();
  gameState = ST_CK_PLAYING;
}

static void ckDisc(int cx, int cy, int v, int r) {
  int own = ckOwner(v);
  canvas->fillCircle(cx, cy, r, own == 1 ? ckPc1 : ckPc2);
  canvas->drawCircle(cx, cy, r, own == 1 ? arcada.display->color565(120, 112, 96) : arcada.display->color565(110, 20, 20));
  if (!(v & 1)) {
    canvas->fillCircle(cx, cy, r - 3, ckGold);
    canvas->drawPixel(cx - 1, cy - 1, COL_TEXT);
  }
}

static void drawCkScene(unsigned long now) {
  bool flipAnim = false;
  {   // orientation for this frame: the old view until the half-way point of a flip, then the new one
    bool f = ckViewFlip;
    if (ckFlipT0) {
      unsigned long el = now - ckFlipT0;
      if (el < 340UL) { flipAnim = true; f = (el < 170UL) ? ckViewOld : ckViewFlip; }
      else ckFlipT0 = 0;
    }
    ckDrawFlip = f;
  }
  canvas->fillScreen(COL_BG);
  for (int r = 0; r < 8; r++)
    for (int c = 0; c < 8; c++)
      canvas->fillRect(CK_X0 + c * CK_CELL, CK_Y0 + r * CK_CELL, CK_CELL, CK_CELL, ((r + c) & 1) ? ckColD : ckColL);
  bool human = !ckEnding && !(ckVsCpu && ckTurn == 2) && !flipAnim;
  for (int s = 0; s < 32; s++) {
    int cx = ckSqX(s), cy = ckSqY(s);
    int x = cx - CK_CELL / 2, y = cy - CK_CELL / 2;
    if (s == ckLastFrom || s == ckLastTo) canvas->drawRect(x, y, CK_CELL, CK_CELL, arcada.display->color565(150, 120, 60));
    if (ckBd[s]) ckDisc(cx, cy, ckBd[s], 5);
    if (human && ckSel < 0 && ((ckMovable >> s) & 1UL)) canvas->fillRect(x + 1, y + 1, 3, 3, COL_KEY);
    if (human && ((ckDest >> s) & 1UL)) {
      canvas->fillCircle(cx, cy, 2, COL_GOAL);
      canvas->drawRect(x, y, CK_CELL, CK_CELL, COL_GOAL);
    }
    if (human && s == ckSel) {
      uint16_t hc = ckK > 0 ? COL_ORANGE : COL_GOAL;
      canvas->drawRect(x, y, CK_CELL, CK_CELL, hc);
      canvas->drawRect(x + 1, y + 1, CK_CELL - 2, CK_CELL - 2, hc);
    }
  }
  if (ckPromoSq >= 0 && now - ckPromoT0 < 500UL) {
    int rr = 6 + (int)((now - ckPromoT0) / 45UL);
    canvas->drawCircle(ckSqX(ckPromoSq), ckSqY(ckPromoSq), rr, ckGold);
  }
  if (ckRepStart && ckLastMv[0]) {   // replay of the last move: a ring glides along its path
    int steps = (ckLastMv[0] & 0x7F) - 1;
    unsigned long el = now - ckRepStart;
    if (steps < 1 || el >= (unsigned long)steps * 320UL + 320UL) {
      ckRepStart = 0;
    } else {
      int i = (int)(el / 320UL);
      float fr = (float)(el % 320UL) / 320.0f;
      if (i >= steps) { i = steps - 1; fr = 1.0f; }
      int a = ckLastMv[1 + i], b = ckLastMv[2 + i];
      int x = ckSqX(a) + (int)((float)(ckSqX(b) - ckSqX(a)) * fr);
      int y = ckSqY(a) + (int)((float)(ckSqY(b) - ckSqY(a)) * fr);
      canvas->drawCircle(ckSqX(ckLastMv[1]), ckSqY(ckLastMv[1]), 3, COL_KEY);
      canvas->drawCircle(x, y, 7, COL_KEY);
      canvas->drawCircle(x, y, 8, COL_KEY);
      if (ckLastMv[0] & 0x80) {
        for (int k = 0; k <= i && k < steps; k++) {
          int m = ckMid(ckLastMv[1 + k], ckLastMv[2 + k]);
          if (m < 0) continue;
          int mx = ckSqX(m), my = ckSqY(m);
          canvas->drawLine(mx - 3, my - 3, mx + 3, my + 3, COL_LASER);
          canvas->drawLine(mx - 3, my + 3, mx + 3, my - 3, COL_LASER);
        }
      }
    }
  }
  if (human) {
    int x = CK_X0 + ckCc * CK_CELL, y = CK_Y0 + ckCr * CK_CELL;
    canvas->drawRect(x, y, CK_CELL, CK_CELL, COL_KEY);
    canvas->drawRect(x + 1, y + 1, CK_CELL - 2, CK_CELL - 2, COL_KEY);
  }
  // side panel
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  ckDisc(128, 14, 1, 5);
  pt(138, 11, ckCount(1));
  ckDisc(128, 32, 3, 5);
  pt(138, 29, ckCount(2));
  if (!ckEnding) {
    pt(122, 48, "TURN");
    ptc(COL_GOAL, 122, 58, ckName(ckTurn));
    ckDisc(150, 61, ckTurn == 1 ? 1 : 3, 5);
    if (ckVsCpu && ckTurn == 2) {
      canvas->setTextColor(COL_TEXT);
      canvas->setCursor(122, 72);
      int dots = (int)((now / 300UL) % 3UL) + 1;
      for (int i = 0; i < dots; i++) canvas->print(".");
      if (ckThinkD) {
        char td[12];
        snprintf(td, sizeof(td), "d%d/%d", (int)ckThinkD, (int)ckThinkMax);
        pt(122, 82, td);
      }
    } else if (ckMust && ckSel < 0) {
      ptc(COL_ORANGE, 122, 72, "JUMP!");
    } else if (ckK > 0) {
      ptc(COL_ORANGE, 122, 72, "MORE!");
    }
  }
  if (ckQuiet >= 50) {
    ptc(COL_TEXT, 116, 90, "DRAW IN");
    pt(122, 100, (80 - ckQuiet) / 2);
  }
  if (ckVsCpu) {
    static const char* const kCkTier4[4] = {"NORM", "EASY", "HARD", "XTRM"};
    ptc(COL_TEXT, 122, 118, kCkTier4[g_variant & 3]);
  } else if (ckUndoOk && !ckEnding && ckK == 0) {
    ptc(COL_TEXT, 122, 118, "St:undo");
  }
  particlesUpdateDraw();
  if (flipAnim) {   // shutter: the board closes to a line, turns, and opens again
    unsigned long el = now - ckFlipT0;
    int h = (int)(56UL * (el < 170UL ? el : 340UL - el) / 170UL);
    if (h > 56) h = 56;
    if (h > 0) {
      canvas->fillRect(CK_X0, CK_Y0, 8 * CK_CELL, h, COL_BG);
      canvas->fillRect(CK_X0, CK_Y0 + 8 * CK_CELL - h, 8 * CK_CELL, h, COL_BG);
    }
  }
}

