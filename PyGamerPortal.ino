// kind: 0 rock, 1 paper, 2 scissors, anything else = a "?" placeholder.
static void drawRpsIcon(int cx, int cy, int kind, uint16_t col) {
  if (kind == 0) {
    canvas->fillCircle(cx, cy, 11, col);
    canvas->drawCircle(cx, cy, 11, COL_TEXT);
  } else if (kind == 1) {
    canvas->fillRect(cx - 9, cy - 12, 18, 24, col);
    canvas->drawRect(cx - 9, cy - 12, 18, 24, COL_TEXT);
    canvas->drawFastHLine(cx - 5, cy - 5, 10, COL_BG);
    canvas->drawFastHLine(cx - 5, cy, 10, COL_BG);
    canvas->drawFastHLine(cx - 5, cy + 5, 10, COL_BG);
  } else if (kind == 2) {
    for (int d = -1; d <= 1; d++) {
      canvas->drawLine(cx - 9 + d, cy - 11, cx + 5 + d, cy + 5, col);
      canvas->drawLine(cx + 9 + d, cy - 11, cx - 5 + d, cy + 5, col);
    }
    canvas->fillCircle(cx - 6, cy + 9, 3, COL_TEXT);
    canvas->fillCircle(cx + 6, cy + 9, 3, COL_TEXT);
  } else {
    canvas->setTextSize(2);
    ptc(col, cx - 5, cy - 7, "?");
    canvas->setTextSize(1);
  }
}

// Both hands slide in shaking as fists, then flip to the real picks.
static void drawRpsReveal() {
  unsigned long now = millis();
  float t = (float)(now - rpsRevealStart) / (float)RPS_REVEAL_MS;
  if (t > 1.0f) t = 1.0f;
  float slide = animEase(t / 0.45f);
  bool shown = t >= 0.45f;
  int cy = HUD_HEIGHT + 36;
  int bob = shown ? 0 : (((now / 45) & 1) ? 4 : -4);
  int pcx = (int)(-20.0f + 62.0f * slide);
  int ccx = (int)(180.0f - 62.0f * slide);
  uint16_t winC = COL_GOAL, loseC = COL_EMITTER;
  uint16_t pcol = COL_TEXT, ccol = COL_TEXT;
  if (shown && rpsRevealPlayer >= 0) {
    if (rpsRevealResult == 1) { pcol = winC; ccol = loseC; }
    else if (rpsRevealResult == -1) { pcol = loseC; ccol = winC; }
  }
  drawRpsIcon(pcx, cy + bob, shown ? rpsRevealPlayer : 0, pcol);
  drawRpsIcon(ccx, cy - bob, shown ? rpsCpuPick : 0, ccol);
  canvas->setTextSize(1);
  ptc(COL_TEXT, pcx - 9, cy + 18, "YOU");
  pt(ccx - 9, cy + 18, "CPU");
  if (shown) {
    const char* msg = rpsRevealPlayer < 0 ? "TIME'S UP!"
                      : rpsRevealResult == 1 ? "YOU WIN" : rpsRevealResult == 0 ? "DRAW" : "YOU LOSE";
    uint16_t mc = rpsRevealResult == 1 ? winC : (rpsRevealResult == 0 ? COL_TEXT : loseC);
    ptc(mc, (VIEW_COLS * TILE_SIZE - (int)strlen(msg) * 6) / 2, HUD_HEIGHT + 80, msg);
  }
}

