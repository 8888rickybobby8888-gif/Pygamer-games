  blitScreen();
}

static void enterMindPlaying() {
  // A level Test Play / pack run needs the vs-CPU round (2 PLAYERS ignores custom codes).
  if (s_lvlActiveSlot[LVLGAME_MIND] >= 0 && (s_lvlTestPlay || s_lvlPack || s_lvlPackPlay)) mmVsCpu = true;
  int t = g_variant & 3;
  mmLen = kMmLen[t];
  mmCols = kMmCols[t];
  mmTries = kMmTries[t];
  mmCol[1] = arcada.display->color565(230, 55, 55);
  mmCol[2] = arcada.display->color565(60, 200, 80);
  mmCol[3] = arcada.display->color565(60, 130, 245);
  mmCol[4] = arcada.display->color565(240, 220, 60);
  mmCol[5] = arcada.display->color565(180, 80, 230);
  mmCol[6] = arcada.display->color565(255, 140, 40);
  mmCol[7] = arcada.display->color565(60, 220, 220);
  mmCol[8] = arcada.display->color565(245, 245, 245);
  mmCol[0] = arcada.display->color565(60, 60, 80);
  mmHit = arcada.display->color565(60, 240, 90);
  mmNear = arcada.display->color565(255, 200, 40);
  memset(mmCode, 0, sizeof(mmCode));
  memset(mmCur, 0, sizeof(mmCur));
  memset(mmGuess, 0, sizeof(mmGuess));
  memset(mmFb, 0, sizeof(mmFb));
  mmN = 0;
  mmSlot = 0;
  mmSolved = false;
  mmScore = 0;
  mmHintN = 0;
  mmHintPos[0] = mmHintPos[1] = 0xFF;
  mmStartDown = false;
  mmStartArmed = false;   // the Start press that began the round must be released first
  mmWinner = 0;
  mmRound = 0;
  mmRes[0] = 0;
  mmRes[1] = 0;
  mmBlinkT = 0;
  if (mmVsCpu) {
    s_mazeRng = (g_twoPlayerMode ? (millis() ^ 0xC0FFEEu) : gameSeed()) | 1u;   // seeded code
    for (int i = 0; i < mmLen; i++) mmCode[i] = (uint8_t)(1 + mazeRngRange(mmCols));
    mmCustom = false;
    if (s_lvlActiveSlot[LVLGAME_MIND] >= 0) {
      LevelData lvl;
      if (lvlLoadSlot(LVLGAME_MIND, s_lvlActiveSlot[LVLGAME_MIND], &lvl)) {
        int hi = 0, sum = 0;
        for (int i = 0; i < mmLen; i++) {
          uint8_t c = (i < lvl.w) ? lvl.cells[0][i] : 0;
          if (c < 1 || c > 8) c = (uint8_t)(1 + sum % 8);   // empty peg (5th of a 4-peg level): derived colour
          mmCode[i] = c;
          sum += c;
          if (c > hi) hi = c;
        }
        if (hi > (int)mmCols) mmCols = (uint8_t)hi;   // the palette must offer every colour of the code
        mmCustom = true;
      } else {
        s_lvlActiveSlot[LVLGAME_MIND] = -1;
      }
    }
    mmPh = MP_GUESS;
  } else {
    mmCustom = false;   // 2 PLAYERS: the setter picks the code
    mmSetter = (uint8_t)mmFirst;
    mmPh = MP_PASS;
    mmNextPh = MP_SET;
    mmWho = mmSetter;
  }
  mmAid = mmVsCpu && !g_twoPlayerMode && (g_variant & 3) <= 1;
  if (mmAid) {
    uint32_t tot = 1;
    for (int i = 0; i < mmLen; i++) tot *= mmCols;
    if (tot > 4096UL) mmAid = false;
    else mmLeft = (uint16_t)tot;
  }
  mmPhT0 = millis();
  s_lastFrameMs = 0;
  gameState = ST_MIND_PLAYING;
}

// One peg (col 0 = an empty slot, drawn as a dim ring).
// Letter A-H centred on (x,y) for the colour-blind overlay (size 1, or 2 on big pegs).
static void mmGlyph(int x, int y, uint8_t col, bool big) {
  if (!(g_save.miscFlags & 8) || col < 1 || col > 8) return;
  canvas->setTextSize(big ? 2 : 1);
  ptc(kMmGlyphDark[col] ? COL_BG : 0xFFFF, x - (big ? 5 : 2), y - (big ? 7 : 3), (char)('A' + col - 1));
  canvas->setTextSize(1);
}
static void mmPeg(int x, int y, int r, uint8_t col) {
  if (col == 0) {
    canvas->drawCircle(x, y, r, mmCol[0]);
    return;
  }
  canvas->fillCircle(x, y, r, mmCol[col]);
  if (g_save.miscFlags & 8) { if (r >= 3) mmGlyph(x, y, col, r >= 8); }
  else if (r >= 4) canvas->drawPixel(x - 1, y - 2, COL_TEXT);
}

static int mmCalcScore() {
  int s = (int)(mmTries - mmN) * 10 + (int)kMmBonus[g_variant & 3] - (int)mmHintN * (int)kMmHintPen[g_variant & 3];
  return s < 0 ? 0 : s;
}

// Start tap while guessing: reveals one secret peg that no earlier guess nailed down.
static void mmHint() {
  if (mmHintN >= 2) { sfxBlocked(); return; }
  uint8_t unk[MM_MAXP];
  int nu = 0;
  for (int i = 0; i < mmLen; i++) {
    bool known = false;
    for (int h = 0; h < mmHintN; h++) if (mmHintPos[h] == i) known = true;
    for (int k = 0; k < mmN; k++) if (mmGuess[k][i] == mmCode[i]) known = true;
    if (!known) unk[nu++] = (uint8_t)i;
  }
  if (nu == 0) { sfxBlocked(); return; }
  int p = unk[(micros() >> 4) % (uint32_t)nu];
  mmHintPos[mmHintN++] = (uint8_t)p;
  mmCur[p] = mmCode[p];
  mmSlot = (uint8_t)p;
  sfx(1100, 70);
  particlesBurst(100 + p * 10, 60, 6, mmCol[mmCode[p]]);
}

static int mmRowY(int k) {
  int pitch = (mmTries <= 8) ? 12 : (mmTries <= 10 ? 10 : 9);
  return 10 + k * pitch;
}

static void mmDrawBoard() {
  int pitch = (mmTries <= 8) ? 12 : (mmTries <= 10 ? 10 : 9);
  for (int k = 0; k < mmTries; k++) {
    int y = mmRowY(k);
    bool cur = (k == mmN && mmPh == MP_GUESS);
    if (cur) canvas->fillRect(2, y - pitch / 2, 86, pitch, arcada.display->color565(28, 28, 46));
    for (int i = 0; i < mmLen; i++) {
      int x = 9 + i * 12;
      if (k < mmN) mmPeg(x, y, 4, mmGuess[k][i]);
      else if (cur) mmPeg(x, y, 4, mmCur[i]);
      else canvas->fillCircle(x, y, 1, mmCol[0]);
    }
    if (k < mmN) {
      int ex = mmFb[k] >> 4, ne = mmFb[k] & 15;
      for (int j = 0; j < ex + ne && j < MM_MAXP; j++) {
        int fx = 70 + (j % 3) * 5, fy = y - 4 + (j / 3) * 5;
        canvas->fillRect(fx, fy, 3, 3, j < ex ? mmHit : mmNear);
      }
    }
    if (cur) {
      int cx = 9 + mmSlot * 12;
      canvas->drawRect(cx - 5, y - 5, 11, 11, COL_KEY);
    }
  }
}

static void mmDrawPanel(unsigned long now) {
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 98, 2, "MASTERMIND");
  char t[20];
  canvas->setTextColor(COL_TEXT);
  if (mmPh == MP_REVEAL) {
    ptc(mmSolved ? mmHit : COL_LASER, 98, 16, mmSolved ? "SOLVED!" : "FAILED");
    ptc(COL_TEXT, 98, 30, "Code:");
    for (int i = 0; i < mmLen; i++) mmPeg(103 + i * 11, 48, 4, mmCode[i]);
    snprintf(t, sizeof(t), "%d of %d", (int)mmN, (int)mmTries);
    pt(98, 62, t);
    if (mmVsCpu && mmSolved) {
      snprintf(t, sizeof(t), "+%d", mmCalcScore());
      ptc(COL_KEY, 98, 76, t);
    }
    if (!mmVsCpu && ((now / 400UL) & 1UL)) {
      ptc(COL_TEXT, 98, 108, "A: next");
    }
    return;
  }
  snprintf(t, sizeof(t), "Try %d/%d", (int)mmN + 1, (int)mmTries);
  pt(98, 14, t);
  if (mmAid) snprintf(t, sizeof(t), "~%d left", (int)mmLeft);   // <= 10 chars
  else if (mmVsCpu) snprintf(t, sizeof(t), "%d colors", (int)mmCols);
  else snprintf(t, sizeof(t), "%s guess", mmName(3 - mmSetter));
  pt(98, 26, t);
  for (int i = 0; i < mmCols; i++) {
    int sx = 98 + (i % 4) * 15, sy = 38 + (i / 4) * 11;
    canvas->fillRect(sx, sy, 11, 8, mmCol[i + 1]);
    if (g_save.miscFlags & 8) mmGlyph(sx + 5, sy + 4, (uint8_t)(i + 1), false);
    if (mmCur[mmSlot] == i + 1) canvas->drawRect(sx - 1, sy - 1, 13, 10, COL_TEXT);
  }
  if (mmVsCpu && !g_twoPlayerMode) {   // the secret, as far as hints have revealed it
    for (int i = 0; i < mmLen; i++) {
      bool shown = false;
      for (int h = 0; h < mmHintN; h++) if (mmHintPos[h] == i) shown = true;
      mmPeg(101 + i * 10, 61, 3, shown ? mmCode[i] : 0);
    }
  }
  canvas->fillRect(98, 66, 5, 5, mmHit);
  ptc(COL_TEXT, 106, 64, "spot");
  canvas->fillRect(98, 76, 5, 5, mmNear);
  pt(106, 74, "color");
  pt(98, 88, "L/R slot");
  pt(98, 98, "U/D color");
  canvas->setCursor(98, 108);
  if (mmVsCpu && !g_twoPlayerMode && mmHintN < 2) {
    canvas->print("A:go B:clr");
    snprintf(t, sizeof(t), "St:hint %d", 2 - (int)mmHintN);
    pt(98, 118, t);
  } else {
    canvas->print("A:guess");
    pt(98, 118, "B:clear");
  }
}

// Large single row used while a player secretly enters the code (2P).
static void mmDrawSet(unsigned long now) {
  char t[28];
  canvas->setTextSize(1);
  canvas->setTextColor(COL_ORANGE);
  snprintf(t, sizeof(t), "%s: SET THE CODE", mmName(mmSetter));
  pt((160 - (int)strlen(t) * 6) / 2, 6, t);
  int x0 = 80 - (mmLen * 24) / 2 + 12;
  for (int i = 0; i < mmLen; i++) {
    int x = x0 + i * 24;
    mmPeg(x, 48, 9, mmCur[i]);
    if (i == mmSlot) canvas->drawRect(x - 11, 36, 23, 25, COL_KEY);
  }
  for (int i = 0; i < mmCols; i++) {
    int sx = 80 - (mmCols * 16) / 2 + i * 16;
    canvas->fillRect(sx, 76, 12, 9, mmCol[i + 1]);
    if (g_save.miscFlags & 8) mmGlyph(sx + 6, 80, (uint8_t)(i + 1), false);
    if (mmCur[mmSlot] == i + 1) canvas->drawRect(sx - 1, 75, 14, 11, COL_TEXT);
  }
  ptc(COL_TEXT, 4, 96, "L/R slot  U/D color");
  pt(4, 106, "B: clear");
  if ((now / 400UL) & 1UL) {
    pt(4, 118, "A: lock in the code");
  }
}

static void mmDrawPass(unsigned long now) {
  char t[28];
  canvas->setTextSize(1);
  if (mmNextPh == MP_SET) {
    canvas->setTextColor(COL_ORANGE);
    snprintf(t, sizeof(t), "PLAYER %d", (int)mmWho);
    canvas->setTextSize(2);
    pt((160 - (int)strlen(t) * 12) / 2, 22, t);
    canvas->setTextSize(1);
    ptc(COL_TEXT, 22, 52, "sets the secret code");
    canvas->setTextColor(COL_KEY);
    snprintf(t, sizeof(t), "Player %d: look away!", 3 - (int)mmWho);
    pt(16, 68, t);
  } else {
    ptc(mmHit, 46, 18, "CODE LOCKED");
    canvas->setTextColor(COL_ORANGE);
    snprintf(t, sizeof(t), "PLAYER %d", (int)mmWho);
    canvas->setTextSize(2);
    pt((160 - (int)strlen(t) * 12) / 2, 38, t);
    canvas->setTextSize(1);
    ptc(COL_TEXT, 28, 66, "guesses the code");
    pt(34, 78, "Pass the device");
  }
  canvas->setTextColor(COL_TEXT);
  if ((now / 400UL) & 1UL) {
    pt(4, 112, mmNextPh == MP_SET ? "A: continue" : "A: start guessing");
  }
}

static void drawMindScene(unsigned long now) {
  canvas->fillScreen(COL_BG);
  if (mmPh == MP_PASS) mmDrawPass(now);
  else if (mmPh == MP_SET) mmDrawSet(now);
  else {
    mmDrawBoard();
    mmDrawPanel(now);
  }
  particlesUpdateDraw();
}

static void drawMindOverScreen() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  char sb[32];
  const char* msg;
  uint16_t hc = COL_ORANGE;
  if (mmVsCpu) {
    msg = mmSolved ? "CODE CRACKED!" : "OUT OF GUESSES";
    if (!mmSolved) hc = COL_LASER;
  } else {
    msg = mmWinner == 1 ? "PLAYER 1 WINS" : mmWinner == 2 ? "PLAYER 2 WINS" : "DRAW";
  }
  ptc(hc, (160 - (int)strlen(msg) * 6) / 2, 14, msg);
  canvas->setTextColor(COL_TEXT);
  if (mmVsCpu) {
    snprintf(sb, sizeof(sb), "Guesses: %d/%d", (int)mmN, (int)mmTries);
    pt(4, 28, sb);
    canvas->setCursor(4, 40);
    if (mmSolved) {
      if (mmCustom) snprintf(sb, sizeof(sb), "Custom code: no score");
      else snprintf(sb, sizeof(sb), "Score: %d", mmScore);
      canvas->print(sb);
    } else {
      canvas->print("No score this time");
    }
    pt(4, 54, "Code:");
    for (int i = 0; i < mmLen; i++) mmPeg(52 + i * 12, 57, 4, mmCode[i]);
    pt(4, 68, "Difficulty: ");
    canvas->print(kAiTierNames[g_variant & 3]);
    snprintf(sb, sizeof(sb), "Cracked %d  Failed %d", mmSb[0][0], mmSb[0][1]);
    pt(4, 80, sb);
    drawBestLineOver(52, 92);
  } else {
    for (int p = 0; p < 2; p++) {
      if (mmRes[p] <= (int)mmTries) snprintf(sb, sizeof(sb), "P%d cracked it in %d", p + 1, mmRes[p]);
      else snprintf(sb, sizeof(sb), "P%d: not cracked", p + 1);
      pt(4, 30 + p * 12, sb);
    }
    snprintf(sb, sizeof(sb), "P1 %d  P2 %d  Draws %d", mmSb[1][0], mmSb[1][1], mmSb[1][2]);
    pt(4, 58, sb);
    pt(4, 70, mmFirst == 1 ? "P1 sets the code next" : "P2 sets the code next");
  }
  canvas->setCursor(4, 108);
  animPrompt("A/Start: rematch B: back");
  blitScreen();
}

static void mmFinishCpu() {
  mmSb[0][mmSolved ? 0 : 1]++;
  if (mmSolved) {
    mmScore = mmCalcScore();
    if (mmCustom) {   // hand-made code: only the slot's own best (fewest guesses) is kept
      s_lastNewBest = false;
      lvlRecordRun(LVLGAME_MIND, (long)mmN, false);
      lvlOnClear(LVLGAME_MIND);
    } else {
      recordResult(52, g_variant, (long)mmScore, true);
    }
    sfxWin();
    pixelsWinCelebration();
  } else {
    s_lastNewBest = false;
    s_lastNewBestGame = 52;
    if (mmCustom) lvlRecordRun(LVLGAME_MIND, 0, false);
    sfxDeath();
  }
  gameState = ST_MIND_OVER;
  drawMindOverScreen();
}

static void mmFinish2P() {
  int a = mmRes[0], b = mmRes[1];
  mmWinner = a < b ? 1 : (b < a ? 2 : 3);
  mmSb[1][mmWinner == 1 ? 0 : (mmWinner == 2 ? 1 : 2)]++;
  for (int p = 0; p < 2; p++)
    if (mmRes[p] <= (int)mmTries && (mmFewest[p] == 0 || mmRes[p] < mmFewest[p])) mmFewest[p] = mmRes[p];
  mmFirst = (mmFirst == 1) ? 2 : 1;   // the other player sets first in the rematch
  if (mmWinner == 3) sfx(300, 100);
  else { sfxWin(); pixelsWinCelebration(); }
  gameState = ST_MIND_OVER;
  drawMindOverScreen();
}

// A round (one code) is over: reveal it.
static void mmEndRound(bool solved) {
  mmSolved = solved;
  mmPh = MP_REVEAL;
  mmPhT0 = millis();
  if (!mmVsCpu) mmRes[(3 - (int)mmSetter) - 1] = solved ? (int)mmN : (int)mmTries + 1;
  if (solved) {
    sfx(1000, 80);
    particlesBurst(128, 48, 14, 0);
  } else {
    sfxDeath();
    pixelsFlash(255, 0, 0, 60);
  }
}

// How many of the cols^len codes give exactly the feedback recorded for every guess so far.
// At most 6^4 = 1296 candidates (4096 with a custom palette) x <= 12 guesses: a few ms.
static uint16_t mmCountLeft() {
  uint8_t cand[MM_MAXP];
  for (int i = 0; i < MM_MAXP; i++) cand[i] = 1;
  uint16_t cnt = 0;
  for (;;) {
    bool ok = true;
    for (int k = 0; k < mmN && ok; k++) {
      int cc[10], cg[10], ex = 0, ne = 0;
      memset(cc, 0, sizeof(cc));
      memset(cg, 0, sizeof(cg));
      for (int i = 0; i < mmLen; i++) {
        if (mmGuess[k][i] == cand[i]) ex++;
        else { cc[cand[i]]++; cg[mmGuess[k][i]]++; }
      }
      for (int c = 1; c <= (int)mmCols; c++) ne += cc[c] < cg[c] ? cc[c] : cg[c];
      if (mmFb[k] != (uint8_t)((ex << 4) | ne)) ok = false;
    }
    if (ok) cnt++;
    int i = 0;
    while (i < mmLen) {
      if (++cand[i] <= mmCols) break;
      cand[i] = 1;
      i++;
    }
    if (i == mmLen) break;
  }
  return cnt;
}

static void mmSubmit() {
  for (int i = 0; i < mmLen; i++) mmGuess[mmN][i] = mmCur[i];
  int cc[10], cg[10], ex = 0, ne = 0;
  memset(cc, 0, sizeof(cc));
  memset(cg, 0, sizeof(cg));
  for (int i = 0; i < mmLen; i++) {
    if (mmCur[i] == mmCode[i]) ex++;
    else { cc[mmCode[i]]++; cg[mmCur[i]]++; }
  }
  for (int k = 1; k <= (int)mmCols; k++) ne += cc[k] < cg[k] ? cc[k] : cg[k];
  mmFb[mmN] = (uint8_t)((ex << 4) | ne);
  mmN++;
  if (mmAid) mmLeft = mmCountLeft();
  if (ex == mmLen) { mmEndRound(true); return; }
  if (mmN >= mmTries) { mmEndRound(false); return; }
  sfx(380 + 110 * ex, 40);
  if (ex > 0) particlesBurst(76, mmRowY(mmN - 1), 3, mmHit);
}

// Shared peg editing for guessing and code setting. Returns true when A/Start submits a full row.
static bool mmEditInput(uint32_t pressed) {
  if (pressed & ARCADA_BUTTONMASK_LEFT) {
    if (mmSlot > 0) { mmSlot--; sfxMove(); }
  } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
    if (mmSlot + 1 < mmLen) { mmSlot++; sfxMove(); }
  } else if (pressed & ARCADA_BUTTONMASK_UP) {
    uint8_t v = mmCur[mmSlot];
    v = (v >= mmCols) ? 1 : (uint8_t)(v + 1);
    mmCur[mmSlot] = v;
    sfx(420 + 50 * v, 12);
  } else if (pressed & ARCADA_BUTTONMASK_DOWN) {
    uint8_t v = mmCur[mmSlot];
    v = (v <= 1) ? mmCols : (uint8_t)(v - 1);
    mmCur[mmSlot] = v;
    sfx(420 + 50 * v, 12);
  } else if (pressed & ARCADA_BUTTONMASK_B) {
    memset(mmCur, 0, sizeof(mmCur));
    mmSlot = 0;
    sfx(300, 15);
  } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
    bool full = true;
    for (int i = 0; i < mmLen; i++) if (mmCur[i] == 0) full = false;
    if (full) return true;
    sfxBlocked();
  }
  return false;
}

static void mindFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  bool hintOk = (mmPh == MP_GUESS && mmVsCpu && !g_twoPlayerMode);
  if (now - mmLastFrameMs > 150UL) { mmStartArmed = false; mmStartDown = false; }   // resumed from pause / first frame
  mmLastFrameMs = now;
  if (hintOk) {   // Start TAP (released within 500 ms) = hint; a longer hold is the pause gesture
    bool sd = (buttons & ARCADA_BUTTONMASK_START) != 0;
    if (!sd) mmStartArmed = true;
    if ((pressed & ARCADA_BUTTONMASK_START) && mmStartArmed && !mmStartDown) { mmStartDown = true; mmStartT0 = now; }
    else if (!sd && mmStartDown) {
      mmStartDown = false;
      if (now - mmStartT0 < 500UL) mmHint();
    }
    pressed &= ~(uint32_t)ARCADA_BUTTONMASK_START;   // Start no longer submits the row here (A does)
  } else {
    mmStartDown = false;
    if (!(buttons & ARCADA_BUTTONMASK_START)) mmStartArmed = true;
  }
  if (mmPh == MP_PASS) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      mmPh = mmNextPh;
      memset(mmCur, 0, sizeof(mmCur));
      mmSlot = 0;
      sfx(600, 30);
    }
  } else if (mmPh == MP_SET) {
    if (mmEditInput(pressed)) {            // lock the code, hide it behind the hand-over screen
      memcpy(mmCode, mmCur, sizeof(mmCode));
      memset(mmCur, 0, sizeof(mmCur));
      mmSlot = 0;
      mmN = 0;
      mmWho = (uint8_t)(3 - mmSetter);
      mmNextPh = MP_GUESS;
      mmPh = MP_PASS;
      sfx(800, 60);
    }
  } else if (mmPh == MP_GUESS) {
    if (mmEditInput(pressed)) mmSubmit();
  } else if (mmVsCpu) {
    if (now - mmPhT0 >= 1200UL) { mmFinishCpu(); return; }
  } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
    if (mmRound == 0) {                    // second round: swap the roles
      mmRound = 1;
      mmSetter = (uint8_t)(3 - mmSetter);
      mmN = 0;
      memset(mmGuess, 0, sizeof(mmGuess));
      memset(mmFb, 0, sizeof(mmFb));
      memset(mmCur, 0, sizeof(mmCur));
      mmSlot = 0;
      mmWho = mmSetter;
      mmNextPh = MP_SET;
      mmPh = MP_PASS;
      sfx(500, 40);
    } else {
      mmFinish2P();
      return;
    }
  }
  drawMindScene(now);
  blitScreen();
}

// --- Checkers --------------------------------------------------------------------------
//
// American draughts on the 32 dark squares of an 8x8 board (square s = row*4 + col/2). Side 1
// (cream, bottom, moves up) is the human / P1; side 2 (red, top) is the CPU / P2. Men move and
// capture one diagonal step forward, kings both ways. Captures are MANDATORY and a capturing piece
// must keep jumping while it can (the chain is walked step by step; a man that reaches the far
// row is crowned and stops). Chains are capped at 7 jumps. The game ends when the side to move has
// no legal move (no pieces or all blocked); 80 plies (40 moves each) without a capture is a draw.
// Two modes like Reversi: vs CPU (g_variant 0 NORMAL = greedy 1-ply material, 1 EASY = mostly random,
// 2 HARD = 3-ply alpha-beta, 3 EXTREME = iterative-deepening alpha-beta up to 5 ply, 4000 nodes /
// 280 ms with the last completed depth's move as the fallback) or 2 PLAYERS hot-seat (the opener
// alternates). vs-CPU score on a win = 100 + 10 x piece difference (min 10).
// A move is stored as a flat byte path: [0] = (squares | 0x80 if it captures), [1..n] = squares.

#define CK_MP 9
#define CK_MAXM 32
#define CK_CELL 14
#define CK_X0 4
#define CK_Y0 8
static const int8_t kCkNb[32][4] = {   // neighbours of each square: up-left, up-right, down-left, down-right
  {-1,-1,4,5}, {-1,-1,5,6}, {-1,-1,6,7}, {-1,-1,7,-1},
  {-1,0,-1,8}, {0,1,8,9}, {1,2,9,10}, {2,3,10,11},
  {4,5,12,13}, {5,6,13,14}, {6,7,14,15}, {7,-1,15,-1},
  {-1,8,-1,16}, {8,9,16,17}, {9,10,17,18}, {10,11,18,19},
  {12,13,20,21}, {13,14,21,22}, {14,15,22,23}, {15,-1,23,-1},
  {-1,16,-1,24}, {16,17,24,25}, {17,18,25,26}, {18,19,26,27},
  {20,21,28,29}, {21,22,29,30}, {22,23,30,31}, {23,-1,31,-1},
  {-1,24,-1,-1}, {24,25,-1,-1}, {25,26,-1,-1}, {26,27,-1,-1},
};
static int8_t ckBd[32];                 // 0 empty, 1 side-1 man, 2 side-1 king, 3 side-2 man, 4 side-2 king
static uint8_t ckMv[CK_MAXM * CK_MP];   // the mover's legal moves at the start of the turn
static uint8_t ckCand[CK_MAXM];         // moves still matching the human's partial input
static uint8_t ckPick[CK_MP];           // the CPU's chosen move
static uint8_t ckNMv, ckNCand, ckK, ckTurn, ckCpuK, ckCr, ckCc;
static uint8_t ckThinkD, ckThinkMax;     // EXTREME search progress shown as "d4/6" (0 = nothing)
static void drawCkScene(unsigned long now);
static int8_t ckSel, ckLastFrom, ckLastTo, ckPromoSq, ckWinner;
static uint32_t ckDest, ckMovable;
static bool ckVsCpu = true;             // mode: true = vs CPU, false = 2 PLAYERS
static bool ckMust, ckCapThis, ckEnding, ckCpuPlanned, ckAbort, ckFancy;
static int ckSb[2][3];                  // scoreboard [0 = vs CPU, 1 = 2P][P1/You, P2/CPU, draws]
static int8_t ckFirst = 1;              // 2P: who opens the next game
static int ckQuiet;
static uint32_t ckNodes, ckNodeCap;
static unsigned long ckDeadline, ckCpuAt, ckBusyUntil, ckEndAt, ckPromoT0, ckRepT;
static uint16_t ckColL, ckColD, ckPc1, ckPc2, ckGold;
// 2P board flip: the logic always works on the real board; ckSqX/ckSqY map a square to its screen
// position through ckDrawFlip (square s <-> 31-s when rotated 180 degrees). The cursor lives in
// SCREEN cells and is mapped back to a logical square only when A is pressed.
static bool ckFlipOpt = true;           // title option (2 PLAYERS): rotate the board for P2
static bool ckViewFlip = false;         // orientation for the side to move
static bool ckViewOld = false;          // orientation before the running flip animation
static bool ckDrawFlip = false;         // orientation used by this frame's drawing
static unsigned long ckFlipT0 = 0;      // flip animation start (0 = none)
static unsigned long ckRepStart = 0;    // last-move replay start (0 = none)
static unsigned long ckStartT0 = 0;
static bool ckStartDown = false, ckUndoOk = false;
static bool ckStartArmed = false, ckTapPending = false;   // Start seen released / an Undo tap waiting out the busy window
static unsigned long ckLastFrameMs = 0;
static uint8_t ckLastMv[CK_MP], ckUndoLastMv[CK_MP];   // last move's path (flat move format)
static int8_t ckUndoBd[32], ckUndoFrom, ckUndoTo;      // one-level undo snapshot (2 PLAYERS)
static int ckUndoQuiet;
// Transposition table for the EXTREME CPU: 128 entries x 8 B.
struct CkTT { uint32_t key; int16_t score; uint8_t depth, flag; };   // flag 1 exact, 2 lower bound, 3 upper bound
static CkTT ckTT[128];

static int ckOwner(int v) { return v ? ((v - 1) >> 1) + 1 : 0; }
static bool ckDirOk(int side, bool king, int d) { return king || (side == 1 ? d < 2 : d >= 2); }
static bool ckPromoRow(int side, int s) { return side == 1 ? s < 4 : s >= 28; }
static const char* ckName(int who) {
  if (ckVsCpu) return who == 1 ? "YOU" : "CPU";
  return who == 1 ? "P1" : "P2";
}
// Square the piece jumps over when going a -> b (-1 if they are not a jump apart).
static int ckMid(int a, int b) {
  for (int d = 0; d < 4; d++) {
    int m = kCkNb[a][d];
    if (m >= 0 && kCkNb[m][d] == b) return m;
  }
  return -1;
}
static bool ckCanJump(const int8_t* bd, int side, int s, bool king) {
  for (int d = 0; d < 4; d++) {
    if (!ckDirOk(side, king, d)) continue;
    int mid = kCkNb[s][d];
    if (mid < 0 || !bd[mid] || ckOwner(bd[mid]) == side) continue;
    int land = kCkNb[mid][d];
    if (land >= 0 && !bd[land]) return true;
  }
  return false;
}

// Generates every legal move of `side` into out (stride CK_MP); returns the count. Captures are
// mandatory (when any exist only they are returned). Jump chains are walked with an explicit
// stack (no recursion); the board is modified while walking and restored before returning.
static int ckGen(int8_t* bd, int side, uint8_t* out, int maxm) {
  int n = 0;
  for (int s = 0; s < 32 && n < maxm; s++) {
    int v = bd[s];
    if (!v || ckOwner(v) != side) continue;
    bool king = !(v & 1);
    uint8_t sq[CK_MP], cs[CK_MP], cv[CK_MP];
    int8_t dir[CK_MP];
    int depth = 0;
    sq[0] = (uint8_t)s;
    dir[0] = 0;
    cs[0] = 0;
    cv[0] = 0;
    bd[s] = 0;
    while (depth >= 0) {
      if (dir[depth] >= 4) {
        if (depth > 0) bd[cs[depth]] = (int8_t)cv[depth];   // take the capture back
        depth--;
        continue;
      }
      int d = dir[depth]++;
      if (!ckDirOk(side, king, d)) continue;
      int mid = kCkNb[sq[depth]][d];
      if (mid < 0) continue;
      int mv = bd[mid];
      if (!mv || ckOwner(mv) == side) continue;
      int land = kCkNb[mid][d];
      if (land < 0 || bd[land]) continue;
      depth++;
      sq[depth] = (uint8_t)land;
      dir[depth] = 0;
      cs[depth] = (uint8_t)mid;
      cv[depth] = (uint8_t)mv;
      bd[mid] = 0;
      bool more = !(!king && ckPromoRow(side, land)) && depth < CK_MP - 2 && ckCanJump(bd, side, land, king);
      if (more) continue;            // keep walking from the landing square
      if (n < maxm) {                // the chain ends here: record it
        uint8_t* o = out + n * CK_MP;
        o[0] = (uint8_t)((depth + 1) | 0x80);
        for (int k = 0; k <= depth; k++) o[1 + k] = sq[k];
        n++;
      }
      bd[cs[depth]] = (int8_t)cv[depth];
      depth--;
    }
    bd[s] = (int8_t)v;
  }
  if (n > 0) return n;
  for (int s = 0; s < 32 && n < maxm; s++) {
    int v = bd[s];
    if (!v || ckOwner(v) != side) continue;
    bool king = !(v & 1);
    for (int d = 0; d < 4 && n < maxm; d++) {
      if (!ckDirOk(side, king, d)) continue;
      int to = kCkNb[s][d];
      if (to < 0 || bd[to]) continue;
      uint8_t* o = out + n * CK_MP;
      o[0] = 2;
      o[1] = (uint8_t)s;
      o[2] = (uint8_t)to;
      n++;
    }
  }
  return n;
}

// Plays a whole move on a scratch board (captures, then crowning at the end).
static void ckApplyMove(int8_t* bd, const uint8_t* mv) {
  int n = mv[0] & 0x7F;
  bool cap = (mv[0] & 0x80) != 0;
  int v = bd[mv[1]];
  bd[mv[1]] = 0;
  for (int k = 1; k < n; k++) {
    if (cap) {
      int mid = ckMid(mv[k], mv[k + 1]);
      if (mid >= 0) bd[mid] = 0;
    }
  }
  int to = mv[n];
  if ((v & 1) && ckPromoRow(ckOwner(v), to)) v++;
  bd[to] = (int8_t)v;
}

static int ckEval(const int8_t* bd, int side) {
  int s1 = 0, s2 = 0;
  for (int s = 0; s < 32; s++) {
    int v = bd[s];
    if (!v) continue;
    int own = ckOwner(v), r = s >> 2, val;
    if (v & 1) {
      int adv = own == 1 ? 7 - r : r;
      val = 100 + 3 * adv;
      if (ckFancy) {
        if (adv == 0) val += 6;
        else if (r >= 2 && r <= 5 && ((s & 3) == 1 || (s & 3) == 2)) val += 2;
      }
    } else {
      val = 165;
    }
    if (own == 1) s1 += val; else s2 += val;
  }
  return side == 1 ? s1 - s2 : s2 - s1;
}

// Negamax with alpha-beta from `side`'s point of view. depth = plies left; ext = how many
// capture extensions may still be granted at the horizon; ply = distance from the root.
static uint32_t ckHash(const int8_t* bd, int side, int ext) {
  uint32_t h = 2166136261u;
  for (int i = 0; i < 32; i++) { h ^= (uint8_t)bd[i]; h *= 16777619u; }
  h ^= (uint32_t)side * 0x9E3779B1u;
  h ^= (uint32_t)ext * 0x85EBCA6Bu;
  return h ? h : 1u;
}
// Move-ordering key (EXTREME only): long captures, promotions, king moves, then advances.
static int ckMoveKey(const int8_t* bd, const uint8_t* m, int side) {
  int n = m[0] & 0x7F, to = m[n];
  bool king = !(bd[m[1]] & 1);
  int k = (m[0] & 0x80) ? 20 + 3 * n : 0;
  if (king) k += 4;
  else if (ckPromoRow(side, to)) k += 8;
  else k += side == 1 ? 7 - (to >> 2) : (to >> 2);
  return k;
}
static int ckNeg(int8_t* bd, int side, int depth, int alpha, int beta, int ext, int ply) {
  ckNodes++;
  if (ckNodes > ckNodeCap || ((ckNodes & 31) == 0 && millis() > ckDeadline)) ckAbort = true;
  if (ckAbort) return ckEval(bd, side);
  CkTT* te = NULL;
  uint32_t key = 0;
  const int a0 = alpha;
  if (ckFancy && depth >= 1) {
    key = ckHash(bd, side, ext);
    te = &ckTT[key & 127u];
    if (te->flag && te->key == key && te->depth >= depth) {
      int sc = te->score;
      if (te->flag == 1) return sc;
      if (te->flag == 2 && sc >= beta) return sc;
      if (te->flag == 3 && sc <= alpha) return sc;
    }
  }
  uint8_t mv[CK_MAXM * CK_MP];
  int n = ckGen(bd, side, mv, CK_MAXM);
  if (n == 0) return -20000 + ply;
  if (depth <= 0) {
    if (ext > 0 && (mv[0] & 0x80)) { depth = 1; ext--; }
    else return ckEval(bd, side);
  }
  uint8_t ord[CK_MAXM];
  for (int i = 0; i < n; i++) ord[i] = (uint8_t)i;
  if (ckFancy && n > 1) {   // insertion sort by key, best first
    int8_t ky[CK_MAXM];
    for (int i = 0; i < n; i++) ky[i] = (int8_t)ckMoveKey(bd, mv + i * CK_MP, side);
    for (int i = 1; i < n; i++) {
      uint8_t o = ord[i];
      int8_t kk = ky[o];
      int j = i - 1;
      while (j >= 0 && ky[ord[j]] < kk) { ord[j + 1] = ord[j]; j--; }
      ord[j + 1] = o;
    }
  }
  int best = -1000000;
  for (int q = 0; q < n; q++) {
    int i = ord[q];
    int8_t nb[32];
    memcpy(nb, bd, 32);
    ckApplyMove(nb, mv + i * CK_MP);
    int v = -ckNeg(nb, 3 - side, depth - 1, -beta, -alpha, ext, ply + 1);
    if (v > best) best = v;
    if (best > alpha) alpha = best;
    if (alpha >= beta || ckAbort) break;
  }
  if (te && !ckAbort && best > -19000 && best < 19000) {
    te->key = key;
    te->score = (int16_t)best;
    te->depth = (uint8_t)depth;
    te->flag = best <= a0 ? 3 : (best >= beta ? 2 : 1);
  }
  return best;
}

// The CPU (side 2) chooses its move into ckPick.
static void ckCpuPlan() {
  int8_t wb[32];
  memcpy(wb, ckBd, 32);
  uint8_t mv[CK_MAXM * CK_MP];
  int n = ckGen(wb, 2, mv, CK_MAXM);
  if (n <= 0) { ckPick[0] = 0; return; }
  int pick = 0, tier = g_variant & 3;   // 0 NORMAL, 1 EASY, 2 HARD, 3 EXTREME
  ckFancy = false;
  if (n > 1) {
    if (tier == 1) {                    // EASY: usually the biggest capture, otherwise anything
      if (mazeRngRange(100) < 60) {
        int bl = 0, cand[CK_MAXM], nc = 0;
        for (int i = 0; i < n; i++) if ((mv[i * CK_MP] & 0x7F) > bl) bl = mv[i * CK_MP] & 0x7F;
        for (int i = 0; i < n; i++) if ((mv[i * CK_MP] & 0x7F) == bl) cand[nc++] = i;
        pick = cand[mazeRngRange(nc)];
      } else {
        pick = mazeRngRange(n);
      }
    } else {
      int bestV = -1000000, bi = -1;
      int off = mazeRngRange(n);
      if (tier >= 2) {                  // HARD / EXTREME: iterative deepening, keep the last full depth
        ckNodes = 0;
        ckAbort = false;
        ckNodeCap = (tier == 3) ? 6000u : 2500u;
        ckDeadline = millis() + 280UL;
        ckFancy = (tier == 3);
        if (ckFancy) memset(ckTT, 0, sizeof(ckTT));
        int maxD = (tier == 3) ? 6 : 3;
        for (int D = 1; D <= maxD; D++) {
          int dv = -1000000, di = -1;
          for (int j = 0; j < n; j++) {
            int i = (j + off) % n;
            int8_t nb[32];
            memcpy(nb, ckBd, 32);
            ckApplyMove(nb, mv + i * CK_MP);
            int v = -ckNeg(nb, 1, D - 1, -1000000, -dv, 2, 1);
            if (ckAbort) break;
            if (v > dv) { dv = v; di = i; }
          }
          if (ckAbort || di < 0) break;
          bi = di;
          bestV = dv;
          if (tier == 3) { ckThinkD = (uint8_t)D; ckThinkMax = (uint8_t)maxD; drawCkScene(millis()); blitScreen(); }   // depth indicator
          if (dv > 15000) break;        // a forced win is in sight
        }
        ckFancy = false;
        ckThinkD = 0;
      }
      if (bi < 0) {                     // NORMAL (or an out-of-budget search): greedy 1-ply material
        bestV = -1000000;
        int cand[CK_MAXM], nc = 0;
        for (int j = 0; j < n; j++) {
          int8_t nb[32];
          memcpy(nb, ckBd, 32);
          ckApplyMove(nb, mv + j * CK_MP);
          int v = ckEval(nb, 2);
          if (v > bestV) { bestV = v; nc = 0; }
          if (v == bestV) cand[nc++] = j;
        }
        bi = cand[mazeRngRange(nc)];
      }
      pick = bi;
    }
  }
  memcpy(ckPick, mv + pick * CK_MP, CK_MP);
}

static int ckCount(int side) {
  int c = 0;
  for (int s = 0; s < 32; s++) if (ckOwner(ckBd[s]) == side) c++;
  return c;
}
// ckMapSq: logical square -> displayed square (identity, or 180 degrees for the flipped view).
static int ckMapSq(int s) { return ckDrawFlip ? 31 - s : s; }
static int ckSqX(int s) { s = ckMapSq(s); int r = s >> 2; return CK_X0 + (2 * (s & 3) + ((r & 1) ? 0 : 1)) * CK_CELL + CK_CELL / 2; }
static int ckSqY(int s) { s = ckMapSq(s); return CK_Y0 + (s >> 2) * CK_CELL + CK_CELL / 2; }

