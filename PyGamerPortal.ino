static void chsFinish(int winnerColor, uint8_t why);
static void chsBeginTurn() {
  uint16_t lm[224];
  int n = chsLegal(lm, 224);
  chsInChk = chsAttacked(chsKing[chsSide], chsSide ^ 1);
  if (n == 0) {
    if (chsInChk) chsFinish(chsSide ^ 1, 1);
    else chsFinish(-1, 2);
    return;
  }
  if (chsInsufficient()) { chsFinish(-1, 3); return; }
  if (chsRepCount(chsHash()) >= 3) { chsFinish(-1, 5); return; }
  if (chsHalf >= 100) { chsFinish(-1, 4); return; }
  chsMovable = 0;
  for (int i = 0; i < n; i++) chsMovable |= (1ULL << (lm[i] & 63));
  chsSel = -1;
  chsDest = 0;
  chsPromoPick = false;
  unsigned long now = millis();
  {   // 2 PLAYERS: Black sees the board turned (animated when it changes); the cursor turns with it
    bool want = (!chsVsCpu && chsFlipOpt && chsSide == 1);
    if (want != chsViewFlip) {
      chsViewOld = chsViewFlip;
      chsViewFlip = want;
      chsFlipT0 = now ? now : 1UL;
      if (chsBusyUntil < now + 340UL) chsBusyUntil = now + 340UL;
      chsCr = (uint8_t)(7 - chsCr);
      chsCc = (uint8_t)(7 - chsCc);
    }
  }
  if (chsVsCpu && chsSide == 1) chsCpuAt = now + 450UL + (unsigned long)mazeRngRange(300);
}

static void chsStartGame(bool resume) {
  static const uint8_t back[8] = {4, 2, 3, 5, 6, 3, 2, 4};
  memset(chsB, 0, sizeof(chsB));
  for (int f = 0; f < 8; f++) {
    chsB[f] = (int8_t)back[f];
    chsB[16 + f] = 1;
    chsB[96 + f] = 9;
    chsB[112 + f] = (int8_t)(back[f] | 8);
  }
  chsSide = 0;
  chsCastle = 15;
  chsEp = -1;
  chsHalf = 0;
  chsKing[0] = 4;
  chsKing[1] = 116;
  chsQueenOnly = false;
  chsColL = arcada.display->color565(236, 214, 176);
  chsColD = arcada.display->color565(170, 124, 88);
  chsPcW = arcada.display->color565(252, 250, 240);
  chsPcWo = arcada.display->color565(24, 20, 16);
  chsPcB = arcada.display->color565(40, 40, 54);
  chsPcBo = arcada.display->color565(226, 226, 214);
  chsHiLast = arcada.display->color565(205, 190, 90);
  chsHiSel = arcada.display->color565(120, 190, 120);
  chsHiChk = arcada.display->color565(215, 70, 60);
  chsLastFrom = chsLastTo = chsAnimFrom = chsAnimTo = -1;
  chsSel = -1;
  chsWinner = 0;
  chsEndWhy = 0;
  chsEnding = false;
  chsPromoPick = false;
  chsInChk = false;
  chsUndoOk = false;
  chsStartDown = false;
  chsStartArmed = false;
  chsTapPending = false;
  chsBusyUntil = 0;
  chsRepT = 0;
  chsThinkD = 0;
  chsViewFlip = chsViewOld = chsDrawFlip = false;
  chsFlipT0 = 0;
  chsCr = 6;
  chsCc = 4;
  chsPly = 0;
  chsHinted = false;
  chsBPend = false;
  chsBookUsed = false;
  chsHintFrom = chsHintTo = -1;
  chsHintUntil = 0;
  memset(chsPlyMv, 0, sizeof(chsPlyMv));
  chsClockMs[0] = chsClockMs[1] = chsClockMode == 1 ? 300000L : (chsClockMode == 2 ? 600000L : 0L);
  if (resume) {
    if (!chsSaveLoad()) { chsSaveClear(); chsStartGame(false); return; }   // unusable save: start fresh
    miscSetFlag(MF_ACH_RESUME, true);
  }
  // A new game does not delete the saved one yet: it is replaced by the first autosave /
  // leave-save (or cleared when this game ends), so Restart -> Back loses nothing.
  chsAutoCnt = (uint8_t)(chsPly % 6);
  chsHistN = 0;
  chsHistBase = 0;
  chsHistPush(chsHash(), true);
  s_mazeRng = (millis() ^ 0xC0FFEEu) | 1u;
  gameState = ST_CHESS_PLAYING;
  chsBeginTurn();
  if (resume) checkAchievements();   // "Resume Play"
}
static void enterChsPlaying() { chsStartGame(false); }

static void drawChsOverScreen() {
  canvas->fillScreen(COL_BG);
