  g_saveExt.version = SAVE_EXT_VERSION;
  for (int g = 0; g < SAVE_EXT_GAMES; g++)
    for (int t = 0; t < SAVE_TIERS; t++) g_saveExt.best[g][t] = SAVE_EXT_NO_SCORE;
}
static int32_t saveBest(int g, int t) {
  if (t < 0 || t >= SAVE_TIERS || g < 0) return SAVE_NO_SCORE;
  if (g < SAVE_MAX_GAMES) return g_save.best[g][t];
  if (g < SAVE_TOTAL_GAMES) return g_saveExt.best[g - SAVE_MAX_GAMES][t];
  return SAVE_NO_SCORE;
}
static void saveSetBest(int g, int t, int32_t v) {
  if (t < 0 || t >= SAVE_TIERS || g < 0) return;
  if (g < SAVE_MAX_GAMES) g_save.best[g][t] = v;
  else if (g < SAVE_TOTAL_GAMES) g_saveExt.best[g - SAVE_MAX_GAMES][t] = v;
}
static uint16_t savePlays(int g) {
  if (g < 0) return 0;
  if (g < SAVE_MAX_GAMES) return g_save.gamesPlayed[g];
  if (g < SAVE_TOTAL_GAMES) return g_saveExt.gamesPlayed[g - SAVE_MAX_GAMES];
  return 0;
}
static void saveSetPlays(int g, uint16_t v) {
  if (g < 0) return;
  if (g < SAVE_MAX_GAMES) g_save.gamesPlayed[g] = v;
  else if (g < SAVE_TOTAL_GAMES) g_saveExt.gamesPlayed[g - SAVE_MAX_GAMES] = v;
}
