// --- Wall Pong ---------------------------------------------------------
//
// Solo squash-style pong: defend the left edge with a paddle that slides
// up/down, keep the ball alive off the top, bottom and right walls.
// Score is rally length; speed ramps up the longer you survive.

static float pongPaddleY, pongBallX, pongBallY, pongBallVX, pongBallVY;
static int pongScore, pongBestScore, pongLives;
static float pongBallSpeedBase = 60.0f;
#define PONG_PADDLE_H 26
#define PONG_PADDLE_W 4
#define PONG_BALL_SIZE 4
// Simultaneous 2P (g_twoPlayerMode): P1 = joystick on the left paddle, P2 = A (up) / B (down)
// on the right paddle. The PyGamer's only directional control is the joystick, so P2 can't
// have an independent stick. First to PONG_2P_WIN points wins.
#define PONG_2P_WIN 5
static float pongPaddle2Y;
static int pong2S1, pong2S2;
static int8_t pong2Winner;
// Level-creator obstacles: one 16x16 block per grid cell of the 10x7 play field
static uint8_t pongBlocks[VIEW_ROWS][VIEW_COLS];
static bool pongHasBlocks = false;

static void pongLoadCustom(const LevelData *lvl) {
  memset(pongBlocks, 0, sizeof(pongBlocks));
  pongHasBlocks = false;
  for (int r = 0; r < lvl->h && r < VIEW_ROWS; r++)
    for (int c = 0; c < lvl->w && c < VIEW_COLS; c++)
      if (lvl->cells[r][c] == 1) { pongBlocks[r][c] = 1; pongHasBlocks = true; }
}

static bool pongValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int n = 0;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++)
      if (lvl->cells[r][c] == 1) n++;
  if (n < 1) { snprintf(msg, msgLen, "Need at least 1 block"); return false; }
  if (n > 14) { snprintf(msg, msgLen, "Max 14 blocks"); return false; }
  for (int r = 0; r < lvl->h; r++)
    if (lvl->cells[r][0] == 1 || lvl->cells[r][lvl->w - 1] == 1) {
      snprintf(msg, msgLen, "Keep left/right col clear");
      return false;
    }
  if (lvl->cells[3][5] == 1) { snprintf(msg, msgLen, "Keep center clear"); return false; }
  return true;
}

// Bounce the ball off at most one obstacle block per frame (axis of least penetration).
static void pongBlockBounce() {
  if (!pongHasBlocks) return;
  int c0 = (int)pongBallX / TILE_SIZE, c1 = ((int)pongBallX + PONG_BALL_SIZE - 1) / TILE_SIZE;
  int r0 = ((int)pongBallY - HUD_HEIGHT) / TILE_SIZE;
  int r1 = ((int)pongBallY + PONG_BALL_SIZE - 1 - HUD_HEIGHT) / TILE_SIZE;
  if (pongBallX < 0 || pongBallY < HUD_HEIGHT) return;
  if (c1 >= VIEW_COLS) c1 = VIEW_COLS - 1;
  if (r1 >= VIEW_ROWS) r1 = VIEW_ROWS - 1;
  for (int r = r0; r <= r1; r++) {
    for (int c = c0; c <= c1; c++) {
      if (!pongBlocks[r][c]) continue;
      float cx0 = (float)(c * TILE_SIZE), cy0 = (float)(HUD_HEIGHT + r * TILE_SIZE);
      float ox = fminf(pongBallX + PONG_BALL_SIZE, cx0 + TILE_SIZE) - fmaxf(pongBallX, cx0);
      float oy = fminf(pongBallY + PONG_BALL_SIZE, cy0 + TILE_SIZE) - fmaxf(pongBallY, cy0);
      if (ox <= 0 || oy <= 0) continue;
      if (ox < oy) {
        if (pongBallX + PONG_BALL_SIZE / 2.0f < cx0 + TILE_SIZE / 2.0f) {
          pongBallX -= ox; pongBallVX = -fabsf(pongBallVX);
        } else {
          pongBallX += ox; pongBallVX = fabsf(pongBallVX);
        }
      } else {
        if (pongBallY + PONG_BALL_SIZE / 2.0f < cy0 + TILE_SIZE / 2.0f) {
          pongBallY -= oy; pongBallVY = -fabsf(pongBallVY);
        } else {
          pongBallY += oy; pongBallVY = fabsf(pongBallVY);
        }
      }
      sfx(380, 15);
      return;
    }
  }
}

