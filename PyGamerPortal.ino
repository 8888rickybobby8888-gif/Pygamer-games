// Picks the cell size for the current game so the grid fills the area between
// the 10px header and the ~22px footer (160 x 94 px).
static void lvlLayout(uint8_t game) {
  const LevelGameConfig *cfg = &kLevelGames[game];
  int w = cfg->w, h = cfg->h;
  bool oneD = (cfg->flags & LVLF_1D) != 0;
  int cw = 160 / w;
  int maxc = oneD ? 16 : cfg->cellPx;
  if (cw > maxc) cw = maxc;
  int ch;
  if (oneD) {
    ch = cw * 2;
    if (ch > 94) ch = 94;
  } else {
    int c2 = 94 / h;
    if (cw > c2) cw = c2;
    ch = cw;
  }
  if (cw < 3) cw = 3;
  if (ch < 3) ch = 3;
  int gw = w * cw, gh = h * ch;
  s_lvlCw = (uint8_t)cw;
  s_lvlCh = (uint8_t)ch;
  s_lvlGx = (uint8_t)((160 - gw) / 2);
  s_lvlGy = (uint8_t)(11 + (94 - gh) / 2);
}

// Small tick mark (two short lines, 7x6 px) used for "verified".
static void lvlDrawTick(int x, int y, uint16_t col) {
  canvas->drawLine(x, y + 3, x + 2, y + 5, col);
  canvas->drawLine(x, y + 2, x + 2, y + 4, col);
  canvas->drawLine(x + 2, y + 5, x + 6, y, col);
  canvas->drawLine(x + 2, y + 4, x + 6, y - 1, col);
}

// Highest drawable bar height of a height-bar game (its real max tile, capped at 8).
static int lvlBarMax(int numTiles) { int m = numTiles - 1; return m > 8 ? 8 : (m < 1 ? 1 : m); }

// Height (0..8) of column c in a height-bar level; the landing-pad tile takes its neighbour's height.
static int lvlBarT(const LevelData *d, int c) {
  int t = d->cells[0][c];
  if (t <= 8) return t;
  for (int k = c - 1; k >= 0; k--) if (d->cells[0][k] <= 8) return d->cells[0][k];
  for (int k = c + 1; k < d->w; k++) if (d->cells[0][k] <= 8) return d->cells[0][k];
  return 0;
}

// ---- Levels menu (picker) ----------------------------------------------------

// Road Cross records used to be "lives left" (1..3); they are seconds*10 now, and nobody clears a
// course in 0.3 s, so those old small values read as "no record yet".
static int32_t lvlBestFix(uint8_t game, int32_t b) {
  if (game == LVLGAME_ROAD && b >= 0 && b <= 3) return LVL_NO_BEST;
  return b;
}

// Rebuilds the per-slot cache (used / verified / name / best) for the current game.
static void lvlMenuRefresh() {
  if (s_pkProbeGame != s_lvlCurGame) { s_pkAvail = pkProbeFile(s_lvlCurGame); s_pkProbeGame = s_lvlCurGame; }   // "Browse Packs" row: probed once per menu visit
  if (s_lvlCacheGame == s_lvlCurGame) return;
  s_lvlUsedMask = 0;
  s_lvlVerMask = 0;
  LevelData t;
  for (int s = 0; s < LVL_SLOTS; s++) {
    s_lvlSlotName[s][0] = 0;
    s_lvlSlotBest[s] = LVL_NO_BEST;
    if (!lvlLoadSlot(s_lvlCurGame, (uint8_t)s, &t)) continue;
    s_lvlUsedMask |= (uint8_t)(1 << s);
    if (t.verified) s_lvlVerMask |= (uint8_t)(1 << s);
    memcpy(s_lvlSlotName[s], t.name, LVL_NAME_LEN + 1);
    s_lvlSlotBest[s] = lvlBestFix(s_lvlCurGame, t.best);
  }
  s_lvlPrevSlot = -1; s_lvlPrevFail = -1;
  s_lvlCacheGame = s_lvlCurGame;
}

static void lvlSlotLabel(int slot, char *out, size_t n);
static bool lvlLowerBetter(uint8_t g) {
  return g == LVLGAME_MAZE || g == LVLGAME_MINE || g == LVLGAME_ROAD || g == LVLGAME_LIGHTS || g == LVLGAME_BSTK || g == LVLGAME_MIND;
}

// Strict "a sorts before b" for the Levels menu (display order only; ties keep slot order).
static bool lvlSortLess(int a, int b) {
  if (s_lvlSort == 1) {
    char la[12], lb[12];
    lvlSlotLabel(a, la, sizeof(la));
    lvlSlotLabel(b, lb, sizeof(lb));
    return strcmp(la, lb) < 0;
  }
  if (s_lvlSort == 2) {
    bool ha = s_lvlSlotBest[a] != LVL_NO_BEST, hb = s_lvlSlotBest[b] != LVL_NO_BEST;
    if (ha != hb) return ha;
    if (!ha) return false;
    return lvlLowerBetter(s_lvlCurGame) ? s_lvlSlotBest[a] < s_lvlSlotBest[b] : s_lvlSlotBest[a] > s_lvlSlotBest[b];
  }
  if (s_lvlSort == 3) return ((s_lvlVerMask >> a) & 1) && !((s_lvlVerMask >> b) & 1);
  return false;
}

// Occupied slots in display order. out[i] is always the REAL slot index, so every action
// (play / edit / copy / delete) addresses the right file whatever the sort.
static int lvlOccupied(int *out) {
  int n = 0;
  for (int s = 0; s < LVL_SLOTS; s++)
    if (s_lvlUsedMask & (1 << s)) out[n++] = s;
  if (s_lvlSort)
    for (int i = 1; i < n; i++)
      for (int j = i; j > 0 && lvlSortLess(out[j], out[j - 1]); j--) { int t = out[j]; out[j] = out[j - 1]; out[j - 1] = t; }
  return n;
}

static LevelData *lvlPrevBuf() { return (LevelData *)s_lvlUndo; }

// Display name of a cached slot: its own name, or "Custom N" for unnamed (older) levels.
static void lvlSlotLabel(int slot, char *out, size_t n) {
  if (s_lvlSlotName[slot][0]) snprintf(out, n, "%s", s_lvlSlotName[slot]);
  else snprintf(out, n, "Custom %d", (slot & 7) + 1);
}

// Formats a per-slot best for a game (Speed Maze / Minesweeper are times, Cube Dash a percentage).
static void lvlFmtBest(uint8_t game, int32_t v, char *out, size_t n) {
  if (v == LVL_NO_BEST) { snprintf(out, n, "--"); return; }
  char tmp[24];
  if (game == LVLGAME_MAZE) snprintf(tmp, sizeof(tmp), "%ld.%lds", (long)(v / 1000), (long)((v / 100) % 10));
  else if (game == LVLGAME_MINE) snprintf(tmp, sizeof(tmp), "%lds", (long)v);
  else if (game == LVLGAME_ROAD) snprintf(tmp, sizeof(tmp), "%ld.%lds", (long)(v / 10), (long)(v % 10));
  else if (game == LVLGAME_CUBE) snprintf(tmp, sizeof(tmp), "%ld%%", (long)v);
  else snprintf(tmp, sizeof(tmp), "%ld", (long)v);
  snprintf(out, n, "%.*s", (int)n - 1, tmp);
}

// Mini render of a level: 1-3 px per cell, centred in a framed bx,by,bw,bh box.
static void lvlDrawThumb(const LevelData *d, uint8_t game, int bx, int by, int bw, int bh) {
  const LevelGameConfig *cfg = &kLevelGames[game];
  canvas->drawRect(bx, by, bw, bh, COL_ICE);
  canvas->fillRect(bx + 1, by + 1, bw - 2, bh - 2, COL_BG);
  if (!d) return;
  int w = d->w, h = d->h;
  if (h == 1 && (cfg->flags & LVLF_HBARS)) {      // height bars
    int pw = (bw - 2) / w;
    if (pw < 1) pw = 1;
    int ox = bx + 1 + ((bw - 2) - w * pw) / 2;
    int avail = bh - 4;
    for (int c = 0; c < w; c++) {
      uint8_t t = d->cells[0][c];
      if (t >= cfg->numTiles) t = cfg->defaultTile;
      int hp = 1 + lvlBarT(d, c) * (avail - 1) / lvlBarMax(cfg->numTiles);
      canvas->fillRect(ox + c * pw, by + bh - 2 - hp, pw, hp, cfg->tileColors[t]);
    }
  } else {
    int px = (bw - 2) / w;
    int py = (bh - 2) / h;
    if (py < px) px = py;
    if (px > 3) px = 3;
    if (px < 1) px = 1;
    int pw = px, ph = px;
    if (h == 1) { ph = px * 3; if (ph > bh - 2) ph = bh - 2; }
    int ox = bx + 1 + ((bw - 2) - w * pw) / 2;
    int oy = by + 1 + ((bh - 2) - h * ph) / 2;
    for (int r = 0; r < h; r++)
      for (int c = 0; c < w; c++) {
        uint8_t t = d->cells[r][c];
        if (t >= cfg->numTiles) t = cfg->defaultTile;
        canvas->fillRect(ox + c * pw, oy + r * ph, pw, ph, cfg->tileColors[t]);
      }
  }
  if (d->verified) {   // tick in the top-right corner on a dark chip
    canvas->fillRect(bx + bw - 10, by + 1, 9, 8, COL_BG);
    lvlDrawTick(bx + bw - 9, by + 3, COL_GOAL);
  }
}

