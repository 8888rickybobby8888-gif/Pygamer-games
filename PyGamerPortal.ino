      else if (pressed & ARCADA_BUTTONMASK_DOWN) memCursorY = (memCursorY + 1) % MEM_GRID;
      else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
