// Shared layout for the Stage-2 games' title and over screens (the older games
// each hand-roll theirs). Every line here is <=22 chars so it fits 160px.
static bool bannerDraw(int g, int x, int y);   // optional /assets/banners.bin art pack (defined with the filesystem code)
static void drawStdTitleEx(const char* name, uint16_t col, const char* l1, const char* l2,
                           const char* l3, int gameIdx, const char* mode) {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  // Art pack present: a 64x32 banner at (4,1) replaces the 24x24 icon; the name moves right and
  // the Best line / 3 info lines drop a few pixels. The title is drawn once per entry / mode change
  // (the animation ticks only repaint small strips), so the file is read once here, never per frame.
  const bool banner = canvas->width() >= 160 && bannerDraw(gameIdx, 4, 1);
  const int by = banner ? 4 : 0;
  ptc(col, (banner ? 116 : (VIEW_COLS * TILE_SIZE) / 2) - (int)strlen(name) * 3, 14, name);
  ptc(COL_TEXT, 4, 40 + by, l1);
  pt(4, 50 + by, l2);
  pt(4, 60 + by, l3);
  pt(4, 88, "Mode: ");
  canvas->print(mode);
  pt(4, 98, "Left/Right: change mode");
  canvas->setCursor(4, 108);
  animPrompt("A/Start: play  B: back");
  if (stdTitleHasLevels(gameIdx)) {
    canvas->setTextColor(COL_TEXT);
    canvas->setCursor(4, 118);
    lvlTitleHint((uint8_t)lvlGameFromPicker(gameIdx));
  }
  drawBestLine(gameIdx, banner ? 34 : 26);
  if (banner) {
    animAccent(74, 24, 82, gameCatColor(gameIdx));
  } else {
    drawGameIcon(4, 1, gameIdx, 3, gameCatColor(gameIdx));   // 24x24 header icon (left of the name)
    animAccent(36, 23, 88, gameCatColor(gameIdx));            // sweeping rule under the name
  }
  blitScreen();
}
static void drawStdTitle(const char* name, uint16_t col, const char* l1, const char* l2,
                         const char* l3, int gameIdx) {
  drawStdTitleEx(name, col, l1, l2, l3, gameIdx, kSpeedTierNames[g_variant & 3]);
}

static void drawStdOver(const char* head, uint16_t headCol, const char* big, const char* sub,
                        int gameIdx) {
  const int sw = canvas->width();          // 160 landscape, 128 portrait
  const int yo = (canvas->height() - 128) / 2;  // portrait screens have 32 spare rows
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(headCol, (sw - (int)strlen(head) * 6) / 2, 20 + yo, head);
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(2);
  int textW = (int)strlen(big) * 12;
  pt((sw - textW) / 2, 44 + yo, big);
  {
    // Pure-number scores count up from 0 (see animScreenTick).
    bool digits = big[0] != 0;
    for (const char* c = big; *c; c++) if (*c < '0' || *c > '9') { digits = false; break; }
    long target = digits ? atol(big) : 0;
    if (digits && target > 0 && target < 100000000L) {
      canvas->fillRect(0, 44 + yo, sw, 16, COL_BG);
      animCountUp(target, 44 + yo);
    }
  }
  canvas->setTextSize(1);
  pt(4, 70 + yo, sub);
  if (sw >= 160) {
    canvas->setCursor(4, 108);
    animPrompt("A/Start: retry  B: back");
  } else {
    canvas->setCursor(4, 108 + yo);
    animPrompt("A: retry  B: back");
  }
  drawBestLineOver(gameIdx, 92 + yo);
  blitScreen();
}

// --- High scores screen -----------------------------------------------------
static int s_hsTier = 0;
static int s_hsTop = 0;
#define HS_ROWS 9

static int hsScoredList(int* out) {
  int n = 0;
  for (int g = 0; g < NUM_GAMES; g++) if (gameHasScore(g)) out[n++] = g;
  return n;
}

static float s_hsScr = 0;

static void drawHiScoresScreen() {
  int list[NUM_GAMES];
  int n = hsScoredList(list);
  int maxTop = n - HS_ROWS;
  if (maxTop < 0) maxTop = 0;
  if (s_hsTop > maxTop) s_hsTop = maxTop;
  if (s_hsTop < 0) s_hsTop = 0;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  int first = (int)floorf(s_hsScr) - 1;
  if (first < 0) first = 0;
  for (int i = first; i < n && i <= first + HS_ROWS + 2; i++) {
    int g = list[i];
    int y = 16 + (int)floorf(((float)i - s_hsScr) * 10.0f + 0.5f);
    if (y < 8 || y > 104) continue;
    char nm[16];
    if (g == 43) {   // Slide 15: the tiers are board sizes, not SPEED/CHILL
      static const char* const kSlTierLbl[4] = {"4x4", "3x3", "5x5", "4x4 TIMED"};
      snprintf(nm, sizeof(nm), "SLD %s", kSlTierLbl[s_hsTier & 3]);
    } else if (g == 47) {   // Flood Fill: the tiers are board sizes
      static const char* const kFlTierLbl[4] = {"10x10", "8x8", "12x12", "14x14"};
      snprintf(nm, sizeof(nm), "FLOOD %s", kFlTierLbl[s_hsTier & 3]);
    } else if (g == 49) {   // Gem Swap: the tiers are the time limits
      static const char* const kGmTierLbl[4] = {"60s", "40s", "90s", "30s"};
      snprintf(nm, sizeof(nm), "GEMS %s", kGmTierLbl[s_hsTier & 3]);
    } else if (g == 50) {   // Road Racer: the tiers are traffic/pace profiles
      static const char* const kRcTierLbl[4] = {"NORMAL", "FAST", "CHILL", "EXTREME"};
      snprintf(nm, sizeof(nm), "RACER %s", kRcTierLbl[s_hsTier & 3]);
    } else if (g == 14 || g == 29 || g == 39 || g == 40 || g == 52 || g == 53 || g == 54 || g >= 57) {
      // vs-CPU games: tiers are the AI levels (NORMAL/EASY/HARD/EXTREME), not SPEED/CHILL
      const char* sn = g == 14 ? "TTT" : g == 29 ? "CONN4" : g == 39 ? "REVERSI" : g == 40 ? "TANK" : g == 52 ? "MIND" : g == 53 ? "CHECK" : g >= 57 ? kHsShort[g - 57] : "CHESS";
      snprintf(nm, sizeof(nm), "%.7s %.7s", sn, kAiTierNames[s_hsTier & 3]);
    } else snprintf(nm, sizeof(nm), "%.14s", kGameNames[g]);
    ptc(COL_TEXT, 4, y, nm);
    char val[16];
    fmtBestValue(g, saveBest(g, s_hsTier), val, sizeof(val));
    ptc(COL_KEY, 94, y, val);
  }
  canvas->fillRect(0, 0, 160, 15, COL_BG);
  canvas->fillRect(0, 105, 160, 23, COL_BG);
  ptc(COL_ORANGE, 4, 4, "HI-SCORES: ");
  canvas->print(kSpeedTierNames[s_hsTier]);
  ptc(COL_TEXT, 4, 112, "U/D scroll L/R mode B:back");
  blitScreen();
}

static void hiScoresAnimTick() {
  animChase(s_hsScr, (float)s_hsTop, 0.42f);
  drawHiScoresScreen();
}

#define PICKER_VISIBLE_ROWS 4

// Picker filter modes. Down cycles them, Up toggles the favorite star (Left/Right move through games).
#define PICK_FILTERS 11
static const char* kFilterNames[PICK_FILTERS] = {
  "ALL", "FAVORITES", "RECENT", "ARCADE", "REFLEX", "PUZZLE", "STRATEGY", "BATTLE",
  "MOST PLAYED", "UNPLAYED", "EXPANSIONS"};
static int s_pickFilter = 0;
static int s_pickList[NUM_GAMES + CART_MAX];   // game ids; ids >= CART_BASE are installed cartridges
static int s_pickN = 0;
static bool s_favDirty = false;
static unsigned long s_favSaveAt = 0;

static bool isFavorite(int g) {
  return g >= 0 && g < 64 && ((g_save.favorites >> g) & 1ULL) != 0;
}

// Rebuilds s_pickList (real game indices) for the current filter.
static void pickerRebuild() {
  s_pickN = 0;
  if (s_pickFilter == 2) {
    for (int i = 0; i < 6; i++) {
      int g = g_save.recent[i];
      if (g < NUM_GAMES && s_pickN < NUM_GAMES) s_pickList[s_pickN++] = g;
    }
    return;
  }
  if (s_pickFilter == 8) {   // MOST PLAYED: every launched game, plays descending, ties by index
    for (int g = 0; g < NUM_GAMES; g++) {
      if (savePlays(g) == 0) continue;
      int j = s_pickN++;
      while (j > 0 && savePlays(s_pickList[j - 1]) < savePlays(g)) {
        s_pickList[j] = s_pickList[j - 1];
        j--;
      }
      s_pickList[j] = g;
    }
    return;
  }
  for (int g = 0; g < NUM_GAMES; g++) {
    bool ok;
    if (s_pickFilter == 0) ok = true;
    else if (s_pickFilter == 1) ok = isFavorite(g);
    else if (s_pickFilter == 9) ok = (savePlays(g) == 0);
    else if (s_pickFilter == 10) ok = false;   // EXPANSIONS: carts only (below)
    else ok = (gameCategory(g) == s_pickFilter - 3);
    if (ok) s_pickList[s_pickN++] = g;
  }
  // Installed cartridges follow the built-in games in ALL, and appear in their category filter,
  // UNPLAYED (no plays yet) and EXPANSIONS. They cannot be starred (the favourites mask is 64 bits).
  for (int k = 0; k < (int)s_cartN; k++) {
    int g = CART_BASE + k;
    bool ok;
    if (s_pickFilter == 0 || s_pickFilter == 10) ok = true;
    else if (s_pickFilter == 1 || s_pickFilter == 2 || s_pickFilter == 8) ok = false;
    else if (s_pickFilter == 9) ok = (pkPlays(g) == 0);
    else ok = (gameCategory(g) == s_pickFilter - 3);
    if (ok) s_pickList[s_pickN++] = g;
  }
}

// Position of the highlighted game inside the visible list, or -1.
static int pickerPos() {
  for (int i = 0; i < s_pickN; i++) if (s_pickList[i] == pickerSelection) return i;
  return -1;
}

// Animated picker state: highlight row and list scroll glide toward their
// targets (ticked from menuAnimTick); s_pkSlide is the horizontal offset of
// the list while it slides in after a filter change.
static float s_pkHi = 0, s_pkScr = 0, s_pkSlide = 0;
static bool s_pkInit = false;

static void pickerTargets(int& pos, float& tScr) {
  pickerRebuild();
  pos = pickerPos();
  if (pos < 0 && s_pickN > 0) { pickerSelection = s_pickList[0]; pos = 0; }
  int sc = pos - PICKER_VISIBLE_ROWS / 2;
  int maxTop = s_pickN - PICKER_VISIBLE_ROWS;
  if (maxTop < 0) maxTop = 0;
  if (sc < 0) sc = 0;
  if (sc > maxTop) sc = maxTop;
  tScr = (float)sc;
}

// --- Cartridge shelf layout (the default game picker; Settings -> "Menu: Shelf / List") -------------------
// Each game is a ~24x32 cartridge on a wooden shelf: the highlighted one is centred, raised and larger,
// its neighbours smaller and dimmer (5 visible). s_pkHi (the glide position shared with the list layout)
// slides the row; A inserts the cartridge into a console slot (shelfInsert), returning to the menu
// pops it back out (s_ejT0, drawn by drawShelfPicker). Settings -> "Cartridge anim" = Full / Quick / Off.
#define SH_PLANK 74      // y of the shelf board top; cartridges stand on it
#define SH_SPACING 30    // px between cartridge centres
#define SH_CONSOLE 100   // y of the console top edge (insert animation)
static uint32_t s_ejT0 = 0;   // millis() when the eject animation started (0 = none)

static bool shelfOn() { return !miscGetFlag(MF_SHELF_LIST); }
static uint8_t cartAnimMode() { uint8_t m = miscGetField(MF_CARTANIM_SHIFT, 2); return m > 2 ? 0 : m; }

// Does game g (built-in or cartridge) have a saved best score on any tier?
static bool pkHasBest(int g) {
  if (!cartIsId(g) && !gameHasScore(g)) return false;
  for (int t = 0; t < SAVE_TIERS; t++) {
    int32_t v = cartIsId(g) ? cartBestOf(g - CART_BASE, t) : saveBest(g, t);
    if (v != SAVE_NO_SCORE) return true;
  }
  return false;
}

static void shStar(int x, int y, uint16_t col) {   // 5x5 star sticker
  static const uint8_t kStar[5] = {0x04, 0x0E, 0x1F, 0x0E, 0x0A};
  for (int r = 0; r < 5; r++)
    for (int c = 0; c < 5; c++)
      if (kStar[r] & (0x10 >> c)) canvas->drawPixel(x + c, y + r, col);
}

// One cartridge. cx = centre x, by = bottom y, cl = closeness 0..255 (255 = highlighted: bigger),
// dim = fade toward the background 0..255.
static void shDrawCart(int cx, int by, int g, int cl, int dim, bool sel) {
  const int w = 24 + (6 * cl) / 255, h = 32 + (8 * cl) / 255;
  const int x0 = cx - w / 2, y0 = by - h;
  const uint8_t dm = (uint8_t)dim;
  const uint16_t col = cartIsId(g) ? kCartPal[s_carts[g - CART_BASE].col & 15] : ((g >= 0 && g < NUM_GAMES) ? s_pickerColors[g] : (uint16_t)0xFFFF);
  const uint16_t shell = animBlend(animBlend(0x9CD3, col, 110), COL_BG, dm);
  canvas->fillRoundRect(x0, y0, w, h, 2, shell);
  canvas->drawRoundRect(x0, y0, w, h, 2, animBlend(animBlend(shell, 0x0000, 120), COL_BG, dm / 2));
  const uint16_t ridge = animBlend(shell, 0x0000, 90);
  canvas->drawFastHLine(x0 + 4, y0 + 2, w - 8, ridge);
  canvas->drawFastHLine(x0 + 4, y0 + 4, w - 8, ridge);
  // label: dark tint of the game colour with its icon (and, when large, a short name)
  const int ly = y0 + 7, lh = h - 13;
  canvas->fillRect(x0 + 3, ly, w - 6, lh, animBlend(animBlend(col, 0x0000, 150), COL_BG, dm));
  const bool big = cl >= 140;
  const int sc = big ? 2 : 1, isz = 8 * sc;
  const int iy = big ? ly + 2 : ly + (lh - 8) / 2;
  drawGameIcon(cx - isz / 2, iy, g, sc, animBlend(animBlend(col, 0xFFFF, 40), COL_BG, dm));
  if (big) {
    char nm[5];
    const char* full = pkName(g);
    int n = 0;
    while (n < 4 && full[n] && full[n] != ' ') { char ch = full[n]; nm[n] = (ch >= 'a' && ch <= 'z') ? (char)(ch - 32) : ch; n++; }
    nm[n] = 0;
    canvas->setTextSize(1);
    ptc(animBlend(0xFFFF, COL_BG, dm), cx - n * 3, iy + isz + 1, nm);
  }
  if (cartIsId(g)) {   // expansion cartridge: gold side stripes
    const uint16_t gold = animBlend(0xFEA0, COL_BG, dm);
    canvas->fillRect(x0, y0 + 3, 2, h - 8, gold);
    canvas->fillRect(x0 + w - 2, y0 + 3, 2, h - 8, gold);
  }
  // connector: dark band with a key notch and contact pins
  canvas->fillRect(x0 + 3, by - 5, w - 6, 5, animBlend(0x2104, COL_BG, dm));
  canvas->fillRect(cx - 2, by - 5, 4, 2, shell);
  const uint16_t pin = animBlend(cartIsId(g) ? 0xFEA0 : 0xC618, COL_BG, dm);
  for (int px = x0 + 5; px < x0 + w - 5; px += 3) if (px < cx - 3 || px > cx + 2) canvas->drawFastVLine(px, by - 3, 3, pin);
  if (isFavorite(g)) shStar(x0 + w - 5, y0 - 3, animBlend(sel ? animBlend(0xFFE0, 0xFFFF, animPulse(700)) : (uint16_t)0xFFE0, COL_BG, dm));
  if (pkHasBest(g)) {   // ribbon hanging from the top-left corner
    canvas->fillRect(x0 + 3, y0 - 2, 4, 9, animBlend(0xF800, COL_BG, dm));
    canvas->drawPixel(x0 + 4, y0 + 6, shell);
    canvas->drawPixel(x0 + 5, y0 + 6, shell);
  }
  if (sel) canvas->drawRoundRect(x0 - 1, y0 - 1, w + 2, h + 2, 3, animBlend(col, 0xFFFF, (uint8_t)(animPulse(900) / 2)));
}

// Console body with its cartridge slot, drawn OVER an inserting / ejecting cartridge.
static void shDrawConsole(int top) {
  canvas->fillRoundRect(12, top, 136, 40, 6, 0x6B4D);
  canvas->drawFastHLine(16, top + 1, 128, 0xAD55);
  canvas->fillRect(40, top + 3, 80, 5, 0x0000);
  canvas->drawFastHLine(40, top + 8, 80, 0x3186);
  canvas->fillRect(126, top + 13, 6, 3, animBlend(0x03E0, 0x07E0, animPulse(600)));
  canvas->setTextSize(1);
  ptc(0xAD55, 44, top + 14, "ARCADIA");
}

// Shelf + cartridges around position hi (index space). hideG: game id left out (it is being inserted / ejected).
static void shDrawScene(float hi, int sx, int hideG) {
  canvas->fillScreen(COL_BG);
  const uint16_t wall = animBlend(COL_BG, COL_ICE, 14);
  for (int x = 10; x < 160; x += 40) canvas->drawFastVLine(x, 17, SH_PLANK - 17, wall);
  canvas->fillRect(0, SH_PLANK, 160, 2, 0xB366);
  canvas->fillRect(0, SH_PLANK + 2, 160, 4, 0x8A22);
  canvas->drawFastHLine(0, SH_PLANK + 6, 160, 0x4101);
  int base = (int)floorf(hi);
  float fr = hi - (float)base;
  for (int pass = 0; pass < 2; pass++) {
    // nearer side last: the highlighted cartridge is always drawn on top
    bool left = (fr < 0.5f) ? (pass == 1) : (pass == 0);
    for (int k = 0; k < 5; k++) {
      int i = left ? base - 3 + k : base + 4 - k;
      if (left && i > base) continue;
      if (!left && i <= base) continue;
      if (i < 0 || i >= s_pickN) continue;
      float d = (float)i - hi;
      float ad = d < 0 ? -d : d;
      int x = 80 + sx + (int)floorf(d * SH_SPACING + 0.5f);
      if (x < -20 || x > 180) continue;
      int g = s_pickList[i];
      if (g == hideG) continue;
      float c = 1.0f - ad;
      if (c < 0) c = 0;
      int dim = ad < 1.0f ? (int)(ad * 90.0f) : (ad < 2.0f ? 90 + (int)((ad - 1.0f) * 60.0f) : 150 + (int)((ad > 3.0f ? 1.0f : ad - 2.0f) * 40.0f));
      shDrawCart(x, SH_PLANK - (int)(6.0f * c + 0.5f), g, (int)(c * 255.0f), dim, ad < 0.5f);
    }
  }
}

static void shCenterText(int y, const char* s, uint16_t col) {
  int x = 80 - 3 * (int)strlen(s);
  if (x < 0) x = 0;
  ptc(col, x, y, s);
}

static void drawShelfPicker(int pos) {
  bool ej = false;
  float ep = 0;
  if (s_ejT0) {
    uint32_t el = millis() - s_ejT0;
    uint32_t dur = cartAnimMode() == 1 ? 220u : 380u;
    if (el >= dur) s_ejT0 = 0; else { ej = true; ep = animEase((float)el / (float)dur); }
  }
  canvas->setTextSize(1);
  int g = pickerSelection;
  if (ej) {
    shDrawScene(s_pkHi, 0, g);
    int by = 140 + (int)(((float)(SH_PLANK - 6) - 140.0f) * ep);
    shDrawCart(80, by, g, 255, 0, true);
    shDrawConsole(SH_CONSOLE);
    blitScreen();
    return;
  }
  shDrawScene(s_pkHi, (int)s_pkSlide, -1);
  // header
  canvas->fillRect(0, 0, 160, 16, COL_BG);
  ptc(COL_TEXT, 4, 4, "GAMES: ");
  canvas->setTextColor(COL_ORANGE);
  canvas->print(kFilterNames[s_pickFilter]);
  canvas->setTextColor(COL_TEXT);
  pt(124, 4, pos + 1);
  canvas->print("/");
  canvas->print(s_pickN);
  canvas->drawFastHLine(0, 15, 160, COL_WALL_NOPORTAL);
  if (s_pickN > 1) {   // more cartridges off to the sides
    uint16_t ac = animBlend(COL_WALL, COL_ICE, animPulse(800));
    canvas->fillTriangle(3, 50, 7, 46, 7, 54, ac);
    canvas->fillTriangle(156, 50, 152, 46, 152, 54, ac);
  }
  // selected game: name, blurb, best
  uint16_t cc = gameCatColor(g);
  uint16_t nc = cartIsId(g) ? kCartPal[s_carts[g - CART_BASE].col & 15] : s_pickerColors[g];
  canvas->fillRect(0, SH_PLANK + 7, 2, 8, cc);
  const char* nm = pkName(g);
  int nx = 80 - 3 * (int)strlen(nm);
  if (nx < 0) nx = 0;
  ptc(nc, nx, SH_PLANK + 8, nm);
  pt(nx + 1, SH_PLANK + 8, nm);
  shCenterText(SH_PLANK + 17, pkBlurb(g), COL_TEXT);
  char line[28];
  line[0] = 0;
  if (pkHasBest(g)) {
    int32_t bv = SAVE_NO_SCORE;
    for (int t = 0; t < SAVE_TIERS && bv == SAVE_NO_SCORE; t++) bv = cartIsId(g) ? cartBestOf(g - CART_BASE, t) : saveBest(g, t);
    char val[14];
    if (cartIsId(g)) snprintf(val, sizeof(val), "%ld", (long)bv); else fmtBestValue(g, bv, val, sizeof(val));
    snprintf(line, sizeof(line), "Best %s  x%u", val, (unsigned)pkPlays(g));
  } else if (pkPlays(g) > 0) {
    snprintf(line, sizeof(line), "Played x%u", (unsigned)pkPlays(g));
  } else {
    snprintf(line, sizeof(line), "New!");
  }
  shCenterText(SH_PLANK + 26, line, COL_KEY);
  shCenterText(SH_PLANK + 36, "L/R move U star D filter", COL_TEXT);
  shCenterText(SH_PLANK + 45, "A play  B/Sel settings", COL_TEXT);
  blitScreen();
}

// A pressed on cartridge g: lift it, move it down to the console slot, slide it in with a click and a
// screen flash (blocking, <= ~600 ms; Quick ~300 ms; Off / List layout: nothing). The title screen
// then fades in through the normal blit fade.
static void shelfInsert(int g) {
  uint8_t mode = cartAnimMode();
  if (!shelfOn() || mode >= 2 || s_pickN == 0) return;
  pickerRebuild();
  int pos = pickerPos();
  if (pos < 0) return;
  const uint32_t dLift = mode == 0 ? 110 : 0, dMove = mode == 0 ? 230 : 120, dSlide = mode == 0 ? 170 : 100, dFlash = 50;
  const uint32_t tMove = dLift, tSlide = dLift + dMove, tFlash = tSlide + dSlide, tEnd = tFlash + dFlash;
  const int by0 = SH_PLANK - 6, liftTo = mode == 0 ? by0 - 8 : by0;
  uint32_t t0 = millis();
  bool clicked = false;
  sfx(520, 18);
  for (;;) {
    uint32_t el = millis() - t0;
    if (el >= tEnd) break;
    int by = liftTo;
    bool flash = false;
    if (el < tMove) by = by0 - (int)((float)(by0 - liftTo) * animEase((float)el / (float)dLift));
    else if (el < tSlide) {
      float f = (float)(el - tMove) / (float)dMove;
      f = f * f * (3.0f - 2.0f * f);
      by = liftTo + (int)((float)(SH_CONSOLE - liftTo) * f);
    } else if (el < tFlash) {
      float f = (float)(el - tSlide) / (float)dSlide;
      by = SH_CONSOLE + (int)(40.0f * f * f);
    } else {
      flash = true;
      by = SH_CONSOLE + 40;
      if (!clicked) { clicked = true; sfx(160, 45); }
    }
    shDrawScene((float)pos, 0, g);
    if (by < SH_CONSOLE + 40) shDrawCart(80, by, g, 255, 0, true);
    shDrawConsole(SH_CONSOLE);
    if (flash) canvas->fillScreen(animBlend(0xFFFF, COL_BG, (uint8_t)(((el - tFlash) * 255u) / dFlash)));
    blitScreen();
  }
}

// Called when the picker is shown again: if we came back from a game (not from Settings / the hub / boot),
// the cartridge pops back out of the console.
static void shelfArrived(uint8_t prev) {
  if (!shelfOn() || cartAnimMode() >= 2) return;
  if (prev == ST_SPLASH || prev == ST_ATTRACT || slideDepth(prev) >= 0) return;
  s_ejT0 = millis();
  if (s_ejT0 == 0) s_ejT0 = 1;
  sfx(300, 20);
}

static void drawGamePicker() {
  int pos;
  float tScr;
  pickerTargets(pos, tScr);
  if (!s_pkInit) { s_pkHi = (float)(pos < 0 ? 0 : pos); s_pkScr = tScr; s_pkInit = true; }
  if (s_pkHi < 0) s_pkHi = 0;
  if (s_pkHi > (float)(s_pickN > 0 ? s_pickN - 1 : 0)) s_pkHi = (float)(s_pickN > 0 ? s_pickN - 1 : 0);
  if (s_pickN > 0 && shelfOn()) { drawShelfPicker(pos < 0 ? 0 : pos); return; }
  int sx = (int)s_pkSlide;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);

  if (s_pickN == 0) {
    canvas->setCursor(28, 38);
    canvas->print(s_pickFilter == 1 ? "No favorites yet" :
                  s_pickFilter == 10 ? "No cartridges found" :
                  s_pickFilter == 9 ? "You played them all!" : "Nothing here yet");
    if (s_pickFilter == 10) {
      pt(4, 54, s_cartDirOk ? "Put .arc files in /carts" : "Settings>USB drive, then");
      pt(4, 64, s_cartDirOk ? "(tools/README_CARTS.txt)" : "copy to /carts (README)");
    }
    if (s_pickFilter == 1) {
      pt(4, 54, "Press Right on a game");
      pt(4, 64, "in ALL to star it");
    }
  }

  // Slow parallax starfield behind the list (stateless: derived from time; 14 pixels).
  {
    uint32_t tb = millis() % 160000u;   // 160000 ms * sp/1000 is a multiple of 160: seamless wrap
    for (int i = 0; i < 14; i++) {
      uint32_t sp = 3 + (uint32_t)(i % 3) * 4;
      int off = (int)(((tb * sp) / 1000u) % 160u);
      int x = ((i * 47) % 160 + 160 - off) % 160;
      int y = 19 + (i * 23) % 66;
      canvas->drawPixel(x, y, animBlend(COL_BG, COL_ICE, (uint8_t)(34 + (i % 3) * 22)));
    }
  }

  const int rowSpacing = 17, rowHeight = 13;
  if (s_pickN > 0) {
    // Highlight bar glides between rows.
    int by = 20 + (int)floorf((s_pkHi - s_pkScr) * rowSpacing + 0.5f);
    canvas->fillRect(10 + sx, by - 2, VIEW_COLS * TILE_SIZE - 20, rowHeight, COL_WALL_NOPORTAL);
    canvas->setCursor(13 + sx + (animPulse(700) > 127 ? 2 : 0), by);
    canvas->setTextColor(COL_TEXT);
    canvas->print(">");
    int first = (int)floorf(s_pkScr) - 1;
    if (first < 0) first = 0;
    for (int i = first; i < s_pickN && i <= first + PICKER_VISIBLE_ROWS + 2; i++) {
      int g = s_pickList[i];
      int y = 20 + (int)floorf(((float)i - s_pkScr) * rowSpacing + 0.5f);
      if (y < 4 || y > 92) continue;
      {
        uint16_t ic = gameCatColor(g);
        if (g == pickerSelection) ic = animBlend(ic, 0xFFFF, (uint8_t)(animPulse(900) / 2));
        drawGameIcon(22 + sx, y, g, 1, ic);
      }
      canvas->setCursor(32 + sx, y);
      canvas->setTextColor(cartIsId(g) ? kCartPal[s_carts[g - CART_BASE].col & 15] : s_pickerColors[g]);
      canvas->print(pkName(g));
      if (isFavorite(g)) {
        canvas->setCursor(138 + sx, y);
        canvas->setTextColor(animBlend(COL_KEY, 0xFFFF, animPulse(900)));
        canvas->print("*");
      }
    }
  }

  // Header/footer masks (rows glide underneath them), then their text.
  canvas->fillRect(0, 0, 160, 18, COL_BG);
  canvas->fillRect(0, 88, 160, 40, COL_BG);
  ptc(COL_TEXT, 4, 4, "GAMES: ");
  canvas->setTextColor(COL_ORANGE);
  canvas->print(kFilterNames[s_pickFilter]);
  canvas->setTextColor(COL_TEXT);
  // A plain "i/N" position readout instead of scroll-arrow glyphs.
  pt(124, 4, s_pickN > 0 ? pos + 1 : 0);
  canvas->print("/");
  canvas->print(s_pickN);
  canvas->drawFastHLine(0, 15, 160, COL_WALL_NOPORTAL);

  // Scroll indicators: small pulsing triangles at the right edge when rows are hidden.
  if (s_pickN > PICKER_VISIBLE_ROWS) {
    uint16_t ac = animBlend(COL_WALL, COL_ICE, animPulse(800));
    float maxTop = (float)(s_pickN - PICKER_VISIBLE_ROWS);
    if (s_pkScr > 0.05f) canvas->fillTriangle(153, 19, 150, 23, 156, 23, ac);
    if (s_pkScr < maxTop - 0.05f) canvas->fillTriangle(153, 85, 150, 81, 156, 81, ac);
  }

  // Detail strip: a category-coloured rule with a bright segment sweeping along it,
  // a colour tab next to the blurb, and the blurb of the highlighted game.
  if (s_pickN > 0) {
    uint16_t cc = gameCatColor(pickerSelection);
    canvas->fillRect(0, 89, 160, 2, animBlend(COL_BG, cc, 110));
    int sw = (int)((millis() / 12u) % 220u) - 30;
    for (int k = 0; k < 24; k++) {
      int px = sw + k;
      if (px >= 0 && px < 160) {
        canvas->drawFastHLine(px, 89, 1, animBlend(cc, 0xFFFF, (uint8_t)(k < 12 ? k * 12 : (23 - k) * 12)));
      }
    }
    canvas->fillRect(0, 92, 2, 8, cc);
    ptc(COL_TEXT, 4, 92, pkBlurb(pickerSelection));
  }

  pt(4, 102, "L/R move U star D filter");
  pt(4, 112, "A: play  B/Sel: settings");
  pt(4, 120, "Hold B=hi U=rand D=awards");

  blitScreen();
}

// One animation step (called ~30x/s while the picker is showing).
static void pickerAnimTick() {
  int pos;
  float tScr;
  pickerTargets(pos, tScr);
  if (pos < 0) pos = 0;
  animChase(s_pkHi, (float)pos, 0.42f);
  animChase(s_pkScr, tScr, 0.42f);
  if (s_pkSlide > 0.5f) s_pkSlide *= 0.55f; else s_pkSlide = 0;
  drawGamePicker();
}

// Moves the highlight by dir (+1/-1) within the visible list.
static void pickerMove(int dir) {
  pickerRebuild();
  if (s_pickN == 0) return;
  int pos = pickerPos();
  if (pos < 0) pos = 0;
  else pos = (pos + dir + s_pickN) % s_pickN;
  pickerSelection = s_pickList[pos];
}

static void pickerCycleFilter() {
  s_pickFilter = (s_pickFilter + 1) % PICK_FILTERS;
  evSet2(2);
  pickerRebuild();
  if (s_pickN > 0 && pickerPos() < 0) pickerSelection = s_pickList[0];
  // New list slides in from the right; highlight/scroll snap to the new rows.
  int np;
  float ns;
  pickerTargets(np, ns);
  s_pkHi = (float)(np < 0 ? 0 : np);
  s_pkScr = ns;
  s_pkSlide = 70.0f;
}

static void pickerToggleFavorite() {
  pickerRebuild();
  if (s_pickN == 0 || pickerSelection < 0 || pickerSelection >= 64) return;
  int pos = pickerPos();
  g_save.favorites ^= (1ULL << pickerSelection);
  s_favDirty = true;
  s_favSaveAt = millis() + 1500;
  pickerRebuild();
  // Un-starring inside the FAVORITES filter removes the row: land on the
  // neighbour that took its place (or leave the selection if the list is empty).
  if (s_pickN > 0 && pickerPos() < 0) {
    if (pos < 0) pos = 0;
    if (pos >= s_pickN) pos = s_pickN - 1;
    pickerSelection = s_pickList[pos];
  }
  checkAchievements();
}

// "Surprise me" (hold Up in the picker): the highlight hops between random games of the
// visible list with growing pauses (the eased scroll glides to each), then stays on the
// final pick; A plays it. Blocking, ~1 s.
static void pickerSurprise() {
  pickerRebuild();
  if (s_pickN == 0) { sfxBlocked(); return; }
  s_mazeRng = (s_mazeRng ^ (uint32_t)micros()) | 1u;
  for (int i = 0; i < 12; i++) {
    int pick = mazeRngRange(s_pickN);
    if (s_pickN > 1 && s_pickList[pick] == pickerSelection) pick = (pick + 1) % s_pickN;
    pickerSelection = s_pickList[pick];
    sfx((uint16_t)(300 + i * 40), 12);
    unsigned long t0 = millis(), hold = 40UL + (unsigned long)(i * i);
    do { pickerAnimTick(); } while (millis() - t0 < hold);
  }
  sfx(880, 70);
  for (int i = 0; i < 6; i++) pickerAnimTick();   // settle the glide on the final row
}

// --- In-game pause menu --------------------------------------------------
//
// Holding Start during any minigame (not just a quick tap, so it never
// fires by accident) opens a small pause menu offering Resume, Restart,
// or Back to Games. One shared implementation for all of them: each
// game's *_PLAYING dispatch calls checkPauseMenu() with its own
// enter*Playing so Restart knows how to relaunch it, and with the
// GameState to return to on Resume/cancel.

static EnterPlayingFn s_pauseRestartFn = NULL;
static int s_pauseSel = 0;
static bool s_pauseHeld = false;
static unsigned long s_pauseHeldSinceMs = 0;
#define PAUSE_HOLD_MS 550

// Dimmed copy of the game frame that was on screen when the menu opened
// (kept so the menu can be redrawn every tick over the frozen game).
// Shares s_fadeBuf's RAM (the second 40 KB framebuffer for portrait mode would not
// otherwise fit): blitScreen() never fades while ST_PAUSE is showing, and the
// backdrop is no longer needed once the pause menu is left, so the two never overlap.
#define s_pauseBg s_fadeBuf
static bool s_pauseBgOk = false;
static unsigned long s_pauseOpenMs = 0;
#define PAUSE_Y0 34     // first option row (y); rows are PAUSE_DY apart (4 options)
#define PAUSE_DY 16
#define PAUSE_N 4
static float s_pauseBarY = PAUSE_Y0;

static void pauseCaptureBg() {
  uint32_t n = (uint32_t)canvas->width() * (uint32_t)canvas->height();
  s_pauseBgOk = false;
  if (n > sizeof(s_pauseBg) / sizeof(s_pauseBg[0])) return;
  const uint16_t* px = canvas->getBuffer();
  for (uint32_t i = 0; i < n; i++) {
    uint32_t p = px[i];
    uint32_t x = (p | (p << 16)) & 0x07E0F81Fu;
    x = ((x * 9u) >> 5) & 0x07E0F81Fu; // ~28% brightness
    s_pauseBg[i] = (uint16_t)(x | (x >> 16));
  }
  s_pauseBgOk = true;
}

static void drawPauseMenu() {
  uint32_t n = (uint32_t)canvas->width() * (uint32_t)canvas->height();
  if (s_pauseBgOk) memcpy(canvas->getBuffer(), s_pauseBg, n * sizeof(uint16_t));
  else canvas->fillScreen(COL_BG);
  // Same 160x128 layout, re-centred: portrait is 128 wide x 160 tall.
  const int pw = canvas->width();
  const int ox = (pw - 160) / 2;                   // 0 or -16
  const int yo = (canvas->height() - 128) / 2;     // 0 or +16
  float t = animEase((float)(millis() - s_pauseOpenMs) / 150.0f);
  int oy = -(int)((1.0f - t) * 70.0f) + yo;
  canvas->fillRect(2, 4 + oy, pw - 4, 118, COL_BG);
  canvas->drawRect(2, 4 + oy, pw - 4, 118, COL_ORANGE);
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 56 + ox, 14 + oy, "PAUSED");
  animChase(s_pauseBarY, (float)(PAUSE_Y0 + s_pauseSel * PAUSE_DY), 0.4f);
  canvas->fillRect(20 + (ox < 0 ? 4 : 0), (int)s_pauseBarY - 3 + oy, pw - 40 - (ox < 0 ? 8 : 0), 14, COL_WALL_NOPORTAL);
  canvas->setTextColor(COL_TEXT);
  const char* opts[PAUSE_N] = {"Resume", "Restart", "How to Play", s_lvlTestPlay ? "Back to Editor" : (s_lvlPackPlay ? "Back to Packs" : "Back to Games")};
  const int tx = ox < 0 ? 24 : 36;                 // option text / cursor columns
  for (int i = 0; i < PAUSE_N; i++) {
    int y = PAUSE_Y0 + i * PAUSE_DY;
    if (i == s_pauseSel) {
      ptc(COL_ORANGE, tx - 12 + (animPulse(520) * 3) / 255, y + oy, ">");
      canvas->setTextColor(COL_TEXT);
    }
    pt(tx, y + oy, opts[i]);
  }
  pt(4 + (ox < 0 ? 2 : 0), 108 + oy, pw >= 160 ? "Up/Down: choose  A: select" : "Up/Down  A: select");
  blitScreen();
}

static void pauseAnimTick() { drawPauseMenu(); }

// Called once per frame from a *_PLAYING dispatch, before that game's own
// button handling. Returns true the frame the pause menu opens -- the
// caller should `return` immediately so this frame's game logic (and its
// own Start-triggered action, if any) doesn't also run against a screen
// that's about to change. A quick tap never reaches the hold threshold,
// so it still passes straight through to whatever that game already
// does with a Start press.
static bool checkPauseMenu(uint32_t buttons, EnterPlayingFn restartFn) {
  bool startDown = buttons & ARCADA_BUTTONMASK_START;
  if (startDown && !s_pauseHeld) {
    s_pauseHeld = true;
    s_pauseHeldSinceMs = millis();
  } else if (!startDown) {
    s_pauseHeld = false;
  }
  // A Select tap pauses at once (new press edge only, so a button still held from a
  // menu never fires). Block Stack uses Select to rotate, so it keeps Start-hold only.
  bool selTap = (s_rawPressed & ARCADA_BUTTONMASK_SELECT) && gameState != ST_BSTK_PLAYING;
  if (selTap || (startDown && s_pauseHeld && millis() - s_pauseHeldSinceMs >= PAUSE_HOLD_MS)) {
    s_pauseHeld = false;
    s_pauseRestartFn = restartFn;
    s_pauseResumeState = gameState;
    s_pauseSel = 0;
    s_pauseBarY = PAUSE_Y0;
    pauseCaptureBg();
    s_pauseOpenMs = millis();
    gameState = ST_PAUSE;
    g_save.evFlags |= 4;
    bump8(g_save.cntPause);
    drawPauseMenu();
    return true;
  }
  return false;
}

