// --- Connect Four ----------------------------------------------------------
//
// Drop pieces into a 7-wide, 6-tall well; first to connect four in a row
// (any direction) wins. Two modes, chosen on the title screen (Up/Down):
// vs CPU (human = red and opens, CPU = yellow; 4 strength tiers via g_variant;
// results are recorded) or 2 PLAYERS hot-seat (P1 red, P2 yellow, opener
// alternates, nothing recorded). Session scoreboards are kept per mode until
// the game is relaunched from the picker.

#define C4_COLS 7
#define C4_ROWS 6
#define C4_CELL 14
#define C4_BOARD_X ((VIEW_COLS * TILE_SIZE - C4_COLS * C4_CELL) / 2)
#define C4_BOARD_Y (HUD_HEIGHT + 6)
static int8_t c4Board[C4_ROWS][C4_COLS]; // 0 empty, 1 = P1 (red), 2 = P2 (yellow)
static int c4Cursor;
static bool c4VsCpu = true;                  // mode: true = vs CPU, false = 2 PLAYERS
static int c4Sb[2][3];                       // scoreboard [0 = vs CPU, 1 = 2P][P1/You, P2/CPU, draws]
static int c4TierWins[4];                    // human wins per CPU tier this session (hi-score value)
static unsigned long c4CpuAt;                // when the CPU may drop its disc (thinking pause)
static int8_t c4Winner;      // 0 none, 1 = P1, 2 = P2, 3 draw
static int8_t c4Turn = 1;    // whose turn, 1 = red, 2 = yellow
static int8_t c4First = 1;   // who opens the current match (alternates after each finished match)
// Disc-drop animation slots (drawing only; the board is already updated).
#define C4_ANIMS 4
static uint8_t c4AnC[C4_ANIMS], c4AnR[C4_ANIMS];
static unsigned long c4AnT[C4_ANIMS], c4AnD[C4_ANIMS];
static int c4AnNext = 0;
static void c4AnimAdd(int c, int r, unsigned long start) {
  int k = c4AnNext;
  c4AnNext = (c4AnNext + 1) % C4_ANIMS;
  c4AnC[k] = (uint8_t)c;
  c4AnR[k] = (uint8_t)r;
  c4AnT[k] = start;
  c4AnD[k] = 90 + 25 * (unsigned long)(r + 1); // 115..240 ms
}
static int c4AnimFind(int c, int r, unsigned long now) {
  for (int k = 0; k < C4_ANIMS; k++)
    if (c4AnC[k] == c && c4AnR[k] == r && now < c4AnT[k] + c4AnD[k]) return k;
  return -1;
}
static bool c4AnimBusy() {
  unsigned long now = millis();
  for (int k = 0; k < C4_ANIMS; k++) if (now < c4AnT[k] + c4AnD[k]) return true;
  return false;
}

static int c4DropPiece(int col, int8_t val) {
  for (int r = C4_ROWS - 1; r >= 0; r--) {
    if (c4Board[r][col] == 0) {
      c4Board[r][col] = val;
      return r;
    }
  }
  return -1;
}

static bool c4CheckWinAt(int row, int col, int8_t val) {
  static const int dirs[4][2] = {{1, 0}, {0, 1}, {1, 1}, {1, -1}};
  for (int d = 0; d < 4; d++) {
    int dr = dirs[d][0], dc = dirs[d][1];
    int count = 1;
    for (int s = 1; s < 4; s++) {
      int r = row + dr * s, c = col + dc * s;
      if (r < 0 || r >= C4_ROWS || c < 0 || c >= C4_COLS || c4Board[r][c] != val) break;
      count++;
    }
    for (int s = 1; s < 4; s++) {
      int r = row - dr * s, c = col - dc * s;
      if (r < 0 || r >= C4_ROWS || c < 0 || c >= C4_COLS || c4Board[r][c] != val) break;
      count++;
    }
    if (count >= 4) return true;
  }
  return false;
}

static bool c4BoardFull() {
  for (int c = 0; c < C4_COLS; c++)
    if (c4Board[0][c] == 0) return false;
  return true;
}

// --- Connect Four CPU (negamax + alpha-beta, iterative deepening) -----------
// The CPU plays yellow (2). Search works in place on c4Board (drop / undo).
// A node budget bounds the think time (~150 ms worst case at 120 MHz); when it
// runs out the last fully searched depth decides.
#define C4_NODE_BUDGET 30000
static uint16_t c4Nodes;
static bool c4Abort;

// Cheap static eval for `who`: centre-column weighted piece count difference.
static int c4Eval(int8_t who) {
  static const int8_t wt[C4_COLS] = {1, 2, 3, 4, 3, 2, 1};
  int s = 0;
  for (int r = 0; r < C4_ROWS; r++)
    for (int c = 0; c < C4_COLS; c++) {
      int8_t v = c4Board[r][c];
      if (v == 0) continue;
      s += (v == who) ? wt[c] : -wt[c];
    }
  return s;
}

static int c4Negamax(int depth, int alpha, int beta, int8_t who);

// Score for `who` of dropping in `col` (column must not be full): a win scores
// 1000 + remaining depth (sooner is better), otherwise search / evaluate.
static int c4MoveScore(int col, int8_t who, int depth, int alpha, int beta) {
  if (++c4Nodes > C4_NODE_BUDGET) { c4Abort = true; return 0; }
  int r = c4DropPiece(col, who);
  int sc;
  if (c4CheckWinAt(r, col, who)) sc = 1000 + depth;
  else if (depth <= 1) sc = c4Eval(who);
  else sc = -c4Negamax(depth - 1, -beta, -alpha, (who == 1) ? 2 : 1);
  c4Board[r][col] = 0;
  return sc;
}

static int c4Negamax(int depth, int alpha, int beta, int8_t who) {
  static const int8_t order[C4_COLS] = {3, 2, 4, 1, 5, 0, 6};
  int best = -100000;
  bool any = false;
  for (int k = 0; k < C4_COLS; k++) {
    int col = order[k];
    if (c4Board[0][col] != 0) continue;
    any = true;
    int sc = c4MoveScore(col, who, depth, alpha, beta);
    if (c4Abort) return 0;
    if (sc > best) best = sc;
    if (best > alpha) alpha = best;
    if (alpha >= beta) break;
  }
  return any ? best : 0;   // no open column = full board = draw
}

// Column for the CPU, or -1 if the board is full. Tiers (g_variant):
// 0 NORMAL depth 3, 15% random column; 1 EASY depth 2, 40% random;
// 2 HARD depth 4, 3% random; 3 EXTREME depth 6, never random.
static int c4CpuPick() {
  static const uint8_t kMistake[4] = {15, 40, 3, 0};
  static const int8_t kDepth[4] = {3, 2, 4, 6};
  static const int8_t order[C4_COLS] = {3, 2, 4, 1, 5, 0, 6};
  int open[C4_COLS], no = 0;
  for (int c = 0; c < C4_COLS; c++) if (c4Board[0][c] == 0) open[no++] = c;
  if (no == 0) return -1;
  int tier = g_variant & 3;
  if (mazeRngRange(100) < kMistake[tier]) return open[mazeRngRange(no)];
  int bestCol = open[0];
  c4Nodes = 0;
  c4Abort = false;
  for (int d = 1; d <= kDepth[tier]; d++) {
    int bc = -1, bs = -100000, alpha = -100000;
    for (int k = 0; k < C4_COLS; k++) {
      int col = order[k];
      if (c4Board[0][col] != 0) continue;
      int sc = c4MoveScore(col, 2, d, alpha, 100000);
      if (c4Abort) break;
      if (sc > bs) { bs = sc; bc = col; }
      if (bs > alpha) alpha = bs;
    }
    if (c4Abort) break;     // incomplete depth: keep the previous result
    bestCol = bc;
    if (bs >= 1000) break;  // forced win found
  }
  return bestCol;
}

