// --- Air Hockey ----------------------------------------------------------
//
// Defend your goal (left) and score on the CPU's (right). Move your
// paddle with the D-pad in both directions; the CPU paddle tracks the
// puck imperfectly. First to 5 goals wins the match.

static float hockeyPlayerX, hockeyPlayerY, hockeyCpuX, hockeyCpuY;
static float hockeyPuckX, hockeyPuckY, hockeyPuckVX, hockeyPuckVY;
static int hockeyPlayerScore, hockeyCpuScore, hockeyWins, hockeyLosses;
static float hockeyCpuSpeedCur = 65.0f, hockeyPuckSpeedCur = 55.0f;
#define HOCKEY_PADDLE_R 6
#define HOCKEY_PUCK_R 3

// Level-creator obstacles: one 16x16 block per cell of the 10x7 rink (the puck bounces off
// them; paddles ignore them).
static uint8_t hkBlocks[VIEW_ROWS][VIEW_COLS];
static bool hkHasBlocks = false;

static void hockeyLoadCustom(const LevelData *lvl) {
  memset(hkBlocks, 0, sizeof(hkBlocks));
  hkHasBlocks = false;
  for (int r = 0; r < lvl->h && r < VIEW_ROWS; r++)
    for (int c = 0; c < lvl->w && c < VIEW_COLS; c++)
      if (lvl->cells[r][c] == 1) { hkBlocks[r][c] = 1; hkHasBlocks = true; }
}

static bool hockeyValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int n = lvlCountTile(lvl, 1);
  if (n < 1) { snprintf(msg, msgLen, "Need at least 1 block"); return false; }
  if (n > 16) { snprintf(msg, msgLen, "Max 16 blocks"); return false; }
  for (int r = 0; r < lvl->h; r++)
    if (lvl->cells[r][0] == 1 || lvl->cells[r][lvl->w - 1] == 1) {
      snprintf(msg, msgLen, "Keep goal columns clear");
      return false;
    }
  if (lvl->h > 3 && lvl->w > 5 && (lvl->cells[3][4] == 1 || lvl->cells[3][5] == 1)) {
    snprintf(msg, msgLen, "Keep center clear");
    return false;
  }
  return true;
}

// Bounces the puck (treated as a 2R square) off at most one block per frame.
static void hockeyBlockBounce() {
  if (!hkHasBlocks) return;
  float bx = hockeyPuckX - HOCKEY_PUCK_R, by = hockeyPuckY - HOCKEY_PUCK_R;
  const float bs = 2.0f * HOCKEY_PUCK_R;
  if (bx < 0 || by < HUD_HEIGHT) return;
  int c0 = (int)bx / TILE_SIZE, c1 = (int)(bx + bs - 1) / TILE_SIZE;
  int r0 = ((int)by - HUD_HEIGHT) / TILE_SIZE, r1 = ((int)(by + bs - 1) - HUD_HEIGHT) / TILE_SIZE;
  if (c1 >= VIEW_COLS) c1 = VIEW_COLS - 1;
  if (r1 >= VIEW_ROWS) r1 = VIEW_ROWS - 1;
  for (int r = r0; r <= r1; r++) {
    for (int c = c0; c <= c1; c++) {
      if (!hkBlocks[r][c]) continue;
      float cx0 = (float)(c * TILE_SIZE), cy0 = (float)(HUD_HEIGHT + r * TILE_SIZE);
      float ox = fminf(bx + bs, cx0 + TILE_SIZE) - fmaxf(bx, cx0);
      float oy = fminf(by + bs, cy0 + TILE_SIZE) - fmaxf(by, cy0);
      if (ox <= 0 || oy <= 0) continue;
      if (ox < oy) {
        if (hockeyPuckX < cx0 + TILE_SIZE / 2.0f) { hockeyPuckX -= ox; hockeyPuckVX = -fabsf(hockeyPuckVX); }
        else { hockeyPuckX += ox; hockeyPuckVX = fabsf(hockeyPuckVX); }
      } else {
        if (hockeyPuckY < cy0 + TILE_SIZE / 2.0f) { hockeyPuckY -= oy; hockeyPuckVY = -fabsf(hockeyPuckVY); }
        else { hockeyPuckY += oy; hockeyPuckVY = fabsf(hockeyPuckVY); }
      }
      sfx(380, 15);
      return;
    }
  }
}

static void hockeyServe(int towardPlayer) {
  hockeyPuckX = VIEW_COLS * TILE_SIZE / 2.0f;
  hockeyPuckY = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE / 2.0f;
  hockeyPuckVX = towardPlayer ? -hockeyPuckSpeedCur : hockeyPuckSpeedCur;
  float vyMag = hockeyPuckSpeedCur * 0.73f;
  hockeyPuckVY = (mazeRngRange(2) == 0) ? vyMag : -vyMag;
}

