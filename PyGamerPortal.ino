// --- Screen blit with software fade-in -------------------------------------
// Every canvas->display push goes through blitScreen(). When gameState differs
// from the state of the previous blit (i.e. a screen change, not a redraw of
// the same screen for cursor/animation/gameplay frames) the finished frame is
// first shown at rising brightness (8 steps, ~120 ms), then at full brightness.
// Set s_fadeEnabled = false to turn all of it off.
static bool s_fadeEnabled = true;
static bool s_fadeSkipOnce = false;      // set to suppress the next fade (e.g. resume)
static GameState s_lastBlitState = ST_SPLASH;
static unsigned long s_lastFadeEndMs = 0;
static uint16_t s_fadeBuf[160 * 128];    // pristine copy of the frame while fading
#define FADE_STEPS 8

