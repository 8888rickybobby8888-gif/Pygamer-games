    File rf = arcada.open("/README.TXT", O_WRITE | O_CREAT | O_TRUNC);
    if (rf) { rf.write((const uint8_t *)kUsbReadme, sizeof(kUsbReadme) - 1); rf.close(); }
  }
}

// --- Boot recovery: the flash chip answers but its FAT volume cannot be mounted ----------------
// The vendored FatFs formatter ERASES the whole chip, so it is only ever run after the user has
// explicitly confirmed it on the screen below (a plain damaged volume, e.g. after a bad USB
// eject, must never be wiped silently). "No chip at all" skips this screen (RAM-only as before).
extern Adafruit_SPIFlash Arcada_QSPI_Flash;   // owned by Adafruit_Arcada_Filesystem.cpp

// True when the first 4 KB of the chip (where a FAT boot sector + tables would be) reads all 0xFF.
static bool stoChipBlank() {
  uint8_t b[64];
  for (uint32_t s = 0; s < 8; s++) {
    if (Arcada_QSPI_Flash.readBuffer(s * 512UL, b, sizeof(b)) != sizeof(b)) return false;
    for (int i = 0; i < 64; i++)
      if (b[i] != 0xFF) return false;
  }
  return true;
}

#define STO_TIMEOUT_MS 30000UL   // idle this long (no new button press) = "play without storage"
#define STO_HOLD_MS 2000UL       // hold A this long on the second screen to confirm an erase

// --- Error codes + ring log -------------------------------------------------------------------------
// Every failure the console can report has a code Exyz (x = area: 1 storage, 2 save data, 3 carts, 4 CHIP-8,
// 5 Quest, 6 packs/levels, 7 system). errLog() remembers the last 8 (code + uptime seconds) and, when the
// drive is available, mirrors them to /arcadia/errlog.txt ("code sec unseen" per line, oldest first).
// errToast() = errLog + a toast; errDraw() paints the standard error screen. Settings > Error log lists them.
#define ERR_N 8
#define ERR_PATH "/arcadia/errlog.txt"
static const ErrInfo kErrTab[] = {
  {101, "No flash chip\nresponds", "Saves are not kept"},
  {102, "Flash disk is blank\nno filesystem", "Set up storage at boot"},
  {103, "Flash disk cannot\nbe mounted", "Back up, then format"},
  {104, "Format failed\nno storage this run", "Reboot, try USB drive"},
  {105, "No flash filesystem\nRAM-only mode", "Reboot, set up storage"},
  {106, "USB drive mode\nfailed to start", "Reboot and retry"},
  {107, "Backup failed\nnothing was erased", "Free space on the disk"},
  {108, "Restore failed\nbackup unreadable", "Check /arcadia/bak"},
  {109, "No backup found\non the drive", "Made by USB drive/reset"},
  {201, "Save file write\nfailed", "Disk full? Reboot"},
  {202, "Settings save\nwrite failed", "Disk full? Reboot"},
  {203, "Extra save write\nfailed", "Disk full? Reboot"},
  {204, "Level save failed\ndisk may be full", "Delete a level"},
  {205, "Quest save failed\nprogress not stored", "Free space, retry"},
  {206, "Save file invalid\nstarting fresh", "Settings > Restore"},
  {301, "Cart: no storage\navailable", "Check disk in Settings"},
  {302, "Cart file missing", "Reinstall the cart"},
  {303, "Cart file is bad\nor wrong version", "Rebuild cart on PC"},
  {304, "Cart is corrupt\nchecksum mismatch", "Reinstall the cart"},
  {305, "Not enough memory\nfor this cart", "Use a smaller cart"},
  {306, "Cart store failed\ncarts.bin not saved", "Free space on the disk"},
  {310, "Cart stopped\nruntime fault", "Cart needs a fix"},
  {311, "Cart not loaded", "Open the cart again"},
  {401, "ROM file missing", "Copy ROM to /roms"},
  {402, "ROM empty or\ntoo big (>3584 B)", "Use a valid .ch8"},
  {403, "Not enough memory\nfor CHIP-8", "Reboot and retry"},
  {404, "ROM not loaded", "Open the ROM again"},
  {501, "Drive not available", "Set up storage first"},
  {502, "quest.wld not found", "Install via USB drive"},
  {503, "quest.wld damaged", "Copy quest.wld again"},
  {504, "Read error\nQuest region", "Try again"},
  {505, "Quest world became\nunreadable", "Reinstall quest.wld"},
  {601, "Level pack record\nis bad", "Rebuild/reinstall pack"},
  {701, "Watchdog reset\nlast run froze", "Report if repeated"},
  {702, "Brownout reset\npower dipped", "Check battery/USB"},
  {703, "Portrait buffer\nnot allocated", "Portrait mode is off"},
  {799, "Unknown error", "See tools README"}};
static ErrRec s_errLog[ERR_N];
static uint8_t s_errCnt = 0;
static bool s_errLoaded = false;   // the file has been merged in; before that nothing is written back
static uint8_t s_errSel = 0;
static bool s_errArm = false;

static const ErrInfo *errFind(uint16_t code) {
  const int n = (int)(sizeof(kErrTab) / sizeof(kErrTab[0]));
  for (int i = 0; i < n; i++) if (kErrTab[i].code == code) return &kErrTab[i];
  return &kErrTab[n - 1];
}
// First line of the message, at most n-1 chars.
static void errLine1(char *out, size_t n, uint16_t code) {
  const char *m = errFind(code)->msg;
  size_t i = 0;
  while (m[i] && m[i] != '\n' && i + 1 < n) { out[i] = m[i]; i++; }
  out[i] = 0;
}
static void errParse(const char *b, int n, ErrRec *out, uint8_t *cnt) {
  uint32_t v[3] = {0, 0, 0}, cur = 0;
  int k = 0;
  bool in = false;
  for (int i = 0; i <= n; i++) {
    char c = i < n ? b[i] : '\n';
    if (c >= '0' && c <= '9') { cur = cur * 10u + (uint32_t)(c - '0'); in = true; continue; }
    if (in && k < 3) v[k++] = cur;
    cur = 0;
    in = false;
    if (c == '\n') {
      if (k >= 2 && v[0] >= 100 && v[0] <= 999 && *cnt < ERR_N) {
        out[*cnt].code = (uint16_t)v[0];
        out[*cnt].sec = v[1];
        out[*cnt].prev = 1;
        out[*cnt].unseen = (uint8_t)(k >= 3 && v[2] ? 1 : 0);
        (*cnt)++;
      }
      k = 0;
    }
  }
}
static void errSave() {
  if (!s_errLoaded || !s_lvlFsReady || s_lvlFsIsRam || g_usbDriveMode) return;
  char b[ERR_N * 20];
  int n = 0;
  for (int i = 0; i < s_errCnt; i++)
    n += snprintf(b + n, sizeof(b) - (size_t)n, "%u %lu %u\n", (unsigned)s_errLog[i].code, (unsigned long)s_errLog[i].sec, (unsigned)s_errLog[i].unseen);
  if (!arcada.exists("/arcadia")) arcada.mkdir("/arcadia");
  File f = arcada.open(ERR_PATH, O_WRITE | O_CREAT | O_TRUNC);
  if (!f) return;
  if (n > 0) f.write((const uint8_t *)b, (size_t)n);
  f.close();
}
static void errLog(uint16_t code) {
  uint32_t s = millis() / 1000UL;
  Serial.print("ERR E");
  Serial.println(code);
  if (s_errCnt > 0) {   // the same code again within a minute is one event
    ErrRec &l = s_errLog[s_errCnt - 1];
    if (l.code == code && !l.prev && s - l.sec < 60UL) return;
  }
  if (s_errCnt >= ERR_N) {
    memmove(&s_errLog[0], &s_errLog[1], sizeof(ErrRec) * (ERR_N - 1));
    s_errCnt = ERR_N - 1;
  }
  s_errLog[s_errCnt].code = code;
  s_errLog[s_errCnt].sec = s;
  s_errLog[s_errCnt].prev = 0;
  s_errLog[s_errCnt].unseen = 1;
  s_errCnt++;
  errSave();
}
static void errToast(uint16_t code) {
  errLog(code);
  char tb[28], l1[22];
  errLine1(l1, sizeof(l1), code);
  snprintf(tb, sizeof(tb), "E%u %s", (unsigned)code, l1);
  toastShow(tb);
}
// Call once after the storage is mounted: merges errlog.txt (earlier runs) with what happened during boot,
// notes a watchdog / brownout reset, and toasts a hint when the last run left an unseen error.
static void errBoot() {
  ErrRec ld[ERR_N];
  uint8_t ln = 0;
  if (s_lvlFsReady && !s_lvlFsIsRam && !g_usbDriveMode && arcada.exists(ERR_PATH)) {
    File f = arcada.open(ERR_PATH, O_READ);
    if (f) {
      char b[ERR_N * 20];
      int n = f.read((uint8_t *)b, sizeof(b));
      f.close();
      if (n > 0) errParse(b, n, ld, &ln);
    }
  }
  ErrRec comb[2 * ERR_N];
  int tot = 0;
  for (int i = 0; i < ln; i++) comb[tot++] = ld[i];
  for (int i = 0; i < s_errCnt; i++) comb[tot++] = s_errLog[i];
  int skip = tot > ERR_N ? tot - ERR_N : 0;
  s_errCnt = (uint8_t)(tot - skip);
  for (int i = 0; i < s_errCnt; i++) s_errLog[i] = comb[skip + i];
  s_errLoaded = true;
#if defined(RSTC_RCAUSE_WDT)
  {
    uint8_t rc = RSTC->RCAUSE.reg;
    if (rc & RSTC_RCAUSE_WDT) errLog(701);
    else if ((rc & (RSTC_RCAUSE_BODCORE | RSTC_RCAUSE_BODVDD)) && !(rc & RSTC_RCAUSE_POR)) errLog(702);
  }
#endif
  int hint = -1;
  for (int i = s_errCnt - 1; i >= 0; i--)
    if (s_errLog[i].unseen && (s_errLog[i].prev || s_errLog[i].code == 701 || s_errLog[i].code == 702)) { hint = i; break; }
  for (int i = 0; i < s_errCnt; i++) s_errLog[i].unseen = 0;
  if (hint >= 0) {
    char tb[28];
    snprintf(tb, sizeof(tb), "Last run: E%u, see log", (unsigned)s_errLog[hint].code);
    toastShow(tb);
  }
  if (s_errCnt > 0) errSave();
}
static void errClear() {
  s_errCnt = 0;
  s_errSel = 0;
  s_errArm = false;
  errSave();
}
static void errAge(char *o, size_t n, const ErrRec &r) {
  if (r.prev) snprintf(o, n, "old");
  else if (r.sec < 100) snprintf(o, n, "%lus", (unsigned long)r.sec);
  else if (r.sec < 6000) snprintf(o, n, "%lum", (unsigned long)(r.sec / 60));
  else snprintf(o, n, "%luh", (unsigned long)(r.sec / 3600));
}
// Standard error screen body (title, message, optional detail, hint). The caller adds its own footer and blits.
static void errDraw(uint16_t code, const char *detail) {
  const ErrInfo *e = errFind(code);
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  char t[16];
  snprintf(t, sizeof(t), "ERROR E%u", (unsigned)code);
  ptc(COL_LASER, 4, 6, t);
  char ln[28];
  int y = 22;
  const char *m = e->msg;
  while (*m) {
    int i = 0;
    while (*m && *m != '\n' && i < 26) ln[i++] = *m++;
    ln[i] = 0;
    if (*m == '\n') m++;
    ptc(COL_TEXT, 4, y, ln);
    y += 10;
  }
  if (detail && detail[0]) ptc(COL_KEY, 4, y + 4, detail);
  ptc(COL_ICE, 4, 70, e->hint);
}
static void errLogDraw() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  char t[20];
  snprintf(t, sizeof(t), "ERROR LOG %d/%d", (int)s_errCnt, ERR_N);
  ptc(COL_ORANGE, 4, 3, t);
  canvas->drawFastHLine(0, 13, 160, animBlend(COL_BG, COL_WALL, 120));
  if (s_errCnt == 0) {
    ptc(COL_TEXT, 4, 40, "No errors logged.");
  } else {
    if (s_errSel >= s_errCnt) s_errSel = (uint8_t)(s_errCnt - 1);
    for (int i = 0; i < s_errCnt; i++) {
      const ErrRec &r = s_errLog[s_errCnt - 1 - i];
      int y = 16 + i * 10;
      if (i == s_errSel) canvas->fillRect(0, y - 1, 160, 10, animBlend(COL_BG, COL_ICE, 70));
      uint16_t c = r.prev ? animBlend(COL_BG, COL_TEXT, 150) : COL_TEXT;
      char b[8], l1[20], ag[8], mb[20];
      snprintf(b, sizeof(b), "E%u", (unsigned)r.code);
      errLine1(l1, sizeof(l1), r.code);
      errAge(ag, sizeof(ag), r);
      snprintf(mb, sizeof(mb), "%.15s", l1);
      ptc(COL_KEY, 4, y, b);
      ptc(c, 30, y, mb);
      ptc(c, 124, y, ag);
    }
    ptc(COL_KEY, 4, 98, errFind(s_errLog[s_errCnt - 1 - s_errSel].code)->hint);
  }
  canvas->drawFastHLine(0, 108, 160, animBlend(COL_BG, COL_WALL, 90));
  ptc(s_errArm ? COL_LASER : COL_TEXT, 4, 112, s_errArm ? "A again: CLEAR  other: no" : "A: clear   B: back");
  blitScreen();
}
static void errLogOpen() {
  s_errSel = 0;
  s_errArm = false;
  gameState = ST_ERRLOG;
  sfx(600, 40);
  errLogDraw();
}
static void errLogUpdate(uint32_t pressed) {
  if (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN)) {
    s_errArm = false;
    if (s_errCnt > 1) {
      if (pressed & ARCADA_BUTTONMASK_UP) s_errSel = (uint8_t)((s_errSel + s_errCnt - 1) % s_errCnt);
      else s_errSel = (uint8_t)((s_errSel + 1) % s_errCnt);
      sfxMove();
    }
    errLogDraw();
  } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
    if (s_errCnt == 0) { sfxBlocked(); }
    else if (!s_errArm) { s_errArm = true; sfx(300, 60); }
    else { errClear(); toastShow("Error log cleared"); sfx(500, 60); }
    errLogDraw();
  } else if (pressed & ARCADA_BUTTONMASK_B) {
    gameState = ST_SETTINGS;
    drawSettingsScreen();
  }
}

