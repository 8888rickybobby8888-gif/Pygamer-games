  const char* labels[BRAWL_NUM_SHOP_ITEMS] = {"Attack +2", "Max Health +6", "Heal Team",
                                               "Continue"};
  int costs[BRAWL_NUM_SHOP_ITEMS] = {brawlAtkCost(), brawlHpCost(), BRAWL_HEAL_COST, -1};
  for (int i = 0; i < BRAWL_NUM_SHOP_ITEMS; i++) {
