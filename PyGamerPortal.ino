// --- Tic-Tac-Toe -----------------------------------------------------------
//
// Two modes, chosen on the title screen (Up/Down): vs CPU (human = X and
// opens, CPU = O; 4 strength tiers via g_variant; results are recorded) or
// 2 PLAYERS hot-seat (P1 = X, P2 = O, opener alternates, nothing recorded).
// Session scoreboards are kept per mode until relaunched from the picker.

static int8_t tttBoard[9]; // 0 empty, 1 = P1 (X), 2 = P2 (O)
static int tttCursor;
static bool tttVsCpu = true;                 // mode: true = vs CPU, false = 2 PLAYERS
static int tttSb[2][3];                      // scoreboard [0 = vs CPU, 1 = 2P][P1/You, P2/CPU, draws]
static int tttTierWins[4];                   // human wins per CPU tier this session (hi-score value)
static unsigned long tttCpuAt;               // when the CPU may play its move (thinking pause)
static int8_t tttWinner; // 0 none (in progress), 1 = P1, 2 = P2, 3 draw
static int8_t tttTurn = 1;   // whose turn, 1 = X, 2 = O
static int8_t tttFirst = 1;  // who opens the current match (alternates after each finished match)
static unsigned long tttMarkT[9]; // when each mark started drawing in (0 = settled)
#define TTT_MARK_MS 130

// 0 in progress, 1/2 = that player has three in a row, 3 = draw (board full).
static int tttWinnerOf(const int8_t* bd) {
  static const int8_t lines[8][3] = {{0, 1, 2}, {3, 4, 5}, {6, 7, 8}, {0, 3, 6},
                                      {1, 4, 7}, {2, 5, 8}, {0, 4, 8}, {2, 4, 6}};
  for (int i = 0; i < 8; i++) {
    int8_t a = bd[lines[i][0]], b = bd[lines[i][1]], c = bd[lines[i][2]];
    if (a != 0 && a == b && b == c) return a;
  }
  for (int i = 0; i < 9; i++)
    if (bd[i] == 0) return 0;
  return 3;
}
static int tttCheckWinner() { return tttWinnerOf(tttBoard); }

// Minimax from the CPU's (O = 2) point of view; `turn` is who moves next.
// Faster wins / slower losses score better.
static int tttMinimax(int8_t* bd, int8_t turn, int depth) {
  int w = tttWinnerOf(bd);
  if (w == 2) return 10 - depth;
  if (w == 1) return depth - 10;
  if (w == 3) return 0;
  int best = (turn == 2) ? -100 : 100;
  for (int i = 0; i < 9; i++) {
    if (bd[i] != 0) continue;
    bd[i] = turn;
    int s = tttMinimax(bd, (turn == 1) ? 2 : 1, depth + 1);
    bd[i] = 0;
    if (turn == 2) { if (s > best) best = s; }
    else { if (s < best) best = s; }
  }
  return best;
}

// The CPU (O) picks a cell, or -1 if the board is full. Tiers (g_variant):
// 0 NORMAL 20% random, heuristic; 1 EASY 45% random, heuristic;
// 2 HARD 5% random, perfect otherwise; 3 EXTREME perfect minimax.
static int tttCpuPick() {
  static const uint8_t kMistake[4] = {20, 45, 5, 0};
  int empt[9], ne = 0;
  for (int i = 0; i < 9; i++) if (tttBoard[i] == 0) empt[ne++] = i;
  if (ne == 0) return -1;
  int tier = g_variant & 3;
  if (mazeRngRange(100) < kMistake[tier]) return empt[mazeRngRange(ne)];
  if (tier >= 2) {
    int8_t bd[9];
    for (int i = 0; i < 9; i++) bd[i] = tttBoard[i];
    int bestS = -100, cand[9], nc = 0;
    for (int k = 0; k < ne; k++) {
      bd[empt[k]] = 2;
      int s = tttMinimax(bd, 1, 1);
      bd[empt[k]] = 0;
      if (s > bestS) { bestS = s; nc = 0; }
      if (s == bestS) cand[nc++] = empt[k];
    }
    return cand[mazeRngRange(nc)];
  }
  // Heuristic: win, block, centre, corners, edges.
  for (int pass = 0; pass < 2; pass++) {
    int8_t who = (pass == 0) ? 2 : 1;
    for (int k = 0; k < ne; k++) {
      tttBoard[empt[k]] = who;
      int w = tttCheckWinner();
      tttBoard[empt[k]] = 0;
      if (w == who) return empt[k];
    }
  }
  if (tttBoard[4] == 0) return 4;
  int cand[4], nc = 0;
  static const int8_t corners[4] = {0, 2, 6, 8};
  for (int k = 0; k < 4; k++) if (tttBoard[corners[k]] == 0) cand[nc++] = corners[k];
  if (nc > 0) return cand[mazeRngRange(nc)];
  return empt[mazeRngRange(ne)];
}

