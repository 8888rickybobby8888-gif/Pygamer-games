// --- Sokoban Mini ------------------------------------------------------
//
// A tiny classic box-pusher: push every box (orange) onto a target
// (green-tinted floor) to clear the level. Rendered top-down and flat --
// grid-stepped movement, one tile per press, no continuous physics.
//
// Levels are generated, not hand-authored, and guaranteed solvable by
// construction: start from a SOLVED state (each box already sitting on
// its target) and repeatedly apply a random valid "pull" -- the exact
// reverse of a push -- to scramble it backward into a starting position.
// Since every scramble step has a real forward push that undoes it,
// walking the same moves back in reverse order always solves the
// generated puzzle, without needing a separate solver to verify it.

#define SOKO_MAX_W 9
#define SOKO_MAX_H 9
#define SOKO_MAX_BOXES 2
#define SOKO_ROOM_SIZE 7

static bool sokoWall[SOKO_MAX_H][SOKO_MAX_W];
static bool sokoTarget[SOKO_MAX_H][SOKO_MAX_W];
static int sokoBoxX[SOKO_MAX_BOXES], sokoBoxY[SOKO_MAX_BOXES];
static int sokoBoxCount = 0;
static int sokoPX = 0, sokoPY = 0, sokoW = 0, sokoH = 0;
static int sokoLevel = 0, sokoMoves = 0;
static int sokoSolved = 0;           // generated levels solved this session (the recorded score)
static bool sokoCustomFirst = false; // the level in play is a custom one: solving it doesn't score
static int sokoPullsBase = 12, sokoPullsRange = 8;
static const char* kSokoTierNames[4] = {"NORMAL", "EASY", "HARD", "EXTREME"};

static int sokoBoxAt(int x, int y) {
  for (int i = 0; i < sokoBoxCount; i++)
    if (sokoBoxX[i] == x && sokoBoxY[i] == y) return i;
  return -1;
}

static bool sokoBlocked(int x, int y) {
  return x < 0 || x >= sokoW || y < 0 || y >= sokoH || sokoWall[y][x];
}

static void sokoGenerate(uint32_t seed) {
  s_mazeRng = seed;
  sokoW = SOKO_ROOM_SIZE;
  sokoH = SOKO_ROOM_SIZE;
  for (int r = 0; r < sokoH; r++) {
    for (int c = 0; c < sokoW; c++) {
      sokoWall[r][c] = (r == 0 || c == 0 || r == sokoH - 1 || c == sokoW - 1);
      sokoTarget[r][c] = false;
    }
  }

  // Solved state: boxes start exactly on their targets.
  sokoBoxCount = SOKO_MAX_BOXES;
  int placed = 0;
  while (placed < sokoBoxCount) {
    int c = 1 + mazeRngRange(sokoW - 2), r = 1 + mazeRngRange(sokoH - 2);
    if (sokoBoxAt(c, r) >= 0) continue;
    sokoBoxX[placed] = c;
    sokoBoxY[placed] = r;
    sokoTarget[r][c] = true;
    placed++;
  }
  static const int8_t dx4[4] = {1, -1, 0, 0};
  static const int8_t dy4[4] = {0, 0, 1, -1};

  // The player must start adjacent to a box, or the very first pull below
  // has nothing to grab, the scramble loop breaks on step 0, and the
  // level is left exactly as it started -- solved. Anchor on a random
  // box and take a random free cell next to it instead of just any free
  // cell in the room.
  int anchor = mazeRngRange(sokoBoxCount);
  int ax = sokoBoxX[anchor], ay = sokoBoxY[anchor];
  int order[4] = {0, 1, 2, 3};
  for (int i = 3; i > 0; i--) {
    int j = mazeRngRange(i + 1);
    int t = order[i];
    order[i] = order[j];
    order[j] = t;
  }
  bool placedPlayer = false;
  for (int oi = 0; oi < 4; oi++) {
    int d = order[oi];
    int px = ax + dx4[d], py = ay + dy4[d];
    if (!sokoBlocked(px, py) && sokoBoxAt(px, py) < 0) {
      sokoPX = px;
      sokoPY = py;
      placedPlayer = true;
      break;
    }
  }
  if (!placedPlayer) {
    // Every neighbor of the anchor box was blocked (shouldn't happen at
    // SOKO_ROOM_SIZE 7 with only 2 boxes, but fall back safely) -- any
    // free cell at all, even if it means the scramble does nothing.
    do {
      sokoPX = 1 + mazeRngRange(sokoW - 2);
      sokoPY = 1 + mazeRngRange(sokoH - 2);
    } while (sokoBoxAt(sokoPX, sokoPY) >= 0);
  }

  int pulls = sokoPullsBase + mazeRngRange(sokoPullsRange);
  for (int step = 0; step < pulls; step++) {
    int order[4] = {0, 1, 2, 3};
    for (int i = 3; i > 0; i--) {
      int j = mazeRngRange(i + 1);
      int t = order[i];
      order[i] = order[j];
      order[j] = t;
    }
    bool moved = false;
    for (int oi = 0; oi < 4 && !moved; oi++) {
      int d = order[oi];
      int fx = sokoPX + dx4[d], fy = sokoPY + dy4[d]; // must hold a box to pull
      int bx = sokoPX - dx4[d], by = sokoPY - dy4[d]; // player steps back here
      int boxIdx = sokoBoxAt(fx, fy);
      if (boxIdx < 0) continue;
      if (sokoBlocked(bx, by) || sokoBoxAt(bx, by) >= 0) continue;
      sokoBoxX[boxIdx] = sokoPX;
      sokoBoxY[boxIdx] = sokoPY;
      sokoPX = bx;
      sokoPY = by;
      moved = true;
    }
    if (!moved) break; // scrambled into a corner -- still a valid, if shorter, puzzle
  }
  sokoMoves = 0;
}

static uint32_t sokoLevelSeed(int level) {
  return (uint32_t)(level + 1) * 2654435761u + 12345u;
}

static bool sokoWon() {
  for (int i = 0; i < sokoBoxCount; i++)
    if (!sokoTarget[sokoBoxY[i]][sokoBoxX[i]]) return false;
  return true;
}

static void sokoTryMove(int dx, int dy) {
  int nx = sokoPX + dx, ny = sokoPY + dy;
  if (sokoBlocked(nx, ny)) return;
  int bi = sokoBoxAt(nx, ny);
  if (bi >= 0) {
    int bnx = nx + dx, bny = ny + dy;
    if (sokoBlocked(bnx, bny) || sokoBoxAt(bnx, bny) >= 0) return;
    sokoBoxX[bi] = bnx;
    sokoBoxY[bi] = bny;
    sfxPush();
  }
  sokoPX = nx;
  sokoPY = ny;
  sokoMoves++;
}

// Level editor hook: tile ids are 0=Floor, 1=Wall, 2=Box, 3=Goal, 4=Start.
// sokoWall/sokoTarget are already sized SOKO_MAX_W/H (9) but the editor
// (and the generator) only ever use the SOKO_ROOM_SIZE (7x7) room.
static void sokoLoadCustom(const LevelData *lvl) {
  sokoW = lvl->w;
  sokoH = lvl->h;
  sokoBoxCount = 0;
  sokoPX = sokoPY = 1;
  for (int r = 0; r < sokoH; r++) {
    for (int c = 0; c < sokoW; c++) {
      uint8_t t = lvl->cells[r][c];
      sokoWall[r][c] = (t == 1);
      sokoTarget[r][c] = (t == 3);
      if (t == 2 && sokoBoxCount < SOKO_MAX_BOXES) {
        sokoBoxX[sokoBoxCount] = c;
        sokoBoxY[sokoBoxCount] = r;
        sokoBoxCount++;
      } else if (t == 4) {
        sokoPX = c;
        sokoPY = r;
      }
    }
  }
  if (sokoBoxCount == 0) { // validate() should prevent this, stay safe anyway
    sokoBoxCount = 1;
    sokoBoxX[0] = sokoPX;
    sokoBoxY[0] = sokoPY;
    sokoTarget[sokoPY][sokoPX] = true;
  }
  sokoMoves = 0;
}

static bool sokoValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int boxes = 0, goals = 0, starts = 0;
  for (int r = 0; r < lvl->h; r++) {
    for (int c = 0; c < lvl->w; c++) {
      uint8_t t = lvl->cells[r][c];
      if (t == 2) boxes++;
      else if (t == 3) goals++;
      else if (t == 4) starts++;
    }
  }
  if (starts != 1) { snprintf(msg, msgLen, "Need exactly 1 Start"); return false; }
  if (boxes < 1 || boxes > SOKO_MAX_BOXES) {
    snprintf(msg, msgLen, "Need 1-%d boxes", SOKO_MAX_BOXES);
    return false;
  }
  if (goals != boxes) { snprintf(msg, msgLen, "Goals must match boxes"); return false; }
  return true;
}

