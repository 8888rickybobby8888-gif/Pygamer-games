static void lvlBlankLevel(LevelData *lvl, uint8_t game) {
  memset(lvl, 0, sizeof(LevelData));
  lvl->magic = LVL_MAGIC;
  lvl->game = game;
  lvl->w = kLevelGames[game].w;
  lvl->h = kLevelGames[game].h;
  lvl->best = LVL_NO_BEST;
  uint8_t def = kLevelGames[game].defaultTile;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++)
      lvl->cells[r][c] = def;
}

// A level saved with smaller extents than its game's grid now (e.g. Cube Dash tracks from before
// the 24-wide grid) is padded with the default tile so the editor can use the whole board.
static void lvlPadToCfg(LevelData *lvl) {
  const LevelGameConfig *cfg = &kLevelGames[lvl->game];
  uint8_t def = cfg->defaultTile;
  for (int r = 0; r < cfg->h; r++)
    for (int c = 0; c < cfg->w; c++)
      if (r >= lvl->h || c >= lvl->w) lvl->cells[r][c] = def;
  lvl->w = cfg->w;
  lvl->h = cfg->h;
}

