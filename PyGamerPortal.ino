static int rpsCpuPick; // 0 rock, 1 paper, 2 scissors
// Reveal animation after each round (non-blocking; the round timer restarts when it ends).
#define RPS_REVEAL_MS 400
static unsigned long rpsRevealStart = 0, rpsRevealEnd = 0; // rpsRevealEnd == 0: no reveal active
static int rpsRevealPlayer = -1, rpsRevealResult = 0;      // player pick (-1 = timed out), 1 win / 0 draw / -1 loss
static bool rpsEndPending = false;                         // the reveal that is playing ends the run

