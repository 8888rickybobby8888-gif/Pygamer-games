// --- Memory Match ------------------------------------------------------
//
// Flip two cards at a time looking for matching pairs on a 4x4 board.
// Board reshuffles fresh (auto-generated) every round -- endless play,
// scored by fewest moves.

#define MEM_GRID 4
#define MEM_CELLS (MEM_GRID * MEM_GRID)
#define MEM_CELL_W (VIEW_COLS * TILE_SIZE / MEM_GRID)
#define MEM_CELL_H (VIEW_ROWS * TILE_SIZE / MEM_GRID)
static uint8_t memValue[MEM_CELLS];
static bool memRevealed[MEM_CELLS], memMatched[MEM_CELLS];
static int memCursorX, memCursorY;
static int memFlipA, memFlipB;
static unsigned long memHideAtMs;
static unsigned long memRevealMs = 700; // how long a mismatch stays face-up
static int memMoves, memMatches, memBestMoves = -1;
// Flip animation (drawing only): change of face-up state is detected per card.
static bool memPrevUp[MEM_CELLS];
static unsigned long memAnimT[MEM_CELLS];
#define MEM_FLIP_MS 150

static uint16_t memColorFor(int pairId) {
  switch (pairId) {
    case 0: return COL_BLUE;
    case 1: return COL_ORANGE;
    case 2: return COL_GOAL;
    case 3: return COL_KEY;
    case 4: return COL_BOOST;
    case 5: return COL_TELE_A;
    case 6: return COL_TELE_B;
    default: return COL_DOOR_CLOSED;
  }
}

static void enterMemTitle() {
  gameState = ST_MEM_TITLE;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_TELE_A, 30, 14, "MEMORY MATCH");
  ptc(COL_TEXT, 4, 40, "D-pad: move cursor");
  pt(4, 50, "A: flip a card");
  pt(4, 60, "Find all 8 pairs!");
  pt(4, 88, "Mode: ");
  canvas->print(kSpeedTierNames[g_variant]);
  pt(4, 98, "Left/Right: change mode");
  canvas->setCursor(4, 108);
  animPrompt("A/Start: play  B: back");
  drawBestLine(12, 26);
  blitScreen();
}

static void enterMemPlaying() {
  s_mazeRng = gameSeed();
  for (int i = 0; i < MEM_CELLS; i++) memValue[i] = i % (MEM_CELLS / 2);
  for (int i = MEM_CELLS - 1; i > 0; i--) {
    int j = mazeRngRange(i + 1);
    uint8_t t = memValue[i];
    memValue[i] = memValue[j];
    memValue[j] = t;
  }
  for (int i = 0; i < MEM_CELLS; i++) {
    memRevealed[i] = false;
    memMatched[i] = false;
    memPrevUp[i] = false;
    memAnimT[i] = 0;
  }
  memCursorX = 0;
  memCursorY = 0;
  memFlipA = -1;
  memFlipB = -1;
  memHideAtMs = 0;
  memMoves = 0;
  memMatches = 0;
  switch (g_variant) {
    case 1: memRevealMs = 350; break;  // Speed
    case 2: memRevealMs = 1000; break; // Chill
    case 3: memRevealMs = 200; break;  // Extreme
    case 4: memRevealMs = 1500; break; // Zen
    default: memRevealMs = 700; break;
  }
  gameState = ST_MEM_PLAYING;
}

static void drawMemScene() {
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  for (int i = 0; i < MEM_CELLS; i++) {
    int cx = i % MEM_GRID, cy = i / MEM_GRID;
    int x = cx * MEM_CELL_W, y = HUD_HEIGHT + cy * MEM_CELL_H;
    bool up = memRevealed[i] || memMatched[i];
    unsigned long now = millis();
    if (up != memPrevUp[i]) { memPrevUp[i] = up; memAnimT[i] = now; }
    uint16_t face = memColorFor(memValue[i]);
    uint16_t fill = up ? face : COL_WALL_NOPORTAL;
    int cw = MEM_CELL_W - 4;
    if (memAnimT[i] != 0 && now - memAnimT[i] < MEM_FLIP_MS) {
      float pr = (float)(now - memAnimT[i]) / (float)MEM_FLIP_MS;
      // squeeze the old face to a sliver, then open the new one
      float sc = (pr < 0.5f) ? 1.0f - pr * 2.0f : pr * 2.0f - 1.0f;
      fill = (pr < 0.5f) ? (up ? COL_WALL_NOPORTAL : face) : (up ? face : COL_WALL_NOPORTAL);
      cw = (int)(cw * sc);
      if (cw < 2) cw = 2;
    }
    canvas->fillRect(x + 2 + (MEM_CELL_W - 4 - cw) / 2, y + 2, cw, MEM_CELL_H - 4, fill);
    if (cx == memCursorX && cy == memCursorY) {
      canvas->drawRect(x + 1, y + 1, MEM_CELL_W - 2, MEM_CELL_H - 2, COL_TEXT);
    }
  }
}

