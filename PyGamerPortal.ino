  canvas->fillRect(0, 0, GAP_PW, HUD_HEIGHT, COL_BG);
  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(1);
  pt(2, 4, "SCORE ");
  canvas->print(gapScore);
}

