// ---- Level packs: /packs/g<game>.pak (browsed from the Levels menu, generated on the PC by tools/make_packs.py) ----
// File = header (20 B) + `count` records back to back, byte fields, no padding:
//   header: "ARPK", version u8 (=1), game u8 (LVLGAME_* id), count u8 (1..60), reserved u8, title[12] ASCII (space padded)
//   record: w u8, h u8, name[8] (A-Z 0-9 space '-', space padded), par u8 (1-9 difficulty marker, informational),
//           cells[w*h] u8 (row-major, stride w, tile ids of that game's editor)
// The whole file stays < 20480 bytes. NOTHING in the file is trusted: a record is playable only when w/h fit the game's
// kLevelGames[] grid, every tile id is < numTiles and the game's own validate function accepts it; broken records are
// listed greyed-out (unplayable) and a record that runs past the end of the file ends the list. Only used with a real
// mounted filesystem (never in the RAM-only fallback and never in USB drive mode).
// The browser keeps its list (names, par, valid bits, record offsets, ~690 B) inside the editor undo ring
// s_lvlUndo (right behind the LevelData thumbnail buffer): no extra static RAM; the editor invalidates it.
#define PK_HDR 20
#define PK_REC_HDR 11
#define PK_MAX_BYTES 20480
typedef struct {
  uint8_t okMask[8];                 // bit i = record i passed every check
  uint16_t off[PK_MAX_LEVELS];       // file offset of record i
  uint8_t par[PK_MAX_LEVELS];
  char name[PK_MAX_LEVELS][8];       // sanitised, space padded, not NUL terminated
  char title[13];
} PkTab;
#define PK_TAB_OFF ((sizeof(LevelData) + 3) & ~(size_t)3)
static_assert(PK_TAB_OFF + sizeof(PkTab) <= LVL_UNDO_DEPTH * LVL_CELLS, "pack list does not fit the undo ring");
#define PKT ((PkTab *)((uint8_t *)s_lvlUndo + PK_TAB_OFF))
static bool s_pkBrowse = false;        // Levels menu sub-mode: the pack browser is open
static bool s_pkAvail = false;         // /packs/g<game>.pak exists with a sane header (probed once per menu visit)
static uint8_t s_pkProbeGame = 0xFF;   // game s_pkAvail belongs to (0xFF = probe again)
static bool s_pkTabOk = false;         // PKT / the count below describe the pack of s_lvlCurGame
static uint8_t s_pkCount = 0;          // usable records (up to the first damaged / truncated one)
static uint8_t s_pkSel = 0, s_pkTop = 0, s_pkPlayIdx = 0;
static uint8_t s_pkLoaded = 0xFF;      // record index whose cells are in the preview buffer (0xFF = none)
static bool s_pkHint = false;

static void pkPath(uint8_t g, char *out, size_t n) { snprintf(out, n, "/packs/g%d.pak", (int)g); }

// Cheap check used for the "Browse Packs" row: file present, header sane, size plausible.
static bool pkProbeFile(uint8_t g) {
  if (g >= LVL_NUM_GAMES || !s_lvlFsReady || s_lvlFsIsRam || g_usbDriveMode) return false;
  char path[24];
  pkPath(g, path, sizeof(path));
  if (!arcada.exists(path)) return false;
  File f = arcada.open(path, O_READ);
  if (!f) return false;
  uint8_t h[PK_HDR];
  uint32_t sz = (uint32_t)f.size();
  bool ok = f.read(h, PK_HDR) == PK_HDR && memcmp(h, "ARPK", 4) == 0 && h[4] == 1 && h[5] == g &&
            h[6] >= 1 && h[6] <= PK_MAX_LEVELS && sz <= PK_MAX_BYTES &&
            sz >= (uint32_t)PK_HDR + (uint32_t)h[6] * (PK_REC_HDR + 1);
  f.close();
  return ok;
}
