// Puts the current player's mark on `cell` (human or CPU). Returns true if
// the round ended (game-over screen shown), false if play continues.
static bool tttPlaceMark(int cell) {
  int8_t who = tttTurn;
  tttBoard[cell] = who;
  tttMarkT[cell] = millis();
  sfx(who == 2 ? 420 : 500, 40);
  int w = tttCheckWinner();
  if (w == 0) {
    tttTurn = (who == 1) ? 2 : 1;
    if (tttVsCpu && tttTurn == 2) tttCpuAt = millis() + 350 + (unsigned long)mazeRngRange(350);
    return false;
  }
  tttEndTween();
  tttWinner = (int8_t)w;
  int m = tttVsCpu ? 0 : 1;
  if (w == 3) { tttSb[m][2]++; sfx(300, 100); }
  else {
    if (w == 1) tttSb[m][0]++; else tttSb[m][1]++;
    if (tttVsCpu && w == 2) sfxDeath();
    else { sfxWin(); pixelsWinCelebration(); }
  }
  if (tttVsCpu) {
    long sc = 0;   // hi-score = human wins at this tier this session
    if (w == 1) sc = ++tttTierWins[g_variant & 3];
    recordResult(14, g_variant, sc, true);
  } else {
    tttFirst = (tttFirst == 1) ? 2 : 1;   // the other player opens the rematch
  }
  gameState = ST_TTT_OVER;
  drawTttOverScreen();
  return true;
}

