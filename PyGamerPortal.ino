// Which games the player has saved a custom level for (bit per LevelGameId, 32 bits), in
// SaveMisc.lvlSavedMask2. Older builds kept it in spare bytes (SaveExt.reserved = games 0..15,
// SaveData.achHi[1] = 16..23, top 5 bits of trophyMask[1] = 24..28): saveMiscMigrate() moves
// those once at boot and frees the trophyMask bits. lvlSavedSync rebuilds a lost mask.
static_assert(LVL_NUM_GAMES <= 32, "lvl saved mask has room for 32 games");
static uint32_t lvlSavedMask() { return g_saveMisc.lvlSavedMask2; }
static void lvlSavedSet(int game) {
  if (game < 0 || game >= LVL_NUM_GAMES) return;
  g_saveMisc.lvlSavedMask2 |= (1UL << game);
}
static void saveMiscMigrate() {
  if (miscGetFlag(MF_LVL_MIGRATED)) return;
  // (trophyMask[1] bits 3+ now hold real trophy bits, so they are no longer read here)
  uint32_t old = (uint32_t)g_saveExt.reserved | ((uint32_t)g_save.achHi[1] << 16);
  g_saveMisc.lvlSavedMask2 |= old & ((1UL << LVL_NUM_GAMES) - 1UL);
  g_saveExt.reserved = 0;
  g_save.achHi[1] = 0;
  g_save.trophyMask[1] &= 0x07;
  miscSetFlag(MF_LVL_MIGRATED, true);
}
static bool achGet(int i) {
  if (i < 16) return (g_save.achMask >> i) & 1u;
  if (i < 24) return (g_save.achHi[(i - 16) >> 3] >> ((i - 16) & 7)) & 1u;
  if (i < 88) return (g_save.achExt[(i - 24) >> 3] >> ((i - 24) & 7)) & 1u;
  if (i >= 152) return false;
  return (g_saveMisc.achX[(i - 88) >> 3] >> ((i - 88) & 7)) & 1u;
}
static void achSet(int i) {
  if (i < 16) g_save.achMask |= (uint16_t)(1u << i);
  else if (i < 24) g_save.achHi[(i - 16) >> 3] |= (uint8_t)(1u << ((i - 16) & 7));
  else if (i < 88) g_save.achExt[(i - 24) >> 3] |= (uint8_t)(1u << ((i - 24) & 7));
  else if (i < 152) g_saveMisc.achX[(i - 88) >> 3] |= (uint8_t)(1u << ((i - 88) & 7));
}
static void achClearAll() {
  g_save.achMask = 0;
  g_save.achHi[0] = 0; g_save.achHi[1] = 0;
  g_saveExt.reserved = 0;
  memset(g_saveMisc.achX, 0, sizeof(g_saveMisc.achX));
  g_saveMisc.lvlSavedMask2 = 0;
  miscSetFlag(MF_PACK_DONE, false);
  for (int b = MF_ACH_RESUME; b <= MF_ACH_CH8; b++) miscSetFlag(b, false);
  memset(g_save.achExt, 0, sizeof(g_save.achExt));
  g_save.evFlags = 0;
  g_save.evFlags2[0] = 0; g_save.evFlags2[1] = 0;
  g_save.cnt2P = 0; g_save.cntPause = 0; g_save.cntLevels = 0; g_save.cntBests = 0;
  g_save.trophyMask[0] = 0; g_save.trophyMask[1] = 0;
}

