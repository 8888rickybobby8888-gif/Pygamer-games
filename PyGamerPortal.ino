// --- Beam Dodge ------------------------------------------------------
//
// Unlike Target Rush (stand still, turn, aim, shoot), this is about
// movement: laser bars sweep across a top-down room and you walk the
// player dot into whichever bar's gap before it reaches you. Each bar
// has one deliberate, clearly-drawn opening -- not a full solid wall you
// have to out-time by reading its speed, which is what made the earlier
// version feel like there was nowhere to go: a full-span band really
// doesn't leave a lateral escape while it's on screen, only a narrow
// timing window most players won't reliably read on a d-pad. A visible
// gap you can walk to is a much more standard, learnable "dodge the
// laser" pattern.

struct SweepBeam {
  bool active;
  bool vertical;  // true: bar spans the height, sweeps left->right. false: spans the width, sweeps top->bottom.
  float pos;      // leading edge position along the sweep axis, in pixels
  float speed;    // pixels/sec
  int thickness;  // bar thickness along the sweep axis, in pixels
  float gapStart; // the safe opening's position along the PERPENDICULAR axis
  float gapSize;
};
#define MAX_BEAMS 2
// Portrait (128x160): 128x144 field under the 16px HUD strip.
#define DODGE_PLAY_W 128
#define DODGE_PLAY_H 144
#define DODGE_PLAYER_R 4
#define DODGE_HIT_COOLDOWN_MS 900UL
#define DODGE_PLAYER_SPEED 110.0f // faster than any beam can ramp to, so reaching a gap in time is always possible

static SweepBeam beams[MAX_BEAMS];
static float dodgePX, dodgePY;
static int dodgeLives = 3;
static unsigned long dodgeStartMs = 0, dodgeFinalMs = 0, dodgeHitUntilMs = 0;
static unsigned long dodgeBeamActivateAt[MAX_BEAMS];
static float dodgeGapSizeCur = 36.0f;
static float dodgeRampMul = 1.0f; // scales how fast beam speed ramps with survival time

// Speed ramps up with survival time instead of starting near its max
// right away, and spawns 40px off the visible edge (not 20) so there's
// real lead-in time to read where the gap is before the bar even
// reaches the playfield.
static void dodgeSpawnBeam(int i) {
  float elapsedSec = (millis() - dodgeStartMs) / 1000.0f;
  float rampSpeed = 16.0f + fminf(elapsedSec, 20.0f) * 1.1f * dodgeRampMul;
  beams[i].vertical = mazeRngRange(2) == 0;
  beams[i].pos = -40.0f;
  beams[i].speed = rampSpeed + mazeRngRange(10);
  beams[i].thickness = 8 + mazeRngRange(6);
  float perpDim = beams[i].vertical ? DODGE_PLAY_H : DODGE_PLAY_W;
  beams[i].gapSize = dodgeGapSizeCur;
  beams[i].gapStart = (float)mazeRngRange((int)(perpDim - dodgeGapSizeCur));
  beams[i].active = true;
}

static void enterDodgeTitle() {
  gameState = ST_DODGE_TITLE;
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_TELE_B, 24, 14, "BEAM DODGE");
