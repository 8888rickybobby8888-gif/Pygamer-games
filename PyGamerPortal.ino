// --- Idle attract mode (picker idle for ~30 s): bouncing logo, twinkling stars and
// confetti bursts on every bounce. Any button wakes it back to the picker. ---
#define ATTRACT_IDLE_MS 30000UL
#define ATT_STARS 28
#define ATT_CONF 24
static unsigned long s_lastInputMs = 0;
static float s_atX = 20, s_atY = 40, s_atVX = 38, s_atVY = 26;
static uint8_t s_atStarX[ATT_STARS], s_atStarY[ATT_STARS], s_atStarPh[ATT_STARS];
static float s_cfX[ATT_CONF], s_cfY[ATT_CONF], s_cfVX[ATT_CONF], s_cfVY[ATT_CONF];
static uint8_t s_cfLife[ATT_CONF];
static uint16_t s_cfCol[ATT_CONF];
static unsigned long s_atLast = 0;
static uint32_t s_atRng = 1;
static uint32_t atRand() { s_atRng ^= s_atRng << 13; s_atRng ^= s_atRng >> 17; s_atRng ^= s_atRng << 5; return s_atRng; }

static void attractStart() {
  s_atRng = micros() | 1u;
  for (int i = 0; i < ATT_STARS; i++) {
    s_atStarX[i] = (uint8_t)(atRand() % 160);
    s_atStarY[i] = (uint8_t)(atRand() % 128);
    s_atStarPh[i] = (uint8_t)(atRand() & 0xFF);
  }
  for (int i = 0; i < ATT_CONF; i++) s_cfLife[i] = 0;
  s_atX = 20; s_atY = 40; s_atVX = 38; s_atVY = 26;
  s_atLast = millis();
  gameState = ST_ATTRACT;
}

static void attractBurst(int x, int y) {
  uint16_t pal[5] = {COL_ORANGE, COL_KEY, COL_BOOST, COL_ICE, COL_TELE_A};
  for (int i = 0, made = 0; i < ATT_CONF && made < 10; i++) {
    if (s_cfLife[i]) continue;
    s_cfX[i] = (float)x;
    s_cfY[i] = (float)y;
    s_cfVX[i] = ((int)(atRand() % 81) - 40) * 1.0f;
    s_cfVY[i] = -(float)(atRand() % 60) - 10.0f;
    s_cfLife[i] = (uint8_t)(18 + atRand() % 14);
    s_cfCol[i] = pal[atRand() % 5];
    made++;
  }
}

static void drawAttract() {
  unsigned long now = millis();
  float dt = (float)(now - s_atLast) / 1000.0f;
  if (dt > 0.1f) dt = 0.1f;
  s_atLast = now;
  const int W = 6 * 7 * 2;      // "ARCADIA" at text size 2
  const int H = 16;
  s_atX += s_atVX * dt;
  s_atY += s_atVY * dt;
  bool hit = false;
  if (s_atX < 0) { s_atX = 0; s_atVX = -s_atVX; hit = true; }
  if (s_atX > 160 - W) { s_atX = (float)(160 - W); s_atVX = -s_atVX; hit = true; }
  if (s_atY < 0) { s_atY = 0; s_atVY = -s_atVY; hit = true; }
  if (s_atY > 128 - H - 18) { s_atY = (float)(128 - H - 18); s_atVY = -s_atVY; hit = true; }
  if (hit) {
    attractBurst((int)s_atX + W / 2, (int)s_atY + H / 2);
  }
  canvas->fillScreen(COL_BG);
  for (int i = 0; i < ATT_STARS; i++) {
    uint8_t tw = (uint8_t)((now / 6 + s_atStarPh[i] * 3) & 0xFF);
    uint8_t lvl = tw < 128 ? tw * 2 : (uint8_t)((255 - tw) * 2);
    canvas->drawPixel(s_atStarX[i], s_atStarY[i], animBlend(COL_BG, 0xFFFF, lvl));
  }
  for (int i = 0; i < ATT_CONF; i++) {
    if (!s_cfLife[i]) continue;
    s_cfVY[i] += 90.0f * dt;
    s_cfX[i] += s_cfVX[i] * dt;
    s_cfY[i] += s_cfVY[i] * dt;
    s_cfLife[i]--;
    if (s_cfX[i] < 0 || s_cfX[i] > 158 || s_cfY[i] > 127) { s_cfLife[i] = 0; continue; }
    canvas->fillRect((int)s_cfX[i], (int)s_cfY[i], 2, 2, s_cfCol[i]);
  }
  uint16_t lc = animBlend(COL_ORANGE, COL_ICE, animPulse(2400));
  canvas->setTextSize(2);
  ptc(lc, (int)s_atX, (int)s_atY, "ARCADIA");
  canvas->setTextSize(1);
  char sub[24];
  snprintf(sub, sizeof(sub), "%d games", NUM_GAMES);
  ptc(COL_TEXT, (int)s_atX + (W - (int)strlen(sub) * 6) / 2, (int)s_atY + H + 3, sub);
  drawPulsingText(34, 118, "Press any button", COL_TEXT, 1400);
  blitScreen();
}

