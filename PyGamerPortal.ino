}

static void enterDodgePlaying() {
  if (portraitGate(enterDodgePlaying, enterDodgeTitle)) return;
  s_mazeRng = gameSeed(); // see the comment in enterMolePlaying
  dodgePX = DODGE_PLAY_W / 2.0f;
  dodgePY = DODGE_PLAY_H / 2.0f;
  dodgeLives = 3;
  switch (g_variant) {
    case 1: dodgeGapSizeCur = 28.0f; dodgeRampMul = 1.3f; break; // Speed
    case 2: dodgeGapSizeCur = 46.0f; dodgeRampMul = 0.75f; break; // Chill
    case 3: dodgeGapSizeCur = 22.0f; dodgeRampMul = 1.6f; break; // Extreme
    case 4: dodgeGapSizeCur = 56.0f; dodgeRampMul = 0.5f; break; // Zen
    default: dodgeGapSizeCur = 36.0f; dodgeRampMul = 1.0f; break;
  }
  dodgeStartMs = millis(); // set before spawning -- dodgeSpawnBeam ramps off elapsed time
  // A second full-room-spanning beam starting immediately alongside the
  // first left no time to even get oriented -- the first is live right
  // away, the second stays dormant for a couple seconds.
  dodgeSpawnBeam(0);
  dodgeBeamActivateAt[0] = dodgeStartMs;
  for (int i = 1; i < MAX_BEAMS; i++) {
    beams[i].active = false;
    dodgeBeamActivateAt[i] = dodgeStartMs + 2000 + i * 1500;
  }
  dodgeHitUntilMs = dodgeStartMs + 1200; // brief grace period before hits count at all
  gameState = ST_DODGE_PLAYING;
  s_lastFrameMs = 0;
}

static void drawDodgeScene() {
  canvas->fillRect(0, HUD_HEIGHT, DODGE_PLAY_W, DODGE_PLAY_H, COL_BG);
  for (int i = 0; i < MAX_BEAMS; i++) {
    if (!beams[i].active) continue;
    int p = (int)beams[i].pos;
    int gapA = (int)beams[i].gapStart, gapB = (int)(beams[i].gapStart + beams[i].gapSize);
    if (beams[i].vertical) {
      // Bar at X=[p, p+thickness), spanning the full height except the
      // gap band in Y -- drawn as two pieces with a visible break.
      if (gapA > 0) canvas->fillRect(p, HUD_HEIGHT, beams[i].thickness, gapA, COL_LASER);
      if (gapB < DODGE_PLAY_H)
        canvas->fillRect(p, HUD_HEIGHT + gapB, beams[i].thickness, DODGE_PLAY_H - gapB, COL_LASER);
    } else {
      if (gapA > 0) canvas->fillRect(0, HUD_HEIGHT + p, gapA, beams[i].thickness, COL_LASER);
      if (gapB < DODGE_PLAY_W)
        canvas->fillRect(gapB, HUD_HEIGHT + p, DODGE_PLAY_W - gapB, beams[i].thickness, COL_LASER);
    }
  }
  bool flashing = millis() < dodgeHitUntilMs;
  canvas->fillCircle((int)dodgePX, HUD_HEIGHT + (int)dodgePY, DODGE_PLAYER_R,
                      flashing ? COL_TEXT : COL_PLAYER);
}

