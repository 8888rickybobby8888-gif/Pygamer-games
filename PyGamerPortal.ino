    s_lastFrameMs = astNow;

    unsigned long elapsed = astNow - asteroidStartMs;
    float speed = asteroidSpeedBase + fminf(elapsed / 1000.0f, 20.0f) * 4.0f; // ramps up over ~20s

    if (buttons & ARCADA_BUTTONMASK_LEFT) asteroidPaddleX -= 90.0f * astDt;
    if (buttons & ARCADA_BUTTONMASK_RIGHT) asteroidPaddleX += 90.0f * astDt;
    if (asteroidPaddleX < ASTEROID_PADDLE_W / 2.0f) asteroidPaddleX = ASTEROID_PADDLE_W / 2.0f;
    if (asteroidPaddleX > ASTEROID_PLAY_W - ASTEROID_PADDLE_W / 2.0f)
