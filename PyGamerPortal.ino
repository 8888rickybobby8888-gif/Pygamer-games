// Validates a freshly loaded/migrated level against its game's config: game id,
// extents (never larger than the config's grid, so game loaders can't overflow
// their own arrays) and tile ids (out-of-range -> default tile).
static bool lvlSanitize(LevelData *d) {
  if (d->game >= LVL_NUM_GAMES) return false;
  const LevelGameConfig *cfg = &kLevelGames[d->game];
  if (d->w < 1 || d->h < 1 || d->w > cfg->w || d->h > cfg->h) return false;
  for (int r = 0; r < d->h; r++)
    for (int c = 0; c < d->w; c++)
      if (d->cells[r][c] >= cfg->numTiles) d->cells[r][c] = cfg->defaultTile;
  return true;
}

