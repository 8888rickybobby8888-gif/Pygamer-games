// The game is decided (w = 1 / 2 / 3 draw): scoreboard + hi-score now, the over screen follows.
static void ckFinish(int w) {
  ckWinner = (int8_t)w;
  int m = ckVsCpu ? 0 : 1;
  ckSb[m][w == 1 ? 0 : (w == 2 ? 1 : 2)]++;
  if (ckVsCpu) {
    if (w == 1) {
      long sc = 100L + 10L * (long)(ckCount(1) - ckCount(2));
      recordResult(53, g_variant, sc < 10L ? 10L : sc, true);
    } else {
      s_lastNewBest = false;
      s_lastNewBestGame = 53;
    }
  } else {
    ckFirst = (ckFirst == 1) ? 2 : 1;   // the other player opens the rematch
  }
  ckSel = -1;
  ckDest = 0;
  ckUndoOk = false;
  ckEnding = true;
  ckEndAt = millis() + 700UL;
}

static void ckToOver() {
  if (ckWinner == 3) sfx(300, 100);
  else if (ckVsCpu && ckWinner == 2) sfxDeath();
  else { sfxWin(); pixelsWinCelebration(); }
  gameState = ST_CK_OVER;
  drawCkOverScreen();
}

// Moves one piece a -> b on the real board (jump = also removes the piece in between).
static void ckDoStep(int a, int b, bool jump) {
  int v = ckBd[a];
  ckBd[a] = 0;
  if (jump) {
    int mid = ckMid(a, b);
    if (mid >= 0) {
      int cv = ckBd[mid];
      ckBd[mid] = 0;
      particlesBurst(ckSqX(mid), ckSqY(mid), 8, ckOwner(cv) == 1 ? ckPc1 : ckPc2);
    }
    ckCapThis = true;
    sfx(220 + 80 * (ckK + ckCpuK > 4 ? 4 : ckK + ckCpuK), 45);
  } else {
    sfx(ckTurn == 2 ? 420 : 500, 25);
  }
  ckBd[b] = (int8_t)v;
}

// The mover's move is complete on square `sq`: crown, hand the turn over.
static void ckEndMove(int sq) {
  unsigned long now = millis();
  int v = ckBd[sq];
  if ((v & 1) && ckPromoRow(ckTurn, sq)) {
    ckBd[sq] = (int8_t)(v + 1);
    ckPromoSq = (int8_t)sq;
    ckPromoT0 = now;
    sfx(1100, 70);
    particlesBurst(ckSqX(sq), ckSqY(sq), 12, ckGold);
  }
  ckLastTo = (int8_t)sq;
  if (ckCapThis) ckQuiet = 0; else ckQuiet++;
  ckCapThis = false;
  ckSel = -1;
  ckDest = 0;
  ckK = 0;
  ckCpuK = 0;
  if (ckQuiet >= 80) { ckFinish(3); return; }
  if (!ckVsCpu) ckUndoOk = true;   // the move just completed can be taken back (Start)
  ckTurn = (uint8_t)(3 - ckTurn);
  ckBusyUntil = now + 220UL;
  ckBeginTurn();
}

// 2 PLAYERS: takes back the last completed move (board, side to move, quiet-move counter, highlight).
static void ckUndo() {
  memcpy(ckBd, ckUndoBd, 32);
  ckTurn = (uint8_t)(3 - ckTurn);
  ckQuiet = ckUndoQuiet;
  ckLastFrom = ckUndoFrom;
  ckLastTo = ckUndoTo;
  memcpy(ckLastMv, ckUndoLastMv, CK_MP);
  ckUndoOk = false;
  ckPromoSq = -1;
  ckCapThis = false;
  ckSel = -1;
  ckDest = 0;
  ckK = 0;
  ckNCand = 0;
  ckRepStart = 0;
  ckBusyUntil = millis() + 220UL;
  sfx(400, 60);
  ckBeginTurn();
}

// Mask of the squares the candidate moves go to next.
static void ckMakeDest() {
  ckDest = 0;
  for (int i = 0; i < ckNCand; i++) ckDest |= (1UL << ckMv[ckCand[i] * CK_MP + 2 + ckK]);
}

static void ckSelect(int s) {
  ckSel = (int8_t)s;
  ckK = 0;
  ckNCand = 0;
  for (int i = 0; i < ckNMv; i++) if (ckMv[i * CK_MP + 1] == s) ckCand[ckNCand++] = (uint8_t)i;
  ckMakeDest();
  sfx(700, 15);
}

// The human picked destination d for the selected piece.
static void ckHumanStep(int d) {
  uint8_t keep[CK_MAXM];
  int nk = 0;
  for (int i = 0; i < ckNCand; i++) if (ckMv[ckCand[i] * CK_MP + 2 + ckK] == d) keep[nk++] = ckCand[i];
  if (nk == 0) { sfxBlocked(); return; }
  memcpy(ckCand, keep, (size_t)nk);
  ckNCand = (uint8_t)nk;
  const uint8_t* m = ckMv + ckCand[0] * CK_MP;
  if (ckK == 0) {
    if (!ckVsCpu) {   // undo snapshot of the position before this move
      memcpy(ckUndoBd, ckBd, 32);
      ckUndoQuiet = ckQuiet;
      ckUndoFrom = ckLastFrom;
      ckUndoTo = ckLastTo;
      memcpy(ckUndoLastMv, ckLastMv, CK_MP);
      ckUndoOk = false;
    }
    ckLastFrom = (int8_t)ckSel;
  }
  ckDoStep(ckSel, d, (m[0] & 0x80) != 0);
  ckK++;
  ckSel = (int8_t)d;
  if (ckK >= (m[0] & 0x7F) - 1) {
    memcpy(ckLastMv, m, CK_MP);
    ckEndMove(d);
  } else {
    ckMakeDest();
  }
}

static void ckFrame(uint32_t buttons, uint32_t pressed) {
  unsigned long now = millis();
  if (ckEnding) {
    if (now >= ckEndAt) { ckToOver(); return; }
    drawCkScene(now);
    blitScreen();
    return;
  }
  bool busy = now < ckBusyUntil;
  bool startTap = false;
  if (!ckVsCpu) {   // 2 PLAYERS: a Start TAP (released within 500 ms) is Undo; holding it is the pause gesture
    bool sd = (buttons & ARCADA_BUTTONMASK_START) != 0;
    if (now - ckLastFrameMs > 150UL) { ckStartArmed = false; ckStartDown = false; }   // first frame / resumed from pause
    if (!sd) ckStartArmed = true;
    if ((pressed & ARCADA_BUTTONMASK_START) && ckStartArmed && !ckStartDown) { ckStartDown = true; ckStartT0 = now; }
    else if (!sd && ckStartDown) { ckStartDown = false; startTap = (now - ckStartT0 < (unsigned long)PAUSE_HOLD_MS); }   // tap window ends where the pause hold begins
    pressed &= ~(uint32_t)ARCADA_BUTTONMASK_START;
  } else {
    ckStartDown = false;
    ckTapPending = false;
  }
  ckLastFrameMs = now;
  if (startTap) ckTapPending = true;          // a tap released during the busy window waits for it to end
  if (ckVsCpu && ckTurn == 2) {
    // CPU's turn: human input is ignored until it has played.
    if (!busy && (long)(now - ckCpuAt) >= 0) {
      if (!ckCpuPlanned) {
        ckCpuPlan();
        ckCpuPlanned = true;
        ckCpuK = 0;
        ckLastFrom = (int8_t)ckPick[1];
        ckCpuAt = millis();
      }
      if (ckPick[0] == 0) {                 // (cannot happen: the turn start checked for moves)
        ckFinish(1);
      } else {
        int a = ckPick[1 + ckCpuK], b = ckPick[2 + ckCpuK];
        ckDoStep(a, b, (ckPick[0] & 0x80) != 0);
        ckCpuK++;
        if (ckCpuK >= (ckPick[0] & 0x7F) - 1) { memcpy(ckLastMv, ckPick, CK_MP); ckEndMove(b); }
        else ckCpuAt = millis() + 280UL;
      }
    }
  } else if (!busy) {
    int dr = 0, dc = 0;
    bool edge = true;
    if (pressed & ARCADA_BUTTONMASK_LEFT) dc = -1;
    else if (pressed & ARCADA_BUTTONMASK_RIGHT) dc = 1;
    else if (pressed & ARCADA_BUTTONMASK_UP) dr = -1;
    else if (pressed & ARCADA_BUTTONMASK_DOWN) dr = 1;
    else edge = false;
    if (edge) {
      ckRepT = now + 220UL;
    } else if ((long)(now - ckRepT) >= 0) {    // held D-pad: cursor auto-repeat
      if (buttons & ARCADA_BUTTONMASK_LEFT) dc = -1;
      else if (buttons & ARCADA_BUTTONMASK_RIGHT) dc = 1;
      else if (buttons & ARCADA_BUTTONMASK_UP) dr = -1;
      else if (buttons & ARCADA_BUTTONMASK_DOWN) dr = 1;
      if (dr || dc) ckRepT = now + 90UL;
    }
    if (ckTapPending) {
      ckTapPending = false;
      if (ckUndoOk && ckK == 0) ckUndo();
      else sfxBlocked();
    } else if (dr || dc) {
      int nr = (int)ckCr + dr, nc = (int)ckCc + dc;
      if (nr >= 0 && nr < 8 && nc >= 0 && nc < 8) { ckCr = (uint8_t)nr; ckCc = (uint8_t)nc; sfxMove(); }
    } else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      int lr = ckViewFlip ? 7 - (int)ckCr : (int)ckCr, lc = ckViewFlip ? 7 - (int)ckCc : (int)ckCc;   // cursor cell -> real square
      int s = ((lr + lc) & 1) ? lr * 4 + (lc >> 1) : -1;
      if (s < 0) {
        sfxBlocked();
      } else if (ckSel < 0) {
        if ((ckMovable >> s) & 1UL) ckSelect(s);
        else sfxBlocked();
      } else if ((ckDest >> s) & 1UL) {
        ckHumanStep(s);
      } else if (ckK == 0 && ((ckMovable >> s) & 1UL)) {
        ckSelect(s);                         // pick a different piece
      } else {
        sfxBlocked();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      if (ckSel >= 0) {
        if (ckK == 0) { ckSel = -1; ckDest = 0; ckNCand = 0; sfx(300, 15); }   // (mid-chain the piece must go on)
        else sfxBlocked();
      } else if (ckLastMv[0]) {            // nothing selected: replay the last move
        ckRepStart = now ? now : 1UL;
        sfx(600, 20);
      }
    }
  }
  if (!ckEnding) {                           // (ckHumanStep/ckEndMove may have ended the game)
    drawCkScene(now);
    blitScreen();
  }
}

// --- Chess ----------------------------------------------------------------------------
//
// Full-rules chess: castling (not out of / through / into check), en passant, promotion (the
// human picks Q/R/B/N, the CPU always queens), check, checkmate, stalemate, draw by insufficient
// material, the 50-move rule and threefold repetition (32-bit position hashes of the plies since
// the last pawn move / capture). Board = 0x88 mailbox (piece = type 1..6 P N B R Q K, +8 for
// black), moves are 16-bit (from | to << 6 | flags << 12; flags 0 quiet, 1 double push,
// 2 O-O, 3 O-O-O, 4 capture, 5 en passant, 8..11 promotion N/B/R/Q, 12..15 the same with capture).
// The generator is pseudo-legal + make/unmake + a king-safety filter (perft-checked on the host
// against the standard counts). Two modes like Checkers: vs CPU (you are White; g_variant 0 NORMAL
// = 2-ply material, 1 EASY = random with a capture bias, 2 HARD = 3-ply alpha-beta with
// piece-square tables, 3 EXTREME = iterative deepening to 5 ply + quiescence, 12000 nodes /
// 400 ms with the last completed depth's move as the fallback) or 2 PLAYERS hot-seat (colours
// swap every game, board flips for Black, Start tap = undo). vs-CPU win score = 100 + 10 x tier
// + material margin (pawns, 0..40). Extras: an opening book for HARD / EXTREME (first plies), a hint
// (vs CPU: Start tap, not on EXTREME; 2P: hold B) that cancels the score, an optional 2P clock,
// and save & resume of an unfinished game (SaveMisc.chessSave; repetition history is not saved).

