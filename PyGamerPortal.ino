static int brkLives, brkScore, brkRound, brkBestScore;
static int brkBricksLeft;
static float brkBallSpeedMul = 1.0f;

static void brkNewRound() {
  brkBricksLeft = 0;
  for (int r = 0; r < BRK_ROWS; r++) {
    for (int c = 0; c < BRK_COLS; c++) {
      bool alive = mazeRngRange(100) < 70;
      brkAlive[r][c] = alive;
      if (alive) brkBricksLeft++;
    }
  }
  if (brkBricksLeft == 0) {
    brkAlive[0][0] = true;
    brkBricksLeft = 1;
  }
  brkBallX = VIEW_COLS * TILE_SIZE / 2.0f;
  brkBallY = HUD_HEIGHT + VIEW_ROWS * TILE_SIZE - 20.0f;
  brkBallVX = 55.0f * brkBallSpeedMul;
  brkBallVY = -75.0f * brkBallSpeedMul;
  brkPaddleX = VIEW_COLS * TILE_SIZE / 2.0f;
}

// Level editor hook: tile ids are 0=Empty, 1=Brick, grid is BRK_COLS x
// BRK_ROWS -- exactly brkAlive[][]'s own dimensions.
static void brkLoadCustom(const LevelData *lvl) {
  brkBricksLeft = 0;
  for (int r = 0; r < BRK_ROWS; r++) {
    for (int c = 0; c < BRK_COLS; c++) {
      bool alive = (r < lvl->h && c < lvl->w) ? (lvl->cells[r][c] == 1) : false;
      brkAlive[r][c] = alive;
      if (alive) brkBricksLeft++;
    }
  }
  if (brkBricksLeft == 0) { // validate() should prevent this, stay safe anyway
    brkAlive[0][0] = true;
    brkBricksLeft = 1;
  }
}

static bool brkValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int bricks = 0;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++)
      if (lvl->cells[r][c] == 1) bricks++;
  if (bricks < 1) { snprintf(msg, msgLen, "Need at least 1 brick"); return false; }
  return true;
}

