struct Level {
  // '#'=wall 'N'=portal-proof wall '.'=floor '~'=pit (blocks walking, not
  // aim) 'I'=ice (slides you until you hit something) 'S'=start 'G'=goal
  // 'X'=box 'P'=pressure plate 'D'=door (opens when any plate is covered)
  // '^','v','<','>'=laser emitter firing that direction 'Y'=key
  // 'K'=locked door (needs a key, consumed on use, unlike 'D')
  // 'u','d','l','r'=conveyor belt forcing you up/down/left/right
  // regardless of which way you stepped on -- chain them to turn corners
  // 'F'=speed boost pad 'M'=mud (slows you down)
  // 'T'/'U'=a fixed, always-on teleporter pair (no shooting needed --
  // distinct from the player-fired blue/orange portals)
  // A level can supply fewer than MAX_GRID_ROWS strings (the rest default
  // to nullptr) -- actual height is however many non-null rows there are,
  // actual width is strlen(rows[0]). All existing 10x7 levels still work
  // unchanged since they're just the small case of this.
  const char* rows[MAX_GRID_ROWS];
};

