// --- Expansion cartridges + CHIP-8: data that the picker needs early ------------------------------
// Installed carts are NOT in the kGame* tables: cartScan() lists /carts/*.arc at boot into s_carts[]
// and the picker shows them with ids CART_BASE + index. The VM itself lives near launchGameV().
#define CART_BASE 64
static_assert(NUM_GAMES <= CART_BASE, "cart picker ids start after the last built-in game");
#define CRGB(r, g, b) ((uint16_t)((((r) & 0xF8) << 8) | (((g) & 0xFC) << 3) | ((b) >> 3)))
static const uint16_t kCartPal[16] = {
  CRGB(0, 0, 0), CRGB(255, 255, 255), CRGB(240, 50, 50), CRGB(60, 220, 90), CRGB(60, 110, 255), CRGB(255, 230, 70),
  CRGB(60, 220, 230), CRGB(230, 80, 230), CRGB(255, 150, 40), CRGB(150, 150, 160), CRGB(60, 60, 75), CRGB(255, 150, 190),
  CRGB(160, 240, 60), CRGB(150, 90, 40), CRGB(20, 30, 110), CRGB(140, 80, 220)
};
static CartEntry s_carts[CART_MAX];
static uint8_t s_cartN = 0;          // valid carts found
static uint8_t s_cartBad = 0;        // files in /carts that were skipped (bad header / too long a name)
static bool s_cartDirOk = false;     // /carts exists
static uint8_t s_romN = 0;           // CHIP-8 ROMs found in /roms (counted at boot, for Diagnostics)
static bool s_romDirOk = false;
// /arcadia/carts.bin: per-cart plays, best score per tier and 16 save bytes
static CartRec s_cbRec[CART_MAX];
static uint8_t s_cbN = 0;
static bool cartIsId(int g) { return g >= CART_BASE && g < CART_BASE + (int)s_cartN; }
static CartRec* cartRecOf(int k) {
  if (k < 0 || k >= (int)s_cartN) return NULL;
  for (int i = 0; i < (int)s_cbN; i++) if (s_cbRec[i].key == s_carts[k].key) return &s_cbRec[i];
  return NULL;
}
static int32_t cartBestOf(int k, int t) {
  CartRec* r = cartRecOf(k);
  return (r && t >= 0 && t < 4) ? r->best[t] : SAVE_NO_SCORE;
}
static uint16_t pkPlays(int g) {
  if (cartIsId(g)) { CartRec* r = cartRecOf(g - CART_BASE); return r ? r->plays : 0; }
  return savePlays(g);
}
static const char* pkName(int g) {
  if (cartIsId(g)) return s_carts[g - CART_BASE].name;
  return (g >= 0 && g < NUM_GAMES) ? kGameNames[g] : "?";
}
static const char* pkBlurb(int g) {
  if (cartIsId(g)) return s_carts[g - CART_BASE].blurb;
  return (g >= 0 && g < NUM_GAMES) ? kGameBlurbs[g] : "";
}
