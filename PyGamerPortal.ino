    else if (buttons & ARCADA_BUTTONMASK_DOWN) { pacWantDX = 0; pacWantDY = 1; }

    bool pacDied = false;
    if (pacNow >= pacReadyUntil) {
      if (pacNow >= pacModeUntil) {
        pacChase = !pacChase;
        pacModeUntil = pacNow + (pacChase ? pacChaseMs : pacScatterMs);
      }
      if (pacNow >= pacMoveAt) {
        pacMoveAt = pacNow + pacStepMs;
        if ((pacWantDX || pacWantDY) && pacOpen(pacX + pacWantDX, pacY + pacWantDY)) {
          pacDX = pacWantDX;
          pacDY = pacWantDY;
