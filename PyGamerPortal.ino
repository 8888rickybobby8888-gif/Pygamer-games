// --- Lights Out ------------------------------------------------------------
//
// Toggle a cell and its neighbors, trying to turn every light off.
// Boards are scrambled from the solved (all-off) state by a random
// sequence of toggles -- since toggling twice undoes itself, that
// guarantees every board is solvable. No lives -- solve and the next,
// harder board loads immediately.

#define LIGHTS_GRID 5
#define LIGHTS_CELL (VIEW_ROWS * TILE_SIZE / LIGHTS_GRID)
static bool lightsOn[LIGHTS_GRID][LIGHTS_GRID];
static int lightsCursorX, lightsCursorY;
static int lightsMoves, lightsRound, lightsBestMoves = -1;
static int lightsStartToggles = 6;
static const char* kLightsTierNames[4] = {"NORMAL", "EASY", "HARD", "EXTREME"};

static void lightsToggle(int x, int y) {
  if (x < 0 || x >= LIGHTS_GRID || y < 0 || y >= LIGHTS_GRID) return;
  lightsOn[y][x] = !lightsOn[y][x];
}

static void lightsScramble() {
  for (int y = 0; y < LIGHTS_GRID; y++)
    for (int x = 0; x < LIGHTS_GRID; x++) lightsOn[y][x] = false;
  int numToggles = lightsStartToggles + lightsRound;
  if (numToggles > 30) numToggles = 30;
  for (int i = 0; i < numToggles; i++) {
    int x = mazeRngRange(LIGHTS_GRID), y = mazeRngRange(LIGHTS_GRID);
    lightsToggle(x, y);
    lightsToggle(x - 1, y);
    lightsToggle(x + 1, y);
    lightsToggle(x, y - 1);
    lightsToggle(x, y + 1);
  }
}

static bool lightsAllOff() {
  for (int y = 0; y < LIGHTS_GRID; y++)
    for (int x = 0; x < LIGHTS_GRID; x++)
      if (lightsOn[y][x]) return false;
  return true;
}

// Level-creator start pattern (tile 1 = light on). A custom board is one puzzle: solving
// it ends the round (ST_LIGHTS_OVER). Validation also checks solvability: on 5x5 a pattern
// is solvable iff it is orthogonal (mod 2) to the two "quiet" patterns below.
static bool lightsCustom = false;
static const uint8_t kLightsQuiet[2][5] = {{0x0E, 0x15, 0x1B, 0x15, 0x0E}, {0x15, 0x15, 0x00, 0x15, 0x15}};

static bool lightsValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  if (lvlCountTile(lvl, 1) < 1) { snprintf(msg, msgLen, "Turn some lights on"); return false; }
  for (int q = 0; q < 2; q++) {
    int par = 0;
    for (int r = 0; r < 5 && r < lvl->h; r++)
      for (int c = 0; c < 5 && c < lvl->w; c++)
        if (lvl->cells[r][c] == 1 && (kLightsQuiet[q][r] & (1 << c))) par ^= 1;
    if (par) { snprintf(msg, msgLen, "Unsolvable pattern"); return false; }
  }
  return true;
}

static void lightsLoadCustom(const LevelData *lvl) {
  int n = 0;
  for (int y = 0; y < LIGHTS_GRID; y++)
    for (int x = 0; x < LIGHTS_GRID; x++) {
      bool on = (y < lvl->h && x < lvl->w && lvl->cells[y][x] == 1);
      lightsOn[y][x] = on;
      if (on) n++;
    }
  lightsCustom = n > 0;
}

