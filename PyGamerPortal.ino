// --- Speed Maze (timed first-person maze escape) --------------------------
//
// The third game mode: a plain perfect maze (recursive backtracker, same
// carving idea as Portal's generateMazeLevel but without any of its
// mandatory-pit/key/door hazard insertion -- those are built assuming
// you can shoot a portal to bridge them, which this mode doesn't have).
// A perfect maze is solvable by construction (every cell reaches every
// other cell through its spanning tree), so unlike generateMazeLevel
// there's no BFS solvability check or retry loop needed here. Reuses
// Portal's movement/collision (updatePlayer) and rendering (castColumn,
// drawFloorCeiling) wholesale -- reach the goal diamond, and the clock
// stops.
#define SPEEDMAZE_CELLS_W 8
#define SPEEDMAZE_CELLS_H 6

static unsigned long mazeStartMs = 0;
static unsigned long mazeFinalElapsedMs = 0;
static float mazeTurnSpeedCur = 4.2f;

static void generateSpeedMaze(uint32_t seed) {
  const int cellsW = SPEEDMAZE_CELLS_W, cellsH = SPEEDMAZE_CELLS_H;
  const int W = 2 * cellsW + 1, H = 2 * cellsH + 1;
  static bool visited[SPEEDMAZE_CELLS_H][SPEEDMAZE_CELLS_W];
  static int8_t stackX[SPEEDMAZE_CELLS_W * SPEEDMAZE_CELLS_H];
  static int8_t stackY[SPEEDMAZE_CELLS_W * SPEEDMAZE_CELLS_H];
  static const int8_t dx4[4] = {1, -1, 0, 0};
  static const int8_t dy4[4] = {0, 0, 1, -1};

  s_mazeRng = seed;
  for (int r = 0; r < H; r++)
    for (int c = 0; c < W; c++)
      grid[r][c] = T_WALL;
  for (int cy = 0; cy < cellsH; cy++)
    for (int cx = 0; cx < cellsW; cx++) {
      grid[2 * cy + 1][2 * cx + 1] = T_FLOOR;
      visited[cy][cx] = false;
    }

  int sp = 0;
  stackX[0] = 0;
  stackY[0] = 0;
  visited[0][0] = true;
  sp = 1;
  while (sp > 0) {
    int cx = stackX[sp - 1], cy = stackY[sp - 1];
    int order[4] = {0, 1, 2, 3};
    for (int i = 3; i > 0; i--) {
      int j = mazeRngRange(i + 1);
      int t = order[i];
      order[i] = order[j];
      order[j] = t;
    }
    bool moved = false;
    for (int oi = 0; oi < 4 && !moved; oi++) {
      int d = order[oi];
      int nx = cx + dx4[d], ny = cy + dy4[d];
      if (nx >= 0 && nx < cellsW && ny >= 0 && ny < cellsH && !visited[ny][nx]) {
        grid[2 * cy + 1 + dy4[d]][2 * cx + 1 + dx4[d]] = T_FLOOR;
        visited[ny][nx] = true;
        stackX[sp] = nx;
        stackY[sp] = ny;
        sp++;
        moved = true;
      }
    }
    if (!moved) sp--;
  }

  curW = W;
  curH = H;
  playerX = tileCenterX(1);
  playerY = tileCenterY(1);
  playerAngle = 0;
  goalRow = H - 2;
  goalCol = W - 2;
  grid[goalRow][goalCol] = T_GOAL;

  for (int i = 0; i < MAX_BOXES; i++) boxes[i].active = false;
  numEmitters = 0;
  doorsOpen = false;
  hasKey = false;
  levelWon = false;
  portalBlueRow = portalOrangeRow = -1;
  teleportARow = teleportBRow = -1;
  keyRow = -1;
}

// Level editor hook: tile ids are 0=Floor, 1=Wall, 2=Start, 3=Goal. Speed
// Maze reuses Portal's own grid[]/TileType/playerX/Y/goalRow/goalCol engine
// wholesale (see generateSpeedMaze() above), so a custom level just needs
// to fill that same shared state instead of inventing a parallel one.
static void mazeLoadCustom(const LevelData *lvl) {
  curW = lvl->w;
  curH = lvl->h;
  for (int r = 0; r < lvl->h; r++) {
    for (int c = 0; c < lvl->w; c++) {
      uint8_t t = lvl->cells[r][c];
      grid[r][c] = (t == 1) ? T_WALL : (t == 3) ? T_GOAL : T_FLOOR;
      if (t == 2) {
        playerX = tileCenterX(c);
        playerY = tileCenterY(r);
      }
      if (t == 3) {
        goalRow = r;
        goalCol = c;
      }
    }
  }
  playerAngle = 0;
  for (int i = 0; i < MAX_BOXES; i++) boxes[i].active = false;
  numEmitters = 0;
  doorsOpen = false;
  hasKey = false;
  levelWon = false;
  portalBlueRow = portalOrangeRow = -1;
  teleportARow = teleportBRow = -1;
  keyRow = -1;
}

static bool mazeValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int starts = 0, goals = 0, startR = -1, startC = -1;
  for (int r = 0; r < lvl->h; r++) {
    for (int c = 0; c < lvl->w; c++) {
      uint8_t t = lvl->cells[r][c];
      if (t == 2) { starts++; startR = r; startC = c; }
      else if (t == 3) goals++;
    }
  }
  if (starts != 1) { snprintf(msg, msgLen, "Need exactly 1 Start"); return false; }
  if (goals != 1) { snprintf(msg, msgLen, "Need exactly 1 Goal"); return false; }

  // Simple reachability check (flood fill from Start over non-Wall cells) --
  // not a full solver, just confirms at least one Goal isn't sealed off.
  static bool vis[LVL_GRID_MAXH][LVL_GRID_MAXW];
  memset(vis, 0, sizeof(vis));
  int qx[LVL_GRID_MAXW * LVL_GRID_MAXH], qy[LVL_GRID_MAXW * LVL_GRID_MAXH];
  int qh = 0, qt = 0;
  qx[qt] = startC; qy[qt] = startR; qt++;
  vis[startR][startC] = true;
  bool reached = false;
  static const int8_t dx4[4] = {1, -1, 0, 0};
  static const int8_t dy4[4] = {0, 0, 1, -1};
  while (qh < qt) {
    int cx = qx[qh], cy = qy[qh]; qh++;
    if (lvl->cells[cy][cx] == 3) reached = true;
    for (int d = 0; d < 4; d++) {
      int nx = cx + dx4[d], ny = cy + dy4[d];
      if (nx < 0 || nx >= lvl->w || ny < 0 || ny >= lvl->h) continue;
      if (vis[ny][nx] || lvl->cells[ny][nx] == 1) continue;
      vis[ny][nx] = true;
      qx[qt] = nx; qy[qt] = ny; qt++;
    }
  }
  if (!reached) { snprintf(msg, msgLen, "Goal not reachable"); return false; }
  return true;
}

// Title-screen hint line: shows the active custom slot (A replays it) or the Levels shortcut.
