static void orientTick() {
  unsigned long now = millis();
  if (now - s_orientSampleMs < 30) return;
  s_orientSampleMs = now;
  if (!arcada.accel) return;
  arcada.accel->read();
  float ax = arcada.accel->x_g, ay = arcada.accel->y_g;
  float a0 = fabsf(ax), a1 = fabsf(ay);
  // One-time axis check while the player is browsing the menus in landscape.
  if (!s_axisLearned && !s_orientPort && !s_orientEverPort && (gameState == ST_GAME_PICKER || gameState == ST_SPLASH) && now < 120000UL) {
    float mx = a0 > a1 ? a0 : a1, mn = a0 > a1 ? a1 : a0;
    if (mx > 0.55f && mx > 2.0f * mn) {
      if (s_axisSince == 0) s_axisSince = now;
      if (now - s_axisSince >= 1000) { s_axisSwap = (a0 > a1); s_axisLearned = true; }
    } else {
      s_axisSince = 0;
    }
  }
  float gl = s_axisSwap ? ay : ax;   // along the landscape X axis
  float al = fabsf(gl), as = s_axisSwap ? a0 : a1; // as = along the landscape Y axis
  int8_t c;
  if (al > 0.6f && al > 1.6f * as) c = (gl > 0) ? 1 : 2;
  else if (as > 0.55f && as > 1.6f * al) c = 0;
  else c = -1;
  if (c < 0) { s_orientCand = -1; return; } // flat / diagonal: keep the committed state
  if (c != s_orientCand) { s_orientCand = c; s_orientSince = now; }
  if (now - s_orientSince < 300) return;
  if (c == 0) {
    s_orientPort = false;
  } else {
    uint8_t d = (c == 1) ? 1 : 0;   // intentionally this way round (empirical); see comment above
    if (!s_orientPort) { s_orientPort = true; s_orientEverPort = true; s_autoDir = d; s_autoFlipMs = now; }
    else if (d != s_autoDir && now - s_autoFlipMs >= 1000) { s_autoDir = d; s_autoFlipMs = now; }
  }
}

// Rotates the four direction bits of a button mask into the portrait screen's frame
// (A/B/Start are untouched). Portrait A: screen-up = device RIGHT, screen-right = device
// DOWN, screen-down = device LEFT, screen-left = device UP. Portrait B is the mirror.
static uint32_t portRemap(uint32_t m) {
  const uint32_t U = ARCADA_BUTTONMASK_UP, D = ARCADA_BUTTONMASK_DOWN;
  const uint32_t L = ARCADA_BUTTONMASK_LEFT, R = ARCADA_BUTTONMASK_RIGHT;
  uint32_t o = m & ~(U | D | L | R);
  if (portDir() == 0) {
    if (m & R) o |= U;
    if (m & D) o |= R;
    if (m & L) o |= D;
    if (m & U) o |= L;
  } else {
    if (m & L) o |= U;
    if (m & U) o |= R;
    if (m & R) o |= D;
    if (m & D) o |= L;
  }
  return o;
}
