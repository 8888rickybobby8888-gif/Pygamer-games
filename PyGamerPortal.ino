// --- Snake -----------------------------------------------------------------
//
// Classic grid snake: eat food to grow, don't hit the walls or yourself.
// Speed ramps up as you grow. Endless -- no levels, just a high score.

#define SNAKE_CELL 8
#define SNAKE_COLS (VIEW_COLS * TILE_SIZE / SNAKE_CELL)
#define SNAKE_ROWS (VIEW_ROWS * TILE_SIZE / SNAKE_CELL)
#define SNAKE_MAX_LEN (SNAKE_COLS * SNAKE_ROWS)
struct SnakeCell { int8_t x, y; };
static SnakeCell snakeBody[SNAKE_MAX_LEN];
static int snakeLen;
static int8_t snakeDX, snakeDY, snakeNextDX, snakeNextDY;
static int8_t snakeFoodX, snakeFoodY;
static unsigned long snakeMoveAtMs, snakeStepMs;
static int snakeScore, snakeBest;
// Level-creator obstacles: the editor grid is a coarse 10x7 overlay; each tile is 2x2 snake
// cells. snakeReach marks cells the snake can actually get to (so food never spawns walled in).
static uint8_t snakeWall[SNAKE_ROWS][SNAKE_COLS];
static uint8_t snakeReach[SNAKE_ROWS][SNAKE_COLS];

static void snakeComputeReach() {
  memset(snakeReach, 0, sizeof(snakeReach));
  static int8_t stk[SNAKE_ROWS * SNAKE_COLS][2];
  int sp = 0;
  int sx = SNAKE_COLS / 2, sy = SNAKE_ROWS / 2;
  snakeReach[sy][sx] = 1;
  stk[sp][0] = (int8_t)sx; stk[sp][1] = (int8_t)sy; sp++;
  while (sp > 0) {
    sp--;
    int x = stk[sp][0], y = stk[sp][1];
    static const int8_t d[4][2] = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}};
    for (int k = 0; k < 4; k++) {
      int nx = x + d[k][0], ny = y + d[k][1];
      if (nx < 0 || ny < 0 || nx >= SNAKE_COLS || ny >= SNAKE_ROWS) continue;
      if (snakeWall[ny][nx] || snakeReach[ny][nx]) continue;
      snakeReach[ny][nx] = 1;
      stk[sp][0] = (int8_t)nx; stk[sp][1] = (int8_t)ny; sp++;
    }
  }
}

// Level editor hook: tile 0 = empty, 1 = wall block (2x2 snake cells).
static void snakeLoadCustom(const LevelData *lvl) {
  memset(snakeWall, 0, sizeof(snakeWall));
  for (int r = 0; r < lvl->h && r < VIEW_ROWS; r++)
    for (int c = 0; c < lvl->w && c < VIEW_COLS; c++)
      if (lvl->cells[r][c] == 1)
        for (int dy = 0; dy < 2; dy++)
          for (int dx = 0; dx < 2; dx++) snakeWall[r * 2 + dy][c * 2 + dx] = 1;
}

static bool snakeValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int walls = 0;
  for (int r = 0; r < lvl->h; r++)
    for (int c = 0; c < lvl->w; c++)
      if (lvl->cells[r][c] == 1) walls++;
  if (walls < 1) { snprintf(msg, msgLen, "Need at least 1 wall"); return false; }
  if (walls > 24) { snprintf(msg, msgLen, "Max 24 wall blocks"); return false; }
  for (int c = 3; c <= 7; c++)
    if (lvl->cells[3][c] == 1) { snprintf(msg, msgLen, "Keep middle row clear"); return false; }
  return true;
}

static void snakePlaceFood() {
  for (;;) {
    int fx = mazeRngRange(SNAKE_COLS);
    int fy = mazeRngRange(SNAKE_ROWS);
    if (snakeWall[fy][fx] || !snakeReach[fy][fx]) continue;
    bool onBody = false;
    for (int i = 0; i < snakeLen; i++) {
      if (snakeBody[i].x == fx && snakeBody[i].y == fy) { onBody = true; break; }
    }
    if (!onBody) {
      snakeFoodX = fx;
      snakeFoodY = fy;
      return;
    }
  }
}

