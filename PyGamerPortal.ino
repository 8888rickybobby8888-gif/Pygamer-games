// The game is over: scoreboard + hi-score now; the over screen follows after the last flips.
static void rvFinish() {
  int b = rvCount(rvBd, 1), w = rvCount(rvBd, 2);
  rvWinner = b > w ? 1 : (w > b ? 2 : 3);
  int m = rvVsCpu ? 0 : 1;
  rvSb[m][rvWinner == 1 ? 0 : (rvWinner == 2 ? 1 : 2)]++;
  if (rvVsCpu && rvCustom) {   // hand-made start: only the slot's own best (disc margin) is kept
    s_lastNewBest = false;
    lvlRecordRun(LVLGAME_REV, b > w ? (long)(b - w) : 0L, true);
    if (b > w) lvlOnClear(LVLGAME_REV);
  } else if (rvVsCpu) recordResult(39, g_variant, b > w ? (long)(b - w) : 0L, true);
  else rvFirst = (rvFirst == 1) ? 2 : 1;   // the other player opens the rematch
  rvEnding = true;
  rvEndAt = millis() + RV_FLIP_MS + 500;
}

static void rvToOver() {
  if (rvWinner == 3) sfx(300, 100);
  else if (rvVsCpu && rvWinner == 2) sfxDeath();
  else { sfxWin(); pixelsWinCelebration(); }
  gameState = ST_REV_OVER;
  drawRevOverScreen();
}

// Turn hand-over after `mover` played: normal, the opponent passes, or the game ends.
static void rvAdvance(int mover) {
  int other = 3 - mover;
  if (rvLegalMask(rvBd, other) != 0) {
    rvTurn = other;
  } else if (rvLegalMask(rvBd, mover) != 0) {
    rvTurn = mover;
    snprintf(rvMsgWho, sizeof(rvMsgWho), "%s", rvName(other));
    rvMsgUntil = millis() + 1800;
    sfx(300, 80);
  } else {
    rvLegal = 0;
    rvFinish();
    return;
  }
  rvLegal = rvLegalMask(rvBd, rvTurn);
  if (rvVsCpu && rvTurn == 2) rvCpuAt = millis() + RV_FLIP_MS + 150 + (unsigned long)mazeRngRange(300);
}

static void rvPlace(int idx) {
  int who = rvTurn;
  uint64_t fs = 0;
  rvApply(rvBd, idx, who, &fs);
  rvFlipSet = fs;
  rvFlipWho = (int8_t)who;
  rvFlipT0 = millis();
  rvBusyUntil = rvFlipT0 + RV_FLIP_MS;
  rvLastMove = idx;
  sfx(who == 2 ? 420 : 500, 40);
  rvAdvance(who);
}

// One frame of Reversi (called from loop() after the pause check).
static void revFrame(uint32_t pressed) {
  unsigned long now = millis();
  if (rvEnding) {
    if (now >= rvEndAt) { rvToOver(); return; }
    drawRevScene();
    blitScreen();
    return;
  }
  if (pressed & ARCADA_BUTTONMASK_B) {
    gameState = ST_GAME_PICKER;
    drawGamePicker();
    return;
  }
  bool busy = now < rvBusyUntil;
  if (rvVsCpu && rvTurn == 2) {
    // CPU's turn: human input is ignored until it has played.
    if (!busy && (long)(now - rvCpuAt) >= 0) {
      int mv = rvCpuPick();
      if (mv >= 0) rvPlace(mv);
    }
  } else {
    if ((pressed & ARCADA_BUTTONMASK_LEFT) && (rvCur & 7) > 0) rvCur--;
    else if ((pressed & ARCADA_BUTTONMASK_RIGHT) && (rvCur & 7) < 7) rvCur++;
    else if ((pressed & ARCADA_BUTTONMASK_UP) && rvCur >= 8) rvCur -= 8;
    else if ((pressed & ARCADA_BUTTONMASK_DOWN) && rvCur < 56) rvCur += 8;
    else if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (!busy && ((rvLegal >> rvCur) & 1ULL)) rvPlace(rvCur);
      else sfxBlocked();
    }
  }
  drawRevScene();
  blitScreen();
}

// --- Tank Duel ---------------------------------------------------------------
//
// Side-view artillery duel on seeded hilly terrain. Two tanks (left = P1, right = P2 /
// CPU) take turns: Up/Down set the angle, Left/Right the power, A fires a shell that
// flies under gravity and a drifting wind. The shell digs a crater where it lands and
// damages every tank near the blast (a direct hit hurts most); first to 0 HP loses.
// Two modes like Reversi: vs CPU (4 strengths, g_variant 0..3 = NORMAL / EASY / HARD /
// EXTREME) or 2 PLAYERS hot-seat. CPU: solves the power for a random angle with a cheap
// bisection over simulated shots, then adds an aim error that shrinks with the tier
// (EXTREME also compensates the wind fully, HARD half). vs-CPU score on a win =
// HP x 10 + 50 per round won this session.

#define TK_W 160
#define TK_G 110.0f
#define TK_VK 1.55f
#define TK_WINDK 7.0f
#define TK_TRAIL 48
static uint8_t tkSurf[TK_W];              // ground surface y per column (larger = lower)
static int tkHp[2], tkX[2], tkAng[2], tkPow[2], tkDmg[2];
static int tkTurn, tkWind, tkExX, tkExY, tkExR, tkCpuAng, tkCpuPow, tkTrN;
static bool tkVsCpu = true;               // mode: true = vs CPU, false = 2 PLAYERS
static int tkSb[2][3];                    // scoreboard [0 = vs CPU, 1 = 2P][P1/You, P2/CPU, draws]
static int8_t tkFirst = 1;                // 2P: who opens the next round
static int8_t tkWinner;                   // 1 / 2 / 3 = draw
static uint8_t tkPhase;                   // 0 aim, 1 shell flying, 2 impact, 3 ending
static float tkSx, tkSy, tkSvx, tkSvy;
static int16_t tkTr[TK_TRAIL][2];
static float tkFlightAcc;   // seconds of shell flight (frame-delta based, so pausing doesn't eat it)
static unsigned long tkFlightT0, tkPhaseT0, tkRepT, tkCpuAt, tkTrT;

static const char* tkName(int who) {      // who: 0 = left tank, 1 = right tank
  if (tkVsCpu) return who == 0 ? "YOU" : "CPU";
  return who == 0 ? "P1" : "P2";
}

// Level-creator terrain: 20 columns of 8 px, tile = ground height 0-8 (y = 116 - 8*h), linearly
// blended between column centres. Replaces the seeded hills in both tank modes.
static uint8_t tkStrip[20];
static bool tkCustom = false;

static bool tankValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  uint8_t lo = 255, hi = 0;
  for (int c = 0; c < lvl->w; c++) {
    uint8_t v = lvl->cells[0][c];
    if (v < lo) lo = v;
    if (v > hi) hi = v;
  }
  if (hi == lo) { snprintf(msg, msgLen, "Add some hills"); return false; }
  return true;
}

static void tankLoadCustom(const LevelData *lvl) {
  for (int c = 0; c < 20; c++) {
    uint8_t v = (c < lvl->w) ? lvl->cells[0][c] : 3;
    tkStrip[c] = v > 8 ? 8 : v;
  }
  tkCustom = true;
}

static void tkGenTerrain() {
  if (tkCustom) {
    for (int x = 0; x < TK_W; x++) {
      float fc = (x - 4) / 8.0f;                 // column-centre coordinate
      int c0 = (int)floorf(fc);
      float t = fc - (float)c0;
      int a = c0 < 0 ? 0 : (c0 > 19 ? 19 : c0);
      int b = c0 + 1 < 0 ? 0 : (c0 + 1 > 19 ? 19 : c0 + 1);
      float hgt = (float)tkStrip[a] + ((float)tkStrip[b] - (float)tkStrip[a]) * t;
      tkSurf[x] = (uint8_t)(116.0f - 8.0f * hgt);
    }
    tkX[0] = 16 + mazeRngRange(16);
    tkX[1] = 144 - mazeRngRange(16);
    for (int t = 0; t < 2; t++) {
      uint8_t base = tkSurf[tkX[t]];
      for (int x = tkX[t] - 7; x <= tkX[t] + 7; x++) if (x >= 0 && x < TK_W) tkSurf[x] = base;
    }
    return;
  }
  float p1 = mazeRngRange(628) / 100.0f, p2 = mazeRngRange(628) / 100.0f, p3 = mazeRngRange(628) / 100.0f;
  float a1 = 10.0f + mazeRngRange(12), a2 = 5.0f + mazeRngRange(8), a3 = 2.0f + mazeRngRange(4);
  float f1 = 0.022f + mazeRngRange(100) / 5000.0f, f2 = 0.055f + mazeRngRange(100) / 3000.0f, f3 = 0.13f;
  for (int x = 0; x < TK_W; x++) {
    float h = 84.0f + a1 * sinf(x * f1 + p1) + a2 * sinf(x * f2 + p2) + a3 * sinf(x * f3 + p3);
    if (h < 52.0f) h = 52.0f;
    if (h > 116.0f) h = 116.0f;
    tkSurf[x] = (uint8_t)h;
  }
  tkX[0] = 16 + mazeRngRange(16);
  tkX[1] = 144 - mazeRngRange(16);
  for (int t = 0; t < 2; t++) {
    uint8_t base = tkSurf[tkX[t]];
    for (int x = tkX[t] - 7; x <= tkX[t] + 7; x++) if (x >= 0 && x < TK_W) tkSurf[x] = base;
  }
}

// Simulates the CPU tank's (right side) shell and returns the x where it comes down.
static float tkSim(int ang, int pw, float windUse) {
  float a = ang * 0.0174533f;
  float x = tkX[1] - cosf(a) * 9.0f;
  float y = tkSurf[tkX[1]] - 6.0f - sinf(a) * 9.0f;
  float vx = -cosf(a) * pw * TK_VK, vy = -sinf(a) * pw * TK_VK;
  float ax = tkWind * TK_WINDK * windUse;
  const float h = 0.02f;
  for (int i = 0; i < 400; i++) {
    vx += ax * h;
    vy += TK_G * h;
    x += vx * h;
    y += vy * h;
    if (x < 0.0f) return -1000.0f;
    if (x >= (float)TK_W) return 1000.0f;
    if (i > 5 && y >= (float)tkSurf[(int)x]) return x;
    if (y > 140.0f) return x;
  }
  return x;
}

static void tkCpuPlan() {
  int tier = g_variant & 3;   // 0 NORMAL, 1 EASY, 2 HARD, 3 EXTREME
  float wu = tier == 3 ? 1.0f : (tier == 2 ? 0.5f : 0.0f);
  int ang = 36 + mazeRngRange(32);
  int lo = 10, hi = 100;
  for (int it = 0; it < 7; it++) {
    int mid = (lo + hi) / 2;
    if (tkSim(ang, mid, wu) < (float)tkX[0]) hi = mid; else lo = mid + 1;
  }
  int pw = lo;
  static const uint8_t kEA[4] = {7, 14, 3, 1};
  static const uint8_t kEP[4] = {10, 20, 4, 1};
  ang += mazeRngRange(2 * kEA[tier] + 1) - kEA[tier];
  pw += mazeRngRange(2 * kEP[tier] + 1) - kEP[tier];
  if (ang < 5) ang = 5;
  if (ang > 85) ang = 85;
  if (pw < 10) pw = 10;
  if (pw > 100) pw = 100;
  tkCpuAng = ang;
  tkCpuPow = pw;
  tkCpuAt = 0;
}

