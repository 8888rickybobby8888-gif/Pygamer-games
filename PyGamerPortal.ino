static uint8_t s_helpGame = 0;       // game whose help is on screen
static uint8_t s_helpLaunch = 0;     // game to launch on close (first-launch flow)
static uint8_t s_helpFrom = 0;       // 0 = opened from the pause menu, 1 = first launch
static unsigned long s_helpT0 = 0;   // when the current page started (line slide-in animation)

static bool helpSeen(int g) {
  if (g < 0 || g >= NUM_GAMES) return true;
  if (g >= 48) return (g_save.reserved >> (g - 48)) & 1u;   // pad[] only holds games 0..47
  return (g_save.pad[1 + (g >> 3)] >> (g & 7)) & 1u;
}
static void helpSetSeen(int g) {
  if (g < 0 || g >= NUM_GAMES || helpSeen(g)) return;
  if (g >= 48) g_save.reserved |= (uint16_t)(1u << (g - 48));
  else g_save.pad[1 + (g >> 3)] |= (uint8_t)(1u << (g & 7));
  s_favDirty = true;                  // debounced save from loop()
  s_favSaveAt = millis() + 1500;
}

// One line sliding in from the right and fading up, `idx` * 90 ms after the page opened.
static void helpLine(int idx, int y, const char* s, uint16_t col) {
  if (!s || !s[0]) return;
  long el = (long)(millis() - s_helpT0) - (long)idx * 90L;
  if (el <= 0) return;
  float t = animEase((float)el / 240.0f);
  int x = 4 + (int)((1.0f - t) * 90.0f);
  ptc(animBlend(COL_BG, col, (uint8_t)(t * 255.0f)), x, y, s);
}

static void drawHelpScreen() {
  if (s_helpGame == 0xFF) { cartDrawHelp(); return; }   // the running cartridge's own page
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  const int g = s_helpGame < NUM_GAMES ? s_helpGame : 0;
  const uint16_t cc = s_pickerColors[g];
  const HelpDef& h = kHelp[g];
  drawGameIcon(5, 4, g, 3, cc);                     // 24x24
  ptc(cc, 34, 8, kGameNames[g]);
  ptc(COL_TEXT, 34, 20, "HOW TO PLAY");
  char pg[8];
  snprintf(pg, sizeof(pg), "%d/%d", g + 1, NUM_GAMES);
  ptc(COL_ICE, 160 - 4 - (int)strlen(pg) * 6, 20, pg);
  canvas->fillRect(4, 31, 152, 1, animBlend(COL_BG, cc, 140));
  helpLine(0, 37, h.goal, COL_KEY);
  for (int i = 0; i < 4; i++) helpLine(1 + i, 51 + i * 11, h.c[i], COL_TEXT);
  helpLine(5, 98, h.tip, cc);
  ptc(COL_TEXT, 4, 118, "L/R: page   B: back");
  blitScreen();
}

// d = +1 / -1: next / previous game's page (wraps).
static void helpPage(int d) {
  if (s_helpGame == 0xFF) return;
  s_helpGame = (uint8_t)((s_helpGame + NUM_GAMES + d) % NUM_GAMES);
  s_helpT0 = millis();
  sfxMove();
  drawHelpScreen();
}

// from: 0 = pause menu (counts toward the "Student" achievement), 1 = first launch.
static void helpOpen(int g, uint8_t from) {
  if (g < 0 || g >= NUM_GAMES) g = 0;
  s_helpGame = (uint8_t)g;
  s_helpLaunch = (uint8_t)g;
  s_helpFrom = from;
  s_helpT0 = millis();
  helpSetSeen(g);
  if (from == 0) { s_fadeSkipOnce = true; evSet2(10); }   // no fade: it would overwrite s_fadeBuf (= the pause backdrop)
  gameState = ST_HELP;
  if (from == 0) sfx(600, 40);   // (the picker already played its select blip)
  drawHelpScreen();
  if (from == 0) checkAchievements();
}

// --- Two-player hot-seat mode ---------------------------------------------
//
// The PyGamer only has one set of controls, so "2 player" here means
// hot-seat: player 1 plays a full round, then player 2 plays the exact
// same round (same RNG seed, so it's a fair comparison), then a results
// screen declares a winner. Toggled from the Settings screen.

static void drawTwoPIntroScreen() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 4, 30, "GET READY");

  canvas->setTextColor(COL_TEXT);
  canvas->setTextSize(2);
  char buf[10];
  snprintf(buf, sizeof(buf), "PLAYER %d", g_twoPPlayerNum);
  int textW = strlen(buf) * 12;
  pt((VIEW_COLS * TILE_SIZE - textW) / 2, 50, buf);

  canvas->setTextSize(1);
  pt(4, 108, "A: start");
  blitScreen();
}

static void drawTwoPResultsScreen() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 30, 6, "RESULTS");
  canvas->setTextColor(COL_TEXT);

  pt(4, 24, "P1 ");
  canvas->print(g_twoPScoreLabel);
  canvas->print(": ");
  canvas->print(g_twoPScoreP1);

  pt(4, 36, "P2 ");
  canvas->print(g_twoPScoreLabel);
  canvas->print(": ");
  canvas->print(g_twoPScoreP2);

  int winner; // 0 = tie, 1 = P1, 2 = P2
  if (g_twoPScoreP1 == g_twoPScoreP2) winner = 0;
  else if (g_twoPHigherIsBetter) winner = (g_twoPScoreP1 > g_twoPScoreP2) ? 1 : 2;
  else winner = (g_twoPScoreP1 < g_twoPScoreP2) ? 1 : 2;

  canvas->setTextSize(1);
  if (winner == 0) {
    ptc(COL_ORANGE, 30, 60, "TIE GAME");
  } else {
    ptc(COL_GOAL, 14, 60, "PLAYER ");
    canvas->print(winner);
    canvas->print(" WINS");
  }

  ptc(COL_TEXT, 4, 108, "A: back to games");
  blitScreen();
}

// --- Mix mode ---------------------------------------------------------------
// Five distinct quick score-attack games back to back on the Normal tier. Each
// game's usual game-over site calls twoPHandleGameEnd() (via twoPOrMix()), which
// hands the score to mixHandleGameEnd() instead of showing the game's own over
// screen. Stars per game compare against the personal Normal best from BEFORE the
// round (g_mixPrevBest). The game list / launching lives next to launchGame().

static void mixStarShape(int cx, int cy, uint16_t col, bool filled) {
  if (filled) {
    canvas->fillTriangle(cx, cy - 4, cx - 4, cy + 3, cx + 4, cy + 3, col);
    canvas->fillTriangle(cx, cy + 4, cx - 4, cy - 2, cx + 4, cy - 2, col);
  } else {
    canvas->drawTriangle(cx, cy - 4, cx - 4, cy + 3, cx + 4, cy + 3, col);
    canvas->drawTriangle(cx, cy + 4, cx - 4, cy - 2, cx + 4, cy - 2, col);
  }
}

// "GAME k/5: NAME" card. Title slides in from the left, name from the right.
static void drawMixIntro() {
  unsigned long now = millis();
  float t = animEase((float)(now - g_mixAnimT0) / 320.0f);
  int g = g_mixList[g_mixK];
  const char* nm = kGameNames[g];
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  ptc(COL_ORANGE, 46, 8, "MIX MODE");
  char buf[16];
  snprintf(buf, sizeof(buf), "GAME %d/%d", (int)g_mixK + 1, MIX_COUNT);
  canvas->setTextSize(2);
  canvas->setTextColor(COL_TEXT);
  int w = (int)strlen(buf) * 12;
  pt((160 - w) / 2 - (int)((1.0f - t) * 170.0f), 28, buf);
  int ts = strlen(nm) <= 12 ? 2 : 1;
  canvas->setTextSize(ts);
  canvas->setTextColor(s_pickerColors[g]);
  w = (int)strlen(nm) * 6 * ts;
  pt((160 - w) / 2 + (int)((1.0f - t) * 170.0f), 58, nm);
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  const char* bl = kGameBlurbs[g];
  pt((160 - (int)strlen(bl) * 6) / 2, 82, bl);
  // progress dots: done = star, current = pulsing, rest = hollow
  for (int i = 0; i < MIX_COUNT; i++) {
    int cx = 80 + (i - 2) * 16;
    if (i < g_mixK) mixStarShape(cx, 100, COL_KEY, true);
    else if (i == g_mixK) canvas->fillCircle(cx, 100, 3, animBlend(COL_BG, COL_ORANGE, (uint8_t)(90 + animPulse(500) * 165 / 255)));
    else canvas->drawCircle(cx, 100, 3, COL_TEXT);
  }
  pt(4, 118, "A: go   B: quit mix");
  blitScreen();
}

static void mixShowIntro() {
  g_mixAnimT0 = millis();
  g_mixIntroEnd = g_mixAnimT0 + 1500;
  gameState = ST_MIX_INTRO;
  drawMixIntro();
  sfx(660, 40);
}

static int mixTotalStars() {
  int t = 0;
  for (int i = 0; i < MIX_COUNT; i++) t += g_mixStars[i];
  return t;
}

// Rows slide in from the right one after another; then stars light up and the total appears.
static void drawMixResults() {
  unsigned long el = millis() - g_mixAnimT0;
  int total = mixTotalStars();
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  uint16_t tc = (total == 3 * MIX_COUNT) ? animBlend(COL_KEY, 0xFFFF, animPulse(500)) : COL_ORANGE;
  canvas->setTextColor(tc);
  const char* head = (total == 3 * MIX_COUNT) ? "PERFECT MIX!" : "MIX RESULTS";
  pt((160 - (int)strlen(head) * 6) / 2, 4, head);
  for (int i = 0; i < MIX_COUNT; i++) {
    long rowT = (long)el - (long)i * 110;
    float p = animEase((float)rowT / 260.0f);
    int off = (int)((1.0f - p) * 170.0f);
    int y = 18 + i * 14;
    int g = g_mixList[i];
    char nm[16];
    snprintf(nm, sizeof(nm), "%.13s", kGameNames[g]);
    ptc(s_pickerColors[g], 4 + off, y, nm);
    for (int s = 0; s < 3; s++) {
      bool lit = s < g_mixStars[i] && rowT > 260 + s * 90;
      mixStarShape(91 + s * 11 + off, y + 4, lit ? COL_KEY : animBlend(COL_BG, COL_TEXT, 90), lit);
    }
    char val[16];
    fmtBestValue(g, (int32_t)g_mixScore[i], val, sizeof(val));
    ptc(COL_TEXT, 126 + off, y, val);
  }
  long totT = (long)el - 5 * 110 - 500;
  if (totT > 0) {
    char buf[16];
    snprintf(buf, sizeof(buf), "%d/%d", total, 3 * MIX_COUNT);
    canvas->setTextSize(2);
    canvas->setTextColor(total == 3 * MIX_COUNT ? COL_KEY : COL_TEXT);
    float p = animBounce((float)totT / 400.0f);
    pt((160 - (int)strlen(buf) * 12) / 2, 92 - (int)((1.0f - p) * 24.0f), buf);
    canvas->setTextSize(1);
  }
  ptc(COL_TEXT, 4, 118, "A/B: back to games");
  blitScreen();
}

static void mixFinish() {
  int total = mixTotalStars();
  evSet2(8);
  if (total == 3 * MIX_COUNT) evSet2(9);
  g_mixLastTotal = (int8_t)total;
  if (total > g_mixBestTotal) g_mixBestTotal = (int8_t)total;
  g_saveMisc.mixLast = (uint8_t)(g_mixLastTotal + 1);
  g_saveMisc.mixBest = (uint8_t)(g_mixBestTotal + 1);
  g_mixActive = false;
  checkAchievements();
  saveWrite();
  g_mixAnimT0 = millis();
  gameState = ST_MIX_RESULTS;
  drawMixResults();
  jingleStart(JG_MIX);
}

// Called with the finished game's score. Stars: 3 = new best / tied best (or no best yet),
// 2 = at least 60% of the old best, 1 = anything else (a zero score is always 1 star).
static void mixHandleGameEnd(long score) {
  int k = g_mixK;
  int st;
  if (score <= 0) st = 1;
  else if (g_mixPrevBest == SAVE_NO_SCORE || score >= (long)g_mixPrevBest) st = 3;
  else if (score * 100L >= (long)g_mixPrevBest * 60L) st = 2;
  else st = 1;
  if (k >= 0 && k < MIX_COUNT) {
    g_mixStars[k] = (uint8_t)st;
    g_mixScore[k] = score;
  }
  sfx(st == 3 ? 1000 : (st == 2 ? 760 : 400), 80);
  g_mixK++;
  if (g_mixK >= MIX_COUNT) mixFinish();
  else mixShowIntro();
}

// Called from a game's own game-over trigger site instead of switching to
// that game's *_OVER state, whenever 2P mode is active. Records the just-
// finished player's score, then either hands off to player 2 (re-seeding
// the shared RNG so their round is identical) or, if player 2 just
// finished, shows the results screen.
static void twoPHandleGameEnd(long score) {
  if (g_mixActive) { mixHandleGameEnd(score); return; }
  if (g_twoPPlayerNum == 1) {
    g_twoPScoreP1 = score;
    g_twoPPlayerNum = 2;
    s_mazeRng = g_twoPSeed;
    gameState = ST_TWOP_INTRO;
    drawTwoPIntroScreen();
    sfx(500, 40);
  } else {
    g_twoPScoreP2 = score;
    g_save.evFlags |= 1;
    bump8(g_save.cnt2P);
    checkAchievements();
    saveWrite();
    gameState = ST_TWOP_RESULTS;
    drawTwoPResultsScreen();
    jingleStart(JG_WIN);
  }
}

// Title-screen A/Start in 2P mode, shared by the Stage-2 games (same fields
// the older games set inline). Player 1 goes through the intro screen first.
static void twoPBegin(EnterPlayingFn fn, bool higherIsBetter, const char* label) {
  g_twoPPlayerNum = 1;
  g_twoPScoreP1 = 0;
  g_twoPScoreP2 = 0;
  g_twoPHigherIsBetter = higherIsBetter;
  strncpy(g_twoPScoreLabel, label, sizeof(g_twoPScoreLabel) - 1);
  g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
  g_twoPSeed = micros() ^ 0xBEEFu;
  g_twoPEnterFn = fn;
  s_mazeRng = g_twoPSeed;
  gameState = ST_TWOP_INTRO;
  drawTwoPIntroScreen();
}

// RNG seed for a round: the shared 2P seed (so P2 replays P1's round) in
// 2P mode, otherwise a fresh time-based one like the other games.
static uint32_t gameSeed() {
  uint32_t s = g_twoPlayerMode ? g_twoPSeed
               : g_challengeSeed ? g_challengeSeed
               : (g_userSeed ? (0x5EED0000u + (uint32_t)g_userSeed * 2654435761u) : (millis() ^ 0xC0FFEEu));
  return s ? s : 0xC0FFEEu;
}

// --- Settings screen (brightness/sound) -----------------------------------
//
// Reachable with B from the game picker (B is otherwise unbound there --
// the picker is the top of the menu hierarchy, so there's nothing to
// "go back" to).

static int trophyCount() {
  int c = 0;
  for (int i = 0; i < NUM_TROPHIES; i++) if (trophyEarned(i)) c++;
  return c;
}
static int s_trophySel = 0;

static uint16_t trophyColor(int tier) {
  switch (tier) {
    case 0: return arcada.display->color565(205, 127, 50);
    case 1: return arcada.display->color565(200, 200, 215);
    case 2: return arcada.display->color565(255, 200, 0);
    case 3: return arcada.display->color565(140, 220, 255);
  }
  return arcada.display->color565(255, 120, 200);
}

static void drawCup(int x, int y, uint16_t col) {
  canvas->fillRect(x, y, 9, 5, col);
  canvas->fillRect(x + 3, y + 5, 3, 3, col);
  canvas->fillRect(x + 1, y + 8, 7, 2, col);
  canvas->drawRect(x - 2, y + 1, 3, 3, col);
  canvas->drawRect(x + 8, y + 1, 3, 3, col);
}

static float s_trHi = 0, s_trScr = 0;

static int trophyTopTarget() {
  const int rows = 6;
  int top = s_trophySel - rows / 2;
  if (top > NUM_TROPHIES - rows) top = NUM_TROPHIES - rows;
  if (top < 0) top = 0;
  return top;
}

static void drawTrophyScreen() {
  canvas->fillScreen(COL_BG);
  canvas->setTextSize(1);
  uint16_t dim = arcada.display->color565(60, 60, 70);
  uint32_t now = millis();
  // Bar glides to the selected row; rows scroll under the header/footer masks.
  int by = 16 + (int)floorf((s_trHi - s_trScr) * 14.0f + 0.5f);
  canvas->fillRect(2, by - 2, 156, 13, COL_WALL_NOPORTAL);
  int first = (int)floorf(s_trScr) - 1;
  if (first < 0) first = 0;
  for (int i = first; i < NUM_TROPHIES && i <= first + 8; i++) {
    int y = 16 + (int)floorf(((float)i - s_trScr) * 14.0f + 0.5f);
    if (y < 0 || y > 104) continue;
    bool got = trophyEarned(i);
    uint16_t cc = dim;
    if (got) {
      cc = trophyColor(kTrophies[i].tier);
      // Shimmer: a short bright glint that sweeps through each earned cup.
      uint32_t ph = (now / 3 + (uint32_t)i * 83u) % 700u;
      if (ph < 120) cc = animBlend(cc, 0xFFFF, (uint8_t)((ph < 60 ? ph : 120 - ph) * 4));
    }
    drawCup(8, y - 1, cc);
    ptc(got ? COL_TEXT : dim, 24, y + 1, kTrophies[i].name);
  }
  canvas->fillRect(0, 0, 160, 14, COL_BG);
  canvas->fillRect(0, 101, 160, 27, COL_BG);
  canvas->setTextColor(COL_ORANGE);
  canvas->setCursor(4, 3);
  char head[28];
  snprintf(head, sizeof(head), "TROPHIES %d/%d", trophyCount(), NUM_TROPHIES);
  canvas->print(head);
  ptc(COL_TEXT, 4, 106, kTrophies[s_trophySel].desc);
  pt(4, 118, "U/D scroll   B: back");
  blitScreen();
}

static void trophyAnimTick() {
  animChase(s_trHi, (float)s_trophySel, 0.42f);
  animChase(s_trScr, (float)trophyTopTarget(), 0.42f);
  drawTrophyScreen();
}

// Settings rows, in display order (grouped; kSetGrp marks where each group's header bar goes).
// Every dispatch below uses these names, not numbers.
enum {
  SR_BRIGHT = 0, SR_MENU, SR_CARTANIM, SR_PORT,                 // DISPLAY
  SR_SOUND, SR_VOLUME, SR_BOOTSND, SR_MUSIC, SR_SNDTEST,        // SOUND (SNDTEST: A plays)
  SR_2P, SR_BOOT, SR_AUTOHELP, SR_TILT, SR_TILTGAIN,            // PLAY (L/R values; A = back to picker)
  SR_HUB, SR_CREDITS,                                           // MORE: A opens a screen
  SR_DIAG, SR_ERRLOG, SR_USB, SR_RESTORE,                                  // SYSTEM: SR_RESTORE = A twice
  SR_RESET_ACH, SR_DELLVLS, SR_RESET_SAVES,                     // DANGER ZONE: A twice
  SR_FACTORY,                                                   // A opens the hold-to-confirm Factory reset screen (stays last)
  SR_COUNT
};
#define SET_ROWS SR_COUNT
#define SET_GROUPS 6
#define SET_LINES (SR_COUNT + SET_GROUPS)   // rows + one header line per group
#define SET_VISIBLE 8
#define SET_Y0 14
#define SET_PITCH 12
static int s_settingsTop = 0;   // target first visible line (headers count as lines)
static int s_settingsSel = 0;
static bool s_resetArmed = false;
static int s_delLvlN = 0;   // custom levels counted when "Delete levels" was armed

static float s_setHi = 1, s_setScr = 0;   // eased highlight line / scroll line
static uint8_t s_setPl = 0;               // pulse level (0..3) of the last drawn frame

static const uint8_t kSetGrp[SET_GROUPS] = {SR_BRIGHT, SR_SOUND, SR_2P, SR_HUB, SR_DIAG, SR_RESET_ACH};
static const char* const kSetGrpName[SET_GROUPS] = {"DISPLAY", "SOUND", "PLAY", "MORE", "SYSTEM", "DANGER ZONE"};
static const char* const kSetLbl[SR_COUNT] = {
  "Brightness", "Menu", "Cart anim", "Portrait",
  "Sound", "Volume", "Boot sound", "Menu music", "Sound test",
  "2 Player", "Boot", "Auto help", "Tilt", "Tilt gain",
  "Challenges & Awards", "Credits",
  "Diagnostics", "Error log", "USB drive", "Restore backup",
  "Reset achievements", "Delete levels", "Reset saves", "Factory reset"};
static const uint8_t kSetIcon[SR_COUNT][8] = {
  {0x10, 0x54, 0x38, 0xEE, 0x38, 0x54, 0x10, 0x00},   // sun
  {0xEE, 0xEE, 0xEE, 0x00, 0xEE, 0xEE, 0xEE, 0x00},   // layout
  {0x7E, 0x7E, 0x42, 0x5A, 0x7E, 0x7E, 0x7E, 0x00},   // cartridge
  {0x3C, 0x24, 0x24, 0x24, 0x24, 0x24, 0x3C, 0x18},   // portrait phone
  {0x08, 0x18, 0xF8, 0xF8, 0xF8, 0x18, 0x08, 0x00},   // speaker
  {0x02, 0x02, 0x0A, 0x0A, 0x2A, 0x2A, 0xAA, 0xAA},   // volume bars
  {0x18, 0x3C, 0x3C, 0x3C, 0x7E, 0x7E, 0x00, 0x18},   // bell
  {0x0C, 0x0E, 0x0A, 0x0A, 0x0A, 0x38, 0x78, 0x30},   // note
  {0x40, 0x60, 0x70, 0x78, 0x70, 0x60, 0x40, 0x00},   // play
  {0x66, 0x66, 0x00, 0xE7, 0xE7, 0xE7, 0x00, 0x00},   // two players
  {0x18, 0x5A, 0x99, 0x99, 0x81, 0x42, 0x3C, 0x00},   // power
  {0x3C, 0x66, 0x06, 0x0C, 0x18, 0x00, 0x18, 0x00},   // ?
  {0x06, 0x0E, 0x1C, 0x38, 0x70, 0xE0, 0xC0, 0x00},   // tilt
  {0x3C, 0x42, 0x89, 0x91, 0x81, 0x42, 0x3C, 0x00},   // gauge
  {0xFF, 0xBD, 0xBD, 0x7E, 0x18, 0x18, 0x3C, 0x7E},   // trophy
  {0x18, 0x18, 0x7E, 0xFF, 0x7E, 0x3C, 0x66, 0x42},   // star
  {0x38, 0x44, 0x44, 0x44, 0x38, 0x1C, 0x0E, 0x06},   // magnifier
  {0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00},   // !
