static void enterRevPlaying() {
  if (s_lvlActiveSlot[LVLGAME_REV] >= 0 && (s_lvlTestPlay || s_lvlPack || s_lvlPackPlay)) rvVsCpu = true;   // custom runs are always vs the CPU
  for (int i = 0; i < 64; i++) rvBd[i] = 0;
  rvBd[27] = 2; rvBd[36] = 2; rvBd[28] = 1; rvBd[35] = 1;
  rvCustom = false;
  if (s_lvlActiveSlot[LVLGAME_REV] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_REV, s_lvlActiveSlot[LVLGAME_REV], &lvl)) revLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_REV] = -1;
  }
  rvTurn = rvVsCpu ? 1 : rvFirst;   // the human always opens vs the CPU
  rvLegal = rvLegalMask(rvBd, rvTurn);
  if (rvLegal == 0 && rvCustom) {   // a hand-made start where the opener cannot move: the other side opens
    rvTurn = 3 - rvTurn;
    rvLegal = rvLegalMask(rvBd, rvTurn);
  }
  if (rvLegal == 0 && rvCustom) {   // neither side can move: fall back to the classic opening
    for (int i = 0; i < 64; i++) rvBd[i] = 0;
    rvBd[27] = 2; rvBd[36] = 2; rvBd[28] = 1; rvBd[35] = 1;
    rvCustom = false;
    rvTurn = rvVsCpu ? 1 : rvFirst;
    rvLegal = rvLegalMask(rvBd, rvTurn);
  }
  rvCur = 0;
  for (int i = 0; i < 64; i++) if ((rvLegal >> i) & 1ULL) { rvCur = i; break; }
  rvFlipSet = 0;
  rvFlipWho = 1;
  rvFlipT0 = 0;
  rvLastMove = -1;
  rvBusyUntil = 0;
  rvMsgUntil = 0;
  rvEnding = false;
  rvWinner = 0;
  rvCpuAt = millis() + 600;
  s_mazeRng = (millis() ^ 0xC0FFEEu) | 1u;
  gameState = ST_REV_PLAYING;
}

// A disc drawn as a circle, or (scale < 1) as a squashed ellipse for the flip animation.
static void rvDisc(int cx, int cy, int who, float sc) {
  uint16_t col = who == 1 ? arcada.display->color565(22, 22, 26) : arcada.display->color565(240, 240, 235);
  if (sc >= 0.99f) {
    canvas->fillCircle(cx, cy, 5, col);
    if (who == 1) canvas->drawCircle(cx, cy, 5, arcada.display->color565(120, 120, 130));
    return;
  }
  for (int dy = -5; dy <= 5; dy++) {
    int w = (int)(sqrtf((float)(25 - dy * dy)) * sc);
    canvas->drawFastHLine(cx - w, cy + dy, 2 * w + 1, col);
  }
}

static void drawRevScene() {
  unsigned long now = millis();
  canvas->fillScreen(COL_BG);
  uint16_t felt = arcada.display->color565(0, 110, 60), grid = arcada.display->color565(0, 66, 34);
  canvas->fillRect(RV_X0, RV_Y0, 8 * RV_CELL + 1, 8 * RV_CELL + 1, felt);
  for (int i = 0; i <= 8; i++) {
    canvas->drawFastHLine(RV_X0, RV_Y0 + i * RV_CELL, 8 * RV_CELL + 1, grid);
    canvas->drawFastVLine(RV_X0 + i * RV_CELL, RV_Y0, 8 * RV_CELL + 1, grid);
  }
  bool humanTurn = !rvEnding && !(rvVsCpu && rvTurn == 2);
  for (int i = 0; i < 64; i++) {
    int cx = RV_X0 + (i & 7) * RV_CELL + RV_CELL / 2 + 1, cy = RV_Y0 + (i >> 3) * RV_CELL + RV_CELL / 2 + 1;
    if (rvBd[i] == 3) {   // custom-start block
      canvas->fillRect(cx - 5, cy - 5, 11, 11, COL_WALL);
      canvas->drawRect(cx - 5, cy - 5, 11, 11, COL_ICE);
    } else if (rvBd[i] != 0) {
      bool flipping = ((rvFlipSet >> i) & 1ULL) && now - rvFlipT0 < RV_FLIP_MS;
      if (flipping) {
        float t = (float)(now - rvFlipT0) / (float)RV_FLIP_MS;
        if (t < 0.5f) rvDisc(cx, cy, 3 - rvFlipWho, 1.0f - 2.0f * t);
        else rvDisc(cx, cy, rvFlipWho, 2.0f * t - 1.0f);
      } else {
        rvDisc(cx, cy, rvBd[i], 1.0f);
      }
      if (i == rvLastMove) canvas->fillRect(cx - 6, cy - 6, 2, 2, COL_LASER);
    } else if (humanTurn && now >= rvBusyUntil && ((rvLegal >> i) & 1ULL)) {
      canvas->fillCircle(cx, cy, 1, COL_KEY);
    }
  }
  if (humanTurn) {
    int x = RV_X0 + (rvCur & 7) * RV_CELL, y = RV_Y0 + (rvCur >> 3) * RV_CELL;
    canvas->drawRect(x, y, RV_CELL + 1, RV_CELL + 1, COL_KEY);
    canvas->drawRect(x + 1, y + 1, RV_CELL - 1, RV_CELL - 1, COL_KEY);
  }
  // side panel
  canvas->setTextSize(1);
  ptc(COL_BLUE, 4, 3, "REVERSI");
  rvDisc(127, 22, 1, 1.0f);
  rvDisc(127, 40, 2, 1.0f);
  ptc(COL_TEXT, 136, 18, rvCount(rvBd, 1));
  pt(136, 36, rvCount(rvBd, 2));
  if (!rvEnding) {
    pt(122, 54, "TURN");
    ptc(COL_GOAL, 122, 64, rvName(rvTurn));
    rvDisc(150, 67, rvTurn, 1.0f);
    if (rvVsCpu && rvTurn == 2) {
      canvas->setTextColor(COL_TEXT);
      canvas->setCursor(122, 76);
      int dots = (int)((now / 300) % 3) + 1;
      for (int i = 0; i < dots; i++) canvas->print(".");
    }
  }
  if (now < rvMsgUntil) {
    ptc(COL_ORANGE, 122, 90, "PASS");
    pt(122, 100, rvMsgWho);
  }
  if (rvVsCpu) {
    static const char* const kTier4[4] = {"NORM", "EASY", "HARD", "XTRM"};
    ptc(COL_TEXT, 122, 118, kTier4[g_variant & 3]);
  }
}

