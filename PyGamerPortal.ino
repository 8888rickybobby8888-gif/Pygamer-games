// Draws game g's icon with its top-left at (x,y), each pixel scale x scale.
static void drawGameIcon(int x, int y, int g, int scale, uint16_t col) {
  const uint8_t* rows = cartIsId(g) ? s_carts[g - CART_BASE].icon : ((g >= 0 && g < NUM_GAMES) ? kGameIcons[g] : NULL);
  if (!rows) return;
  for (int r = 0; r < 8; r++) {
    uint8_t bits = rows[r];
    if (!bits) continue;
    for (int c = 0; c < 8; c++) {
      if (!(bits & (0x80 >> c))) continue;
      if (scale == 1) canvas->drawPixel(x + c, y + r, col);
      else canvas->fillRect(x + c * scale, y + r * scale, scale, scale, col);
    }
  }
}

