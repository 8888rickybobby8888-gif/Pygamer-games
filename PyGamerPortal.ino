// Portrait rotation direction: 0 = "A", 1 = "B" (the two mirrored rotations). Chosen by
// portDir() from the Settings row / accelerometer. Auto currently maps the device's
// right-edge-up pose to dir 1 (chosen empirically on the real device; the older
// "right edge up = A" assumption rendered the image flipped). The Settings
// "Portrait: Flip A/Flip B" override exists in case a unit disagrees.
static uint8_t s_autoDir = 0;
static uint8_t portDir();   // defined with the orientation code below

// Rotates the 128x160 portrait canvas into the 160x128 landscape buffer.
static void portraitRotate() {
  const uint16_t* src = s_portCanvas->getBuffer();
  uint16_t* dst = s_landCanvas->getBuffer();
  if (portDir() == 0) {
    // A: portrait (px,py) -> landscape (x = 159 - py, y = px)
    for (int py = 0; py < 160; py++) {
      const uint16_t* row = src + py * 128;
      uint16_t* d = dst + (159 - py);
      for (int px = 0; px < 128; px++) { *d = row[px]; d += 160; }
    }
  } else {
    // B: portrait (px,py) -> landscape (x = py, y = 127 - px)
    for (int py = 0; py < 160; py++) {
      const uint16_t* row = src + py * 128;
      uint16_t* d = dst + 127 * 160 + py;
      for (int px = 0; px < 128; px++) { *d = row[px]; d -= 160; }
    }
  }
}
// Pushes the finished frame to the display (rotating first when it is portrait).
static void presentFrame() {
  if (s_portCanvas && cvCur() == s_portCanvas) portraitRotate();
  arcada.blitFrameBuffer(0, 0, true, false);
}

// --- Orientation detection (LIS3DH) ------------------------------------------------
// Assumption: the sensor's +X axis points toward the landscape RIGHT edge of the
// screen and +Y toward the bottom (a one-time auto-check in the picker swaps X/Y if
// gravity clearly lies along the other axis while the screen is upright). With the
// right edge up, the sensor reads +X; Auto maps that to dir 1 and left-edge-up to dir 0
// (empirical, see above). The Settings row "Portrait: Auto/Flip A/Flip B" overrides it.
static bool s_orientPort = false;      // committed: device is held in portrait
static int8_t s_orientCand = -1;       // -1 ambiguous, 0 landscape, 1 portrait A, 2 portrait B
static unsigned long s_orientSampleMs = 0, s_orientSince = 0, s_autoFlipMs = 0, s_axisSince = 0;
static bool s_axisSwap = false, s_axisLearned = false, s_orientEverPort = false;
