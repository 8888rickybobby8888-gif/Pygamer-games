// --- Lunar Lander ------------------------------------------------------------
//
// Side view, 160x128. Gravity pulls the lander down; A / Up fires the main engine,
// Left / Right the side thrusters; all of them burn fuel. Touch down on the green pad
// slower than the safe speed and nearly level to score (base + fuel left + accuracy
// + level bonus) and start a harder level (rougher ground, narrower pad, more
// gravity); anything else is a crash. Score = total points. Tiers set gravity, fuel,
// pad width and the safe landing speed. Physics runs in fixed 16 ms steps.

#define LL_W 160
static uint8_t llTerr[LL_W];          // ground surface y per column
static float llX, llY, llVX, llVY, llFuel, llFuelMax, llGrav, llGravBase, llMaxVY;
static int llPadX, llPadW, llPadY, llPadBase, llLevel, llScore, llLastPts, llFlame;
static uint8_t llPhase;               // 0 flying, 1 landed banner, 2 crash animation
static bool llEmpty;
static unsigned long llPhaseT0, llAcc, llSfxAt, llWarnAt;

static void llStartLevel() {
  int lv = llLevel > 12 ? 12 : llLevel;
  int rough = 5 + lv * 2;
  int pts[LL_W / 8 + 2];
  pts[0] = 92 + mazeRngRange(20);
  for (int i = 1; i < LL_W / 8 + 2; i++) {
    int v = pts[i - 1] + mazeRngRange(2 * rough + 1) - rough;
    if (v < 66) v = 66 + mazeRngRange(4);
    if (v > 120) v = 120 - mazeRngRange(4);
    pts[i] = v;
  }
  for (int x = 0; x < LL_W; x++) llTerr[x] = (uint8_t)(pts[x / 8] + (pts[x / 8 + 1] - pts[x / 8]) * (x % 8) / 8);
  llPadW = llPadBase - 2 * (lv - 1);
  if (llPadW < 16) llPadW = 16;
  llPadX = 6 + mazeRngRange(LL_W - llPadW - 12);
  llPadY = llTerr[llPadX + llPadW / 2];
  for (int x = llPadX; x < llPadX + llPadW; x++) llTerr[x] = (uint8_t)llPadY;
  llGrav = llGravBase + 1.5f * (float)(lv - 1);
  if (llGrav > 40.0f) llGrav = 40.0f;   // thrust is a fixed 52 px/s^2: keep every level winnable
  llX = (llPadX + llPadW / 2 < 80) ? (float)(110 + mazeRngRange(40)) : (float)(10 + mazeRngRange(40));
  llY = 26.0f;
  llVX = (float)(mazeRngRange(21) - 10);
  llVY = 0.0f;
  llFuel = llFuelMax;
  llEmpty = false;
  llFlame = 0;
  llAcc = 0;
  llPhase = 0;
  s_lastFrameMs = 0;
}

// Level-creator terrain: 20 columns of 8 px. Tiles 0-8 = ground height (y = 118 - 6*h),
// tile 9 = the landing pad (one run of >= 3 columns, flat at the height of the column
// next to it). A custom level is a single landing: touching down ends the round.
static bool llCustom = false;
#define LL_PAD_TILE 9

static bool landPadRun(const LevelData *lvl, int *a, int *b) {   // [a,b) of the pad run; false if not exactly one run
  int runs = 0;
  *a = *b = 0;
  for (int c = 0; c < lvl->w; c++) {
    if (lvl->cells[0][c] != LL_PAD_TILE) continue;
    if (c == 0 || lvl->cells[0][c - 1] != LL_PAD_TILE) { runs++; *a = c; }
    *b = c + 1;
  }
  return runs == 1;
}

static bool landValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int a, b;
  if (lvlCountTile(lvl, LL_PAD_TILE) == 0) { snprintf(msg, msgLen, "Place a landing pad"); return false; }
  if (!landPadRun(lvl, &a, &b)) { snprintf(msg, msgLen, "Only one pad allowed"); return false; }
  if (b - a < 3) { snprintf(msg, msgLen, "Pad needs 3+ columns"); return false; }
  return true;
}

static void landLoadCustom(const LevelData *lvl) {
  int a, b;
  if (!landPadRun(lvl, &a, &b) || b - a < 3) return;
  int n = lvl->w < 20 ? lvl->w : 20;
  if (b > n) b = n;
  if (a >= b) return;
  int h[21];
  int padH = 3;
  if (a > 0) padH = lvl->cells[0][a - 1];
  else if (b < n) padH = lvl->cells[0][b];
  if (padH > 8) padH = 3;
  for (int i = 0; i < 20; i++) {
    int v = (i < n) ? lvl->cells[0][i] : 0;
    if (v > 8) v = padH;   // the pad tile (or junk) -> pad height
    h[i] = 118 - 6 * v;
  }
  h[20] = h[19];
  for (int i = a; i < b; i++) h[i] = 118 - 6 * padH;
  for (int x = 0; x < LL_W; x++) llTerr[x] = (uint8_t)(h[x / 8] + (h[x / 8 + 1] - h[x / 8]) * (x % 8) / 8);
  llPadX = a * 8;
  llPadW = (b - a) * 8;
  llPadY = 118 - 6 * padH;
  for (int x = llPadX; x < llPadX + llPadW; x++) llTerr[x] = (uint8_t)llPadY;
  llX = (llPadX + llPadW / 2 < 80) ? (float)(110 + mazeRngRange(40)) : (float)(10 + mazeRngRange(40));
  llGrav = llGravBase;
  llCustom = true;
}

static void enterLandTitle() {
  gameState = ST_LAND_TITLE;
  drawStdTitle("LUNAR LANDER", COL_ICE, "A/Up: thrust", "Left/Right: steer", "Land slow, on the pad", 36);
}

static void enterLandPlaying() {
  s_mazeRng = gameSeed();
  switch (g_variant & 3) {
    case 1: llGravBase = 26.0f; llFuelMax = 85.0f;  llPadBase = 34; llMaxVY = 20.0f; break;  // Speed
    case 2: llGravBase = 14.0f; llFuelMax = 140.0f; llPadBase = 46; llMaxVY = 30.0f; break;  // Chill
    case 3: llGravBase = 32.0f; llFuelMax = 70.0f;  llPadBase = 26; llMaxVY = 17.0f; break;  // Extreme
    default: llGravBase = 20.0f; llFuelMax = 100.0f; llPadBase = 40; llMaxVY = 24.0f; break;
  }
  llLevel = 1;
  llScore = 0;
  llLastPts = 0;
  llSfxAt = llWarnAt = 0;
  llStartLevel();
  llCustom = false;
  if (s_lvlActiveSlot[LVLGAME_LAND] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_LAND, s_lvlActiveSlot[LVLGAME_LAND], &lvl)) landLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_LAND] = -1;
  }
  gameState = ST_LAND_PLAYING;
}

static void drawLandScene() {
  canvas->fillScreen(COL_BG);
  for (int i = 0; i < 14; i++) canvas->drawPixel((i * 37 + 11) % 160, 22 + (i * 23) % 40, COL_WALL);
  uint16_t rock = arcada.display->color565(80, 70, 62);
  uint16_t rim = arcada.display->color565(150, 138, 118);
  for (int x = 0; x < LL_W; x++) {
    canvas->drawFastVLine(x, llTerr[x], 128 - llTerr[x], rock);
    canvas->drawPixel(x, llTerr[x], rim);
  }
  canvas->fillRect(llPadX, llPadY, llPadW, 3, COL_GOAL);
  canvas->fillRect(llPadX, llPadY - 5, 1, 5, COL_KEY);
  canvas->fillRect(llPadX + llPadW - 1, llPadY - 5, 1, 5, COL_KEY);
  int cx = (int)llX, cy = (int)llY;
  if (llPhase != 2) {
    if (llFlame & 1) {
      int fl = 5 + (int)((millis() / 40) % 3);
      canvas->fillTriangle(cx - 2, cy + 2, cx + 2, cy + 2, cx, cy + 2 + fl, COL_ORANGE);
    }
    if (llFlame & 2) canvas->fillRect(cx + 5, cy - 2, 4, 2, COL_ORANGE);   // pushing left
    if (llFlame & 4) canvas->fillRect(cx - 8, cy - 2, 4, 2, COL_ORANGE);   // pushing right
    canvas->fillRect(cx - 3, cy - 4, 7, 6, COL_TEXT);
    canvas->fillRect(cx - 1, cy - 3, 3, 2, COL_BLUE);
    canvas->drawLine(cx - 3, cy + 2, cx - 5, cy + 5, COL_TEXT);
    canvas->drawLine(cx + 3, cy + 2, cx + 5, cy + 5, COL_TEXT);
  } else {
    int r = (int)((millis() - llPhaseT0) / 45);
    if (r > 16) r = 16;
    canvas->fillCircle(cx, cy, r, COL_ORANGE);
    canvas->fillCircle(cx, cy, r / 2, COL_KEY);
    for (int i = 0; i < 8; i++) {
      int dx = (int)(cosf((float)i * 0.785f) * (float)(r + 3)), dy = (int)(sinf((float)i * 0.785f) * (float)(r + 3));
      canvas->drawPixel(cx + dx, cy + dy, COL_LASER);
    }
  }
  // HUD
  canvas->setTextSize(1);
  ptc(COL_TEXT, 2, 2, "FUEL");
  canvas->drawRect(28, 1, 42, 9, COL_TEXT);
  int fw = (int)(40.0f * llFuel / llFuelMax);
  canvas->fillRect(29, 2, fw, 7, llFuel < llFuelMax * 0.2f ? COL_LASER : COL_GOAL);
  pt(76, 2, "SC ");
  canvas->print(llScore);
  canvas->setCursor(2, 12);
  canvas->setTextColor(llVY <= llMaxVY ? COL_GOAL : COL_LASER);
  canvas->print("Vy ");
  canvas->print((int)llVY);
  canvas->setTextColor(fabsf(llVX) <= 16.0f ? COL_GOAL : COL_LASER);
  canvas->print(" Vx ");
  canvas->print((int)llVX);
  ptc(COL_TEXT, 112, 12, "Lv ");
  canvas->print(llLevel);
  if (llPhase == 1) {
    canvas->fillRect(28, 44, 104, 26, COL_BG);
    canvas->drawRect(28, 44, 104, 26, COL_GOAL);
    ptc(COL_GOAL, 52, 49, "LANDED!");
    char b[16];
    snprintf(b, sizeof(b), "+%d points", llLastPts);
    ptc(COL_TEXT, 80 - (int)strlen(b) * 3, 59, b);
  }
}

static void drawLandOverScreen() {
  char big[12], sub[28];
  snprintf(big, sizeof(big), "%d", llScore);
  snprintf(sub, sizeof(sub), "landings: %d", llLevel - 1);
  if (llCustom && llScore > 0) drawStdOver("TOUCHDOWN!", COL_GOAL, big, "custom level cleared", 36);
  else drawStdOver("CRASHED!", COL_LASER, big, sub, 36);
}

static bool llTouching() {
  int b = (int)llY + 5;
  for (int xx = (int)llX - 4; xx <= (int)llX + 4; xx++)
    if (xx >= 0 && xx < LL_W && llTerr[xx] <= b) return true;
  return false;
}

// One frame of Lunar Lander (called from loop() after the pause check).
static void landFrame(uint32_t buttons) {
  unsigned long now = millis();
  unsigned long dtMs = (s_lastFrameMs == 0) ? 16 : now - s_lastFrameMs;
  if (dtMs > 60) dtMs = 60;
  s_lastFrameMs = now;
  if (llPhase == 1) {
    if (now - llPhaseT0 >= 1700) {
      if (llCustom) {   // hand-made level: one landing ends the round
        s_lastNewBest = false;
        lvlRecordRun(LVLGAME_LAND, (long)llScore, true);
        lvlOnClear(LVLGAME_LAND);
        if (g_twoPlayerMode) {
          twoPHandleGameEnd(llScore);
        } else {
          gameState = ST_LAND_OVER;
          drawLandOverScreen();
        }
        return;
      }
      llLevel++;
      llStartLevel();
    }
  } else if (llPhase == 2) {
    if (now - llPhaseT0 >= 900) {
      if (!llCustom) recordResult(36, g_variant, (long)llScore, true);
      else { s_lastNewBest = false; lvlRecordRun(LVLGAME_LAND, (long)llScore, true); }
      if (g_twoPlayerMode) {
        twoPHandleGameEnd(llScore);
      } else {
        gameState = ST_LAND_OVER;
        drawLandOverScreen();
      }
      return;
    }
  } else {
    bool thr = (buttons & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_UP)) && llFuel > 0.0f;
    int side = ((buttons & ARCADA_BUTTONMASK_RIGHT) ? 1 : 0) - ((buttons & ARCADA_BUTTONMASK_LEFT) ? 1 : 0);
    if (llFuel <= 0.0f) { thr = false; side = 0; }
    llFlame = (thr ? 1 : 0) | (side > 0 ? 4 : 0) | (side < 0 ? 2 : 0);
    if (thr && now >= llSfxAt) { sfx(120, 40); llSfxAt = now + 70; }
    if (llFuel > 0.0f && llFuel < llFuelMax * 0.2f && now >= llWarnAt) { sfx(1100, 30); llWarnAt = now + 600; }
    llAcc += dtMs;
    for (int guard = 0; llAcc >= 16 && guard < 5 && llPhase == 0; guard++) {
      llAcc -= 16;
      const float dt = 0.016f;
      llVY += llGrav * dt;
      if (thr) { llVY -= 52.0f * dt; llFuel -= 14.0f * dt; }
      if (side) { llVX += (float)side * 28.0f * dt; llFuel -= 5.0f * dt; }
      if (llFuel < 0.0f) llFuel = 0.0f;
      llX += llVX * dt;
      llY += llVY * dt;
      if (llX < 5.0f) { llX = 5.0f; if (llVX < 0) llVX = 0; }
      if (llX > (float)(LL_W - 6)) { llX = (float)(LL_W - 6); if (llVX > 0) llVX = 0; }
      if (llY < 20.0f) { llY = 20.0f; if (llVY < 0) llVY = 0; }
      if (llTouching()) {
        bool onPad = (int)llX - 4 >= llPadX - 1 && (int)llX + 4 <= llPadX + llPadW;
        bool soft = llVY <= llMaxVY && fabsf(llVX) <= 16.0f;
        if (onPad && soft) {
          llY = (float)(llPadY - 5);
          int fuelPct = (int)(llFuel * 100.0f / llFuelMax);
          int acc = 30 - (int)(fabsf(llX - (float)(llPadX + llPadW / 2)) * 2.0f);
          if (acc < 0) acc = 0;
          llLastPts = 100 + fuelPct + acc + (llLevel - 1) * 25;
          llScore += llLastPts;
          llPhase = 1;
          llFlame = 0;
          drawLandScene();
          blitScreen();
          sfxWin();
          pixelsFlash(0, 255, 0, 60);
        } else {
          llPhase = 2;
          llFlame = 0;
          sfxDeath();
          pixelsFlash(255, 0, 0, 80);
        }
        llPhaseT0 = millis();
      }
    }
    if (llFuel <= 0.0f && !llEmpty && llPhase == 0) { llEmpty = true; sfx(160, 120); }
  }
  drawLandScene();
  blitScreen();
}

// --- Sky Hop -----------------------------------------------------------------
//
// Portrait (128x160) endless jumper. The hopper bounces by itself every time it lands
// on a platform; Left/Right steer (the screen edges wrap round). The camera follows
// the hopper up; fall off the bottom and it is over. Higher up, some platforms slide
// sideways, some crumble after one bounce, and yellow ones are springs. Score =
// height. Platform layout depends only on the round seed (both 2P players get the
// same tower). Tiers set platform width, gaps and when the nasty platforms start.

#define SK_N 9
#define SK_W 128
static float skPX[SK_N], skPY[SK_N];
static uint8_t skPT[SK_N];            // 0 normal, 1 sliding, 2 crumbling, 3 spring, 4 crumbled
static int8_t skPD[SK_N];             // slide direction
static float skX, skY, skVX, skVY, skHeight, skTopY, skGenH;
static int skPW, skGapBase, skScore, skMoveAt, skCrumbleAt, skMilestone;
static uint8_t skLastType;

static void skGen(int i) {
  int gmax = skGapBase + (int)(skGenH / 250.0f);
  if (gmax > skGapBase + 14) gmax = skGapBase + 14;
  int gap = 24 + mazeRngRange(gmax - 24 + 1);
  skGenH += (float)gap;
  skTopY -= (float)gap;
  skPY[i] = skTopY;
  skPX[i] = (float)mazeRngRange(SK_W - skPW + 1);
  int r = mazeRngRange(100);
  skPD[i] = mazeRngRange(2) ? 1 : -1;
  uint8_t t = 0;
  if (r < 20 && skGenH > (float)skCrumbleAt && skLastType == 0) t = 2;
  else if (r >= 20 && r < 45 && skGenH > (float)skMoveAt) t = 1;
  else if (r >= 94) t = 3;
  skPT[i] = t;
  skLastType = t;
}

static void enterSkyTitle() {
  gameState = ST_SKY_TITLE;
  drawStdTitle("SKY HOP", COL_GOAL, "Left/Right: steer", "Hop up, never stop", "Turn device to play", 37);
}

static void enterSkyPlaying() {
  if (portraitGate(enterSkyPlaying, enterSkyTitle)) return;
  s_mazeRng = gameSeed();
  switch (g_variant & 3) {
    case 1: skPW = 24; skGapBase = 52; skMoveAt = 300; skCrumbleAt = 700; break;    // Speed
    case 2: skPW = 34; skGapBase = 40; skMoveAt = 650; skCrumbleAt = 1400; break;   // Chill
    case 3: skPW = 20; skGapBase = 56; skMoveAt = 150; skCrumbleAt = 400; break;    // Extreme
    default: skPW = 28; skGapBase = 46; skMoveAt = 450; skCrumbleAt = 1000; break;
  }
  skTopY = 140.0f;
  skGenH = 0.0f;
  skLastType = 0;
  skPX[0] = (float)(SK_W / 2 - skPW / 2);
  skPY[0] = 140.0f;
  skPT[0] = 0;
  skPD[0] = 1;
  for (int i = 1; i < SK_N; i++) skGen(i);
  skX = (float)(SK_W / 2 - 5);
  skY = 128.0f;
  skVX = 0.0f;
  skVY = -320.0f;
  skHeight = 0.0f;
  skScore = 0;
  skMilestone = 50;
  s_lastFrameMs = 0;
  gameState = ST_SKY_PLAYING;
}

static void drawSkyScene() {
  uint16_t sky = arcada.display->color565(8, 14, 44);
  canvas->fillScreen(sky);
  for (int i = 0; i < 12; i++) {
    int sy = (i * 29 + (int)(skHeight * 0.3f)) % 160;
    canvas->drawPixel((i * 53 + 7) % SK_W, sy, COL_WALL);
  }
  uint16_t grass = arcada.display->color565(40, 170, 70);
  uint16_t crumb = arcada.display->color565(150, 100, 50);
  for (int i = 0; i < SK_N; i++) {
    if (skPT[i] == 4) continue;
    int px = (int)skPX[i], py = (int)skPY[i];
    if (py < -8 || py > 164) continue;
    uint16_t c = skPT[i] == 1 ? COL_BLUE : skPT[i] == 2 ? crumb : grass;
    canvas->fillRect(px, py, skPW, 5, c);
    canvas->drawFastHLine(px, py, skPW, COL_TEXT);
    if (skPT[i] == 2) {
      canvas->drawFastVLine(px + skPW / 3, py, 5, sky);
      canvas->drawFastVLine(px + (2 * skPW) / 3, py + 1, 4, sky);
    }
    if (skPT[i] == 3) canvas->fillRect(px + skPW / 2 - 3, py - 4, 6, 4, COL_KEY);
  }
  int hx = (int)skX, hy = (int)skY;
  int stretch = skVY < -120.0f ? 2 : 0;
  canvas->fillRect(hx, hy, 10, 10 + stretch, COL_PLAYER);
  int ex = skVX < -5.0f ? 0 : (skVX > 5.0f ? 4 : 2);
  canvas->fillRect(hx + ex, hy + 2, 2, 3, COL_BG);
  canvas->fillRect(hx + ex + 4, hy + 2, 2, 3, COL_BG);
  // HUD
  canvas->setTextSize(1);
  ptc(COL_TEXT, 2, 2, "HT ");
  canvas->print(skScore);
  int32_t bs = saveBest(37, saveTierOf(g_variant));
  canvas->setCursor(66, 2);
  canvas->setTextColor(COL_KEY);
  canvas->print("BEST ");
  canvas->print(bs == SAVE_NO_SCORE ? 0 : (int)bs);
}

static void drawSkyOverScreen() {
  char big[12];
  snprintf(big, sizeof(big), "%d", skScore);
  drawStdOver("YOU FELL!", COL_LASER, big, "height reached", 37);
}

// One frame of Sky Hop (called from loop() after the pause check; buttons are already
// in the portrait screen frame).
static void skyFrame(uint32_t buttons) {
  unsigned long now = millis();
  float dt = (s_lastFrameMs == 0) ? 0.016f : (float)(now - s_lastFrameMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  s_lastFrameMs = now;

  // steering
  float target = 0.0f;
  if (buttons & ARCADA_BUTTONMASK_LEFT) target -= 105.0f;
  if (buttons & ARCADA_BUTTONMASK_RIGHT) target += 105.0f;
  float acc = (target == 0.0f ? 500.0f : 800.0f) * dt;
  if (skVX < target) { skVX += acc; if (skVX > target) skVX = target; }
  else if (skVX > target) { skVX -= acc; if (skVX < target) skVX = target; }

  float prevFeet = skY + 10.0f;
  skVY += 560.0f * dt;
  skY += skVY * dt;
  skX += skVX * dt;
  if (skX < -10.0f) skX = (float)SK_W;
  if (skX > (float)SK_W) skX = -10.0f;

  // sliding platforms
  for (int i = 0; i < SK_N; i++) {
    if (skPT[i] != 1) continue;
    skPX[i] += (float)skPD[i] * 30.0f * dt;
    if (skPX[i] < 0.0f) { skPX[i] = 0.0f; skPD[i] = 1; }
    if (skPX[i] > (float)(SK_W - skPW)) { skPX[i] = (float)(SK_W - skPW); skPD[i] = -1; }
  }

  // landing
  if (skVY > 0.0f) {
    float feet = skY + 10.0f;
    for (int i = 0; i < SK_N; i++) {
      if (skPT[i] == 4) continue;
      float py = skPY[i];
      if (prevFeet <= py + 2.0f && feet >= py && skX + 8.0f > skPX[i] && skX + 2.0f < skPX[i] + (float)skPW) {
        skY = py - 10.0f;
        if (skPT[i] == 3) { skVY = -480.0f; sfx(900, 90); }
        else {
          skVY = -320.0f;
          if (skPT[i] == 2) { skPT[i] = 4; sfx(220, 60); }
          else sfx(skPT[i] == 1 ? 620 : 520, 18);
        }
        break;
      }
    }
  }

  // camera follows the hopper upward
  if (skY < 64.0f) {
    float d = 64.0f - skY;
    skY = 64.0f;
    skHeight += d;
    skTopY += d;
    for (int i = 0; i < SK_N; i++) skPY[i] += d;
    skScore = (int)(skHeight / 8.0f);
    if (skScore >= skMilestone) { skMilestone += 50; sfx(1000, 50); }
  }
  // recycle platforms that scrolled off the bottom
  for (int i = 0; i < SK_N; i++) if (skPY[i] > 168.0f) skGen(i);

  if (skY > 162.0f) {   // fell off the bottom
    drawSkyScene();
    blitScreen();
    sfxDeath();
    pixelsFlash(255, 0, 0, 60);
    recordResult(37, g_variant, (long)skScore, true);
    if (g_twoPlayerMode) {
      twoPHandleGameEnd(skScore);
    } else {
      gameState = ST_SKY_OVER;
      drawSkyOverScreen();
    }
    return;
  }
  drawSkyScene();
  blitScreen();
}

// --- Beat Tapper -------------------------------------------------------------
//
// Four lanes (Left, Up, Down/A, Right/B) scroll notes down to a hit line. Press the
// lane as a note crosses the line: PERFECT (100) or GOOD (50), times a combo
// multiplier (x1..x4). Every hit plays the next note of the song's melody through
// sfx(); a miss breaks the combo and costs health. Three songs (picked by the round
// seed, so a 2P opponent gets the same song and pattern); the lane pattern follows
// the melody's pitch with seeded wobble. Ends when the 64-note song is done (clear
// bonus) or when health runs out. Timing uses a song clock advanced by frame time, so
// pausing never causes misses.

#define BT_STEPS 64
#define BT_TUNE 32
#define BT_LW 28
#define BT_X0 24
#define BT_TOPY 14
#define BT_HITY 104
static const uint16_t kBtTunes[3][BT_TUNE] = {
  {262, 262, 392, 392, 440, 440, 392, 392, 349, 349, 330, 330, 294, 294, 262, 262,
   392, 392, 349, 349, 330, 330, 294, 294, 392, 392, 349, 349, 330, 330, 294, 294},
  {330, 330, 349, 392, 392, 349, 330, 294, 262, 262, 294, 330, 330, 294, 294, 294,
   330, 330, 349, 392, 392, 349, 330, 294, 262, 262, 294, 330, 294, 262, 262, 262},
  {262, 330, 392, 523, 392, 330, 262, 330, 294, 349, 440, 587, 440, 349, 294, 349,
   330, 392, 494, 659, 494, 392, 330, 392, 262, 330, 392, 523, 659, 523, 392, 262},
};
static uint8_t btLane[BT_STEPS];      // lane 0..3, 255 = rest
static uint8_t btState[BT_STEPS];     // 0 pending, 1 hit, 2 missed
static unsigned long btClk, btStepMs, btFall, btLead, btFbUntil, btFlash[4], btEndAt;
static int btPerfW, btGoodW, btMissMax, btMisses, btNext, btCombo, btMaxCombo, btSong, btFbKind, btFbLane;
static long btScore;
static bool btCleared, btEnding;

static unsigned long btHitTime(int k) { return btLead + (unsigned long)k * btStepMs; }

// Level-creator chart: 16 columns (time) x 4 lanes; tile 1 = note. Each column plays its
// notes lane by lane (a chord becomes a quick run), an empty column is one rest step.
static int btSteps = BT_STEPS;
static bool btCustom = false;
static const uint16_t kBtLaneTone[4] = {262, 330, 392, 523};

static void beatLoadCustom(const LevelData *lvl) {
  int k = 0;
  for (int c = 0; c < lvl->w && c < 16; c++) {
    int notes = 0;
    for (int r = 0; r < lvl->h && r < 4; r++) {
      if (lvl->cells[r][c] == 1 && k < BT_STEPS) { btLane[k] = (uint8_t)r; btState[k] = 0; k++; notes++; }
    }
    if (!notes && k < BT_STEPS) { btLane[k] = 255; btState[k] = 0; k++; }
  }
  btSteps = k > 0 ? k : 1;
  btCustom = true;
}

static bool beatValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  if (lvlCountTile(lvl, 1) < 8) { snprintf(msg, msgLen, "Need at least 8 notes"); return false; }
  return true;
}

static void enterBeatTitle() {
  gameState = ST_BEAT_TITLE;
  drawStdTitle("BEAT TAPPER", COL_TELE_A, "Left Up Down Right", "Hit notes on the line", "A=Down  B=Right too", 38);
}

static void enterBeatPlaying() {
  s_mazeRng = gameSeed();
  switch (g_variant & 3) {
    case 1: btStepMs = 270; btFall = 1000; btPerfW = 48; btGoodW = 100; btMissMax = 8; break;   // Speed
    case 2: btStepMs = 420; btFall = 1300; btPerfW = 70; btGoodW = 140; btMissMax = 14; break;  // Chill
    case 3: btStepMs = 220; btFall = 850;  btPerfW = 38; btGoodW = 85;  btMissMax = 7; break;   // Extreme
    default: btStepMs = 330; btFall = 1100; btPerfW = 55; btGoodW = 115; btMissMax = 10; break;
  }
  btSong = (int)(mazeRngNext() % 3u);
  for (int k = 0; k < BT_STEPS; k++) {
    int f = kBtTunes[btSong][k % BT_TUNE];
    int lane = f < 300 ? 0 : f < 400 ? 1 : f < 500 ? 2 : 3;
    int w = mazeRngRange(100);
    if (w < 18 && lane > 0) lane--;
    else if (w >= 82 && lane < 3) lane++;
    bool rest = (btSong == 1 && (k % 8) == 7) || (btSong == 2 && mazeRngRange(100) < 18);
    btLane[k] = rest ? 255 : (uint8_t)lane;
    btState[k] = 0;
  }
  btSteps = BT_STEPS;
  btCustom = false;
  if (s_lvlActiveSlot[LVLGAME_BEAT] >= 0) {
    LevelData lvl;
    if (lvlLoadSlot(LVLGAME_BEAT, s_lvlActiveSlot[LVLGAME_BEAT], &lvl)) beatLoadCustom(&lvl);
    else s_lvlActiveSlot[LVLGAME_BEAT] = -1;
  }
  btLead = btFall + 600;
  btClk = 0;
  btNext = 0;
  btMisses = 0;
  btCombo = btMaxCombo = 0;
  btScore = 0;
  btFbUntil = 0;
  btFbKind = 0;
  btFbLane = 0;
  btCleared = false;
  btEnding = false;
  for (int i = 0; i < 4; i++) btFlash[i] = 0;
  s_lastFrameMs = 0;
  gameState = ST_BEAT_PLAYING;
}

static uint16_t btLaneColor(int l) {
  switch (l) {
    case 0: return COL_LASER;
    case 1: return COL_KEY;
    case 2: return COL_BOOST;
    default: return COL_BLUE;
  }
}

static void drawBeatScene() {
  canvas->fillScreen(COL_BG);
  uint16_t d1 = arcada.display->color565(16, 16, 30), d2 = arcada.display->color565(26, 26, 44);
  for (int l = 0; l < 4; l++) {
    int x = BT_X0 + l * BT_LW;
    canvas->fillRect(x, BT_TOPY - 2, BT_LW, 128 - BT_TOPY + 2, (l & 1) ? d2 : d1);
    canvas->drawFastVLine(x, BT_TOPY - 2, 128 - BT_TOPY + 2, COL_WALL);
  }
  canvas->drawFastVLine(BT_X0 + 4 * BT_LW, BT_TOPY - 2, 128 - BT_TOPY + 2, COL_WALL);
  canvas->fillRect(BT_X0, BT_HITY, 4 * BT_LW, 2, COL_TEXT);
  const char* kKeys = "<^v>";
  for (int l = 0; l < 4; l++) {
    int x = BT_X0 + l * BT_LW;
    bool fl = btClk < btFlash[l];
    canvas->drawRect(x + 3, BT_HITY - 5, BT_LW - 6, 12, btLaneColor(l));
    if (fl) canvas->fillRect(x + 4, BT_HITY - 4, BT_LW - 8, 10, btLaneColor(l));
    canvas->setTextSize(1);
    ptc(COL_TEXT, x + BT_LW / 2 - 3, 116, kKeys[l]);
  }
  // falling notes
  float pxPerMs = (float)(BT_HITY - BT_TOPY) / (float)btFall;
  for (int k = btNext; k < btSteps && k < btNext + 16; k++) {
    if (btLane[k] == 255 || btState[k] != 0) continue;
    float y = (float)BT_HITY - ((float)btHitTime(k) - (float)btClk) * pxPerMs;
    if (y < (float)(BT_TOPY - 2)) break;
    if (y > 126.0f) continue;
    int x = BT_X0 + btLane[k] * BT_LW;
    canvas->fillRect(x + 4, (int)y - 3, BT_LW - 8, 7, btLaneColor(btLane[k]));
    canvas->drawFastHLine(x + 4, (int)y - 3, BT_LW - 8, COL_TEXT);
  }
  // HUD
  canvas->setTextSize(1);
  ptc(COL_TEXT, 2, 2, "SC ");
  canvas->print(btScore);
  canvas->drawRect(88, 2, 68, 7, COL_WALL);
  canvas->fillRect(89, 3, (66 * btNext) / btSteps, 5, COL_TELE_A);
  int mult = 1 + (btCombo >= 30 ? 3 : btCombo >= 20 ? 2 : btCombo >= 10 ? 1 : 0);
  ptc(COL_KEY, 2, 22, "CMB");
  pt(2, 32, btCombo);
  ptc(COL_GOAL, 2, 46, "x");
  canvas->print(mult);
  // health bar (right)
  int hp = btMissMax - btMisses;
  if (hp < 0) hp = 0;
  ptc(COL_TEXT, 140, 14, "HP");
  canvas->drawRect(144, 24, 10, 74, COL_TEXT);
  int hh = (72 * hp) / btMissMax;
  canvas->fillRect(145, 25 + (72 - hh), 8, hh, hp * 3 <= btMissMax ? COL_LASER : COL_GOAL);
  // judgement text
  if (btClk < btFbUntil) {
    const char* t = btFbKind == 2 ? "PERFECT!" : btFbKind == 1 ? "GOOD" : "MISS";
    uint16_t c = btFbKind == 2 ? COL_KEY : btFbKind == 1 ? COL_GOAL : COL_LASER;
    ptc(c, 80 - (int)strlen(t) * 3, 62, t);
  }
}

static void drawBeatOverScreen() {
  char big[14], sub[28];
  snprintf(big, sizeof(big), "%ld", btScore);
  snprintf(sub, sizeof(sub), "best combo: %d", btMaxCombo);
  if (btCleared) drawStdOver("SONG CLEAR!", COL_GOAL, big, sub, 38);
  else drawStdOver("OFF BEAT!", COL_LASER, big, sub, 38);
}

static void btFinish() {
  if (!btCustom) recordResult(38, g_variant, btScore, true);   // hand-made charts don't set records
  else {
    s_lastNewBest = false;
    lvlRecordRun(LVLGAME_BEAT, btScore, true);
    if (btCleared) lvlOnClear(LVLGAME_BEAT);
  }
  if (g_twoPlayerMode) {
    twoPHandleGameEnd(btScore);
  } else {
    gameState = ST_BEAT_OVER;
    drawBeatOverScreen();
  }
}

// One frame of Beat Tapper (called from loop() after the pause check).
static void beatFrame(uint32_t pressed) {
  unsigned long now = millis();
  unsigned long dtMs = (s_lastFrameMs == 0) ? 16 : now - s_lastFrameMs;
  if (dtMs > 60) dtMs = 60;
  s_lastFrameMs = now;
  if (btEnding) {
    if (btClk >= btEndAt) { btFinish(); return; }
    btClk += dtMs;
    drawBeatScene();
    blitScreen();
    return;
  }
  btClk += dtMs;

  // --- input: one attempt per lane press
  uint32_t laneBits[4] = {ARCADA_BUTTONMASK_LEFT, ARCADA_BUTTONMASK_UP,
                          ARCADA_BUTTONMASK_DOWN | ARCADA_BUTTONMASK_A,
                          ARCADA_BUTTONMASK_RIGHT | ARCADA_BUTTONMASK_B};
  for (int l = 0; l < 4; l++) {
    if (!(pressed & laneBits[l])) continue;
    btFlash[l] = btClk + 90;
    int best = -1;
    long bestD = 100000;
    for (int k = btNext; k < btSteps && k < btNext + 8; k++) {
      if (btLane[k] != l || btState[k] != 0) continue;
      long d = (long)btClk - (long)btHitTime(k);
      if (d < 0) d = -d;
      if (d <= btGoodW && d < bestD) { best = k; bestD = d; }
    }
    if (best >= 0) {
      bool perfect = bestD <= btPerfW;
      int mult = 1 + (btCombo >= 30 ? 3 : btCombo >= 20 ? 2 : btCombo >= 10 ? 1 : 0);
      btScore += (long)(perfect ? 100 : 50) * mult;
      btCombo++;
      if (btCombo > btMaxCombo) btMaxCombo = btCombo;
      btState[best] = 1;
      btFbKind = perfect ? 2 : 1;
      btFbLane = l;
      btFbUntil = btClk + 350;
      sfx(btCustom ? kBtLaneTone[btLane[best] & 3] : kBtTunes[btSong][best % BT_TUNE], 100);
    }
  }

  // --- notes that slid past the hit window are misses
  while (btNext < btSteps) {
    if (btLane[btNext] == 255 || btState[btNext] != 0) { btNext++; continue; }
    if (btClk <= btHitTime(btNext) + (unsigned long)btGoodW) break;
    btState[btNext] = 2;
    btNext++;
    btMisses++;
    btCombo = 0;
    btFbKind = 0;
    btFbUntil = btClk + 350;
    sfx(110, 70);
    if (btMisses >= btMissMax) {
      sfxDeath();
      pixelsFlash(255, 0, 0, 60);
      btCleared = false;
      btEnding = true;
      btEndAt = btClk + 500;
      break;
    }
  }
  if (!btEnding && btNext >= btSteps && btClk > btHitTime(btSteps - 1) + (unsigned long)btGoodW + 400) {
    int left = btMissMax - btMisses;
    btScore += 20L * left + (btMisses == 0 ? 300 : 0);
    btCleared = true;
    btEnding = true;
    btEndAt = btClk + 100;
    sfxWin();
    pixelsWinCelebration();
    s_lastFrameMs = 0;
  }
  drawBeatScene();
  blitScreen();
}

// --- Reversi (Othello) -------------------------------------------------------
//
// 8x8. P1 = black (the human vs the CPU), P2 / CPU = white. D-pad moves the cursor,
// A / Start places a disc on a dotted legal square and flips every bracketed line.
// A player with no legal move passes; the game ends when neither can move. Two modes
// like Tic-Tac-Toe: vs CPU (4 strengths, g_variant 0..3 = NORMAL / EASY / HARD /
// EXTREME) or 2 PLAYERS hot-seat (the opener alternates). CPU tiers: EASY = greedy by
// flips with 40% random moves, NORMAL = greedy by flips + corner bonus, HARD = 2-ply
// search on a positional weight table, EXTREME = 4-ply alpha-beta (the root move plus
// depth 3 below it; weights + mobility + late disc count) capped at ~3000 nodes / 280 ms.
// If the cap fires before the first root move completes, the CPU falls back to the
// best weight-table square. vs-CPU score = disc margin.

#define RV_CELL 14
#define RV_X0 4
#define RV_Y0 14
static int8_t rvBd[64];                 // 0 empty, 1 = P1 (black), 2 = P2 / CPU (white)
static int rvCur, rvTurn, rvLastMove;
static bool rvVsCpu = true;             // mode: true = vs CPU, false = 2 PLAYERS
static int rvSb[2][3];                  // scoreboard [0 = vs CPU, 1 = 2P][P1/You, P2/CPU, draws]
static int8_t rvFirst = 1;              // 2P: who opens the next game
static int8_t rvWinner;                 // 1 / 2 / 3 = draw
static uint64_t rvLegal, rvFlipSet;
static int8_t rvFlipWho;
static unsigned long rvFlipT0, rvBusyUntil, rvCpuAt, rvMsgUntil, rvEndAt;
static bool rvEnding, rvUseMob, rvAbort;
static char rvMsgWho[6];
static uint32_t rvNodes;
static unsigned long rvDeadline;
#define RV_FLIP_MS 340

static const int8_t kRvDx[8] = {-1, 0, 1, -1, 1, -1, 0, 1};
static const int8_t kRvDy[8] = {-1, -1, -1, 0, 0, 1, 1, 1};
static const int8_t kRvW[64] = {
  100, -20, 10,  5,  5, 10, -20, 100,
  -20, -50, -2, -2, -2, -2, -50, -20,
   10,  -2, -1, -1, -1, -1,  -2,  10,
    5,  -2, -1, -1, -1, -1,  -2,   5,
    5,  -2, -1, -1, -1, -1,  -2,   5,
   10,  -2, -1, -1, -1, -1,  -2,  10,
  -20, -50, -2, -2, -2, -2, -50, -20,
  100, -20, 10,  5,  5, 10, -20, 100};

// Flips a move would make for player p at idx (0 if occupied / not legal).
static int rvCountFlips(const int8_t* bd, int idx, int p) {
  if (bd[idx] != 0) return 0;
  int x0 = idx & 7, y0 = idx >> 3, tot = 0, q = 3 - p;
  for (int d = 0; d < 8; d++) {
    int x = x0 + kRvDx[d], y = y0 + kRvDy[d], n = 0;
    while (x >= 0 && x < 8 && y >= 0 && y < 8 && bd[y * 8 + x] == q) { x += kRvDx[d]; y += kRvDy[d]; n++; }
    if (n > 0 && x >= 0 && x < 8 && y >= 0 && y < 8 && bd[y * 8 + x] == p) tot += n;
  }
  return tot;
}

// Places p's disc at idx and flips; *set (optional) collects the flipped squares.
static int rvApply(int8_t* bd, int idx, int p, uint64_t* set) {
  int x0 = idx & 7, y0 = idx >> 3, tot = 0, q = 3 - p;
  for (int d = 0; d < 8; d++) {
    int x = x0 + kRvDx[d], y = y0 + kRvDy[d], n = 0;
    while (x >= 0 && x < 8 && y >= 0 && y < 8 && bd[y * 8 + x] == q) { x += kRvDx[d]; y += kRvDy[d]; n++; }
    if (n > 0 && x >= 0 && x < 8 && y >= 0 && y < 8 && bd[y * 8 + x] == p) {
      int fx = x0 + kRvDx[d], fy = y0 + kRvDy[d];
      for (int i = 0; i < n; i++) {
        bd[fy * 8 + fx] = (int8_t)p;
        if (set) *set |= (1ULL << (fy * 8 + fx));
        fx += kRvDx[d];
        fy += kRvDy[d];
      }
      tot += n;
    }
  }
  bd[idx] = (int8_t)p;
  return tot;
}

static uint64_t rvLegalMask(const int8_t* bd, int p) {
  uint64_t m = 0;
  for (int i = 0; i < 64; i++) if (bd[i] == 0 && rvCountFlips(bd, i, p) > 0) m |= (1ULL << i);
  return m;
}

static int rvCount(const int8_t* bd, int p) {
  int c = 0;
  for (int i = 0; i < 64; i++) if (bd[i] == p) c++;
  return c;
}

static int rvEval(const int8_t* bd, int p) {
  int q = 3 - p, s = 0, cp = 0, cq = 0;
  for (int i = 0; i < 64; i++) {
    if (bd[i] == p) { s += kRvW[i]; cp++; }
    else if (bd[i] == q) { s -= kRvW[i]; cq++; }
  }
  if (rvUseMob) {
    s += 4 * (__builtin_popcountll(rvLegalMask(bd, p)) - __builtin_popcountll(rvLegalMask(bd, q)));
    if (cp + cq >= 52) s += 8 * (cp - cq);   // endgame: discs matter
  }
  return s;
}

// Negamax with alpha-beta from the point of view of p (to move). depth = plies left.
static int rvNegamax(const int8_t* bd, int p, int depth, int alpha, int beta) {
  rvNodes++;
  if (rvNodes > 3000 || ((rvNodes & 31) == 0 && millis() > rvDeadline)) rvAbort = true;
  if (rvAbort) return rvEval(bd, p);
  uint64_t mv = rvLegalMask(bd, p);
  if (mv == 0) {
    if (rvLegalMask(bd, 3 - p) == 0) return (rvCount(bd, p) - rvCount(bd, 3 - p)) * 1000;
    if (depth <= 0) return rvEval(bd, p);
    return -rvNegamax(bd, 3 - p, depth - 1, -beta, -alpha);
  }
  if (depth <= 0) return rvEval(bd, p);
  int best = -1000000;
  for (int i = 0; i < 64; i++) {
    if (!((mv >> i) & 1ULL)) continue;
    int8_t nb[64];
    memcpy(nb, bd, 64);
    rvApply(nb, i, p, NULL);
    int v = -rvNegamax(nb, 3 - p, depth - 1, -beta, -alpha);
    if (v > best) best = v;
    if (best > alpha) alpha = best;
    if (alpha >= beta) break;
  }
  return best;
}

static bool rvIsCorner(int i) { return i == 0 || i == 7 || i == 56 || i == 63; }

// Level-creator start position. Tiles: 0 empty, 1 black (P1), 2 white (P2 / CPU), 3 block (3 in
// rvBd: never empty, never an opponent disc, so no move can fill it and no line flips through it).
static bool rvCustom = false;

static bool revValidateLevel(const LevelData *lvl, char *msg, size_t msgLen) {
  int8_t bd[64];
  int nb = 0, nw = 0;
  for (int i = 0; i < 64; i++) {
    uint8_t t = ((i >> 3) < lvl->h && (i & 7) < lvl->w) ? lvl->cells[i >> 3][i & 7] : 0;
    bd[i] = (int8_t)(t > 3 ? 0 : t);
    if (t == 1) nb++;
    else if (t == 2) nw++;
  }
  if (nb < 2) { snprintf(msg, msgLen, "Need 2+ black discs"); return false; }
  if (nw < 2) { snprintf(msg, msgLen, "Need 2+ white discs"); return false; }
  if (rvLegalMask(bd, 1) == 0) { snprintf(msg, msgLen, "Black has no opening move"); return false; }
  return true;
}

static void revLoadCustom(const LevelData *lvl) {
  int nb = 0, nw = 0;
  for (int i = 0; i < 64; i++) {
    uint8_t t = ((i >> 3) < lvl->h && (i & 7) < lvl->w) ? lvl->cells[i >> 3][i & 7] : 0;
    if (t > 3) t = 0;
    rvBd[i] = (int8_t)t;
    if (t == 1) nb++;
    else if (t == 2) nw++;
  }
  if (nb == 0 || nw == 0) {   // damaged level: fall back to the classic opening
    for (int i = 0; i < 64; i++) rvBd[i] = 0;
    rvBd[27] = 2; rvBd[36] = 2; rvBd[28] = 1; rvBd[35] = 1;
    return;
  }
  rvCustom = true;
}

// The CPU (always player 2) chooses its move.
static int rvCpuPick() {
  uint64_t mv = rvLegalMask(rvBd, 2);
  int moves[64], n = 0;
  for (int i = 0; i < 64; i++) if ((mv >> i) & 1ULL) moves[n++] = i;
  if (n == 0) return -1;
  int tier = g_variant & 3;   // 0 NORMAL, 1 EASY, 2 HARD, 3 EXTREME
  if (tier == 1 && mazeRngRange(100) < 40) return moves[mazeRngRange(n)];
  int cand[64], nc = 0;
  if (tier <= 1) {
    int bestS = -1000;
    for (int j = 0; j < n; j++) {
      int sc = rvCountFlips(rvBd, moves[j], 2);
      if (tier == 0 && rvIsCorner(moves[j])) sc += 25;
      if (sc > bestS) { bestS = sc; nc = 0; }
      if (sc == bestS) cand[nc++] = moves[j];
    }
    return cand[mazeRngRange(nc)];
  }
  rvUseMob = (tier == 3);
  int depth = (tier == 3) ? 3 : 1;
  rvNodes = 0;
  rvAbort = false;
  rvDeadline = millis() + 280;
  int best = -1000000;
  int off = mazeRngRange(n);
  for (int j = 0; j < n; j++) {
    int m = moves[(j + off) % n];
    int8_t nb[64];
    memcpy(nb, rvBd, 64);
    rvApply(nb, m, 2, NULL);
    int v = (tier == 3) ? -rvNegamax(nb, 1, depth, -100000, -(best - 1))
                        : -rvNegamax(nb, 1, depth, -100000, 100000);
    if (rvAbort) {                  // out of budget: this move's value is unreliable
      if (nc == 0) {                // nothing completed yet: greedy on the weight table
        int bw = -1000;
        for (int q = 0; q < n; q++) {
          int w = kRvW[moves[q]];
          if (w > bw) { bw = w; nc = 0; }
          if (w == bw) cand[nc++] = moves[q];
        }
      }
      break;
    }
    if (v > best) { best = v; nc = 0; }
    if (v == best) cand[nc++] = m;
  }
  rvUseMob = false;
  return cand[mazeRngRange(nc)];
}

