    unsigned long colorNow = millis();
    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    bool timedOut = colorNow >= colorRushRoundEndMs;
    bool answered = (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN)) != 0;
    if (answered || timedOut) {
      bool saidMatch = (pressed & ARCADA_BUTTONMASK_UP) != 0;
      bool correct = !timedOut && (saidMatch == colorRushMatch);
      if (correct) {
        colorRushScore += 10;
        sfx(700, 30);
        if (colorRushRoundMs > 900) colorRushRoundMs -= 60;
        colorRushNewRound();
      } else {
        colorRushLives--;
        sfx(150, 80);
        pixelsFlash(255, 0, 0, 60);
        if (colorRushLives <= 0) {
          if (colorRushScore > colorRushBestScore) colorRushBestScore = colorRushScore;
          recordResult(16, g_variant, (long)(colorRushScore), true);
          if (twoPOrMix()) {
            twoPHandleGameEnd(colorRushScore);
          } else {
            gameState = ST_COLOR_OVER;
            drawColorOverScreen();
          }
          return;
        }
        colorRushNewRound();
      }
    }

    drawColorScene();
    drawColorHud();
    blitScreen();
    return;
  }

  // --- Math Blitz ---
  if (gameState == ST_MATH_TITLE) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      if (g_twoPlayerMode) {
        g_twoPPlayerNum = 1;
        g_twoPScoreP1 = 0;
        g_twoPScoreP2 = 0;
        g_twoPHigherIsBetter = true;
        strncpy(g_twoPScoreLabel, "SCORE", sizeof(g_twoPScoreLabel) - 1);
        g_twoPScoreLabel[sizeof(g_twoPScoreLabel) - 1] = 0;
        g_twoPSeed = micros() ^ 0xBEEFu;
        g_twoPEnterFn = enterMathPlaying;
        s_mazeRng = g_twoPSeed;
        gameState = ST_TWOP_INTRO;
        drawTwoPIntroScreen();
      } else {
        enterMathPlaying();
      }
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    } else if (pressed & ARCADA_BUTTONMASK_LEFT) {
      g_variant = (g_variant + 4) % 5;
      enterMathTitle();
    } else if (pressed & ARCADA_BUTTONMASK_RIGHT) {
      g_variant = (g_variant + 1) % 5;
      enterMathTitle();
    }
    return;
  }
  if (gameState == ST_MATH_OVER) {
    if (pressed & (ARCADA_BUTTONMASK_A | ARCADA_BUTTONMASK_START)) {
      enterMathPlaying();
    } else if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
    }
    return;
  }
  if (gameState == ST_MATH_PLAYING) {
    if (checkPauseMenu(buttons, enterMathPlaying)) return;
    unsigned long mathNow = millis();
    if (pressed & ARCADA_BUTTONMASK_B) {
      gameState = ST_GAME_PICKER;
      drawGamePicker();
      return;
    }
    bool timedOut = mathNow >= mathRoundEndMs;
    bool answered = (pressed & (ARCADA_BUTTONMASK_UP | ARCADA_BUTTONMASK_DOWN)) != 0;
    if (answered || timedOut) {
      bool saidTrue = (pressed & ARCADA_BUTTONMASK_UP) != 0;
      bool correct = !timedOut && (saidTrue == mathTrue);
      if (correct) {
        mathScore += 10;
        sfx(700, 30);
        if (mathRoundMs > 1200) mathRoundMs -= 80;
        mathNewRound();
      } else {
        mathLives--;
        sfx(150, 80);
        pixelsFlash(255, 0, 0, 60);
        if (mathLives <= 0) {
          if (mathScore > mathBestScore) mathBestScore = mathScore;
          recordResult(17, g_variant, (long)(mathScore), true);
          if (twoPOrMix()) {
            twoPHandleGameEnd(mathScore);
          } else {
            gameState = ST_MATH_OVER;
            drawMathOverScreen();
          }
          return;
        }
        mathNewRound();
      }
    }

    drawMathScene();
    drawMathHud();
    blitScreen();
    return;
