// --- Sound -----------------------------------------------------------------

// Every sound effect in the program funnels through sfx(), so muting here
// is enough to silence all of them at once.

// tone() has no amplitude, so "volume" is emulated: Low drops shrill notes and
// halves note length, Med trims the very highest notes and shortens by 1/4.
// When the last real sound effect finishes (menu music waits for this) and a flag
// that menuMusicTick() sets while it is the one calling sfx().
static unsigned long s_sfxEndMs = 0;
static bool s_musicPlaying = false;
// Applies the Volume setting to one note; false = the note is dropped at this volume.
static bool sndShape(uint16_t& freq, uint16_t& ms) {
  if (g_save.volume == 0) {
    if (freq > 1000) return false;
    if (ms > 8) { ms = ms / 2; if (ms < 8) ms = 8; }
  } else if (g_save.volume == 1) {
    if (freq > 1800) return false;
    if (ms > 8) { ms = (uint16_t)((ms * 3) / 4); if (ms < 8) ms = 8; }
  }
  return true;
}
static void sfx(uint16_t freq, uint16_t ms) {
  if (!s_soundOn) return;
  if (!sndShape(freq, ms)) return;
  if (!s_musicPlaying) { s_sfxEndMs = millis() + ms; s_sfxLastMs = millis(); }
  tone(ARCADA_AUDIO_OUT, freq, ms);
}

// --- Jingles: tiny non-blocking note sequences (freq, ms pairs; 0 ends; <= 8 notes) -----
// jingleTick() runs once per loop(), so a jingle keeps playing across state changes and
// never blocks input. Any sfx() tone that outlasts the jingle's current note pauses the
// jingle until it is done (and a jingle that keeps getting out-shouted gives up).
// Mute and the Volume setting apply through sndShape().
static const uint16_t kJingle[JG_COUNT][16] = {
  {784, 70, 988, 70, 1175, 70, 1568, 170, 0},                 // new best
  {659, 70, 784, 70, 1047, 70, 1319, 160, 0},                 // achievement / trophy
  {392, 110, 330, 110, 262, 240, 0},                          // game over
  {523, 80, 659, 80, 784, 80, 1047, 220, 0},                  // win / level up
  {440, 60, 660, 110, 0},                                     // game start
  {523, 70, 659, 70, 784, 70, 659, 70, 1047, 200, 0},         // mix result
};
static void jingleStart(uint8_t kind) {
  if (kind >= JG_COUNT || !s_soundOn || s_jgOn) return;
  s_jgOn = true;
  s_jgKind = kind;
  s_jgIdx = 0;
  s_jgNext = millis();
  s_jgOwnEnd = s_sfxEndMs;   // earlier sfx tones do not count as 'outlasting' us
  s_jgWaitSince = s_jgNext;
}
static void jingleTick() {
  if (!s_jgOn) return;
  if (!s_soundOn) { s_jgOn = false; return; }
  uint32_t now = millis();
  if ((int32_t)(now - s_jgNext) < 0) return;
  // an sfx() tone that outlasts our own last note: wait for it (give up after ~0.7 s)
  if ((int32_t)(s_sfxEndMs - s_jgOwnEnd) > 0 && (int32_t)(now - s_sfxEndMs) < 0) {
    s_jgNext = s_sfxEndMs;
    if ((int32_t)(now - s_jgWaitSince) > (s_jgKind == JG_WIN ? 1500 : 700)) s_jgOn = false;
    return;
  }
  if (s_jgIdx >= 8) { s_jgOn = false; return; }
  uint16_t f = kJingle[s_jgKind][s_jgIdx * 2];
  uint16_t ms = kJingle[s_jgKind][s_jgIdx * 2 + 1];
  if (f == 0) { s_jgOn = false; return; }
  s_jgIdx++;
  uint16_t sf = f, sm = ms;
  if (sndShape(sf, sm)) {
    tone(ARCADA_AUDIO_OUT, sf, sm);
    s_jgOwnEnd = now + sm;
    s_sfxEndMs = s_jgOwnEnd;   // menu music waits for the jingle too
  }
  s_jgNext = now + ms + 15;
  s_jgWaitSince = now;
}

static void sfxMove() { sfx(220, 15); }
static void sfxBlocked() { sfx(120, 30); }
static void sfxPortalBlue() { sfx(900, 60); }
static void sfxPortalOrange() { sfx(500, 60); }
static void sfxPush() { sfx(300, 25); }
static void sfxDeath() { sfx(90, 250); }
static void sfxWin() { jingleStart(JG_WIN); }   // non-blocking

// --- NeoPixels ---------------------------------------------------------

static bool s_pxOn = false;        // a non-blocking flash is lit and waits for pixelsTick() to clear it
static uint32_t s_pxOffAt = 0;
static void pixelsSet(uint8_t r, uint8_t g, uint8_t b) {
  s_pxOn = false;   // any direct write cancels a pending async clear
  for (int i = 0; i < ARCADA_NEOPIXEL_NUM; i++) {
    arcada.pixels.setPixelColor(i, r, g, b);
  }
  arcada.pixels.show();
}

static void pixelsFlash(uint8_t r, uint8_t g, uint8_t b, uint16_t ms) {
  pixelsSet(r, g, b);
  delay(ms);
  pixelsSet(0, 0, 0);
}
// Real-time variant: lights the pixels now and lets loop() switch them off after `ms`.
static void pixelsFlashAsync(uint8_t r, uint8_t g, uint8_t b, uint16_t ms) {
  pixelsSet(r, g, b);
  s_pxOn = true;
  s_pxOffAt = millis() + ms;
}
static void pixelsTick() {
  if (s_pxOn && (int32_t)(millis() - s_pxOffAt) >= 0) pixelsSet(0, 0, 0);   // also clears s_pxOn
}

// --- Animation helpers (shared by menus, title/over screens, games) -----------
// Triangle wave 0..255 with the given period; cheap "pulse"/"blink" source.
static uint8_t animPulse(uint32_t periodMs) {
  if (periodMs < 2) return 0;
  uint32_t p = millis() % periodMs;
  uint32_t h = periodMs / 2;
  uint32_t v = (p < h) ? p : (periodMs - p);
  return (uint8_t)((v * 255u) / h);
}
// Ease-out cubic, t clamped to 0..1.
static float animEase(float t) {
  if (t <= 0.0f) return 0.0f;
  if (t >= 1.0f) return 1.0f;
  float u = 1.0f - t;
  return 1.0f - u * u * u;
}
// Ease-out bounce, t clamped to 0..1.
static float animBounce(float t) {
  if (t <= 0.0f) return 0.0f;
  if (t >= 1.0f) return 1.0f;
  if (t < 0.36364f) return 7.5625f * t * t;
  if (t < 0.72727f) { t -= 0.54545f; return 7.5625f * t * t + 0.75f; }
  if (t < 0.90909f) { t -= 0.81818f; return 7.5625f * t * t + 0.9375f; }
  t -= 0.95455f;
  return 7.5625f * t * t + 0.984375f;
}
// Linear RGB565 blend: t=0 -> a, t=255 -> b.
static uint16_t animBlend(uint16_t a, uint16_t b, uint8_t t) {
  int ar = (a >> 11) & 31, ag = (a >> 5) & 63, ab = a & 31;
  int br = (b >> 11) & 31, bg = (b >> 5) & 63, bb = b & 31;
  int r = ar + ((br - ar) * t) / 255;
  int g = ag + ((bg - ag) * t) / 255;
  int bl = ab + ((bb - ab) * t) / 255;
  return (uint16_t)((r << 11) | (g << 5) | bl);
}
// Moves v toward target (exponential ease-out); snaps when close.
static void animChase(float& v, float target, float k) {
  float d = target - v;
  if (d < 0.02f && d > -0.02f) v = target;
  else v += d * k;
}
// Pulsing text: fades between COL_BG and col. Caller sets size/cursor.
static void drawPulsingText(int x, int y, const char* text, uint16_t col, uint32_t periodMs) {
  canvas->setCursor(x, y);
  canvas->setTextColor(animBlend(COL_BG, col, (uint8_t)(90 + (animPulse(periodMs) * 165u) / 255u)));
  canvas->print(text);
}

// Category accents (Arcade, Reflex, Puzzle, Strategy, Battle, other). Runtime-built
// (color565 is not a constant expression) by initPickerColors().
static uint16_t s_catCols[6];

// --- Tiny particle pool (confetti / sparkles / bursts) ------------------------
// 24 particles, 16 bytes each, plus 192 bytes of "pixels under the sprite" for the
// static-screen mode. Positions are 1/16 px. A burst only lives while gameState is the
// one it was started in (leaving the screen drops everything), and every sprite is
// clipped to canvas->width()/height(), so portrait (128x160) works too. Uses its own
// RNG so seeded games (s_mazeRng) stay deterministic.
struct Particle {
  int16_t x, y, vx, vy;
  int16_t sx, sy;       // where the last drawn sprite (2x2) sits (static-screen mode)
  uint16_t col;
  uint8_t life, saved;
};
#define NUM_PARTICLES 24
static Particle s_parts[NUM_PARTICLES];
static uint16_t s_partSave[NUM_PARTICLES][4];
static uint8_t s_partState = 0xFF;
static uint32_t s_partRng = 0x2F6E2B1u;
static bool s_partStatic = false;    // confetti on a static (not redrawn) screen: animScreenTick owns it
static bool s_pendBurst = false;     // NEW BEST confetti waiting for the first post-slide tick
static int s_pendBurstY = 0;

static uint32_t partRand() {
  s_partRng ^= s_partRng << 13;
  s_partRng ^= s_partRng >> 17;
  s_partRng ^= s_partRng << 5;
  return s_partRng;
}
// Spawns up to `count` particles at pixel (x,y); color 0 = random category colour.
static void particlesBurst(int x, int y, int count, uint16_t color) {
  if (s_partState != (uint8_t)gameState) {
    memset(s_parts, 0, sizeof(s_parts));
    s_partState = (uint8_t)gameState;
  }
  s_partRng ^= (uint32_t)micros();
  if (s_partRng == 0) s_partRng = 0x2F6E2B1u;
  for (int i = 0; i < NUM_PARTICLES && count > 0; i++) {
    Particle& p = s_parts[i];
    if (p.life || p.saved) continue;
    uint32_t r = partRand();
    p.x = (int16_t)(x * 16);
    p.y = (int16_t)(y * 16);
    p.vx = (int16_t)((int)(r & 63) - 32);
    p.vy = (int16_t)(-10 - (int)((r >> 6) & 47));
    p.col = color ? color : s_catCols[(r >> 12) % 6];
    p.life = (uint8_t)(20 + ((r >> 16) % 14));
    count--;
  }
}
// Restores the pixels under every sprite drawn by the last particlesStep(true).
static void particlesErase() {
  if (s_partState != (uint8_t)gameState) {
    for (int i = 0; i < NUM_PARTICLES; i++) s_parts[i].saved = 0;
    return;
  }
  const int W = canvas->width();
  uint16_t* buf = canvas->getBuffer();
  for (int i = NUM_PARTICLES - 1; i >= 0; i--) {
    Particle& p = s_parts[i];
    if (!p.saved) continue;
    p.saved = 0;
    size_t o = (size_t)p.sy * W + p.sx;
    buf[o] = s_partSave[i][0];
    buf[o + 1] = s_partSave[i][1];
    buf[o + W] = s_partSave[i][2];
    buf[o + W + 1] = s_partSave[i][3];
  }
}
// One physics step + draw. save=true remembers the pixels underneath (static screens that
// are not redrawn every frame; call particlesErase() first); save=false is for screens
// that redraw everything each frame (gameplay). Returns true while any particle lives.
static bool particlesStep(bool save) {
  if (s_partState != (uint8_t)gameState) {
    memset(s_parts, 0, sizeof(s_parts));
    s_partState = (uint8_t)gameState;
    return false;
  }
  const int W = canvas->width(), H = canvas->height();
  uint16_t* buf = canvas->getBuffer();
  bool any = false;
  for (int i = 0; i < NUM_PARTICLES; i++) {
    Particle& p = s_parts[i];
    if (!p.life) continue;
    p.life--;
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 2;
    int px = p.x >> 4, py = p.y >> 4;
    if (p.life == 0 || px < 0 || py < 0 || px >= W - 1 || py >= H - 1) { p.life = 0; continue; }
    any = true;
    uint16_t c = p.col;
    if (p.life < 6) c = animBlend(p.col, COL_BG, (uint8_t)((6 - p.life) * 40));
    size_t o = (size_t)py * W + px;
    if (save) {
      s_partSave[i][0] = buf[o];
      s_partSave[i][1] = buf[o + 1];
      s_partSave[i][2] = buf[o + W];
      s_partSave[i][3] = buf[o + W + 1];
      p.sx = (int16_t)px;
      p.sy = (int16_t)py;
      p.saved = 1;
    }
    buf[o] = c;
    buf[o + 1] = c;
    buf[o + W] = c;
    buf[o + W + 1] = c;
  }
  return any;
}
// Gameplay screens (redrawn every frame): call right before blitScreen().
static void ringsStep();
static void particlesUpdateDraw() { particlesStep(false); ringsStep(); }

// Bigger explosion: particles + a few expanding rings/spokes (4 slots x 8 B, non-blocking;
// drawn from particlesUpdateDraw(), so a game needs no extra call).
struct ExpRing { int16_t x, y; uint8_t age, maxr; uint16_t col; };
static ExpRing s_rings[4];
static uint8_t s_ringState = 0xFF;
static void explosionBurst(int x, int y, int size, uint16_t color) {
  if (size < 3) size = 3;
  if (size > 40) size = 40;
  int cnt = 6 + size / 2;
  if (cnt > 18) cnt = 18;
  particlesBurst(x, y, cnt, color);
  if (s_ringState != (uint8_t)gameState) { memset(s_rings, 0, sizeof(s_rings)); s_ringState = (uint8_t)gameState; }
  int slot = 0;
  for (int i = 0; i < 4; i++) { if (!s_rings[i].maxr) { slot = i; break; } if (s_rings[i].age > s_rings[slot].age) slot = i; }
  ExpRing& r = s_rings[slot];
  r.x = (int16_t)x; r.y = (int16_t)y; r.age = 0; r.maxr = (uint8_t)size;
  r.col = color ? color : COL_ORANGE;
}
static void ringsStep() {
  if (s_ringState != (uint8_t)gameState) { memset(s_rings, 0, sizeof(s_rings)); s_ringState = (uint8_t)gameState; return; }
  static const int8_t kDx[8] = {10, 7, 0, -7, -10, -7, 0, 7};
  static const int8_t kDy[8] = {0, 7, 10, 7, 0, -7, -10, -7};
  for (int i = 0; i < 4; i++) {
    ExpRing& r = s_rings[i];
    if (!r.maxr) continue;
    r.age++;
    if (r.age > 10) { r.maxr = 0; continue; }
    int rad = 1 + ((int)r.maxr * r.age) / 10;
    uint16_t c = animBlend(r.col, COL_BG, (uint8_t)(r.age * 20));
    canvas->drawCircle(r.x, r.y, rad, c);
    if (rad > 4) canvas->drawCircle(r.x, r.y, rad / 2, animBlend(0xFFFF, COL_BG, (uint8_t)(r.age * 24)));
    int r0 = rad * 6 / 10;
    for (int k = 0; k < 8; k++) {
      canvas->drawLine(r.x + kDx[k] * r0 / 10, r.y + kDy[k] * r0 / 10, r.x + kDx[k] * rad / 10, r.y + kDy[k] * rad / 10, c);
    }
  }
}

// Registered "live" regions of the current static title/over screen: the
// A/Start prompt pulses, a NEW BEST! line flashes and a score counts up.
// All are cancelled automatically when gameState changes.
static GameState s_animState = ST_SPLASH;
static bool s_pmActive = false, s_blActive = false, s_cuActive = false;
static int s_pmX = 0, s_pmY = 0, s_blX = 0, s_blY = 0, s_cuY = 0;
static const char* s_pmText = "";
static char s_blText[32];
static long s_cuTarget = 0;
static unsigned long s_cuStart = 0;
static bool s_acActive = false;      // sweeping accent bar (title screens)
static int s_acX = 0, s_acY = 0, s_acW = 0;
static uint16_t s_acCol = 0;
static void animRegBegin() {
  if (s_animState != gameState || (!s_pmActive && !s_blActive && !s_cuActive && !s_acActive)) {
    s_pmActive = s_blActive = s_cuActive = s_acActive = false;
  }
  s_animState = gameState;
}
// 2 px high rule in `col` with a bright highlight sweeping along it (redrawn each tick).
static void animAccent(int x, int y, int w, uint16_t col) {
  animRegBegin();
  s_acX = x;
  s_acY = y;
  s_acW = w;
  s_acCol = col;
  s_acActive = true;
}
// Prints text at the current cursor and registers it as the pulsing prompt.
static void animPrompt(const char* text) {
  animRegBegin();
  s_pmX = canvas->getCursorX();
  s_pmY = canvas->getCursorY();
  s_pmText = text;
  s_pmActive = true;
  canvas->print(text);
}
static void animBestFlash(int x, int y, const char* text) {
  animRegBegin();
  s_blX = x;
  s_blY = y;
  snprintf(s_blText, sizeof(s_blText), "%s", text);
  s_blActive = true;
  s_pendBurst = true;     // confetti fires on the first redraw tick (after the game-over slide)
  s_pendBurstY = y + 4;
  jingleStart(JG_BEST);
}
// Big (size 2) centered score at y that counts up from 0 over ~700 ms.
static void animCountUp(long target, int y) {
  animRegBegin();
  s_cuTarget = target;
  s_cuY = y;
  s_cuStart = millis();
  s_cuActive = true;
}
static void animScreenTick() {
  if (!s_pmActive && !s_blActive && !s_cuActive && !s_acActive && !s_partStatic) return;
  if (gameState != s_animState) {
    s_pmActive = s_blActive = s_cuActive = s_acActive = false;
    s_pendBurst = false;
    if (s_partStatic) { memset(s_parts, 0, sizeof(s_parts)); s_partStatic = false; }  // confetti never outlives its screen
    return;
  }
  if (s_partStatic) particlesErase();   // put back the pixels under last tick's confetti
  if (s_pendBurst) {
    s_pendBurst = false;
    s_partStatic = true;
    const int cw = canvas->width();
    particlesBurst(cw / 4, s_pendBurstY, 8, 0);
    particlesBurst(cw / 2, s_pendBurstY, 8, 0);
    particlesBurst((cw * 3) / 4, s_pendBurstY, 8, 0);
  }
  canvas->setTextSize(1);
  if (s_acActive) {
    canvas->fillRect(s_acX, s_acY, s_acW, 2, animBlend(COL_BG, s_acCol, 80));
    int sw = (int)((millis() / 10u) % (uint32_t)(s_acW + 40)) - 20;
    for (int k = 0; k < 20; k++) {
      int px = sw + k;
      if (px < 0 || px >= s_acW) continue;
      int a = k < 10 ? k : 19 - k;   // 0..9..0 triangle
      canvas->fillRect(s_acX + px, s_acY, 1, 2, animBlend(s_acCol, 0xFFFF, (uint8_t)(a * 22)));
    }
  }
  if (s_pmActive) {
    int w = (int)strlen(s_pmText) * 6;
    canvas->fillRect(s_pmX, s_pmY, w, 8, COL_BG);
    drawPulsingText(s_pmX, s_pmY, s_pmText, COL_TEXT, 1100);
  }
  if (s_blActive) {
    int w = (int)strlen(s_blText) * 6;
    canvas->fillRect(s_blX, s_blY, w, 8, COL_BG);
    canvas->setCursor(s_blX, s_blY);
    canvas->setTextColor(animBlend(COL_KEY, 0xFFFF, animPulse(420)));
    canvas->print(s_blText);
  }
  if (s_cuActive) {
    float t = (float)(millis() - s_cuStart) / 700.0f;
    long v = s_cuTarget;
    if (t < 1.0f) v = (long)((float)s_cuTarget * animEase(t));
    else s_cuActive = false;
    char buf[16];
    snprintf(buf, sizeof(buf), "%ld", v);
    canvas->fillRect(0, s_cuY, canvas->width(), 16, COL_BG);
    canvas->setTextSize(2);
    ptc(COL_TEXT, (canvas->width() - (int)strlen(buf) * 12) / 2, s_cuY, buf);
    canvas->setTextSize(1);
  }
  if (s_partStatic) s_partStatic = particlesStep(true);
  blitScreen();
}

// --- Animated "turn me" prompt (shown before a portrait game starts) ---------------
// Draws a little handheld (rounded body, screen, D-pad and button dots) that swings
// 90 degrees back and forth with easing, a curved arrow and pulsing text. Landscape.
static void tpQuad(int cx, int cy, float ca, float sa, float x0, float y0, float x1, float y1,
                   uint16_t col) {
  const float qx[4] = {x0, x1, x1, x0}, qy[4] = {y0, y0, y1, y1};
  int X[4], Y[4];
  for (int i = 0; i < 4; i++) {
    X[i] = cx + (int)lroundf(qx[i] * ca - qy[i] * sa);
    Y[i] = cy + (int)lroundf(qx[i] * sa + qy[i] * ca);
  }
  canvas->fillTriangle(X[0], Y[0], X[1], Y[1], X[2], Y[2], col);
  canvas->fillTriangle(X[0], Y[0], X[2], Y[2], X[3], Y[3], col);
}
static void tpDot(int cx, int cy, float ca, float sa, float x, float y, int r, uint16_t col) {
  canvas->fillCircle(cx + (int)lroundf(x * ca - y * sa), cy + (int)lroundf(x * sa + y * ca), r, col);
}
static void tpRoundBox(int cx, int cy, float ca, float sa, float hx, float hy, uint16_t col) {
  tpQuad(cx, cy, ca, sa, -hx + 3, -hy, hx - 3, hy, col);
  tpQuad(cx, cy, ca, sa, -hx, -hy + 3, hx, hy - 3, col);
  tpDot(cx, cy, ca, sa, -hx + 3, -hy + 3, 3, col);
  tpDot(cx, cy, ca, sa, hx - 3, -hy + 3, 3, col);
  tpDot(cx, cy, ca, sa, -hx + 3, hy - 3, 3, col);
  tpDot(cx, cy, ca, sa, hx - 3, hy - 3, 3, col);
}

static void drawTurnPrompt() {
  unsigned long now = millis();
  float ph = (float)((now - s_turnT0) % 2800UL) / 2800.0f;
  float e;   // 0 = landscape, 1 = portrait
  if (ph < 0.15f) e = 0.0f;
  else if (ph < 0.45f) e = animEase((ph - 0.15f) / 0.30f);
  else if (ph < 0.60f) e = 1.0f;
  else if (ph < 0.90f) e = 1.0f - animEase((ph - 0.60f) / 0.30f);
  else e = 0.0f;
  const float s = (portDir() == 0) ? -1.0f : 1.0f;   // -1: counter-clockwise on screen
  float ang = s * e * 1.5707963f;
  float ca = cosf(ang), sa = sinf(ang);
  const int cx = 80, cy = 46;
  canvas->fillScreen(COL_BG);
  // curved arrow around the device
  {
    float sweep = (60.0f + 70.0f * (float)animPulse(1400) / 255.0f) * 0.0174533f;
    float t0 = (s < 0) ? -0.35f : -2.79f;
    const float R = 44.0f;
    int px = cx + (int)lroundf(R * cosf(t0)), py = cy + (int)lroundf(R * sinf(t0));
    int steps = (int)(sweep / 0.14f) + 1;
    float te = t0;
    for (int i = 1; i <= steps; i++) {
      te = t0 + s * sweep * (float)i / (float)steps;
      int nx = cx + (int)lroundf(R * cosf(te)), ny = cy + (int)lroundf(R * sinf(te));
      canvas->drawLine(px, py, nx, ny, COL_KEY);
      canvas->drawLine(px, py + 1, nx, ny + 1, COL_KEY);
      px = nx;
      py = ny;
    }
    float tx = -s * sinf(te), ty = s * cosf(te), nx = cosf(te), ny = sinf(te);
    canvas->fillTriangle(px + (int)lroundf(8 * tx), py + (int)lroundf(8 * ty),
                         px + (int)lroundf(5 * nx), py + (int)lroundf(5 * ny),
                         px - (int)lroundf(5 * nx), py - (int)lroundf(5 * ny), COL_KEY);
  }
  // the device
  tpRoundBox(cx, cy, ca, sa, 27, 18, animBlend(COL_ORANGE, 0xFFFF, animPulse(700) / 2));
  tpRoundBox(cx, cy, ca, sa, 25, 16, animBlend(COL_BG, COL_WALL, 120));
  tpQuad(cx, cy, ca, sa, -15, -12, 9, 6, animBlend(COL_BG, COL_BLUE, 150));
  tpQuad(cx, cy, ca, sa, -24, -1, -18, 1, COL_TEXT);   // D-pad cross
  tpQuad(cx, cy, ca, sa, -22, -3, -20, 3, COL_TEXT);
  tpDot(cx, cy, ca, sa, 17, -3, 2, COL_GOAL);          // A / B
  tpDot(cx, cy, ca, sa, 22, 3, 2, COL_ORANGE);
  tpQuad(cx, cy, ca, sa, -4, 10, 4, 12, COL_TEXT);     // start bar
  canvas->setTextSize(2);
  drawPulsingText(38, 90, "TURN ME", COL_ORANGE, 900);
  canvas->setTextSize(1);
  ptc(COL_TEXT, 38, 108, "Rotate to play");
  ptc(COL_ICE, 29, 118, "A: skip   B: back");
  blitScreen();
}

// Called from each portrait game's enter*Playing(). When the device is currently held
// in landscape this parks the game behind the turn prompt and returns true (the caller
// returns at once); the prompt calls the game back with s_turnBypass set.
static bool portraitGate(EnterPlayingFn self, EnterPlayingFn title) {
  if (s_turnBypass) { s_turnBypass = false; return false; }
  if (!s_portCanvas) {   // canvas allocation failed: portrait games can't run, back to their title
    toastShow("Portrait unavailable");
    title();
    return true;
  }
  if (!arcada.accel) return false;
  if (s_orientPort) return false;
  if (isPortraitState((uint8_t)gameState)) return false; // retry / pause-restart: already in a portrait game
  s_turnFn = self;
  s_turnTitleFn = title;
  s_turnT0 = millis();
  gameState = ST_TURN_PROMPT;
  drawTurnPrompt();
  return true;
}

// A bright "comet" streams around the strip with a fading tail, cycling
// through colors, for exactly one second.
static void pixelsWinCelebration() {
  const uint8_t colors[6][3] = {{255, 0, 0}, {255, 140, 0}, {255, 255, 0},
                                 {0, 255, 0}, {0, 140, 255}, {180, 0, 255}};
  const unsigned long duration = 1000;
  const unsigned long frameMs = 35;
  unsigned long start = millis();
  int step = 0;

  while (millis() - start < duration) {
    const uint8_t* c = colors[(step / 3) % 6];
    for (int i = 0; i < ARCADA_NEOPIXEL_NUM; i++) {
      int dist = ((i - step) % ARCADA_NEOPIXEL_NUM + ARCADA_NEOPIXEL_NUM) %
                 ARCADA_NEOPIXEL_NUM;
      uint8_t fade = (dist == 0) ? 255 : (dist == 1) ? 110 : (dist == 2) ? 30 : 0;
      arcada.pixels.setPixelColor(i, (c[0] * fade) / 255, (c[1] * fade) / 255,
                                   (c[2] * fade) / 255);
    }
    arcada.pixels.show();
    delay(frameMs);
    step++;
  }
  pixelsSet(0, 0, 0);
}

// --- Level loading -------------------------------------------------------

// Which box (if any) currently has its center in tile (r,c). Used by the
// tile-based systems that don't need pixel precision: the portal ray and
// the laser trace.
static int boxAt(int r, int c) {
  for (int i = 0; i < MAX_BOXES; i++) {
    if (boxes[i].active && tileRowAt(boxes[i].y) == r &&
        tileColAt(boxes[i].x) == c)
      return i;
  }
  return -1;
}

// Which box (if any) overlaps a square of the given half-extent centered
// at (x,y). Used for continuous player<->box collision.
static int boxOverlapping(float x, float y, float half, int ignore = -1) {
  for (int i = 0; i < MAX_BOXES; i++) {
    if (!boxes[i].active || i == ignore)
      continue;
    if (fabsf(boxes[i].x - x) < (half + BOX_HALF) &&
        fabsf(boxes[i].y - y) < (half + BOX_HALF))
      return i;
  }
  return -1;
}

// Shared per-level reset, used by both the hand-authored loader and the
// on-device maze generator below.
static void resetLevelRuntimeState() {
  facingDX = 0;
  facingDY = 1;
  playerVX = playerVY = 0;
  portalBlueRow = portalBlueCol = -1;
  portalOrangeRow = portalOrangeCol = -1;
  moveCount = 0;
  levelWon = false;
  doorsOpen = false;
  hasKey = false;
}

static int s_hlNextBox = 0;

// Shared by the flash table and the /packs/portal.lvl loader: reset, then parse one row at a time.
static void handLevelBegin(int w, int h) {
  curW = w;
  curH = h;
  for (int i = 0; i < MAX_BOXES; i++)
    boxes[i].active = false;
  s_hlNextBox = 0;
  numEmitters = 0;
  teleportARow = teleportACol = teleportBRow = teleportBCol = -1;
  goalRow = goalCol = keyRow = keyCol = -1;
}

// Parses row r (at least curW chars, no terminator needed) into grid[r][].
static void handLevelRow(int r, const char* row) {
  {
    int nextBox = s_hlNextBox;
    for (int c = 0; c < curW; c++) {
      char ch = row[c];
      int8_t edx = 0, edy = 0;
      switch (ch) {
        case '#': grid[r][c] = T_WALL; break;
        case 'N': grid[r][c] = T_WALL_NOPORTAL; break;
        case '~': grid[r][c] = T_PIT; break;
        case 'I': grid[r][c] = T_ICE; break;
        case 'P': grid[r][c] = T_PLATE; break;
        case 'D': grid[r][c] = T_DOOR; break;
        case 'Y':
          grid[r][c] = T_KEY;
          keyRow = r;
          keyCol = c;
          break;
        case 'K': grid[r][c] = T_DOOR_LOCKED; break;
        case 'u': grid[r][c] = T_CONVEYOR_UP; break;
        case 'd': grid[r][c] = T_CONVEYOR_DOWN; break;
        case 'l': grid[r][c] = T_CONVEYOR_LEFT; break;
        case 'r': grid[r][c] = T_CONVEYOR_RIGHT; break;
        case 'F': grid[r][c] = T_BOOST; break;
        case 'M': grid[r][c] = T_MUD; break;
        case 'T':
          grid[r][c] = T_TELEPORT_A;
          teleportARow = r;
          teleportACol = c;
          break;
        case 'U':
          grid[r][c] = T_TELEPORT_B;
          teleportBRow = r;
          teleportBCol = c;
          break;
        case 'G':
          grid[r][c] = T_GOAL;
          goalRow = r;
          goalCol = c;
          break;
        case 'S':
          grid[r][c] = T_FLOOR;
          playerX = tileCenterX(c);
          playerY = tileCenterY(r);
          break;
        case 'X':
          grid[r][c] = T_FLOOR;
          if (nextBox < MAX_BOXES) {
            boxes[nextBox].x = tileCenterX(c);
            boxes[nextBox].y = tileCenterY(r);
            boxes[nextBox].active = true;
            nextBox++;
          }
          break;
        case '^': edy = -1; goto emitter;
        case 'v': edy = 1; goto emitter;
        case '<': edx = -1; goto emitter;
        case '>':
          edx = 1;
        emitter:
          grid[r][c] = T_EMITTER;
          if (numEmitters < MAX_EMITTERS) {
            emitters[numEmitters].row = r;
            emitters[numEmitters].col = c;
            emitters[numEmitters].dx = edx;
            emitters[numEmitters].dy = edy;
            numEmitters++;
          }
          break;
        default:
          grid[r][c] = T_FLOOR;
          break;
      }
    }
    s_hlNextBox = nextBox;
  }
}

static void loadHandLevel(int idx) {
  const Level& lvl = LEVELS[idx];
  int h = 0;
  while (h < MAX_GRID_ROWS && lvl.rows[h] != nullptr)
    h++;
  int w = (h > 0) ? strlen(lvl.rows[0]) : VIEW_COLS;
  if (w > MAX_GRID_COLS) w = MAX_GRID_COLS;
  handLevelBegin(w, h);
  for (int r = 0; r < h; r++)
    handLevelRow(r, lvl.rows[r]);
  resetLevelRuntimeState();
}

// --- On-device maze generation ------------------------------------------
//
// Ports the exact algorithm used to validate this design offline (see
// gen_levels.js in the sketch folder) so it runs live on the PyGamer:
// a recursive-backtracker "perfect maze" (exactly one path between any
// two cells), with a mandatory pit crossing and a key-behind-a-locked-door
// detour dropped onto that unique path. Seeded by the level number, so a
// given level number always regenerates the same maze.
//
// Difficulty isn't a setting -- it's the generated level number itself.
// Every DIFFICULTY_TIER_SPAN levels, the maze gets a bit bigger and a bit
// denser (a second mandatory pit crossing kicks in, then more ice/mud),
// up to a cap where it plateaus -- past that point mazes stay at max
// density forever, just with different layouts.
//
// Also ports the offline script's automated solvability check (a BFS that
// understands pit-bridging and the key/door gate) and runs it here too --
// if a random construction doesn't check out, it retries with a different
// internal seed (still deterministic overall) before finalizing. Every
// level that reaches the player has been verified reachable end to end.

#define DIFFICULTY_TIER_SPAN 80 // generated levels per tier
#define DIFFICULTY_MAX_TIER 12  // plateaus here (maze size hits MAZE_MAX_CELLS_*) -- reached around level 960 of 1000

#define MAZE_MAX_CELLS_W 12
#define MAZE_MAX_CELLS_H 10
#define MAZE_MAX_CELLS (MAZE_MAX_CELLS_W * MAZE_MAX_CELLS_H)
#define MAZE_MAX_RETRIES 20

static uint32_t s_mazeRng;
static uint32_t mazeRngNext() {
  uint32_t x = s_mazeRng;
  x ^= x << 13;
  x ^= x >> 17;
  x ^= x << 5;
  s_mazeRng = x;
  return x;
}
static int mazeRngRange(int n) { return (int)(mazeRngNext() % (uint32_t)n); }

// --- Solvability check ---------------------------------------------------
//
// BFS across the tile grid: walls/portal-proof-walls/emitters block, pits
// can't be walked onto directly but ARE bridgeable (mirroring the real
// portal-shot rule: from any tile next to a pit run, you can reach the
// first solid tile beyond it in a straight line), and a locked door only
// opens in the second phase, once the key has been collected.

static bool solveSeen[MAX_GRID_ROWS][MAX_GRID_COLS];
static int16_t solveQR[MAX_GRID_ROWS * MAX_GRID_COLS];
static int16_t solveQC[MAX_GRID_ROWS * MAX_GRID_COLS];

static void solveBfsFill(int W, int H, int sr, int sc, bool keyCollected) {
  static const int8_t dx4[4] = {1, -1, 0, 0};
  static const int8_t dy4[4] = {0, 0, 1, -1};

  for (int r = 0; r < H; r++)
    for (int c = 0; c < W; c++)
      solveSeen[r][c] = false;

  int qh = 0, qt = 0;
  solveQR[qt] = sr;
  solveQC[qt] = sc;
  qt++;
  solveSeen[sr][sc] = true;

  while (qh < qt) {
    int y = solveQR[qh], x = solveQC[qh];
    qh++;
    for (int d = 0; d < 4; d++) {
      int nx = x + dx4[d], ny = y + dy4[d];
      if (nx < 0 || nx >= W || ny < 0 || ny >= H) continue;
      uint8_t t = grid[ny][nx];
      if (t == T_WALL || t == T_WALL_NOPORTAL || t == T_EMITTER || t == T_PIT) continue;
      if (t == T_DOOR_LOCKED && !keyCollected) continue;
      if (!solveSeen[ny][nx]) {
        solveSeen[ny][nx] = true;
        solveQR[qt] = ny;
        solveQC[qt] = nx;
        qt++;
      }
    }
    for (int d = 0; d < 4; d++) {
      int fx = x + dx4[d], fy = y + dy4[d];
      if (fx < 0 || fx >= W || fy < 0 || fy >= H || grid[fy][fx] != T_PIT) continue;
      while (fx >= 0 && fx < W && fy >= 0 && fy < H && grid[fy][fx] == T_PIT) {
        fx += dx4[d];
        fy += dy4[d];
      }
      if (fx < 0 || fx >= W || fy < 0 || fy >= H) continue;
      uint8_t ft = grid[fy][fx];
      if (ft == T_WALL || ft == T_WALL_NOPORTAL || ft == T_EMITTER) continue;
      if (ft == T_DOOR_LOCKED && !keyCollected) continue;
      if (!solveSeen[fy][fx]) {
        solveSeen[fy][fx] = true;
        solveQR[qt] = fy;
        solveQC[qt] = fx;
        qt++;
      }
    }
  }
}

static bool checkMazeSolvable(int W, int H, int sx, int sy, int gx, int gy,
                               int keyTx, int keyTy) {
  if (keyTx >= 0) {
    solveBfsFill(W, H, sy, sx, false);
    if (!solveSeen[keyTy][keyTx]) return false;
    solveBfsFill(W, H, keyTy, keyTx, true);
    return solveSeen[gy][gx];
  }
  solveBfsFill(W, H, sy, sx, false);
  return solveSeen[gy][gx];
}

static void generateMazeLevel(int genIndex) {
  // Difficulty ramps with the generated level number itself, not a
  // setting. Tier 0 is the smallest/easiest; it grows every
  // DIFFICULTY_TIER_SPAN levels and plateaus at DIFFICULTY_MAX_TIER
  // (mazes just keep getting different after that, not bigger).
  int tier = genIndex / DIFFICULTY_TIER_SPAN;
  if (tier > DIFFICULTY_MAX_TIER) tier = DIFFICULTY_MAX_TIER;

  int cellsWMin = 4 + tier / 2;
  int cellsWSpan = 3 + tier / 2;
  int cellsHMin = 3 + tier / 2;
  int cellsHSpan = 3 + tier / 3;
  if (cellsWMin + cellsWSpan > MAZE_MAX_CELLS_W)
    cellsWSpan = MAZE_MAX_CELLS_W - cellsWMin;
  if (cellsHMin + cellsHSpan > MAZE_MAX_CELLS_H)
    cellsHSpan = MAZE_MAX_CELLS_H - cellsHMin;
  // Safe with the current constants (verified by hand), but mazeRngRange()
  // does an unguarded modulo -- if DIFFICULTY_MAX_TIER or the size formulas
  // above are ever tuned without re-checking this, clamp rather than risk
  // a modulo-by-zero.
  if (cellsWSpan < 1) cellsWSpan = 1;
  if (cellsHSpan < 1) cellsHSpan = 1;

  bool wantKeyDoor = tier >= 1;
  bool wantSecondPit = tier >= 4;
  int flavorStep = tier >= 8 ? 4 : tier >= 3 ? 6 : 9; // higher tier = denser

  static const int8_t dx4[4] = {1, -1, 0, 0};
  static const int8_t dy4[4] = {0, 0, 1, -1};

  static bool visited[MAZE_MAX_CELLS_H][MAZE_MAX_CELLS_W];
  static int8_t stackX[MAZE_MAX_CELLS], stackY[MAZE_MAX_CELLS];
  static bool bfsSeen[MAZE_MAX_CELLS_H][MAZE_MAX_CELLS_W];
  static int8_t prevX[MAZE_MAX_CELLS_H][MAZE_MAX_CELLS_W];
  static int8_t prevY[MAZE_MAX_CELLS_H][MAZE_MAX_CELLS_W];
  static int8_t qx[MAZE_MAX_CELLS], qy[MAZE_MAX_CELLS];
  static int8_t pathX[MAZE_MAX_CELLS], pathY[MAZE_MAX_CELLS];
  static bool onPath[MAZE_MAX_CELLS_H][MAZE_MAX_CELLS_W];
  static int16_t tileX[MAZE_MAX_CELLS * 2], tileY[MAZE_MAX_CELLS * 2];

  int cellsW = 0, cellsH = 0, W = 0, H = 0;
  int sx = 0, sy = 0, gx = 0, gy = 0, keyTx = -1, keyTy = -1;
  int tileLen = 0;
  bool solved = false;
  int attemptsUsed = 0;

  for (int attempt = 0; attempt < MAZE_MAX_RETRIES && !solved; attempt++) {
    attemptsUsed = attempt + 1;
    s_mazeRng = (uint32_t)(genIndex + 1) * 2654435761u +
                (uint32_t)attempt * 40503u + 1u;
    if (s_mazeRng == 0) s_mazeRng = 0xA5A5A5A5u;

    cellsW = cellsWMin + mazeRngRange(cellsWSpan);
    cellsH = cellsHMin + mazeRngRange(cellsHSpan);
    W = 2 * cellsW + 1;
    H = 2 * cellsH + 1;

    for (int r = 0; r < H; r++)
      for (int c = 0; c < W; c++)
        grid[r][c] = T_WALL;
    for (int cy = 0; cy < cellsH; cy++)
      for (int cx = 0; cx < cellsW; cx++)
        grid[2 * cy + 1][2 * cx + 1] = T_FLOOR;

    for (int r = 0; r < cellsH; r++)
      for (int c = 0; c < cellsW; c++)
        visited[r][c] = false;

    int sp = 0;
    stackX[0] = 0;
    stackY[0] = 0;
    sp = 1;
    visited[0][0] = true;

    while (sp > 0) {
      int cx = stackX[sp - 1], cy = stackY[sp - 1];
      int order[4] = {0, 1, 2, 3};
      for (int i = 3; i > 0; i--) {
        int j = mazeRngRange(i + 1);
        int t = order[i];
        order[i] = order[j];
        order[j] = t;
      }
      bool moved = false;
      for (int oi = 0; oi < 4; oi++) {
        int d = order[oi];
        int nx = cx + dx4[d], ny = cy + dy4[d];
        if (nx >= 0 && nx < cellsW && ny >= 0 && ny < cellsH && !visited[ny][nx]) {
          grid[2 * cy + 1 + dy4[d]][2 * cx + 1 + dx4[d]] = T_FLOOR; // carve
          visited[ny][nx] = true;
          stackX[sp] = nx;
          stackY[sp] = ny;
          sp++;
          moved = true;
          break;
        }
      }
      if (!moved) sp--;
    }

    // BFS over cells, from (0,0) to the far corner, to find the (unique)
    // solution path.
    for (int r = 0; r < cellsH; r++)
      for (int c = 0; c < cellsW; c++)
        bfsSeen[r][c] = false;

    int qh = 0, qt = 0;
    qx[qt] = 0;
    qy[qt] = 0;
    qt++;
    bfsSeen[0][0] = true;
    int goalCx = cellsW - 1, goalCy = cellsH - 1;

    while (qh < qt) {
      int cx = qx[qh], cy = qy[qh];
      qh++;
      if (cx == goalCx && cy == goalCy) break;
      for (int d = 0; d < 4; d++) {
        int nx = cx + dx4[d], ny = cy + dy4[d];
        if (nx < 0 || nx >= cellsW || ny < 0 || ny >= cellsH) continue;
        if (grid[2 * cy + 1 + dy4[d]][2 * cx + 1 + dx4[d]] != T_FLOOR) continue;
        if (bfsSeen[ny][nx]) continue;
        bfsSeen[ny][nx] = true;
        prevX[ny][nx] = cx;
        prevY[ny][nx] = cy;
        qx[qt] = nx;
        qy[qt] = ny;
        qt++;
      }
    }

    int pathLen = 0;
    {
      int cx = goalCx, cy = goalCy;
      for (;;) {
        pathX[pathLen] = cx;
        pathY[pathLen] = cy;
        pathLen++;
        if (cx == 0 && cy == 0) break;
        int px = prevX[cy][cx], py = prevY[cy][cx];
        cx = px;
        cy = py;
      }
      for (int i = 0; i < pathLen / 2; i++) {
        int tx = pathX[i]; pathX[i] = pathX[pathLen - 1 - i]; pathX[pathLen - 1 - i] = tx;
        int ty = pathY[i]; pathY[i] = pathY[pathLen - 1 - i]; pathY[pathLen - 1 - i] = ty;
      }
    }

    for (int r = 0; r < cellsH; r++)
      for (int c = 0; c < cellsW; c++)
        onPath[r][c] = false;
    for (int i = 0; i < pathLen; i++)
      onPath[pathY[i]][pathX[i]] = true;

    // Expand the cell path into actual tile coordinates (cell, connector,
    // cell, connector, ..., cell).
    tileLen = 0;
    for (int i = 0; i < pathLen; i++) {
      tileX[tileLen] = 2 * pathX[i] + 1;
      tileY[tileLen] = 2 * pathY[i] + 1;
      tileLen++;
      if (i < pathLen - 1) {
        int ddx = pathX[i + 1] - pathX[i], ddy = pathY[i + 1] - pathY[i];
        tileX[tileLen] = 2 * pathX[i] + 1 + ddx;
        tileY[tileLen] = 2 * pathY[i] + 1 + ddy;
        tileLen++;
      }
    }

    sx = tileX[0];
    sy = tileY[0];
    gx = tileX[tileLen - 1];
    gy = tileY[tileLen - 1];
    keyTx = -1;
    keyTy = -1;

    // Mandatory pit crossing(s): connector tile(s) along the path. One at
    // roughly the midpoint always; a second one earlier on, once the
    // difficulty tier calls for it.
    int pitIdx = -1;
    for (int i = tileLen / 2; i < tileLen - 1; i++) {
      if (i % 2 == 1) { pitIdx = i; break; }
    }
    if (pitIdx >= 0) grid[tileY[pitIdx]][tileX[pitIdx]] = T_PIT;

    if (wantSecondPit) {
      int pit2Idx = -1;
      for (int i = tileLen / 5; i < tileLen / 2 - 1; i++) {
        if (i % 2 == 1) { pit2Idx = i; break; }
      }
      if (pit2Idx >= 0 && pit2Idx != pitIdx)
        grid[tileY[pit2Idx]][tileX[pit2Idx]] = T_PIT;
    }

    // Mandatory key + locked door: first path cell with an off-path
    // neighbor connected through a carved wall becomes the key's
    // dead-end detour; the door goes further along the path toward the
    // goal.
    if (wantKeyDoor) {
      int branchPathIdx = -1;
      for (int i = 1; i < pathLen - 1 && keyTx < 0; i++) {
        int cx = pathX[i], cy = pathY[i];
        for (int d = 0; d < 4; d++) {
          int nx = cx + dx4[d], ny = cy + dy4[d];
          if (nx < 0 || nx >= cellsW || ny < 0 || ny >= cellsH) continue;
          if (onPath[ny][nx]) continue;
          if (grid[2 * cy + 1 + dy4[d]][2 * cx + 1 + dx4[d]] != T_FLOOR) continue;
          keyTx = 2 * nx + 1;
          keyTy = 2 * ny + 1;
          branchPathIdx = i;
          break;
        }
      }

      if (keyTx >= 0) {
        int branchTileIdx = branchPathIdx * 2;
        int doorTileIdx = tileLen - 3;
        if (branchTileIdx + 6 < doorTileIdx) doorTileIdx = branchTileIdx + 6;
        if (doorTileIdx % 2 == 1) doorTileIdx--;
        if (doorTileIdx > branchTileIdx &&
            !(tileX[doorTileIdx] == gx && tileY[doorTileIdx] == gy)) {
          grid[tileY[doorTileIdx]][tileX[doorTileIdx]] = T_DOOR_LOCKED;
        } else {
          keyTx = -1; // maze too small for a meaningful detour -- skip it
        }
      }
    }

    solved = checkMazeSolvable(W, H, sx, sy, gx, gy, keyTx, keyTy);
  }

  // Flavor: untouched path tiles become ice or mud -- denser at higher
  // difficulty tiers.
  if (flavorStep > 0) {
    for (int i = 2; i < tileLen - 2; i += flavorStep) {
      int x = tileX[i], y = tileY[i];
      if (grid[y][x] == T_FLOOR)
        grid[y][x] = (i % (flavorStep * 2) < flavorStep) ? T_ICE : T_MUD;
    }
  }

  if (keyTx >= 0) grid[keyTy][keyTx] = T_KEY;
  grid[sy][sx] = T_FLOOR;
  grid[gy][gx] = T_GOAL;

  curW = W;
  curH = H;
  playerX = tileCenterX(sx);
  playerY = tileCenterY(sy);
  goalRow = gy;
  goalCol = gx;
  keyRow = (keyTx >= 0) ? keyTy : -1;
  keyCol = (keyTx >= 0) ? keyTx : -1;

  for (int i = 0; i < MAX_BOXES; i++)
    boxes[i].active = false;
  numEmitters = 0;
  teleportARow = teleportACol = teleportBRow = teleportBCol = -1;

  lastGenAttempts = attemptsUsed;

  resetLevelRuntimeState();
}

// -1 for a hand-authored level, else the difficulty tier a generated
// level number falls into (see generateMazeLevel).
static int levelTier(int idx) {
  if (idx < NUM_HAND_LEVELS) return -1;
  int tier = (idx - NUM_HAND_LEVELS) / DIFFICULTY_TIER_SPAN;
  return (tier > DIFFICULTY_MAX_TIER) ? DIFFICULTY_MAX_TIER : tier;
}

// Jumps to a different random level number within the SAME difficulty
// tier as `idx` -- a "reroll" that keeps difficulty fixed but gives you a
// different maze layout, since each level number is itself deterministic.
static uint32_t s_rerollCounter = 0;

static int rerollWithinTier(int idx) {
  int tier = levelTier(idx);
  if (tier < 0) return idx; // tutorials aren't generated, nothing to reroll

  int tierStart = NUM_HAND_LEVELS + tier * DIFFICULTY_TIER_SPAN;
  int tierEnd = (tier == DIFFICULTY_MAX_TIER) ? NUM_LEVELS
                                               : tierStart + DIFFICULTY_TIER_SPAN;
  int span = tierEnd - tierStart;
  if (span < 1) span = 1;

  s_rerollCounter++;
  uint32_t r = (uint32_t)millis() * 2654435761u + s_rerollCounter * 40503u;
  int pick = tierStart + (int)(r % (uint32_t)span);
  if (pick == idx) pick = tierStart + (pick + 1 - tierStart) % span; // avoid a no-op reroll
  return pick;
}

static void loadLevel(int idx) {
  if (idx < NUM_HAND_LEVELS && (idx < PORTAL_BUILTIN_KEEP || portalPackLoad(idx))) {
    if (idx < PORTAL_BUILTIN_KEEP) loadHandLevel(idx);
    lastLevelWasGenerated = false;
  } else {
    unsigned long t0 = micros();
    // Pack missing/bad record for a hand-made slot: a deterministic generated maze seeded by the
    // slot (genIndex 0,3,6.. => tier 0-1, so later slots are a little harder). Same n => same maze.
    generateMazeLevel(idx < NUM_HAND_LEVELS ? (idx - PORTAL_BUILTIN_KEEP) * 3 : idx - NUM_HAND_LEVELS);
    lastGenMicros = micros() - t0;
    lastLevelWasGenerated = true;
    Serial.print("Generated level ");
    Serial.print(idx + 1);
    Serial.print(": ");
    Serial.print(curW);
    Serial.print("x");
    Serial.print(curH);
    Serial.print(" tiles, ");
    Serial.print(lastGenAttempts);
    Serial.print(" attempt(s), ");
    Serial.print(lastGenMicros);
    Serial.println(" us");
  }
}

// A door is open for as long as the player or an active box sits on any
// pressure plate. Recomputed from current positions -- nothing "sticks"
// except by literally parking a box there.
static void updateDoorsState() {
  bool open = (grid[tileRowAt(playerY)][tileColAt(playerX)] == T_PLATE);
  if (!open) {
    for (int i = 0; i < MAX_BOXES; i++) {
      if (boxes[i].active &&
          grid[tileRowAt(boxes[i].y)][tileColAt(boxes[i].x)] == T_PLATE) {
        open = true;
        break;
      }
    }
  }
  doorsOpen = open;
}

// --- Laser hazard ------------------------------------------------------

static bool isBeamBlocker(uint8_t t) {
  return t == T_WALL || t == T_WALL_NOPORTAL || t == T_EMITTER ||
         t == T_DOOR_LOCKED || (t == T_DOOR && !doorsOpen);
}

// Traces every emitter's beam into a flat list of lit cells, stopping each
// one at whatever blocks it (wall/door/box).
#define MAX_LIT_CELLS (MAX_EMITTERS * (MAX_GRID_ROWS + MAX_GRID_COLS))
static int8_t litCellRow[MAX_LIT_CELLS];
static int8_t litCellCol[MAX_LIT_CELLS];
static int litCellCount;

static void computeLitCells() {
  litCellCount = 0;
  for (int e = 0; e < numEmitters; e++) {
    int r = emitters[e].row, c = emitters[e].col;
    for (;;) {
      r += emitters[e].dy;
      c += emitters[e].dx;
      if (r < 0 || r >= curH || c < 0 || c >= curW)
        break;
      uint8_t t = grid[r][c];
      if (isBeamBlocker(t) || boxAt(r, c) >= 0)
        break;
      if (litCellCount < MAX_LIT_CELLS) {
        litCellRow[litCellCount] = r;
        litCellCol[litCellCount] = c;
        litCellCount++;
      }
    }
  }
}

static bool checkLaserDeath() {
  computeLitCells();
  const float hitHalf = TILE_SIZE / 2.0f - 2.0f;
  for (int i = 0; i < litCellCount; i++) {
    float cx = tileCenterX(litCellCol[i]);
    float cy = tileCenterY(litCellRow[i]);
    if (fabsf(playerX - cx) < (PLAYER_HALF + hitHalf) &&
        fabsf(playerY - cy) < (PLAYER_HALF + hitHalf))
      return true;
  }
  return false;
}

// --- Movement (continuous, pixel-based) -------------------------------
//
// Everything below moves in real pixels rather than jumping tile to tile.
// Static level geometry (walls/pits/doors/emitters) is still checked
// against the tile grid (sampling the mover's 4 corners); boxes and the
// player collide with each other via simple AABB overlap.

static bool isConveyor(uint8_t t) {
  return t == T_CONVEYOR_UP || t == T_CONVEYOR_DOWN ||
         t == T_CONVEYOR_LEFT || t == T_CONVEYOR_RIGHT;
}

static void conveyorDelta(uint8_t t, int8_t* dx, int8_t* dy) {
  switch (t) {
    case T_CONVEYOR_UP: *dx = 0; *dy = -1; break;
    case T_CONVEYOR_DOWN: *dx = 0; *dy = 1; break;
    case T_CONVEYOR_LEFT: *dx = -1; *dy = 0; break;
    case T_CONVEYOR_RIGHT: *dx = 1; *dy = 0; break;
    default: *dx = 0; *dy = 0; break;
  }
}

// Whether a tile's static geometry blocks a mover. Locked doors let the
// player through if they're holding the key, but never let a box through.
static bool tileBlocksMover(uint8_t t, bool isBox) {
  if (t == T_WALL || t == T_WALL_NOPORTAL || t == T_PIT || t == T_EMITTER)
    return true;
  if (t == T_DOOR && !doorsOpen)
    return true;
  if (t == T_DOOR_LOCKED)
    return isBox || !hasKey;
  return false;
}

static bool staticBlockedAt(float x, float y, float half, bool isBox) {
  int r0 = tileRowAt(y - half), r1 = tileRowAt(y + half);
  int c0 = tileColAt(x - half), c1 = tileColAt(x + half);
  for (int r = r0; r <= r1; r++) {
    for (int c = c0; c <= c1; c++) {
      if (tileBlocksMover(grid[r][c], isBox))
        return true;
    }
  }
  return false;
}

// Moves (x,y) by `delta` along one axis in small steps, stopping as soon
// as it would overlap a static blocker or another box. Returns true if it
// covered the whole distance.
static bool moveAxisSimple(float& x, float& y, float delta, bool isX,
                            float half, bool isBox, int selfBoxIdx) {
  if (delta == 0)
    return true;
  float dir = delta > 0 ? 1.0f : -1.0f;
  float remaining = fabsf(delta);
  const float STEP = 1.0f;
  while (remaining > 0.0001f) {
    float moveAmt = fminf(STEP, remaining);
    float nx = isX ? x + dir * moveAmt : x;
    float ny = isX ? y : y + dir * moveAmt;
    if (staticBlockedAt(nx, ny, half, isBox))
      break;
    if (boxOverlapping(nx, ny, half, selfBoxIdx) >= 0)
      break;
    x = nx;
    y = ny;
    remaining -= moveAmt;
  }
  return remaining <= 0.0001f;
}

static void applyBoxTileEffects(int bi) {
  if (!boxes[bi].active)
    return;
  int r = tileRowAt(boxes[bi].y), c = tileColAt(boxes[bi].x);
  uint8_t t = grid[r][c];
  if (t == T_PIT) {
    grid[r][c] = T_FLOOR; // box fills the pit and is consumed
    boxes[bi].active = false;
    sfxPush();
  } else if (t == T_PORTAL_BLUE && portalOrangeRow >= 0 &&
             boxAt(portalOrangeRow, portalOrangeCol) < 0) {
    boxes[bi].x = tileCenterX(portalOrangeCol);
    boxes[bi].y = tileCenterY(portalOrangeRow);
  } else if (t == T_PORTAL_ORANGE && portalBlueRow >= 0 &&
             boxAt(portalBlueRow, portalBlueCol) < 0) {
    boxes[bi].x = tileCenterX(portalBlueCol);
    boxes[bi].y = tileCenterY(portalBlueRow);
  } else if (t == T_TELEPORT_A && teleportBRow >= 0 &&
             boxAt(teleportBRow, teleportBCol) < 0) {
    boxes[bi].x = tileCenterX(teleportBCol);
    boxes[bi].y = tileCenterY(teleportBRow);
  } else if (t == T_TELEPORT_B && teleportARow >= 0 &&
             boxAt(teleportARow, teleportACol) < 0) {
    boxes[bi].x = tileCenterX(teleportACol);
    boxes[bi].y = tileCenterY(teleportARow);
  }
}

// If a box sits where the player is about to move into on this axis, push
// it by the same delta (resolved against walls/other boxes) before the
// player's own movement is resolved, so the player follows right behind
// it instead of clipping through.
static void resolvePlayerPushAxis(float delta, bool isX) {
  if (delta == 0)
    return;
  float nx = isX ? playerX + delta : playerX;
  float ny = isX ? playerY : playerY + delta;
  int bi = boxOverlapping(nx, ny, PLAYER_HALF);
  if (bi < 0)
    return;
  float before = isX ? boxes[bi].x : boxes[bi].y;
  moveAxisSimple(boxes[bi].x, boxes[bi].y, delta, isX, BOX_HALF, true, bi);
  float after = isX ? boxes[bi].x : boxes[bi].y;
  if (fabsf(after - before) > 0.01f)
    sfxPush();
  applyBoxTileEffects(bi);
}

// Portals render flush against the wall they were fired at (see
// PORTAL_WALL_NUDGE in draw3DScene), not centered on their floor tile --
// so the trigger needs to match that same offset position, or you'd
// teleport just by stepping anywhere onto the tile, well before you
// visually reach the portal itself.
#define PORTAL_TRIGGER_RADIUS (TILE_SIZE * 0.55f)

static bool playerNearPortalDecal(int8_t row, int8_t col, int8_t faceDX,
                                   int8_t faceDY) {
  float px = (col + 0.5f + faceDX * 0.47f) * TILE_SIZE;
  float py = (row + 0.5f + faceDY * 0.47f) * TILE_SIZE;
  float dx = playerX - px, dy = playerY - py;
  return (dx * dx + dy * dy) <= (PORTAL_TRIGGER_RADIUS * PORTAL_TRIGGER_RADIUS);
}

static void applyPlayerTileEffects() {
  int r = tileRowAt(playerY), c = tileColAt(playerX);
  uint8_t t = grid[r][c];

  if (t == T_GOAL) {
    if (!levelWon) {
      levelWon = true;
      sfxWin();
      pixelsWinCelebration();
    }
  } else if (t == T_KEY) {
    hasKey = true;
    grid[r][c] = T_FLOOR;
    sfx(700, 40);
  } else if (t == T_DOOR_LOCKED) {
    if (hasKey) {
      hasKey = false;
      grid[r][c] = T_FLOOR;
      sfx(400, 40);
    }
  } else if (t == T_PORTAL_BLUE && portalOrangeRow >= 0 &&
             millis() >= s_portalCooldownUntilMs &&
             playerNearPortalDecal(r, c, portalBlueFaceDX, portalBlueFaceDY)) {
    playerX = tileCenterX(portalOrangeCol);
    playerY = tileCenterY(portalOrangeRow);
    // Nudge out along the facing direction so we don't immediately land
    // back on this same portal tile and re-trigger it next frame.
    moveAxisSimple(playerX, playerY, facingDX * (PLAYER_HALF + 3), true,
                   PLAYER_HALF, false, -1);
    moveAxisSimple(playerX, playerY, facingDY * (PLAYER_HALF + 3), false,
                   PLAYER_HALF, false, -1);
    s_portalCooldownUntilMs = millis() + PORTAL_COOLDOWN_MS;
    sfxPortalOrange();
    pixelsFlash(255, 100, 0, 40);
  } else if (t == T_PORTAL_ORANGE && portalBlueRow >= 0 &&
             millis() >= s_portalCooldownUntilMs &&
             playerNearPortalDecal(r, c, portalOrangeFaceDX, portalOrangeFaceDY)) {
    playerX = tileCenterX(portalBlueCol);
    playerY = tileCenterY(portalBlueRow);
    moveAxisSimple(playerX, playerY, facingDX * (PLAYER_HALF + 3), true,
                   PLAYER_HALF, false, -1);
    moveAxisSimple(playerX, playerY, facingDY * (PLAYER_HALF + 3), false,
                   PLAYER_HALF, false, -1);
    s_portalCooldownUntilMs = millis() + PORTAL_COOLDOWN_MS;
    sfxPortalBlue();
    pixelsFlash(0, 90, 255, 40);
  } else if (t == T_TELEPORT_A && teleportBRow >= 0) {
    playerX = tileCenterX(teleportBCol);
    playerY = tileCenterY(teleportBRow);
    moveAxisSimple(playerX, playerY, facingDX * (PLAYER_HALF + 3), true,
                   PLAYER_HALF, false, -1);
    moveAxisSimple(playerX, playerY, facingDY * (PLAYER_HALF + 3), false,
                   PLAYER_HALF, false, -1);
    sfx(600, 50);
    pixelsFlash(180, 0, 255, 40);
  } else if (t == T_TELEPORT_B && teleportARow >= 0) {
    playerX = tileCenterX(teleportACol);
    playerY = tileCenterY(teleportARow);
    moveAxisSimple(playerX, playerY, facingDX * (PLAYER_HALF + 3), true,
                   PLAYER_HALF, false, -1);
    moveAxisSimple(playerX, playerY, facingDY * (PLAYER_HALF + 3), false,
                   PLAYER_HALF, false, -1);
    sfx(600, 50);
    pixelsFlash(0, 255, 220, 40);
  }
}

static float speedMultiplierFor(uint8_t t) {
  if (t == T_BOOST) return 1.8f;
  if (t == T_MUD) return 0.45f;
  return 1.0f;
}

// Called every frame with how many held directions there are, so the HUD
// move counter still means something (counts "steps" of travel).
static float s_distanceAccum = 0;

static void updatePlayer(float dt, float inputX, float inputY) {
  if (levelWon)
    return;

  updateDoorsState();

  uint8_t curTile = grid[tileRowAt(playerY)][tileColAt(playerX)];
  float vx, vy;

  if (curTile == T_ICE) {
    // Frictionless: keep whatever velocity we already had unless we're
    // currently stopped, in which case fresh input can get us moving.
    vx = playerVX;
    vy = playerVY;
    if (fabsf(vx) < 0.5f && fabsf(vy) < 0.5f) {
      vx = inputX;
      vy = inputY;
    }
  } else if (isConveyor(curTile)) {
    int8_t cdx, cdy;
    conveyorDelta(curTile, &cdx, &cdy);
    vx = cdx * MOVE_SPEED;
    vy = cdy * MOVE_SPEED;
  } else {
    vx = inputX;
    vy = inputY;
  }

  float speedMul = speedMultiplierFor(curTile);
  vx *= speedMul;
  vy *= speedMul;

  if (fabsf(vx) > 1.0f || fabsf(vy) > 1.0f) {
    facingDX = (vx > 1.0f) - (vx < -1.0f);
    facingDY = (vy > 1.0f) - (vy < -1.0f);
  }

  playerVX = vx;
  playerVY = vy;

  float dx = vx * dt, dy = vy * dt;

  resolvePlayerPushAxis(dx, true);
  bool movedX = moveAxisSimple(playerX, playerY, dx, true, PLAYER_HALF, false, -1);

  resolvePlayerPushAxis(dy, false);
  bool movedY = moveAxisSimple(playerX, playerY, dy, false, PLAYER_HALF, false, -1);

  // If we got fully blocked on an axis (e.g. sliding into a wall on ice),
  // kill that axis's stored velocity -- otherwise ice would lock us
  // against the wall forever, since input is ignored while already moving.
  if (!movedX) playerVX = 0;
  if (!movedY) playerVY = 0;
  // On ice, hitting a wall stops you dead (both axes) so you can steer again.
  if (curTile == T_ICE && (!movedX || !movedY)) playerVX = playerVY = 0;

  s_distanceAccum += fabsf(dx) + fabsf(dy);
  while (s_distanceAccum >= TILE_SIZE) {
    s_distanceAccum -= TILE_SIZE;
    moveCount++;
    sfxMove(); // soft footstep tick, once per tile of distance covered
  }

  applyPlayerTileEffects();

  if (!levelWon && checkLaserDeath()) {
    sfxDeath();
    pixelsFlash(255, 0, 0, 80);
    pixelsFlash(0, 0, 0, 60);
    pixelsFlash(255, 0, 0, 80);
    if (gameState == ST_QUEST_PLAYING) questOnDeath();
    else loadLevel(currentLevel);
  }
}

// --- Shooting portals ------------------------------------------------------
//
// Fires a ray from the player in the facing direction. Pits and open
// doors don't block the ray, but only floor/ice/plate/portal tiles (and
// only when nothing's standing on them) are valid places to stick a
// portal. Boxes, closed doors, emitters and normal walls block the ray;
// a portal-proof wall blocks it AND cancels the whole shot.

static bool isPortalTargetTile(uint8_t t) {
  return t == T_FLOOR || t == T_ICE || t == T_PLATE || t == T_KEY ||
         t == T_BOOST || t == T_MUD || t == T_TELEPORT_A ||
         t == T_TELEPORT_B || t == T_PORTAL_BLUE || t == T_PORTAL_ORANGE ||
         isConveyor(t);
}

static void clearPortal(bool blue) {
  if (blue && portalBlueRow >= 0) {
    if (grid[portalBlueRow][portalBlueCol] == T_PORTAL_BLUE)
      grid[portalBlueRow][portalBlueCol] = T_FLOOR;
    portalBlueRow = portalBlueCol = -1;
  } else if (!blue && portalOrangeRow >= 0) {
    if (grid[portalOrangeRow][portalOrangeCol] == T_PORTAL_ORANGE)
      grid[portalOrangeRow][portalOrangeCol] = T_FLOOR;
    portalOrangeRow = portalOrangeCol = -1;
  }
}

static void shootPortal(bool blue) {
  if (levelWon)
    return;
  if (facingDX == 0 && facingDY == 0)
    return;

  updateDoorsState();

  int lastR = -1, lastC = -1;
  int originRow = tileRowAt(playerY), originCol = tileColAt(playerX);

  for (int i = 1; i < curH + curW; i++) {
    int r = originRow + facingDY * i;
    int c = originCol + facingDX * i;

    if (r < 0 || r >= curH || c < 0 || c >= curW)
      break;

    uint8_t t = grid[r][c];

    if (t == T_WALL_NOPORTAL) {
      lastR = lastC = -1; // this shot is cancelled outright
      break;
    }
    if (t == T_WALL || t == T_EMITTER || t == T_DOOR_LOCKED ||
        (t == T_DOOR && !doorsOpen) ||
        boxAt(r, c) >= 0)
      break;

    if (isPortalTargetTile(t) && boxAt(r, c) < 0) {
      lastR = r;
      lastC = c;
    }
    // T_PIT, T_GOAL, an open T_DOOR: pass through without blocking sight,
    // but don't count as a placement spot.
  }

  if (lastR < 0) {
    sfxBlocked();
    return;
  }

  if (blue && lastR == portalOrangeRow && lastC == portalOrangeCol)
    return;
  if (!blue && lastR == portalBlueRow && lastC == portalBlueCol)
    return;

  clearPortal(blue);

  if (blue) {
    portalBlueRow = lastR;
    portalBlueCol = lastC;
    portalBlueFaceDX = facingDX;
    portalBlueFaceDY = facingDY;
    grid[lastR][lastC] = T_PORTAL_BLUE;
    sfxPortalBlue();
    pixelsFlash(0, 90, 255, 60);
  } else {
    portalOrangeRow = lastR;
    portalOrangeCol = lastC;
    portalOrangeFaceDX = facingDX;
    portalOrangeFaceDY = facingDY;
    grid[lastR][lastC] = T_PORTAL_ORANGE;
    sfxPortalOrange();
    pixelsFlash(255, 100, 0, 60);
  }
}

// --- Rendering -----------------------------------------------------------

// Camera: top-left of the viewport follows the player, clamped so we
// never scroll past the level edge. On a level that fits within the
// viewport on some axis, max is 0 and that axis just never moves.
// --- First-person raycaster ----------------------------------------------
//
// Classic DDA (digital differential analysis) grid raycaster, one column
// per screen pixel -- the same technique Wolfenstein 3D used. Floor-level
// features (portals, goal, key, boxes, lasers) aren't walls, so a
// raycaster can't show them as wall strips; they're drawn afterward as
// camera-facing billboard sprites, depth-tested against the per-column
// wall distance (zbuffer) so they correctly hide behind nearer walls.
//
// Not hardware-validated: FOV, wall height scaling and sprite sizing are
// a first pass and will likely want tuning once seen on the real screen.

#define VIEW3D_W (VIEW_COLS * TILE_SIZE)  // 160
#define VIEW3D_H (VIEW_ROWS * TILE_SIZE)  // 112, below the HUD strip
static float s_zbuffer[VIEW3D_W];

// The screen row every wall/floor/sprite projection treats as "straight
// ahead" -- normally the exact vertical center. In 3rd person this gets
// nudged up a bit (see draw3DScene) to approximate a camera that's been
// raised above the player's own eye height, without having to rework
// every projection formula into a true variable-height camera model: for
// a fixed pitch, shifting this one shared value shifts everything that
// reads it consistently.
static float s_horizon = VIEW3D_H / 2.0f;
#define THIRD_PERSON_RAISE_PX 32.0f

static bool isWallForRender(uint8_t t) {
  if (t == T_WALL || t == T_WALL_NOPORTAL || t == T_EMITTER) return true;
  if (t == T_DOOR && !doorsOpen) return true;
  if (t == T_DOOR_LOCKED) return true;
  return false;
}

static uint16_t shadeColor(uint16_t c, float factor) {
  if (factor < 0) factor = 0;
  if (factor > 1) factor = 1;
  uint8_t r = (c >> 11) & 0x1F, g = (c >> 5) & 0x3F, b = c & 0x1F;
  r = (uint8_t)(r * factor);
  g = (uint8_t)(g * factor);
  b = (uint8_t)(b * factor);
  return (r << 11) | (g << 5) | b;
}

// Blends c toward white by amt (0..1) -- shadeColor can only darken, this
// is the complement, used for the box's top cap so it reads as a bright
// highlight (a strong, unmissable cue) rather than a subtle tint.
static uint16_t lightenColor(uint16_t c, float amt) {
  if (amt < 0) amt = 0;
  if (amt > 1) amt = 1;
  uint8_t r = (c >> 11) & 0x1F, g = (c >> 5) & 0x3F, b = c & 0x1F;
  r = (uint8_t)(r + (31 - r) * amt);
  g = (uint8_t)(g + (63 - g) * amt);
  b = (uint8_t)(b + (31 - b) * amt);
  return (r << 11) | (g << 5) | b;
}

static uint16_t wallBaseColor(uint8_t t) {
  switch (t) {
    case T_WALL_NOPORTAL: return COL_WALL_NOPORTAL;
    case T_EMITTER: return COL_EMITTER;
    case T_DOOR: return COL_DOOR_CLOSED;
    case T_DOOR_LOCKED: return COL_DOOR_CLOSED;
    default: return COL_WALL;
  }
}

// Wall/sprite textures: 16x16 1-bit bitmaps (one uint16_t per row, bit x =
// column x), baked from the same shape logic that used to be evaluated
// live per pixel -- see gen_textures.js in the sketch folder, which
// prints these arrays so the visuals are guaranteed to match what was
// already designed and reasoned through, just stored instead of
// recomputed. A lookup + bit test is also cheaper per pixel than the
// original formulas (a couple had a multiply and modulo apiece).
#define TEX_SIZE 16

static const uint16_t TEX_WALL_BRICK[TEX_SIZE] = {0x0000, 0xfefe, 0xfefe, 0xfefe, 0x0000, 0xfefe, 0xfefe, 0xfefe, 0x0000, 0xfefe, 0xfefe, 0xfefe, 0x0000, 0xfefe, 0xfefe, 0xfefe};
static const uint16_t TEX_WALL_HAZARD[TEX_SIZE] = {0x71c7, 0x38e3, 0x1c71, 0x8e38, 0xc71c, 0xe38e, 0x71c7, 0x38e3, 0x1c71, 0x8e38, 0xc71c, 0xe38e, 0x71c7, 0x38e3, 0x1c71, 0x8e38};
static const uint16_t TEX_WALL_DOOR[TEX_SIZE] = {0xffff, 0xfbdf, 0xfbdf, 0xfbdf, 0xfbdf, 0x8001, 0xfbdf, 0xfbdf, 0xfbdf, 0xfbdf, 0x8001, 0xfbdf, 0xfbdf, 0xfbdf, 0xfbdf, 0xffff};
static const uint16_t TEX_WALL_EMITTER[TEX_SIZE] = {0x0000, 0x07c0, 0x1ff0, 0x3838, 0x701c, 0x610c, 0xc7c6, 0xc7c6, 0xcfe6, 0xc7c6, 0xc7c6, 0x610c, 0x701c, 0x3838, 0x1ff0, 0x07c0};
// Roof/ceiling panel grid -- unstaggered mortar lines every 4px (a drop
// ceiling look) so the ceiling reads as an actual surface instead of an
// empty void, distinct from the brick wall pattern's staggered rows.
static const uint16_t TEX_CEIL_PANEL[TEX_SIZE] = {0x0000, 0xeeee, 0xeeee, 0xeeee, 0x0000, 0xeeee, 0xeeee, 0xeeee, 0x0000, 0xeeee, 0xeeee, 0xeeee, 0x0000, 0xeeee, 0xeeee, 0xeeee};

static bool bitmapLit(const uint16_t* bmp, int tx, int ty) {
  return (bmp[ty] >> tx) & 1;
}

static bool texturePixelLit(uint8_t t, int tx, int ty) {
  switch (t) {
    case T_WALL_NOPORTAL: return bitmapLit(TEX_WALL_HAZARD, tx, ty);
    case T_EMITTER: return bitmapLit(TEX_WALL_EMITTER, tx, ty);
    case T_DOOR:
    case T_DOOR_LOCKED: return bitmapLit(TEX_WALL_DOOR, tx, ty);
    default: return bitmapLit(TEX_WALL_BRICK, tx, ty);
  }
}

// Casts one column's ray via DDA, filling in the wall slice and the
// per-column depth buffer used later for sprite occlusion.
// Quest region theme tint: per-channel multipliers (/16) applied to wall, floor
// and ceiling colours while playing Quest. Index 0 (Town) = unchanged.
static uint8_t qCurTheme();
static const uint8_t kThemeMul[8][3] = {
  {16,16,16}, // Town
  { 6,12,16}, // Ice
  {16,10, 5}, // Factory
  {16,13, 6}, // Temple
  { 7,14, 8}, // Maze
  { 9,11, 5}, // Swamp
  {12, 6,16}, // Vault
  { 8, 5, 3}, // Caves
};
static uint16_t themeTint(uint16_t c, uint8_t th) {
  if (!th) return c;
  const uint8_t* m = kThemeMul[th & 7];
  uint16_t r = ((c >> 11) & 31) * m[0] >> 4;
  uint16_t g = ((c >> 5) & 63) * m[1] >> 4;
  uint16_t b = (c & 31) * m[2] >> 4;
  return (r << 11) | (g << 5) | b;
}

static void castColumn(int x, float posX, float posY, float dirX, float dirY,
                        float planeX, float planeY) {
  float cameraX = 2.0f * x / (float)VIEW3D_W - 1.0f;
  float rayDirX = dirX + planeX * cameraX;
  float rayDirY = dirY + planeY * cameraX;

  int mapX = (int)posX, mapY = (int)posY;
  float deltaDistX = (rayDirX == 0) ? 1e30f : fabsf(1.0f / rayDirX);
  float deltaDistY = (rayDirY == 0) ? 1e30f : fabsf(1.0f / rayDirY);

  int stepX, stepY;
  float sideDistX, sideDistY;
  if (rayDirX < 0) { stepX = -1; sideDistX = (posX - mapX) * deltaDistX; }
  else { stepX = 1; sideDistX = (mapX + 1.0f - posX) * deltaDistX; }
  if (rayDirY < 0) { stepY = -1; sideDistY = (posY - mapY) * deltaDistY; }
  else { stepY = 1; sideDistY = (mapY + 1.0f - posY) * deltaDistY; }

  int side = 0;
  uint8_t hitTile = T_WALL;
  for (int steps = 0; steps < 48; steps++) {
    if (sideDistX < sideDistY) { sideDistX += deltaDistX; mapX += stepX; side = 0; }
    else { sideDistY += deltaDistY; mapY += stepY; side = 1; }
    if (mapX < 0 || mapX >= curW || mapY < 0 || mapY >= curH) break;
    uint8_t t = grid[mapY][mapX];
    if (isWallForRender(t)) { hitTile = t; goto hit; }
  }
  // ran off the edge of the level: a wall, except in Quest where the edge is a visible doorway
  hitTile = (gameState == ST_QUEST_PLAYING) ? T_DOOR : T_WALL;
hit:

  float perpDist = (side == 0) ? (mapX - posX + (1 - stepX) / 2.0f) / rayDirX
                                : (mapY - posY + (1 - stepY) / 2.0f) / rayDirY;
  if (perpDist < 0.05f) perpDist = 0.05f;
  s_zbuffer[x] = perpDist;

  int lineHeight = (int)(VIEW3D_H / perpDist);
  int drawStart = (int)s_horizon - lineHeight / 2;
  int drawEnd = drawStart + lineHeight;
  int clipStart = (drawStart < 0) ? 0 : drawStart;
  int clipEnd = (drawEnd > VIEW3D_H) ? VIEW3D_H : drawEnd;
  if (clipEnd <= clipStart) return;

  // Where exactly along the wall face we hit, 0..1 -- the texture's U
  // coordinate. The two flips below are the standard fix for the texture
  // otherwise appearing mirrored depending on which side of the tile
  // you're facing.
  float wallHit = (side == 0) ? (posY + perpDist * rayDirY) : (posX + perpDist * rayDirX);
  wallHit -= floorf(wallHit);
  int texX = (int)(wallHit * TEX_SIZE);
  if (side == 0 && rayDirX > 0) texX = TEX_SIZE - texX - 1;
  if (side == 1 && rayDirY < 0) texX = TEX_SIZE - texX - 1;
  if (texX < 0) texX = 0;
  if (texX >= TEX_SIZE) texX = TEX_SIZE - 1;

  float distShade = 1.0f - fminf(perpDist / 9.0f, 0.65f);
  float shade = distShade * (side == 1 ? 0.72f : 1.0f);
  uint16_t base = themeTint(wallBaseColor(hitTile), qCurTheme());
  uint16_t litColor = shadeColor(base, shade);
  uint16_t darkColor = shadeColor(base, shade * 0.55f);

  // Step through the texture's V axis as we walk down the column -- this
  // is what makes the pattern scale correctly with distance instead of
  // stretching a single row.
  float texStep = (float)TEX_SIZE / lineHeight;
  float texPos = (clipStart - drawStart) * texStep;

  canvas->startWrite();
  for (int y = clipStart; y < clipEnd; y++) {
    int texY = ((int)texPos) & (TEX_SIZE - 1);
    texPos += texStep;
    bool lit = texturePixelLit(hitTile, texX, texY);
    canvas->writePixel(x, HUD_HEIGHT + y, lit ? litColor : darkColor);
  }
  canvas->endWrite();
}

// Sprite bitmaps -- same deal as the wall textures above: baked from the
// original shape logic via gen_textures.js rather than evaluated live.
enum SpriteKind : uint8_t {
  SPR_CRATE,   // boxes: a bordered face with X cross-bracing
  SPR_RING,    // portals/teleporters: a glowing ring
  SPR_DIAMOND, // goal: a diamond beacon
  SPR_KEY,     // key: a round head + notched shaft
  SPR_BOLT,    // laser hazard cells: a jagged bolt
  SPR_CHECK,   // floor hazards (pit/ice/mud/boost/conveyor): checkerboard
  SPR_PLATE,   // pressure plates: a cross-hatched panel
};

static const uint16_t TEX_SPR_CRATE[TEX_SIZE] = {0x0000, 0x1ff8, 0x0ff0, 0x47e2, 0x63c6, 0x718e, 0x781e, 0x7c3e, 0x7c3e, 0x781e, 0x718e, 0x63c6, 0x47e2, 0x0ff0, 0x1ff8, 0x0000};
static const uint16_t TEX_SPR_RING[TEX_SIZE] = {0x0000, 0x0100, 0x0fe0, 0x1830, 0x27c8, 0x6fec, 0x5ff4, 0x5ff4, 0xdff6, 0x5ff4, 0x5ff4, 0x6fec, 0x27c8, 0x1830, 0x0fe0, 0x0100};
