static void chsThinkFrame();           // draws one animated frame between the CPU's search iterations
static int chsSq88(int s) { return ((s >> 3) << 4) | (s & 7); }

// Is 0x88 square sq attacked by colour `by`?
static bool chsAttacked(int sq, int by) {
  int pc = by << 3, a;
  if (by == 0) {
    a = sq - 15; if (!(a & 0x88) && chsB[a] == 1) return true;
    a = sq - 17; if (!(a & 0x88) && chsB[a] == 1) return true;
  } else {
    a = sq + 15; if (!(a & 0x88) && chsB[a] == 9) return true;
    a = sq + 17; if (!(a & 0x88) && chsB[a] == 9) return true;
  }
  for (int k = 0; k < 8; k++) { a = sq + kChsKnightD[k]; if (!(a & 0x88) && chsB[a] == (pc | 2)) return true; }
  for (int k = 0; k < 8; k++) { a = sq + kChsKingD[k]; if (!(a & 0x88) && chsB[a] == (pc | 6)) return true; }
  for (int k = 0; k < 4; k++) {
    int d = kChsKingD[k];
    a = sq + d;
    while (!(a & 0x88)) {
      int p = chsB[a];
      if (p) { if (p == (pc | 4) || p == (pc | 5)) return true; break; }
      a += d;
    }
  }
  for (int k = 4; k < 8; k++) {
    int d = kChsKingD[k];
    a = sq + d;
    while (!(a & 0x88)) {
      int p = chsB[a];
      if (p) { if (p == (pc | 3) || p == (pc | 5)) return true; break; }
      a += d;
    }
  }
  return false;
}

static int chsAdd(uint16_t* out, int n, int cap, int from, int to, int fl) {
  if (n >= cap) return n;
  out[n] = (uint16_t)((((from >> 4) << 3) | (from & 7)) | ((((to >> 4) << 3) | (to & 7)) << 6) | (fl << 12));
  return n + 1;
}

// Pseudo-legal moves of the side to move (captures + queen promotions only if capsOnly).
static int chsGen(uint16_t* out, int cap, bool capsOnly) {
  int n = 0, side = chsSide;
  for (int s = 0; s < 120; s++) {
    if (s & 0x88) continue;
    int p = chsB[s];
    if (!p || (p >> 3) != side) continue;
    int t = p & 7;
    if (t == 1) {
      int fwd = side ? -16 : 16, r = s >> 4, promoR = side ? 1 : 6, startR = side ? 6 : 1;
      int to = s + fwd;
      if (!chsB[to]) {
        if (r == promoR) {
          n = chsAdd(out, n, cap, s, to, 11);
          if (!capsOnly && !chsQueenOnly) {
            n = chsAdd(out, n, cap, s, to, 10);
            n = chsAdd(out, n, cap, s, to, 9);
            n = chsAdd(out, n, cap, s, to, 8);
          }
        } else if (!capsOnly) {
          n = chsAdd(out, n, cap, s, to, 0);
          if (r == startR && !chsB[to + fwd]) n = chsAdd(out, n, cap, s, to + fwd, 1);
        }
      }
      for (int k = -1; k <= 1; k += 2) {
        to = s + fwd + k;
        if (to & 0x88) continue;
        int q = chsB[to];
        if (q && (q >> 3) != side) {
          if (r == promoR) {
            n = chsAdd(out, n, cap, s, to, 15);
            if (!chsQueenOnly) {
              n = chsAdd(out, n, cap, s, to, 14);
              n = chsAdd(out, n, cap, s, to, 13);
              n = chsAdd(out, n, cap, s, to, 12);
            }
          } else {
            n = chsAdd(out, n, cap, s, to, 4);
          }
        } else if (!q && to == chsEp) {
          n = chsAdd(out, n, cap, s, to, 5);
        }
      }
    } else if (t == 2 || t == 6) {
      const int8_t* dl = (t == 2) ? kChsKnightD : kChsKingD;
      for (int k = 0; k < 8; k++) {
        int to = s + dl[k];
        if (to & 0x88) continue;
        int q = chsB[to];
        if (!q) { if (!capsOnly) n = chsAdd(out, n, cap, s, to, 0); }
        else if ((q >> 3) != side) n = chsAdd(out, n, cap, s, to, 4);
      }
      if (t == 6 && !capsOnly) {
        if (side == 0 && s == 4) {
          if ((chsCastle & 1) && !chsB[5] && !chsB[6] && chsB[7] == 4 && !chsAttacked(4, 1) && !chsAttacked(5, 1) && !chsAttacked(6, 1))
            n = chsAdd(out, n, cap, 4, 6, 2);
          if ((chsCastle & 2) && !chsB[3] && !chsB[2] && !chsB[1] && chsB[0] == 4 && !chsAttacked(4, 1) && !chsAttacked(3, 1) && !chsAttacked(2, 1))
            n = chsAdd(out, n, cap, 4, 2, 3);
        } else if (side == 1 && s == 116) {
          if ((chsCastle & 4) && !chsB[117] && !chsB[118] && chsB[119] == 12 && !chsAttacked(116, 0) && !chsAttacked(117, 0) && !chsAttacked(118, 0))
            n = chsAdd(out, n, cap, 116, 118, 2);
          if ((chsCastle & 8) && !chsB[115] && !chsB[114] && !chsB[113] && chsB[112] == 12 && !chsAttacked(116, 0) && !chsAttacked(115, 0) && !chsAttacked(114, 0))
            n = chsAdd(out, n, cap, 116, 114, 3);
        }
      }
    } else {
      int d0 = (t == 3) ? 4 : 0, d1 = (t == 4) ? 4 : 8;
      for (int k = d0; k < d1; k++) {
        int d = kChsKingD[k], to = s + d;
        while (!(to & 0x88)) {
          int q = chsB[to];
          if (!q) { if (!capsOnly) n = chsAdd(out, n, cap, s, to, 0); }
          else { if ((q >> 3) != side) n = chsAdd(out, n, cap, s, to, 4); break; }
          to += d;
        }
      }
    }
  }
  return n;
}

static void chsCastleUpd(int sq) {   // a move touched this square: drop the castling rights that depended on it
  if (sq == 4) chsCastle = (uint8_t)(chsCastle & ~3);
  else if (sq == 0) chsCastle = (uint8_t)(chsCastle & ~2);
  else if (sq == 7) chsCastle = (uint8_t)(chsCastle & ~1);
  else if (sq == 116) chsCastle = (uint8_t)(chsCastle & ~12);
  else if (sq == 112) chsCastle = (uint8_t)(chsCastle & ~8);
  else if (sq == 119) chsCastle = (uint8_t)(chsCastle & ~4);
}

// Plays a pseudo-legal move; returns the undo word (captured piece | castle << 8 | ep << 16 | halfmove << 24).
static uint32_t chsMake(uint16_t m) {
  int from = chsSq88(m & 63), to = chsSq88((m >> 6) & 63), fl = m >> 12;
  int p = chsB[from];
  int epSq = to + (chsSide ? 16 : -16);
  int cap = (fl == 5) ? chsB[epSq] : chsB[to];
  uint32_t u = (uint32_t)(cap & 0xFF) | ((uint32_t)chsCastle << 8) | ((uint32_t)(uint8_t)chsEp << 16) | ((uint32_t)chsHalf << 24);
  chsB[to] = (int8_t)p;
  chsB[from] = 0;
  if (fl == 5) chsB[epSq] = 0;
  else if (fl == 2) { chsB[from + 1] = chsB[from + 3]; chsB[from + 3] = 0; }
  else if (fl == 3) { chsB[from - 1] = chsB[from - 4]; chsB[from - 4] = 0; }
  else if (fl & 8) chsB[to] = (int8_t)((chsSide << 3) | (2 + (fl & 3)));
  if ((p & 7) == 6) chsKing[chsSide] = (int8_t)to;
  chsCastleUpd(from);
  chsCastleUpd(to);
  chsEp = (fl == 1) ? (int8_t)((from + to) >> 1) : (int8_t)-1;
  if ((p & 7) == 1 || cap) chsHalf = 0;
  else if (chsHalf < 250) chsHalf++;
  chsSide ^= 1;
  return u;
}

static void chsUnmake(uint16_t m, uint32_t u) {
  chsSide ^= 1;
  int from = chsSq88(m & 63), to = chsSq88((m >> 6) & 63), fl = m >> 12;
  int cap = (int)(u & 0xFF);
  chsCastle = (uint8_t)((u >> 8) & 0xFF);
  chsEp = (int8_t)((u >> 16) & 0xFF);
  chsHalf = (uint8_t)((u >> 24) & 0xFF);
  int p = chsB[to];
  if (fl & 8) p = (chsSide << 3) | 1;   // a promoted piece goes back to being a pawn
  chsB[from] = (int8_t)p;
  if (fl == 5) {
    chsB[to] = 0;
    chsB[to + (chsSide ? 16 : -16)] = (int8_t)cap;
  } else {
    chsB[to] = (int8_t)cap;
    if (fl == 2) { chsB[from + 3] = chsB[from + 1]; chsB[from + 1] = 0; }
    else if (fl == 3) { chsB[from - 4] = chsB[from - 1]; chsB[from - 1] = 0; }
  }
  if ((p & 7) == 6) chsKing[chsSide] = (int8_t)from;
}

static bool chsLegalAfter() {   // after chsMake: did the mover leave his own king safe?
  return !chsAttacked(chsKing[chsSide ^ 1], chsSide);
}
// Legal moves of the side to move (stack use ~450 B + out; never called from inside the search).
static int chsLegal(uint16_t* out, int cap) {
  uint16_t mv[224];
  int g = chsGen(mv, 224, false), n = 0;
  for (int i = 0; i < g; i++) {
    uint32_t u = chsMake(mv[i]);
    bool ok = chsLegalAfter();
    chsUnmake(mv[i], u);
    if (ok && n < cap) out[n++] = mv[i];
  }
  return n;
}

// Static evaluation in centipawns from the side to move's point of view.
static int chsEval() {
  int sc = 0, npm = 0;
  for (int s = 0; s < 120; s++) {
    if (s & 0x88) continue;
    int p = chsB[s];
    if (!p) continue;
    int t = p & 7, v = kChsVal[t];
    if (t >= 2 && t <= 5) npm += kChsVal[t];
    if (t == 6) continue;
    if (chsPst) {
      int s64 = ((s >> 4) << 3) | (s & 7);
      v += kChsPst[t - 1][(p & 8) ? s64 : (s64 ^ 56)];
    }
    sc += (p & 8) ? -v : v;
  }
  if (chsPst) {
    int tbl = (npm <= 3000) ? 6 : 5;
    for (int c = 0; c < 2; c++) {
      int s = chsKing[c], s64 = ((s >> 4) << 3) | (s & 7);
      int v = kChsPst[tbl][c ? s64 : (s64 ^ 56)];
      sc += c ? -v : v;
    }
  }
  return chsSide ? -sc : sc;
}

// Move-ordering scores (MVV-LVA, promotions first).
static void chsScoreMoves(const uint16_t* mv, uint8_t* sc, int n) {
  for (int i = 0; i < n; i++) {
    int fl = mv[i] >> 12, score = 0;
    if (fl & 4) {
      int victim = (fl == 5) ? 1 : (chsB[chsSq88((mv[i] >> 6) & 63)] & 7);
      int attacker = chsB[chsSq88(mv[i] & 63)] & 7;
      score = 16 + victim * 8 + (7 - attacker);
    }
    if (fl & 8) score += 40 + (fl & 3);
    sc[i] = (uint8_t)score;
  }
}
static void chsPickBest(uint16_t* mv, uint8_t* sc, int n, int i) {   // selection step: best remaining move to slot i
  int b = i;
  for (int j = i + 1; j < n; j++) if (sc[j] > sc[b]) b = j;
  if (b != i) {
    uint16_t tm = mv[i]; mv[i] = mv[b]; mv[b] = tm;
    uint8_t ts = sc[i]; sc[i] = sc[b]; sc[b] = ts;
  }
}
static void chsNodeTick() {
  if ((++chsNodes & 63) == 0 && (chsNodes >= chsNodeCap || (long)(millis() - chsDeadline) >= 0)) chsAbort = true;
}

static int chsQuies(int alpha, int beta, int qd) {
  chsNodeTick();
  if (chsAbort) return 0;
  int stand = chsEval();
  if (qd <= 0 || stand >= beta) return stand;
  if (stand > alpha) alpha = stand;
  uint16_t mv[48];
  uint8_t sc[48];
  int n = chsGen(mv, 48, true);
  chsScoreMoves(mv, sc, n);
  for (int i = 0; i < n; i++) {
    chsPickBest(mv, sc, n, i);
    uint32_t u = chsMake(mv[i]);
    if (!chsLegalAfter()) { chsUnmake(mv[i], u); continue; }
    int v = -chsQuies(-beta, -alpha, qd - 1);
    chsUnmake(mv[i], u);
    if (chsAbort) return 0;
    if (v >= beta) return v;
    if (v > alpha) alpha = v;
  }
  return alpha;
}

static int chsSearch(int depth, int ply, int alpha, int beta) {
  if (chsAbort) return 0;
  if (chsHalf >= 100) return 0;
  if (depth <= 0) return chsQui ? chsQuies(alpha, beta, 6) : chsEval();
  chsNodeTick();
  if (chsAbort) return 0;
  uint16_t mv[128];
  uint8_t sc[128];
  int n = chsGen(mv, 128, false);
  chsScoreMoves(mv, sc, n);
  int best = -CHS_INF, legal = 0;
  for (int i = 0; i < n; i++) {
    chsPickBest(mv, sc, n, i);
    uint32_t u = chsMake(mv[i]);
    if (!chsLegalAfter()) { chsUnmake(mv[i], u); continue; }
    legal++;
    int v = -chsSearch(depth - 1, ply + 1, -beta, -alpha);
    chsUnmake(mv[i], u);
    if (chsAbort) return 0;
    if (v > best) best = v;
    if (v > alpha) { alpha = v; if (alpha >= beta) break; }
  }
  if (!legal) return chsAttacked(chsKing[chsSide], chsSide ^ 1) ? -(CHS_MATE - ply) : 0;
  return best;
}

// --- position hash + repetition list ---
static uint32_t chsHash() {
  uint32_t h = 2166136261u;
  for (int s = 0; s < 120; s++) {
    if (s & 0x88) continue;
    if (!chsB[s]) continue;
    h = (h ^ (uint32_t)(uint8_t)chsB[s]) * 16777619u;
    h = (h ^ (uint32_t)s) * 16777619u;
  }
  h = (h ^ (uint32_t)chsSide) * 16777619u;
  h = (h ^ (uint32_t)chsCastle) * 16777619u;
  h = (h ^ (uint32_t)(uint8_t)chsEp) * 16777619u;
  return h;
}
static void chsHistPush(uint32_t h, bool irreversible) {
  if (irreversible) chsHistBase = chsHistN;
  if (chsHistN >= CHS_HIST) {   // window full (only a very long reversible run): slide it down
    if ((int)chsHistN - (int)chsHistBase > CHS_HIST - 2) chsHistBase = (uint8_t)(chsHistN - (CHS_HIST - 2));
    int cnt = (int)chsHistN - (int)chsHistBase;
    memmove(chsHist, chsHist + chsHistBase, (size_t)cnt * sizeof(uint32_t));
    chsHistN = (uint8_t)cnt;
    chsHistBase = 0;
    chsUndoOk = false;
  }
  chsHist[chsHistN++] = h;
}
static int chsRepCount(uint32_t h) {
  int c = 0;
  for (int i = chsHistBase; i < chsHistN; i++) if (chsHist[i] == h) c++;
  return c;
}
static bool chsInsufficient() {
  int minors = 0, knights = 0, bc[2] = {0, 0};
  for (int s = 0; s < 120; s++) {
    if (s & 0x88) continue;
    int t = chsB[s] & 7;
    if (t == 1 || t == 4 || t == 5) return false;
    if (t == 2) { minors++; knights++; }
    if (t == 3) { minors++; bc[((s >> 4) + (s & 7)) & 1]++; }
  }
  if (minors <= 1) return true;
  return knights == 0 && (bc[0] == 0 || bc[1] == 0);   // only bishops, all on one colour
}
static int chsMaterial(int side) {
  int v = 0;
  for (int s = 0; s < 120; s++) {
    if (s & 0x88) continue;
    int p = chsB[s];
    if (p && (p >> 3) == side) v += kChsVal[p & 7];
  }
  return v;
}

// The CPU's move for the side to move (0 if it has none). Never touches the UI state.
static uint16_t chsCpuPickInner(int tier) {
  uint16_t root[224];
  int n = chsLegal(root, 224);
  if (n == 0) return 0;
  if (n == 1) return root[0];
  if (tier == 1) {                       // EASY: usually a capture if there is one, otherwise anything
    if (mazeRngRange(100) < 60) {
      int cands[64], nc = 0;
      for (int i = 0; i < n && nc < 64; i++) if ((root[i] >> 12) & 4) cands[nc++] = i;
      if (nc > 0) return root[cands[mazeRngRange(nc)]];
    }
    return root[mazeRngRange(n)];
  }
  // rotate the root order so equal moves do not always pick the first one
  {
    int off = mazeRngRange(n);
    uint16_t tmp[224];
    memcpy(tmp, root, (size_t)n * sizeof(uint16_t));
    for (int i = 0; i < n; i++) root[i] = tmp[(i + off) % n];
  }
  int maxD = (tier == 0) ? 2 : (tier == 2 ? 3 : 5);
  chsPst = (tier != 0);
  chsQui = (tier == 3);
  chsNodes = 0;
  chsAbort = false;
  chsNodeCap = (tier == 3) ? 12000u : 30000u;
  chsDeadline = millis() + 400UL;
  uint16_t best = 0;
  for (int D = 1; D <= maxD; D++) {
    int dv = -CHS_INF, di = -1;
    uint8_t ties[224];
    int nt = 0;
    for (int i = 0; i < n; i++) {
      uint32_t u = chsMake(root[i]);
      int v;
      if (tier == 0) v = -chsSearch(D - 1, 1, -CHS_INF, CHS_INF);      // exact scores: ties are broken at random
      else v = -chsSearch(D - 1, 1, -CHS_INF, dv == -CHS_INF ? CHS_INF : -dv);
      if (!chsAbort && tier >= 2 && v > 100 && chsRepCount(chsHash()) > 0) v -= 60;   // winning: avoid repeating
      chsUnmake(root[i], u);
      if (chsAbort) break;
      if (v > dv) { dv = v; di = i; nt = 0; }
      if (v == dv) ties[nt++] = (uint8_t)i;
    }
    if (chsAbort || di < 0) break;       // an unfinished iteration is never used
    best = (tier == 0 && nt > 0) ? root[ties[mazeRngRange(nt)]] : root[di];
    if (tier >= 2 && di > 0) { uint16_t t0 = root[0]; root[0] = root[di]; root[di] = t0; }   // best move first next time
    if (tier >= 2) { chsThinkD = (uint8_t)D; chsThinkFrame(); }
    if (dv >= CHS_MATE - 100) break;     // a forced mate is in sight
  }
  if (!best) best = root[mazeRngRange(n)];
  return best;
}
static uint16_t chsCpuPick(int tier) {
  chsQueenOnly = true;
  uint16_t m = chsCpuPickInner(tier);
  chsQueenOnly = false;
  chsThinkD = 0;
  return m;
}

// --- opening book (UCI-style lines, replayed from the move list; HARD / EXTREME only) ---
static const char* const kChsBook[] = {
  "e2e4 e7e5 g1f3 b8c6 f1b5 a7a6", "e2e4 e7e5 g1f3 b8c6 f1c4 g8f6", "e2e4 e7e5 g1f3 b8c6 d2d4 e5d4",
  "e2e4 e7e5 b1c3 g8f6 f2f4 d7d5", "e2e4 e7e5 g1f3 g8f6 f3e5 d7d6", "e2e4 c7c5 g1f3 d7d6 d2d4 c5d4",
  "e2e4 c7c5 g1f3 b8c6 d2d4 c5d4", "e2e4 c7c5 b1c3 b8c6 g2g3 g7g6", "e2e4 e7e6 d2d4 d7d5 b1c3 g8f6",
  "e2e4 c7c6 d2d4 d7d5 b1c3 d5e4", "e2e4 d7d5 e4d5 d8d5 b1c3 d5a5", "d2d4 d7d5 c2c4 e7e6 b1c3 g8f6",
  "d2d4 d7d5 c2c4 c7c6 g1f3 g8f6", "d2d4 g8f6 c2c4 e7e6 b1c3 f8b4", "d2d4 g8f6 c2c4 g7g6 b1c3 f8g7",
  "d2d4 d7d5 g1f3 g8f6 c1f4 e7e6", "d2d4 d7d5 c2c4 d5c4 g1f3 g8f6", "c2c4 e7e5 b1c3 g8f6 g1f3 b8c6",
  "g1f3 d7d5 d2d4 g8f6 c2c4 e7e6", "g1f3 g8f6 c2c4 g7g6 b1c3 f8g7"};
#define CHS_BOOK_N (sizeof(kChsBook) / sizeof(kChsBook[0]))
static_assert(CHS_BOOK_N <= 24, "book candidate buffer");
static int chsBookEnc(const char* q) {   // "e2e4" -> from | to << 6, -1 if malformed
  int f0 = q[0] - 'a', r0 = q[1] - '1', f1 = q[2] - 'a', r1 = q[3] - '1';
  if ((unsigned)f0 > 7u || (unsigned)r0 > 7u || (unsigned)f1 > 7u || (unsigned)r1 > 7u) return -1;
  return (r0 * 8 + f0) | ((r1 * 8 + f1) << 6);
}
// A book reply for the side to move, or 0: every line whose first chsPly moves equal the game so far
// is a candidate; one is picked with the seeded RNG and must be legal here.
static uint16_t chsBookMove() {
  if (chsPly >= 6) return 0;
  const char* cand[CHS_BOOK_N];
  int cnt = 0;
  for (unsigned l = 0; l < CHS_BOOK_N; l++) {
    const char* ln = kChsBook[l];
    if (strlen(ln) < (size_t)chsPly * 5u + 4u) continue;
    bool ok = true;
    for (int i = 0; i < chsPly && ok; i++) if (chsBookEnc(ln + i * 5) != (int)chsPlyMv[i]) ok = false;
    if (ok) cand[cnt++] = ln + chsPly * 5;
  }
  if (!cnt) return 0;
  int want = chsBookEnc(cand[mazeRngRange(cnt)]);
  if (want < 0) return 0;
  uint16_t lm[224];
  int n = chsLegal(lm, 224);
  for (int i = 0; i < n; i++) if ((lm[i] & 0xFFF) == want && (lm[i] >> 12) < 8) return lm[i];
  return 0;
}

// --- save & resume (SaveMisc.chessSave, 72 bytes) ---
// [0..31] board, two 4-bit pieces per byte (square index 0..63, a1 first) | [32] side, castling<<1, vsCpu<<5,
// P1 white<<6, flip<<7 | [33] en-passant square 0..63 or 0xFF | [34] halfmove clock | [35] tier, clock mode<<2,
// hinted<<4 | [36] plies | [37..40] clocks in seconds (W, B; LE) | [41,42] last move | [43] 0xC5 marker |
// [44..67] first 12 plies. The repetition history is not saved (it restarts at the resume position).
static bool chsSaveValid() { return miscGetFlag(MF_CHESS_SAVED) && g_saveMisc.chessSave[43] == 0xC5; }
static void chsSaveClear() { memset(g_saveMisc.chessSave, 0, sizeof(g_saveMisc.chessSave)); miscSetFlag(MF_CHESS_SAVED, false); }
static void chsSaveStore() {
  uint8_t* d = g_saveMisc.chessSave;
  memset(d, 0, sizeof(g_saveMisc.chessSave));
  for (int i = 0; i < 64; i++) {
    uint8_t v = (uint8_t)(chsB[((i >> 3) << 4) | (i & 7)] & 15);
    d[i >> 1] |= (i & 1) ? (uint8_t)(v << 4) : v;
  }
  d[32] = (uint8_t)((chsSide & 1) | ((chsCastle & 15) << 1) | (chsVsCpu ? 0x20 : 0) | (chsP1White ? 0x40 : 0) | (chsFlipOpt ? 0x80 : 0));
  d[33] = chsEp >= 0 ? (uint8_t)(((chsEp >> 4) << 3) | (chsEp & 7)) : 0xFF;
  d[34] = chsHalf;
  d[35] = (uint8_t)((g_variant & 3) | ((chsClockMode & 3) << 2) | (chsHinted ? 0x10 : 0));
  d[36] = chsPly;
  for (int c = 0; c < 2; c++) {
    long sec = chsClockMs[c] / 1000;
    if (sec < 0) sec = 0;
    if (sec > 65535) sec = 65535;
    d[37 + c * 2] = (uint8_t)(sec & 255);
    d[38 + c * 2] = (uint8_t)(sec >> 8);
  }
  d[41] = chsLastFrom >= 0 ? (uint8_t)chsLastFrom : 0xFF;
  d[42] = chsLastTo >= 0 ? (uint8_t)chsLastTo : 0xFF;
  d[43] = 0xC5;
  for (int i = 0; i < 12; i++) { d[44 + i * 2] = (uint8_t)(chsPlyMv[i] & 255); d[45 + i * 2] = (uint8_t)(chsPlyMv[i] >> 8); }
  miscSetFlag(MF_CHESS_SAVED, true);
}
// Restores the saved game into the globals. False (nothing trusted) if the data does not describe a sane position.
static bool chsSaveLoad() {
  if (!chsSaveValid()) return false;
  const uint8_t* d = g_saveMisc.chessSave;
  int nk[2] = {0, 0}, kg[2] = {0, 0};
  memset(chsB, 0, sizeof(chsB));
  for (int i = 0; i < 64; i++) {
    uint8_t v = (i & 1) ? (uint8_t)(d[i >> 1] >> 4) : (uint8_t)(d[i >> 1] & 15);
    int s = ((i >> 3) << 4) | (i & 7);
    if (v == 0) continue;
    if ((v & 7) < 1 || (v & 7) > 6) return false;
    if ((v & 7) == 1 && ((i >> 3) == 0 || (i >> 3) == 7)) return false;   // no pawns on the back ranks
    if ((v & 7) == 6) { nk[v >> 3]++; kg[v >> 3] = s; }
    chsB[s] = (int8_t)v;
  }
  if (nk[0] != 1 || nk[1] != 1) return false;
  int side = d[32] & 1, castle = (d[32] >> 1) & 15;
  if (!(chsB[4] == 6 && chsB[7] == 4)) castle &= ~1;
  if (!(chsB[4] == 6 && chsB[0] == 4)) castle &= ~2;
  if (!(chsB[116] == 14 && chsB[119] == 12)) castle &= ~4;
  if (!(chsB[116] == 14 && chsB[112] == 12)) castle &= ~8;
  int ep = -1;
  if (d[33] != 0xFF) {
    int r = d[33] >> 3;
    if (d[33] >= 64 || (r != 2 && r != 5)) return false;
    ep = (r << 4) | (d[33] & 7);
  }
  chsKing[0] = (int8_t)kg[0];
  chsKing[1] = (int8_t)kg[1];
  chsSide = (uint8_t)side;
  if (chsAttacked(chsKing[side ^ 1], side)) return false;   // the side that just moved cannot be left in check
  chsCastle = (uint8_t)castle;
  chsEp = (int8_t)ep;
  chsHalf = d[34];
  chsVsCpu = (d[32] & 0x20) != 0;
  chsP1White = (d[32] & 0x40) != 0;
  chsFlipOpt = (d[32] & 0x80) != 0;
  g_variant = (uint8_t)(d[35] & 3);
  chsClockMode = (uint8_t)((d[35] >> 2) & 3);
  if (chsClockMode > 2) chsClockMode = 0;
  chsHinted = (d[35] & 0x10) != 0;
  chsPly = d[36];
  for (int c = 0; c < 2; c++) chsClockMs[c] = (int32_t)(d[37 + c * 2] | (d[38 + c * 2] << 8)) * 1000L;
  chsLastFrom = d[41] < 64 ? (int8_t)d[41] : (int8_t)-1;
  chsLastTo = d[42] < 64 ? (int8_t)d[42] : (int8_t)-1;
  for (int i = 0; i < 12; i++) chsPlyMv[i] = (uint16_t)(d[44 + i * 2] | (d[45 + i * 2] << 8));
  return true;
}
// Leaving a running game (pause > Back to Games) keeps it for "A: resume" on the title.
static void chsSaveOnLeave() {
  if (chsEnding || chsPly == 0 || g_mixActive || g_challengeSeed) return;
  chsSaveStore();
  saveWrite();
}

// --- game layer ---
static int chsP1Side() { return (chsVsCpu || chsP1White) ? 0 : 1; }   // colour P1 / "You" plays
static int chsColOf(int s) { int f = s & 7; return chsDrawFlip ? 7 - f : f; }
static int chsRowOf(int s) { int r = s >> 3; return chsDrawFlip ? r : 7 - r; }
static int chsSqX(int s) { return CHS_X0 + chsColOf(s) * CHS_CELL + CHS_CELL / 2; }
static int chsSqY(int s) { return CHS_Y0 + chsRowOf(s) * CHS_CELL + CHS_CELL / 2; }

// Letters of the `side` pieces that are off the board ("QRB2N" style: letter + count when > 1).
static void chsLostStr(int side, char* out) {
  static const uint8_t init[6] = {8, 2, 2, 2, 1, 1};
  int cnt[6] = {0, 0, 0, 0, 0, 0};
  for (int s = 0; s < 120; s++) {
    if (s & 0x88) continue;
    int p = chsB[s];
    if (p && (p >> 3) == side) cnt[(p & 7) - 1]++;
  }
  static const char letters[5] = {'Q', 'R', 'B', 'N', 'P'};
  static const uint8_t idx[5] = {4, 3, 2, 1, 0};
  int k = 0;
  for (int i = 0; i < 5; i++) {
    int miss = (int)init[idx[i]] - cnt[idx[i]];
    if (miss <= 0) continue;
    out[k++] = letters[i];
    if (miss > 1) out[k++] = (char)('0' + miss);
  }
  out[k] = 0;
}

static void chsGlyph(int x, int y, int type, uint16_t fill, uint16_t edge) {
  const uint16_t* g = kChsGlyph + (type - 1) * 11;
  for (int ry = -1; ry <= 11; ry++) {
    uint32_t a = (ry >= 1 && ry <= 11) ? g[ry - 1] : 0;
    uint32_t b = (ry >= 0 && ry <= 10) ? g[ry] : 0;
    uint32_t c = (ry >= -1 && ry <= 9) ? g[ry + 1] : 0;
    uint32_t m = (a | b | c) << 1;                       // column c lives in bit 11 - c (bit 12 = column -1)
    uint32_t e = (m | (m << 1) | (m >> 1)) & 0x1FFFu;    // 3x3 dilation = the outline
    uint32_t f = b << 1;
    if (!e) continue;
    for (int bit = 12; bit >= 0; bit--) {
      if ((f >> bit) & 1u) canvas->drawPixel(x + 11 - bit, y + ry, fill);
      else if ((e >> bit) & 1u) canvas->drawPixel(x + 11 - bit, y + ry, edge);
    }
  }
}
static void chsDrawPiece(int p, int x, int y) {   // x,y = top-left of the 15x15 cell
  if (p & 8) chsGlyph(x + 2, y + 2, p & 7, chsPcB, chsPcBo);
  else chsGlyph(x + 2, y + 2, p & 7, chsPcW, chsPcWo);
}

static void drawChsScene(unsigned long now) {
  bool flipAnim = false;
  {   // orientation for this frame: the old view until the half-way point of a flip, then the new one
    bool f = chsViewFlip;
    if (chsFlipT0) {
      unsigned long el = now - chsFlipT0;
      if (el < 340UL) { flipAnim = true; f = (el < 170UL) ? chsViewOld : chsViewFlip; }
      else chsFlipT0 = 0;
    }
    chsDrawFlip = f;
  }
  canvas->fillScreen(COL_BG);
  for (int r = 0; r < 8; r++)
    for (int c = 0; c < 8; c++)
      canvas->fillRect(CHS_X0 + c * CHS_CELL, CHS_Y0 + r * CHS_CELL, CHS_CELL, CHS_CELL, ((r + c) & 1) ? chsColD : chsColL);
  bool human = !chsEnding && !(chsVsCpu && chsSide == 1) && !flipAnim;
  bool animOn = chsAnimFrom >= 0 && now - chsAnimT0 < 120UL;
  int kingSq = -1;
  if (chsInChk) { int k = chsKing[chsSide]; kingSq = ((k >> 4) << 3) | (k & 7); }
  for (int s = 0; s < 64; s++) {
    int x = chsSqX(s) - CHS_CELL / 2, y = chsSqY(s) - CHS_CELL / 2;
    if (s == chsLastFrom || s == chsLastTo) canvas->fillRect(x, y, CHS_CELL, CHS_CELL, chsHiLast);
    if (s == kingSq) canvas->fillRect(x, y, CHS_CELL, CHS_CELL, chsHiChk);
    if (human && s == chsSel) canvas->fillRect(x, y, CHS_CELL, CHS_CELL, chsHiSel);
  }
  for (int s = 0; s < 64; s++) {
    int p = chsB[chsSq88(s)];
    if (!p || (animOn && s == chsAnimTo)) continue;
    chsDrawPiece(p, chsSqX(s) - CHS_CELL / 2, chsSqY(s) - CHS_CELL / 2);
  }
  if (human && chsSel >= 0) {
    for (int s = 0; s < 64; s++) {
      if (!((chsDest >> s) & 1ULL)) continue;
      int cx = chsSqX(s), cy = chsSqY(s);
      if (chsB[chsSq88(s)]) canvas->drawRect(cx - CHS_CELL / 2, cy - CHS_CELL / 2, CHS_CELL, CHS_CELL, COL_GOAL);
      else canvas->fillCircle(cx, cy, 2, COL_GOAL);
    }
  }
  if (animOn) {   // the moved piece glides from its old square
    float t = (float)(now - chsAnimT0) / 120.0f;
    int fx = chsSqX(chsAnimFrom), fy = chsSqY(chsAnimFrom), tx = chsSqX(chsAnimTo), ty = chsSqY(chsAnimTo);
    int px = fx + (int)((float)(tx - fx) * t), py = fy + (int)((float)(ty - fy) * t);
    chsDrawPiece(chsB[chsSq88(chsAnimTo)], px - CHS_CELL / 2, py - CHS_CELL / 2);
  }
  if (human && chsHintFrom >= 0 && now < chsHintUntil) {   // hint: both squares outlined and an arrow
    int fx = chsSqX(chsHintFrom), fy = chsSqY(chsHintFrom), tx = chsSqX(chsHintTo), ty = chsSqY(chsHintTo);
    canvas->drawRect(fx - CHS_CELL / 2, fy - CHS_CELL / 2, CHS_CELL, CHS_CELL, COL_ORANGE);
    canvas->drawRect(tx - CHS_CELL / 2, ty - CHS_CELL / 2, CHS_CELL, CHS_CELL, COL_ORANGE);
    canvas->drawRect(tx - CHS_CELL / 2 + 1, ty - CHS_CELL / 2 + 1, CHS_CELL - 2, CHS_CELL - 2, COL_ORANGE);
    canvas->drawLine(fx, fy, tx, ty, COL_ORANGE);
    canvas->fillCircle(tx, ty, 2, COL_ORANGE);
  }
  if (human && !chsPromoPick) {
    int x = CHS_X0 + chsCc * CHS_CELL, y = CHS_Y0 + chsCr * CHS_CELL;
    canvas->drawRect(x, y, CHS_CELL, CHS_CELL, COL_KEY);
    canvas->drawRect(x + 1, y + 1, CHS_CELL - 2, CHS_CELL - 2, COL_KEY);
  }
  if (chsPromoPick) {   // promotion chooser: four glyphs in a bar over the middle of the board
    int bx = CHS_X0 + 30, by = CHS_Y0 + 52;
    canvas->fillRect(bx - 2, by - 2, 4 * CHS_CELL + 4, CHS_CELL + 4, COL_BG);
    canvas->drawRect(bx - 2, by - 2, 4 * CHS_CELL + 4, CHS_CELL + 4, COL_KEY);
    for (int i = 0; i < 4; i++) {
      uint16_t cell = (i == (int)chsPromoIdx) ? chsHiSel : (i & 1 ? chsColD : chsColL);
      canvas->fillRect(bx + i * CHS_CELL, by, CHS_CELL, CHS_CELL, cell);
      chsDrawPiece(kChsPromoTypes[i] | (chsSide ? 8 : 0), bx + i * CHS_CELL, by);
    }
    int sx = bx + (int)chsPromoIdx * CHS_CELL;
    canvas->drawRect(sx, by, CHS_CELL, CHS_CELL, COL_GOAL);
    canvas->drawRect(sx + 1, by + 1, CHS_CELL - 2, CHS_CELL - 2, COL_GOAL);
  }
  // side panel (x = 126..159, text <= 5 chars)
  canvas->setTextSize(1);
  canvas->setTextColor(COL_TEXT);
  if (!chsEnding) {
    const char* who = chsVsCpu ? (chsSide == 0 ? "YOU" : "CPU") : (chsSide == chsP1Side() ? "P1" : "P2");
    canvas->setCursor(128, 4);
    canvas->setTextColor(COL_GOAL);
    canvas->print(who);
    canvas->fillRect(151, 3, 8, 9, chsSide ? chsPcBo : chsPcWo);
    canvas->fillRect(152, 4, 6, 7, chsSide ? chsPcB : chsPcW);
    canvas->setCursor(128, 15);
    if (chsVsCpu && chsSide == 1) {
      canvas->setTextColor(COL_TEXT);
      int dots = (int)((now / 300UL) % 3UL) + 1;
      for (int i = 0; i < dots; i++) canvas->print(".");
      if (chsThinkD) { canvas->setCursor(128, 26); canvas->print("D"); canvas->print((int)chsThinkD); }
    } else if (chsPromoPick) {
      canvas->setTextColor(COL_ORANGE);
      canvas->print("PROMO");
    } else if (chsInChk) {
      canvas->setTextColor(COL_LASER);
      canvas->print("CHECK");
    }
  }
  {
    char lost[12];
    canvas->setTextColor(COL_TEXT);
    chsLostStr(1, lost);   // black pieces White has taken
    char tb[12];
    lost[4] = 0;
    canvas->fillRect(126, 44, 6, 8, chsPcBo);
    canvas->fillRect(127, 45, 4, 6, chsPcB);
    pt(133, 44, lost);
    chsLostStr(0, lost);
    lost[4] = 0;
    canvas->fillRect(126, 56, 6, 8, chsPcWo);
    canvas->fillRect(127, 57, 4, 6, chsPcW);
    pt(133, 56, lost);
    int diff = (chsMaterial(0) - chsMaterial(1)) / 100;
    canvas->setCursor(128, 72);
    canvas->setTextColor(COL_KEY);
    if (diff == 0) snprintf(tb, sizeof(tb), "EVEN");
    else snprintf(tb, sizeof(tb), "%c+%d", diff > 0 ? 'W' : 'B', diff > 0 ? diff : -diff);
    canvas->print(tb);
    if (chsHalf >= 70) {
      snprintf(tb, sizeof(tb), "50:%d", (100 - chsHalf) / 2);
      ptc(COL_TEXT, 128, 84, tb);
    }
  }
  if (chsVsCpu) {
    static const char* const kChsTier4[4] = {"NORM", "EASY", "HARD", "XTRM"};
    ptc(COL_TEXT, 128, 118, kChsTier4[g_variant & 3]);
  } else if (chsUndoOk && !chsEnding) {
    ptc(COL_TEXT, 128, 118, "UNDO");
  }
  if (!chsVsCpu && chsClockMode) {   // two clocks: the side to move is highlighted, red under 30 s
    for (int c = 0; c < 2; c++) {
      int sec = (int)((chsClockMs[c] + 999L) / 1000L);
      char cb[16];
      if (sec < 0) sec = 0;
      if (sec > 5999) sec = 5999;
      snprintf(cb, sizeof(cb), "%c%d:%02d", c ? 'B' : 'W', sec / 60, sec % 60);
      ptc(sec < 30 ? COL_LASER : (chsSide == c && !chsEnding ? COL_KEY : COL_TEXT), 124, 96 + c * 10, cb);
    }
  }
  particlesUpdateDraw();
  if (flipAnim) {   // shutter: the board closes to a line, turns, and opens again
    unsigned long el = now - chsFlipT0;
    int h = (int)(60UL * (el < 170UL ? el : 340UL - el) / 170UL);
    if (h > 60) h = 60;
    if (h > 0) {
      canvas->fillRect(CHS_X0, CHS_Y0, 8 * CHS_CELL, h, COL_BG);
      canvas->fillRect(CHS_X0, CHS_Y0 + 8 * CHS_CELL - h, 8 * CHS_CELL, h, COL_BG);
    }
  }
}

static void chsThinkFrame() {
  drawChsScene(millis());
  blitScreen();
}

