// --- Level editor data model ------------------------------------------------
//
// Shared by the on-device level editor for the 6 "spatial" games (Sokoban
// Mini, Tilt Maze, Breakout, Platform Dash, Speed Maze, Space Invaders).
// Declared this early for the same auto-prototype-hoisting reason as
// EnterPlayingFn above: any function signature that mentions LevelData
// needs the typedef visible before the IDE's hoisted prototypes.
//
// The grid is a generic small 2D byte buffer -- big enough for every one of
// the 6 games' real in-memory layout (the largest is Sokoban's 7x7 room and
// Breakout's 10x4 brick field) -- with per-game code mapping the raw tile
// ids into that game's own arrays/variables. This is intentionally a dumb
// byte grid rather than 6 different structs so load/save/draw/cursor logic
// can be shared.
#define LVL_SLOTS 5            // custom save slots per game
#define LVL_TEMP_SLOT LVL_SLOTS // reserved RAM-only slot index: editor Test Play
#define LVL_GRID_MAXW 24
#define LVL_GRID_MAXH 16
#define LVL_NUM_GAMES 25
#define LVL_MAGIC 0xA7          // current slot-file / in-memory marker (header + name + best)
#define LVL_MAGIC_V4 0xA8       // atomic two-file saves: the 0xA7 layout + [generation][checksum] trailer (flash files only)
#define LVL_MAGIC_V2 0xA6       // previous: [magic][game][w][h] + cells (no name / best)
#define LVL_MAGIC_V1 0xA5       // old 94-byte files (cells[9][10]), migrated on load
#define LVL_V1_SIZE 94
#define LVL_HDR 16              // v3 header: magic, game|verified<<7, w, h, name[8], best int32 LE
#define LVL_NAME_LEN 8
#define LVL_NO_BEST ((int32_t)0x80000000)

