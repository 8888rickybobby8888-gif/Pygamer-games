// Digit roll: each digit of `value` spins through random digits and locks in left to
// right. `elapsed` is ms since the roll began; the visuals use millis() only (never
// the seeded game RNG).
#define GUESS_ROLL_MS 260
static void guessDrawBig(int value, unsigned long elapsed, uint16_t doneCol) {
  char buf[8];
  snprintf(buf, sizeof(buf), "%d", value);
  int n = (int)strlen(buf);
  int x0 = (VIEW_COLS * TILE_SIZE - n * 12) / 2;
  canvas->setTextSize(2);
  for (int i = 0; i < n; i++) {
    bool locked = elapsed >= (unsigned long)(60 + 70 * i);
    char ch = locked ? buf[i] : (char)('0' + (int)((millis() / 35 + (unsigned long)i * 7) % 10));
    ptc(locked ? doneCol : COL_ICE, x0 + i * 12, HUD_HEIGHT + 20, ch);
  }
  canvas->setTextSize(1);
}

// Blocking (300 ms) reveal of the secret number, used when a round ends.
static void guessRevealBlocking(int value, const char* msg, uint16_t col) {
  unsigned long t0 = millis();
  for (;;) {
    unsigned long el = millis() - t0;
    bool done = el >= 300;
    canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
    guessDrawBig(value, el, col);
    if (done) {
      canvas->setTextSize(1);
      ptc(col, (VIEW_COLS * TILE_SIZE - (int)strlen(msg) * 6) / 2, HUD_HEIGHT + 55, msg);
    }
    blitScreen();
    if (done) break;
    delay(25);
  }
}

static void drawGuessScene() {
  canvas->fillRect(0, HUD_HEIGHT, VIEW_COLS * TILE_SIZE, VIEW_ROWS * TILE_SIZE, COL_BG);
  canvas->setTextSize(2);
  canvas->setTextColor(COL_TEXT);
  bool rolling = guessRollStart != 0 && millis() - guessRollStart < GUESS_ROLL_MS;
  if (!rolling) guessRollStart = 0;
  if (rolling) {
    guessDrawBig(guessCurrent, millis() - guessRollStart, COL_TEXT);
  } else {
    char buf[8];
    snprintf(buf, sizeof(buf), "%d", guessCurrent);
    int textW = (int)strlen(buf) * 12;
    pt((VIEW_COLS * TILE_SIZE - textW) / 2, HUD_HEIGHT + 20, buf);
  }
  canvas->setTextSize(1);
  const char* msg = rolling                  ? "..."
                     : guessLastResult == 1   ? "Go HIGHER"
